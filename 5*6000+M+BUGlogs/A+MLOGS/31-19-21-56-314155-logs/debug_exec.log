code:from object_detector import Object_Detector_Tool

def count_baller_addresses(image_path: str, labels: list, save_object: bool, saved_image_path: str):
    with Object_Detector_Tool(image_path, labels, threshold=0.75, model_size="tiny", save_object=save_object) as detector:
        labels_count = {label: detector.labels[label + "_conf"] for label in labels}
        return labels_count

def count_baseball_player_count(image_path: str, model_name="base", save_object: bool, saved_image_path: str):
    with Object_Detector_Tool(image_path, labels=[f"{model_name}_{_}" for _ in range(10)], save_object=save_object, model_name=model_name) as detector:
        labels_count = {label: detector.labels[label + "_conf"] for label in labels if "_conf" in detector.labels[label] and "baseball" in detector.labels[label]}
        return labels_count

def count_baller_address(accumulator, label):
    label_count = count_baseball_player_count(f"../val/Counting_7_image_1.jpg", model_name=label)
    accumulator[label] += label_count["baseball"]

final_result = {label: count_baller_address({" accumulator": {"baseball": 0}}, label) for label in ["baseball", "base"] if "baller_address" in label}
final_result
