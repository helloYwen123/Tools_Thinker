Code: from object_detector import Object_Detector_Tool
import numpy as np

def count_tall_towers(images_path):
    # Set the parameters
    labels = ['Lackawanna']
    threshold = 0.45
    model_size = 'tiny'
    save_objects = True
    saved_image_path = 'detected_objects'

    # Load the object detector tool
    detector_tool = Object_Detector_Tool()
    detector_tool.set_labels(labels)
    detector_tool.threshold = threshold
    detector_tool.model_size = model_size
    detector_tool.save_images = save_objects
    detector_tool.saved_image_path = saved_image_path

    # Load image and run the tool
    detector_tool.load_image(images_path)
    detected_objects, object_number = detector_tool.execute()

    # Count tall towers
    counts = {}
    for obj in detected_objects:
        label, confidence, box = obj['label'], obj['confidence score'], obj['box']
        count = counts.get(label, 0)
        counts[label] = count + 1

    # Sum counts and return
    total_tall_count = sum(counts.values())
    return total_tall_count

# Example usage
