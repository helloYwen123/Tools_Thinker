Code: # Import the required tool
 import os
 import re
 from object_detector import Object_Detector_Tool

 def count_white_vertical_lines(path_to_image, image_caption="Path to Image"):
     """
     Counts the number of white vertical lines on the ground.

     Args:
     path_to_image: Path to the image file.
     image_caption: Description of the image.

     Returns:
     int: Total number of white vertical lines on the ground.

     """
     # Load the image
     image = Image.open(path_to_image)
     # Calculate the dimensions of the image
     image_width, image_height = image.size
     # Initialize the total count
     white_lines_count = 0
     # Iterate over the rows (or "vertical" cells) of the image
     for row in range(image_height):
         # Check the height of the current cell
         if image_height - row > 42:
             # If the height of the cell is greater than 42, it contains a white vertical line
             image_lines = image.crop((0, row, image_width, image_height)).count_channels()
             for channel in range(image_lines):
                 # Check if each channel is 1 (white) or 0 (black)
                 if channel == 1:
                     white_lines_count += 1
                     break
     return white_lines_count

# Sample function to calculate the number of white vertical lines
def sample_count_white_lines():
    path_to_image = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_106_image_1.jpg'
    image_caption = "Sample Image"
    white_lines_count = count_white_vertical_lines(path_to_image, image_caption)
    return white_lines_count

# Test the function
if __name__ == '__main__':
    white_lines_count = sample_count_white_lines()
    print(f"The number of white vertical lines on the ground is: {white_lines_count}")

