from object_detector import Object_Detector_Tool as objdet_tool

def count_bottles_on_table(img_path, return_object_count=False):
    detection_tool = objdet_tool()

    try:
        detected_objects = detection_tool.execute(image=img_path, labels=["bottle"], threshold=0.4, save_object=True, saved_image_path="detected_objects")
        object_labels = ['bottle']
        
        # Extract object data for each detected object
        object_data = [obj for obj in detected_objects if obj['label'] == 'bottle']
        
        # Filter and count bottles
        for obj in object_data:
            if obj['label'] == 'bottle':
                bottle_count = obj['confidence score'] * len([obj for obj in detected_objects if obj['label'] == "bottle"])
            else:
                bottle_count = 0
        
        if return_object_count:
            return {'bottle_count': bottle_count}
        else:
            return object_data
    except Exception as e:
        print(f"An error occurred: {e}")
        return False

# Check function
