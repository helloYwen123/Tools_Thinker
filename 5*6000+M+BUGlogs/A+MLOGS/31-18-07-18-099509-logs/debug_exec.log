from object_detector import Object_Detector_Tool

def detect_bottles(image_path, labels=["bottle"], save_object=False, saved_image_path="detected_objects", threshold=0.45, model_size="tiny"):
    # Load the object detector model
    model = Object_Detector_Tool(image_path, labels, False, saved_image_path, save_object, saved_image_path)

    # Detect bottles in the image
    detected_objects, object_number = model.execute(image_path, labels, True, threshold, "tiny", save_object, saved_image_path)

    # Calculate the total number of bottles detected
    total_bottles = sum(object_number.values())

    return total_bottles

# Function to count bottles detected in the image
def count_bottles(image_path):
    global final_result
    total_bottles = detect_bottles(image_path)
    final_result.append({"label": "bottle", "count": total_bottles})
    return total_bottles
