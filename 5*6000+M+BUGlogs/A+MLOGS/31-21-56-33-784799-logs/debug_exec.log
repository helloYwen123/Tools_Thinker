from object_detector import Object_Detector_Tool

def count_tigers(image_path, labels, threshold, model_size, save_object):
    # Load and analyze the model
    detector_tool = Object_Detector_Tool()
    labels = "baseball, basket"
    threshold = 0.45
    model_size = "base"
    
    try:
        # Execute the tool with input image
        detected_objects, object_number = detector_tool.execute(image_path, labels, saved_image_path=None, threshold=threshold, model_size=model_size)
        
        # Calculate the number of tigers based on the labels
        tiger_count = sorted([count for _, count in object_number.items() if "baseball" in labels and "basket" in labels and "tiger" in labels][0])
        
        final_result = tiger_count
        return final_result
    except Exception as e:
        return "Error: " + str(e)

