Code: from object_detector import Object_Detector_Tool

def count_elephants(image_path, label, threshold=0.45, model_size='tiny', save_object=True, saved_image_path="detected_objects"):

    # Load model
    detector_tool = Object_Detector_Tool(image_image_path=image_path,
                                         labels=[label], threshold=threshold, model_size=model_size, save_object=save_object)
    detections = detector_tool.execute()

    # Find the number of objects for each image
    image_labels = detections['object_number']

    # Return a dictionary with the total count for each labeled object
    return image_labels

# Get the number of elephants with trunks in the water
elephants_with_trunks_in_water = count_elephants("val_Counting_43_image_1.jpg", "elephant_trunk", threshold=0.45)

# Print the result
