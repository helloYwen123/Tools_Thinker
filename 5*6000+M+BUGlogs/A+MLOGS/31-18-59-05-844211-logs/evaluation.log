Code: from object_detector import Object_Detector_Tool

def ski_spectators(image_path, labels, threshold=None, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool(image_path=image_path, labels=labels, save_object=save_object)
    if threshold is not None:
        object_detector_tool.set_threshold(threshold)
    if model_size is not None:
        object_detector_tool.model_size = model_size
        if model_size == 'tiny':
            object_detector_tool._load_tiny()
        if model_size == 'base':
            object_detector_tool._load_base()
    results = object_detector_tool.execute()
    object_count = results[0][1]
    return object_count

