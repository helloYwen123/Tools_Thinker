code:from object_detector import Object_Detector_Tool

def count_one_way_signs(image_path, labels, threshold=0.45, save_object=True, saved_image_path="detected_objects"):
    # Read the image
    image = Image.open(image_path)

    # Detect objects
    objectDetector = Object_Detector_Tool(image=image, labels=labels, threshold=threshold, save_object=save_object)
    detected_objects = objectDetector.execute()

    # Count one way signs
    one_way_signs = 0
    for obj in detected_objects:
        if obj['label'] == 'one way':
            one_way_signs += 1

    return one_way_signs

