def analyze_digits(image_path, labels, threshold, model_size, save_object=False, saved_image_path="detected_objects"):
    """
    This function uses the Object_Detector_Tool to detect objects in an image based on specified labels and a given threshold.
    
    Parameters:
    image_path (str): Path to the image.
    labels (list): A list of object labels to detect.
    threshold (float): The confidence threshold for detection (default: 0.45).
