def count_people(image_path, labels=["person"], threshold=0.45, model_size="base", save_object=True, saved_image_path="detected_objects", object_detector=None):
    try:
        det_data = object_detector.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
        print(det_data)
    except BaseException as e:
        print(str(e))

    # This function can handle various errors that may occur, including model not being recognized or object not detected in the image.
    if "failed" in det_data:
        return False, det_data
    elif "error" in det_data:
        return False, det_data

    person_objects = []
    person_counts = {}
    for obj in det_data:
        if obj["label"] == "persons":
            person_objects.append(obj)
            person_counts[obj["label"]] = person_counts.get(obj["label"], 0) + 1

    count = 0
    total_labels = len(person_counts)
    for label in person_counts:
        count += person_counts[label]
        if count > total_labels:
            break

    return True, {"count": count, "totals": total_labels}

