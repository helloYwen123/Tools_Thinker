    def count_people(image_path, person_labels_to_detect=["person"], save_object=False, saved_image_path="detected_objects"):
        # Read the image
        image = image_path

        # Check if labels are provided and are valid
        if not isinstance(person_labels_to_detect, list) or len(person_labels_to_detect) == 0:
            raise ValueError("person_labels_to_detect must be a list of strings.")

        # Use PyTesseract to read the image
        text = ' '.join(cv2.imread(image_path).strip().split())

        # Convert the image to grayscale and calculate area of interest
        gray_image = cv2.cvtColor(cv2.imread(image), cv2.COLOR_BGR2GRAY)
        area_of_interest = gray_image.mean(axis=1).mean()

        # Detect people
        people = []
        for person_label in person_labels_to_detect:
            # Read the bounding boxes for each person
            bbox = person_box_detector(text, person_label).reshape(-1, 4)
            
            # Filter out people from the detection if their bounding box has too low area of interest
            bbox_around_interest = filter_around_interest_area(bbox, area_of_interest)
            
            # Add person to the list if at least one bounding box is around the interest area
            if len(bbox_around_interest) >= 1:
                people.append(bbox_around_interest)
        
        # Convert people to a list of dictionaries with labels, confidence, box and saved image paths
        people_list = [{"label": p.label, "confidence": p.confidence, "box": p[:, :2], "saved_image_path": os.path.join(cv2.imread(image_path).shape[0], p[:, 2]-p[:, 0].max() + 2)} for p in people]

        # Count the total number of people in the image
        total_persons = sum((len(p['box']) == 4) for p in people_list)

        return {"total_persons": total_persons, "people_count": people_list}

