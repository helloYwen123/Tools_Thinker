code:def count_elephants(image_path, labels=['elephant'], threshold=0.45, model_size='tiny', save_object=True):
    detection_tool = Object_Detector_Tool()
    labels = labels
    threshold = threshold
    model_size = model_size
    save_object = save_object
    if image_path:
        if model_size == 'tiny':
            dets = detection_tool.image_to_detections(image_path)
        else:
            dets = detection_tool.image_to_detections(image_path, model_type=model_size)
        confidence_score = [det['conf'][0] for det in dets]
        if save_object:
            detection_tool.save_object(detections=dets, confidence=confidence_score, labels=labels, saved_image_path=image_path)
        total_labels = [labels.count(det['label']) for det in dets]
    return total_labels

