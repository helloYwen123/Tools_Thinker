def count_people(image_path):
    image = Image.open(image_path)
    object_detector = Object_Detector_Tool(image=image, labels=["Person"])
    detections = object_detector.execute()
    total_count = 0
    for person_detection in detections[0]:
        total_count += int(person_detection["confidence_score"])
    return total_count

