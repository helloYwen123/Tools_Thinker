from object_detector import Object_Detector_Tool

class Answer_Service:
    def __init__(self):
        self.object_detector_tool = Object_Detector_Tool()

    def get_candlight_count(self, path_to_image):
        labels = ["candlight"]
        threshold = 0.45
        model_size = "tiny"
        save_object = True
        saved_image_path = "detected_objects"

        result = self.object_detector_tool.execute(image=path_to_image, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

        if 'label' in result:
            count = result['label'][0]['confidence'].item() * 10

            return count
        else:
            return None

