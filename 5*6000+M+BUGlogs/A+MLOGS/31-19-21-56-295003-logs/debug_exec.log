code:from tools.object_detector_tool import Object_Detector_Tool

def count_detection_objects(image_path, labels=None, save_object=True, saved_image_path='detected_objects', model_size='tiny'):
    """
    Counts the objects detected in an image.
    
    Parameters:
    - image_path (str): The path to the image file.
    - labels (list): A list of object labels to detect.
    - save_object (bool): Whether to save the detected objects as images.
    - saved_image_path (str): The path to save the detected object images. Default is 'detected_objects'.
    - model_size (str): The size of the model to use ('tiny' or 'base', default is 'tiny').
    
    Returns:
    - tuple: A tuple containing two elements: a list of dictionaries for each detected object (each with keys 'label', 'confidence score', 'box', and 'saved_image_path'), and a dictionary mapping each label to its total count in the image.
    """
    detection_object_data = Object_Detector_Tool.execute(image_path=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size)
    
    # Count the total number of detected objects
    total_count = len(detection_object_data['object_number'])
    
    return detection_object_data, total_count

