def count_trains(object_labels, threshold, saved_image_path, label_count, label_count_dict):
    train_count = 0
    for label in label_count:
        if label in object_labels:
            if label_count_dict[label] > threshold:
                train_count += 1
        else:
            if saved_image_path is not None:
