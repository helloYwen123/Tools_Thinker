Code: from object_detector import Object_Detector_Tool

def count_trains(image_path):
    # Load the image using the Object_Detector_Tool
    detector_tool = Object_Detector_Tool()
    
    # Use the object labels provided to detect trains
    object_labels = ["train"]
    
    # Detect and count the trains in the image
    result, total_train_count = detector_tool.detect_and_count(image_path=image_path, labels=object_labels)
    
    # Calculate the total count for trains
    total_count = sum(total_train_count)
    
    return total_count

