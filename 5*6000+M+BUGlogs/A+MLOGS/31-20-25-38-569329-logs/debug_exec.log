def count_people_wearing_hat(image_path):
    person_count = 0
    with open(image_path, 'r', encoding='utf-8') as file:
        lines = file.readlines()
        for line in lines:
            lines = lines.split("\n")[0]
            people = lines.split(", ")[2:]
            for person in people:
                if "person." in person:
                    if "hat" in person:
                        person_count += 1

