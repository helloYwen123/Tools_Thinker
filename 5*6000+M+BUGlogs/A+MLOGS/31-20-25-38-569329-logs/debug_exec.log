# Function to count the occurrence of the baseball and basketball objects in the image
def count_baseball_basketball_objects(image_path):

    # Initialize the object detection tool
    detector_tool = Object_Detector_Tool(image_path, labels=["baseball", "basket"], save_object=True, threshold=0.10, model_size="tiny")

    # Call the function and record the result
    objects, total_count = detector_tool.execute()

    # Filter object dictionaries based on label
    baseballs = [obj for obj in objects if obj["label"] == "baseball"]
    baskets = [obj for obj in total_count.keys() if obj != "baseball"]

    # Count the number of baseballs
    baseball_count = len(bases)

    return baseball_count

