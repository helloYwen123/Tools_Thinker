def count_banners(anchorage):
    """
    Counts banners in an awning.
    :param anchorage: The address of the building (excluding the house number).
    :return: The number of banners in the awning.
    """
    # Remove the name and prices of the banners
    banners = [sub.replace("LUNCH ", "").replace("LUNCH & ", "").replace("DINNER ", "").replace("MONDAY THU", "").replace("DINNER", "") for sub in anchorage]
    return len(banners)

