from object_detector import Object_Detector_Tool

def count_blue_circles(image):
    """Detect blue circles in an image using the ground-fishing model.

    Args:
        image (str): The path to the image file.

    Returns:
        list: A list of dictionaries with blue circles detected in the image.
        dict: Dictionary mapping each label to its count.
    """

    # Load the pre-trained ground-fishing model and threshold
    detector = Object_Detector_Tool()
    detector.load_model_and_threshold()

    # Perform object detection
    objects = detector.execute(image=image)

    # Count blue circles
    blue_circle_boxes = []
    for obj in objects['detections']:
        if obj['category'] == 'baseball' and obj['color'] == 'blue':
            blue_circle_boxes.append(obj)

    # Convert list to dictionary for label to count
    counts = {obj['category']: obj['confidence score'] * obj['count'] for obj in blue_circle_boxes}

    # Convert dictionary to list for more convenient manipulation
    counts_list = [{'label': category, 'count': count} for category, count in counts.items()]

    return counts_list
