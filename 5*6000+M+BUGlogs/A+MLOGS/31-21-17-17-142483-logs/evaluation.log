# command to load the image
def load_image(image_path):
    image = object_detector_tool.load_image(image_path)
    return image

# command to detect objects
def detect_objects(image, labels, save_object, thresholds, model_size, save_path):
    object_detected = object_detector_tool.detect_objects(image=image, labels=labels, save_object=False, threshold=thresholds['threshold'], model_size=model_size)
    return object_detected

def calculate_object_number(image_path, labels=['baseball', 'basket']):
    total_count = 0
    object_info = detect_objects(image=image_path, labels=labels, save_object=False, thresholds={"threshold": 0.45}, model_size="tiny", save_object=True, saved_image_path="detected_objects")
    for info in object_info:
        total_count += info["total_count"]
    return total_count

# command to get the count of people wearing a green jacket in an image
def count_county_jacket(image_path, labels=['baseball', 'basket']):
    count = 0
    for info in detect_objects(image=image_path, labels=labels, threshold=thresholds['threshold'], save_object=False, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
        if info['label'] == 'baseball':
            count += 1
        else:
            count += 0
    return count

