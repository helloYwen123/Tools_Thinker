Code: from object_detector import Object_Detector_Tool

def count_blue_circles(frame_path: str, labels: list = ["red", "blue"], save_objects: bool = False, saved_image_path: str = "detected_objects", threshold: float = 0.45, model_size: str = "tiny") -> None:
    tool = Object_Detector_Tool()
    
    object_count = tool.execute(image=frame_path, labels=labels, save_object=save_objects, threshold=threshold, model_size=model_size)
    total_count = object_count["object_number"]
    for label in labels:
        if label == "blue":
            count = object_count["obj_" + label + "_count"]
    
    for label, count in sorted(object_count.items(), key=lambda x: x[1]):
        if count != 0:
            print(f"{label}: {count}")
        elif count == 0 and save_objects:
            img_name = f"obj_{label}_image_" + ("." + _ if "_" in label else ".") + f"{count}"  # Add the count as an extension to the object name
            img_path = saved_image_path + "/" + img_name
            tool.show(img_path)

