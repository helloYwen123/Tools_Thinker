Code: from object_detector import Object_Detector_Tool

def count_bluecircles(image):
    import cv2
    import numpy as np

    def find_bluecircles(image):
        bluecircles = np.zeros((image.shape[0], image.shape[1]), dtype = np.uint8)
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
        blurred = cv2.medianBlur(gray, 5)
        ret, thresh = cv2.threshold(blurred, 50, 255, cv2.THRESH_BINARY)
        contours, _ = cv2.findContours(thresh, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

        for contour in contours:
            x, y, w, h = cv2.boundingRect(contour)
            if w/2 < 200:
                continue
            cv2.rectangle(image, (x, y), (x+w, y+h), (255, 0, 0), 2)
            if w/2 < 200:
                continue
            bluecircles[y:y+h, x:x+w] = 1

        return bluecircles

    return count_bluecircles(image)

