code:import numpy as np
from object_detector import Object_Detector_Tool

def count_people(image_path):
    # Load the image
    image = Object_Detector_Tool.execute(image=image_path)

    # Get the bounding boxes of each person in the image
    people_boxes = []
    for detection in image['detected_objects']:
        if 'label' in detection and detection['label'] == 'man':
            people_boxes.append({'bbox': detection['bbox'], 'label': 'man'})

    # Count the number of people
    people_count = len(people_boxes)

    return {'count': people_count}

