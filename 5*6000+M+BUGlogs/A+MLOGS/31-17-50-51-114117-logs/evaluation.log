Code: def count_glassed_people(image_path):
    # Import required tool class
    from toolobjectdetectortool import object_detector
    # Load image
    image = object_detector.load_image(image_path)
    # Perform object detection
    object_labels = object_detector.detect_objects(image=image, labels=["glasses"], threshold=0.45, model_size="tiny")
    # Count glasses present in the image
    num_glassed_people = len(object_labels) - object_labels.count("glasses")
    return num_glassed_people

