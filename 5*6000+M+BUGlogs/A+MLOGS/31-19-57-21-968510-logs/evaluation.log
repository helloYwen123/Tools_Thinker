            ppl_conf = ppl['confidence score']
            ppl_num = ppl['box']
        if ppl['label'] == "basket":
            ppl_conf = ppl['confidence score']
            ppl_num = ppl['box']
    ppl_final = ppl_num + ppl_conf
    return ppl_final

