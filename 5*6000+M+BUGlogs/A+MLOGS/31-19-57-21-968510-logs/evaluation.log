    detector = Object_Detector_Tool(image_path, labels, threshold, model_size, save_object, saved_image_path)
    result = detector.execute_labels()
    people_in_suit = [person_dict for person_dict in result[1] if person_dict["label"] == "suit"]
    return people_in_suit

