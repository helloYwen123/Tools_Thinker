Code: from object_detector import Object_Detector_Tool

# Define a function to iterate through the bus image and count the motors.
# Then, count how many "movers" are not on the bus and subtract them from the total count to get the number of motors.
def count_motors():
    # Load the bus image.
    bus_image = object_detector_tool.load_image('bus.jpg')

    # Initialize a counter for "movers" not on the bus.
    mover_count = 0

    # Iterate through the annotated objects.
    for motor in object_detector_tool.get_objects(bus_image, labels=['mover']):
        # Count "movers" not on the bus.
        if motor['label'] != 'mover':
            mover_count += 1
        else:
            mover_count -= 1

    # Return the total count of motors.
    return mover_count

# Call the function and print the result.
motor_count = count_motors()
print(f'Total motors: {motor_count}')

