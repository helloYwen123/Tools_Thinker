Code: from object_detector import Object_Detector_Tool

def count_eating_people_image(image_path):
    detector_tool = Object_Detector_Tool(image_path, save_object=True)
    labels = ["hot dog"]
    threshold = 0.4
    model_size = "tiny"
    detected_objects = detector_tool.execute(labels, save_object=True, model_size=model_size, threshold=threshold)
    
    total_count_dict = {}
    total_count = 0
    
    for detected_object in detected_objects:
        label = detected_object["label"]
        total_count = total_count + detected_object["confidence score"]
        if label == "hot dog":
            total_count_dict[label] = total_count
    
    total_eating_people = len(total_count_dict)
    
    return total_eating_people

final_result = count_eating_people_image("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_51_image_1.jpg")
print("Number of people eating sandwich:", final_result)

