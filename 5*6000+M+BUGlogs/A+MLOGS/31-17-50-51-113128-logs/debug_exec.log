from object_detector import Object_Detector_Tool

def solve_image_questions(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    try:
        obj_list = []
        obj_num = {}
        tool = Object_Detector_Tool()
        tool.open_image(image_image_path=image_path)
        label_count = 0
        for label in labels:
            obj_list.extend(tool.detect_objects(label))
            obj_nums = len(tool.get_object_by_label(label))
            obj_num[label] = obj_nums
            label_count += obj_nums
        obj_dict = {}
        for name, count in obj_num.items():
            obj_dict[name] = count
        if save_object:
            import imageio
            imageio.imwrite("detected_objects/{}.png".format(name), obj_list[0]['image'])
        return obj_dict, label_count, obj_list
    except Exception as e:
        print(str(e))
        return None, None, None

