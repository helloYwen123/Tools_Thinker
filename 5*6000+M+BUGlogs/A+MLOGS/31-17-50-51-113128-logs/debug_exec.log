class Image_Objects:
    def __init__(self, path_to_image, labels, threshold, model_size, save_object):
        self.path_to_image = path_to_image
        self.labels = labels
        self.threshold = threshold
        self.model_size = model_size
        self.save_object = save_object
        self.object_labels = Object_Detector_Tool.extract_objects(self.path_to_image, self.labels, self.threshold, self.model_size, self.save_object)

    def get_objects(self):
        detected_objects = self.object_labels[0]
        objects_counts = self.object_labels[1]
        total_objects = sum(objects_counts.values())
        return detected_objects, total_objects

