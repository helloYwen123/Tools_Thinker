Code: from object_detector import Object_Detector_Tool

def calculate_buses(image_path):
    try:
        detected_objects = Object_Detector_Tool.execute(image=str(image_path), labels=["bus"], threshold=0.45)
        bus_count = len(detected_objects)
        
        return bus_count
    except Exception as e:
        print("Error:", e)
        return 0

# Example usage
