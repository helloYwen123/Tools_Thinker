Code: from object_detector import Object_Detector_Tool

def count_red_buses(image_path, labels=["red"], save_object=True, saved_image_path="detected_objects"):
    detector_tool = Object_Detector_Tool(
        image_path,
        labels=labels,
        save_object=save_object,
        saved_image_path=saved_image_path
    )

    detections = detector_tool.execute()
    total_object_counts = {label: len(detected_object['boxes']) for label, detected_object in detections.items()}

    count = total_object_counts["red"]
    print(f"Number of red buses: {count}")

    return count, total_object_counts

