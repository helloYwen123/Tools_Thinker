tool = odctool.Object_Detector_Tool(image_path=image_path, labels=labels, confidence_threshold=confidence_threshold, model_size="tiny", save_object=True)
# Get detected objects
detected_objects = tool.execute()

# Calculate total number of detections
total_detections = len(detected_objects)

# Calculate proportion of the image occupied by baseballs and baskets
proportion = detected_objects["baseball"] + detected_objects["basket"] / total_detections

# Final result
