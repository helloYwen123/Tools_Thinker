code:from object_detector import Object_Detector_Tool

def yellow_bears_count(object_labels: str) -> int:
    # Use the Object_Detector_Tool to detect objects in the image
    objects, object_count = Object_Detector_Tool.execute(image="path/to/image.jpg", labels=object_labels, save_object=True, saved_image_path="detected_objects")
    # The first element in the returned tuple is a list of dictionaries
    # Each dictionary in the list represents a detected object. Check the "confidence score" property to see if the score is above the threshold
    # The count of detected 'Yellow Bear' is the sum of the 'confidence score' in the first tuple
    yellow_bears_confidence = [obj['confidence score'] for obj in objects[0]['objects'][0]['info']]
    return sum([obj_confidence >= threshold for _, obj_confidence in zip(object_count.items(), yellow_bears_confidence)])

threshold = 0.5  # Confidence threshold for detection (default: 0.45)
final_result = yellow_bears_count("Yellow Bear")
print(f"Yellow Bears: {final_result}")
