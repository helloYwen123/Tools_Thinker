from object_detector import Object_Detector_Tool

def count_yellow_jackets(image_path, labels, threshold=0.45, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
    try:
        detection_result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)
        total_count = len(detection_result[1]['labels'])

        return total_count
    except Exception as e:
        print(f"Error: {e}")
        return None

