# Function to assign gender based on clothing
def assign_gender(base_gender):
    body_groups = {"topless": 0, "female": 1, "male": 2}
    for part in base_gender.split('_'):
        part = part.lower()
        if part in body_groups.keys():
            base_gender = body_groups[part]
            break
    return base_gender

