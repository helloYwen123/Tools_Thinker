# Command to detect objects and count them from the image
def detect_objects(image_path, labels, save_object = False, saved_image_path = ""):
    # Initialize the Object_Detector_Tool
    detector = Object_Detector_Tool()
    # Initialize the labels (object names)
    labels = ["baseball", "basket"]
    
    # Save object images with empty padding
    if save_object:
        detector.save_object("val_Counting_78", labels, image_path)
    
    # Execute the object detection
    detected_objects, object_number = detector.execute(image_path, labels = labels, save_object = save_object, saved_image_path = saved_image_path)
    
    # Get the total count for each label
    total_counts = {}
    for label in labels:
        total_counts[label] = object_number[label]
    
    # Return the total dictionary with labels as keys and total count as values
    return total_counts

