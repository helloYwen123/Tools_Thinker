Code: def count_people(image_path):
    # Set the input types based on the image path and whether person detection is required
    if image_path.endswith((".jpg", ".png")):
        labels = ["people"]
        save_object = True
    else:
        labels = []
        save_object = False
    
    # Use the object_detection tool to detect people
    detected_objects, person_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object)
    
    # Count the number of people
    number_of_people = 0
    for person in detected_objects:
        if "people" in person["label"]:
            number_of_people += 1
    
    return number_of_people

