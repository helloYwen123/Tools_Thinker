from object_detector import Object_Detector_Tool

def count_chicken_nuggets(image_path="val_Counting_55_image_1.jpg"):
    detector_tool = Object_Detector_Tool()
    detector_tool.image = image_path
    label = 'chicken nuggets'
    threshold = 0.5
    model_size = 'tiny'
    save_object = False
    detected_objects = detector_tool.execute(labels=[label], threshold=threshold, model_size=model_size, save_object=save_object)
    
    total_count = {}
    for item in detected_objects[1].values():
        total_count[item[2]] = item[3]
        
    return total_count
