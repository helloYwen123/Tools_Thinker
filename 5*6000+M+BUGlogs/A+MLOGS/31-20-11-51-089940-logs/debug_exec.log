def count_blue_hat_persons(image_path):
    # Load the image and use it as an input to the model
    object_detector = Object_Detector_Tool()
    data = object_detector.execute(image=image_path, labels=["blue_hat"], keep_object=True)
    
    # Get the total count of blue hat people
    total_blue_hat = data["object_number"]["baseball"][1]
    
    # Calculate the percentage of people not wearing a blue hat
    not_blue_hat_percentage = 100 - (total_blue_hat * 100) / len(data["total_objects"])
    
    return not_blue_hat_percentage

