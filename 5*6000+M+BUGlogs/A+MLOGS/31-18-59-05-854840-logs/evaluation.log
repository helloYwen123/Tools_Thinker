from object_detector import Object_Detector_Tool

def has_ski_flip(image_path: str, labels: list, threshold: float=None):
    threshold = 0.45 if threshold is None else threshold
    model_size = "tiny"
    save_object = True
    saved_image_path = f'detected_objects'
    if not os.path.exists(os.path.join(saved_image_path, "skinny_ski_flip.png")):
        detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size)
        detection_confidences = [obj['confidence'] for obj in detected_objects]
        flip_counter = sum(detection_confidences >= threshold for _ in objects)  # Count flip counts
        if flip_counter:
            return True
    return False

