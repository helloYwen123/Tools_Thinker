Code: def count_people(img_path):
    import os
    import cv2
    
    # Load the image
    img = cv2.imread(img_path)
    
    # Check if the image is empty
    if img.shape[0] == 0:
        return 0
    
    # Initialize containers to store people
    people = cv2.minAreaRect(img)[1]
    num_people = 0
    
    # Find people in the image
    for rect, area in zip(people[:3], people[3:]):
        (x, y, w, h) = rect
        area = w * h
        
        # Check if the image is a rectangle rather than a circle
        if (y > x + y) and (x > y):
            continue
        
        # Calculate the bounding box of people
        rect1 = (x - y, y - x)
        
        # Count people within the bounding box
        count = cv2.countNonZero(img[rect1[1]:rect1[1]+h, rect1[0]:rect1[0]+w])
        
        # Add people to the total count
        num_people += count
    
    # Return the total count of people
    return num_people

# Get the image file path from the user
