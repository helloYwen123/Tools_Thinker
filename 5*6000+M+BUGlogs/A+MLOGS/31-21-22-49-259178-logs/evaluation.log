Code: def calculate_meat_in_sandwiches(count_sandwiches: int, hotdogs: int) -> int:
    """Calculate the number of hotdogs in a sandwich."""
    hotdogs_in_sandwich = count_sandwiches - (hotdogs + (hotdogs * 10 + (hotdogs * 10 * 10)))  # One hotdog per 10 hotdogs
    return hotdogs_in_sandwich

