    # Iterate over object_labels
    for label in object_labels:
        # Check if the confidence score is greater than the threshold
        if label in object_counts:
            if threshold < object_counts[label]:
                if type(object_counts[label]) is not int:
                    object_counts[label] = type(object_counts[label]).max()
                else:
                    object_counts[label] += 1
        else:
            # Add the label count to the dictionary
            object_counts[label] = 1

    # Calculate total number of labels detected
