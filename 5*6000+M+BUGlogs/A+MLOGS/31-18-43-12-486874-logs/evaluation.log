Code: def main(args):
    # List of object labels to detect
    labels = ["Almonds", "Nut"]
    
    # Set confidence threshold and model size
    conf_threshold = 0.45
    model_size = "tiny"
    
    # Function to search for the first object with confidence above 0.55
    def find_label_by_conf(conf_threshold, model_size):
        # Create the object detection tool using its arguments
        object_detection_tool = object_detector.create_object_detection_tool()
        
        # Search for the first object with confidence above 0.55
        object_detection_tool.search_for_objects_with_confidence(model_size, conf_threshold)
        
        # Get the list of detected objects
        detected_objects = object_detection_tool.get_detected_objects()
        
        # Initialize a dictionary to count labels
        label_count = {}
        
        # Loop over detected objects and count labels
        for obj in detected_objects:
            # Check if the object name matches one of the labels
            if obj['name'] in labels:
                # Count the label and update the dictionary
                label_count[obj['name']] = int(obj['count']) if obj['count'] is not None else 0
                break
        return label_count
    
    # Main execution
    label_count = find_label_by_conf(conf_threshold, model_size)
    
    # Print final result
    print(f"There are {label_count['Almonds']} big nuts in the green bowl.")
    
if __name__ == "__main__":
