def count_blue_buses(image_path):

    classifier = Object_Detector_TOOL()
    data = classifier.objects_from_image_path(image_path)
    
    label_counts = data["output_type"][0]["label"]

    blue_bus_count = count_to_lowercase(label_counts["baseball"]["count"])
    
    return float(blue_bus_count)

# Define the function that counts the number of blue buses in a specific image.
def count_to_lowercase(count):
    blue_buses = [x for x in count if x.lower() == "blue"]
    
    return len(blue_buses)

