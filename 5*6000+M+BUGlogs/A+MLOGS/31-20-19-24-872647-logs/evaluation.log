class Main:
    def __init__(self):
        # Load the image and generate bounding boxes
        self.labels = ['baseball', 'basket']
        self.threshold = 0.45
        self.model_size = 'tiny'
        self.save_object = True
        self.saved_image_path = 'detected_objects'

    def execute(self, image_path, labels, save_object, saved_image_path):
        detector = Object_Detector_Tool(image_path, labels, self.threshold, self.model_size, self.save_object, saved_image_path)
        return detector

    def count(self, image_path):
        detector = self.execute(image_path, self.labels, self.save_object, self.saved_image_path)
        return detector['objects']

