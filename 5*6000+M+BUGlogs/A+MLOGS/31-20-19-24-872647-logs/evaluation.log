def count_white_umbrellas():
    # Load the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_67_image_1.jpg"

    # Detect white umbrellas
    tool = Object_Detector_Tool()
    result = tool.execute(image=image_path, labels=["white_umbrella"], save_object=True, threshold=0.3)
  
    # Initialize a counter for white umbrellas
    white_umbrellas_count = 0

    # Iterate through each detection object and count white umbrellas
    for detection_dict in result["image_result"]:
        label = detection_dict.get('label')
        confidence_score = detection_dict.get('confidence score')
        box = detection_dict.get('box')
        save_image_path = detection_dict.get('saved_image_path')

        if label == "white_umbrella" and confidence_score > 0.3:
            white_umbrellas_count += 1

    return white_umbrellas_count

final_result = count_white_umbrellas()
