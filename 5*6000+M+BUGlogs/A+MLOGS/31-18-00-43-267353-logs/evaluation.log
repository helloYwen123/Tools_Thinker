Code: def yellow_cars_count(image_path):
    model = "detect_object"
    labels = ["yellow car"]
    threshold = 0.45
    model_size = "tiny"
    
    try:
        # Call the Object_Detector_Tool tool with the input parameters
        detected_objects, object_count = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True)
        
        # Collect the count of yellow cars
        yellow_car_count = sum([obj['label'] == 'yellow car' for obj in detected_objects])
        
        # Return the count
        return yellow_car_count
    
