Code: from tensorflow import io
from object_detector import Object_Detector_Tool, load_image

def count_people_skiers(image_path, labels=["b", "o"], model_size="base", save_object=True, saved_image_path="detected_objects"):
    """
    Counts people skiing on a snowy trail.
    The tool uses a groundmasking model to detect skiing people.
    The tool returns a list of object dictionaries for skiing people
    with their bounding boxes and saved image paths.
    """
    
    num_cases, _, _, _ = Object_Detector_Tool.execute(image_path=image_path, labels=labels, threshold=0.45, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    case_num = num_cases['base'] 
    people_skiing = []
    skip_case = False

    if case_num > 0:
        for _, _, box, _ in num_cases['base']:
            x, y, w, h = box
            for case_number in range(case_num):
                if x + w > y:
                    skip_case = not skip_case
            if skip_case:
                break
            people_skiing.append({"label": "skier", "bbox": box, "image_path": f"detected_objects/image_{case_number+1}.png"})
    return people_skiing

