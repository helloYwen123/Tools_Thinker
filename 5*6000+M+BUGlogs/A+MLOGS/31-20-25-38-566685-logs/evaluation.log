    if detector["object_number"] > 0:
        # Add object detection labels to the list
        labels = detector["labels"]
        
        # Calculate total count of objects
        total_count = detector["object_number"]

        # Print the total count
        print(f"The total number of people on the snowboard is: {total_count}")

        return total_count
    else:
        # If the object is not detected, print a message
        print(f"No people detected in the image for sports like cross country skiing.")
        return 0

