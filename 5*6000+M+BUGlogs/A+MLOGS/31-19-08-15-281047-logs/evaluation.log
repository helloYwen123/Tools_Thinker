def count_blue_collars(image_path):
    # Load the object detector model
    detector_tool = Object_Detector_Tool()

    # Set the image path and optional labels, save objects
    args = {
        'image_path': image_path,
        'labels': ['blue collar'],
        'threshold': 0.45,
        'model_size': 'tiny',
        'save_object': True,
        'saved_image_path': 'detected_objects'
    }

    # Execute the model and get the number of blue collars detected
    detected_objects, detection_count = detector_tool.execute(**args)

    # Return the number of blue collars detected
    return detection_count

