Code: from object_detector import Object_Detector_Tool

# Import necessary environment variables
import os

# Function to detect objects in an image and calculate the number of people in the water
def count_people_in_water(image_path):
    # Load image
    object_detector_tool = Object_Detector_Tool()
    img, labels, threshold, model_size = object_detector_tool.execute(image_path, labels=["baseball"], save_object=True)

    # Convert detected object labels to a binary array
    labels_array = [int(label == "baseball") for label in labels]

    # Calculate water count
    water_count = 0
    for i, label in enumerate(labels):
        if labels_array[i]:
            water_count += 1

    return water_count

# Path to the image
