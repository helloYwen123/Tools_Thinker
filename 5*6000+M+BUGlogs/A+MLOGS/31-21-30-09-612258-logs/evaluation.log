Code: from object_detector import Object_Detector_Tool

def count_baseball_players(image_path, labels=['baseball'], save_object=False, saved_image_path="detected_objects"):
    object_detector = Object_Detector_Tool(
        input_types={
            "image": image_path,
            "labels": labels,
            "threshold": 0.45,
            "model_size": "tiny",
            "save_object": save_object,
            "saved_image_path": saved_image_path,
        },
        output_type=[
            {
                "label": "Baseball Player",
                "confidence_score": 0.45,
                "box": [],
                "saved_image_path": "baseball_player_example.jpg"
            },
            # Add more object dictionaries for each detected object
        ],
    )

    objects = object_detector.execute()

    # Check if baseball players are detected
    if "baseball_player_example.jpg" in objects:
        baseball_player_count = objects.get("baseball_player", {}).get("label", 0)
        return baseball_player_count
    else:
        return 0

