code:def count_consonants(board_img: str) -> int:
    detected_objects = Object_Detector_Tool.execute(image=board_img, labels=['letters'], save_object=True, threshold=0.4, model_size='tiny', saved_image_path='detected_objects')
    letter_data = detected_objects['output_type'][0]
    
    letter_counts = {}
    for obj in letter_data:
        if obj['label'].lower() in ['a', 'e', 'i', 'o', 'u']:
            letter_counts[obj['label'].lower()] = obj['confidence score'] * obj['box'][2] * obj['box'][3]
    
    consonant_letter_counts = {k: Letter_counts for k, Letter_counts in letter_counts.items() if letter_counts[k] > 0}
    
    return sum(list(map(lambda con: con[1] > 0.4, consonant_letter_counts.items()))) # Calculate total count of consonant-related letters
    
