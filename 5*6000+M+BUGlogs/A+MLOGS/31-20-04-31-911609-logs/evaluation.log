def count_red_letters(obj_list):
    # Count the total number of "red" letters in the detected objects
    red_letters = sum([int("RED" in str(obj["label"])) for obj in obj_list])
    return red_letters

def count_letters(obj_list):
    # Count the total number of letters in the detected objects
    letters = sum([len(str(obj["label"])) for obj in obj_list])
    return letters

