Code: from object_detector import Object_Detector_Tool

def count_red_letters_in_image(image_path: str, labels: list = ["red_letter_1", "red_letter_2"], threshold: float = 0.45, model_size: str = "tiny", save_object: bool = False, saved_image_path: str = "detected_objects"):
    # Load the image and convert it to grayscale
    gray_image = my_object_detector_tool.load_image(image_path)

    # Detect red letters in the image using the specified labels and threshold
    result = my_object_detector_tool.detect_objects(gray_image, labels, threshold)

    # Count the number of red letters in the detected objects
    red_letter_count = len([obj for obj in result if obj['label'] == 'red_letter_1']) + len([obj for obj in result if obj['label'] == 'red_letter_2'])

    return red_letter_count

def count_red_letters_in_image_path(image_path, labels=["red_letter_1", "red_letter_2"]):
    # Load the image at image_path
    image = my_object_detector_tool.load_image(image_path)

    # Detect red letters in the image using the specified labels and threshold
    result = my_object_detector_tool.detect_objects(image, labels)

    # Count the number of red letters in the detected objects
    red_letter_count = len([obj for obj in result if obj['label'] == 'red_letter_1']) + len([obj for obj in result if obj['label'] == 'red_letter_2'])

    return red_letter_count

# Example command to analyze an image with a specific label count
