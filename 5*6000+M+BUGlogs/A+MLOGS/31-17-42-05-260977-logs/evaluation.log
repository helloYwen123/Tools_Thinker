def count_one_way_signs(image_path):
    # Load image and apply object detection
    object_detector = Object_Detector_Tool(image_path, labels=["one way"])
    detected_objects = object_detector.execute()

    # Total one way sign instances
    one_way_sign_count = sum([obj['labels'] == 'one way' for obj in detected_objects])

    return one_way_sign_count

