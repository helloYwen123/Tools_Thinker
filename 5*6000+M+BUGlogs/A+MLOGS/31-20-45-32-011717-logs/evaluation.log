Code: from object_detector import Object_Detector_Tool

def count_persons(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    """
    Determines how many people are looking through a camera.

    :param image_path: Path to the image file.
    :param labels: List of object labels to detect.
    :param save_object: Boolean value for saving detected objects as images.
    :param saved_image_path: Path to save the detected object images.
    :return: A pair of lists containing the number of people looking through the camera according to the labels.
    """

    obj_detector = Object_Detector_Tool(image_path, labels, save_object, saved_image_path)
    if obj_detector:
        detections = obj_detector.input_output_detection()
        count_people = detections[1].get("baseball", 0) + detections[1].get("basket", 0)
        return count_people
    else:
        return None

# Example usage with the provided image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_62_image_1.jpg"
count_people = count_persons(image_path, ["baseball"], save_object=False, saved_image_path="detected_objects")
if count_people:
    print(f"The image is being viewed by {count_people[0]} and {count_people[1]} people.")
else:
    print("No people detected in the image.")

