Code: import object_detector_tool as ot

def count_cows(image_path, n):
    cropped_image = ot.object_detector.Tool(image=image_path, save_object=False)
    detections = cropped_image.bounding_boxes
    detected_objects = []
    object_count = {}
    for detection in detections:
        label = detection["label"]
        if label not in object_count:
            object_count[label] = 1
        else:
            object_count[label] += 1
        detected_objects.append([label, detection["confidence score"], detection["bbox"], detection["bbox"]])
    return detected_objects, object_count

