Code: from object_detector import Object_Detector_Tool

def count_sign_letters(image_path):
    # Load the object detector tool with default settings
    tool = Object_Detector_Tool()

    # Set the confidence threshold
    tool.confidence_threshold = 0.45

    # Set the model size
    tool.model_size = "tiny"

    # Execute the tool on the image
    tool.execute(image_path)

    # Convert the result into an object detection results object
    detection_results = tool.get_result()

    # Initialize counters for black letter count
    black_letter_count = 0

    # Iterate through each object detected in the image
    for detection_result in detection_results:
        # Extract labels from the detection_result
        labels_str = detection_result["labels"]

        # Split the labels string into individual labels
        labels = labels_str.split(", ")

        # Iterate through each label
        for label in labels:
            # Check if the label is "black"
            if label == "black":
                # Increment the black letter count
                black_letter_count += 1

    # Return the total number of black letters
    return black_letter_count

