Code: from object_detector import Object_Detector_Tool

def count_black_letters(image_path: str):
    try:  # Try to load the image
        image = Image.open(image_path)
    except:  # If FileNotFoundError: If an error occurs when opening the image
        return None

    detector = Object_Detector_Tool.from_path(image_path)
    detected_objects, object_number = detector.execute()

    # Count the number of objects with black letters
    black_letter_count = 0
    for object in detected_objects:
        if object['label'] == "baseball" or object['label'] == "basket":
            if 'letters' in object:
                letters = object['letters']
                black_letter_count += sum(letter == '0' or letter == '1' for letter in letters)

    return black_letter_count

