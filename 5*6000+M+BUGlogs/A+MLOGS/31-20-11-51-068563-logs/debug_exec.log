def count_toilets(image_path, labels=["toilet"], save_object=False, saved_image_path="detected_objects"):
    """Detects toilets in an image using the default base model and threshold."""
    # Load the model and threshold
    model = "base"  # Choose a base model, like 'tiny' for smaller images
    threshold = 0.54  # Specify the threshold
    
    # Execute the object detector tool
    detector_tool = Object_Detector_Tool(image_path, labels=labels, model=model, threshold=threshold)
    detected_objects, object_number = detector_tool.execute()
    
    # Check if a toilet was detected
    if "toilet" in object_number:
        # Count the number of toilets
        total_toilets_count = len(detected_objects['toilet'])
        return total_toilets_count
    
    # If a toilet was not detected, return 0
    return 0

