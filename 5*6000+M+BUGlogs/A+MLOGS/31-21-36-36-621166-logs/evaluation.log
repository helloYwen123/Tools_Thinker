    detection = tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)
    birds = []
    for bird in detection["objects"]:
        for bird_label in detected_labels:
            if bird["confidence"] > 0.45 and bird_label == bird_label:
                birds.append(bird)
    return birds

