Code: def calculate_right_birds(eyes_image, bird_labels, threshold, model_size, save_object, saved_image_path):
    """
    Calculates the number of birds facing the right of the image based on the eyes image.

    Args:
    - eyes_image (str): The path to the image file.
    - bird_labels (list): A list of object labels to detect.
    - threshold (float): The confidence threshold for detection (default: 0.45).
    - model_size (str): The size of the model to use ('tiny' or 'base', default: 'tiny').
    - save_object (bool): Whether to save the detected objects as images (default: False).
    - saved_image_path (str): The path to save the detected object images (default: 'detected_objects'). 

    Returns:
    - int: The number of birds facing the right of the frame.
    """
    bird_labels = bird_labels.split(',')
    count_dict = {}
    for label in bird_labels:
        count_dict[label] = 0

    detected_objects = Object_Detector_Tool.execute(image=eyes_image, labels=bird_labels, save_object=save_object, saved_image_path=saved_image_path)

    if save_object:
        for img_name, img_data in detected_objects.items():
            if img_data['label'] == 'swallows':
                count_dict['swallows'] += img_data['count']

    right_bird_count = 0
    for label, count in count_dict.items():
        if count > 0:
            right_bird_count += 1
            if label in ['swallows'] and threshold < count:
                right_bird_count -= 1
                break

    return right_bird_count

