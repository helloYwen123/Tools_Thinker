def count_birds(image_path, labels=None, save_object=False, saved_image_path="detected_objects", threshold=0.45, model_size="tiny"):
    # Load the model and initialize the Detection_Tool object
    detector_tool = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

    # Detect the birds
    detected_objects, object_number = detector_tool.execute()

    # Calculate the number of birds facing the right of the frame
    birds_right = 0
    for obj in detected_objects:
        if obj["label"] == "b" and obj["conf score"] > 0.45:  # Assuming "b" for bird
            birds_right += 1

    return birds_right

