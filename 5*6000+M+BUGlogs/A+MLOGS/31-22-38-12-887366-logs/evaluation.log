Code: from object_detector import Object_Detector_Tool

def count_people_in_image(image_path, labels=['person'], threshold=0.45, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    detector_tool = Object_Detector_Tool(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    detected_objects = detector_tool.execute()
    person_count = sum([o['label'] == 'person' for o in detected_objects])
    return person_count

