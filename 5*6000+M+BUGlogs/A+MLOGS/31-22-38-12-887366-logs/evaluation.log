Code: from object_detector import Object_Detector_Tool

def count_people_in_image(image_path, labels=['suit'], save_object=False, saved_image_path="detected_objects"):
    """
    Counts the number of people wearing suit in the image.
    
    Parameters:
    - image_path: The path to the image file.
    - labels: A list of object labels to detect (default: ['suit']).
    - save_object: Whether to save the detected objects as images (default: False).
    - saved_image_path: The path to save the detected object images (default: 'detected_objects').
    """
    
    object_detector_tool = Object_Detector_Tool()
    objects_detections = object_detector_tool.execute(image_path, labels, threshold=0.45, save_object=save_object, saved_image_path=saved_image_path)
    
    total_people_in_suit = objects_detections[0].get("label", "")
    return total_people_in_suit

total_people_in_suit = count_people_in_image("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_77_image_1.jpg", labels=["suit"])
