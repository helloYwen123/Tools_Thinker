def find_missing_right(size, total_height, count):
    n_left = total_height * count
    n_right = (size + 1) * (2 * count - 1)
    return n_right - n_left

def calculate_total(height, count):
    total = height * count
    return total

def count_right_sides(size, total_height, count, missing_right):
    total_height_without_missing_right = total_height * count - missing_right
    total_height_with_missing_right = total_height - (count - missing_right) * (2 * count - 1)
    return total_height_without_missing_right + (2 * count - 1) * (total_height_with_missing_right - total_height_without_missing_right)

