def count_non_blue_hats(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=["blue_hats"], save_object=True, saved_image_path="detected_objects")
    blue_hats_data = []
    non_blue_hats_data = []
    total_blue_hats_count = 0

    for object_data in detected_objects:

        # Check if the object is wearing a blue hat
        if object_data["label"] == "blue_hats" and float(object_data["confidence_score"]) >= 0.5:
            total_blue_hats_count += 1  # Increase the count for blue hats
        else:
            non_total_blue_hats = float(object_data["confidence_score"])  # If the object is not a blue hat, convert to a float

            if not non_total_blue_hats:
                non_blue_hats_count = len(non_blue_hats_data) + 1  # If the object is not wearing a blue hat and there's one already, increment count
            else:
                non_blue_hats_data.append(object_data)

    if total_blue_hats_count > 0:
        non_blue_hats = len(non_blue_hats_data)  # Calculate the total count of non-blue hats

        if total_blue_hats_count > non_blue_hats:
            non_blue_hats_count = total_blue_hats_count - non_blue_hats
        total_count = non_blue_hats_count + total_blue_hats_count
    else:
        total_count = 0

    return (total_count, non_blue_hats_count)

