Code: def number_of_non_blue_hat_people(image_path='val_Counting_118_image_1.jpg'):
    """
    This function takes the path to an image as input and returns the count of people not wearing a blue hat based on the specified labels.
    """
    # Load the image
    object_detector_tool = Object_Detector_Tool()
    labels = ["baseball", "basket", "helmet"]  # Example labels to detect
    threshold = 0.45  # Confidence threshold for detection
    model_size = "tiny"  # Size of the model to use
    save_objects = True  # Whether to save the detected objects as images
    saved_image_path = 'Detected_Objects'  # Path to save the detected object images
    if not object_detector_tool.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_objects, saved_image_path=saved_image_path):
        raise Exception("Error executing the object detector tool")
    
    # Detect objects in the image using the Grounding DINO model
    object_labels = object_detector_tool.output_type[0]
    if not all(label in object_labels for label in ["baseball", "basket", "helmet"]) and "all" not in labels:
        raise Exception("Object labels are not all detected")
    
    # Count people not wearing a blue hat
    total_count = 0
    for label in object_labels:
        count = 0
        for person in object_detector_tool.output_type[1].values():
            if person['label'] == label and person['color'] != 'blue':
                count += 1
        total_count += count
    
    return total_count

