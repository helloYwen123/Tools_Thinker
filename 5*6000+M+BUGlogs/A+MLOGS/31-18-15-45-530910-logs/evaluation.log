Code: def count_white_pillows(image_path):
    # Load the bounding box predictions
    boxes = None

    try:
        # Perform object detection
        boxes = object_detector.execute(image_path, labels=["baseball", "basket"], threshold=0.45, model_size="base")

        # Initialize the dictionary to count the total number of white pillows
        pillow_count = {}

        # Loop through the bounding boxes to count the number of white pillows of each label
        for box in boxes:
            label, confidence, (x1, y1, x2, y2) = box
            if label == "baseball":
                if x1 + 1.2 < x2 and y1 - 1.2 < y2:
                    white_count = 1
            elif label == "basket":
                if x1 + 1.2 < x2 and y1 - 1.2 < y2:
                    white_count = 1
            else:
                white_count = 0

            # Add the white_count to the pillow_count dictionary
            if (label, white_count) in pillow_count:
                pillow_count[(label, white_count)] += 1
            else:
                pillow_count[(label, white_count)] = 1

    except Exception as e:
        print(f"An error occurred: {e}")

    # Return the number of total white pillows
    return pillow_count

