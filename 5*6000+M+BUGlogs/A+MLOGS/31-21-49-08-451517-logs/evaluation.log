def count_blue_towels(image_path, labels=["blue"], threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
    detector_tool = Object_Detector_Tool(image_path, labels, threshold, model_size, save_object, saved_image_path)
    detected_objects, object_number = detector_tool.execute()

    # Count blue towels from the detected objects
    num_blue_towels = 0
    for detected_object in detected_objects:
        if detected_object['label'] in labels and detected_object['box'][2] >= 0.5:

            # Assuming a simple threshold for counting
            if detected_object['box'][2] > 0.5:
                num_blue_towels += 1

    return num_blue_towels

