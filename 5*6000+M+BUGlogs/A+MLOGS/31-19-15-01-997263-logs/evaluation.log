Code: from object_detector import Object_Detector_Tool

def toilet_count():
    # Load the image
    detector = Object_Detector_Tool()

    # Define the image path
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_20_image_1.jpg"

    # Perform object detection
    labels = ["toilet"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True

    # Execute the object detection
    objects, object_number = detector.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, saved_object=save_object)

    # Count the toilets
    toilet_count = sum([len(detected_objects) for detected_objects in objects if "toilet" in detected_objects['label']])

    return toilet_count

final_result = toilet_count()
print("Number of toilets:", final_result)

