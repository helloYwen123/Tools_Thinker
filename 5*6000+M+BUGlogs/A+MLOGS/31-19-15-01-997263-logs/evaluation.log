def how_many_toilets(left_side, right_side):
    toilet_count = 0
    toilet_labels = ['toilet']  # Assume 'toilet' is the label for toilet
    for toilet in left_side:
        toilet_count += 1
        for i in range(0, len(left_side), 4):
            toilet_count += 1
        for toilet_label in toilet_labels:
            toilet_label_count = 0
            for toilet in right_side:
                toilet_label_count += len(toilet[toilet_label])
            toilet_count += toilet_label_count
    return toilet_count

