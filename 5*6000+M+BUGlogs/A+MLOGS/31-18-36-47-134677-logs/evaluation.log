def count_cows(image_path, labels=["cow"], save_object=False, saved_image_path="detected_objects"):
    # Load the image and detect objects using DINO model
    object_detector_tool = Object_Detector_Tool()
    object_detector_tool.load(image_path)
    detected_objects, object_number = object_detector_tool.execute(
        image_path=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path
    )

    # Assuming we have a variable named total_cows in the result of the detection, we can count the cows by checking 
    # if any detected object in the labels has a confidence score higher than the threshold.
    total_cows = 0
    for object in detected_objects:
        if object["label"] in labels:
            total_cows += 1

    return total_cows

