Code: import json

def calculate_count(labels):
    label_count = {}
    for label in labels:
        if label in label_count:
            label_count[label] += 1
        else:
            label_count[label] = 1
    return label_count

def count_people(sitting_on_bed_image):
    object_detector = Object_Detector_Tool()
    objects = json.loads(open(sitting_on_bed_image, 'rb').read())
    if 'labels' in objects:
        labeled_objects_data = objects['labels']
        for object_detection in labeled_objects_data:
            if objects['bbox'][object_detection['bbox']][2] <= 0.5:
                continue
            if 'objects' in labeled_objects_data[object_detection['bbox']][0]:
                people_count = labeled_objects_data[object_detection['bbox']][0]['objects'][0]['count']
                if sitting_on_bed_image not in final_result[0]:
                    final_result[0][sitting_on_bed_image] = {'count': 1, 'bbox': objects['bbox'][object_detection['bbox']]}
                else:
                    for obj in final_result[0][sitting_on_bed_image]['bbox']:
                        if 'id' in obj['bbox'] and obj['bbox']['id'] == object_detection['bbox']['id']:
                            if object_detection['bbox'][object_detection['bbox']]['bbox'][2] <= 0.5:
                                continue
                            final_result[0][sitting_on_bed_image]['bbox'].append({'bbox': obj, 'count': people_count})

    return finalize_count()

def finalize_count():
    result = []
    if sorted(list(final_result[0].values()), key=lambda x: x['count'])[::-1]:
        for obj in final_result:
            result.append([f"{obj} ({final_result[0][obj]['bbox']})", round(final_result[0][obj]['count'])])
    return result

