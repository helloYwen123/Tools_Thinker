Code: from object_detector import Object_Detector_Tool

def count_people_playing_games():
    # Replace "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_28_image_1.jpg" with the actual path to the image file
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_28_image_1.jpg"
    
    # Load the labels
    labels = ["playing_games"]
    
    # Convert the image to BGR to make the tool's input format compatible
    image_BGR = image_path.split(".")[0]
    image_BGR = image_BGR.replace("rgb_28", "jpg")
    
    # Execute the tool to detect the labels in the image
    detected_objects, object_count = Object_Detector_Tool.execute(image=image_BGR, labels=labels, save_object=False)
    
    # Filter the detected objects to only those where "playing_games" is present
    valid_objects = [x for x in detected_objects if "playing_games" in x['label']]
    
    # Count the objects where "playing_games" is present
    num_playing_games = sum([x['confidence score'] >= 0.45 for x in valid_objects])
    
    return num_playing_games

# Check the result
num_playing_games = count_people_playing_games()
print(f"Number of people playing games: {num_playing_games}")

