code:def detect_objects(image_path, labels, threshold, model_size='tiny'):
    from object_detector import Object_Detector_Tool
    # Set the threshold for detection
    threshold = 0.45
    # Load the base model and threshold
    det_tool = Object_Detector_Tool(model_size, threshold)
    
    # Execute the detection tool
    objects = det_tool.execute(image_path, labels)
    return objects

def get_object_number(labels, total_counts):
    total_counts = total_counts['labels']
    object_counts = {label: total_counts for label in labels}
    return object_counts

