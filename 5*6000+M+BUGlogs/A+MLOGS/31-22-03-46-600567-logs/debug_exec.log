def get_number_of_objects(image_path, labels, save_object, saved_image_path, model_size, threshold):
    # Load the object detector model
    object_detector_tool = Object_Detector_Tool()

    # Execute the tool with the provided parameters
    (detection_images, object_number) = object_detector_tool.execute(image=image_path, labels=labels, model_size=model_size, threshold=threshold, save_object=save_object, saved_image_path=saved_image_path)

    # Convert the result to a list of dictionaries
    detected_objects = [{'label': obj['label'], 'confidence score': obj['confidence'], 'box': obj['box']} for obj in detection_images]

    return detected_objects

