# Model size
model_size = "tiny"

# Function to detect and save objects
def detect_objects_and_save(image_path, labels, confidence_threshold, model_size, save_object=True, saved_image_path="detected_objects"):
    detector_tool = Object_Detector_Tool(image_path=image_path, labels=labels, confidence_threshold=confidence_threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    if detector_tool.run():
        objects = detector_tool.output_type
        if save_object:
            for obj in objects:
                for key in obj:
                    obj[key].append(1)  # Add 'label' as 1th count
        else:
            total_count = len(objects)
            labels = {lab: count for lab, count in enumerate(total_count)}
            print(f"{total_count} labels detected in the image.")

