Code: from object_detector import Object_Detector_Tool

def count_photovoltaics(image_path, labels, threshold, model_size, save_object=False):
    detector = Object_Detector_Tool()
    
    detections = detector.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)
    
    if detections:
        base_label_names = detections[0]['label']
        total_count = len(detections)

        if save_object:
            return {'base_label_names': base_label_names, 'total_count': total_count}
        else:
            return base_label_names, total_count
    else:
        return [], []

result = count_photovoltaics("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_85_image_1.jpg", ["baseball", "basket"], 0.45, "tiny")
if result:
    base_label_names, count = result
    base_label_count = result[1]

    print(f"Found base label {base_label_names} with {count} occurrences")
else:
    pass

final_result = base_label_count

