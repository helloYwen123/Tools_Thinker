import object_detector

def count_slices_of_tomatoes(path_to_image, save_object=True, saved_image_path="detected_objects"):
    try:
        image = object_detector.load_image(path_to_image)
        object_labels = ["tomato"]
        
        labels_result = object_detector.detect_objects(image=image, labels=object_labels)
        
        total_count, slice_count = calculate_tomato_slices(image, slice_label=object_labels)
        
        if total_count > 0:
            if save_object:
                object_detector.save_detected_objects(selected_labels=slice_label, total_count=total_count, image=image, saved_image_path=saved_image_path)
        
        if slice_count > 0:
            return slice_count
    except Exception as e:
        print(f"Error: {e}")
        return None

def calculate_tomato_slices(image_path, slice_label, save_object=True, saved_image_path="detected_objects"):
    try:
        image = object_detector.load_image(image_path)
        detected_objects = object_detector.detect_objects(image=image, labels=[slice_label])[0]
        
        total_count = detected_objects["count"]
        slice_count = detected_objects["count_sliced"]
        
        if save_object:
            object_detector.save_detected_objects(selected_labels=slice_label, total_count=total_count, image=image, saved_image_path=saved_image_path)
        
        return slice_count
    except Exception as e:
        print(f"Error: {e}")
        return None

def create_total_tomato_count(total_count, sliced_slices):
    total_count += sliced_slices
    return total_count
