Code: def count_detected_objects(image_path, labels, threshold=0.45, model="tiny", save_object=False, saved_image_path="detected_objects"):
    global final_result

    detector_tool = Object_Detector_Tool()
    detected_objects, object_number = detector_tool.execute(image_path, labels, save_object, threshold, model, saved_image_path)

    if detected_objects:
        for obj in detected_objects:
            total_count = obj["confidence score"]
            for label in labels:
                if label in obj["label"]:
                    object_number["{} {}".format(label, total_count)] = obj["box"]
                    break

    final_result = {"object_number": object_number, "total_objects": object_number["baseball"] + object_number["basket"], "total_detected_objects": sum([int(x) for x in object_number.values()])}
    return final_result

