def count_purple_planes(image_path):
    detected_objects = {}
    total_count = 0
    plane_images = []

    plane_detector = Object_Detector_Tool(image_path)
    planers = plane_detector.execute(labels=["purple"], threshold=0.45, model_size="base", save_object=True)

    for plane_detection in planers[0]:
        if plane_detection['label'] == "purple":
            colored_planes = plane_detection['label'] + " plane"
            colored_planes_label = colored_planes.replace(' ', '_')
            total_count += plane_detection['confidence score']
            plane_images.append({
                'label': colored_planes_label,
                'confidence score': plane_detection['confidence score'],
                'box': plane_detection['box']
            })

    detected_objects.append({"plane objects": total_count, "purple planes": len(planers[0])})

    return detected_objects

