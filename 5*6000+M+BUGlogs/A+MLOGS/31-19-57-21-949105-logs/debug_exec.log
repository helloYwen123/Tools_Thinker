class Image_Processor:
    def calculate_blue_buses(self, image_path):
        image = object_detector.Image_Detector_Tool(image_path, label=["bus"], threshold=0.45, model_size='small', save_object=True, saved_image_path="detected_objects")
        label_counts = image.output_data[0]
        for label in label_counts:
            if label["label"] == "bus" and int(label["confidence score"]) > 0.3:
                return len([bus for bus in label_counts if bus["label"] in ["blue bus"]])
        return -1

