from object_detector import Object_Detector_Tool

def count_green_trains(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    try:
        detector = Object_Detector_Tool(image=image_path, labels=labels, save_object=save_object)
        total_green_trains = len(detector.box)
        return total_green_trains
    except Exception as e:
        print(f"Error occurred: {e}")
        return None

