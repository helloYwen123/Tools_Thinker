def count_total_windows():
    # Path to the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_24_image_1.jpg"

    # Label to detect
    label_to_detect = "window"

    # Threshold for object detection
    threshold = 0.45

    # Size of the model to use
    model_size = "tiny"

    # Path to save the detected object images
    saved_image_path = "detected_objects"

    # Execute the tool with the provided parameters
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=[label_to_detect], threshold=threshold, model_size=model_size, save_object=True, saved_image_path=saved_image_path)

    # Count the total number of windows
    total_windows = sum([obj['label'] == label_to_detect for obj in detected_objects])

    return total_windows

