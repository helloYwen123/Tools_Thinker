def count_windows(image_path):
    tool_metadata = {
        'tool_module_name': 'object_detector',
        'tool_class_name': 'Object_Detector_Tool',
        'tool_description': 'A tool that detects windows in an image using the Grounding DINO model and saves individual window images with empty padding.',
        'tool_version': '1.0.0',
        'input_types': {
            'image': str,
            'labels': list,
            'threshold': float,
            'model_size': str,
            'save_object': bool,
            'saved_image_path': str
        },
        'output_type': (list, dict),
        'demo_commands': [{'command': 'detected_objects, open_image=True', 'description': 'Opens the detected windows and their images. ', 'image=image_path', 'labels="open and detect windows"', 'saved_image_path='}}]
    }
    tool = Object_Detector_Tool(image_path=image_path, labels=["open and detect windows"], threshold=0.45, model_size='base', save_object=True)
    detected_objects = tool.execute()
    open_window_images = [img["name"] for img in detected_objects if img["label"] == "open and detect windows"]
    window_count = len(open_window_images)
    return {'window_count': window_count}

final_result = count_windows('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_24_image_1.jpg')
