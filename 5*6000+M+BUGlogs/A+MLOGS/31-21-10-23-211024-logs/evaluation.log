Code: from object_detector import Object_Detector_Tool

def count_fingers(image_path):
    """Detects fingers using the object_detector tool.

    Args:
        image_path (str): Path to an image file.

    Returns:
        dict: Dictionary with each finger detected in the image.
    """
    # Initialize and run the object_detection tool
    detector = Object_Detector_Tool()
    result = detector.execute(image=image_path)
    
    # Count all instances of the detected object
    total_fingers = len(result)
    
    return total_fingers

