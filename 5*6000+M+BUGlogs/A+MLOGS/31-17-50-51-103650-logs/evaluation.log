Code: from object_detector import Object_Detector_Tool

def count_blue_towels(image_path):
    tool = Object_Detector_Tool()
    tool.confidence_threshold = 0.8
    result = tool.execute(image_path, labels=["blue", "white"], save_object=True, saved_image_path="detected_objects")
    
    total_blue_towels = 0
    for _, label in result:
        if label == "blue":
            total_blue_towels += 1
            
    return total_blue_towels

# Test the function
