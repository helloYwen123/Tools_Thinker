from object_detector import Object_Detector_Tool

def count_elephants(image_path, labels, threshold, model_size, save_object=False, saved_image_path="detected_objects"):
    # Load the image
    detector = Object_Detector_Tool(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    detections = detector.detect()

    # Count the elephants
    total_count = count_objects(detections, model_size=model_size)
    
    return total_count

def count_objects(detections, model_size="base"):
    if model_size == "tiny":
        model = 2
    else:
        model = 4

    elephant_count = 0
    for detection in detections:
        if detection["label"] == " elephant ":
            height = detection["bbox"][2] - detection["bbox"][0]
            width = detection["bbox"][3] - detection["bbox"][1]
            length = detection["bbox"][4] - detection["bbox"][2]
            area = height * width
            obj_count = area / model
    
            if model == 2:
                obj_count *= 4
            elif model == 4:
                obj_count *= 4

            if obj_count > 0:
                elephant_count += 1
    return elephant_count
