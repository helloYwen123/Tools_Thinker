def count_wearing_glasses():
    # Path to the image file
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_15_image_1.jpg"

    # Labels to detect (e.g., 'glasses', 'hate', 'laptop')
    labels = ['glasses']

    # Confidence threshold
    threshold = 0.5

    # Model size (default: 'tiny')
    model_size = 'tiny'

    # Save object images
    save_object = True

    # Path to save the detected object images
    saved_image_path = 'detected_objects'

    # Initialize the detector
    detector = Object_Detector_Tool(image_path, labels, threshold, model_size, save_object, saved_image_path)

    # Get the total number of detections
    detection_count = detector.detection_count

    return detection_count

