    total_people_wearing_glasses = None  # Initialize a variable for the number of people wearing glasses

    # Check if there are objects with a confidence score above the threshold
    if len(detected_objects) > 0:
        # Iterate through detected objects
        for det_obj in detected_objects:
            # Check if the object has a confidence score above the threshold
            if det_obj["confidence_score"] > threshold:
                # Obtain the confidence score and other useful information for each detected object
                confidence, box = det_obj["confidence_score"], det_obj["box"]

                # Extract the x and y coordinates of the bounding box
                x0, y0, x1, y1 = box["topleft"][0], box["topleft"][1], box["bottomright"][0], box["bottomright"][1]

                # Iterate through the list of object labels to find an object with confidence score above the threshold
                for label in labels:
                    # Check if the object with the specified confidence score exists in the image
                    if int(obj_det.find_object(image_path, label, x0, y0, x1, y1)) > 0:
                        confidence_per_label = det_obj["confidence_score"][str(int(obj_det.find_object(image_path, label, x0, y0, x1, y1))))

                        # If the object has a confidence score above the threshold, count the number of people wearing glasses in this specific object (which is typically baseball or basket)
