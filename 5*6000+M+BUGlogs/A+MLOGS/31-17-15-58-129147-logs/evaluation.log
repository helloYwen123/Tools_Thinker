def count_tennis_rackets(image_path, labels=None):
    from os import path

    # Check if the image file exists
    if not path.exists(image_path):
        return 0  # Image not found

    # Execute the object detector tool
    label_to_count = 'tennis racket'
    output = Object_Detector_Tool.execute(image=image_path, labels=[label_to_count], save_object=True)

    # Count the presence of tennis rackets
    detected_objects = output[0]
    num_tennis_rackets = sum([bbox["label"] == label_to_count for bbox in detected_objects])

    return num_tennis_rackets

