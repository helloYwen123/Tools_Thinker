def count_tennis_rackets(image_path, label="tennis", threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
    """Detects tennis rackets in an image using the default base model and threshold. Returns a list of detection dictionaries."""
    
    # Load the image
    # Load the labels for the object detector tool
    # Load the input types
    tool_output = None
    detected_objects = None
    object_number = None
    
    try:
        # Execute the object detector tool
        tool_output = Object_Detector_Tool.execute(image=image_path, labels=[label], save_object=True, saved_image_path=saved_image_path)
        
        # Calculate the total count of the detected object
        # This is just an example, actual implementation may differ for different tool configurations or object definitions
        if tool_output["label_counter"]["count"] == 1:
            object_number = 1  # A tennis racket has only one tennis racket
        
        # Return the result
        return [tool_output], object_number
    
    except Exception as e:
        print(f"An error occurred: {e}")
        
# Example usage
