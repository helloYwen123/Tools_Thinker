code:from object_detector import Object_Detector_Tool

def count_people_wearing_solid_red_shirts(image_path):
    # Load image
    blob = cv2.dnn.blobFromImage(cv2.imread(image_path), 1/255, (300, 300), swapRB=True)
    model = cv2.dnn.readNetFromTiff("C:/Python39/datasets/Face_detector/data/Face_detector_5000_0.data", "C:/Python39/datasets/Face_detector/data/Face_detector_5000_1.data")
    #Detect people
    people = model.predict(blob)
    # Find individuals wearing red shirts
    red_shirt = []
    for i in range(len(people)):
        #Check if individual is wearing red shirt
        if people[i][3][0] > 0.45:
            red_shirt.append({1: [i, 0]}) 
    #Count number of individuals wearing red shirt
    count = len(red_shirt)
    return count

