Code: def get_kumquat_count(image_path="path/to/image.png", labels=["kumquat"], threshold=0.45, model_size="tiny", save_object=False, saved_image_path='detected_objects'):
    # Load the image for detection
    try:
        image = object_detector.load_image(image_path)
        # Load the labels and threshold
        labels += ["kumquat"]  # Add "kumquat" label
        threshold += 0.05  # Increase the threshold
        # Detect objects
        objects = object_detector.detect_objects(image, labels, threshold, model_size, save_object=save_object, saved_image_path=saved_image_path)
        # Get the count for 'kumquat' label
        object_count = {
            "kumquat": objects[0]["count"] if objects[0].get("label") == "kumquat" else 0
        }
        # Print the detected objects and their count
        if save_object:
            object_detector.draw_box(image, objects[0]["bbox"][0], objects[0]["bbox"][1], objects[0]["bbox"][2], objects[0]["bbox"][3])  # Draw bounding box
            object_detector.save_object(image, detected_objects, objects[0]["bbox"][0], objects[0]["bbox"][1], objects[0]["bbox"][2], objects[0]["bbox"][3])
        return object_count
    except Exception as e:
        print(f"Error: {e}")
        return None

# Example command
