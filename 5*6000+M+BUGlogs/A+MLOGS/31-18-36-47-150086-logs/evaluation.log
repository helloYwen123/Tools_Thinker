def count_kumquats(image_path, labels, threshold=0.45, model_size='tiny'):
    result = []
    with Object_Detector_Tool(image_path, labels, threshold, model_size=model_size) as obj_detector:
        detected_objects = obj_detector.execute()
        for obj in detected_objects:
            label = obj['label']
            count = int(obj['confidence score'])
            result.append({'label': label, 'count': count})
    return result

