Code: def detect_objects(image_path, labels, threshold, save_object=False, saved_image_path="detected_objects"):
    detector_tool = Object_Detector_Tool()
    result = detector_tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold)
    if result:
        labels_count = len(result[1])
        final_result = f"Number of players wearing red shirts: {labels_count}"
    else:
