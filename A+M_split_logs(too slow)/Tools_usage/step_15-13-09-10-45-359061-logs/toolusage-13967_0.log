import object_detector

def find_desklamp_position(image_path):
    # Load the image and perform object detection
    image = object_detector.execute(image=image_path, labels=["desk_lamp"], save_object=True, saved_image_path="detected_objects")

    if len(image[0]["detected_objects"]) == 0:
        return "There is no DeskLamp detected in the image."

    # Get the position information of the detected DeskLamp
    obj_info = image[0]["detected_objects"][0]
    # Extract the coordinates from the detected DeskLamp box
    (x0, y0), (x1, y1), (x2, y2), (x3, y3) = obj_info['bbox']

    return f"The DeskLamp is located at (x0, y0) with coordinates (x1, y1), (x2, y2), and (x3, y3)."

# Test the script
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13967_0.png"
final_result = find_desklamp_position(image_path)
print(final_result)
```

