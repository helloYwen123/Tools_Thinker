import object_detector  # Import the Object_Detector_Tool class

def calculate_distances(room_image_path):
    """
    Estimate the real-world distances between objects in an image.

    Parameters:
    room_image_path (str): The path to the room image.

    Returns:
    dict: A dictionary with distances between each pair of objects.
    """

    # Load the image
    image = cv2.imread(room_image_path)

    # Detect objects in the image
    detected_objects, object_number = object_detector.execute(image=image, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

    # Get bounding box coordinates and confidence scores for each detected object
    objects_info = [{
        'bbox': (tuple_bbox), 'score': confidence
    } for _, label in detected_objects.items() for tuple_bbox, confidence in label.items() if label is not None]

    # Estimate pixel-level depth
    image_depth = Pixel_Depth_Tool.execute(image_path=[room_image_path], output=True, outdir='./vis_depth')

    # Return the distances between each object pair
    distances = {
        (o1, o2): np.linalg.norm(np.array([o1[1] - o2[1], o1[0] - o2[0]]) for o1, o2 in zip(objects_info, reversed(objects_info)))
        for i in range(len(objects_info) - 1)
    }

    return distances

# Example usage
room_image_file = 'path/to/room_image.png'
distances = calculate_distances(room_image_file)
