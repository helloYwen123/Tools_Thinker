import os
import numpy as np
from object_detector import ObjectDetector_Tool, Pixel_Depth_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool
from PIL import Image

# Load and process the image
image_path = 'path/to/image.png'  # Replace with the actual image file path
label = ['baseball', 'basket'].random()
save_object = False
save_image_path = os.path.join('detected_objects', f'detected_{label}')
try:
    obj_detector = ObjectDetector_Tool()
    detected = obj_detector.execute(image=image_path, labels=label, save_object=save_object)
    detected_objects = detected['detected_objects']

    text_detector = Text_Detector_Tool()
    results = text_detector.execute(image=image_path, languages=['en', 'de'], detail=None)
    text_blocks = results['text_blocks']

except Exception as e:
    print(f"Failed to retrieve object distance: {e}")

# Compute distance between objects using pixel level depth estimation
obj_detector = ObjectDetector_Tool()
obj_detector.threshold = 0.69
obj_detector.model_size = 'tiny'
output_object_depth = False
output_depth_path = os.path.join('visualize_depth', f'visualize_{label}')
depth_estimation = Pixel_Depth_Tool()
depth_estimation.execute(image_path=image_path, output=output_object_depth, outdir=output_depth_path)

# Calculate distances using the depth estimates
for detected_obj in detected_objects:
    detected_obj['depth'] = np.fromfile(os.path.join(output_depth_path, f'assets/{detected_obj["image"]}_depth_map.npy'), dtype=np.float32)
    detected_obj['distance'] = np.sqrt(cv2.absdiff(detected_obj['image'], obj_detector.read_image_detection(detected_obj['bbox']))**2)

# Output the calculated distances
for obj in text_blocks:
    for block in obj['text_blocks']:
        print(block['bbox'], obj['bbox'], block['distance'])

# Save the list of the calculated distances in a file
file_path = 'distance_list.txt'
np.savetxt(file_path, detected_objects['distance'])
```

This Python program first loads the image and performs object detection using the `Object_Detector_Tool`. It then calculates the distances between detected objects. Finally, it outputs the list of distances in a file `distance_list.txt`.
