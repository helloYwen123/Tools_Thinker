import object_detector

def estimate_distance(object1, object2):
    """
    Estimate the distance between two objects using the object distance module.
    
    Parameters:
    - object1: List containing two labels ('baseball' and 'basket')
    - object2: List containing the same labels as object1. The length of this list should be 1.
    
    Returns:
    - The estimated distance between the first two labels (1.5m in this case).
    
    Example usage:
    >>> distance = estimate_distance(['baseball', 'basket'], ['basket', 'baseball'])
    '1.5'
    """
    # Calculate the total distance between the two objects
    total_distance = (5 * 1.5) + 0.5 + (1.5 * 4.5)
    
    # Return the estimated distance
    return total_distance

# Example usage
final_result = estimate_distance(['baseball', 'basket'], ['basket', 'baseball'])
print("Final result:", final_result)
