import commands

def estimate_distance(image_path, distance_estimate):
    pixel_depth_tool = commands["Pixel_Depth_Tool"]
    tool_parameters = {
        "mode": 'image',  # Use the 'image' mode
        "image_path": [image_path],
        "outdir": 'results',  # Directory to save the depth images
        "output": True,  # Save the depth image
        "outdir": './vis_depth',
    }

    depth_results = pixel_depth_tool.execute(**tool_parameters)
    if distance_estimate:
        output_path = '.\\results\\results'  # Specify the output directory
    return depth_results

# Assuming image path is the path to the image
image_path = 'path/to/image.png'

final_result = estimate_distance(image_path, True)
print(final_result)
```

Replace 'path/to/image.png' with the actual path to the image you want to estimate the distance. The program will then generate a list of dictionaries, where each dictionary contains the depth images for each input image and optionally saves them to the specified output directory.
