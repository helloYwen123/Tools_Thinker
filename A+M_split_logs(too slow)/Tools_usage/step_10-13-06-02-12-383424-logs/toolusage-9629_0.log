from object_detector import Object_Detector_Tool

class Image_Analyze:
    def analyze_image(self, image_path):
        detector = Object_Detector_Tool()
        
        # Detect objects using the Grounding DINO model
        detections = detector.execute(image=image_path, save_object=True)

        # Check if the detected objects match the expected locations
        if "baseball" in detections[0] and "basket" in detections[1]:
            baseball_x, baseball_y, basketball_x, basketball_y = detections
            frame = False
            dining_table = False
        
        else:
            self.log("No framed landscape photograph with black wood frame or silver rectangular dining table detected.")
    
        return f"Relative positions: Is the baseball at {baseball_x}, {baseball_y} and is the basketball at {basketball_x, basketball_y}? {frame} and {dining_table}"

# Create instance of the class and provide input path
image_path = "path/to/your-image.png"
result = Image_Analyze().analyze_image(image_path)

if result:
    print(result)
```

