import cv2

# Load the image file
image_path = 'path/to/image.png'
image = cv2.imread(image_path)

# Define object labels
object_labels = ['brown wooden chair', 'artistic white paper drawing scenario']

# Define detection thresholds and save setting options
object_detection_threshold = 0.35
save_object_path = 'detected_objects'
save_object_options = {'model_size': 'base', 'save_object': True, 'saved_image_path': save_object_path}

# Detect the objects
detected_objects, object_detection_results = Object_Detector_Tool.execute(image=image, labels=object_labels, save_object=save_object_options['save_object'])

# Print the detected objects
print("Detected chairs:", detected_objects)

# Check which chair is closer to the camera
closest_chair_number = None
closest_chair_2_dist = float('inf')
closest_chair_1_dist = float('inf')
for chair_label, chair_detection in detected_objects['baseball']:
  if chair_detection['bbox'][0] < object_detection_threshold:
    closest_chair_number = chair_label
    closest_chair_1_dist = chair_detection['bbox'][0] - detected_objects['brown wooden chair']['bbox'][0]
    closest_chair_2_dist = chair_detection['bbox'][0] - detected_objects['artistic white paper drawing scenario']['bbox'][0]

# Print the closest chair
if closest_chair_number:
  print("Closest chair to the camera:", closest_chair_number)
  print("Distances to the brown wooden chair:", closest_chair_1_dist, "pixels away")
  print("Distances to the artistic white paper drawing scenario:", closest_chair_2_dist, "pixels away")

