    # Save object result to saved_path if save object is True
    saved_image_path = './detected_objects'

    # Call the Tool
    detection = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path=saved_image_path, model_size=model_size)
    text_results = detection.text_results[0]

    # Find the coordinates of the TV stand
    try:
        tv_stand_box_coordinates = text_results[1]
        print(f"TV stand coordinates: {tv_stand_box_coordinates}")
