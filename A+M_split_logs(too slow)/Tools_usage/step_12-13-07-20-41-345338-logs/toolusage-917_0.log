            tv_stand_distance = box[2] - bounding_boxes[-1][2]  # 0 based index
            tv_stand_relative = tv_stand_distance / bounding_boxes[-1][2]
            tv_stand_x = bounding_boxes[2][0] - tv_stand_distance  # -1 for 0 based indexing
            x1, y1 = bounding_boxes[0]
