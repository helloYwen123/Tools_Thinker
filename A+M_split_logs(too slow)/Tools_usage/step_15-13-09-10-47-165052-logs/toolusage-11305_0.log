from object_detector import Object_Detector_Tool, Text_Detector_Tool
from letter_detector import Letter_Detector_Tool
import os

def count_tables(image_path):
    detected_objects = []
    object_number = {}

    # Detect objects in the image
    classified_objects = []
    if 'basket' in image_path:
        detected_objects = Object_Detector_Tool.execute(image_path, languages=['zh'], threshold=0.8)
        object_number['basket'] = len(detected_objects)
    elif 'baseball' in image_path:
        detected_objects = Object_Detector_Tool.execute(image_path, languages=['en'], threshold=0.6)
        object_number['baseball'] = len(detected_objects)

    # Save detected objects as images or text
    if 'ball_game' in image_path:
        detected_objects = Object_Detector_Tool.execute(image_path, languages=['zh'], threshold=0.8)
        detected_objects, object_number = Object_Detector_Tool.execute(image_path, languages=['zh'], threshold=0.8, save_object=True, saved_image_path='detected_objects')

    if object_number == 1:
        print("How many dining tables are visible in the scene?")
        print("There is 1 dining table.")
    else:
        print(
            f"How many dining tables are visible in the scene? {len(detected_objects)}"
        )

# Run the script
count_tables('path/to/image.png')

