from object_detector.object_detector import Object_Detector_Tool, text_detector

def count_DiningTable(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=["Dining Table"], save_object=True)

    object_number = {}
    for label in detected_objects.keys():
        if label == "Dining Table":
            total_objects = detected_objects[label]["num"]
            object_number[label] = total_objects

    return object_number

total_objects = count_DiningTable('path/to/image.png')
print('Number of Dining Tables in the image:', total_objects)

