detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['black wood chair with four legs with respect to countertop c x'], save_object=True, saved_image_path='detected_objects')

object_overlap = {}

for detected_object in detected_objects:
    if 'black wood chair with four legs' in detected_object['bbox']:
        x_overlap = 0
        y_overlap = 0
        for obj in detected_objects:
            if x_overlap >= obj['bbox'][0].right and x_overlap >= detected_object['bbox'][0].left and y_overlap >= obj['bbox'][0].bottom and y_overlap >= detected_object['bbox'][0].top:
                break
        else:
            x_overlap = y_overlap = 0

        for obj in detected_objects:
            if obj['bbox'][1].left <= detected_object['bbox'][0].right <= obj['bbox'][1].right and obj['bbox'][0].bottom <= detected_object['bbox'][0].top <= obj['bbox'][0].top:
                if obj['bbox'][1].left <= x_overlap and x_overlap <= obj['bbox'][1].right and y_overlap < detected_object['bbox'][0].right+x_overlap:
                    x_overlap = max(x_overlap+obj['bbox'][0].right-detected_object['bbox'][0].left, x_overlap)
                    if obj['bbox'][1].top-y_overlap > detected_object['bbox'][0].top-detected_object['bbox'][0].bottom:
                        y_overlap = obj['bbox'][1].top-y_overlap

        object_overlap[detected_object['bbox']] = (x_overlap, y_overlap)

object_overlap = {k: v for k, v in object_overlap.items()}

