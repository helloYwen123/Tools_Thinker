from object_detector import Object_Detector_Tool

# Configure tool input types
tool_input_types = {
    "image": "str - The path to the image file.",
    "labels": "list - A list of object labels to detect.",
    "threshold": "float - The confidence threshold for detection (default: 0.35).",
    "model_size": "str - The size of the model to use ('tiny' or 'base', default: 'tiny').",
    "save_object": "bool - Whether to save the detected objects as images (default: False)."
}

# Configure tool output types
tool_output_types = {
    "image": "str - The path to the detection image saved with empty padding (usually the original path with a '.png' extension added).
    "detected_objects": "dict - Mapping object labels to a list of detection results (each with box, score, and saved image path).
    "object_number": "dict - Mapping object labels to the number of detected objects in the image"
}

# Create Object_Detector_Tool object
detector_tool = Object_Detector_Tool()

# Define input data
input_data = {
    "image": "path/to/image.png", 
    "labels": ["baseball", "basket"], 
    "model_size": "tiny",
    "threshold": 0.35,
    "save_object": True,
    "saved_image_path": "detected_objects"
}

# Execute detection
output_data = detector_tool.execute(input_data)

# Output
detected_objects = output_data["detected_objects"]
names = output_data["object_number"]
print(f"Detected objects: {detected_objects}")
print(f"Total name count: {names}")
```
