```python
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def detect_text_and_letters(image_path):
    labels = ["text_1", "text_2", "text_3", "text_4", "text_5"]
    
    result = []

    for label in labels:
        detector = Text_Detector_Tool()
        
        for retry_count in range(3):
            try:
                bbox, text, confidence = detector.execute(image=image_path, languages='en', detail=1)
                if bbox:
                    x0, y0, w, h = bbox
                    text_bb = [x0, y0, x0+w, y0+h]
                    label_detected = f"{label} {x0, y0, x0+w, y0+h}"
                    result.append([label_detected, text_bb, confidence])

                    # Optional: Save detected text as image
                    detection_file = f"detected_{label}_text.png"
                    detection_file_path = os.path.join("detected_objects", detection_file)
                    import os
                    os.remove(detection_file_path)
                    # Ensure the detection file is created by this code
                    if label.lower() == 'text_1' or label.lower() == 'text_2':
                        text_detector.save_object_image(image, "detected_objects", text_box=tuple(bbox))
            except Exception as e:
                print(f"Error detected text, continuing with next label: {label}.")
                continue
      
        if all([box for bbox, text, score in result]):
            break
    
    return result

# Generate list of detected text blocks with bounding box, recognized text, and confidence score

final_result = detect_text_and_letters('path/to/your/image.jpg')
print(final_result)

# Output a list of detected text blocks
for text_bb, label_detected in final_result:
    print(f"Detected: {label_detected} bbox: {text_bb}")
```

Please replace `'path/to/your/image.jpg'` with the path of your image before running this code.

This code will process all detected text blocks and, based on the confidence scores and bounding boxes, identify each individual text. It will also generate a list of detected text blocks, each with its bounding box, recognized text, and confidence score for each text.
