    labels_list = detector.detect_objects(img, labels=labels)
    bbox_list = []
    for label in labels_list:
        top_left = label['bbox'][0]
        bottom_right = label['bbox'][2]
        area = (bottom_right[0] - top_left[0]) * (bottom_right[1] - top_left[1])
