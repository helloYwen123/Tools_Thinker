if detected_objects:
    # Fetch the confidence scores
    object_number = {'brown square dining table': detected_objects['brown square dining table'][0]['score']}
    detected_objects[0]['confidence'] = object_number['brown square dining table']['score']
    
    final_result.append((detected_objects[0]['confidence'], 'brown square dining table', object_number))

# Detect text on the dining table
