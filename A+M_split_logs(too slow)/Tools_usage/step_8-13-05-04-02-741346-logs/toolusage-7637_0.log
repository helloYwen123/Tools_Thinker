# Convert text Detection results to letters
if len(result_texts) > 0:
    for text_result in result_texts:
        letters_detected = letter_detector.execute(image=f"image_path/letter_{text_result['bbox'][0]}_{text_result['bbox'][1]}_{text_result['bbox'][2]}_{text_result['bbox'][3]}_{text_result['bbox'][4]}")
        final_result['letter_in_image'].extend([result for result in letters_detected if result])

# Save detected letters and texts to JSON file
import json

json_result = json.dumps(final_result, indent=4)

print(f"Final_result: {json_result}")
```

