    object_bbox = [tdt.detect_image('B', True).bbox]
    object_score = [tdt.detect_image('B', True).score]
    image_path = [o.boundedbox for o in object_bbox]

    # Check if text detection is successful (retries if necessary)
    result_ltr = ldd.detect_ltr(
        image_path + ['A']  + text_detector.detect_text('all.txt')[1:])
    image_path_ltr = [ltr[1] for ltr in result_ltr]
    
    # Load the depth image
    depth_image = otd.load_depth_image('depth_image.txt', model_size='tiny')
    output_path_depth_image = './vis_depth'
    pixel_depth_estimator = Pixel_Depth_Tool(
        mode='image',
        image_path=image_path + image_path_ltr,
        output=False,
        outdir=output_path_depth_image)
    pixel_depth_estimator.execute()
    
