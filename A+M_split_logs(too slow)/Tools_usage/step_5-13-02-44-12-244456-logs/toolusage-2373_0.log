import pixel_depth_tool

# Execute detection on the image
results = pixel_depth_tool.execute(image_path='path_to_image')

# Extract information about depth maps and output image paths
image_results = {result['image_path']: result for result in results['image_results']}
video_results = {result['video_path']: result for result in results['video_results']}

# Extract bounding box and confidence score for each object
det_object_info = []

for path, results in image_results.items():
  depth_map = results['depth_map']
  depth_mean = depth_map.mean(axis=0)
  
  for object_info in results:
    bbox = object_info['bbox']
    confidence = object_info['score']
    
    # Convert confidence score to int for comparison
    confidence_int = int(confidence)
    if confidence_int <= 0.90:
      object_info['bbox_int'] = bbox
    
    # Calculate Euclidean distance
    distance = ((bbox[0] - depth_mean[0]) ** 2 + (bbox[1] - depth_mean[1]) ** 2)**0.5
    
    # Find closest bounding box and depth mean
    min_bbox = obj for obj in results if distance[i] <= min_bbox_distance and (bbox[0] - bbox[i][1]) ** 2 + (bbox[1] - bbox[i][0]) ** 2 <= min_bbox_distance**2  
        
    closest_bbox = min_bbox[0] if len(min_bbox) > 1 else min_bbox[0]
    
    # If closer to depth mean, put bbox on foreground
    if distance[int(closest_bbox[2])] >= closest_bbox[2]:
      distance[int(closest_bbox[2])] = closest_bbox[2]
      bbox[int(closest_bbox[2])][2] = closest_bbox[nice_to_width] + (bbox[int(closest_bbox[2])][2] - bbox[int(closest_bbox[2])][1])
      bbox[int(closest_bbox[2])][1] = bbox[int(closest_bbox[2])][1] + (bbox[int(closest_bbox[2])][2] - bbox[int(closest_bbox[2])][0])
  
  # Calculate confidence score for object_info_list
  for i, bbox in enumerate(bbox):
    bbox[i][2] = bbox[-1][2] - bbox[-2][1]
    confidence_score_i = (bbox[-1][2] - distance[bbox[i][2]]) ** 2 + (bbox[-1][1] - distance[bbox[i][1]]) ** 2
    confidence_score_i += 4.0 * bbox[-1][3]
    object_info[bbox[i]]['bbox_score'] = round(confidence_score_i, 2)
  
  # Get bounding box score
  object_info = {bbox[i]: {'bbox_score': float(confidence_score_i)} for i, bbox in enumerate(bbox)}

  # Save object_info for further reference
  object_info_list.append(object_info)
  
  # Extract pixel level depth map and bounding box for depth visualization
  depth_img_file = image_results[path]['output_image_path']
  depth_img = cv2.imread(depth_img_file)
  depth_img = cv2.imread(depth_img_file, cv2.IMREAD_ANYDEPTH)

  for i, bbox in enumerate(bbox):
    bbox[i][2] = bbox[-1][2] - bbox[-2][1]
    confidence = float(object_info[bbox[i]]['bbox_score'])
    depth_value = depth_img[bbox[i][2]-bbox[i][1], bbox[i][1]:bbox[i][2]]
    
    # Add bounding box and depth value to object_info_list
    if i == 0:
      object_info_list[0][bbox[i]['bbox_int']] = 0
    elif i > 0:
      object_info_list[0][bbox[i]] = confidence * depth_value
  
  results = {path: results}

# Convert to text format
formatted_results = [{f'Object {item["bbox"]}': item} for item in object_info_list]

formatted_results = {key: value for sub_key, sub_values in formatted_results.items() for key, value in sub_values.items()}  
```

Please make sure to replace 'path_to_image' with the actual image path in your code. This program will estimate the pixel level depth from the image and use it to determine which object is closest to the camera.
