# Import necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool
from pixel_level_depth_estimator import Pixel_Depth_Tool

# Define final_result variable as an empty string
final_result = ""

# Check image if contains any objects
if isinstance(image, dict):
    detected_objects = image["detected_objects"]
    object_number = image["object_number"]
else:
    detected_objects = []
    object_number = 0

# Check if text exists in the image
if isinstance(text, list):
    results = text["results"]
else:
    results = []

# Try to detect objects and text
for det_box in detected_objects:
    label = det_box["labels"][0]
    box = det_box["bbox"]
    detection = det_box["det"]
    confidence = det_box["confidence"]
    final_result += f"Detected {label} with box ({box[0], box[1]}, {box[2], box[3]}), score {confidence}\n"

for txt in results:
    letter = txt["recognized_text"].upper()
    box = txt["bbox"]
    confidence = txt["confidence"]
    final_result += f"Detected letter '{letter}' with box ({box[0], box[1]}, {box[2], box[3]}), score {confidence}\n"

# Try to detect letters from the input image
if results:
    for txt in results:
        letter = txt["recognized_text"].upper()
        final_result += f"Detected letter '{letter}': bbox ({txt["bbox"][0]}, {txt["bbox"][1]}, {txt["bbox"][2]}, {txt["bbox"][3]}), score {txt['confidence']} - detected with height {txt['bbox'][2]} and width {txt['bbox'][3]-txt['bbox'][0]}\n"

# Save detected objects as images
final_result += "\n".join(f"{'detected_objects'}: {' '.join(str(detection['bbox']))} with {detection['bbox']} box, score {detection['confidence']}\n" for _, detection in detected_objects.items())
if save_image:
    for img in image_results["assets"]:
        path = os.path.join(get_current_timestamp(), img)
        depth_output = {"assets": {'image': image_results["assets"][img]}, "output_image_path": path}
        image_results["assets"].update(depth_output)

if output_video:
    for img in image_results["video"]:
        path = os.path.join(get_current_timestamp(), img)
        depth_output = {"video_depth_map": image_results["video"][img][::-1], "output_video_path": path}
        image_results["video"].update(depth_output)

# Output the final result and clean results
print(final_result.strip())
print(image_results)
