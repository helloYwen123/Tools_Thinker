import object_detector as otdool
import text_detector

def detect_chairs(image_path, labels=["chair"], language="en", detail=0, show=False, outdir="./"):
    detected_objects = otdool.execute(
        image=image_path, 
        labels=labels, 
        languages=[language], 
        detail=detail, 
        output=True, 
        saved_image_path=f"detected_objects"
    )

    if detected_objects.get("baseball", None):  # Check if a baseball was detected
        detected_objects = detected_objects.get("baseball", tuple())

    if detected_objects:
        object_number = len(detected_objects)

        detected_objects, object_number = tuple(detected_objects)

        return f"3 chairs visible in the scene." if object_number >= 3 else f"2 chairs visible in the scene."

    else:
        return "0 chairs visible in the scene."

if __name__ == "__main__":
    image_path = "path/to/image.png"
    chairs = detect_chairs(image_path, labels=["chair"])
    print(chairs)

    # Check the correctness of the detected chairs using the text detector tool
    result = otdool.execute(image_path, languages=["en", "de"], show=False)
    print(result)

    # Check the correctness of the detected chairs using the letter detector tool
    letter_result = letter_detector.execute(image_path)
    if letter_result:
        detected_letters = letter_result[0]  # Assuming 'results' has lists of bbox
        print(detected_letters)
```

