import ImageDETector_Tool
import Text_Detector_Tool

# Example usage:
image_path = 'path/to/image.png'
labels = ['bed', 'text']  # List of labels to detect
save_object = True  # Save detected objects as images
saved_image_path = 'detected_objects'

# Detect beds
detected_objects = ImageDETector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
print(f"Detected Beds: {detected_objects['bed'] =}")

# Detect text
text_results = Text_Detector_Tool.execute(image_path=image_path, languages=['en'])
print(f"Detected Text: {text_results =}")

# Combine results
final_result = {
    'beds': detected_objects['bed'],
    'text': text_results
}

print(f"Final Result: {final_result}")
```

Replace `'path/to/image.png'` with the actual path to your image file, and adjust the `labels` and `text` lists to the specific labels you want to detect. This code will print two lists: the first lists all the beds detected in the image, and the second lists all the text detected in the image. Finally, it will combine these lists and print the final result of the combined detected text and beds. Make sure to adjust this code to use the specific image and labels of your scenario.
