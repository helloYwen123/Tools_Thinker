from object_detector import Object_Detector_Tool

def detect_objects_and_count(labels=['baseball', 'basket'], image_path='image.png', save_object=True):
    result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object)
    
    predicted_labels = []
    predicted_objects = {}

    for label in labels:
        prediction = result["detected_objects"][label]
        predicted_labels.append(label)
        predicted_objects[label] = prediction
        if prediction:
            box = prediction["bbox"]
            box = [min(box[0] + box[2] * 0.5, result["image_shape"][1] - 2 * box[2] + 1), 
                    min(box[1] + box[3] * 0.5, result["image_shape"][0] - 2 * box[3] + 1), 
                    max(box[0] + box[2] * 0.5, 1), 
                    max(box[1] + box[3] * 0.5, 1)]
            predicted_objects[label] = {"bbox": box, "score": prediction["score"], "saved_image_path": prediction["saved_image_path"]}
    
    return {"predicted_labels": predicted_labels, "predicted_objects": predicted_objects}

# Example usage
import sys
sys.path.append('/path_to/object_detector_tool')
import object_detector

result = object_detector.Execute.execute(image="image.png", labels=["baseball", "basket"], save_object=True)
detected_objects = result[0]["detected_objects"]
predicted_labels = result[1]["detected_objects"]
predicted_objects = result[2]["detected_objects"]

final_result = {"predicted_labels": predicted_labels, "predicted_objects": predicted_objects}

