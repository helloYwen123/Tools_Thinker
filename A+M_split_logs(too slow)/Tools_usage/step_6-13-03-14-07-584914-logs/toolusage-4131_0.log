from tool.module_name import Pixel_Depth_Tool
from tool_class_name import Pixel_Depth_Tool
from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool
from letter_detector_tool import Letter_Detector_Tool

# Load the objects
objects = []

for i in range(len(input_image)):
    results = Object_Detector_Tool.execute(image=input_image[i])

    for j in range(len(results)):
        objects.append([results[j]['box'], results[j]['bbox'], results[j]['score']])

# Load the languages for text detection
languages = [
    'en',
    'ja'
]

# Load the text detection results
text_results = Text_Detector_Tool.execute(image=input_image, languages=languages)

# Load the letter detector results
results = Letter_Detector_Tool.execute(image=input_image)

# Estimate the depth of each object using the Pixel Depth Tool
depth_results = Pixel_Depth_Tool.execute(image=results, output=False, outdir='./vis_depth')

# Extract the distance and confidence for each object from the depth results
for i in range(len(depth_results)):
    distances = [x['bbox'] for x in depth_results[i]['depth_map']]
    best_distance = min(distances)
    estimated_depth = depth_results[i]['depth_map'][best_distance]
    Confidence = depth_results[i]['bbox'][2] - depth_results[i]['bbox'][0]

    print(f"Estimated depth of object {i+1} is {estimated_depth}. Confidence score is {Confidence}")

# Output the distance of each object from the camera
for i in range(len(depth_results)):
    object_details = objects[i]
    for distance in depth_results[i]['depth_map']:
        print(f"Object {i+1} is {distance} pixels away from the camera.")

