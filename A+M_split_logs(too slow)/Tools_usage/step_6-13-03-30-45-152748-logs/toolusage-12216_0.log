import object_detector  # Necessary for detecting objects in the image

# This function will be used to execute the Object_Detector_Tool and get the results.
def analyze_image(image_path, labels=None, threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
	if save_object:
		from .object_detector import execute
		return execute(image_path=image_path, labels=labels, thresholds=[0.5, 0.35], model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
	else:
		return None

# This function will be used to get the detected objects in the dictionary format.
def get_detected_objects(image_path=None, labels= None, threshold=0.35, model_size='tiny'):
	if image_path is None:
		from object_detector import execute
		return execute(image_path=image_path, labels=labels, thresholds=[0.5, 0.35], model_size=model_size)
	else:
		return None

# The tool function to get the results will be executed after the image has been processed by the function above.

def get_results(image_path=None, labels= None, threshold=0.35, model_size='tiny'):
	if image_path is None:
		from object_detector import execute
		return execute(image_path=image_path, labels=labels, thresholds=[threshold], model_size=model_size)
	else:
		return None

# Set the image path, labels, and other parameters
image_path = 'path/to/image.png'
labels = ['baseball', 'basket']

# Get the results
detected_objects = get_results(image_path, labels, threshold=0.5, model_size='tiny')

print(detected_objects)
```

Save the above code in a file named `objects_detector.py`. The `analyze_image`, `get_detected_objects`, and `get_results` functions should now be called with appropriate arguments to retrieve the results and analyze the image.
