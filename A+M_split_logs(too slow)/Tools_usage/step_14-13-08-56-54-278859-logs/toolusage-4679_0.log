def count_paintings():
    # Open objects Detector Tool
    tool = Object_Detector_Tool()

    # Execute object_detector tool with save_object=True
    result = tool.execute(image="SAT_images_train/4679_0.png", save_object=True, labels=["painted wall"])

    # Get the total count for each detected label
    total_count = {label: result[1].get_label_number(label, "object_number", "total_label_count") for label in result[1]}
    
    # Print the total count
    print(f"Total count of paintings: {total_count['painted wall']}")

