from object_detector import Object_Detector_Tool

def answer_question():
    image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/11659_0.png'
    saved_image_path = 'detected_objects'
    
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=['painting'], save_object=True, saved_image_path=saved_image_path)
    print(f"Number of paintings: {object_number['painting']}")
  

if __name__ == '__main__':
