from text_detector import Text_Detector_Tool

final_result = {"closest_object": None}
result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en'], detail='0')
results = result.execute([result])
for result in results:
    x, y, width, height = result[0]["bbox"]
    letter_found = result[0]["letter"]
    if letter_found and letter_found not in [f[0] for f in final_result.values()]:
        final_result["closest_object"] = {"bbox": (int(width * x), int(y) - int(height / 2), int(width * (x + 1)), int(y) + int(height / 2)), "letter": letter_found, "confidence": result[1]["score"]}
print(final_result)

