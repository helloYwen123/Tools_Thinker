from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Load the bounding boxes labeled
def load_labels(file_path):
    labels = []
    with open(file_path) as f:
        for line in f:
            labels.append(line.strip())
    return labels

# Load the image
def load_image(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=load_labels('labels.txt'), save_object=True)
    object_number = Object_Detector_Tool.execute(image=image_path, labels=load_labels('labels.txt'), object_number=True, saved_image_path='detected_objects')
    return detected_objects, object_number

# Load the frame
from object_detector import Text_Detector_Tool

detector = Text_Detector_Tool()
labels = get_labels("labels.txt")
results = detector.execute(image='image.png', languages=['en', 'de'], languages=['ch_sim'])
letter_detection = detector.execute(image='image.png')
