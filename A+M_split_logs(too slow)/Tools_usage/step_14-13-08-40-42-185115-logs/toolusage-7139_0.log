import object_detector
import text_detector
import numpy as np
import letter_detector
import pixel_depth_estimator

def calculate_liquidity(image_path, labels, languages, detail):
    result = None
    try:
        objects = object_detector.execute(image_path, labels, languages, detail)
        if 'baseball' in objects and 'basket' not in objects:
            result = text_detector.execute(image_path, languages)
        elif 'basket' in objects and 'baseball' not in objects:
            result = letter_detector.execute(image_path)
            if result:
                letters = [f"[{item['box'][0]}-{item['box'][2]}] {item['box'][2]} {item['score']} {'.' if item['score'] > 0.9 else ''}" for item in result if item['score'] > 0.9]
                result = '\n'.join(letters)
    except Exception as e:
        print(f"Error: {e}")
    return result

def estimate_depth(image_path, outdir, detail):
    image_results = []
    try:
        for image_path in image_path:
            image_results.append(pixel_depth_estimator.execute(image_path, [image_path], True, outdir))
        if len(image_results) > 0:
            depth_output = {image_path: image_results[0]}
            if outdir:
                for output in image_results:
                    depth_output[output['output_image_path']] = output
            return depth_output
    except Exception as e:
        print(f"Error: {e}")
    return None

def calculate_liquidity_of_solid_object(object, path_to_image, languages):
    object_results = []
    for image_path in path_to_image:
        object_results.append(text_detector.execute(image_path, languages))
    object_results.sort(key=lambda x: x['bbox'][2]-x['bbox'][0])
    for obj in object_results:
        obj['bbox'] = [int(c) for c in obj['bbox']]
        if obj['bbox'][2]-obj['bbox'][0] > object['bbox'][2]-object['bbox'][0] * 0.1 and obj['bbox'][2]-obj['bbox'][0] > object['bbox'][2]-object['bbox'][0] * 0.15:
            return True
    return False

image_path = ["path/to/image.png"]
languages = ["en", "de"]  # English and German
depth_path = ["path/to/depth/output.mp4"]

liquidity_of_solid_object_results = calculate_liquidity_of_solid_object(
    object=dict(height=100, width=200),
    path_to_image=image_path,
    languages=languages
)  # For example 1
liquidity_results = estimate_depth(image_path, depth_path, 0)  # For example 2

for result in liquidity_results["image_results"]:
    print("Detected letter:", result["input_image_path"])
    print("Detected letters:", result["input_image_path"])
    for det in result["depth_output"]:
        print(det)

final_result = liquidity_results
print("Final answer:", final_result)
