from object_detector import Object_Detector_Tool

# Parameters
image_path = "path/to/image.png"
image_labels = ["DeskLamp"]
confidence_threshold = 0.35
model_size = "tiny"
save_object = True

# Function to execute the tool and return the results
def run_object_detector(image_path):
    result = Object_Detector_Tool.execute(image_path=image_path, labels=image_labels, threshold=confidence_threshold, model_size=model_size, save_object=save_object)
    return result

# Example execution
result = run_object_detector(image_path)
if result:
    # Process the detected objects, for instance, calculate total number of objects
    total_objects = len(result)

    # Use a simple example for the final result variable assignment
    final_result = f"Total objects in the image: {total_objects}"
else:
    final_result = "Error: No detected objects found."

if final_result:
    print(final_result)
else:
    print("No detected objects found.")

