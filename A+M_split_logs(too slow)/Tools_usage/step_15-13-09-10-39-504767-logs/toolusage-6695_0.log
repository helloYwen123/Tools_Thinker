import object_detector

# Path to the image file
image_file_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/6695_0.png'

# Labels to detect (e.g. "baseball", "basket")
labels = ['baseball', 'basket']

# Confidence threshold
threshold = 0.35

# Use the 'tiny' model size
model_size = 'tiny'

# Save objects as images
save_objects = True
saved_image_path = 'detected_objects'

# Run object detection
detected_objects = object_detector.object_detector.execute(image=image_file_path, labels=labels, save_objects=save_objects, model_size=model_size, threshold=threshold, saved_image_path=saved_image_path)

# Count the total number of objects for each label in the detected_objects
object_number = {}
for label, objects in detected_objects.items():
    if label in object_number:
        object_number[label] += len(objects)
    else:
        object_number[label] = len(objects)

# Print the final answer (number of objects for each label)
final_result = [label + ' : ' + str(object_number[label]) for label, objects in detected_objects.items()]
print(final_result)
```
This code uses the `object_detector` tool to detect objects in the specified image file. It saves individual object images with empty padding and counts the total number of objects for each label. The final result is printed as a list of dictionaries.
