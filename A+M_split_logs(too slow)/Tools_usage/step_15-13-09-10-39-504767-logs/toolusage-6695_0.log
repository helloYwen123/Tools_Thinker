import re

def find_in_room(window_loc, dresser_loc, image_path):
    image = Image.open(image_path)
    detected_objects = []

    for label in "baseball, basket":

        letter_boxes = letter_detector(image.open(image_path), label)
        for bbox, letter in letter_boxes:
            if window_loc and window_loc.top <= bbox[1] < window_loc.bottom + window_loc.height and \
               dresser_loc and dresser_loc.left <= bbox[0] < dresser_loc.right + dresser_loc.width:

                line = [str(label), letter, str(bbox[1]-bbox[0])]
                detected_objects.append((" ".join(line), None))

    if detected_objects: 
        return detected_objects
    else:
        return []

