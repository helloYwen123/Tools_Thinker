from object_detector import Object_Detector_Tool

# Initialize the Object_Detector_Tool
obj_tool = Object_Detector_Tool()

# Create a list of label strings that include 'baseball' and 'basket'
labels = ['baseball', 'basket']

# Set the confidence threshold for detection (default: 0.35)
confidence_threshold = 0.35

# Set the size of the model used ('tiny' or 'base', default: 'tiny')
model_size = 'tiny'

# Set whether to save the detected objects as images (default: False)
save_object = True

# Define additional parameters such as image file paths and any necessary arguments
image_path = 'path/to/image.png'
labels_string = 'baseball, basket'

obj_tool.execute(image=image_path, labels=labels, conf_threshold=confidence_threshold, model_size=model_size, save_object=save_object)

# Extract the objects detected (label_string contains both 'baseball' and 'basket', so we'll check for both)
detected_obj = obj_tool.execute(image=image_path, labels_string=labels_string)

# Check for the presence of 'baseball' and 'basket' in the detected objects
if 'baseball' in detected_obj and 'basket' in detected_obj:
    print("Window (highlighted by a red box) is in the same room with the artistic colourful white paper drawing scenario (highlighted by a blue box).")
else:
    print("The Window (highlighted by a red box) is not in the same room with the artistic colourful white paper drawing scenario.")

# Get the object names (each label string corresponds to one object)
obj_names = obj_tool.execute(image=image_path, labels=labels).keys()
print("The Window (highlighted by a red box) is an {}.".format('\n'.join(obj_names)))
```

