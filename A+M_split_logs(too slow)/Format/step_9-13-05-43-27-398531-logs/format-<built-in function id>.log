import torch

class Object_Detector_Tool:
    def execute(self, image, labels, save_object=True, saved_image_path="detected_objects"):
        img = torch.from_image(image)
        x, y, h, w = img
        detections = self.detection_engine(x, y, h, w, labels)
        img_obj = self.img_generator(img, detections)
        if save_object:
            img_obj.save(saved_image_path)
            print(f"Image {image} saved as {saved_image_path}")
        return img_obj, set(detections)

