  object_number[label] = image_number
  letter_results = Letter_Detector_Tool.execute(image=detected_objects)
  for bbx, letter, score in letter_results:
    print(f"Detected letter with bounding box {bbx}, recognized text '{letter}' found, with confidence score {score}")
