from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool
from pixel_level_depth_estimator import Pixel_Depth_Tool
from Text_Detector_Tool import Text_Detector_Tool
import os
import numpy as np

# Load image and detect objects
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(
    image='1573_0.png',
    labels=['baseball', 'basket'],
    save_object=True,
    saved_image_path='detected_objects'
)

# Load detection results
text_detector_tool_en = Text_Detector_Tool()
detected_text_en = text_detector_tool_en.execute(image='1573_0.png', languages=['en'])

for detected_box, detected_text, score in detected_text_en:
    print(f"Detected text: {detected_text} with score: {score}")

# Estimate pixel-level depth
depth_estimator_tool = Pixel_Depth_Tool()
image_results = depth_estimator_tool.execute(image_path=[
    '1573_0.png', '1573_1.png',
], output=True, outdir='./')

for source, image_path, result in image_results.values():
  if isinstance(result, list):
    for depth_map, image_path, depth_result in result:
      depth_image_path = os.path.join('./vis_depth', os.path.basename(image_path) + '.png')
      if not os.path.exists(os.path.dirname(depth_image_path)):
        os.makedirs(os.path.dirname(depth_image_path))
      np.savez(depth_image_path, assets=image_path, depth_map=depth_map)
      print(f"Saving depth image at: {depth_image_path}")
