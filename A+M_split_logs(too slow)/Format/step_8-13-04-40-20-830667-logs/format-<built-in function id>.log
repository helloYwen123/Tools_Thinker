from object_detector import Object_Detector_Tool

# Initialize Object_Detector_Tool
detector = Object_Detector_Tool()

# Detect dining table
detected_objects_table = detector.execute(
    image="path/to/dining_table_image.png",
    labels=["table"],
    save_object=True,

    # Add options here if needed
    # example option settings:
    # saved_image_path="detected_objects",
    # threshold=0.8, # set according to image quality
)

# Check if dining table was successfully detected:
if len(detected_objects_table["baseball"]) > 0:
    # Get detected dining table bbox
    bbox_table = detected_objects_table["baseball"][0]["box"]
    bbox_table_text = detected_objects_table["baseball"][0]["text"]
else:
    bbox_table = None
bbox_match = None

# Detect window
detected_objects_window = detector.execute(
    image="path/to/window_image.png",
    save_object=True,

    # Add option settings if needed
    # example option settings:
    # saved_image_path="detected_objects",
    # threshold=0.8, # set according to image quality
)

# Check if window was successfully detected:
if len(detected_objects_window["window"]) > 0:
    # Get detected window bbox
    bbox_window = detected_objects_window["window"][0]["box"]
    bbox_match = detected_objects_window["window"][0]["text"]
else:
    bbox_window = None
bbox_match = None

# Output relative positions
relative_positions = f"Dining table is in the {bbox_table_text} of window, relative to its {bbox_match}" if bbox_match else f"Dining table is not related to window."

print(f"The brown rectangular extendable dining table is in the {bbox_match} of window, relative to its {bbox_table_text}.")

