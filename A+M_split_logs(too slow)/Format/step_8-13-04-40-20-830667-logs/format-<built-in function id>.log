import import_tools as io

# Detect any brown rectangular extendable dining tables
detected_tables = io.object_detector(tool_class_name='Object_Detector_Tool', tool_module_name='object_detector', tool_class_name='Object_Detector_Tool', tool_description='Detect brown rectangular extendable dining tables', tool_version='1.0.0')

# Extract bounding box coordinates for each detected dining table
bbox_coordinates = []
for item in detected_tables['detected_objects']:
    bbox = item['bbox']
    width, height, color = [(int(item)) for item in bbox]  # Convert to int for easy comparison
    # Check if window is a part of the bounding box
    window_bbox = [(item for item in bbox if item[-1] == 2)]
    if window_bbox:
        window_bbox = window_bbox[0][-3:]
        window_bbox = [(item for item in bbox if item[-1] == 2)]
    if window_bbox:
        x1, y1, x2, y2 = list(map(int, window_bbox[0][0]))
        x3, y3 = list(map(int, bbox[-1]))
        if x3 >= x1 and x3 <= x2 or y3 >= y1 and y3 <= y2:
            bbox_coordinates.append([bbox[-2], width, height])

window_bbox = [(item for item in detected_tables['detected_objects'] if item['bbox'][0][-1] == 1)]  # Filter out dining tables
window_bbox = [(item for item in detected_tables['detected_objects'] if item['bbox'][-3] == 2), (item for item in detected_tables['detected_objects'] if item['bbox'][-1] == 2)]

# Compare bounding boxes of dining tables with window
if not bbox_coordinates:
    print("There are no brown rectangular extendable dining tables detected. Please provide more information about the objects you want to use for the question.")

final_result = "The brown rectangular extendable dining table is positioned with respect to the window following: " + " - The dining table's x1 (center_left) is " + str(detected_tables['detected_objects'][0]['bbox'][0][0]) + " pixels (with respect to the window). - The dining table's x3 is " + str(detected_tables['detected_objects'][0]['bbox'][0][1]) + " pixels (with respect to the window). - The dining table's y1 is " + str(detected_tables['detected_objects'][0]['bbox'][0][2]) + " pixels (with respect to the window). - The dining table's y3 is " + str(detected_tables['detected_objects'][0]['bbox'][0][3]) + " pixels (with respect to the window)."

print("final_result")
