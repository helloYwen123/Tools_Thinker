```
import object_detector

def analyze_object(image_path, labels):
    # Load the image for object detection
    img = object_detector.detect_objects(image_path, labels)
    
    # Count the objects
    object_count = list_count_detection(img)

    return {
        'dark brown color bed': object_count,
        'Doorway': 0
    }

def list_count_detection(img):
    return len(img['baseball']) + len(img['basket'])

