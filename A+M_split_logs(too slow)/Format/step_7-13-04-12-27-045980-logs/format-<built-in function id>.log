from object_detector import Object_Detector_Tool

# Assume the test image path is 'test_img.png'
detected_objects, object_number = Object_Detector_Tool.execute(image='test_img.png')

# Extract bounding box and score for the brown cube shape wooden material
for label in detected_objects:
    if label['box'][0] == 450 and label['box'][2] == 650 and label['box'][3] == 569 and label['box'][1] == 567:
        num_objs = len(detected_objects)
        break

if num_objs > 0:
    # Calculate distance of the wooden material from the countertop
    if label['bbox'] != []:
        x, y, width, height = (round(x) for x, y, w, h in label['bbox'])
        x1 = x - width // 2
        x2 = x + width // 2
        y1 = y - height // 2
        y2 = y + height // 2
        
        dx = x2 - x1
        dy = y2 - y1
        
        # Calculate the distance of the wooden material from the countertop
        distance = (dx * dx + dy * dy) ** 0.5
        print(f"The distance from the wooden material to the countertop is: {distance:.2f} units")  
else:
    print("No bounding box detected for the wooden material")
