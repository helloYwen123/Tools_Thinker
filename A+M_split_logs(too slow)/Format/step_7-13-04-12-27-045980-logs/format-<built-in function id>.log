    text_results = [{'bbox': box, 'text': text['text'], 'confidence': text['score']} for box, text, confidence in text_results]

    if text_results:
        result[image_path]['text'] = text_results

    # Detect letters
    letter_results = letter_detection_tool.execute(image=image)
    letter_bbox = [bbox for bbox in letter_results if 'letters' in bbox[0]]
    letter_results = [{'bbox': bbox[0], 'name': 'Unknown', 'confidence': 0.00} for bbox in letter_results]

    for bbox, name in letter_results:
        result[image_path]['letter_bbox'] = bbox
        result[image_path]['letter_name'] = name

    print(result)

