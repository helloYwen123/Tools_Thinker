result = {}
for image_path in image_paths:
    image = image_path

    # Detect objects
    detected_objects = object_detector_tool.execute(image=image, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
    
    if "baseball" in detected_objects:
        bbox = detected_objects['baseball'][0]['bbox']
        name = detected_objects['baseball'][0]['name']
        confidence = detected_objects['baseball'][0]['score']
    else:
        name = 'Unknown'
        confidence = 0

    result[image_path] = {'name': name, 'bbox': bbox, 'confidence': confidence}

    # Detect text
