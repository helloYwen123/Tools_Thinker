--- Completion 8 ---
<command>
from object_detector import Object_Detector_Tool, Text_Detector_Tool

# Set the image path and labels
image_path = 'path/to/image.png'
labels = ['baseball', 'basket']

# Execute the object detector
detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels)

# Execute the text detector
results = Text_Detector_Tool.execute(image=image_path, languages=['en'])

object_count = len(detected_objects) + len(results)
final_result = f"The image contains {object_count} objects. "
for label, objects in detected_objects.items():
    final_result += f"{label}: "
    for _ in range(len(objects)):
        box = objects[_]['box']
        score = objects[_]['score']
        box_str = f"({box['x1'], box['y1']}, {box['x2'], box['y2']}), score: {score}"
        final_result += box_str
    final_result += "\n"
if results:
    final_result += "Found text:\n"
    for result in results:
        bbox = result['bbox']
        letter = result['text']
        confidence = result['score']
        box_str = f"({bbox['x1'], bbox['y1']}, {bbox['x2'], bbox['y2']}), letter: {letter}"
        final_result += box_str
else:
    final_result += "No found text."

print(final_result)
</command>
