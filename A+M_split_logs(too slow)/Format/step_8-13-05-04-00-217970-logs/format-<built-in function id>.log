import numpy as np
import os
import cv2

def image_to_array(image_path):
    """Converts an image path to a numpy array."""
    
    # Load the image
    image = cv2.imread(image_path)
    image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    
    # Split the image into RGB channels
    r, g, b = cv2.split(image)
    
    # Convert the channels to float to normalize the intensity levels
    r = np.float32(image.astype(np.float32) / 255)
    g = np.float32(image.astype(np.float32) / 255)
    b = np.float32(image.astype(np.float32) / 255)
    
    return r, g, b

def detect_objects(image_path, labels, threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects'):
    # Load the labels
    with open(labels, 'r') as f:
        labels = f.read().splitlines()
    
    # Detect objects in the image using grounders_dino
    blob = cv2.dnn.readNetFromCaffe('/home/your_user/folder/models/dnn/weights/resnet101_deploy.prototxt', '/home/your_user/folder/models/dnn/weights/resnet101_caffe.pb')
    
    # Get the label index
    label_detector = cv2.dnn.LabelDetector.createLabelDetector(blob)
    
    # Get labels
    labels = [label[i:i + 1] for i in range(len(labels)) if label_detector.detectClasses([image])[0] == labels[i]]
    
    # Detect objects
    blob = cv2.dnn.blobFromImage(image=image, size=(300, 300), mean=(104.0, 177.0, 123.0), swapRB=True)
    blob = blob.reshape((1,300,300,3))
    blob = np.expand_dims(blob, axis=0)
    
    # Create a blob object to store the input data
    blob = np.expand_dims(blob, axis=0)

    # Check if the model size is 'tiny'
    if model_size == 'tiny':
        blob = cv2.dnn.blobFromData(blob, size=(300,300), mean=(104.0,177.0,123.0), swapRB=True)
    else:
        blob = cv2.dnn.blobFromData(blob, size=(300,300), mean=(104.0, 177.0, 123.0), swapRB=True, swapRB=False)
    
    # Perform inference and detect objects with the trained model
    output = cv2.dnn.readNetFromCaffe('/home/your_user/folder/models/dnn/weights/resnet101_deploy.prototxt', '/home/your_user/folder/models/dnn/weights/resnet101_caffe.pb', blob, 0.5)
    
    # Detect objects and labels in the image
    res = {'predictions': []}
    
    for label in labels:
        bbox, score, confidence = cv2.dnn.blobFromData(blob=image).predict()[0]
        
        # Check if the score is above threshold
        if score > threshold:
            # Create a bounding box object
            bbox = dict()
            # Create a text object
            text = ''
            
            # Create an X Y centroid object
            x_min, y_min, x_max, y_max = bbox[0:4]
            bbox = {
                'bbox': [x_min, y_min, x_max, y_max],
                'score': score,
                'confidence': confidence
            }

            # Add a text string to the current string
            text = f'{text} {bbox["score"]:.2f}-{bbox["bbox"]}'
            res['predictions'].append({
                'bbox': bbox,
                'score': score,
                'confidence': confidence
            })
    
    # Find the objects with the highest score
    objects = np.zeros((len(res['predictions']), 4), dtype=bool)
    for i in range(len(res['predictions'])):
        if res['predictions'][i]['score'] > 0.35:
            objects[i] = True
            
    # Draw bounding boxes and labels around the top 5 objects
    image = image.astype(np.uint8)
    for i, (bbox, r, g, b) in enumerate(res['predictions'][:5]):
        # Draw the object's bounding box
        cv2.rectangle(image, (bbox['bbox'][0], bbox['bbox'][1]), (bbox['bbox'][2], bbox['bbox'][3]), (0, 0, 255), 3)
        
        # Draw the object's label on the image
        cv2.putText(image, f"{bbox['score']:.2f}-{bbox['bbox']}", (bbox['bbox'][0], bbox['bbox'][1]), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 0, 255), 1, cv2.LINE_AA)
    
    print('Objects with highest score:', res['predictions'][:5])
