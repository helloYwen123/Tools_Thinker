Here's an example Python program that attempts to answer the question:

```python
import object_detector as od

def detect_objects(image_path, labels=['baseball', 'basket'], save_object=False, saved_image_path='detected_objects'):
    result = od.execute(image_path=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    
    detected_objects = result[0]
    object_number = result[1]

    # Print the detected objects
    print("Detected objects:")
    for obj in detected_objects:
        print(obj[2])

    # Print the total number of detected objects
    print(f"There are {object_number} detected objects.")

# Example usage
