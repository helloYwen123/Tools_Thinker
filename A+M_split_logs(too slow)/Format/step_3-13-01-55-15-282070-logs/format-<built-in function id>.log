<command>
from_tool_object_detector = "Object_Detector_Tool"
from_tool_object_detector_tool_args = {}
from_tool_object_detector_tool_args["image"] = "/path/to/room/1.png"
from_tool_object_detector_tool_args["labels"] = ["drawer", "tv_stand"]
