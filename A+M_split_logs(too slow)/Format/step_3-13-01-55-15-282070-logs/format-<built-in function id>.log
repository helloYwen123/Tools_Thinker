from_tool_object_detector_tool_args["model_size"] = "tiny"
from_tool_object_detector_tool_args["save_object"] = True
from_tool_object_detector_tool_args["saved_image_path"] = "(detected_objects)"

from_tool_object_detector_tool = from_tool_object_detector_tool_class_from_module(
    from_tool_object_detector_tool_module, from_tool_object_detector_tool_class_name
