import torch.tensor

def object_counter(image_path, labels, save_object):
    detected_objects_result = Object_Detector_Tool.execute(
        image=image_path,
        labels=labels,
        save_object=save_object,
        saved_image_path='Detected_objects'
    )
    object_count_result = {detected_objects['label']: detected_objects['count'] for detected_objects in detected_objects_result}
    return object_count_result

# Using the previously found path to detect objects in the scene
object_counter('path_to_image.png', labels=['baseball', 'basket'], save_object=True)['baseball']
