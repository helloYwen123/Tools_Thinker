import os
import numpy as np
from matplotlib import image as mplim

class Object_Detector_Tool:
    def execute(self, image_path, labels, save_object=True, saved_image_path="detected_objects") -> "tuple":
        # Load the image
        with mplim.imread(image_path) as img:
            # Detect objects
            det_boxes = self.detector_model(img, labels=labels)
            # Convert back to numpy array
            det_boxes = np.array(det_boxes)

            # Save the detected objects
            if save_object:
                save_output = saved_image_path.split("/")[-1]
                self.save_object(det_boxes, save_path_dir=saved_image_path, save_name=save_output)

            # Get detection scores
            detection_scores = self.denormalize(det_boxes[:, -1], max_score=0.05)

            # Plot detected objects and their bounding boxes
            self.plot_results(det_boxes, image_path, labels)

            # Get total number of detection boxes
            num_boxes = det_boxes.sum(axis=0).sum()

            return (det_boxes, detection_scores, num_boxes)

    def detector_model(self, img, labels=None) -> "numpy array":
        # Implement detector model
        return self.detector_model_code(img, labels)

    def denormalize(self, det_boxes, max_score=0.45,
                    min_score=0.02, threshold=0.7):

        # Normalize detection scores to a between 0 and 1
        score_diff = self.label_to_score(img=det_boxes, labels=labels) - max_score
        score_diff *= 10 * (threshold - min_score)
        score_diff = max(self.label_to_score(img=det_boxes, labels=labels) - max_score, 0.02)
        score_diff += 0.7 - threshold

        # Apply threshold
        score_diff = score_diff * (1.0/10)
        score_diff = score_diff * (1.0/threshold)

        # Return the normalized detection scores
        return score_diff

    def label_to_score(self, img, labels):  # Custom model, no labels

        # Implement model to calculate score from image
        return self.label_to_score_code(img=img, labels=labels)

    def save_object(self, det_boxes, save_path_dir, save_name):
        # Generate the save filename
        save_path = f'{save_path_dir}/{save_name}'

        # Check that the paths exist
