if result and 'objects' in result:
    objects = result.get('objects', [])
    if 'boxes' in result.get('detected_objects', []):  # Check if there are bounding boxes for the detected objects
        for object in objects:
            if 'bx' in object and 'x1' in object and 'y1' in object and 'x2' in object and 'y2' in object:
                x1, y1, x2, y2 = object['bx']
                if 'boxes' in object and object['boxes']:
                    object_boxes = [box['bx'] for box in object['boxes']]
                else:
                    object_boxes = None
                if 'score' in object:  # Check if there is a score for the object
                    score = object['score']
                else:
                    score = None
                print(f"Found object: {object['id']}, at ({x1}, {y1}), with bounding box ({x2}, {y2}).")
                if object_boxes:
                    for box in object_boxes:
                        object_name = object['label']
                        print(f"Box coordinates for {object_name}: ({box[0]}, {box[1]}, {box[2]}, {box[3]})")
            for box in object_boxes:
                x1, y1 = box[0], box[1]
                if 'bx' in object and x1 in object['bx'] and y1 in object['y1'] and x2 in object['bx'] and y2 in object['y2']:
                    print(f"Box coordinates for detected box '{object_name}', with bounding box ({x1}, {y1}), and score {score}.")
