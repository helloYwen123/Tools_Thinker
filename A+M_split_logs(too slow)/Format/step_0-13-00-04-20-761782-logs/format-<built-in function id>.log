def calculate_area(objs, center=None):
    if center is None:
        center = [len(x) for x in objs]
    A = 0
    for i in range(len(objs)):
        for j in range(len(objs[0])):
            x1, y1, x2, y2 = centrations(objs)[:, i, j]
            if ((x1, y1), (x2, y2)) in centrations(objs):
                A += (center[i] - center[j]) * (center[i] - center[j])
            else:
                A -= (center[i] - center[j]) * (center[i] - center[j])
    return A

def detect_object(image_path, languages=['en', 'de']):
    detector = Text_Detector_Tool()
    results = detector.execute(image_path, languages)
    if len(results) == 0:
        raise Exception("Failed to detect text in the image")
    result = results[0]
    bbox = result[1][0]
    text = result[2]
    confidence_score = result[1][3]
    return bbox, text, confidence_score

def calculate_distance(corners):
    dx = corners[0][0] - corners[2][0] # 0
    dy = corners[0][1] - corners[2][1] # 0
    dx = abs(dx)
    dy = abs(dy)
    return (dx + dy) / 2

def calculate_area_circumscribe(objs):
