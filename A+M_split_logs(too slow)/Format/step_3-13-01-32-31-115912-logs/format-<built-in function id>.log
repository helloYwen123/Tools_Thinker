def count_chairs(image_path):
    import Object_Detector_Tool
    with open(image_path, 'rb') as f:
        res = Object_Detector_Tool.Object_Detector_Tool.execute(image_path="{}".format(image_path), labels=["Chair"], save_object=False, saved_image_path="detected_objects")
        chairs = [res[i]['obj_label'] for i in range(len(res)) if res[i]['obj_label'] == "Chair"]
        return chairs

# The paths of images are generated from the path to the image file.
final_result = count_chairs('/path/to/image.png')
print("Number of chairs: ", final_result[0])
