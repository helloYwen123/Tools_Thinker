```python
import torch
import matplotlib.pyplot as plt

# Define the object_detector tool
class Object_Detector_Tool:
    def __init__(self, model_name='tiny', model_size='tiny', labels=None, **kwargs):
        super().__init__()
        self.model_name = str(model_name)
        self.model_size = model_size
        self.labels = labels
        self.conf_thres = float(kwargs.get('conf_thres', 0.15))
        self.model = torch.jit.script(self.load_object_detection_model())
    
    def execute(self, image, labels=None, **kwargs):
        # Detect objects in the image
        detections = self.model(image=image, labels=self.labels, conf_thres=self.conf_thres)
        # Get the coordinates of the bboxes
        bboxes = self.drawing_detection_boxes(image, detections)
        return bboxes
    
    def load_object_detection_model(self):
        model_path = "path/to/model/model_weights/model.pth"
        device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
        model, _ = torch.hub.load('facebookresearch/dino', 'dino', checkpoint_file=model_path)
        #model = torch.jit.load(model_path)
        #print(model)
        model = model.to(device)
        return model
    
    def drawing_detection_boxes(self, image, detections):
        image = image.permute(2, 0, 1)  # Swap axes for height then width
        image = image.reshape(1, image.shape[0], image.shape[1], 3)
        boxes = torch.asnumpy(detections[0]['bboxes'].numpy())
        for i in range(len(boxes)):
            x1, y1, x2, y2 = boxes[i]
            img = plt.imread(image)
            x, y, width, height = [int(v) for v in img.shape[1:]]
            x = max(0, min(x, x1 + width/2))
            y = max(0, min(y, y1 + height/2))
            width = max(width, x1 - x)
            height = max(height, y1 - y)
            y1, x1, y2, x2 = (y0, x0, y1, x1) if y1 > y0 else (y1, x1, y2, x2)
            img = plt.imshow(img[y1:y2, x1:x2])
            plt.imsave("./path/to/saved/image.png", img)
        return detections[0]['bboxes']
```

You can use this Python program by copying and pasting the code into a Python environment. Then, you can call the `detect_objects` function with an image or a list of image paths, and it will return the bounding boxes of the detected objects.
