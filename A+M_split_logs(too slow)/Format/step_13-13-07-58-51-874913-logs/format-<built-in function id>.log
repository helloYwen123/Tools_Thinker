import os

def count_doorways(image_path):
    # Assuming the image_path is a list of paths to images
    image_paths = image_path
    total_doorways = 0
    for i, image_path in enumerate(image_paths):
        with open(image_path, 'r') as imgfile:
            image = imgfile.read()
        with open(image_path, 'r') as txtfile:
            text = txtfile.read()
            if 'doorway'.lower() in text.lower():
                total_doorways += 1
    return total_doorways

# Example usage
image_paths = ['./image1.png', './image2.png']
total_doorways = count_doorways(image_paths)
print(f'The scene contains {total_doorways} doorway(s)')
</command>
