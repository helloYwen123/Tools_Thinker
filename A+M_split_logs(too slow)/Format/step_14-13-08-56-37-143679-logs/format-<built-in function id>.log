import object_detector
import text_detector
import letter_detector
import pixel_depth_estimator

image_path = 'path/to/image.png'
labels = ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

detected_objects, object_number = object_detector.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
results = letter_detector.execute(image=image_path)
image_results = pixel_depth_estimator.execute(image_path=[image_path], output=True, outdir='./vis_depth')

for result in results:
    txt = result['recognized_text']
    if txt.strip() in object_number:
        for key in object_number:
            if txt.strip() == key:
                object_number[key] += 1
                break
for image_path, image_result in zip(["image1.jpg", "image2.jpg"], image_results):
