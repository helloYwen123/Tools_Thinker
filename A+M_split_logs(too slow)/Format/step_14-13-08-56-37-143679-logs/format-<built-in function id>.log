```python
from object_detector import Object_Detector_Tool

# Define the image file path
image_file_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3227_0.png"

# Define the labels to detect
labels = ["modern chair with striped upholstery", "white color sperical shape office chair"]

# Set the threshold for detection
threshold = 0.3

# Set the model size to 'tiny'
model_size = "tiny"

# Set the save object to True
save_object = True

# Execute the object detection tool
with open(image_file_path) as image_file:
    image = image_file.read()
    objects = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

# Display the results
print("Detected objects:")
for label in objects:
    print(f"{label[0]}: {objects[label]}")
    print(objects['baseball'])

# Calculate the total count of detected objects
total_objects = objects.pop()

print(f"Total detected objects: {total_objects}")
```
