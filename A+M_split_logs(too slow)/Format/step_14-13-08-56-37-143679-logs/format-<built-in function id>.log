from object_detector import Object_Detector_Tool, Letter_Detector_Tool

final_result = []
# Detect modern chair with striped upholstery
modern_chair = Object_Detector_Tool.execute(image='path/to/image.png', labels=['chair'], threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects')

# Detect white area sperical shape office chair
white_office_chair = Object_Detector_Tool.execute(image='path/to/image.png', labels=['office_chair'], threshold=0.35, model_size='tiny', save_object=True)

# Check whether both chair is present in the image
ch1_presence = len([det for det in modern_chair['detected_objects'] if det['box'] != modern_chair['bbox'][2:]] if modern_chair['bbox'] else False)
ch2_presence = len([det for det in white_office_chair['detected_objects'] if det['box'] != white_office_chair['bbox'][2:]] if white_office_chair['bbox'] else False)

# If both chair is present, consider chair with striped upholstery as modern chair
if not (ch1_presence or ch2_presence):
    final_result.append({'A': modern_chair['bbox'], 'B': modern_chair['bbox'].copy()})

# Calculate the total number of modern chairs present in the image
total_chairs = len([det for det in modern_chair['detected_objects'] if det['score'] >= 0.35])

# If the total number of chairs is >= 1, then consider the modern chair as modern
if total_chairs >= 1:
    final_result.append({'C': 'modern chair with striped upholstery'})

print(final_result)
