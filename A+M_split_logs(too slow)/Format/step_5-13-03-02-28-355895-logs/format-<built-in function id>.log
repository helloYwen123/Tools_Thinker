from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def answer_question(question_file_path):
    detected_objects = []
    object_number = []

    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images Train/10452_0.png"
    labels = ["modern brown dresser with six drawers", "left", "right"]
    threshold = 0.35
    model_size = "tiny"

    try:
        detected_objects_image_path = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size).model_outputs[0].fields["bbox"][0]
        detected_objects.append{(detected_objects_image_path, "baseball", "basket", detected_objects_image_path})

        object_number_data = Text_Detector_Tool.execute(image=image_path, languages=["en", "de"])['results'][0]
        object_number.append(len(object_number_data))

        # Extract specific letters
        for lang in object_number_data['languages']:
            detected_objects_image_path = Text_Detector_Tool.execute(image=image_path, languages=lang, output=True, outdir='./').output[0]
            detected_objects.append((detected_objects_image_path, "A" if lang == "en" else "B", f"detected '{lang}' letter", "detected_objects_image_path"))

        # Perform pixel-level depth estimation
        depth_path = "/nfs/data8/liao/wxie/Python/Depth_Images"
        Pixel_Depth_Tool.execute(image_path=[depth_path], output=True, outdir="./")

    except Exception as e:
        print(f"Error occurred: {e}")

    return detected_objects, object_number

