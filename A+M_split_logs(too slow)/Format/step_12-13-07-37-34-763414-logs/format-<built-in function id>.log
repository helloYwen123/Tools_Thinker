        rectx = min(rectx, rectw)
        recty = min(recty, recth)
        cv2.rectangle(thresh, (rectx, recty), (rectx + rectw, recty + recth), (255, 255, 255), 2, flags=cv2.LINE_4)
        cnts = np.append(cnts, [np.array([bbox_x + (bbox[0] + w / 2),bbox_y + (bbox[0] + h / 2),bbox[0] + w, bbox[2] + h], dtype=np.int32)])
        cnts = np.append(cnts, [np.array([rectx, recty + recth, rectx + rectw, recty + recth + 20], dtype=np.int32)])

        for c in cnts:
            perimeter = cv2.arcLength(c, True)
            approx = cv2.approxPolyDP(c, 0.005 * perimeter, True)
            if len(approx) == 4:
                x = approx[0][0] - cntx
                y = approx[0][1] - cntx
                cv2.circle(thresh, (int(x), int(y)), 8, [255, 255, 255], -1)

        depth_image = cv2.drawContours(depth_image, cnts, -1, [255, 255, 255], 2)[rectx:rectx + bbox[0], recty:recty + bbox[2]]

