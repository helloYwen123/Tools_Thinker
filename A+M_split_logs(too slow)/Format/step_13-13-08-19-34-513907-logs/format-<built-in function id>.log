    for image_path in images_path:
        detected_objects.extend(detected_objects)

    object_ids = {obj['id']: obj for obj in objects}
    object_texts = {obj['label'] + str(obj['id']) + '_text': obj for obj in texts['images']} # Example usage with the text detector

    # Detect the dresser
    dresser_bbox = [x['bbox'] for x in detected_objects['dresser']][0]
    dresser_id = detected_objects['dresser'][0]['id']

    # Generate final answer
    final_result = {
        'label': 'dresser',
        'bbox': str(dresser_bbox),
        'confidence': f'{round(detected_objects['dresser'][0]['score'], 3)}'
    }
    
    return final_result

# Execute the tool
result = main()
print(result)
