from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', save_object=False, saved_image_path='detected_objects')

if not final_result:
    print("Error: Could not detect objects in the image.")
else:
    detected_objects = final_result[0]
    detected_object_counts = final_result[1]
    print("Detected objects:")
    print("--------------------------------------")
    for label, details in detected_objects.items():
        # Convert the details list to separate lists
        label_details = []
        for detection in details:
            label_details.append((detection['box'], detection['score'], detection['saved_image_path']))
        label_details = sum(label_details, []).sort(key=lambda x: x[2], reverse=True)

    print(f"Detected objects with scores higher than threshold value: {detected_object_counts['baseball']}")
    print(f"Detected objects with scores higher than threshold value: {detected_object_counts['basket']}")


