from Object_Detector_Tool import Object_Detector_Tool

# Image path
image_path = 'path/to/image.png'

# Labels to detect
labels = ['floating black countertop island']

# Confidence threshold
threshold = 0.35

# Mode of operation (image or video mode)
mode = 'image'

# Output directory
outdir = './vis_depth'

# Initialize the object detector
obj_detector = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, mode=mode, save_object=True, saved_image_path=outdir)

# Perform object detection
results = obj_detector.execute()

# Check if detection failed within the number of retries
if 'detected_objects' not in results:
    print("Error: Could not detect objects.")
else:
    # Print the total number of detected objects
    print(f"Total detected objects: {results['detected_objects']['count']['baseball']}")

    # Print the coordinates of the detected objects
    for result in results['detected_objects']:
        print(f"Label: {result['bbox'][0]}, Score: {result['score']}, Box: [{result['bbox'][0]}, {result['bbox'][1]}, {result['bbox'][2]}, {result['bbox'][3]}]")


