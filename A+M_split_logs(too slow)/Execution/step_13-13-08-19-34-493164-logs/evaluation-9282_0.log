def answer_question_image(path_to_image):
    image = Image.open(path_to_image)
    result = []
    detected_objects_and_object_numbers = {
        'baseball': [],
        'basket': []
    }
    letter_results = {
        'baseball': [],
        'basket': []
    }

    letter_results = letter_detector.execute(image=image)
    detected_objects, object_number = object_detector.execute(image=image, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
    result = detected_objects + letter_results
    final_result = {
        **detected_objects_and_object_number,
        **object_number,
        **letter_results
    }
    return final_result

final_result = answer_question_image('path_to_image.png')
print(final_result)


