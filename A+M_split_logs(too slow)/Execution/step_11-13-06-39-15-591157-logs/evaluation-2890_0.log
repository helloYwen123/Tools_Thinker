from object_detector import Object_Detector_Tool

# Import necessary modules
import numpy as np

# Provide image file paths for demonstration
detected_objects, object_numbers = Object_Detector_Tool.execute(image="path/to/image.png", labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects")

print("Detected objects: ")
for obj, results in detected_objects.items():
    print(f"{obj}: {results}")
    for det in results:
        print(f"{det['box']} - {det['score']}")

print("Object numbers:")
for obj, count in object_numbers.items():
    print(f"{obj} detected {count} time(s)")


