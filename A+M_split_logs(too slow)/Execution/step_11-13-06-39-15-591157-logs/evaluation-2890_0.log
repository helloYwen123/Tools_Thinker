    from_module = 'Image_Detection_Tool'
    import_name = 'Object_Detector_Tool'
    result = import_name.loadToolMethod(f'execute', from_module=f'{from_module}.Tool', class_name=f'{import_name}.Object_Detector_Tool')(
        image='image.png',
        labels=['chair'],
        threshold=0.5,
        model_size='base',
        save_object=True,
