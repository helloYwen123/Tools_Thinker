    for letter_result in letter_results:
        bounding_box = [(x0, y0), (x1, y1), (x2, y2), (x3, y3)]
        letter = letter_result['text']
        depth = letter_result['score']
        letter_info.append([bounding_box, letter, depth])
    
    # Convert letter_info into a single result structure
    results = {}
    for letter_result in letter_info:
        results[letter_result[0][0]] = {'bbox': letter_result[0],
                                         'letter': letter_result[1],
                                         'score': letter_result[2]}
    
    # Extract results from questions
    letters_detected = [results['baseball'], results['basket']]
    detected_letter_results = [letters_detected, results]

    # Process detected letter results
    detected_letter_results = [detected_letter_results[0]
