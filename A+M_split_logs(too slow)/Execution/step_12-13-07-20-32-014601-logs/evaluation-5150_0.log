from letter_detector import Letter_Detector_Tool

# Initialize the letter detector tool with English and German
detector_tool = Letter_Detector_Tool()

# Process the image
results = detector_tool.execute(image=image_path)

# Extract the detected letters and coordinates
for detection_box, letter, score in results:
    bboxes = [[[x0, y0], [x1, y1], [x2, y2], [x3, y3]]]
    texts = [letter]
    scores = [score]
    for bbox, letter, score in results:
        bboxes.append([[x0, y0], [x1, y1], [x2, y2], [x3, y3]])
        texts.append(letter)
        scores.append(score)
    detected_letters = zip(bboxes, texts, scores)
    for bbox, letter, score in detected_letters:
        x0, y0, x1, y1 = bbox
        detection = (x0, y0, x1, y1)
        print("Detected Letter:", letter, "at", detection)


