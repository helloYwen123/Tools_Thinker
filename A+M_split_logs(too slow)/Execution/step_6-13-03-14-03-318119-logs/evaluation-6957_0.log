def answer_question(scene_images, question):
    for image in scene_images:
        try:
            detected_objects = detect_objects(image_path=image, labels={'baseball': 1, 'basket': 2}, threshold=0.35, saved_image_path="detected_objects")
            if 'baseball' in detected_objects and 'basket' not in detected_objects:
                final_result = detected_objects['baseball'][0]['bbox'] + ', ' + 'Basketball is missing!' + detected_objects['baseball'][0]['bbox']
                return final_result
            elif 'basket' in detected_objects and 'baseball' not in detected_objects:
                final_result = detected_objects['basket'][0]['bbox'] + ', ' + 'Baseball is missing!' + detected_objects['basket'][0]['bbox']
                return final_result
            if 'baseball' not in detected_objects and 'basket' in detected_objects:
                final_result = detected_objects['basket'][0]['bbox'] + ', ' + 'Basketball is missing!' + detected_objects['basket'][0]['bbox']
                return final_result
            if 'baseball' in detected_objects and 'basket' in detected_objects:
                final_result = detected_objects['basket'][0]['bbox'] + ', ' + 'Basketball is missing!' + detected_objects['basket'][0]['bbox']
                return final_result
        except Exception as e:
            print(e)
            return "Error: An error occurred while processing the image."
    return "Error: No objects detected."

