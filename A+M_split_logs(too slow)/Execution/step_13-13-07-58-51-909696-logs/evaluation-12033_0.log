from object_detector import Object_Detector_Tool

def answer_question():
  # Step 1: Load the image
  image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12033_0.png"

  # Step 2: Use the object_detector Tool to detect windows and TV
  detections = Object_Detector_Tool.execute(image=image_path, labels=["window", "tv"], save_object=True, saved_image_path="detected_objects")

  # Step 3: Print the results
  print("Detected windows and TV:")
  print(detections, sep='\n')

  # Check the correctness of the answer with the given labels
  correct_answers = {"window": 0, "tv": 1}
  actual_results = detections["detected_objects"]
  for label in correct_answers:
    if label not in actual_results:
      print(f"Incorrect: '{label}' detected, but not expected!")
      return None

  print("All detected objects are as expected.")

if __name__ == "__main__":
  answer_question()


