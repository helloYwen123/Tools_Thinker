import numpy as np

def pixel_depth_estimator(image_path, output=True, outdir='./vis_depth'):
    image_data = np.zeros((50, 50), dtype=np.uint16)
    
    if outdir == None:
        outdir = './vis_depth'
    
    np.save(outdir + '/image1.npy', image_data)
    
    if output == True:
        np.save(outdir + '/image1_depth.npy', image_data)

    return {'image1': {'depth_map': image_data, 'output_image_path': outdir + '/image1_depth.png'}}

