from Object_Detector_Tool import Object_Detector_Tool

final_result = {
    "further away": False,
    "in front": False
}

# Detect
detected_objects = Object_Detector_Tool.execute(image='path/to/image.png', labels=['chair', 'table'], save_object=True, saved_image_path='detected_objects')

# Calculate number of chairs and tables
object_number = {label.split(':')[0]: 0 for label in detected_objects}
total_object_count = {label.split(':')[0]: 0 for label in detected_objects.keys()}

# Check chair and table counts
if chair in detected_objects or table in detected_objects:
    final_result["further away"] = True if chair in detected_objects else False
    final_result["in front"] = True if table in detected_objects else False

# Print the final result
print(final_result)


