from pixel_level_depth_estimator import Pixel_Depth_Tool

# Define the input images and their paths
image1_path = 'path/to/image1.jpg'
image2_path = 'path/to/image2.jpg'
video1_path_list = ['path/to/video1.mp4', 'path/to/video2.mp4']
video2_path_list = ['path/to/video3.mp4', 'path/to/video4.mp4']

# Estimate the pixel-level depth images
image_results = Pixel_Depth_Tool.execute(image_path=[image1_path, image2_path], video_path_list=video1_path_list, outdir='./vis_depth', output=True)
video_results = Pixel_Depth_Tool.execute(image_path=[image1_path, image2_path], video_path_list=video2_path_list, outdir='./vis_depth', output=True)

# Process and print the depth image paths for each object
for i in range(len(image_result_keys)):
    pixel_depth_image_path = image_results[image_result_keys[i]]['output_image_path']
    depth_image_path = video_results[image_result_keys[i]]['output_video_path']
    print(f"{image_result_keys[i]}: {pixel_depth_image_path}, {depth_image_path}")


