    def __init__(self):
        self.object_results = []

    def render_objects(self, image):
        for result in self.object_results:
            image = draw_object(image, result['label'], [result['bbox']], result['score'])
        return image

	def draw_objects(self, image):
        for result in self.object_results:
            image = draw_object(image, result['label'], [result['bbox']], result['score'])
        return image

