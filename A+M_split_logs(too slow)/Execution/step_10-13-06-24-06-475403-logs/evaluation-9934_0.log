from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool
from groundtruth_generation_tool import GroundTruth_Generation_Tool

class ImageProcessor:

    @staticmethod
    def detect_labels(image_path, labels = None, threshold = 0.35, model_size = 'tiny', save_object = True,
                       saved_image_path = 'detected_objects'):
        if not labels:
            labels = ['baseball', 'basket']
        predictions = []
        object_results = []
        object_count = {'baseball': 0, 'basket': 0}

        object_tool = Object_Detector_Tool()
        letter_tool = Letter_Detector_Tool()

        for label in labels:
            if label == 'baseball' and save_object:
                image, object_labels = object_tool.execute(image=f'{image_path}{label}_{saved_image_path}')
                object_count[label] += len(object_labels)
                letter_tool.execute(image=image, language='en')

                results = letter_tool.execute(image=image).get('Letters')

                if results:
                    for result in results:
                        box = result.get("bbox")
                        bbx = (box['bx'][0] - 25, box['by'][0] - 25, box['bx'][1] + 25, box['by'][1] + 25)
                        letter = ' '.join([c.get("w") for c in letter_tool.execute(image=image).get('Letters'])[0].get('words'])

                        object_results.append({'bbox': bbx, 'label': label, 'score': result['confidence'], 'letter': letter})

            if label == 'basket' and save_object:
                image, object_labels, number_of_objects = object_tool.execute(image=f'{image_path}{label}_{saved_image_path}', labels=labels,
                                                                                language='en')
                letter_tool.execute(image=image, language='de')

                results = letter_tool.execute(image=image).get('Letters')

                if results:
                    for result in results:
                        box = result.get("bbox")
                        bbx = (box['bx'][0] - 25, box['by'][0] - 25, box['bx'][1] + 25, box['by'][1] + 25)
                        letter = ' '.join([c.get("w") for c in letter_tool.execute(image=image).get('Letters'])[0].get('words'])

                        object_results.append({'bbox': bbx, 'label': label, 'score': result['confidence'], 'letter': letter})

        if save_object:
            output_results = {output: {'bbox': [bbox for box in object_results], 'label': label, 'score': score, 'letter': letter}
                              for output, results in object_results.items()}
            if outputs['basket']:
                output_results['assets/image1.mp4'][{'assets/image1.mp4': {'video_depth_map': results, 'output_video_path': save_image_path.split('.')[0] + '_output.mp4'}}]
            if outputs['baseball']:
                output_results['assets/image1.mp4'][{'assets/image1.mp4': {'video_depth_map': results, 'output_video_path': save_image_path.split('.')[0] + '_output.mp4'}}]

        image_results = {'assets/image1.jpg': {'depth_map': results, 'output_image_path': saved_image_path}}
        return {'label_count': object_count}

    @staticmethod
    def image_to_video(image, modes, output = True, outdir = './vis_depth'):
        """Estimates pixel-level depth from an image file"""

        results = object_to_video(image_result = image, mode = modes['image'], output = output, outdir = outdir)
        return results


class GroundTruth_Generation_Tool:

    @staticmethod
    def generate_granular_grafting(input_path = None, ground_truth_path = None, output_name = None):
        if input_path is None:
            return None
        return input_file_to_granular(input_path, ground_truth_path, outputs = output_name)

    @staticmethod
    def export_granular_grafting(input_path, ground_truth_path, outputs = None):
        results = ''
        if outputs is not None:
            results = import_granular_grafting_to_json(input_path, ground_truth_path, output = True, nolocal = True)
        elif fileExists(input_path):
            return input_path
        return results

