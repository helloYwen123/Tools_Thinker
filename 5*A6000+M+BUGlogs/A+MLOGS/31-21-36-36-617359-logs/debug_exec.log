from object_detector import Object_Detector_Tool

# Function to get the number of parking meters in the image
def get_parking_meter_count(image_path):
    obj_dict = {}
    for label in ["baseball", "basket"]:
        for i in range(10):
            img = image_path.split("/")[-1]
            det = Object_Detector_Tool.execute(image=image_path, labels=[label], threshold=0.45, model_size="tiny", save_object=True, saved_image_path=f"detected_objects")
            if label in det[0]['labels']:
                for j in range(len(det[0]['results'])):
                    if det[0]['results'][j]["bbox"]:
                        x, y, w, h = det[0]['results'][j]["bbox"]
                        obj_dict[label] = {"bbox": [x, y, w, h]}

    total_counts = {}
    for label in obj_dict:
        total_counts[label] = len(detected[0]['bbox'] for detected in obj_dict.values())

    return total_counts
