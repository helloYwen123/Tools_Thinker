Solution: 4
Code: from object_detector import Object_Detector_Tool

def count_kids(image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects"):
    tool_options = {
        "image": image_path,
        "labels": labels,
        "threshold": 0.45,
        "model_size": "tiny",
        "save_object": save_object,
        "saved_image_path": saved_image_path
    }
    
    detection = Object_Detector_Tool.execute(**tool_options)
    
    total_kids = sum(tool["object_count"] for tool in detection if tool["label"] in labels)
    
    return total_kids

