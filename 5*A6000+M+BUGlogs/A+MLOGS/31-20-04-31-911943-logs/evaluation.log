def count_green_frogs(image_path):
    # Load the image and detect objects
    detector = Object_Detector_Tool()
    detected_objects = detector.execute(image=image_path)

    # Initialize dictionary to store the count of each green frog
    green_frog_count = {'green_frogs': 0}

    # Iterate over each object and count the instances of green frogs
    for objects in detected_objects['objects']:
        if objects['label'] == 'green_frogs':
            green_frog_count['green_frogs'] += 1

    return green_frog_count

