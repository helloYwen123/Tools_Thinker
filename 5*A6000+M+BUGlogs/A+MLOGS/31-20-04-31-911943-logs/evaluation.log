Code: from object_detector import Object_Detector_Tool

def count_green_frogs_image(image_path, labels, threshold=0.45, model_size='tiny', save_object=False):
    """
    This function counts the number of green frogs in an image.

    :param image_path: The path of the image file.
    :param labels: A list of labels to detect.
    :param threshold: The confidence threshold for detection (default: 0.45).
    :param model_size: The size of the model to use (default: 'tiny').
    :param save_object: Whether to save the detected objects as images (default: False).
    :return: The number of green frogs in the image.
    """
    try:
        # Load the image and detect objects using the DINO model
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold)

        # Get the total number of green frogs
        green_frogs = sum(detected_objects['confidence_score'] == 0.45 for detected_objects in detected_objects if 'baseball' in detected_objects or 'basket' in detected_objects)

        return green_frogs

    except Exception as e:
        return "Error: " + str(e)

