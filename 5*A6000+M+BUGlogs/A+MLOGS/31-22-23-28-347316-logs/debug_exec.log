def count_bats(image_path, labels, labels_count, threshold, model_size, save_object):
    """
    Counts the number of objects in an image using the Grounding DINO model.
    :param image_path:=str - Path to the image file to be analyzed.
    :param labels: list - A list of object labels to detect.
    :param confidence_threshold: float - The confidence threshold for detection (default: 0.45).
    :param model_size: str - The size of the model to use ('tiny' or 'base', default: 'tiny').
    :param save_object: bool - Whether to save the detected objects as images (default: False).
    :param saved_image_path: str - The path to save the detected object images.
    :return: tuple - A tuple containing two elements: a list of dictionaries for each detected object (each with keys 'label', 'confidence score', 'box', and 'saved_image_path'), and a dictionary mapping each label to its total count in the image.
    """
    object_objects = []
    total_labels = []
    for label in labels:
        object_objects.append({"label": label, "confidence score": 0.0, "box": []})

    detector = Object_Detector_Tool(image_path, labels=labels_count, model_size=model_size, threshold=threshold)
    results = detector.detection()

    for result in results:
        for object in result['objects']:
            for box in object['bbox']:
                for object_dict in object_objects:
                    if int(box[0].split(';')[0]) > int(object_dict['box'][0][0]) and int(box[0].split(';')[0]) <= int(object_dict['box'][2][0]) and 
                        int(box[1].split(';')[0]) > int(object_dict['box'][0][1]) and int(box[1].split(';')[0]) <= int(object_dict['box'][2][1]):
                        object_dict['label'] = label
                        object_dict['confidence score'] = result['objects'][object]['confidence score']
                        break

    if saved_object:
        object_objects = sorted(object_objects, key=lambda x: x['confidence score'])
        for object in object_objects:
            filename, extension = os.path.splitext(saved_object + f"_{object['label']}" + '.' + extension)
            Image.open(filename).save(saved_image_path + f"{filename}-{int(time.time())}.jpg")

    total_labels = [len([object for object in object_objects if object['label'] == label]) for label in labels]
    return object_objects, total_labels

