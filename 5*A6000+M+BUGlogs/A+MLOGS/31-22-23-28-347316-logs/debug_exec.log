    - image: str - The image file path.
    - labels: list - A list of object labels to detect.
    - save_object: bool - Whether to save the detected objects as images.
    - saved_image_path: str - The path to save the detected object images.
    """
    import object_detector

    object_detector.execute(
        image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_68_image_1.jpg",
        labels=["baseball bat"],
        save_object=True,
        saved_image_path="detected_objects"
    )

    detected_objects = object_detector.output_type

    for obj in detected_objects:
        if obj["label"] == "baseball bat":
            return obj["count"]

