def count_burners():
    final_result = {}
    path_to_image = 'val_Counting_64_image_1.jpg'
    labels = ['burner_2', 'burner_3', 'burner_4']
    confidence_threshold = 0.3
    model_size = 'tiny'

    with open(path_to_image, 'rb') as file:
        detection_results = Object_Detector_Tool.execute(image=file, labels=labels, save_object=True)

    for object in detection_results:
        if object['label'] == 'burner_2':
            final_result['burner_2'] = object['confidence'] < confidence_threshold
        if object['label'] == 'burner_3':
            final_result['burner_3'] = object['confidence'] < confidence_threshold
        if object['label'] == 'burner_4':
            final_result['burner_4'] = object['confidence'] < confidence_threshold

    total_burner_count = len(final_result.keys())
    return total_burner_count

total_burners = count_burners()
