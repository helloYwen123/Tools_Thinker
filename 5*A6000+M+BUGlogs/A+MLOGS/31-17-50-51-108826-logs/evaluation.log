def detect_objects(frame, labels, threshold=0.45, save_object=False, saved_image_path="detected_objects"):
    detector = Object_Detector_Tool()
    label_output = {}
    for label in labels:
        label_output[label] = detector.detect_labels(frame, threshold=threshold)[0]["confidence score"]
    return label_output

def count_labels(labels, total_label_count):
    count_list = []
    for label in labels:
        count = total_label_count[label]
        count_list.append([label, count])
    return count_list

