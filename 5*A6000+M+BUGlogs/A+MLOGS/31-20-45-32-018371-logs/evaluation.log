def detect_railway_signs(path_to_image, labels, save_object=False, saved_image_path="detected_objects"):
    detection_tool = Object_Detector_Tool()
    detected_objects, object_number = detection_tool.execute(image=path_to_image, labels=labels)
    
    # Calculate the number of drive wheels on the engine
    num_wheels_on_engine = len(detected_objects[0]["class_name"]) - 1 if 'class_name' in detected_objects[0] else 2
    return num_wheels_on_engine

