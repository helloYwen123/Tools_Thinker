def count_drive_wheels(image_path, save_object=False, saved_image_path="detected_objects", labels=["rail"], threshold=0.45, model_size="tiny"):
    with Object_Detector_Tool(
        image_path=image_path,
        labels=labels,
        save_object=save_object,
        saved_image_path=saved_image_path,
        model_size=model_size,
        threshold=threshold
    ) as tool:
        object_number = tool.execute()
        return object_number

def count_drive_wheels(image_path):
