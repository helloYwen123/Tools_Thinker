Code: from object_detector import Object_Detector_Tool

def count_signs_with_arrows():
    # Function to count the number of signs with arrows
    def count_signs_with_arrows(image_path):
        object_detector_tool = Object_Detector_Tool()
        detector_result = object_detector_tool.execute(image_path=image_path)
        
        # Extracting the number of signs with arrows
        arrow_signs = sum([signs["label"] == "one way" for signs in detector_result.values() if signs["label"] == "sign"])
        return arrow_signs

    # Path to the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_105_image_1.jpg"

    # Counting signs with arrows
    arrow_signs = count_signs_with_arrows(image_path)
    final_result = {"Number of signs with arrows": arrow_signs}
    
    return final_result

result = count_signs_with_arrows()
print(result)

