Code: def find_banners(image_path):
    # Load the image using the Object_Detector_Tool tool
    detector_tool = Object_Detector_Tool(image_path, save_object=True)

    # Get list of object labels
    labels = ["Lunch", "Dinner", "Monday", "Wednesday", "Friday", "Saturday"]
    objects = detector_tool.execute(labels=labels, threshold=0.45, saved_object=True)

    # Count the number of banners
    total_banners = 0
    for label in labels:
        banner_count = len([obj for obj in objects if obj['label'] == label])
        total_banners += banner_count

    return total_banners

