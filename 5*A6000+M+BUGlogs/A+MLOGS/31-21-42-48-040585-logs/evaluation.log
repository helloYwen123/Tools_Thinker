Code: def count_banners(image_path, labels=['serving', 'lunch', 'dinner', 'saturday'], save_object=True, saved_image_path="detected_objects"):
    """
    Counts the number of banners in the awning based on specified labels.
    
    Parameters:
    - image_path: The path to the image file.
    - labels: A list of object labels to detect.
    - save_object: Whether to save the detected objects as images.
    - saved_image_path: The path to save the detected object images.
    
    Returns:
    A tuple containing the number of banners.
    """
    detector_tool = Object_Detector_Tool(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    detection_list = detector_tool.execute()
    total_count = sum(int(detection['labels'][0][0]) for detection in detection_list)
    return total_count

