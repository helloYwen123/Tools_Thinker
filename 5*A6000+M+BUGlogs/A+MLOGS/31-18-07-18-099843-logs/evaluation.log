Code: def count_signs(image_path, label):
    """Counts the number of signs based on the label given in the path."""
    # Initialize a empty array to store detected signs
    signs = []
    
    # Load the object detector model
    model = torch.hub.load('ultralytics/yolov5', 'ultralytics.yolo_v5')
    
    # Load the image
    image = Image.open(image_path)
    
    # Detect the signs
    bboxes = model(image=image, conf_thres=0.2)[0].bbox
    for box in bboxes:
        # Get the sign label from the box
        label_from_box = box.xywh[4]
        label_from_bbox = label[label_from_box[2]:label_from_box[3]]
        if label_from_bbox[1] < 100 and label_from_bbox[0] >= 100:
            # If the label is within the image boundaries and not in the top or left regions, it's a sign
            if label_from_box[2] < 100 and label_from_box[1] < 100 and label_from_box[3] > 100 and label_from_box[4] > 100:
                sign = {
                    'label': label_from_bbox[1],
                    'bbox': [label_from_bbox[1], label_from_box[2], label_from_bbox[3], label_from_box[4]],
                }
                signs.append(sign)
    
    return signs

