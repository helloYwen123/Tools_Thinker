class Object_Detector_Tool:
    def execute(self, image, labels, save_object=False, saved_image_path="detected_objects"):
        from object_detector import detect_objects, save_object
        objects = detect_objects(image, labels, threshold=0.45, model_size="tiny", save_object=save_object, saved_image_path=saved_image_path)
        total_labels = len(objects)
        count_dict = {}
        for label, count in objects.items():
            total_count = count_dict.get(label, 0) + count
            count_dict[label] = total_count
        return objects, count_dict
