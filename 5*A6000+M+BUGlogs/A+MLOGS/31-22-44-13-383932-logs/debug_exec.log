from object_detector import Object_Detector_Tool

def count_red_coat_people(label_path, threshold=0.45, model_size='tiny', save_object=False):
    # Load the image and model
    image_path = label_path
    obj_deploy = LabelDeploy(image=image_path, threshold=threshold, model_size=model_size)
    object_objects = obj_deploy.execute()

    # Filter objects by category 'baseball'
    baseball_classes = object_objects["baseball"]["bbox"]
    baseball_labels = [obj["label"] for obj in baseball_classes if obj["label"] in ["baseball", "basket"]]

    # Calculate the frequency of baseball players
    total_objects = object_objects["baseball"]["bbox"] + object_objects["basket"]["bbox"]
    baseball_count = sum(1 for label in baseball_labels if label in total_objects)

    return baseball_count
