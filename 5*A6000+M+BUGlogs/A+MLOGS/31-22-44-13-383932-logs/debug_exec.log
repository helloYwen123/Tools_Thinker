from object_detector import Object_Detector_Tool


def count_red_coat_person(image_path):
    object_detector_tool = Object_Detector_Tool()
    object_labels = ["red coat", "back pack"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True

    if "backpack" in object_labels:
        object_labels.remove("back pack")

    if "red coat" in object_labels and "skis" not in image_path:
        object_labels.append("skis")

    detector_output, object_count = object_detector_tool.execute(
        image=image_path,
        labels=object_labels,
        save_object=save_object,
        saved_image_path="detected_objects",
        threshold=threshold,
        model_size=model_size
    )

    total_count = len(detector_output)

    for label in object_labels:
        if label == "red coat":
            final_result.append({"label": label, "count": object_count})

    return final_result
