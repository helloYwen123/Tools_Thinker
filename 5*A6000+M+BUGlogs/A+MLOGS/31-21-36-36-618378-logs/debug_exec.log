# Function to count the number of blue collars
def count_blue_collars(image_path):
    # Load the image
    detector = Object_Detector_Tool()
    detections = detector.execute(image_path, labels=("blue",), save_object=False)
    
    # Check if a blue collar has been detected
    is_blue = False
    for detection in detections:
        if detection['label'] == 'blue':
            is_blue = True
            break  # Only one blue collar
    
    return is_blue, detections
    
