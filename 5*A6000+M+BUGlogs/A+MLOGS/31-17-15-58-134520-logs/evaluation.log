Code: from object_detector import Object_Detector_Tool

def count_white_bikes(image_path):
    # Load image and run the object_detector tool
    detected_objects, object_count = Object_Detector_Tool.execute(image=image_path, labels=['white_bike'], save_object=False, saved_image_path="detected_objects")
    
    # Count objects and get the ratio of white bikes to total bikes
    total_bikes = 0
    for bounding_box in detected_objects[0]['bbox']:
        object_id = bounding_box['object_id']
        if object_id == 'white_bike':
            total_bikes += 1
    
    white_bike_ratio = object_count['white_bike'] / total_bikes
    
    return white_bike_ratio

