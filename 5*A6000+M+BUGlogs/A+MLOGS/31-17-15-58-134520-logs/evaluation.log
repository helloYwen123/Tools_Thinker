import numpy as np

def count_people(image_path, labels, threshold, model_size, save_object, saved_image_path):
    # Load the image
    image = np.array(Image.open(image_path))

    # Detect people in the image
    object_detection = Object_Detector_Tool()
    detected_objects, object_number = object_detection.execute(image=image, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size, saved_image_path=saved_image_path)

    # Find people in the object bounding boxes
    # Assuming we have an image of a parade and people are represented by triangles, we can estimate the number of people by counting the number of triangles.
    num_people = len(detected_objects)
    return num_people

