def count_objects(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    # Load the model
    model = object_detector.Model(model_size="base", threshold=0.45)
    label_count = {}
    detected_objects = model.detect_objects(image_path, labels=labels)

    # Store detected objects
    for detection in detected_objects:
        label = detection.get('label')
        box = detection.get('box')
        for row in box:
            x1, y1, width, height = row
            obj_id = detection.get('id')
            if label in label_count:
                label_count[label] += 1
            else:
                label_count[label] = 1

    if save_object:
        # Save detected objects
        for label in label_count:
            save_object_path = 'detected_objects/' + label
            try:
                os.mkdir(save_object_path)
            except FileExistsError:
                pass
            filename = save_object_path + '/' + label + '_objects'
            np.save(filename, detected_objects)

        saved_image_path += '/result.png'

        # Save detected objects
        for detection in detected_objects:
            box = detection.get('box')
            for row in box:
                x1, y1, width, height = row
                obj_id = detection.get('id')
                result = {'label': label, 'confidence': detection.get('confidence') * 100, 'bbox': [x1, y1, width, height]}
                result['bbox'] += ['x1', 'y1', 'x2', 'y2']
                result_str = json.dumps(result) + ','
                try:
                    with open(saved_image_path, 'a') as f:
                        f.write(result_str)
                        f.write('\n')
                except IOError:
                    pass

    final_result = {}
    final_result['count'] = label_count

    return final_result

