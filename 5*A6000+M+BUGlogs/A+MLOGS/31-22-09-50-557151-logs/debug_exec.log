from object_detector import Object_Detector_Tool

# Function to count how many red buildings are present in a given image
def count_red_buildings(image_path, labels, threshold = 0.45, model_size='tiny', save_object = True, saved_image_path = 'detected_objects', limit_to_label_count = False):
    # Initialize the object detector tool
    detected_objects, object_number = Object_Detector_Tool.execute(image = image_path, labels = labels, save_object = save_object, saved_image_path = saved_image_path)

    # Loop through the detected objects dictionary
    for idx, obj in enumerate(detected_objects):
        # Check if the object is red and not black
        if obj['label'] in {'baseball'} and obj['color'] != 'black':
            print(f"Number of red bases: {obj['number_of_bases']}")

    if limit_to_label_count:
        # Check the total number of detected objects for the red_label
        total = sum([int(obj['number_of_bases']) for obj in detected_objects])
        print(f"Total red buildings: {total}")
