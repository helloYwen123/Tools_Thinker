from object_detector import Object_Detector_Tool

def count_red_buildings(image_file, labels=("baseball", "basket"), save_object=False, saved_image_path="detected_objects") -> dict:
    # Load the image and extract relevant information.
    image = image_file
    object_detector_tool = Object_Detector_Tool(image, labels, threshold=0.45, model_size="base", save_object=save_object, saved_image_path=saved_image_path)
    result = object_detector_tool.execute()

    # Analyze the distribution of red buildings.
    red_building_count = len([obj for obj in result[0][1][0]["box"] for box in box for area in box for color in [box["color"]] if color == "red"])

    return {"Red Buildings": red_building_count}

