from object_detector import Object_Detector_Tool

def count_red_buildings(file_path, labels, threshold=0.45, model_size='tiny', save_object=False):
    tool = Object_Detector_Tool()
    detections_list = tool.execute(image=file_path, labels=(labels, model_size) if model_size != 'large' else 'large', threshold=threshold, saved_image_path='detected_objects' if save_object else None)
    
    total_count = 0
    for detection in detections_list:
        for det in detection:
            if det['label'] == 'red_building':
                total_count += 1
                
    return total_count

