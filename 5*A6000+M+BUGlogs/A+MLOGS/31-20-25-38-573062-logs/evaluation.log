def count_skiers(image_path, save_objects=False, thresholds=[0.45], model_size="tiny"):
    """
    Counts skiers doing a flip in an image using the Grounding DINO model.

    Parameters:
    image_path (string): Path to an image file.
    save_objects (bool): Whether to save the detected objects as images (default: False).
    thresholds (list): List of confidence thresholds to check labels (default: [0.45]).
    model_size (str): Model size ('tiny' or 'base') (default: 'tiny').
    """
    
    detector = Object_Detector_Tool(image_path, labels=["skier"], save_objects=save_objects, saved_image_path="detected_objects")
    boxes = detector.execute(labels=["skier"], model_size=model_size)

    if boxes is not None:
        labels = [box["label"] for box in boxes]
        if "skier" in labels:
            total_count = len([box["label"] for box in boxes])
            return total_count, boxes
        else:
            return 0, boxes
    else:
        return 0, boxes

