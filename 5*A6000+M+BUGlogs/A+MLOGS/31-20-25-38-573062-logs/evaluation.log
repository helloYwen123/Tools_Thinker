def count_ski_flops(image_path):
    # Initiate the Detector tool
    detector_tool = Object_Detector_Tool(image_path=image_path)

    # Get the list of detected objects in the image
    detected_objects = detector_tool.execute()

    # Calculate the total number of objects
    total_objects = len(detected_objects)

    # Initialize a variable to keep track of the number of ski-flops
    ski_flops = detected_objects[0]['label']

    # Check if the first detected object is 'skiers'
    if detected_objects[0]['label'] == 'skiers':
        ski_flops = detected_objects[0]['label']
        total_objects -= 1  # Subtract "skiers" label since we only want the flop on the individual skis

    return total_objects, ski_flops

