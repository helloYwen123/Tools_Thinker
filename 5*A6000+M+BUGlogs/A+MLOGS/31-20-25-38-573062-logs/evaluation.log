def count_person_on_ski(ski_image_path):
    model_size = "base"
    threshold = 0.45
    labels = ["baseball", "basket"]

    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(img_path=ski_image_path, labels=labels, threshold=threshold, model_size=model_size)

    counts = {}
    for label in object_number:
        counts[label] = object_number[label]

    total_count = sum(counts.values())
    return total_count

