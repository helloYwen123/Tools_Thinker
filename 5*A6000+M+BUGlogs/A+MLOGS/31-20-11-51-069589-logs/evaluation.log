class AnswerGatherer:
    def analyze_image_and_determine_yellow_stars(self, image_path):
        # Load image into the tool
        detector_tool = Objects_Detector_Tool(image_path, labels=["yellow_stars"])
        
        # Generate a list of all detected objects based on the provided labels
        detected_objects = detector_tool.execute(labels=["yellow_stars"])
        
        # Initialize a dictionary to hold information about detected objects
        object_info = {
            "Object Labels": [],
            "Confidence Scores": [],
            "Boxes": [],
            "Saved Images": []
        }
        
        # Calculate and accumulate object counts
        for object_info_row in detected_objects:
            object_info['Object Labels'].append(object_info_row[0])
            object_info['Confidence Scores'].append(object_info_row[1])
            object_info['Boxes'].append(object_info_row[2])
            object_info['Saved Images'].append(object_info_row[3])
        
        # Filter and return only yellow stars
        yellow_star_count = sum([int(x == "yellow_stars" for x in detected_objects[0]['Object Labels'])])
        yellow_stars = [x for x, y in zip(x[1:] for x in detected_objects[0]['Boxes']) if y.startswith('x')]
        
        # Calculate and return total yellow stars
        return yellow_star_count, len(yellow_stars)
            
    
def count_yellow_stars(image_path):
    # The command must be valid Python code to get the answer related to images
    yellow_star_count, yellow_stars = AnswerGatherer().analyze_image_and_determine_yellow_stars(image_path)
        # Extract the actual image path
        return yellow_star_count, yellow_stars

