def count_yellow_stars(image_path):
    # Load object detector model
    detector_tool = Object_Detector_Tool()

    # Execute object detection on the image
    output = detector_tool.execute(image_path, labels=["y_star"], threshold=0.45, saved_image_path="detected_objects")

    # Count the number of yellow stars in the output
    count = len([obj for obj in output["final_result"] if obj["label"] == "y_star"])

    return count

