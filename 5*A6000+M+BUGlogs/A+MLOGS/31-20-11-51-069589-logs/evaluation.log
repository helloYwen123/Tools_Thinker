Code: from object_detector import Object_Detector_Tool

def count_yellow_stars(img_path, labels, threshold, model_size, save_object=True):
    try:
        det_results = Object_Detector_Tool.execute(image=img_path, labels=labels, save_object=save_object, saved_image_path="detected_objects", model_size=model_size)
        
        total_count = sum([obj['confidence score'] for obj in det_results]) / len(det_results)
        
        yellow_stars_count = sum([star.label == "yellow star" for star in det_results[0]['box']])
        
        return yellow_stars_count, total_count
    except Exception as e:
        print(f"An error occurred: {e}")
        return None

def get_yellow_stars_count(img_path, labels="yellow star"):
    result = count_yellow_stars(img_path, labels, 0.35, "tiny", save_object=False)
    return result[0]

