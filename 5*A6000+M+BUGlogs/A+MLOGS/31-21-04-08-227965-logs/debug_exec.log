code:from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    # Initialize the object detector
    detector = Object_Detector_Tool(image_path, labels, threshold, model_size)

    # Detect objects
    objects = detector.detect_objects()

    # Count the objects
    total_count = 0
    for label in labels:
        for detection in objects:
            if detection['label'] == label:
                total_count += 1

    return objects, total_count

