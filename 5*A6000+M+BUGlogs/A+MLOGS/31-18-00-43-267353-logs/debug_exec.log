code:def calculate_yellow_cars(image_path):
    # Load the object detection model
    detector = Object_Detector_Tool()

    # Read the image
    image = Image.open(image_path)

    # Detect objects
    results = detector.execute(image=image, labels=["yellow car"], save_object=True)

    # Count detected yellow cars
    yellow_car_objects = [obj for obj in results if 'yellow car' in obj['label']]
    number_of_yellow_cars = len(yellow_car_objects)

    return number_of_yellow_cars

