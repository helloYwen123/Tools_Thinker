import os

def object_counter(image_path, labels, save_objects=True, saved_image_path='detected_objects'):
    object_counter_classes = []
    detected_objects = {}
    for label in labels:
        if label in detected_objects:
            detected_objects[label] += 1
            object_counter_classes.append(label)
        else:
            detected_objects[label] = 1
            object_counter_classes.append(label)
    if save_objects and os.path.exists(image_path):
        os.popen(f"cp {image_path} {saved_image_path}/object_{len(detected_objects)}")
    return object_counter_classes

