def calculate_glasses():
    # Load the model
    model_path = '/path/to/model/tiny'
    device_name = object_detector.detect_objects_in_directory(image="/path/to/image1.jpg")
    object_detector.detect_object_detection(model_path, device_name, threshold=0.45, model_size='tiny')

    # Determine the number of glasses
    glasses = 0
    for glasses_list in device_name['detected_objects']:
        if glasses_list['label'] == 'glasses':
            glasses += glasses_list['confidence']//glasses_list['label_count']

    return glasses

