detected_object_count = len(filtered_objects)
final_result = detected_objects  # Extract result dictionary

# Save all object images
for obj in final_result.values():
    saved_object_path = obj['saved_image_path']
    if saved_object_path:
        object_detector_tool.save_object(output_image_path, saved_object_path)

# Output the number of people reflected in the mirror
