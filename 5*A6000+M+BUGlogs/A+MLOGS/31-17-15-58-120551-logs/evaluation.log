Code: from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, save_object, saved_image_path):
    # Initialize Object_Detector_Tool
    object_detector_tool = Object_Detector_Tool(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size='base')

    # Detect objects in the image
    detected_objects, object_counts = object_detector_tool.execute()

    if not detected_objects or not (any([det['label'] in labels for det in detected_objects])):
        return ["The object count is undefined.", "The object category is undefined.", "The labels are invalid or not listed in labels."]

    if save_object:
        # Save detected object images
        save_object_image_path = f"{saved_image_path}/detected_objects_{image_path}"
        for det in detected_objects:
            object_path = f"{save_object_image_path}/{det['label']}.png"
            image_name = f"{object_detector_tool.label_counts[det['label']]}_{det['confidence']}_detected_{image_path}.png"
            if os.path.exists(image_path):
                os.rename(image_path, object_path)
                os.rename(image_name, object_name)
                print(f"Generated object image: {object_name}")

    return detected_objects, object_counts

