def count_sinking_boats(input):
    image_path = input["image"]
    labels = input["labels"]
    model_size = input["model_size"]
    
    # Load the model and its labels
    model, labels = load_model_and_labels(model_size)
    
    # Load the image and convert to grayscale
    resized_image = Image.open(image_path)
    resized_image = resized_image.resize((640, 480))  # Adjust the size according to the model input size
    image = Image.fromarray(resized_image)
    image = image.convert('L')  # Convert to grayscale
    
    # Detect bounding boxes
    objects = object_detector_tool.detect_objects(image, labels=labels, model_size=model_size)
    
    # Count the number of sinking boats
    sinking_count = sum(1 for _, _, boxes in objects if boxes[2] < 0.2)  # Adjust the range threshold
    sinking_count = 0 if sinking_count == 0 else sinking_count  # Return 0 if there are no sinking boats
    
    final_result = {"total_sinking_boats": sinking_count}
    return final_result

