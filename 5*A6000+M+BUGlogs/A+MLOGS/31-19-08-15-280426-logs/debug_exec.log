from object_detector import Object_Detector_Tool

def count_sinking_boats(image_path, labels=["baseball"], save_object=False):

    if save_object:
        if labels == [] or labels == ["baseball"]:
            return [], "No labels detected in the image."

    object_detector_tool = Object_Detector_Tool(image_path, labels=labels, save_object=True, model_size="tiny")
    detection_dict_list, total_count_dict = object_detector_tool.execute()

    sinking_boat_count = 0
    for label, detection_dict in detection_dict_list:
        if "baseball" in label and "sinking" in label:
            sinking_boat_count += detection_dict["total_count"]

            if len(detection_dict["box"]) > 0:
                for pos in detection_dict["box"]:
                    if pos[2] == "0.0" or pos[3] == "0.0":
                        continue
                    pos_x = float(pos[1])
                    pos_y = float(pos[0])
                    sink_x = (len(pos_x) - pos_x) / 2
                    sink_y = (len(pos_y) - pos_y) / 2
                    sinking_position = pos_x + sink_x, pos_y + sink_y
                    sinking_position = max(0, min(len(detection_dict["box"])-1, sinking_position))
                    object_shape = (detection_dict["box"][sinking_position][2], detection_dict["box"][sinking_position][3], detection_dict["box"][sinking_position][0] - detection_dict["box"][sinking_position][1], detection_dict["box"][sinking_position][1] - detection_dict["box"][sinking_position][0], detection_dict["box"][sinking_position][4], detection_dict["box"][sinking_position][5])
