def detect_objects(image_path, labels, threshold=0.45, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    # Load the ground model and threshold
    obj_detector_tool = Object_Detector_Tool(image_path, labels, threshold, model_size, save_object, saved_image_path)

    # Detect objects using the ground model
    detected_objects = obj_detector_tool.execute()

    if detected_objects:
        # Count the recognized objects
        object_counts = {}
        for label in labels:
            object_count = detected_objects["objects"].get(label, 0)
            object_counts[label] = object_count

        # Get the total object counts using the model
        total_object_counts = sum(obj_counts.values())
        # Get the object labels
        labels = sorted(object_counts.keys(), key=lambda x: object_counts[x], reverse=True)

        final_result = []
        for index, label in enumerate(labels):
            object_count = object_counts[label]
            if save_object:
                object_image_path = f"detected_objects/{index}.jpg"
                object_detector_tool.save_object(path=image_path, label=label, object_count=object_count, saved_image_path=object_image_path)
            detected_image_with_object = f"detected_image_{index}.jpg"
            final_result.extend([{
                "label": label,
                "object_count": object_count,
                "detected_image": f"{detected_image_with_object}"
            }])

        return final_result
    else:
        return []

