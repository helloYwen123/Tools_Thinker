def count_sinking_boats(image_path: str, labels: list['str'] = None, save_object: bool = False, saved_image_path: str = 'detected_objects', threshold: float = 0.45, model_size: str = 'tiny'):
    result_list = []
    label_count_dict = {}
    total_sinking_boats = 0

    model = Object_Detector_Tool()
    model_object_detector = model.get_object_detector()

    object_list = []

    with open(image_path, 'rb') as image:
        image_data = image.read()

    detection, object_labels = model_object_detector.detection(image_data, labels, threshold, model_size, save_object)

    for object in detection:
        if object['label'] == "Sinking Boat":
            sinking_boats_cnt = object_labels.count(object['label'])
            total_sinking_boats += sinking_boats_cnt
            result_list += [{'label': object['label'], 'confidence score': object['score'], 'box': f'{object["bbox"]}'}]
    
    object_count_dict = {}
    for object in result_list:
        if object['label'] in object_count_dict:
            object_count_dict[object['label']].append((object['bbox'], object['confidence score']))
        elif object['label'] == labels[0]:
            object_count_dict[labels[0]] = [ (object['bbox'], object['confidence score']) ]

    # Saving images
    if save_object:
        model.generate_image_detection_results(f'detected_objects/{labels[0]}.png', detections_dict=object_count_dict)
    
    result_list = [{'label': labels[0], 'total_cnt': total_sinking_boats}]
        
    return result_list, object_count_dict

