Code: def image_analysis(file_path, labels, threshold=0.45, model_size='tiny', save_object=True):
    from object_detector import Object_Detector_Tool

    # Load the image
    detector_tool = Object_Detector_Tool()
    detector_tool.set_object_labels(labels)
    img = detector_tool.load_image(file_path)

    # Detect objects
    objects, total_object_count = detector_tool.execute(img=img, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

    # Total number of objects
    total_objects = len(total_object_count)
    
    # Find the actual number of objects with trunks in the water
    water_obj_count = 0
    for obj in objects['objects']:
        if 'trunk' in obj:
            obj_is_in_water = obj['box']['y_min'] <= 0.25 and obj['box']['x_max'] >= 0.5
            if obj_is_in_water:
                water_obj_count += 1

    return total_objects, water_obj_count

