code:from object_detector import Object_Detector_Tool

def count_white_fridges(image_path, labels=None, threshold=0.45, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
    from os.path import join

    image = join(image_path)
    detected_objects, object_number = Object_Detector_Tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    # Loop through each detected object and count white fridges
    white_fridge_count = sum([obj['label'] == 'White_Fridge' for obj in detected_objects])
    
    return {'white_fridge_count': white_fridge_count}

