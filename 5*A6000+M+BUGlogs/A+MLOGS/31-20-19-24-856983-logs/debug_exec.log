code:from object_detector import Object_Detector_Tool

def count_words_with_i_on_sign(image_path, labels=["advanced", "intermediate"], threshold=0.45):
    """
    Counts the number of words in an image with the letter 'i' and returns their information with their count in the total image count.
    """
    detector = Object_Detector_Tool(image_path, labels, threshold, 'tiny')
    word_count = {}
    for word in detector['detected_objects']:
        if 'label' in word and word['label'] in labels and 'i' in word['label']:
            word_count[word['label']] = word_count.get(word['label'], 0) + 1
    return word_count

