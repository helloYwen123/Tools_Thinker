code:def count_buses_in_image(image_path):
    import numpy as np
    import cv2
    image = cv2.imread(image_path)
    # Convert the image to gray
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    # Apply an adaptive threshold to the image
    ret, thresh = cv2.threshold(gray, 127, 255, 0)
    # Construct a noise suppression mask
    kernel = cv2.getStructuringElement(cv2.MORSE_CROSS_shape, (3, 3))
    closing = cv2.morphologyEx(thresh, cv2.MORSE_CLOSE, kernel)
    # Find contours in the image
    contours, _ = cv2.findContours(closing, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    # Count the number of buses in the image
    num_buses = 0
    for contour in contours:
        if contour.shape[0] > 200:
            num_buses += 1
            cv2.drawContours(image, [contour], -1, (0, 0, 255), 2)
    return num_buses

