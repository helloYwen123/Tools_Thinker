Code: def extract_knobs(box, total_knobs):
    """
    Extracts knobs from a bounding box.
    :param box: A dictionary containing the coordinates of the bounding box.
    :param total_knobs: An integer representing the total number of knobs.
    :return: A list of knobs, represented as (x, y, width, height).
    """
    # Extract knob coordinates and calculate width and height
    for x, y, width, height in box:
        for i in range(1, width, 5):
            for j in range(1, height, 5):
                yield (x + j, y + i, width - j, height - i)

def count_knobs(image_path, total_knobs):
    """
    Counts the knobs in an image.
    :param image_path: The path to the image file.
    :param total_knobs: The number of knobs to count.
    :return: The count of knobs in the image.
    """
    # Load the image and detect knobs
    object_detector = Object_Detector_Tool()
    labels = ["baseball", "basket"]
    box = object_detector.detect(image_path, labels, threshold=0.45, model_size="tiny", save_object=True)
    knobs, _ = object_detector.count_knobs(image_path, box, total_knobs)
    
    return knobs

