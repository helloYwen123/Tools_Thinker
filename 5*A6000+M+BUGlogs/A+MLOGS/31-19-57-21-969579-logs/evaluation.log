    image = image[1000:1400].tobytes()  # Crop the image to 1400px
    # Apply the object detection
    detected_objects, _ = object_detector.execute(image=image)
    
    # Count the knobs
    for label in detected_objects["predictions"]:
        knobs = detected_objects["tally"].get(label, 0)
        total_knobs -= knobs
    
    # Check if all knobs were detected
    if total_knobs == 0:
        return "No knobs detected"
    else:
        return total_knobs

