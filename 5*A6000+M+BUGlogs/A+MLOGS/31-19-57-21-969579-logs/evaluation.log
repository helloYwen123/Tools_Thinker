Code: def count_stove_knobs(image_path="val_Counting_54_image_1.jpg"):
    # Load the image
    img = cv2.imread(image_path)
    
    # Implement object detection
    object_dect = Object_Detector_Tool(image_path, labels=["oven"], model_size="tiny")
    objects = object_dect.run_detection()
    
    # Count the number of kitchen knobs
    stove_knobs = 0
    for obj in objects:
        if 'oven' in obj['label'] and 'stove' in obj['label']:
            stove_knobs += int(obj['confidence'])
    
    # Return the count
    return stove_knobs

