Code: def count_detections(image_path, labels, threshold, model_size, save_object):
    # Load the image
    image = object_detector.load_image(image_path)

    # Apply the labels to the image
    for label in labels:
        object_detector.apply_labels(image, label, threshold)

    # Perform object detection
    object_detector.detect_objects(image, model_size)

    # Count the object detections
    total_count = len(object_detector.labels)
    max_count = max(total_count, len(labels))

    # Save detected objects if requested
    if save_object:
        image_folder = f"{object_detector.saved_image_path}/detected_objects/labels_{threshold}"
        os.makedirs(image_folder, exist_ok=True)

    return {"total_count": total_count, "max_count": max_count}

