    labels_to_count = ["cap"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True

    if "val_Counting_83_image_1.jpg" in image_path:
        labels = [1]  # 0 is the background, 1 is a person wearing cap
    else:
        labels = [2]  # 2 is a person wearing cap

    if save_object:
        objects = detector_tool.execute(image=image_path, labels=labels, save_object=save_object, model_size=model_size, threshold=threshold, labels_to_count=labels_to_count)
        total_count = len(objects)
    else:
        total_count = detector_tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size).total_count

    return total_count, labels_in_count

def labels_in_count(objects, total_count):
    # Function to count the number of instances of each label in the detected objects list
    labels_count = {}
    for object in objects:
        label = object["label"]
        if label in labels_count:
            labels_count[label] = labels_count[label] + 1
        else:
            labels_count[label] = 1
            
    # Return the total number of detected objects and the count of each label
    return total_count, labels_count

