Code: from tool.object_detector import Object_Detector_Tool

class Image:
    def __init__(self, path):
        self.path = path

    def __str__(self):
        return f"Image path: {self.path}"

def detect_objects(image_path, labels, save_object):
    # Load the Grounding DINO model and detect the object
    tools = {1: Object_Detector_Tool}
    tools["1"] = self.get_tool("1")
    results_tool = tools["1"]
    results_tool.image = Image(image_path)
    results_tool.labels = labels
    results_tool.threshold = 0.45
    results_tool.model_size = "tiny"
    results_tool.save_object = save_object

    # Execute the object detection
    tools["1"].execute(image=image_path)

    # Get the total count for each label
    counts = tools["1"].output_type()

    # Get the object counts for each detected object
    detected_objects = tools["1"].output_type()

    return counts, detected_objects

def count_yellow_cars(image_path, save_object):
    counts, detections = detect_objects(image_path, ["Yellow Car"], save_object)
    yellow_cars = sum([d["label"] == "Yellow Car" for d in detections])
    return yellow_cars

