Code: from object_detector import Object_Detector_Tool

class Kitchen:
    def __init__(self, image_path, boxes_path):
        self.image_path = image_path
        self.boxes_path = boxes_path
        self.object_detector = Object_Detector_Tool(
            image=image_path, labels=["sink", "stove", "fridge"], save_object=True
        )

    def detect_objects(self):
        self.object_detector.detect_objects()
        detections_with_boxes = self.object_detector.output
        final_result = {"count": 1}
        for label, detections in detections_with_boxes.items():
            final_result[f"label_{label}"] = len(detections)
        return final_result

kitchen = Kitchen("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_100_image_1.jpg", "/home/stud/wg/BLINK_Dataset/counting-detected-os/val-counting-100/val_counting-100.png")
