from object_detector import Object_Detector_Tool

def count_red_letters(filename, labels):
    tool = Object_Detector_Tool()
    input_type = tool.input_types['image']

    if input_type == 'image':
        tool.model_size = 'base'
        tool.threshold = 0.45
    else:
        if tool.labels:
            return len(tool.labels)

    # Load the image
    image = tool.load_image(filename)
    
    # Detect objects in the image
    labels = tool.detect_objects(image)
    
    # Calculate the number of red letters
    red_count = 0
    for label in labels:
        if label['category'] == 'red_letter':
            red_count += 1
    
    return red_count
