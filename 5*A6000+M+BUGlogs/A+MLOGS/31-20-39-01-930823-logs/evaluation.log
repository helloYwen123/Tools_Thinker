Code: def count_players_with_face_guards(image_path: str, labels: list, save_object: bool, saved_image_path: str) -> tuple:
    """
    Counts the number of players wearing face guards based on the given labels.

    Args:
    - image_path: str - The path to the image file.
    - labels: list - A list of object labels to detect.
    - save_object: bool - Whether to save the detected objects as images (default: False).
    - saved_image_path: str - The path to save the detected object images (default: 'detected_objects').

    Returns:
    - tuple - A tuple containing two elements: a list of dictionaries for each detected object (each with keys 'label', 'confidence score', 'box', and 'saved_image_path'), and a dictionary mapping each label to its total count in the image.
    """
    Detection_Tool = object_detector.Object_Detector_Tool
    object_detector_kwargs = {
        'tool_module_name': 'object_detector',
        'tool_class_name': 'Object_Detector_Tool',
        'tool_description': 'A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding.',
        'tool_version': '1.0.0',
        'input_types': {'image': 'str - The path to the image file.', 'labels': 'list - A list of object labels to detect.', 'threshold': 'float - The confidence threshold for detection (default: 0.45).', 'model_size': "str - The size of the model to use ('tiny' or 'base', default: 'tiny').", 'save_object': 'bool - Whether to save the detected objects as images (default: False).', 'saved_image_path': "str - The path to save the detected object images (default: 'detected_objects')."},
        'output_type': tuple,
        'user_metadata': {
            'limitation': 'The model may not always detect objects accurately.'
        },
    }

    detection_results = Detection_Tool.execute(image=image_path, labels=labels, save_object=save_object, model_size="tiny", saved_image_path=saved_image_path)
    count_result = {
        'labels': [],
        'percentage': []
    }
    for result in detection_results:
        if 'class_name' in result['detected_objects'][0] and result['detected_objects'][0]['class_name'] in labels:
            count_result['labels'].append(result['detected_objects'][0]['class_name'])
            count_result['percentage'].append(float(result['conf_score']) / 10)

    return (count_result, result)

