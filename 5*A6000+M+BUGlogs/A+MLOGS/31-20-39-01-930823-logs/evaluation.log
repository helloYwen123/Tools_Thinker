Code: def get_number_of_players_with_face_guards(image_path, labels, threshold, model_size, save_object):
    detected_objects = []
    detector_tool = Object_Detector_Tool()
    object_number = {}
    labels_to_check = ['baseball', 'catcher', 'pitcher']
    
    for label in labels_to_check:
        for i, object in enumerate(detector_tool.execute(image=image_path, labels=labels, save_object=save_object, model_size=model_size)):
            if label in object['label'] and i > 0 and label != 'catcher' and object['confidence score'] > 0.4:
                detected_objects.append(object)
                object['label'] = f"{label}_{i}"
                object_number[label] = object_number.get(label, 0) + 1

    total_count_labels = {label: count for label, count in object_number.items()}
    total_count_labels['total'] = sum(total_count_labels.values())
    
    if saved_object:
        for label, obj_dict in detected_objects:
            saved_obj_dict = {label: {'confidence score': obj_dict['confidence score'], 'bbox': obj_dict['bbox']}}
            saved_obj_dict['label'] = f"{label}_{len(detected_objects)}"
            if 'pitcher' in obj_dict['bbox']:
                saved_obj_dict['pitcher'] = True
            os.makedirs('detected_objects', exist_ok=True)
            with open(os.path.join('detected_objects', f"{label}_{i}.png"), 'wb') as f:
                f.write(obj_dict['image'].tobytes())
            print(f"Detected {label} ({obj_dict['bbox']}); saved as {label}_{i}.png.")
    
    print(f"Number of players wearing face guards: {total_count_labels['total']}")
    return total_count_labels

