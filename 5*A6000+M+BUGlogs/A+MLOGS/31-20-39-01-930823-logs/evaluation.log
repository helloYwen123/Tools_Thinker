class Object_Detector_Tool:
    def execute(self, image, labels, save_object=True, saved_image_path='detected_objects'):
        labels_list = [{'label': 'baseball', 'confidence score': 0.5}, {'label': 'basket', 'confidence score': 0.6}]
        
        # Load the image
        image_array = np.array(image)
        
        # Detect objects
        detections = self.detect_objects(image_array, labels_list)
        
        # Save detection images
        for det in detections['detections']:
            if save_object:
                img_path = saved_image_path + '/' + det['label'] + '.jpg'
                self.save_object(img_path)
        return {'detections': detections, 'labels_list': labels_list}

    def detect_objects(self, image_array, labels_list):
        import object_detector
        # Load the training model
