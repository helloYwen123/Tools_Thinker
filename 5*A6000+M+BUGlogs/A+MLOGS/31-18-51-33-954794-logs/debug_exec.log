from object_detector import Object_Detector_Tool

tool_threshold = 0.45  # The confidence threshold for detection
model_size = "base"

def find_countrielement():
    try:
        # Load the model and create instance variables
        detector_tool = Object_Detector_Tool(
            object_labels={"baseball": 0, "basket": 1, "bus": 2},
            threshold=tool_threshold,
            model_size=model_size,
            save_object=True,
            saved_image_path="detected_objects"
        )

        # Detect objects in the bus
        results = detector_tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_45_image_1.jpg", labels=["bus"], save_object=True, saved_image_path="detected_objects")

        # Count the objects
        buses = [result for result in results if result["label"] == "bus"]
        bus_count = len(buses)

        return bus_count
    except Exception as e:
        print(f"An error occurred: {e}")
        return None

# Example usage
final_result = find_countrielement()
