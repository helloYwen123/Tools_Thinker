import numpy as np

def calculate_object_number(image_path, labels, threshold, save_object, saved_image_path):
    """
    Calculates the number of objects detected in an image.
    """
    # Read the image
    image = np.array(Image.open(image_path))
    
    # Call the tool
    result = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, save_object=save_object, saved_image_path=saved_image_path)
    
    # Get the object count for each label
    object_count = {label: len(labels) for label in set(result[1])
                    for i, detection in enumerate(result[0])
                    if detection['label'] == label}
    
    return object_count

