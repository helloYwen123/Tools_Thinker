# Function to detect and count objects in an image
def detect_and_count_objects(image_path, labels, threshold, model_size, save_object, saved_image_path):
    # Use Object_Detector_Tool to detect and count objects
    data = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=bool(save_object), threshold=threshold, model_size=model_size, saved_image_path=saved_image_path)

    # Calculate the number of people wearing hats
    people_wearing_hat = 0
    for detection in data[0]:
        if detection['label'] == 'hat':
            people_wearing_hat += 1

    # Return the count of people wearing hats
    return people_wearing_hat

