def how_many_people_wearing_hat(image_path, labels=None, save_objects=False, saved_image_path=None):
    detector_tool = Object_Detector_Tool()
    detected_objects, object_number = detector_tool.execute(
        image=image_path, labels=labels, save_object=save_objects, saved_image_path=saved_image_path)
    total_object_count = {obj['label']: len(obj['boxes']) for obj in detected_objects}
    num_people_wearing_hat = sum(label in object_number.keys() for label in ['baseball', 'base', 'hand', 'shirt', 'cap'])

    return {
        'total_object_count': total_object_count,
        'num_people_wearing_hat': num_people_wearing_hat
    }

