Code: def object_count(image_path, labels=["baseball", "basket"], save_image=True, saved_image_path="detected_objects"):
    """Detects 'baseball' and 'basket' in an image using the default model and threshold. Returns a tuple with a list of detection dictionaries and a dictionary with the total count for each label"""
    
    det = Object_Detector_Tool(image_path, labels, threshold=0.45, model_size="tiny")
    count_dict = {"baseball": 0, "basket": 0}
    for obj in det.output_dict['obj_detection']:
        count_dict[obj['gt_label']] += obj['box']["coordinates"]
    
    if save_image:
        for label, count in count_dict.items():
            if saved_image_path == "detected_objects":
                import os
                os.makedirs(saved_image_path, exist_ok=True)
                os.path.join(saved_image_path, f"{label}.jpg")
            image_path = os.path.join(os.getcwd(), image_path)
            obj_detection = image_path[:-3] + "obj_detection.png"
            obj_detections = image_path[:-3] + "detected_objects/detections.png"
            object_detections = image_path[:-3] + "detected_objects/detections.png"
            object_img = image_path[:-3] + "detected_objects/".join([label, f"{count_str}x" for count_str in count])
            print(f"> {obj_img}")
            with open(obj_img, "rb") as object_obj:
                with open(obj_detections, "wb") as obj_detection:
                    obj_detection.write(obj_obj.read())
                    with open(obj_detections, "rb") as obj_detection:
                        with open(obj_img, "rb") as obj_img:
                            image_obj = obj_detections.read()
                            with open(object_detections, "wb") as detections:
                                detections.write(image_obj)
    
    return count_dict

final_result = object_count("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_107_image_1.jpg", labels=["baseball", "basket"])

for label, count in final_result.items():
    print(f"> {label}: {count}")

