def get_car_position(image_path, detected_objects):
    image_width, image_height, image_channels = detected_objects['image'][0]['image'].shape
    return ((int(image_width / 2) - 1, int(image_height / 2) - 1), (int(image_width / 2), int(image_height / 2)))

def get_car_location(image_path, detected_objects):
    coordinates = []
    for detection in detected_objects:
        coordinates.append(detection['bounding_box'])
    
    image_width, image_height, image_channels = detected_objects['image'][0]['image'].shape
    return (int((coordinates[0] + coordinates[-1][0]) / 2), int((coordinates[0] + coordinates[-1][1]) / 2)) if len(coordinates) >= 2 else (-1, -1)

def get_train_direction(image_path, detected_objects):
    image_width, image_height, image_channels = detected_objects['image'][0]['image'].shape
    image_color = detected_objects['image'][0]['image'].astype('float32') / 255
    
    # Use the 'object_detector' tool to detect trains
    trained_objects = detected_objects["object_detector"]
    
    for train in trained_objects["train"]:
        # Detect potential cars with train object
        cars = object_detector.execute(image_path=image_path, labels=["train_car", "car"], save_object=False)
        if cars:
            car_coordinates = get_car_location(image_path=image_path, detected_objects=detected_objects)
            if car_coordinates:
                train_width, train_height, train_channels = train['image'][0]['image'].shape
                train_color = train['image'][0]['image'].astype('float32') / 255
    
                for car in cars["objects"]:
                    # Check if coordinates overlap and calculate difference between car and train
                    if ((car['bounding_box'][0] // train_width < (image_width / train_width - 1) and car['bounding_box'][0] // train_width + (train_height // train_width) - 1 <= ((image_width / train_width) * 2 - 1))
                       and (car['bounding_box'][1] // train_height < (image_height / train_height - 1) and car['bounding_box'][1] // train_height + (train_width // train_height) - 1 <= ((image_height / train_height) * 2 - 1))
                       and (car['bounding_box'][2] // train_channels < (image_color[1:] // train_channels) < (image_color[1:] // train_channels) + (train_channels // train_channels) * 0.5)
                       and (car['bounding_box'][0] - train_color[0] > 0)
                       and (car['bounding_box'][0] - train_color[0] > 0)
                       and ((car['bounding_box'][1] - train_color[1] > 0) and (car['bounding_box'][1] - train_color[1] > 0)))
                        car_coordinates[0] = min(car_coordinates[0], car['bounding_box'][0])
                        car_coordinates[1] = min(car_coordinates[1], car['bounding_box'][1])
                        car_coordinates[2] = min(car_coordinates[2], car['bounding_box'][2])
    
    return (car_coordinates[0] - car_color[0] > 0 and car_coordinates[1] - car_color[1] > 0)

