Code: from object_detector import Object_Detector_Tool

def count_detected_objects(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    os.makedirs(os.path.dirname(saved_image_path), exist_ok=True)
    object_detector = Object_Detector_Tool(image_path, labels=labels, threshold=0.45, model_size="tiny", save_object=save_object, saved_image_path=saved_image_path)
    return object_detector

def count_sandwiches(presets_image_path):
    object_detector = count_detected_objects(presets_image_path, labels=["sandwich"])
    total_sandwiches = 0
    for labels, count in object_detector["object_number"].items():
        if "sandwich" in labels:
            total_sandwiches += count["sandwich"]
    return total_sandwiches

final_result = count_sandwiches('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_60_image_1.jpg')
print("Number of sandwiches:", final_result)

