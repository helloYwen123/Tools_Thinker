def count_tall_buildings(image_path, labels, threshold, model_size, save_object, saved_image_path):
	# Load the image
	image = Object_Detector_Tool.load_image(image_path)

	# Detect the image using the Grounding DINO model
	detection_dict = Object_Detector_Tool.detect_objects(
		image=image,
		labels=labels,
		detection_threshold=threshold,
		model_size=model_size
	)

	# Count the number of tall buildings
	total_tall_buildings = detection_dict['object_count'][labels[0]][:,0].sum()

	# Save the detected objects if requested
	if save_object:
		detection_image = detection_dict['object_image'][labels[0]]
		save_path = f'{saved_image_path}/{labels[0]}_{total_tall_buildings}.png'
		detection_image.save(save_path)
		return total_tall_buildings, detection_image

def count_tall_building(image_path, labels, threshold, model_size, save_object, saved_image_path):
	detection_image = count_tall_buildings(image_path, labels, threshold, model_size, save_object, saved_image_path)
