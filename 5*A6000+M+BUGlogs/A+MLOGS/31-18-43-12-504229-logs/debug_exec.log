from object_detector import Object_Detector_Tool

def count_kids_in_front_of_yellow_schoolbus():
    # Set up object_detection
    tool_params = {
        'labels': ['yellow school bus', 'baseball'],
        'threshold': 0.45,
        'model_size': 'tiny',
        'save_object': True,
        'saved_image_path': 'detected_school_bus'
    }

    # Call the detection tool
