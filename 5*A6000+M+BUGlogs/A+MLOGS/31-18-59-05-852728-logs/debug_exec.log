def count_black_letters(numbers):
    """Count the number of black letters with a certain style."""
    num_black_letters = 0
    for number in numbers:
        for letter in number:
            if letter == 'B' or letter == 'D' or letter == 'Z':
                num_black_letters += 1
    return num_black_letters

def number_of_signs(image_path, labels, threshold, model_size, save_object, saved_image_path):
    # Load the image
    object_detector_tool = Object_Detector_Tool()
    object_detector_tool.load_model(model_size, save_objects=True)
    image = object_detector_tool.execute(image_path, labels=labels, save_object=False, saved_image_path="")

    # Count the number of stop signs
    stop_sign_count = 0
    for letter in image:
        if letter == 'S' or letter == 'S' or letter == 'P':
            stop_sign_count += 1

    # Count the number of other signs
    other_sign_count = 0
    for letter in image:
        if letter not in ['S', 'STOP', 'STOP', 'STOP', 'S']:
            other_sign_count += 1

    # Add signs to the string to separate them based on letter frequency
    signs = ''
    if stop_sign_count > other_sign_count:
        signs += 'STOP'
    if other_sign_count > stop_sign_count:
        signs += 'STOP'
    signs += 'STOP' * 100

    # Count black letters in the sign
    black_letters = count_black_letters(signs.split())

    # Add the total number of signs to the string
    signs += '-' + str(sum(label['confidence score'] for label in black_letters))

    # Return the final count
    return black_letters + signs

