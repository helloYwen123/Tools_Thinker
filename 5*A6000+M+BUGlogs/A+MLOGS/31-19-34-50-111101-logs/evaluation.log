Code: from object_detector import Object_Detector_Tool

def count_words_with_i(image_path, labels=['baseball', 'basket'], threshold=0.45, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    objects = Object_Detector_Tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size)
    object_count_dict = {}
    for obj in objects:
        label = obj['label']
        if label in object_count_dict:
            object_count_dict[label] += 1
        else:
            object_count_dict[label] = 1
    
    i_count = 0
    for label in object_count_dict:
        if 'i' in label:
            i_count += object_count_dict[label]
    
    if save_object:
        Object_Detector_Tool.save_object(image_path, saved_image_path, object_count_dict)
    return i_count

final_result = count_words_with_i("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_91_image_1.jpg")
print("Number of words with letter 'i':", final_result)

