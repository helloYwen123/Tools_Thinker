def count_letter_i_in_southwest_image(image_path, labels, threshold=0.45, model_size="tiny"):
    detector_tool = Object_Detector_Tool(dataset_image_path=image_path, labels=labels, save_object=True, threshold=threshold, model_size=model_size)
    
    result = detector_tool.output_detection_and_count_labels(labels=detector_tool.input_labels, threshold=detector_tool.threshold, model_size=detector_tool.model_size)
    
    # Filter objects based on name "i"
    filtered_labels = [obj for obj in result if obj['label'] == "i"]
    
    # Count the occurrences of "i"
    i_count = len(filtered_labels)
    
    return i_count

