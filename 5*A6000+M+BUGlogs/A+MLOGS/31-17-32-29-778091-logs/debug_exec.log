from object_detector import Object_Detector_Tool

def count_green_jackets(image_path, labels=('baseball', 'basket'), save_object=False, saved_image_path="detected_objects"):
    obj_detector = Object_Detector_Tool(image_path, labels=labels, save_object=save_object, thresholds=(0.45, 0.5))
    detected_objects = obj_detector.execute()
    
    label_counts = {}
    for detected_object in detected_objects["detected_objects"]:
        label_count = detected_object["label"]
        if label_count in label_counts:
            label_counts[label_count] += 1
        else:
            label_counts[label_count] = 1
            
    total_count = {label: count for label, count in label_counts.items() if any(label in "baseball" + "basket" for label in label_counts)}
    
    return total_count

