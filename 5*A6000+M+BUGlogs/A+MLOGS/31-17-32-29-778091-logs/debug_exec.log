def count_people(image_path, labels, threshold=0.45, model_size='tiny', save_object=False, saved_image_path="detected_objects"):

    # Use the object_detector module to process the image
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size, saved_image_path=saved_image_path)

    # Count the people based on the labels
