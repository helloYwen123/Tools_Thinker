def count_people(images_path, labels, threshold, model_size):
    # Load the pretrained Object Detection model
    tool = Object_Detector_Tool()
    
    # Define labels to detect
    labels_to_detect = ["people"]

    # Load the model and threshold values
    if model_size == 'tiny':
        tool.model = (1.0, 0.5, 'tiny')
    elif model_size == 'base':
        tool.model = (1.0, 0.5, 'base')

    # Load the labels list
    labels_detector = tool.detected_objects

    # Execute the tool with the given params
    detected_objects, number = tool.execute(image=images_path, labels=labels_to_detect, threshold=threshold, save_object=False, saved_image_path="")
    
    # Calculate the total number of humans based on the detected objects
    total_people = sum(count for detection in detected_objects for people_count in detection['label'] if "human" in people_count)
    
