class Detector_Tool:
    def execute(self, image, labels, save_object=False, saved_image_path="detected_objects"):
        object_count_image = {}
        for label in labels:
            object_count = self.detect_and_save_object(image, label, save_object)
            object_count_image[label] = object_count
        return object_count_image, object_count_image

    def detect_and_save_object(self, image, object_name, save_object):
        image_data = image_to_tensor(image)
        if object_name == "baseball":
            obj_indices = keras.applications.mobilenet_v2.Detection.objects.detect_objects(image_data)
        elif object_name == "basket":
            obj_indices = keras.applications.mobilenet_v2.Detection.objects.detect_objects(image_data, threshold=0.2)
        elif object_name == "towel":
            obj_indices = keras.applications.mobilenet_v2.Detection.objects.detect_towel(image_data)
        object_count = len(obj_indices)
        if save_object:
            object_name_image = get_obj_image(image, object_name)
            save_obj_path = os.path.join(saved_image_path, object_name_image[0].name)
            mkdir_if_needed(save_obj_path)
            image.save(save_obj_path)
        return object_count

    @staticmethod
