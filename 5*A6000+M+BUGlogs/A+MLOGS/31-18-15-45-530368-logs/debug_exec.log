code:from object_detector import Object_Detector_Tool

def count_skiers_in_image_image(image_path):
    detector_tool = Object_Detector_Tool()
    label_labels = ["skiing_ski", "skiing_skiing_ski"]  # Adjust labels as needed
    labels_to_detect = label_labels
    object_number = detector_tool.execute(image_path, labels=labels_to_detect, threshold=0.8, model_size="tiny", save_object=True, saved_image_path="detected_objects")
    total_objects_skiing = len(object_number)
    return total_objects_skiing

def find_object_by_label(image_path, object_name):
    detector_tool = Object_Detector_Tool()
    saved_object_list = []
    object_number = detector_tool.execute(image_path, labels=[object_name], save_object=True, saved_image_path="detected_objects")

    saved_object_list = object_number
    saved_object_list.sort(key=lambda x: x["bbox"], reverse=True)

    if saved_object_list:
        final_result = saved_object_list[0]
        return final_result

