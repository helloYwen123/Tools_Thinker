from object_detector import Object_Detector_Tool

def count_kids_in_bench(image_path, labels=None, threshold=0.45, model_size="tiny", save_object=False, saved_image_path="detected_objects"):

    # Load the image
    image = Image.open(image_path)
    
    # Detect objects
    obj_detector = Object_Detector_Tool(image=image, labels=labels, threshold=threshold, model_size=model_size)
    
    if save_object:
        # Save object images with empty padding
        obj_detector.save_object_image_image_path="detected_objects"
    
    # Calculate the number of kids sitting on the bench
    kids_in_bench = len(obj_detector.detection_results["children"])

    return {"kids in bench": kids_in_bench}
