code:import cv2

def get_label_count(image_path, labels, threshold, model_name, save_object, saved_image_path):
    label_detections = []

    image = cv2.imread(image_path)
    labeled_images = [image]
    label_count_dict = {'baseball': 0, 'basket': 0}

    for i, label in enumerate(labels):
        if label == 'baseball':
            label_detections.append(f"Baseball {i}")
            label_count_dict['baseball'] += 1
        elif label == 'basket':
            label_detections.append(f"Basket {i}")
            label_count_dict['basket'] += 1
        else:
            print(f"Unknown label detected: {label}")
            continue

    if save_object:
        for detection in label_detections:
            path = f"{saved_image_path}/{detection}.png"
            cv2.imwrite(path, labeled_images[i])

    return label_count_dict

