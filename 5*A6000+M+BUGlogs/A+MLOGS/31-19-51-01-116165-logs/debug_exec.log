def count_kids_on_bench(image_path):
    # Load object detector model and threshold
    detector_tool = Object_Detector_Tool(image_path, labels=["skateboard"], threshold=0.45)
    
    # Get the number of kids on the bench
    total_kids = 0
    for label in detector_tool.labels:
        total_kids += int(label)  # Count each child as 1 kid
    
    return total_kids

