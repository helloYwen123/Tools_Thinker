def count_labels(result, label):
    # Convert the detected label to a value
    label_value = {'kumquat':1, 'banana':1, 'apple':1}
    
    # Count the label in the result
    total_count = len([obj for obj in result['objects'] if obj['label']==label])
    return total_count, label_value

