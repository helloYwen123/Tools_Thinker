def count_kumquats(image_path):
    # Load the image and perform object detection
    result = Object_Detector_Tool.execute(image=image_path, labels=["kumquat"], save_object=False, threshold=0.45, model_size="basic", saved_image_path=None)
    
    # Count the number of 'kumquat' labels
