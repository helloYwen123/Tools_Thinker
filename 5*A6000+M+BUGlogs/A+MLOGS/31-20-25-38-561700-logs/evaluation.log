def calculate_chicken_nugget_count(image_file_path):
    object_detector_tool = Object_Detector_Tool()
    labels = ["chicken nugget"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True
    saved_image_path = "detected_objects"

    objects = object_detector_tool.execute(image_file_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)
    for object in objects:
        if "chicken nugget" in object["label"]:
            count = len(object["labels"])
            return count
    return 0

