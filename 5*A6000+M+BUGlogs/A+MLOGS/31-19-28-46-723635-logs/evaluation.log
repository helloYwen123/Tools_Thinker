Code: def count_known_face_signs(image_path, labels_to_search, save_images=False, saved_image_path="detected_objects"):
    import object_detector
    import cv2
    import numpy as np
    import imageio

    # Load the image and extract the first face sign if there is one detected
    face_sign = []
    if labels_to_search[0] == "face_sign" or labels_to_search[0] == "face_sign_on_sign" or labels_to_search[0] == "baseball" or labels_to_search[0] == "basket":
        image = cv2.imread(image_path)
        if isinstance(labels_to_search[0], str):
            mask = image == int(labels_to_search[0])
            mask = mask.astype(np.uint8)
            face_sign_image = image.copy()
            mask = cv2.bitwise_not(mask)
            face_sign_image[mask] = (0, 0, 255)
            face_sign_image = np.dimgtranslate(face_sign_image, np.array([5, -25]))

        else:
            face_sign_image = cv2.imread(image_path)
            face_sign_image = np.dimgtranslate(face_sign_image, np.array([5, -25]))
    
    # Extract object bounding boxes from the image and return the count of 'face_sign'
    object_labels = object_detector.detect(image, labels=labels_to_search, threshold=0.45)
    objects_with_label = [obj for obj in object_labels if obj['label'] == labels_to_search[0]]
    faces_sign_count = sum([1 if obj['label'] == labels_to_search[0] else 0 for obj in objects_with_label])
    return faces_sign_count

