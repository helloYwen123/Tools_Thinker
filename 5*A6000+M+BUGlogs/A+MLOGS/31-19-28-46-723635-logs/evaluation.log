Code: from matplotlib.patches import ImagePatch

def count_obj(detected_objects):
    """Counts the objects of a certain label in an image."""
    label_count = {}
    for obj in detected_objects:
        if obj['label'] not in label_count:
            label_count[obj['label']] = 1
        else:
            label_count[obj['label']] += 1
    return label_count

