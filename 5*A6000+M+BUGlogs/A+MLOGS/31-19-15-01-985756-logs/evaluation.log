Code: def calculate_flower_pots(image_path, *labels, save_object=False, saved_image_path="detected_objects"):
    # Load the image
    image = Object_Detector_Tool.execute(image_path, labels, threshold=0.45, model_size="tiny", save_object=save_object, saved_image_path=saved_image_path)

    total_labels = {}
    for label in labels:
        total_labels[label] = image["output"].get(label).item()

    # Calculate the number of flowers in the image
    total_count = sum(total_labels.values())

    return total_count, total_labels

