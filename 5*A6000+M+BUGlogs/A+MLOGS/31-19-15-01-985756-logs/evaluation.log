Code: from object_detector import Object_Detector_Tool

def count_flower_pots(images_path, flower_pot_desc=None, threshold=0.45, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    # Load object detector tool and execute it
    detector = Object_Detector_Tool()
    detected_objects, object_number = detector.execute(image_path=images_path, labels=["flower", "pot"], save_object=save_object, saved_image_path=saved_image_path)

    # Iterate through detected objects
    for detected_object in detected_objects:
        # Determine if the object is a flowerpot (containing flower)
        if detected_object["label"] == "flower" and not flower_pot_desc:
            # Extract flower pot bounding box and count
            box = detected_object["box"]
            flower_pot_count = len(box["vertices"])
        elif detected_object["label"] == "pot" and not flower_pot_desc:
            # Extract flower bounding box and count
            box = detected_object["box"]
            flower_count = len(box["vertices"])

        # If detection was made, use detected objects (no need to save)
        if detected_object["label"] != "unknown":
            # Return detected object count
            yield detected_object, flower_pot_count
            yield detected_object, flower_count

# Example usage
images_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_42_image_1.jpg"
