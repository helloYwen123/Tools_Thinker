from object_detector import Object_Detector_Tool

def count_people_image(image_path, model_size="tiny", save_object=False):
    cap = cv2.VideoCapture(image_path)
    ret, frame = cap.read()
    if ret == True:
        gray_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        object_dtc = Object_Detector_Tool(gray_frame, 0.55, model_size="tiny")
        object_list = object_dtc.get_boxes_labels_labels("model01")
        total_label = len(object_list)
        
        if save_object:
            cap.release()
            cv2.destroyAllWindows()
            if save_object == 1:
                for item in object_list:
                    img = "detected_objects/item_{}.png".format(item["label"])
                    os.makedirs(os.path.dirname(img), exist_ok=True)
                    cv2.imwrite(img, image_path)
        return total_label

    else:
        return 0
