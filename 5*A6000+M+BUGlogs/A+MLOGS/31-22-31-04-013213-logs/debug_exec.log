from object_detector import Object_Detector_Tool

def count_children_in_image(image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects"):
    tool_config = {
        'input_types': {'image': 'path_to_image', 'labels': 'list', 'threshold': 0.45, 'model_size': 'tiny', 'save_object': save_object, 'saved_image_path': saved_image_path},
        'output_type': 'tuple', 'user_metadata': {'limitation': 'The model may not always detect objects accurately.'}
    }

    # Load the model and set the threshold
    object_detector = Object_Detector_Tool(image_path, tool_config)
    
    # Detect objects in the image
    detected_objects = object_detector.execute(labels=labels, threshold=0.45)
    
    if len(detected_objects[1]['labels']) > 2:
        print("There are several people present in the image.")
        return True  # Assuming there are more than 2 children detected
    else:
        total_count = sum([obj['count'] for obj in detected_objects[1]])
        if total_count == 0:
            print("There are no children detected in the image.")
        else:
            print(f"There are {total_count} children in the image.")

    if not saved_object:
        return detected_objects[0]

    # Save object detections
    object_ids = detected_objects[0]['id']
    for obj in detected_objects[1]:
        obj['id'] = object_ids
    
    image_path += '_detected.png'
    saved_object['detected_objects'] = detected_objects[1]
    saved_object['detected_image_path'] = image_path

    return object_ids, total_count, detected_objects[1], saved_object
