Code: from object_detector import Object_Detector_Tool

def count_colored_tiles():
    # Load the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_5_image_1.jpg"
    tool = Object_Detector_Tool()
    tool.confidence_threshold = 0.45
    tool.model_size = "tiny"
    tool.save_object = True
    detected_objects, obj_number = tool.execute(image=image_path, labels=["tile"], save_object=True)

    # Count the colored tiles above the sink
    colored_tiles_above_sink = sum([obj.get("label") == "tile" for obj in detected_objects if obj.get("confidence") > 0.45])

    return colored_tiles_above_sink

final_result = count_colored_tiles()
print(f"The number of colored tiles above the sink is: {final_result}")

