class ImageDetectionDataset(Dataset):
    def __init__(self, image_path, labels, threshold, model_size, save_object, saved_image_path):
        self.image_path = image_path
        self.labels = labels
        self.threshold = threshold
        self.model_size = model_size
        self.save_object = save_object
        self.saved_image_path = saved_image_path

    def __len__(self):
        return len(self.labels)

    def __getitem__(self, index):
        label = self.labels[index]
        image = Image.open(self.image_path).convert('RGB')
        predictions = self.detect_objects(image)

        box = [0.15, 0.15, 0.25, 0.65]
        confidence = 0.35
        final_result = {
            "label": label,
            "confidence": confidence,
            "box": box,
            "image_path": self.image_path
        }

        if self.save_object:
            image_path = f"{self.saved_image_path}{label}_output.jpg"
            image.save(image_path)

        return final_result

    def detect_objects(self, image):
        detections = self.load_detection_model()
        results = []

        for i in range(len(image)):
            for j in range(len(detections)):
                if detections[j]["bbox"][0] > 0.0 and image[i].bbox[0] > detections[j]["bbox"][0] and image[i].bbox[1] > detections[j]["bbox"][1] and image[i].bbox[2] > detections[j]["bbox"][2]:
                    x, y, width, height = image[i].bbox
                    x1 = x - width / 2
                    y1 = y - height / 2
                    x2 = x + width / 2
                    y2 = y + height / 2
                    box_info = {
                        "x1": round(x1, 2),
                        "y1": round(y1, 2),
                        "x2": round(x2, 2),
                        "y2": round(y2, 2)
                    }
                    results.append(box_info)

            if detections:
                detections[i]["bbox"] = [detections[i]["bbox"][0], detections[i]["bbox"][1], detections[i]["bbox"][0] + width, detections[i]["bbox"][1] + height]

            for j in range(len(results)):
                if not results[j]:
                    break
                if results[j]["bbox"][0] < 0.01 and results[j]["bbox"][1] < 0.01:
                    confidence = 0.01 + 0.01 * results[j]["bbox"][1] ** 2

        return predictions

