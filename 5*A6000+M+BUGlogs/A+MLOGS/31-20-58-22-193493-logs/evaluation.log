Code: from object_detector import Object_Detector_Tool

def count_knobs(stove_image_path):
    """
    Counts the knobs on a stove using Object_Detector_Tool.

    Args:
    - stove_image_path (str): The path to the stove image.

    Returns:
    - int: The number of knobs on the stove.
    """
    detector_tool = Object_Detector_Tool()
    results = detector_tool.execute(image=stove_image_path, labels=["knobs"], saved_image_path="detected_objects")
    all_objects = results[0]
    total_objects = all_objects[all_objects["label"] == "all_objects"][["object", "confidence score", "box"]]
    total_objects["conf_score"] = total_objects["conf_score"].astype(float)
    max_conf_score = max(total_objects["conf_score"])  # Get the highest confidence score
    knobs = all_objects[all_objects["object"] == "knobs"][["box"]]
    knobs_count = int(max_conf_score >= 0.5)
    return knobs_count

stove_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_54_image_1.jpg"  # Path to the stove image
knobs_count = count_knobs(stove_image_path)
print("The number of knobs on the stove is:", knobs_count)

