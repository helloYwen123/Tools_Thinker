Code: from object_detector import Object_Detector_Tool
import torch

class KeystoneDetector:
    def __init__(self, image_path, labels, threshold, model_size, save_object, saved_image_path):
        self.label_to_count = {}
        self.image_path = image_path
        self.threshold = threshold
        self.model_size = model_size
        self.save_object = save_object
        self.saved_image_path = saved_image_path
        
    def detect_objects(self, image):
        self.detected_objects = {}
        self.object_count = {}
        object_detector_tool = Object_Detector_Tool[image_path, labels, save_object, saved_image_path]
        object_detector_tool.save_object = save_object
        self.detected_objects, self.object_count = object_detector_tool.execute(image, labels)
        return self.detected_objects

def count_common_vowels(detected_objects_list, object_labels, total_object_names):
    common_vowels_count = 0
    for object in detected_objects_list:
        if object['label'] in object_labels:
            for vowel in object['label_values']:
                if vowel in 'AEIOUaeiou':
                    common_vowels_count += 1
    return common_vowels_count

