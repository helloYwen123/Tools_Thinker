def count_bottles(image_path):
    # Load the image with Object_Detector_Tool
    detector_tool = Object_Detector_Tool(image_path)
    
    # Detect objects and count them
    bounding_boxes = detector_tool.detect_objects()
    
    # Exclude any detected objects not relevant to the question (e.g., tables, chairs)
    relevant_objects = bounding_boxes['bbox']
    relevant_results = bounding_boxes['bbox'][relevant_objects['label'] == 'bottle']
    
    if not relevant_results:
        return 0
    
    # Calculate the total number of bottles
    total_bottles = sum(relevant_results['bbox'][relevant_objects['label'] == 'bottle']).pop(0)
    
    return round(total_bottles)

