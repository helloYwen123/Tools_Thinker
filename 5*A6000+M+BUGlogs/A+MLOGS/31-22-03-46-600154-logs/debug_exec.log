code:from object_detector import Object_Detector_Tool

def count_balls(image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects"):
    # Load the image
    detector = Object_Detector_Tool()
    # Detect balls
    detections = detector.detect_objects(image_path, labels=labels)
    # Count each detected label
    label_counts = {}
    for detection in detections:
        label = detection['label']
        if label not in label_counts:
            label_counts[label] = 0
        label_counts[label] += 1
    # Save detected objects
    for label, count in label_counts.items():
        if save_object:
            detector.save_object(image_path, label, count)
    return label_counts

