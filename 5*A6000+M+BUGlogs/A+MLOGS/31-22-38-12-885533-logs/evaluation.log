Code: def get_motorcycles_count(image_path, labels=['baseball', 'basket'], save_objects=True):
    # Load the image
    image = object_detector.execute(image=image_path)

    # Detect objects using the Grounding DINO model
    detected_objects = object_detector.detect_objects(image, labels, threshold=0.45, model_size='tiny', save_objects=save_objects)

    # Count the number of baseballs and baskets
    total_count = 0
    for label, count in detected_objects:
        if label == 'baseball':
            total_count += count
        elif label == 'basket':
            total_count -= count

    return total_count

# Read the path to the image
