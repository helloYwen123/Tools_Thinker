Code: def detect_objects(image_path, labels, threshold=0.45, model_size='tiny', save_object=False, saved_image_path='detected_objects'):
    # Load the object detection model
    from object_detector import Object_Detector_Tool
    detector_tool = Object_Detector_Tool()

    # Detect objects in the image using the grounded dinosaur model
    labels_results = detector_tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    # Extract object labels
    labels_list = []
    for label in labels_results['labels']:
        labels_list.append(label['label'])

    # Count the occurrences of each label
    object_count = {}
    for label in labels_list:
        if label in object_count:
            object_count[label] += 1
        else:
            object_count[label] = 1

    return labels_list, object_count

