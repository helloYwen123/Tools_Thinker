Code: from object_detector import Object_Detector_Tool

def count_red_motorcycles(image_path):
    # Load the image file
    img = Object_Detector_Tool.execute(image=image_path, labels=["motorcycle_red"], threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects")

    # Get the count of the detected items
    item_count = len(img['detected_image'])

    # Check if the count is > 0
    if item_count > 0:
        # Assuming there are n objects
        n = item_count
        # Calculate total count
        total_count = n * 2  # Assuming each object is considered twice for count
        return total_count
    else:
        return 0

# Calculate and print the count of red motorcycles
final_result = count_red_motorcycles("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_52_image_1.jpg")
print("Total red motorcycles count:", final_result)

