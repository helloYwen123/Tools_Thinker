Code: from object_detector import Object_Detector_Tool

def count_bears(image_path, labels=None, threshold=0.45, model_size='tiny', save_object=False, saved_image_path='detected_objects'):
    detector = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, save_objects=save_object)
    detected_objects = detector.execute()
    object_count = {}
    for label in detected_objects['object_number']:
        if label in labels:
            object_count[label] = detected_objects['object_number'][label]
    return object_count, detected_objects

