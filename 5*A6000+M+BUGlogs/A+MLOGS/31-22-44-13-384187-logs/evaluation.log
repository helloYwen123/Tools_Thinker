# Function to calculate frequency of yellow bear
def calculate_yellow_bear_frequency(image_path, class_labels, threshold=0.45, model_size='tiny', save_object=True, saved_image_path='detected_objects'):

    # Load the object detection tool
    detector_tool = Object_Detector_Tool(image_path, class_labels, threshold, model_size, save_object, saved_image_path)

    # Function to count yellow bears
    def count_yellow_bears(image, min_bearing=40):
        detected_objects = detector_tool.execute()
        total_yellow_bears = 0
        for obj_dict in detected_objects:
            if obj_dict['label'] == 'Yellow Bear' and obj_dict['confidence score'] > 0.45:
                total_yellow_bears += 1

        # Return the count
        return total_yellow_bears

    # Count yellow bears
    yellow_bear_count = count_yellow_bears(image_path, 40)

    return yellow_bear_count

