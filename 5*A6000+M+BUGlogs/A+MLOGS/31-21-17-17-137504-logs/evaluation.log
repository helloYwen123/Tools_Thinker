Code: from object_detector import Object_Detector_Tool

def count_burners(image_path):
    """
    Counts the burners on a stove in a given image.

    Parameters
    ----------
    image_path : str
        Path to the image containing the stove.

    Returns
    -------
    int
        Count of burners on the stove.
    """
    try:
        # Load the image
        image = Image.open(image_path)

        # Detect objects using the Grounding DINO model
        tool = Object_Detector_Tool(image_path=image_path, model='tiny')
        detected_objects = tool.execute()

        # Get the object with the label 'burner'
        object_with_label = next(filter(lambda x: x['label'] == 'burner', detected_objects), None)

        # Count the objects
        number_burners = len(object_with_label['bbox'] if object_with_label else [])

        return number_burners

    except Exception as e:
        print(f"Error: {e}")
        return None

# Provide the paths to the images here
image_paths = ['/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_64_image_1.jpg']

for image_path in image_paths:
    number_burners = count_burners(image_path)
    if number_burners is not None:
        print(f"Total burners on {image_path}: {number_burners}")
    else:
        print(f"Failed to count burners on {image_path}")

