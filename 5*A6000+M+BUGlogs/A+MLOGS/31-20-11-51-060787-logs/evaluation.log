class Bathroom_Lid_Analysis:
    def analyze_bathroom_lids(self, image_path):
        labels = ["toilet_lid"]
        threshold = 0.45
        model_size = "tiny"

        toilet_ lid_count = 0
        with Object_Detector_Tool(image_path, labels, threshold, model_size) as tool:
            detector_outputs = tool.run()

            for object_output in detector_outputs[0]:
                if object_output["label"] == "toilet_lid" or object_output["label"] == "seated_in_toilet_lid":
                    toilet_ lid_count += 1

        return toilet_ lid_count

