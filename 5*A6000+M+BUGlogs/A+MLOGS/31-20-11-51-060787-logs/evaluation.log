using namespace std; // for std::cout
using namespace cv; // for cv::showImage

/* Initialize the Grounding DINO model */
int main() {
    // Load the model
    auto detector = Object_Detector_Tool("model_name", 0.45, "tiny", false, "detected_objects");
    
    // Load the image path
    string imgPath = "path/to/image.png";
    // Load the image
    cv::mat img;
    // Load the image as a grayscale of 8-bit
    img.create(img.size(), CV_GAUGE8UC);
    // Load the image as a gray image
    img.copyTo(img);
    
    // Detect objects in the image
    vector<dict<double, string>> detection;
    vector<unordered_map<string, double>> objectNumber;
    
    detector.execute(imgPath, "baseball", "basket", false, false);

    // print the detection and object number for "basket"
    for (auto& det : detection) {
        stringstream ss(det);
        ss >> objectNumber[1]["baseball"];
    }
    
    // Display the result
    cv::imshow("Detections", img);
    cv::waitKey(0);
    
    return 0;
}

