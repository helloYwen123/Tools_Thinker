def count_toilets_with_lids(image_path):
    """
    Counts the number of toilets with lids in an image.
    """
    # Prepare the function for object detection
    otj = Object_Detector_Tool(image_path=image_path)
    labels_to_detect = ["toilet"]
    
    # Call the function
    detected_objects = otj.execute(labels=labels_to_detect, threshold=0.45)
    
    # Calculate the total number of toilets with lids
    total_lid_toilets = len(detected_objects) if 'toilet' in detected_objects[0] else 0
    
    return total_lid_toilets

