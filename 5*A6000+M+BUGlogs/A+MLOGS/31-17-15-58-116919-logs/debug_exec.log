# Function to find the total number of blue floats
def find_blue_floats(car, labels, save_object=True):
    detected_objects = []
    category_count = {}

    # Image detection
    result = car.detect_objects_in_image(image=car.vehicles[0].img, labels=labels)
    detected_objects = result["detected_objects"]
    for det in detected_objects:
        if det["label"] == "float":
            category_count[det["label"]] = category_count.get(det["label"], 0) + 1

    if save_object:
        detected_objects[1]['img'] = car.vehicles[0].img  # Adding saved image
        detected_objects[1]['name'] = "float"

    return detected_objects, category_count

def count_blue_floats():
    detected_objects, category_count = find_blue_floats(car, ["float"], save_object=True)

    blue_float_count = 0
    for float_label, count in category_count.items():
