def count_faced_objects(image_path, labels, threshold, model_size, save_object, saved_image_path):
    try:
        object_detector_tool = Object_Detector_Tool()
        result = object_detector_tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
        total_faced_objects = len(result[0])
        if len(result[1]) > 0:
            label_with_count = dict()
            for label in result[1]:
                if label not in label_with_count:
                    label_with_count[label] = {'count': 0}
                label_with_count[label]['count'] += 1
            return total_faced_objects, label_with_count
        else:
            return total_faced_objects, dict()
    except Exception as e:
        return None, dict()

