Code: from object_detector import Object_Detector_Tool

def count_people_in_image(image_path, labels, threshold, model_size, save_objects=False, saved_image_path="detected_objects"):
    """
    Counts the number of people present in an image.
    
    Parameters:
    - image_path: The path to the image file.
    - labels: A list of object labels to detect.
    - threshold: The confidence threshold for detection (default: 0.45).
    - model_size: The size of the model to use ('tiny' or 'base', default: 'tiny').
    - save_objects: Whether to save the detected objects as images (default: False).
    - saved_image_path: The path to save the detected object images (default: 'detected_objects').
    """
    tool = Object_Detector_Tool()
    tool.object_detection(image=image_path, labels=labels, model_size=model_size, threshold=threshold, save_objects=save_objects, saved_image_path=saved_image_path)

    # Check if any object is detected
    if tool.number_of_objects_detected() > 0:
        # Retrieve labels and object count
        label_count = tool.object_count(tool.detection_result())
    else:
        label_count = False

    return label_count

# Example usage
label_count = count_people_in_image("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_11_image_1.jpg", ["baseball"], 0.45, "base", True)
print(f"The number of people present in the image is: {label_count}")

