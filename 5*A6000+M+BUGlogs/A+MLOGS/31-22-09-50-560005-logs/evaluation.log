Code: from object_detector import Object_Detector_Tool

def count_clear_bottles(images_path):
    # Load the image
    detector_tool = Object_Detector_Tool()
    objects = detector_tool.execute(image=images_path, labels=["wine"], save_object=True)

    # Counter empty bottles
    empty_wine_bottles = sum((object['label'] == 'wine' for object in objects))

    return empty_wine_bottles

