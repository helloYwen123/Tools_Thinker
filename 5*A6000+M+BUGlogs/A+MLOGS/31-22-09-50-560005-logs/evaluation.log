Code: from object_detector import Object_Detector_Tool

threshold = 0.45  # Confidence threshold
model_size = "base"  # Size of the model to use

# Function to detect bottles of wine
def detect_bottles(image_path):
    detector = Object_Detector_Tool()
    labels = ["wine_bottle"]
    object_detections = detector.execute(image_path, labels, threshold, model_size)

    results = []
    wine_bottles_count = 0

    for detection in object_detections:
        if detection["label"] in labels:
            wine_bottles_count += 1
        else:
            results.append(detection)

    return results, wine_bottles_count

