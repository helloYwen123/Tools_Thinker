def count_clear_bottles(image_path):
    # Load object detector model
    object_detector = Object_Detector_Tool(image_path)

    # Detect objects
    objects = object_detector.execute()

    # Count clear bottles
    total_count = 0
    for obj in objects:
        if 'baseball' in obj['label'] or 'basket' in obj['label']:
            total_count += 1
            # Check if the wine bottle is clear
            if 'cork' in obj['label'] or '.' in obj['label']:
                if 'glass' in obj['label']:
                    total_count += 1

    return total_count

