def detect_objects(image_path, labels, threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
    import object_detector as IDT
    
    # Load the model
    model = IDT.Model(mode=model_size)
    model.load_weights("model_weights.tflz")
    
    image = IDT.Object_Detector_Tool.imread(image_path)
    
    detections = IDT.Object_Detector_Tool.detect_objects(image, model, labels, threshold=threshold)
    
    # Save the detected images
    if save_object:
        IDT.Object_Detector_Tool.save_object("detected_objects", detections)
    
    return detections

