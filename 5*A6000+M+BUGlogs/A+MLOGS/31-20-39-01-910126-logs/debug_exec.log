code:def calculate_players_on_tennis Court(image_path, labels, threshold, model_size, save_object):
    object_detector_tool = Object_Detector_Tool()

    # Read the image
    image = cv2.imread(image_path)

    if model_size == "tiny":
        model = object_detector_tool.load_model("small")
    elif model_size == "base":
        model = object_detector_tool.load_model("default")

    # Detect objects
    detections = object_detector_tool.detect_objects(image, labels, threshold, model, save_object)

    # Calculate number of players (excluding doubles partners and opponents)
    num_players = sum([
        int(det['label'] == label) for label, detections in detections.items()
        for det in detections.values()
        if det['label'] == 'Player'
    ])

    return num_players

