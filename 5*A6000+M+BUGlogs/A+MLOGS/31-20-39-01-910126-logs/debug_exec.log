def count_tennis_players(image_path):
    tool_params = {
        'image': image_path,
        'labels': 'tennis player',  # Labels to detect (example: baseball, basket)
        'threshold': 0.45,  # Confidence threshold
        'model_size': 'base',  # Model size
        'save_object': True,  # Save detected objects as images
    }

    detector_tool = Object_Detector_Tool()
    tool_params.update(detector_tool.get_object_info())
    detected_objects, object_number = tool_params["output_type"][0], tool_params["output_type"][1]

    total_tennis_players = sum([o['label'] == 'tennis player' for o in detected_objects])
    return total_tennis_players, object_number

