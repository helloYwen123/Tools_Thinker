Code: from object_detector import Object_Detector_Tool

def count_black_toilets():
    # Function to count the number of black toilets in an image
    def count_toilets(image_path, labels=['black', 'white'], threshold=0.5):
        detector = Object_Detector_Tool()
        
        detections = detector.detect_objects(image_path, labels=labels, threshold=threshold, model_size="tiny", save_object=False)
        
        total_black = 0
        for obj in detections['detections']:
            if obj['label'] == 'black':
                total_black += 1
        
        return total_black
      
    # Example usage:
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_2_image_1.jpg"
    total_black = count_toilets(image_path)
    
    return total_black

final_result = count_toilets()
print("The number of black toilets in this image is:", final_result)

