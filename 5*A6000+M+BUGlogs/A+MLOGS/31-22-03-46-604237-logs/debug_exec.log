    # Calculate the percentage of people near the motorbike
    people_near_bbox = sum(biker bbox <= bike_bbox[:,bbox] for cyclist_bbox,biker_bbox in zip(biker_bbox, cyclist_bbox))

    # Check for people near the motorbike and return the count
    if people_near_bbox >= 1:
        total_count = people_near_bbox
    else:
        total_count = 0
    
    return total_count

