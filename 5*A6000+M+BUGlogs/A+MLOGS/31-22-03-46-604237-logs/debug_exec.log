def count_people_near_bike(image_path, bike_pos=0):
    # Load the image
    detect_tool = Object_Detector_Tool(image_path)
    
    # Define the labels to detect
    detection_labels = ["biker"]

    # Calculate the confidence threshold for detection
    confidence_threshold = 0.45

    # Detect people near the motorbike
    detected_bike = detect_tool.detect_objects(detection_labels, confidence_threshold, model_size="tiny")
    
    # Get the bounding box of the motorbike
    bike_bbox = detected_bike["bbox"]

    # Find the bounding box of the biker, if any
    biker_bbox = []
    for label in detection_labels:
        biker_bbox += detected_bike[label]
    
    # Count the number of people not far (less than 0.1)
