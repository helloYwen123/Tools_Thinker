from object_detector import Object_Detector_Tool

def count_blue_floats(image_path, labels=False, threshold=0.45, model_size='tiny'):
    # Define the image path
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_1_image_1.jpg"
    
    # Initialize the object detector
    detector = Object_Detector_Tool(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size)
    
    # Initialize a list to hold the detected objects
    detected_objects = []
    
    # Iterate over the detected objects
    for object in detector:
        # Check if the object is a float and is blue
        if object["label"] in ["baseball", "basket", "ring"]:
            # Add the detected object to the list
            detected_objects.append({"label": object["label"]})
    
    # Count the objects
    total_objects = detector[2]["count"]
    
    # Check if the list of detected objects contains a float with the label of a blue object
    if len(detected_objects) == 0 and "basket" in detected_objects and detected_objects[0]["label"] == "basket":
        # Count the basket object as blue
        total_objects += 1
    
    final_result = total_objects
    return final_result
