def count_plates_on_counter(image_path, labels=[['plate', '1.00']], threshold=0.35, model_size="tiny", padding=20):
  from object_detector_tool import detection_model

  # Load the model and save it with the specified labels, threshold, model size, and padding
  detection_model.load(model_size=model_size, labels=labels, threshold=threshold, padding=padding)

  # Load the image file and detect the plates
  detection_result = detection_model.execute(image_path, labels, threshold=threshold, model_size=model_size)

  # Count the plates and return the result
  if not detection_result:
    return None

  plate_count = len(detection_result[0]["label"])
  return plate_count

