def count_white_fridges(image_path, labels=["whitenap", "refrigerator"], threshold=0.35, model_size="tiny", padding=20):

    # Use object_detector to count white fridges
    detection_result = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Filter the result to count only the fridges
    white_fridges = [obj['label'] == 'refrigerator' for obj in detection_result]

    return len(white_fridges)
