def count_people_with_bat(image_path, labels=['baseball'], threshold=0.35, model_size='tiny', padding=20):

    detection = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    total_persons = 0

    for person in detection:
        if person['label'] in ["person"] or person['label'] in ["baseball"]:
            if person['confidence_score'] >= 0.5:
                total_persons += 1

    return total_persons
