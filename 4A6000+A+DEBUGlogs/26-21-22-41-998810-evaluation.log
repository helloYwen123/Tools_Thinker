def load_images(image_path, labels, threshold, model_size, padding):
    detection_result = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    for item in detection_result:
        if item["label"] in ["car", "person"] and item["confidence score"] > 0.5:
            if item["label"] == "person":
                persons.append(item['label'])

            if item["class"] == "car":
                cars.append(item['class'])
    return cars, persons

