    labels = ["train", "whee"]

    # Confidence threshold for detection
    threshold = 0.5

    # Model size (tiny or base)
    model_size = "tiny"

    # Empty padding (number of pixels to add around detected objects)
    padding = 20

    # Convert the image and labels list to a dictionary
    detection_dict = {
        "image": image_path,
        "labels": labels,
        "threshold": threshold,
        "model_size": model_size,
        "padding": padding
    }

    # Execute the detection tool
    execution = detection_tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Create a list to store detected objects
    detected_objects = []

    # Iterate over detected objects
    for detected_obj in execution:
        # Add object information to the detected_objects list
        if detected_obj['label'] in labels and detected_obj['confidence_score'] > 0:
            detected_objects.append({
                'label': detected_obj['label'],
                'confidence_score': detected_obj['confidence_score'],
                'box': {'x': detected_obj['bbox']['x'], 'y': detected_obj['bbox']['y'], 'width': detected_obj['bbox']['w'], 'height': detected_obj['bbox']['h']},
                'saved_image_path': detected_obj['saved_image_path']
            })

    # If there are detected objects, count the wheels inside each object dictionary
