def count_gloves(image_path):
    """
    Counts the number of gloves with more than one color detected in an image.
    
    Parameters:
    - image_path (str): The path to the image file.
    
    Returns:
    - int: The number of gloves with more than one color.
    """
    detector_tool = Object_Detector_Tool()
    
    try:
        detection_results = detector_tool.execute(image_path, ["gloves"], threshold=0.35, model_size="tiny", padding=20)
        
        # Check if gloves are detected
        if detection_results:
            # For each glove, gather the confidence scores and bounding box coordinates
            for i, glove_dict in enumerate(reversed(detection_results)):
                glove_confidence = glove_dict["confidence"]
                glove_bounding_box = glove_dict["bbox"]
                
            # Count gloves with more than one color
            count_gloves_with_more_than_one_color = sum(
                1 for glove_confidence, glove_bounding_box in zip(glove_confidence, glove_bounding_box) 
                if not all(glove_confidence)
            )
        else:
            count_gloves_with_more_than_one_color = 0
        
        return count_gloves_with_more_than_one_color
    except Exception as e:
        print(f"An error occurred while detecting gloves in the image: {e}")
        return None

