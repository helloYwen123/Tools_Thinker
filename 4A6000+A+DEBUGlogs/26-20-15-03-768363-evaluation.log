    from object_detector import Object_Detector_Tool

    # Step 2: Define the tool parameters (object_detection_tool)
    tool_parameters = {
        "image": "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_94_image_1.jpg",
