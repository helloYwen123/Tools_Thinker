def count_people_in_image(image_path, labels, threshold=None, model_size='tiny', padding=20):
    detection_result = Object_Detector_Tool.execute(image=image_path)
    people_count = len(detection_result["labels"])
    
    if threshold is not None:
        detection_result = Object_Detector_Tool.threshold_detection(detection_result, threshold)
        people_count = len(detection_result["labels"])
    if model_size == 'base':
        detection_result = Object_Detector_Tool.model_size(detection_result, 'base')
        people_count = len(detection_result["labels"])
    
    return people_count + padding * 2 + 2
    
