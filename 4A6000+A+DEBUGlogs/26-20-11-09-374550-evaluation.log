def has_people(image_path, labels=['person'], threshold=0.35, model_size='tiny', padding=20):
    '''Detect people in an image using a pre-trained model and return the number of detected people.'''
    detection_result = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    if len(detection_result['output_type']) > 0:
        return len(detection_result['output_type'][0][1])
    return 0

