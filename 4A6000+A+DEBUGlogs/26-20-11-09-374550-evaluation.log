def count_people_in_an_image(image_path, labels=['car', 'person'], threshold=0.35, model_size='tiny', padding=20):
    # Implement object detection logic to count people in the 'image_path' image
    # and return the count as an integer
    detection_results = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    no_of_people = len(detection_results['output_type']['person'])
    return no_of_people

