def count_people_with_red_shirt(image_path):
    import cv2  # Assuming we have OpenCV installed, not part of the tool
    import numpy as np  # Assuming we have Numpy installed, not part of the tool
    
    # Load the image
    image = cv2.imread(image_path)
    
    # Set default threshold
    threshold = 0.35
    model_size = 'tiny'  # Can be 'tiny', 'base'
    padding = 20
    
    # Create an object detector tool instance
    detector_tool = Object_Detector_Tool()
    
    # Detect people
    execution = detector_tool.execute(image_path, labels=['person'], threshold=threshold, model_size=model_size, padding=padding)
    
    # Convert the detected object list to a list of dictionaries
    detected_objects = np.array(execution[0]).tolist()
    
    # Filter detected people by 'person' label
    people = [obj for obj in detected_objects if obj['label'] == 'person']
    
    # Count the number of people
    count = len(people)
    
    return count

