def count_tigers(image_path, labels):
    # Use the object detector tool to detect tigers
    detection = Object_Detector_Tool.execute(image_path, labels=labels, threshold=0.5, model_size="small", padding=0)
    # Convert the return values to PyTorch tensors before counting
    if isinstance(detection, dict):
        prediction = torch.tensor([d['label'] for d in detection], dtype=torch.float32)
    # Get the number of tigers based on their bounding boxes
    number_of_tigers = torch.sum(prediction == prediction.sum(dim=1) == 1)
    return number_of_tigers.item()

