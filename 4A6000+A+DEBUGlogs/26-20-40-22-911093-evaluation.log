def count_people(image_path, labels=['baseball'], threshold=0.35, model_size="tiny", padding=20):

    # Load the object detection model with the provided parameters
    detection_tool = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Create a new variable to store the total number of people detected
    total_people = 0

