def count_people(image_path, labels=None, threshold=0.35, model_size="tiny", padding=20):
    object_detector = Object_Detector_Tool(image_path, labels, threshold, model_size, padding)
    detected_objects = object_detector.output_type
    
    if type(detected_objects) == list:
        objects = [dict(zip("label", i["label"])) for i in detected_objects]
    else:
        return "The provided labels are not a list of dictionaries and can't be processed correctly."

    count = sum([x["label"] in labels for x in objects])
    
    return count
print('<final_result>', final_result)

