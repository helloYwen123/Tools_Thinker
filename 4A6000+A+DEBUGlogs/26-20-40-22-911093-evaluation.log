def count_people(image_path, labels=['man'], threshold=0.35, model_size='tiny', padding=20):
    detection = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    people = []
    
    if detection:
        for box in detection:
            for obj in box['objects']:
                if obj['label'] in ['man'] and obj['confidence score'] > 0.5:
                    people.append(obj)
    
    return len(people)
