Code: from object_detector import Object_Detector_Tool as ot

def count_motors(image_path):
    # Generate detection results and calculate the number of motors
    detection_results = ot.execute(image=f"{image_path}", labels=('motor'), threshold=0.15, model_size='base', padding=20)
                
    # Extract the object types from the detection results
    object_types = [det['label'] for det in detection_results]
    motor_count = sum(1 for object_type in object_types if object_type == 'motor')
    
    return motor_count

# Function to count the number of motors driving near the bus
def count_buses_in_route(bus_route, buses, motor_detection_results):
    number_of_motors_in_route = motor_detection_results[bus_route][buses][0]

    return number_of_motors_in_route

