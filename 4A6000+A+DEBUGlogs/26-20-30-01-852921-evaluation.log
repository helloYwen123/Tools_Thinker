def count_fingers(image_path):
    # Load the image containing the bathtub and person
    execution = ObjectDetector_Tool.execute(image=image_path, labels=["bathtub", "person", "hand"], threshold=0.5, model_size="tiny", padding=20)
    detected_objects = execution["output_type"][0]

    # Count the fingers in the bathtub
    fingers_in_bathtub = 0
    for bathtube_object in detected_objects["objects"]:
        if bathtube_object["label"] == "bathtub" and bathtube_object["confidence_score"] >= 0.35:
            fingers_in_bathtub += 1
            # Add padding as empty circle around the fingers
            circle_size = int(0.05 * bathtube_object["bbox"][2])
            circle = (bathtube_object["bbox"][0], bathtube_object["bbox"][1], bathtube_object["bbox"][0] + circle_size, bathtube_object["bbox"][1] + circle_size)
            bbox = (bathtube_object["bbox"][0], bathtube_object["bbox"][1], bathtube_object["bbox"][0] + circle_size, bathtube_object["bbox"][1] + circle_size)
            execution.add_circle(circle, bounding_box=bbox)

    return len(detected_objects["objects"]) - fingers_in_bathtub

