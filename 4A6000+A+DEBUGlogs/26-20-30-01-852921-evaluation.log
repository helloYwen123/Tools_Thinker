def count_fingers(image_path):
    """Detect and count fingers in an image using the Grounding DINO model."""
    detection = Object_Detector_Tool.execute(image_path, ["finger"], threshold=0.35, model_size="base", padding=20)
    finger_boxes = [d['box'] for d in detection]
    finger_numbers = [len(b) for b in finger_boxes]
    return sum(finger_numbers)

