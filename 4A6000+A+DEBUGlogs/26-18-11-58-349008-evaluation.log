def count_red_bikes(image_path: str, labels: list = ['red_bike'], threshold: float = 0.35, model_size: str = "tiny", padding: int = 20):
    detection_result = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    red_bike_count = len([bbox for bbox in detection_result if 'red_bike' in bbox['label']])
    
    return red_bike_count
print('<final_result>', final_result)

