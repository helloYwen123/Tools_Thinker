    image_data = image.open(image_path)
    
    # Create a new mask
    mask = np.zeros(image_data.shape, dtype=np.bool_)
    objects = {"baseball": 0, "basket": 0}
    
    # Detect objects
    detection = Object_Detector_Tool.execute(image_data=image_data, labels=["baseball", "basket"], model_size="tiny", threshold=0.35, padding=0)
    boxes = {item['label']: int(item['bbox']) for item in detection["outputs"]}
    
    # Count red buildings
    for box in boxes:
        if box == 0:  # Ignore the basket
            continue
        for obj in boxes[box]:
            if obj['label'] == "baseball" and obj['bbox'][0] > 100 and obj['bbox'][2] < 400:  # Search for baseballs within 100 pixels and centered within the box
