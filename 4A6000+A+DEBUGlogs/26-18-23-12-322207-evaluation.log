def count_red_buildings(image_path, labels=["baseball", "basket"], threshold=0.35, model_size="tiny", padding=20):
    """
    This function detects red buildings in an image.
    
    Parameters:
    - image_path (str): The path to the image file.
    - labels (list): A list of object labels to detect.
    - threshold (float): The confidence threshold for detection (default: 0.35).
    - model_size (str): The size of the model to use ('tiny' or 'base', default: 'tiny').
    - padding (int): The number of pixels to add as empty padding around detected objects (default: 20).
    
    Returns:
    - list: A list of detected red buildings with their bounding box and bounding box confidence.
    """
    detection = Object_Detector_Tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    detected_objects = detection[0]
    bounding_boxes = detected_objects['bbox']
    labels_with_box = [dict(label=label, x1=bounding_box[0], x2=bounding_box[2], y1=bounding_box[1], y2=bounding_box[3], confidence=box['confidence']) for label, box in zip(labels, bounding_boxes)]
    return labels_with_box

def count_red_buildings_in_image(image_path, labels=["baseball", "basket"], threshold=0.35, model_size="tiny", padding=20):
    """
    Function to count the number of red buildings in an image.
    
    Parameters:
    - image_path (str): The path to the image file.
    - labels (list): A list of object labels to detect.
    - threshold (float): The confidence threshold for detection (default: 0.35).
    - model_size (str): The size of the model to use ('tiny' or 'base', default: 'tiny').
    - padding (int): The number of pixels to add as empty padding around detected objects (default: 20).
    
    Returns:
    - int: The number of red buildings in the image.
    """
    _, _, _ = count_red_buildings(image_path, labels, threshold, model_size, padding)
    return labels_with_box

