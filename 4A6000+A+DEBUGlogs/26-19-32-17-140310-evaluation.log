Code: from object_detector.tool import Object_Detector_Tool

def count_people_in_suit(image_path):
    import cv2
    detector = Object_Detector_Tool()

    image = cv2.imread(image_path)
    labels = ['suit']
    threshold = 0.35
    model_size = 'tiny'
    padding = 20

    result = detector.execute(image, labels, threshold, model_size, padding)

    # Check for 'suit' object
    people_with_suit = 0
    for object_data in result:
        if object_data['label'] == 'suit':
            people_with_suit += 1

    return people_with_suit

