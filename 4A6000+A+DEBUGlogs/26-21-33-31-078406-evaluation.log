def count_people(image_path, model_size="base", threshold=0.35, labels=("baseball", "basket")):
    import cv2
    import numpy as np

    image = cv2.imread(image_path)
    binary_threshold = cv2.adaptiveThreshold(image, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY, 21, 10)
    _, contours, _ = cv2.findContours(binary_threshold, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)
    for c in contours:
        contours = np.array(c, dtype=np.int)
        if all(np.all(cv2.isMatchTemplate(image, cv2.imread(c[0], cv2.IMREAD_GRAYSCALE)) == True) for c, i in zip(contours, labels)):
            return 1
    return 0

