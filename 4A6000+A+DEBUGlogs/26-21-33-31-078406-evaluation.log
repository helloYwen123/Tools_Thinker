def count_people(in_image_path, people_label="name"):
    people = []
    with open(in_image_path, 'rb') as image_file:
        for page in open(image_file, 'r').iter_lines():
            page_split = page.split(',')
            if page_split[1] == people_label:
                people.append({"name": page_split[0], "confidence score": float(page_split[2])})
            else:
                continue
    if not people:
        return 0
    return len(people)
