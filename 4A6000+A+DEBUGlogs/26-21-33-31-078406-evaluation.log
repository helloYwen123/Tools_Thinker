def count_people(image_path, labels=['person'], threshold=0.5, model_size="base", padding=20):
    execution = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    if len(execution):
        return len(set(tuple(x[2] for x in execution) for x in execution))
    else:
        return 0

# Function to count people in the image based on bounding box labels
