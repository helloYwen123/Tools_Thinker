import numpy as np

def detect_objects(image_path, labels, threshold, model_size, padding):
    image = np.array(np.fromfile(image_path, np.float32)/127.5 - 1)

    execution = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    detections = execution[0].tolist()

    return detections

