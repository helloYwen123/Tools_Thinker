def count_red_letters(train_plate):
    """
    Counts the number of red letters on the front of a train plate.
    
    Parameters:
    train_plate (str): A string representing the train plate.
    
    Returns:
    int: The number of red letters on the front of the train plate.
    """
    detected_objects = Object_Detector_Tool.execute(image=train_plate, labels=["red", "letter"], threshold=0.5, model_size="base", padding=15)
    num_red_letters = len([obj for obj in detected_objects if obj["label"] == "red"])
    return num_red_letters

