def count_red_motorcycles():
    # Load the image
    image_path = 'path_to_image.jpg'
    image = Image.open(image_path)

    # Detect objects
    detection = Object_Detector_Tool.execute(image=image, labels=["red motorcycle"], threshold=0.2)

    # Find the coordinates of the red motorcycles
    red_motorcycles = []
    for obj in detection:
        if obj['label'] == 'red motorcycle':
            for coor in obj['bbox']:
                x1, y1, x2, y2 = coor
                if x2 > 220 and y2 > 220:  # Adjusting the bounding box coordinates to match the image size.
                    x1 = (x1 - x2) / 2 + x1
                    y1 = (y2 - y1) / 2 + y1
                    red_motorcycles.append((x1, y1, x2 - x1, y2 - y1))

    # Count the red motorcycles
    count = 0
    for motorcycle in red_motorcycles:
        if motorcycle[2] > motorcycle[0] and motorcycle[3] > motorcycle[1]:  # Adjusting the box coordinates to match the image size.
            count += 1

    return count

final_result = count_red_motorcycles()
