def sum_up_image(image_path):
    # Initialize a dictionary to store the pixel values
    pixel_values = {}
    # Open the image file and load its content
    with open(image_path, 'rb') as image_file:
        image_data = image_file.read()
    # Iterate through the pixel values in the image data and sum them up
    for i in range(len(image_data)):
        for j in range(len(image_data[0])):
            pixel = int(image_data[i][j])
            if pixel not in pixel_values:
                pixel_values[pixel] = 0
            pixel_values[pixel] += 1
    # Calculate the sum of values and return it
    sum_of_values = sum(pixel_values.values())
    return sum_of_values

