def count_sandwiches(image_path):
    # Load the image
    model = Object_Detector_Tool.model_manager.load('base')
    result = model.execute(image_path, threshold=0.5, model_size="base", padding=20)
    # Each slice of sandwich is 2-4 sandwich lines in width. Divide the result into 2D arrays
    sandwich_slices = []
    for i, row in enumerate(result['output']):
        if 'type' in row:
            if row['type'] == 'sandwich':
                if len(row['bbox']) >= 4:
                    # Filter out empty boxes
                    bbox = zip(result['bbox'][i], result['bbox'][i+1])  # [xmin, ymin, xmax, ymax]
                    sandwich_slices.append(bbox)

    # Filter out non-sandwich boxes
    sandwich_slices = [bbox for bbox in sandwich_slices if 'sandwich' in bbox[-3]]

    if len(sandwich_slices) > 0:
        return len(sandwich_slices)
    else:
        return 0

