def count_green_tiles(image):
    # Loading the image
    import Image
    image = Image.open(image)

    # Detecting green tiles
    object_detector_tool = Object_Detector_Tool()
    objects = object_detector_tool.execute(image=image, labels=["green"])
    
    # Counting the number of green tiles
    total_green_tiles = 0
    for detection in objects:
        if detection["label"] in ["green"]:
            for bbox in detection["bbox"]:
                x1, y1, x2, y2 = bbox["x1"], y1, bbox["x2"], y2
                width = x2 - x1
                height = y2 - y1
                total_green_tiles += width * height
    
    # Return the result
    return total_green_tiles

