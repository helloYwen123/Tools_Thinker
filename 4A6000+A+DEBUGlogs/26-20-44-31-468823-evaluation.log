def count_birds_right_of_frame(image_path, empty_padding=20):
    # Load the image
    image = Image.open(image_path)

    # Detect birds using the Object_Detector_Tool tool
    detection_results = Object_Detector_Tool.execute(image=image, labels=["waterbirds"], threshold=0.35, model_size="tiny", padding=empty_padding)
    
    # Find the bounding box for the birds
    bird_boxes = None
    
    for result in detection_results["output_type"]:
        if result["label"] == "waterbirds":
            bird_boxes = result["box"]
    
    # Count the birds facing the right of the frame
    birds_right_of_frame = 0
    
    if bird_boxes is not None:
        x1, y1, x2, y2 = bird_boxes
        width, height = image.size
        for i in range(width):
            for j in range(height):
                if i in x1 or j in y1 or i in x2 or j in y2 or i in (x1 + empty_padding) or j in (y1 + empty_padding) or i in (x2 + empty_padding) or j in (y2 + empty_padding):
                    birds_right_of_frame += 1
    
    return birds_right_of_frame
