def find_museums():
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_14_image_1.jpg"
    labels = ['museum']
    threshold = 0.35
    model_size = 'tiny'
    padding = 20
    metadata = {'threshold':threshold, 'model_size':model_size, 'padding':padding}

    # Execute object detection
    execution = Object_Detector_Tool.execute(image=image_path, labels=labels, **metadata)

    # Get the predicted bounding boxes
    predicted_boxes=[]
    for detection in execution.output:
        predicted_boxes.append([detection['bbox'][0], detection['bbox'][1], detection['bbox'][2], detection['bbox'][3] + detection['bbox'][2], detection['bbox'][3] + detection['bbox'][3]])

    # Filter the predicted boxes based on the label
    valid_boxes = [bbox for bbox in predicted_boxes if bbox[0] >= 0 and bbox[1] >= 0]

    # Check if there are any museums within the bounding box
    num_museums = 0
    for bbox in valid_boxes:
        if 'museum' in bbox[4]:
            num_museums += 1

    # Calculate area of the predicted object
    object_area = sum([bbox[2] * bbox[3] for bbox in valid_boxes])

    # Calculate area of predicted object multiplied by 4 (for side)
    side_area = 4 * (object_area / 1000000)^0.5 # 4 for each of the four sides

    # Calculate total area of the sculpture
    total_area = sum([bbox[4][-2]*bbox[4][-1] for bbox in valid_boxes])

    # Calculate height of the sculpture
    height = side_area / total_area * 100  # Area/height

    # Calculate angle
    theta = math.acos(((sum([(bbox[4][-1] - bbox[2] - bbox[3]) for bbox in valid_boxes]))**2 + (sum([(bbox[2]*bbox[4][-1]**2 - bbox[4][-2]**2)**2 for bbox in valid_boxes]))**0.5)**0.5)

    # Calculate center
    position_center = sum([(bbox[0] + bbox[1], bbox[2]) for bbox in valid_boxes]) / len(valid_boxes)

    return round(height * 100), theta, position_center

result = find_museums()
print("The number of museums within the predicted area is: ", result[0])
