def count_people_without_hat(image_path, min_hat_confidence=0.35, model_size="tiny", padding=20):
    # Load the image using OpenCV
    image = cv2.imread(image_path)
    
    # Detect people in the image, taking into account the given model size and empty padding
    execution = Object_Detector_Tool.execute(image=image, labels=["person"], threshold=min_hat_confidence, model_size=model_size, padding=padding)
    
    # Count the number of detected people without hats
    people_count = 0
    if execution:
        for det in execution["output_types"]:
            if det["label"] == "person" and det["confidence score"] > 0:
                if det["box"][2] < 0:
                    # Skip the person if the bounding box is entirely outside the image
                    continue
        
            # Calculate the confidence score for the detected object
            if not execution["confidence score"] < 0.35:
                continue
    
            if "box" in det:
                x1, x2, y1, y2 = det["box"]
                if x1 < 0 or x2 >= image.shape[1] or y1 < 0 or y2 >= image.shape[0]:
                    # Skip the object if it is not visible in the image
                    continue
                    
                # Detect the person
                mask = np.zeros_like(image)
                cv2.fillConvexPoly(mask, np.int32([x1, y1, x2, y2, x1])), 1)
                mask = cv2.bitwise_and(image, image, mask=mask)
                
                # Check if the bounding box includes some person
                if np.count_nonzero(mask) > 0:
                    people_count += 1
            
    return people_count

