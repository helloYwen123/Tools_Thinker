def count_glasses_present(image_path):
    """
    Detect glasses using the Grounding DINO model and count them as present or not.
    """
    detector_tool = Object_Detector_Tool()
    execution = detector_tool.execute(image_path=image_path, labels=["glasses"], threshold=0.2, model_size="base")
    glasses_detected = [obj['label'] for obj in execution['output_type'] if obj['label'] == 'glasses']
    glasses_present = len(glasses_detected) > 0
    return glasses_present

