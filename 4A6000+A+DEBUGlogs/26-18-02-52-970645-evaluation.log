def count_glasses(image_path, labels=None, threshold=0.35, model_size="tiny", padding=20):
    with open(image_path, 'rb') as f:
        image = f.read()
    
    # Load the ground-truth bounding boxes
    if labels is None:
        labels = ['glasses']
    
    detector = Object_Detector_Tool(image, labels, threshold, model_size, padding)
    
    detected_objects = detector.detect_objects(True)
    
    # Count the objects with glasses
    total_glasses = 0
    for obj in detected_objects:
        if obj['label'] == 'glasses':
            total_glasses += obj['confidence']
            
    return total_glasses

def check_glass_count(image_path):
    total_glasses = count_glasses(image_path)
    
    print(f'There are {total_glasses} glasses detected in the image.')
    
    return total_glasses

