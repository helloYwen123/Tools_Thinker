def count_people_affected(*, image_path=None, labels=None, threshold=None, model_size=None, padding=None):
    # Check for image data
    if image_path is None or len(image_path) == 0:
        return "Image path cannot be empty"
    
    if labels is not None and len(labels) < 1:
        return "Labels cannot be empty"
    
    if threshold is not None:
        threshold = float(threshold)
    else:
        threshold = 0.35
    
    if model_size is not None:
        if model_size.lower() == "tiny":
            model_size = "tiny"
        elif model_size.lower() == "base":
            model_size = "base"
        else:
            return "Invalid model size"
    
    if padding is not None:
        padding = int(padding)
    elif threshold is None:
        return "Confidence threshold is required"
    else:
        return "Invalid padding value"
    
    try:
        detection_result = Object_Detector_Tool.execute(image_path, labels, threshold, model_size, padding)
        if detection_result is None:
            return "The model may not have correctly detected any objects"
        
        for label in detection_result:
            if label[2] > threshold:
                name = label[0].upper()
                return {"name": name, "confidence score": label[1], "bbox": label[3]}
        
    except Exception as e:
        return "Error executing the detection tool: {}".format(e)
    
    return "No objects detected within specified parameters"

