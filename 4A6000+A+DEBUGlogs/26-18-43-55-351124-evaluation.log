def count_trains(image_path, labels, threshold, model_size, padding):
    # Load image and perform object detection
    object_detector_tool = Object_Detector_Tool()
    execution = object_detector_tool.execute(image_path, labels, threshold, model_size, padding)
    
    # Count the number of trains
    train_count = 0
    for detected_object in execution:
        if "train" in detected_object["label"]:
            train_count += detected_object["confidence score"]
            
    # Output the count
    return f"Number of trains: {train_count}"

