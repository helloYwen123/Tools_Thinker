class ObjectDetector_Tool:
    def __init__(self):
        # Initialize the object detector with default parameters
        self.object_detector = Object_Detector_Tool()

    def execute(self, image, labels=None, threshold=0.35, model_size="tiny", padding=20):
        if labels:
            detection_results = self.object_detector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        else:
            detection_results = self.object_detector.execute(image=image, threshold=threshold, model_size=model_size)
        return detection_results

