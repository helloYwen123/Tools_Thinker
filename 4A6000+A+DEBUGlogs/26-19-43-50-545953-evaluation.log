def count_white_umbrellas(image_path, labels=["white_umbrella"], threshold=0.35, model_size="tiny", padding=20):

    # Load and preprocess the image
    detector = Object_Detector_Tool()
    detection = detector.execute(image_path, labels, threshold, model_size, padding=padding)

    # Extract and check the number of white umbrellas from the results
    white_umbrellas = 0
    for obj in detection:
        if obj['label'] == 'white_umbrella':
            white_umbrellas += 1

    # Return the result as a float (number of white umbrellas)
    return white_umbrellas

