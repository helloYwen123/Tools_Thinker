def count_red_cars(image_path):
    # Load the model with the "base" size
    model = "tiny"
    size = "base"
    threshold = 0.95
    padding = 10
    tool = "object_detector"

    # Execute the tool with the provided parameters
    execution = Object_Detector_Tool.execute(image_path, labels=["car"], threshold=threshold, model_size=model, padding=padding)
    detection = execution['output_type']

    # Find the bounding boxes for "car" in the detected objects
    detected_cars = []
