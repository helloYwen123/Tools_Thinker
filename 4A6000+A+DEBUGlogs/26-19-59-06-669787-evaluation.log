Code: from Object_Detector_Tool import Object_Detector_Tool

def count_face_guards(image_path, labels, threshold=0.35, model_size="tiny", padding=20):
    """Detect baseball and person in an image using the base model, save the detected objects with 20 pixels of empty padding."""
    try:
        detection = Object_Detector_Tool.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        if "baseball" in detection:
            num_baseball = detection["baseball"]["bbox"][0]
        else:
            num_baseball = 0
        if "person" in detection:
            num_person = detection["person"]["bbox"][0]
        else:
            num_person = 0
        return num_baseball, num_person
    except Exception as e:
        return None

