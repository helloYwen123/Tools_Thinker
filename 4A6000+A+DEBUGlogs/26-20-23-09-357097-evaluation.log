def count_people_wearing_yellow_shirt(image_path, min_score=0.5, padding=20, threshold=0.35, model_size="tiny"):
    # Load the image and detect people using the Grounding DINO model
    detection_output = Object_Detector_Tool.execute(image_path, ["person"], threshold, model_size, padding)
    people = []
    
    for d in detection_output:
        # Get the bounding box, confidence score, and saved image
        bbb, confidence, saved_image_path = d
        bbb = [bbb[0] + padding, bbb[1] + padding, bbb[2] - padding - 2 * padding, bbb[3] - padding - 2 * padding]
        
        # Check if the bounding box has a confidence score over the threshold
        if confidence > threshold:
            people.append({"label": "person", "confidence score": confidence, "box": bbb, "saved_image_path": saved_image_path})
    
    # Return the number of people wearing yellow shirts
    return len([bbox for bbox in people if "baseball" in bbox["label"]])
