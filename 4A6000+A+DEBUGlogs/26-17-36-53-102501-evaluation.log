def count_people(image_path):
    detection_tool = Object_Detector_Tool()
    
    #Detect people in the image
    execution = detection_tool.execute(image=image_path, labels=["person"], threshold=threshold, model_size=model_size, padding=padding)
    detected_objects = execution
    detected_objects = [dict(label=label, prediction_score=prediction_score, box=(bbox[0],bbox[1],bbox[2],bbox[3]), saved_image_path=saved_image_path) for label, prediction_score, box, saved_image_path in detected_objects]
    
    #Calculate the number of people
    total_people = len(detected_objects)
    
    return total_people

def count_white_motorcycles(image_path):
    motor_cyclings_tool = Object_Detector_Tool()
    
    detection_tool = motor_cyclings_tool
    execution = detection_tool.execute(image=image_path, labels=["motorcycle"], threshold=threshold, model_size=model_size, padding=padding)
    motorcycle_objects = execution
    
    total_white_motorcycles = 0
    for object in motorcycle_objects:
        if "color" in object and object["color"] == "white":
            total_white_motorcycles += 1
            
    return total_white_motorcycles

