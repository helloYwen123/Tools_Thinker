def number_of_white_lines(image_path):
    detection_result = Object_Detector_Tool.execute(image=image_path, labels=["baseball"], threshold=0.35, model_size="tiny")
    baseball_detections = detection_result['output_type'][1] if 'output_type' in detection_result else None
    if baseball_detections:
