def count_white_vertical_lines(image_path, labels=["baseball"], threshold=0.35, model_size="tiny", padding=20):
    # Create the Object_Detector_Tool
    obj_detector = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Detect white vertical lines
    detected_objects = obj_detector.detect_objects()

    # Count the number of detected white vertical lines
    white_vertical_lines = len(detected_objects)
    return white_vertical_lines

