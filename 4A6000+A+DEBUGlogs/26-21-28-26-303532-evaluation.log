    detector = Object_Detector_Tool()

    try:
        # Detect and save the objects with default empty padding
        execution = detector.execute(image_image_path=image_path, labels=["baseball", "basket"], threshold=0.35, padding=20, model_size="tiny")
    except Exception as e:
        print(f"Error occurred while executing the object detector: {e}")
