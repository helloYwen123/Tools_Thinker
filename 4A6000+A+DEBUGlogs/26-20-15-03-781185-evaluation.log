Code: from object_detector.object_detector import Object_Detector_Tool as detector

def count_wooden_beams(image_path):
    # Load the image and find bounding boxes for wooden beams
    detection_result = detector.execute(image_path, labels=["wooden beam"], threshold=0.35, model_size="tiny", padding=20)

    # Filter detections to only the top beam
    top_beam = max(detection_result, key=lambda x: x['box'][0])

    # Calculate the number of wooden beams on top of the person
    beam_count = top_beam['box'][3] - (top_beam['box'][1] + top_beam['box'][3] - top_beam['box'][0]) - 2

    return beam_count

# Example usage
