def answer_question(image_path, labels, threshold, model_size, padding):
    # Load the detector model
    detector = Object_Detector_Tool(image_path)

    # Detect objects using the model
    if model_size.lower() == "tiny":
        detected_objects = detector.execute(labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        if not detected_objects:
            return "No objects detected."
        elif "baseball" in detected_objects:
            baseball_detected = True
            baseball_boxes = detected_objects["baseball"]
        elif "basket" in detected_objects:
            basket_detected = True
            basket_boxes = detected_objects["basket"]
    else:
        detected_objects = detector.execute(labels=labels, threshold=threshold, model_size=model_size)
        baseball_boxes = ["{}: {:.2f}".format(label, box[0]) for (label, box) in detected_objects["bbox"]]
        basket_boxes = ["{}: {:.2f}".format(label, box[0]) for (label, box) in detected_objects["bbox"]]
        if not baseball_boxes or not basket_boxes:
            return "No objects detected."

    # Return the number of black suitcases detected
    black_suitcase_count = len([box for box in basket_boxes if box[2] == 0 and "black" in box[4]])

    return black_suitcase_count
