Code: def count_words_on_chalkboard(image_path, labels, threshold, model_size, padding):
    import cv2
    from object_detector import Object_Detector_Tool
    
    # Load the image
    img = cv2.imread(image_path)
    
    # Detect objects in the image
    detection_tool = Object_Detector_Tool(image_path)
    detection_tool.execute(labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    detection_tool.print_results()
    
    # Find text blocks
    text_blocks = []
    for obj_dct in detection_tool.output:
        if 'label' in obj_dct.keys():
            if obj_dct['label'] == 'Words':
                text_blocks.append(obj_dct)
    
    # Count words
    word_count = 0
    for txt_block in text_blocks:
        text = txt_block['text']
        words = text.split()
        word_count += len(words)
    
    return word_count

