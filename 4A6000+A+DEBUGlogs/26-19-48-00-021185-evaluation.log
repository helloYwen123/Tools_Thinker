def bounding_box_score(boxes, scores):
    """Calculate the score for each object based on its bounding box and score."""
    score = boxes[:, 2] * boxes[:, 3]
    return score

def detect_people_with_baseego(image, labels=["Person"], threshold=0.35, model_size="tiny", padding=20):
    """Detect people in an image using the BaseEgo model and return their paths."""
    detection = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    people_bounding_boxes = []
    for person_data in detection:
        x1, y1, x2, y2 = person_data["bbox"]
        y1 = y1 * 0.1  # Scale bounding box by 10%
        x1 = x1 * 0.1  # Scale bounding box by 10%
        people_bounding_boxes.append([x1, y1, x2, y2, 1.0])
    return people_bounding_boxes

