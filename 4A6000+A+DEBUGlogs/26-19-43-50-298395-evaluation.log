def count_image_words(image_path, words_list, threshold=0.35, model_size="tiny", padding=20):
    word_count = 0
    with open(image_path, 'rb') as img:
        image_content = img.read()
    word_labels = Object_Detector_Tool.execute(image=image_content, labels=words_list, threshold=threshold, model_size=model_size, padding=padding)
    for label in word_labels:
        word_count += int(label["label"] in words_list)
    return word_count

