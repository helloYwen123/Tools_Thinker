    image_path = 'path/to/image.jpg'
    labels_to_detect = ['blue']
    threshold = 0.15
    model_size = 'tiny'
    padding = 5

    # Initialize the object detector tool
    detector = Object_Detector_Tool(image_path=image_path, labels=labels_to_detect, threshold=threshold, model_size=model_size, padding=padding)

