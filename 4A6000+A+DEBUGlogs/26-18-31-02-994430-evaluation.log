    # Load the image
    image = Image.open(filepath)
    # Convert the image to RGB
    image = ImageOps.colorize(image)
    # Detect cows
    execution = Object_Detector_Tool.execute(image=image, labels=["cow"], threshold=0.35, model_size="tiny", padding=20)
    if execution:
        # Find bounding boxes for the cows
        cow_bbox = execution[0]
        # Count the number of cows
        num_cows = len(cow_bbox)
