            from torchvision.transforms import ToTensor
            import tensorflow as tf
            import numpy as np

            image = Image.open(image_path).convert('RGB')
            tensor = ToTensor()(image).to(np.float32)

            x = np.expand_dims(tensor, axis=0)
            y = (np.argmax(np.argmax(tf.nn.softmax(tf.nn.softmax(tf.nn.softmax(tf.nn.softmax(x, axis=1), axis=0), dim=0), axis=0), axis=1), axis=1))  # Shape: (?, ?, 255)
