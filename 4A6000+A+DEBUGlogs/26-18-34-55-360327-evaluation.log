def count_kids(image_path, model='base', threshold=0.5, padding=15):
    detections = tools.object_detector.execute(image_path, [
        'person',
        'baseball',
        'basket'
    ], threshold, model, padding)
    if len(detections) == 0:
        return 0
    # Check if we found any baseball or basket
    for detection in detections:
        if (detection["label"] == "baseball" or detection["label"] == "basket"):
            kids_found = float(detection["confidence"])
            if kids_found >= threshold:
                return 1
    return 0

