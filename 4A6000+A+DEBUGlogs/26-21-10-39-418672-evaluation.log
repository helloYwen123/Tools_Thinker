def object_detector(image_path, labels=['baseball', 'basket'], threshold=0.35, model_size='tiny', padding=20):
    detection_result = Object_Detector_Tool.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding, demo=True)
    if detection_result:
        print(f"Found {len(detection_result)} objects.")
    else:
        print("No objects detected.")
    return [obj['bbox'] for obj in detection_result]

def count_plates(plate_count):
    counter = 0
    for obj in plate_count:
        if "baseball" in obj:
            counter += 1
        elif "car" in obj or "person" in obj:
            counter += 1
        if "baseball" not in obj and "basket" in obj:
            counter += 1
        if "pizza" in obj:
            counter += 1
        if "salmon" in obj:
            counter += 1
    return counter

