        return detect_dino.output_type

    def detect_objects_count(self, image_path, labels, threshold, model_size, padding):
        _, _, _, predicted_objects = self.detect_objects(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        if predicted_objects:
            return predicted_objects.count()
        else:
