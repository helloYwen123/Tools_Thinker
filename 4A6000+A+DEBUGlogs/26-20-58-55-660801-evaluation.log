def count_arrow_signs(image_path):
    # Load the image
    execution = Object_Detector_Tool.execute(image=image_path, labels=["arrow"], threshold=0.3, model_size="tiny")

    # Check if there are any objects with an arrow
    if len(execution) > 0:
        # Find the paths of the objects
        arrow_paths = [obj["path"] for obj in execution["output_type"] if obj["label"].lower() == "arrow"]

        # Initialize the counter
        arrow_count = 0

        # Count the signs with arrows
        for sign_path in arrow_paths:
            # Check if the sign is at the specified intersection
            for intersection_sign in execution["output_type"]:
                if intersection_sign["path"] == sign_path:
                    arrow_count += 1

        return arrow_count
    else:
        return 0

