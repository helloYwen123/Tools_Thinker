def count_signs_with_arrows(image_path):
    """
    Counts the number of street signs with arrows in an image.
    :param image_path: str - the path to the image.
    :return: int - the number of signs with arrows in the image.
    """
    # Load the image using OpenCV and convert it to grayscale
    detector = Tool(image_path, ["arrows"], threshold=0.35)
    signs_with_arrows = detector.output_type[0]
    return len(signs_with_arrows)

