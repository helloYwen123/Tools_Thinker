def count_person_with_glasses(image, labels, model_name, threshold, padding):
    # Check the input format
    if isinstance(image, str) is False:
        print("The input format is incorrect.")
        return None

    labels = labels.split(",")
    max_num_labels = len(labels)
    
    if max_num_labels != 1:
        print(f"Invalid number of labels, got {max_num_labels}. Expected 1.")
        return None
    
    if isinstance(labels[0], str) is not True:
        print("The label format is incorrect.")
        return None
    
    if "person" not in labels or "glasses" not in labels:
        print("Invalid label, got person or glasses. Ensure both 'person' and 'glasses' are present.")
        return None
    
