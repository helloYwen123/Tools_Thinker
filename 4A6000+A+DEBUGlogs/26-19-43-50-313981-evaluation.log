        print("Threshold is required and not specified.")
        return None
    
    if isinstance(model_name, str) is False or model_name != "tiny" or model_name != "base":
        print("Invalid model name, expected 'tiny' or 'base'.")
        return None
    
    if padding < 0:
        print("Padding is required and not specified.")
        return None

    # Construct image path
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_109_image_1.jpg"
    
    # Load the object detector model
    detector_tool = Object_Detector_Tool()

    # Execute the detection
    detection_result = detector_tool.execute(image_path, labels=labels, threshold=threshold, model_name=model_name, padding=padding)

    # Determine if there are people with glasses detected
    detected_person = False

    if len(detection_result) > 0:
