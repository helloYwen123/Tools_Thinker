class Counter:
    def count_people(self, image_path, labels=["food", "person"], threshold=0.5, model_size="base", padding=20):
        # Detect food and person in the image
        objects = Object_Detector_Tool.execute(image=image_path, labels=["food", "person"], threshold=threshold, model_size=model_size, padding=padding)
        n_people = 0
        for obj in objects:
            if obj["label"] in labels:
                n_people += 1
        return n_people

# Example usage for counting people
