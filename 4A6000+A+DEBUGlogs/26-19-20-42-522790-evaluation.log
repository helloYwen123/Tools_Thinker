def count_owners(image_path, labels, threshold, model_size, padding):
    # Read image
    execution = Object_Detector_Tool.execute(image=path_to_image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    # Get bounding box for each owner
    owner_boxes = []
    
    # Iterate over detected objects
    for object_detection in execution:
        
        # Extract owner name from object label
        owner_name = object_detection['label']
        
        # Extract bounding box coordinates
        bbox = object_detection['box']
        
        # Append bounding box to list of owners
        owner_boxes.append([bbox, owner_name])
    
    return owner_boxes
