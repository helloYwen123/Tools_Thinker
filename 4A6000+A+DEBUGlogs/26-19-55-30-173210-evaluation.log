# Function to count the number of trains stopped at the station
def count_stopped_trains(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=["train"], threshold=0.35, model_size="tiny", padding=30)
    
    train_count = 0
    for object_dict in detected_objects:
        if "box" in object_dict and "train" in object_dict["label"]:
            train_count += object_dict["box"]["bounding_box"][-1]
    
