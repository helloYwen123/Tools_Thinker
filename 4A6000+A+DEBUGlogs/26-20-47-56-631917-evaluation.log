def count_telephone_poles():
    try:
        # Load the image and load labels
        execution = Object_Detector_Tool.execute(image="val_Counting_85_image_1.jpg", labels=["telephone pole"], threshold=0.35)

        # Extract the coordinates of the telephone poles
        poles_coordinates = []

        for detection in execution["output_type"]:
            if detection["label"] == "telephone pole":
                coordinates = detection["box"]
                poles_coordinates.append(coordinates)

        return len(poles_coordinates)
    except:
        return "Error detecting telephone poles"

