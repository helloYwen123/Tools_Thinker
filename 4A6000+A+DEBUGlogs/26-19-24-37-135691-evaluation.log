def count_kids_on_bench(image_path):
    # Load the image using the Object_Detector_Tool
    tool = Object_Detector_Tool()
    execution = tool.execute(image=image_path)

    # Access the result for detected objects and their positions
    objects = execution['output_type']

    # Initialize a counter for the number of kids
    count_kids = 0

    # Iterate through the detected objects
