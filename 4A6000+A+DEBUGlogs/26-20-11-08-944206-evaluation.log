def how_many_people_are_laying_down(image_path, labels=None, threshold=None, model_size="tiny", padding=20):

    # Load the object detector tool
    detector = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Detect the number of people in the image
    detected_people_objects = detector.execute()

    # Count the number of people in the image
    num_people = len(set([obj.label for obj in detected_people_objects if obj.label not in labels]))

    return num_people
