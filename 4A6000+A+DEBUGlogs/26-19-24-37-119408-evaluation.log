def count_drive_wheels(image_path):
    # Load the image and perform object detection
    detection = Object_Detector_Tool.execute(image_path, labels=["train"], threshold=0.35)
    
    # Get the bounding box for the train's wheels
    wheel_bounding_boxes = [bbox for bbox in detection['output_type'] if bbox['category']=='train'][0]['box']
    
    # Count the number of drive wheels
    drive_wheel_count = len(wheel_bounding_boxes)
    
    return drive_wheel_count

