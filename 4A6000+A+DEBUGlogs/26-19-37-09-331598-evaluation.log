def count_chicken_nuggets(image_path, labels=None, threshold=None, model_size='tiny', padding=20):
    # Load object detector tool
    detector_tool = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Detect chicken nuggets
    object_detection = detector_tool.execute()

    # Parse and count chicken nuggets
    for obj in object_detection:
        if obj['label'] == 'chicken nugget':
