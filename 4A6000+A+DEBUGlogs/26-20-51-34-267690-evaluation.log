def count_signs(image_path, labels=None, threshold=0.35, model_size="tiny", padding=20):
    try:
        detector = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        # Check if the input image is valid and readable
        if "bbox" in detector.output_type and len(detector.output_type) > 1:
            # Iterate through the detection boxes to tally the "STOP" signs
            for box, label in detector.output_type:
                if label == "STOP" and "bbox" in detector.output_type[0]:
                    count = int(detector.output_type[0]['bbox'][1]) + int(detector.output_type[0]['bbox'][3]) + int(detector.output_type[0]['bbox'][5]) + int(detector.output_type[0]['bbox'][2])
                    final_result += [count]
            return final_result  # Return the count of "STOP" signs
        else:
            raise ValueError("The image is not valid.")
    except Exception as e:
        print("Error:", e)
        return None  # May raise an exception if the input image is not valid

