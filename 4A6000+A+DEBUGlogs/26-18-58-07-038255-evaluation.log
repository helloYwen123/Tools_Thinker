def count_yellow_stars(bridge_image_path) -> int:
    """
    Counts the number of yellow stars on a colorful bridge.
    
    :param bridge_image_path: Path to the image of the bridge.
    :return: Number of yellow stars on the bridge.
    """
    detection_tool = Object_Detector_Tool()
    
    try:
        detection_tool.execute(image=bridge_image_path, labels=["yellow star"], threshold=0.5, model_size="tiny", padding=10)
        detected_objects = detection_tool.output_types[0]
        total_yellow_stars = sum(int(detected_object["label"]) for detected_object in detected_objects)
        return total_yellow_stars
    except Exception as e:
        print(f"Error counting yellow stars: {e}")
        return 0

def main():
    # Counting yellow stars
    result = count_yellow_stars("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_71_image_1.jpg")
    print(f"Number of yellow stars: {result}")

if __name__ == "__main__":
