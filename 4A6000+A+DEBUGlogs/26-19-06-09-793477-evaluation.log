def count_colored_tiles():
    # Load the image with object detection
    img = cv2.imread("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_5_image_1.jpg", 1)

    # Detect objects using the Grounding DINO model
    objects = Object_Detector_Tool.execute(image=img, labels=["Counting"])
    
    # Filter objects to consider as colored tiles based on RGB color
    colored_tiles = [object['label'] in ['Baseball', 'Basket'] for object in objects]
    
    # Count the number of colored tiles above the sink
    return len([tile for tile in colored_tiles if tile])

