def common_vowels_count(image_path):
    # Initialize the object detector tool with the default parameters
    detector = Object_Detector_Tool()

    # Execute the object detection tool
    detection_info = detector.execute(image_path, labels=["e", "a", "o", "i", "u", "y"], threshold=0.35, model_size="tiny", padding=20)

    # Count the number of common vowels in the detected objects
    common_vowels_count = sum(['e', 'a', 'o', 'i', 'u'].count(d['label']) for d in detection_info)

    return common_vowels_count

