def count_players_wearing_red_shirts(image_path='val_Counting_81_image_1.jpg'):
    # Load the image
    image = Object_Detector_Tool.load_image(image_path)
    
    # Detect players wearing red shirts using the object detector tool
    for result in Object_Detector_Tool.execute(image=image, labels=['red_shirt']):
        if result['label'] == 'red_shirt':
            # Extract the bounding box coordinates from the detected objects
            bbox = (result['box'][0], result['box'][1]-result['box'][3], result['box'][2], result['box'][3]+result['box'][5])
            
            # Count the number of players in the box by checking if the number of players in the box exceeds 1
            count = len([bbox for bbox in result['bbox'] if len(set([bbox[0], bbox[1], bbox[2], bbox[3]])) > 1])
            return count

