def calculate_tigers(caption):
    # Convert the caption to a list of object labels
    labels = caption.split(',')[:-1]
     
    # Initialize the result list
    tigers = []

    # Iterate through each object label
    for label in labels:
        # Check if the label contains "tiger"
        if "tiger" in label:
            # If it does, check if the number after the comma is an integer and add it to the result list
            numbers = label.split(",")[1].split(".")[0]
            if numbers.isdigit():
                tigers.append(int(numbers))
            else:
                tigers.append(label.split(",")[1])
        else:
            # If the label doesn't contain "tiger", skip it
            pass
    
