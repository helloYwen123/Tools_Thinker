def count_people_wearing_blue_shirt(image_path):
    # Load the trained DINO model
    detector = Object_Detector_Tool()
    
    # Load the saved images path
    saved_image_paths = ['dino_image_1.png', 'dino_image_2.png', 'dino_image_3.png']
    
    # Create a list of object labels to detect
    labels = ['baseball']
    
    # Configure the detection options
    config = detector.config_dict
    config['model'] = 'base'
    config['padding'] = 20
    
    # Execute the detection on the image
    execution = detector.execute(image_path, labels, config)
    
    # Count the numbers of people wearing blue shirt
    count_blue_shirt = 0
    for bounding_boxes in execution["output_type"][1:]:
        if 'blue' in bounding_boxes['label']:
            count_blue_shirt += 1
            
    return count_blue_shirt

