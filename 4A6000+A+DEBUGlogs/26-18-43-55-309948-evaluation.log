    object_detector = Object_Detector_Tool()
    detected_objects = object_detector.execute(image=str(img), labels=["ones", "black", "white"], threshold=0.35, model_size="tiny", padding=20)

    # Count the number of objects found
    count_ones = 0
    for object in detected_objects:
        if object["label"] == "ones":
            count_ones += 1

    return count_ones
