def count_fingers(image_path, labels=None, threshold=0.35, model_size='tiny', padding=20):
    tool_folder = 'object_detector'
    image = image_path
    labels = labels if labels else ['hand']
    threshold = threshold if threshold is not None else 0.35
    model_size = model_size if model_size else 'tiny'
    padding = padding if padding is not None else 20

    detection = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Filter detected objects and only keep those that match 'hand'
    hand_objects = [
        obj
        for obj in detection
        if obj['label'] == 'hand'
    ]

    if not hand_objects:
        return 0

    # Count the number of fingers in the bath tub
    # The number of fingers is the number of objects matching 'hand' that do not have a lower y-coordinate than the top hand object
    try:
        hand_objects = sorted(hand_objects, key=lambda obj: (obj['bbox'][1], obj['bbox'][0]))
        hand_objects = hand_objects[0]['bbox'][1] + hand_objects[0]['bbox'][0]
        hand_objects = sorted(hand_objects, reverse=True)
        num_fingers = hand_objects.index(0) + 1
    except IndexError:
        # No hand objects found, count as 0
        num_fingers = 0

    return num_fingers
