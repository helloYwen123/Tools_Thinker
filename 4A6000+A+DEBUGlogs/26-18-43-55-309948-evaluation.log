def count_fingers(image_path):
    import numpy as np

    # Load the image
    image = np.array(Image.open(image_path))

    # Convert the image to RGB for better performance
    image = image[:, :, ::-1]  # Swap R and G channels for faster processing

    # Initiate the object detector tool
    tool = Object_Detector_Tool(image=image)

    # Detect objects with specified labels and threshold
    detections = tool.detect_objects_with_labels_and_threshold(4, 0.5, labels=["finger"], threshold=0.35, model_size="tiny")

    # Find the length of a finger based on the bounding box information
    finger_length = np.array([bbox[2] - bbox[0] for bbox in detections])[:1, 2]  # Get the length of a finger

    # Count the fingers
    finger_count = np.sum(finger_length)  # Sum the length of all fingers

    return finger_count

