def count_people_with_green_jacket(image_path):
    detector_tool = Object_Detector_Tool()
    detection = detector_tool.execute(image_path, labels=["coat"], threshold=0.35, model_size="tiny", padding=20)
        
    green_jackets = [i["label"] == "coat" for i in detection if i["label"] == "coat" and i["confidence score"] > 0.5]
        
    num_green_jackets = sum(green_jackets)
    
    return num_green_jackets

