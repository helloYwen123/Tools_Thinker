def count_white_hats(image_path):
    # Load the image
    execution = Object_Detector_Tool.execute(image=image_path, labels=["white cap"], threshold=0.35, model_size="tiny")
    # Print out information for each detected object
    for detection_dict in execution:
        if "white cap" in detection_dict["label"]:
            print(detection_dict["label"])
            print(detection_dict["confidence score"])
            print("Box: ", detection_dict["box"])
            print("Saved image path: ", detection_dict["saved_image_path"])
    # The number of white hats would be the sum of these detected objects
    white_hats_count = sum(1 for _ in range(0, len(execution)))

    return white_hats_count

