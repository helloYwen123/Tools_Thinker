def count_people_with_yellow_jacket(image_path):
    # Load the image and convert it to RGB format
    image = Image.open(image_path)
    image = ImageOps.colorize(image, "yellow")
    
    # Create a DINO object detector using the provided label and threshold values
    detector = Object_Detector_Tool(image=image, labels=["Yellow_Jacket"], threshold=0.5, model_size="base", padding=20)
    
    # Display the detected objects and their bounding boxes
    for bbox in sorted(detector.output_data('detected_objects'), key=lambda x: x['box'], reverse=True)[:10]:
