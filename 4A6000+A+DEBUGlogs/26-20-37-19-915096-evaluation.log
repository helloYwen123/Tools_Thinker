def analyze_image(image_path):
    detection = Object_Detector_Tool.execute(image_path, ['baseball', 'basket'])

    # Check if baseball was detected and the ball was correctly identified as the ball
    if "baseball" in detection and "ball" in detection[1]["box"]:
        ball_found = True
    else:
        ball_found = False

    return ball_found


def count_white_hats(image_path):
    detection = Object_Detector_Tool.execute(image_path, ['baseball', 'basket'], threshold=0.5, model_size="base", padding=20)
    if detection:
        # Assuming the ball detection and ball identification confirm the presence of a ball
        for person in detection:
            if "person" in person and person[1]["label"] == "baseball":
                hit_counter += 1
    return hit_counter


