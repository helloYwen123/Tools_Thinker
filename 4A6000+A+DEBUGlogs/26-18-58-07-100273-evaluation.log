                'label': detection['bbox[0].categories.0.label'],
                'confidence score': detection['bbox[0].det_labels.0.confidence'],
                'box': detection['bbox[0].bbox'],
                'saved_image_path': f"results/generated_detections/{detection['bbox[0].categories.tag'][0]}.png"
            }
            detections.append(object_info)
        return detections
