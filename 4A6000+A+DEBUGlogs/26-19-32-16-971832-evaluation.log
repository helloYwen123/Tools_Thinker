# Function to calculate the number of elephants in the water based on the image and parameters provided.
def calculate_elephants_in_water(image_file, labels=["elephant"], threshold=0.5, model_size="tiny", padding=20):
    # Load the object detection model and parameters
    object_detector = Object_Detector_Tool(image=image_file, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    detections = object_detector.execute()
    
    # Calculate the number of elephants in the water
    num_elephants = sum(1 for (name, conf, pos) in detections if "elephant" in name and conf > threshold)
    
    return num_elephants

