def count_elephants(image_path, labels, threshold, model_size="tiny", padding=20):
    detection = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    elephants = []
    # Check if the image contains any elephants
    for obj in detection:
        if "elephant" in obj['label'] and "long" in obj['label'] or "small" in obj['label']:
            elephants.append(obj['bbox'])
    if len(elephants) > 0:
        return len(elephants)
    else:
        return 0

