Code: from object_detector import Object_Detector_Tool

def count_people(image_path, labels, threshold, model_size, padding):
    detector = Object_Detector_Tool()
    image = detector.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    predictions = []
    
    for obj in image['predicted_result'][-1]:
        if obj['label'] in labels:
            predictions.append((obj['label'], max(0, obj['confidence_score'])))
        
    count = 0
    for predicted in predictions:
        if predicted[0] == 'person':
            count += 1
    
    return count

