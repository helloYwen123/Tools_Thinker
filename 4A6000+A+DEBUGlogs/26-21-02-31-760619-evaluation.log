def count_people(image_path, labels=["person"], threshold=0.5, model_size="tiny", padding=20):
    """
    This function detects people in an image using the Grounding DINO model.

    Parameters:
    - image_path: The path to the image file.
    - labels: A list of object labels to detect.
    - threshold: The confidence threshold for detection (default: 0.35).
    - model_size: The size of the model to use ('tiny' or 'base', default: 'tiny').
    - padding: The number of pixels to add as empty padding around detected objects (default: 20).

    Returns:
    A list of detected objects.
    """
    object_detector_tool = Object_Detector_Tool()
    detection = object_detector_tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Filter and sort detected persons
    people = [person for person in detection if "person" in person['name']]
    people.sort(key=lambda x: x['confidence'])

    return people

# Sample usage
