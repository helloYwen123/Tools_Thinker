def get_people_ate_sandwiches(sandwiches):
    # This counts the number of people eating the sandwich from its bounding boxes.
    # Each person bounding box should have [x, y, width, height] coordinates.
    # The result is the average of the people counts.
    people_counts = []
    for i, sandwich in enumerate(sandwiches):
        # Check bounding box coordinates.
        if not (sandwich.bbox and sandwich.rectangle):
            continue
        # Average number of people eating the sandwich.
        total_count = len(sandwich.bbox) // 2
        people_counts.append(total_count)
    
    if len(people_counts) == 0:
        return 0
    else:
        return sum(people_counts) / len(people_counts)
