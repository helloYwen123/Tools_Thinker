def count_people(image, labels=None, threshold=0.35, model_size="tiny", padding=20):
    detector = Object_Detector_Tool()
    execution = detector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    # Iterate through the detected objects
    people = []
    for item in execution:
        if "person" in item["label"]:
            people.append({"label": item["label"], "confidence score": item["confidence score"]})
    
    return len(people)

