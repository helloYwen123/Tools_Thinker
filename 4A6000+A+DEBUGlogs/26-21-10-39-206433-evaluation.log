def count_green_carts(image_path, labels=["car", "bike"], threshold=0.5, model_size="base", padding=20):
    detection = Object_Detector_Tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    all_labels = set([obj['label'] for obj in detection['output_type'] if 'car' in obj['label']])
    green_carts = [l for l in all_labels if 'cart' in l and 'green' in l]
    return len(green_carts)

