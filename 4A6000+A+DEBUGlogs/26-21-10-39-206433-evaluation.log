def count_green_train_carts(image_path):
    # Load the image
    print("Loading image...")
    image = Image.open(image_path)
    
    # Detect the image and extract bounding box coordinates
    print("Detecting objects...")
    execution = Object_Detector_Tool.execute(image=image, labels=["baseball"], threshold=0.5, model_size="tiny", padding=20)
    
    # Get the coordinates for the baseballs (assumed to be the green train cars)
    baseballs = {bbox['label']: (bbox['bbox'][0], bbox['bbox'][2], bbox['bbox'][2]) for (bbox, label) in execution['output_type'] if label == "baseball"}
    
    if baseballs:
        # Count the green train cars
        num_green_train_carts = sum(1 for (name, box) in baseballs.items() if box[2] != 0)
        return num_green_train_carts
    else:
        return 0
