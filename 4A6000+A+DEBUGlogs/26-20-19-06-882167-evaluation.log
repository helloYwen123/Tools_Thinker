def count_red_buses(image_path, labeled_list=['baseball', 'basket'], threshold=0.35, model_size='tiny', padding=20):
    # Load image and preprocess
    image = Image.open(image_path)
    image = ImageEnhance.Contrast(image).enhance(10)  # Increase contrast to highlight colors
    image = ImageUtil.zoom(image, zoom_factor=2.5)  # Increase size to fit within the container
    label_dict = {}
    for label in labeled_list:
        label_dict[label] = []

    # Perform object detection
    execution = Object_Detector_Tool.execute(image=image, labels=[label_dict], threshold=threshold, model_size=model_size, padding=padding)
    for row in range(execution['output_type']):
        for label in execution['output_type'][0]:
            x, y, w, h = str(execution['output_type'][0][label]['bbox'][0][0][0][0]*100).split('/')
            confidence = str(execution['output_type'][0][label]['bbox'][0][1][0][0]*10).split('/ ')
            label_dict[label].append([y, x, w, h, confidence[1]], image_path)

    # Accumulate counts
    valid_count = sum([len(x) for y, x in label_dict.values()])

    return valid_count
