    tool = Object_Detector_Tool(tool_module_name="object_detector",
                              tool_class_name="Object_Detector_Tool",
                              tool_description="A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding.",
                              tool_version="1.0.0",
                              input_types={'image': input_image, 'labels': ['candlight'], 'threshold': threshold, 'model_size': 'base', 'padding': 20},
                              output_type=['label', 'confidence score', 'box', 'saved_image_path'],
                              user_metadata={'limitation': 'Detection of candlelight may not always be accurate.'})

    # Perform the detection
    execution = tool.execute(image=input_image, labels=['candlight'], threshold=threshold, model_size=model_size, padding=20)

    # Extract candlelight confidence scores
    if 'candlight' in execution:
        for candlelight in execution['candlight']:
            candlelight_confidence = candlelight['confidence score']
            if candlelight_confidence > 0.9:
                candlelight_box = candlelight['box']
                candlelight_path = candlelight['saved_image_path']
                return candlelight_path
    else:
        return None

