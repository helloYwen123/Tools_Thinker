class MyTool:
    def __init__(self):
        # Initialize the object_detector
        self.object_detector = Object_Detector_Tool()

    def get_objects(self, image_path, labels=["baseball", "basket"], threshold=0.35, model_size="tiny", padding=20):
        # Load your image
        image = Image.open(image_path).convert("RGB")

        # Detect bball and basket
        detection_results = self.object_detector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

        # If the ball is found in the image
        if "ball" in detection_results["output"]:
            ball_path = detection_results["output"]["ball"] + ".png"
            Ball = Image.open(ball_path).convert("RGB")
            return Ball

    def get_objects_with_padding(self, image_path, labels=["car", "person"], threshold=0.5, model_size="base", padding=15):
        # Load your image
        image = Image.open(image_path).convert("RGB")

        # Detect car and person
        detection_results = self.object_detector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

        # If the car is found in the image
        if "car" in detection_results["output"]:
            car_path = detection_results["output"]["car"] + ".png"
            Car = Image.open(car_path).convert("RGB")
            return Car

    def get_objects_with_zero_padding(self, image_path, labels=["baseball", "basket"], threshold=0.35, model_size="tiny"):
        # Load your image
        image = Image.open(image_path).convert("RGB")

        # Detect baseball and basketball
        detection_results = self.object_detector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=0)

        # If baseball is found in the image
        if "ball" in detection_results["output"]:
            ball_path = detection_results["output"]["ball"] + ".png"
            Ball = Image.open(ball_path).convert("RGB")
            return Ball


