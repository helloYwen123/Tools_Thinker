def count_egs_with_trunks_in_water():
    # Load the image and convert it to its grayscale representation
    image = Image.open('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_43_image_1.jpg')
    image = image.convert('L')
    
    # Create an instance of the Object_Detector_Tool class
    detector = Object_Detector_Tool(image_data=image, labels=["trunks"], threshold=0.35, model_size="tiny")
    
    # Detect and extract the bounding boxes of objects
    detection = detector.execute(labels=["trunks"])
    
    # Count the number of elephants with their trunks in the water
    total_egs = len([obj['bbox'] for obj in detection if obj['label'] == "trunks"][0])
    
    return total_egs

