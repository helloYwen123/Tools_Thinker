Code: from object_detector import Object_Detector_Tool

def count_elephant_trunks(image_path):
    # Load the model
    object_detector = Object_Detector_Tool()
    
    # Load the threshold and model size as global variables
    threshold = 0.35
    model_size = "base"
    
    # Perform object detection using the image path and the threshold value
    execution = object_detector.execute(image_path, labels=["elephant", "trunk"], threshold, model_size, padding=20)

    # Get the bounding box annotations for the detected elephant and calculate the count of trunks
    elephant_bbox = [anno['bbox'] for anno in execution['output_type'] if anno['label'] == "elephant"]
    trunks_count = 0
    for bb in elephant_bbox:
        num_trunks = len([trk for trk in bb['bbox'] if trk[2] > 0.25 and trk[2] < 0.8])
        trunks_count += num_trunks

    # Return the count of elephant trunks
    return trunks_count

# Usage
