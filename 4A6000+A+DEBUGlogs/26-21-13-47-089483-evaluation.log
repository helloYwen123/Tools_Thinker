class Object_Detector_Tool:
    def execute(self, image, labels, threshold=0.35, model_size="tiny", padding=20):
        demo_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_32_image_1.jpg"
        with Image.open(demo_image) as im:
            data = im.read()
            imc = Image.frombytes("RGB", im.getDimensions(), data)
            image = imc.resize((480, 480))
        labels = self.labelDetection(image, labels)
        return labels

    def labelDetection(self, input_image_object, labels):
        tool_module_name = "object_detector"
        tool_class_name = "Object_Detector_Tool"

        input_type = "image"

        try:
            detection = self.execute(input_image_object=input_image_object, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        except Exception as e:
            print(f"An error occurred during processing {e}")
            return []
        
        if len(detection) > 0:
            result = []
            for object_info in detection:
                result.append({
                    "label": object_info["label"],
                    "confidence score": object_info["confidence score"],
                    "box": object_info["bbox"],
                    "saved_image_path": "path/to/save/image.png"
                })
            return result
        else:
            return []

