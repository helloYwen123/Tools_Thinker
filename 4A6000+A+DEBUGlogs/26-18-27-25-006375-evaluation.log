                x = (x[0] / 8, x[1] / 8, x[2] / 8, x[3] / 8)  # Convert to relative coordinates
                buns.append((str(x[0])) + ' / ' + str(x[1]))  # Format as 'x/y/z'

            detection_results.append({'bbox': buns, 'confidence score': item['confidence score']})

