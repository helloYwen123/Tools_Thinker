def person_detector(image, labels, threshold, model_size, padding):
    """Detect people in an image using the specified labels, confidence threshold, model size, and padding.
    For enhanced performance in detecting people in images, this function can be used in combination with other tools to provide additional information or verification."""
    detection_results = []
    objects = image.detect_objects(labels=labels)
    for box in objects:
        confidence_score = objects[box]['confidence']
        if confidence_score > threshold:
            detection_results.append((box, objects[box]))
    return detection_results

def hotdog_detector(image, labels=['hotdog'], threshold=0.5, model_size="base", padding=20):
    """Detect hot dogs in an image using the specified labels, confidence threshold, model size, and padding.
    For detecting hot dogs, the tool assumes that the hot dogs are uniformly distributed and can be approximated by the bounding box method.
    The confidence score for each label is calculated based on the area of the bounding box intersection with the label's bounding box and the size of the bounding box intersection, allowing for small variations in hot dog size and distance between hot dogs."""
    detection_results = []
    for hotdog in image.detect_objects(labels=['hotdog']):
        hotdog_label = hotdog['label']
        for person in hotdog_detector(image=image, labels=[hotdog_label], threshold=threshold, model_size=model_size, padding=padding):
            person['confidence'] = hotdog['confidence']
            detection_results.append(person)
    return detection_results

def count_people(image_path):
    # Load image
    image = Image.open(image_path)
    
    # Detect people using the hotdog tool
    hotdog_detection_results = hotdog_detector(image=image, labels=['hotdog'])
    
    # Detect bounding boxes of people using the people detection tool
    people_detection_results = people_detector(image=image, labels=hotdog_detection_results, threshold=threshold, model_size=model_size, padding=padding)
    
    count_people = len(people_detection_results)
    print("People detected:", count_people)
    return count_people

