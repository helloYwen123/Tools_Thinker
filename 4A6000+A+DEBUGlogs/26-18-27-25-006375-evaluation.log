def count_sandwiches(image_path, labels=['hot dog'], threshold=0.5, model_size='tiny', padding=20):
    """
    Counts the number of hot dogs visible in an image.
    
    Parameters:
    - image_path: A string representing the path to the image file.
    - labels: A list of object labels to detect.
    - threshold: The confidence threshold for detection (default: 0.35).
    - model_size: The size of the model to use ('tiny' or 'base', default: 'tiny').
    - padding: The number of pixels to add as empty padding around detected objects (default: 20).
    
    Returns:
    - The number of detected sandwiches.
    """
    # Load the Detection Tool and execute the function
    detection = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    # Count the number of sandwiches
    sandwich_count = len([obj[0] for obj in detection if 'hot dog' in obj[0]])
    return sandwich_count
