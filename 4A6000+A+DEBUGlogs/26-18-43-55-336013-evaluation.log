def count_black_letters(image_path, labels=None, threshold=0.35, model_size="tiny", padding=20):
    """
    Detect black letters in a given image.
    
    Parameters:
    - image_path (str): The path to the image file.
    - labels (list): A list of object labels to detect. Default is ['baseball', 'basket'].
    - threshold (float): The confidence threshold for detection. Default is 0.35.
    - model_size (str): The size of the model to use. Default is 'tiny'.
    - padding (int): The number of pixels to add as empty padding around detected objects. Default is 20.
    
    Returns:
    - list: A list of detected objects dictionaries with ('label';'confidence score';'box';'saved_image_path') keys and their corresponding values.
    """
    # Load the image and detect black letters
    detection = None
    labels_to_search = ['baseball', 'basket']
    if labels is not None:
        detection = Image_Agent.execute(image_path, labels=labels_to_search, threshold=threshold, model_size=model_size, padding=padding)
    
    if detection is not None and 'baseball' in detection['labels'] or 'basket' in detection['labels']:
        detected_object = detection['output_type']
        detected_object_length = len(detected_object)
        final_result = f"Number of signs with black letters: {detected_object_length}"
    else:
        final_result = "No signs found"

    return final_result

