Code: from object_detector import Object_Detector_Tool

def count_banners(image_path="path/to/image.jpg"):
    # Load image
    image = Image.open(image_path)
    
    # Detect objects
    execution = Object_Detector_Tool.execute(image=image, labels="banners", threshold=0.35, model_size="tiny")
    
    # Count objects
    banner_banners = 0
    if "banners" in execution:
        for label in execution["label"]:
            if label.lower().startswith("banners"):
                banner_banners += len(execution["bbox"]))
    
    return banner_banners

