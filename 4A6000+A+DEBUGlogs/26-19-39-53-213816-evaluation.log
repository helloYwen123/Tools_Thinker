def how_many_toilets(left_distance):
    # Detect objects like toilets and sinks in the image
    detection_results = Object_Detector_Tool.execute(image="path/to/image.jpg", labels=["toilet", "sink"], threshold=0.25, model_size="base")

    # Count objects left of the basins
    left_toilets = [object['bbox'] for object in detection_results['output_type'][0] if (left_distance > 0 and 'left' in object['bbox']) or (left_distance < 0 and object['bbox'][2] < left_distance)]

    return len(left_toilets)

