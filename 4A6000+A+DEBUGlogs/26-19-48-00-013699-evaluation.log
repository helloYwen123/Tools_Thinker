def count_wearing_hats(image_path):
    # Initialize the object detector tool
    detection_tool = Object_Detection_Tool()

    # Load the image
    with open(image_path, 'rb') as image_file:
        detection_tool.load_image(file=image_file)
        
    # Detect human body parts
    label = ["baseball", "basket", "car", "person"]
    threshold = 0.35
    model_size = "tiny"
    padding = 20
    
