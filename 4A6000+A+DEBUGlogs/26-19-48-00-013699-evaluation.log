    detection_tool.detect_objects(image_path, labels=label, threshold=threshold, model_size=model_size, padding=padding)
    
    # Return the number of person detections
    if detection_tool.result_list is not None:
        wearing_hats_count = len([i for i in detection_tool.result_list if "baseball" in label])
