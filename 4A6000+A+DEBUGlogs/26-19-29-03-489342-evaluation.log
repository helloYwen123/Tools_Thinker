class Image_Analysis_Tool:
    def count_purple_planes(self, image_path):
        # Convert image to grayscale
        image = Image.open(image_path).convert("L")
        
        # Perform object detection using DINO
        detector = Object_Detector_Tool(image=image, labels=["airplane"], threshold=0.5, model_size="base", padding=0)
        
        # Get the detections
        detections = detector.output_types[1]
        
        # Count the count of purple planes
        purple_planes_count = sum(d["label"] == "purple" for d in detections)
        
