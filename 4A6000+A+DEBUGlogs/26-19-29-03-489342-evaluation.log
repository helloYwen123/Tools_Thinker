def detect_plane_or_car(image_path, object_labels, threshold=0.35, model_size="tiny", padding=20):
    detection_result = []
    try:
        detector = Object_Detector_Tool(threshold=threshold, model_size=model_size)
        detector.detect_object_from_image(image_path, labels=object_labels)
        planes = [box for box in detector["output_type"][1] if box[2] == "plane"]
        cars = [box for box in detector["output_type"][1] if box[2] == "car"]
        if planes:
            plane_count = len(planes)
        else:
            plane_count = 0
        if cars:
            car_count = len(cars)
        else:
            car_count = 0
        final_result = {"planes": plane_count, "cars": car_count}
    except Exception as e:
        final_result = {"error": str(e)}
    return final_result
