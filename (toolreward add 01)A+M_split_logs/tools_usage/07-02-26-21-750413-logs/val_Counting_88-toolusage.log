from object_detector import Object_Detector_Tool
import Image
import numpy as np

def detect_objects(image_path):
    image = Image.open(image_path)
    labels = ['baseball', 'basket']
    save_object = True
    saved_image_path = 'detected_objects'
    
    detected_objects, object_number = Object_Detector_Tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=(saved_image_path))
    print(f"Detected the following objects: {detected_objects}")
    for label, entries in detected_objects.items():
        for entry in entries:
            print(f"- {label}: {entry}")
    return object_number

final_result = detect_objects('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_88_image_1.jpg')
