def recognize_image(path):
    # Load the image
    image = Image.open(path)
    # Detect text in the image
    result = Text_Detector_Tool.execute(image, languages=['en', 'de'])
    # If text is detected, return the list of detected text blocks
    if result:
        letter_blocks = result[0].copy()
        letter_blocks.insert(1, 'Detected text')  # Add detection to the text block
        letter_blocks.insert(3, result[0][3])
        return letter_blocks
    # Return empty list if no text is detected
    return []

# Call the function with the provided test image
final_result = recognize_image('path/to/image.jpg')
print('Number of people eating sandwich:', final_result)
