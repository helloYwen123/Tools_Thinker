from tool import object_detector
from tool import text_detector
from tool import letter_detector

# Load the image file
image = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_82_image_1.jpg'

# Detect objects in the image using the Grounding DINO model
objects_info = object_detector.execute(image=image, labels=["baseball", "basket"], skip_retries=True)

object_number = object_detector.object_number

# Detect text in the image
text_info = text_detector.execute(image=image, languages=['en', 'de'])

# Detect letters in the image
letters_info = letter_detector.execute(image=image)

# Combine the detected objects, text, and letters to form the final result
final_result = [None, None, None, None, None, None, None]

# Iterate through the detected objects
for obj in objects_info:
    # Iterate through the text information
    for txt_info in text_info:
        if txt_info[2] == obj[2]:
            # Iterate through the detected letters
            for lst in letters_info:
                if lst[2] == obj[2]:
                    final_result[0] = 'baseball'

# Iterate through the detected objects to find the number of baseballs
for obj in objects_info:
    if obj[2] == 'baseball':
        final_result[1] = len(objects_info)

# Iterate through the detected objects to find the number of baskets
for obj in objects_info:
    if obj[2] == 'basket':
        final_result[2] = len(objects_info)

# Iterate through the detected objects to find the number of detected letters
for lst in letters_info:
    if lst[2] == 'baseball':
        final_result[3] = len(lst)

# Convert to correct form
final_result = [0 if x == None else x for x in final_result]

# Replace '?' with the correct value
final_result[3] = 0 if objects_info[0][1] == None else objects_info[0][1]

print(final_result)
