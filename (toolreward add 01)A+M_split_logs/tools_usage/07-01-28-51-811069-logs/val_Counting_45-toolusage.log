from letter_detector import Letter_Detector_Tool

# Sample code using the letter_detector tool
def is_bus_has_two_motors(image_path):
  letter_detector_tool = Letter_Detector_Tool(imagePath=image_path)
  detected_letters = letter_detector_tool.execute()

  if detected_letters:
    # Assuming the detected_letters list contains tuples of (bbox, recognized text, and score)
    detected_numbers = [f"{number}" for number in range(1, 12)]

    for bbox, recognized_text, score in detected_letters:
      # Check if recognized text contains 'motor'
      if recognized_text.lower() in detected_numbers:
        return True

    return False

