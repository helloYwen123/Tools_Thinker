from letter_detector import Letter_Detector_Tool



def analyze_extras(image_path):
    # Load the image using PIL
    img = Image.open(image_path)

    results = Letter_Detector_Tool.execute(image=image_path)

    detected_letters = []
    for letter_result in results:
        bounding_box = [letter_result[1], letter_result[2]]
        letter = letter_result[3]
        confidence = letter_result[4]
        detected_letters.append([bounding_box, letter, confidence])

    return detected_letters


def count_text_blocks_in_image(image_path):
    text_blocks = []

    for letter_result in analyze_extras(image_path):
        letter = letter_result[3]
        confidence = letter_result[4]

        if letter == 'E':
            for bounding_box in letter_result[1]:
                x0, y0 = bounding_box
                x1, y1 = bounding_box

                w, h = x1 - x0 + 1, y1 - y0 + 1

                if w == 1 and h == 1:
                    text_blocks.append([bounding_box, 'E', confidence])

    return text_blocks


