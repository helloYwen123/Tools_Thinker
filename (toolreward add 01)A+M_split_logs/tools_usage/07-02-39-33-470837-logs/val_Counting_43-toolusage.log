"""
Detect elephants and count how many have their trunks in the water
"""

import object_detector as Object_Detector_Tool
import string

from_module = 'object_detector'
import_name = 'Object_Detector_Tool'
input_module = 'image'
output_module = 'detected_objects'

def detect_trunks_and_count(elephant_images, water_depth):
    final_result = {}
    for elephant in elephant_images:
        for label in ['elephant trunk', 'water']:
            if label in elephant and (label == 'elephant trunk' or (water_depth <= 2 and label == 'water')):
                result = Object_Detector_Tool.execute(image=elephant, labels=[label], threshold=0.5, model_size='tiny', save_object=True, saved_image_path=f'detected_objects/{label}/')
                if not result[0]:
                    continue
                for d_result in result[0]:
                    if label == 'elephant trunk' and d_result[1]['score'] >= 0.9 and d_result[1]['bbox'][0][0] <= len(elephant) and d_result[1]['bbox'][1][0] >= 258 and d_result[1]['bbox'][1][1] < len(d_result[1]['bbox'][1][1]) - 170:
                        final_result[label] = final_result.get(label, 0) + 1

    return [final_result.get(k, 0) for k in final_result], final_result

