from object_detector import Object_Detector_Tool

final_result = ""
# Get the file paths for the images
image_paths = [
    "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg"
]

# Use the Object_Detector_Tool to detect objects in the images
for image_path in image_paths:
    detector = Object_Detector_Tool(
        save_object=True, saved_image_path=image_path
    )
    labeled_objects = detector.execute(image=image_path, labels=["baseball", "basket"])

    if labeled_objects:
        # Extract the letter bounding boxes and letter text
        letter_bbxs = [bbox for obj in labeled_objects for bbox in obj["bbox"]]
        letter_texts = [letter.lower() for obj in labeled_objects for letter in obj["score"][0]]

        # Sort the letter bounding boxes by their score
        letter_bbxs.sort(key=lambda x: x[2])

        detected_letters = " ".join(letter_texts)
        
        if letter_texts:
            final_result += "Found " + detected_letters + " letter:"
        if letter_texts and labeled_objects:
            final_result += f" with {len(letter_texts)} letters detected in the following letters: {' '.join(letter_texts)}"
        else:
            final_result += " No letters found."
    else:
        final_result += " No objects detected."
============================== END ==============================

