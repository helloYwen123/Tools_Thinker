def identify_people_with_blue_shirt(image_path):
    # Use the Letter_Detector_Tool to detect letters in the image
    results = Letter_Detector_Tool.execute(image=image_path)
    
    # Count the number of people wearing blue shirts
    blue_shirt_count = sum(1 for result in results if result[2].lower() == "blue")
    
    final_result = {"People wearing blue shirt": blue_shirt_count}
    
    return final_result

# Check with the provided image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg"
