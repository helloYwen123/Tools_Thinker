from text_detector import Text_Detector_Tool

# Convert image path to PIL image object
if os.path.exists('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg'):
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg'
    image = Image.open(image_path)
else:
    image = None

# Detect text in the image
if image:
    try:
        text_blocks = Text_Detector_Tool.execute(image=image, languages=['en', 'de'], detail=0)
        detected_text = [block for _, block in text_blocks]

        if detected_text:
            final_result = "Detected Text"
        else:
            final_result = "No Text detected"
    except Exception as e:
        final_result = "Text Detection Failed" + str(e)
else:
    final_result = "Image does not exist"
