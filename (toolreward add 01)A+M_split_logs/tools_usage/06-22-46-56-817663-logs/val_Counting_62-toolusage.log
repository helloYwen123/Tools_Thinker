from object_detector import Object_Detector_Tool, Text_Detector_Tool, Letter_Detector_Tool

# Set up tools
detector_tool = Object_Detector_Tool(tool_module_name="object_detector")
text_tool = Text_Detector_Tool(tool_module_name="text_detector")
letter_tool = Letter_Detector_Tool(tool_module_name="letter_detector")

# Load image
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_62_image_1.jpg"
image = detector_tool.execute(image=path_to_image, languages=["en", "de"])

# Detect text
results_en = text_tool.execute(image=str(image), languages=["en"])
results_de = text_tool.execute(image=str(image), languages=["de"])

if results_en and results_de:
    text_detected = results_en + results_de
    detected_text_blocks = []
    for text_detected_en in text_detected:
        text_detected_en_tuple = []
        for bdx, letter, bcy in text_detected_en["bbox", "letter", "score"]:
            bdy = bbx + bbox + [bbox[-1] - 10]
            text_detected_en_tuple.append([bdx, bdy, letter, bcy])
            detected_text_blocks.append(bdx, bdy, letter, bcy)  # Assuming the image is grayscale, convert to RGB for easier detection
else:
    detections = []

# Concatenate detected text blocks
concatenated_text_blocks = []
for text_detected_en_tuple in detected_text_blocks:
    concatenated_text_blocks.append(text_detected_en_tuple)

# Assuming text detection fails, return an empty list
if text_detected_en_tuple:
    concatenated_text_blocks = detected_text_blocks

final_result = concatenated_text_blocks[0][0]
