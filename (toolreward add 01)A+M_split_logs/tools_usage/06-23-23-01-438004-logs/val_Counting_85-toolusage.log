from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_phone_poles(image_path):
    # Load image
    image = Image.open(image_path)

    # Detect objects
    results = Object_Detector_Tool.execute(image=image, labels=["telephone pole"],
                                    saved_image_path="out.png", language="en")

    # Extract detected objects from the results dictionary
    detected_objects = results.get('baseball', results.get('basket'))

    # Total number of detected telephone poles
    total_poles = len(detected_objects) * detected_objects.get('box', [0, 0]).count(100, 150)

    return total_poles

# Path to an image in the COUNTING_85_IMAGE_1 dataset
