from object_detector import ObjectDetector_Tool

# Load image files
image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_99_image_1.jpg"

# Set the object labels to be detected
labels = ["baseball", "basket"]

# Set the desired threshold for confidence score
threshold = 0.35

# Set the size of the model to use
model_size = "tiny"

# Set whether to save the detected objects as images or not
save_object = True

# Execute the object detector tool
result = ObjectDetector_Tool.execute(image=image, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

# Extract object detections
detected_objects = result["detected_objects"]
object_number = result["object_number"]

# Determine the number of persons driving the red car front of the train
if detected_objects:
    for detection in detected_objects:
        if detection["bbox"][0] == (36, 50) and detection["bbox"][1] == (200, 150) and detection["bbox"][2] == (200, 200) and detection["bbox"][3] == (100, 200):
            final_result = f"{detected_objects['baseball']}"

    else:
        final_result = f"{object_number}"
else:
    final_result = "No detected objects"
