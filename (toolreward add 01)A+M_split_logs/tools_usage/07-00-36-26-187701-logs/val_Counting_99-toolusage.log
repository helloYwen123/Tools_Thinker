from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(
    image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_99_image_1.jpg",
    labels=[
        "car"
    ],
    save_object=False
)

if "detected_objects" in final_result:
    car_count = len(final_result["detected_objects"]["car"])
else:
    car_count = 0

if "object_number" in final_result:
    final_result = final_result["object_number"]
else:
    final_result = {}

if car_count > 0:
    if "ch_sim" in final_result:
        ch_sim_count = final_result["ch_sim"].get("baseball")
        if ch_sim_count > 0:
            ch_sim_count = "Chinese_Simplified_Chinese"
        elif "ch_sim" not in final_result:
            ch_sim_count = "Chinese_Simplified_Chinese"
    else:
        ch_sim_count = final_result["ch_sim"]

if car_count > 0 and ch_sim_count is not None:
    if "en" in final_result["ch_sim"]:
        en_count = final_result["en"].get("car")
        if en_count > 0:
            en_count = "English"
    elif "fr" in final_result["ch_sim"]:
        fr_count = final_result["fr"]
        fr_count = "French"
    elif "de" in final_result["ch_sim"]:
        de_count = final_result["de"]
        de_count = "German"
    elif "es" in final_result["ch_sim"]:
        es_count = final_result["es"]
        es_count = "Spanish"
    else:
        es_count = "English"
    if en_count is not None and es_count is not None:
        if en_count == "English" and ch_sim_count != "English" and es_count == "E":
            if car_count == 1:
                ch_sim_count = "J"
            elif car_count == 2:
                ch_sim_count = "E"
            elif car_count == 3:
                ch_sim_count = "E"

final_result = {"name": "BMW", "model": "3", "count": car_count, "language": en_count, "ch_sim": {"baseball": 2, "basket": 1}}
