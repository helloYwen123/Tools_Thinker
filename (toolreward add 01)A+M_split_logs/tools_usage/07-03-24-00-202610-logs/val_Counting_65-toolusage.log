final_result = 0

# Import necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Function to execute object_detector_tool
def execute_observer(image, labels, save_object=True, saved_image_path=None):
    detected_objects = {}
    object_number = {}
    
    # Check if the command and related function have been imported
    if 'Object_Detector_Tool' in inspect.getmodule().__name__ and 'Text_Detector_Tool' in inspect.getmodule().__name__ and 'Letter_Detector_Tool' in inspect.getmodule().__name__:
        try:
            # Process object detection results
            detected_objects = Object_Detector_Tool.execute(image, labels)
            
            # Process text detection results
            result_text = []
            languages = ['en', 'de']
            for text_language in languages:
                result_text += Text_Detector_Tool.execute(image, languages=[text_language])
            
            # Process letter detection results
            letter_results = Letter_Detector_Tool.execute(image)
            detected_letters = []
            for letter_results_list in letter_results:
                detected_letters.extend(letter_results_list)
            
            # Store results
            detected_objects.update(detected_letters)
            object_number.update(detected_objects)
            
            if save_object:
                detected_objects = object_number
            
            # Save results if save_object is set to True
            detected_objects = object_number
            for label, detection in detected_objects.items():
                detected_objects[label].append([detection[0], text_results[0], detection[2]])
        
        except Exception as e:
            print(f'Error occurred when execution detected_object:{str(e)}')
            final_result = None
    
    return detected_objects, object_number, final_result
