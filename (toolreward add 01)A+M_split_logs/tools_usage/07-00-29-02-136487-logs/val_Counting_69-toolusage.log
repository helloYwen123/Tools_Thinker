from path import *
import object_detector
import text_detector
import letter_detector

# Load image and detect labels
labels = object_detector.execute(image=image_path, save_objects=False)

# Detect text in the image
languages = [ 'en', 'de' ]
results = text_detector.execute(image=image_path, languages=languages)

# Use letter_detector to detect the letters mentioned in the image
final_result = []

for result in results:
    detected_letters = letter_detector.execute(image=result[0])
    detected_letters = [item['letter'] for item in detected_letters] if detected_letters else []

# Print final_result
for result in final_result:
    print(result)
