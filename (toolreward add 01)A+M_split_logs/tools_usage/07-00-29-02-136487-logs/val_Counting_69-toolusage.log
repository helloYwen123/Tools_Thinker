def countVowels(image_path):
    detector = Letter_Detector_Tool()
    result = detector.execute(image=image_path)
    vowels = ['a', 'e', 'i', 'o', 'u']
    count = result.count(row[4] for row in result if row[4] in vowels)
    return f"{count}."

final_result = countVowels("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_69_image_1.jpg")
print(final_result)
