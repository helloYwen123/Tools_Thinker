def count_detected_letters(image_path):
    with open(image_path, 'r', encoding='utf-8') as image_file:
        content = image_file.read()
        results = Letter_Detector_Tool.execute(image=image_file)
        detected_letters = []
        for letter_dict in results:
            if letter_dict['score'] > 0.8:  # Adjust the confidence threshold as needed
                detected_letters.append({
                    'bbox': letter_dict['bbox'],
                    'recognized_text': letter_dict['recognized_text'],
                    'score': letter_dict['score']
                })
        if detected_letters:
            return detected_letters
        else:
            return None

final_result = count_detected_letters('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_65_image_1.jpg')
print(final_result)
