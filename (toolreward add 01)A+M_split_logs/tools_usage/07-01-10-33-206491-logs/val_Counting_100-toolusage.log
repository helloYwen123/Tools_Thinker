def detect_objects(image_path):
    # Use the object detector tool to detect text and numbers in the image
    generated_codes = Object_Detector_Tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")
    
    return generated_codes

# Create an image object with an example image path and additional options (if needed)
image_obj = Image()

# Call the detect_objects function to get the detected objects
objects_codes = detect_objects(image_obj.img_path)

# Analyze the number of detected objects in the image
object_labels = [object_labels[0]["label"] for object_labels in objects_codes.object_results]
object_count = {label: len(objects_codes.object_results[0]["bbox"]) for label in object_labels}
  
final_result = min(object_count, key=object_count.get)
