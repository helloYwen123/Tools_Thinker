from image_helper import *

# Load the image
im = Image.open("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_67_image_1.jpg")

# Execute the text detector tool with details set to 0 (simple output)
result = Text_Detector_Tool.execute(image=str(im), languages=['en', 'de'], detail=0)

# Extract the detected text blocks
text_blocks = []

for block in result:
    if 'Detected text' in block[0]:
        text_blocks.append([block[1], block[0], block[2]])

# Convert the text blocks to a dictionary
text_dict = {text_str: text_block[1] for text_str, text_block in zip(result[1][1], result[0])}

if not text_dict:
    final_result = (C, "Text detection failed.")
else:
    # Check the confidence score
    if text_dict.get("baseball") is not None:
        if text_dict.get("baseball").confidence > 0.70:
            final_result = (B, "Number of white umbrellas: " + str(len(text_dict.get("baseball"))))
        else:
            final_result = (D, "Number of white umbrellas: " + str(len(text_dict.get("baseball"))))
    else:
        # Check the number of detected letters
        if len(text_dict.get("basket")) > 0:
            final_result = (B, "Number of white umbrellas: " + str(len(text_dict.get("basket"))))
        else:
            final_result = (D, "Number of white umbrellas: " + str(len(text_dict.get("basket"))))
print(final_result[0])  # Output: 'B' or 'D'
