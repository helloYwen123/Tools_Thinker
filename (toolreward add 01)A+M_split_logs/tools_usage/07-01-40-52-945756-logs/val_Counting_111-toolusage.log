def count_sheep(image_path):
    image = Text_Detector_Tool().execute(image=image_path, languages=['en'], detail=0)

    letter_containers = Letter_Detector_Tool().execute(image=image_path)

    letter_count = {}
    letter_scores = {}
    letter_found_count = 0

    for bbox, letter, score in letter_containers:
        if letter in ['s', 'c']:
            letter_count[letter] = letter_count.get(letter, 0) + 1
            letter_scores[letter] = score * 100
            letter_found_count += 1

    # print(letter_count)
    # print(letter_scores)

    total_score = 0
    for letter, score in letter_scores.items():
        total_score += score
        if letter in ['s', 'c']:
            letter_found_count += 1

    if letter_found_count % 2 == 0:
        total_score /= 2

    final_results = {}
    final_results['sheep_count'] = len(letter_containers)
    final_results['letter_count'] = {
        'found': letter_found_count, 'score_sum': total_score * 100, 'correct_ratio': 100 / ((total_score * 100) / letter_found_count)
    }
    return final_results

image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_111_image_1.jpg'
sheep_count = count_sheep(image_path)
 
