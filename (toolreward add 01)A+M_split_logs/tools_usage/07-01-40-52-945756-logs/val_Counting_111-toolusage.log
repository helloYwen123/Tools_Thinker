def calculate_tigers(sheep_image):
    # Load the image
    detector = Object_Detector_Tool()
    detector.execute(image=sheep_image, save_object=True, saved_image_path="detected_objects")
    
    # Convert the object data to a dictionary
    data = {}
    for i, object_data in enumerate(detected_objects['baseball']):
        for j, bbox in enumerate(object_data['bbox']):
            object_data = detected_objects['baseball'][j]
            if object_data['label'] == 'tigers':
                data[i] = object_data
    
    # If there are tigers, return the count, otherwise return 0
    if len(data) > 0:
        tigers = data.values()
        count = sum([t['bbox'][1][0] - t['bbox'][3][0] for t in tigers]) / 2
        return count
    else:
        return 0

