from letter_detector import Letter_Detector_Tool

# Execute the letter_detector tool with the path of the image
results = Letter_Detector_Tool.execute(image='path/to/YourImageFile.png')

# The detected letters are stored in the "results" variable as a list.
# Each element of the list is a list containing the following elements:
# [bbox, letter, and score]

# Extract the detected letters as requested.
detected_letters = [
    [bbox for letter, _, score in results] for bbox in results["bbox"]
]

# Determine how many detected yellow cars there are
yellow_cars_count = sum(
    1 for detected_letter in detected_letters if detected_letter[2] == "yellow"
)

final_result = "The number of yellow cars is: " + str(yellow_cars_count)
