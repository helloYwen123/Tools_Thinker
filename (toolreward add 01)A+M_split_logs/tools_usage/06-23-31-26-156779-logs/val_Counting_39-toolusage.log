from object_detector import Object_Detector_Tool

final_result = {}

# Set the image file path
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_39_image_1.jpg'

# Use the Object Detection Tool on the image
result = Object_Detector_Tool.execute(image=image_path, save_object=True, languages=['en', 'de'])

# Extract detection results dictionary
detected_objects = result[1]
object_number = result[0]

# Check if "baseball" and "basket" are detected
if "baseball" in detected_objects[0]['bbox'] and "basket" in detected_objects[0]['bbox']:
    # Add the number of detected "baseball" and "basket" to the dictionary
    final_result['baseball'] = object_number['baseball'] + object_number['basket']
else:
    # If there are no "baseball" and "basket", add zero
    final_result['baseball'] = 0
    final_result['basket'] = 0

print(final_result)
