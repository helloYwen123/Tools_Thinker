from object_detector import Object_Detector_Tool

# Assuming the code is in a file named `image_analysis.py`
# and the image file path is 'path/to/image.png'
detector = Object_Detector_Tool()
labels = ['baseball', 'basket']
confidence_threshold = 0.35
save_object = False
saved_image_path = 'detected_objects'

# Execute the tool
detector.execute(image='path/to/image.png', labels=labels, save_object=save_object, saved_image_path=saved_image_path)
result = detector.execute(image='path/to/image.png', languages=['en', 'de'])

# Find the first element in the 'baseball' and 'basket' lists in the result dictionary
found_baseball = next((word for item in result['baseball'] for word in item.values() if word['score'] > conf_threshold), None)
found_basket = next((word for item in result['basket'] for word in item.values() if word['score'] > conf_threshold), None)

if found_baseball:
  found_baseball_text = ' '.join(found_baseball['letter'])
else:
  found_baseball_text = None

if found_basket:
  found_basket_text = ' '.join(found_basket['letter'])
else:
  found_basket_text = None

final_result = found_baseball_text or found_basket_text

final_result
