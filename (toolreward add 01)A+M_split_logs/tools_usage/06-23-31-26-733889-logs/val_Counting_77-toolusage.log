def count_people(image_path):
    # Load the image
    image_obj = Object_Detector_Tool()
    result = image_obj.execute(image_path)
    
    # Extract the number of people wearing suit
    detected_objects = []
    object_number = {}
    for obj in result['detected_objects']:
        if 'baseball' in obj:
            box = obj['box']
            score = obj['score']
            detected_objects.append(
                [box, obj['text'], score]
            )
        elif 'ski' in obj:
            box = obj['box']
            score = obj['score']
            detected_objects.append(
                [box, obj['text'], score]
            )
        else:
            continue
    
    count = 0
    for obj in detected_objects:
        if obj[2] == 'baseball':
            count += 1
        elif obj[2] == 'ski':
            count += 1
    
    final_result = ""
    if count > 0:
        final_result = "People wearing suit: " + str(count) + " in the image"
    else:
        final_result = "No people wearing suit in the image"
    
    return final_result

