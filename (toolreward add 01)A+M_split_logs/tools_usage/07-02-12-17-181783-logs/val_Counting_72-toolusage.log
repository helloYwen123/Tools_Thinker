def analyze_images(images_paths):
    final_result = {"A": 0, "B": 0, "C": 0, "D": 0, "E": 0}

    for image_path in images_paths:
        detection_tool = Text_Detector_Tool()
        results = detection_tool.execute(image=image_path)

        if results and "detected_result" in results[0]:
            for det in results:
                label = det[1].get("text", "Unknown Label")
                if label in ["baseball"] or label in ["basket"] or label in ["plane"] or label in ["bird"] or label in ["helicopter"]:
                    final_result[label] += 1

    return final_result

# Example usage
images_paths = ["/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_72_image_1.jpg", "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg"]
final_result = analyze_images(images_paths)
for label, count in final_result.items():
    print(f"{label}: {count}")

(final_result["baseball"], final_result["basket"], final_result["plane"], final_result["bird"], final_result["helicopter"])
