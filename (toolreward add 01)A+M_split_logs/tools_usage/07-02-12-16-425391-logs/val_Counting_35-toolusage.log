from object_detector import Object_Detector_Tool

# Assuming the path to the image is "path/to/image.png"
# and the labels list is ["baseball", "basket"]
# Save object detection data
detected_objects = Object_Detector_Tool.execute(image="path/to/image.png", labels=["baseball", "basket"], save_object=True)
object_number = {label: 1 for label in ["baseball", "basket"]}  # Placeholder

final_result = min((len(detected_objects[label]) for label in detected_objects), key=len)
print(f"Number of kids sitting on the bench: {detected_objects['baseball'] if detected_objects.get('baseball', 0) else detected_objects['basket']}")
