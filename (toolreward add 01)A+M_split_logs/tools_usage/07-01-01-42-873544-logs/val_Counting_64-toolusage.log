# Execute the Object Detector Tool to detect and count the burners
detected_objects, object_number = Object_Detector_Tool.execute(image=image_file_path,
                                                            labels=["burner"],
                                                            threshold=0.35,
                                                            saved_image_path="detected_objects",
                                                            save_object=True)

# Iterate through the detected objects
for detected_object in detected_objects["baseball"]:
    # Extract the burners from the detected objects
