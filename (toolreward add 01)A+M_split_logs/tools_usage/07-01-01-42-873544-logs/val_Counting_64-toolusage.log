from object_detector import Object_Detector_Tool

# Image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_64_image_1.jpg"

# Create the Object_Detector_Tool instance
detector_tool = Object_Detector_Tool(image_path)

# Detect objects in the image
detected_objects, object_number = detector_tool.execute()

# Check if objects are detected
if len(detected_objects) >= 3:
    # Add detected objects to the list
    detected_objects.append(
        [{"box": (0, 0), "score": object_number[detected_objects[0]["bbox"][0]]}, {"bbox": (detected_objects[0]["bbox"][-2], detected_objects[0]["bbox"][-1]), "score": 0.95}] * 3
    )
else:
    # No detected objects
    detected_objects = []

final_result = object_number[detected_objects[0]["bbox"][0]]

# Check if objects are detected
if final_result >= 3:
    # Add detected objects to the list
    final_result += 1
final_result = object_number[final_result - 1] * 3 + object_number[detected_objects[0]["bbox"][0]]

final_result
