def find_one_way_signs(input_image_path):
    """
    This function searches for all one-way signs in a given image.
    :param input_image_path: The path of the image to search.
    :return: A list of tuples where each tuple contains the coordinates and the value of the sign (1 for right hand traffic, 0 for left hand traffic).
    """
    # Load the input image
    image = Image.open(input_image_path)

    # Detect one-way signs using the Text_Detector_Tool
    results = text_detector.execute(image=image, languages=["en"],
                                    detail=1)  # Details are irrelevant

    # Initialize counters for each type of sign
    right_hand = 0
    left_hand = 0

    # Search for each sign
    for block in results:
        if 'right' in block[1] and 'left' in block[1]:
            right_hand += 1
        elif 'left' in block[1] and 'right' not in block[1]:
            left_hand += 1

    # Return the counts for the right and left hand signs
    return (right_hand, left_hand)

# Initialize the letter_detector tool with the available tool
detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/no_taxa_image.png', labels=['baseball', 'basket', 'one way'], save_object=True, saved_image_path='detected_objects')
detected_objects,
right_hand,
left_hand
