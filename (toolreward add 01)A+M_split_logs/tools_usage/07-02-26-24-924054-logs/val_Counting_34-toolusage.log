from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Create an instance of Object_Detector_Tool
object_detector = Object_Detector_Tool()

# Execute the object_detector with the path to the image 'image_1.jpg'
detected_objects = object_detector.execute(image="path/to/image.jpg", labels=["one way", "no turns", "one way"], save_object=True, saved_image_path="detected_objects")
 
# Get the total number of detected objects
objects_number = len(detected_objects)

# Create an instance of Text_Detector_Tool
text_detector = Text_Detector_Tool()

# Execute the text_detector (but with a lower retry limit to account for possible errors)
try:
    text_results = text_detector.execute(image="path/to/image.jpg", languages=['en', 'zh'], detail=0)
except Exception as e:
    final_result = 'None'  # Assume there's an error
    text_results = []

# Get the text result from the first detected object (the only one detected in the image)
text_result = text_results[0][1]  # Convert detected objects object to text

# Create an instance of Letter_Detector_Tool
letter_detector = Letter_Detector_Tool()

# Execute the letter_detector with the path to the image 'letter_1.jpg'
letter_results = letter_detector.execute(image="path/to/image.jpg")

# Check if the 'detected_objects' and letter_results dictionaries have keys with the same value
if 'detected_objects' in text_results and 'letter_results' in text_results:
    if text_results['detected_objects'] == text_results['letter_results']:
        final_result = "None"
    else:
        final_result = object_detector.total_objects
elif any(key in text_results for key in text_results.keys()):
    final_result = object_detector.total_objects
else:
    final_result = "None"

# Use the final_result to determine the final choice
final_result
