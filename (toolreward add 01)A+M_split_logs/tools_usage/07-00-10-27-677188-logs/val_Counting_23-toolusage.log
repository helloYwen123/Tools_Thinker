from object_detector import Object_Detector_Tool

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_23_image_1.jpg"
labels = ["banana"]
confidence_threshold = 0.3

# Initialize the object detector tool
object_detector_tool = Object_Detector_Tool(
    input_types={"image": image_path},
    labels=labels,
    confidence_threshold=confidence_threshold,
    mode="count"
)

# Detect the objects
objects_count = object_detector_tool.execute(image=image_path)

# Process the objects to count
for obj in objects_count["detected_objects"]:
    if "banana" in obj["label"]:
        # Increment the count for banana
        total_objects += 1

# Calculate the final count for banana
total_objects += 1
