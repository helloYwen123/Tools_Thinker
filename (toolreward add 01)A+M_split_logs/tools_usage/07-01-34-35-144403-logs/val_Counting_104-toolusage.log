def count_text(image_path, languages, detail):
    result = Text_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
    text_blocks = []
    for block in result:
        text = block['text']
        if ' ' not in text:
            text_blocks.append({
                'bbox': block['bbox'],
                'text': text,
                'score': block['score']
            })
    return text_blocks
