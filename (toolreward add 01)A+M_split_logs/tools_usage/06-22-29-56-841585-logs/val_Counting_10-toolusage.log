if(results):
    taller_top = False
    for result in results:
        if 'box' in result:
            bottom_location = result['bbox'][0]
            top_location = result['bbox'][2]
            if top_location - bottom_location > 460:
                taller_top = True
                
    if taller_top:
        final_result = (True, 1, "A")
    else:
        final_result = (False, 1, "C")
else:
    final_result = (False, 0, "C")
