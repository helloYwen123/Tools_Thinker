from object_detector import Object_Detector_Tool

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_86_image_1.jpg"
object_detector_tool = Object_Detector_Tool(image_path, labels=["Mon", "Wed", "Thur", "Fri", "Sat", "Sun"], languages=["en", "de"], threshold=0.35, model_size="tiny")
result = object_detector_tool.execute()

# Process the detected object images
detected_objects = result[0]
object_number = result[1]

# Determine the number of banners
banner_count = len(detected_objects) - 6

# Print the result
final_result = ['Banners'] if banner_count > 0 else ['Banners and More']
print("Number of Banners:", final_result)
