def analyze_glass():
    import_path = 'Tool_Name'
    from Module_Name import Object_Detector_Tool

    # Initialize detector tool
    detector_tool = Object_Detector_Tool()

    # Specify path to image
    detector_tool.image = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_74_image_1.jpg'

    # Detect objects
    detected_objects = detector_tool.execute(labels=["glass", "wine glass"], threshold=0.2, save_object=True, saved_image_path="detected_objects")

    # Calculate number of empty glasses
    if 'glass' in detected_objects:
        glass_count = sum(1 for obj in detected_objects['glass'] if obj['score'] == 2 or obj['score'] == 3)
    else:
        glass_count = 0

    final_result = str(glass_count)
    print('\nThe number of empty glasses is:', final_result)

analyze_glass()
