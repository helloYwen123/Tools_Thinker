from letter_detector import Letter_Detector_Tool

# Read the image path
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_93_image_1.jpg'

# Execute the letter detection using the letter_detector tool
results = Letter_Detector_Tool.execute(image=image_path)

# Get the detected letters with bounding box coordinates, recognized text, and confidence score
detected_letters = results[0]

# Check if there are any detected letters
if detected_letters:
    # Fetch the bounding box coordinates, recognized letters, and confidence score of each detected letter
    letter_bbox = [
        [bbox[0],bbox[1],bbox[0]+bbox[2],bbox[1]+bbox[3]]
        for bbox in detected_letters
    ]
    letters_text = [text for bbox, text in detected_letters]

    # Print the detected letters
    for letter_bbox, letter_text, score in letter_bbox + letters_text:
        print(f"Detected letter: {letter_text}, (x: {letter_bbox[0]}, y: {letter_bbox[1]}, w: {letter_bbox[2]}, h: {letter_bbox[3]}), score: {score}")
else:
    # Print when there are no detected letters
    print("No detected letters.")
