def analyze_image(input_path, labels, threshold, save_object, saved_image_path):
    input_path = input_path
    labels = labels
    threshold = threshold
    save_object = save_object
    saved_image_path = saved_image_path
    
    # Load and preprocess the image
    image_data = cv.imread(input_path)
    
    # Perform text detection
    detected_text = []
    for language in labels:
        result = Text_Detector_Tool.execute(image=image_data, languages=[language,])
        detected_text.extend(result)
    
    # Analyze text content of detected text
    text_analysis = []
    for i, detected_text_i in enumerate(detected_text):
        text_analysis.extend([[detected_text_i[0][:-10], detected_text_i[1], detected_text_i[2]] for detected_text_i in detected_text])
    
    # Count detected objects for each label
    object_number = {}
    for detected_text_j in text_analysis:
        if detected_text_j[1] in object_number:
            object_number[detected_text_j[1]].append(float(detected_text_j[0]))
        else:
            object_number[detected_text_j[1]] = [float(detected_text_j[0])]

    final_result = []
    for label, detections in sorted(object_number.items()):
        total_objects = len(detections)
        score_summary = "Score: {:.2f}".format(np.mean([obj['score'] for obj in detections]))
        print(f"{label}: {total_objects} objects")
        final_result.append(f"**{label}**: {total_objects} objects\nScore summary: {score_summary}")

    # Debugging text detection
    if save_object:
        for detected in detected_text:
            bboxes = [[detected[0][0], detected[0][1], detected[0][2], detected[0][3]]]
            scores = [detected[4]]
            if save_image:
                filename = f"{label}_image_{i}.png"
                cv2.rectangle(image_data, (detected[0][0], detected[0][1]), (detected[0][2], detected[0][3]), (0, 255, 0), 2)
                cv2.putText(image_data, f"Score: {scores[0]:.2f}", (detected[0][0], detected[0][1]), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
                cv2.imwrite(os.path.join(saved_image_path, ''.join([str(char), filename]), filename), image_data)
                if save_object:
                    object_data = [detected[0][0], detected[0][1], detected[0][2], detected[0][3], detected[4]]
                    save_location = os.path.join(saved_image_path, ''.join([str(char), filename]))
                    obj_save = os.path.join(save_location, filename)
                    obj_save = cv2.copyMakeBorder(image_data, 20, 20, 20, 20, cv2.BORDER_CONSTANT, value = 0)
                    cv2.imwrite(obj_save, obj_save)
        return final_result
    else:
        return text_analysis

