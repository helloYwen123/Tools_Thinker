def count_people(image_path):
    # import necessary libraries
    importobject = Object_Detector_Tool()
    importresult = importobject.execute(image=image_path, labels=["skier"], save_object=True, saved_image_path="counted_objects")
    object_type = "skier"
    # calculate number of people
    count = sum(object["label"] == object_type for object in importresult["detected_objects"])
    final_result = int(count)
    return final_result

count_people("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_30_image_1.jpg")
