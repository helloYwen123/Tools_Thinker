def get_letter_count(image_path):
    # Use the Letter_Detector_Tool to detect letters in the image
    results = Letter_Detector_Tool.execute(image_path)

    # Initialize a counter for the number of detected letter boxes
    letter_count = 0

    # Iterate through the detected letter boxes and count them
    for box, letter, score in results:
        letter_count += 1

    return letter_count

