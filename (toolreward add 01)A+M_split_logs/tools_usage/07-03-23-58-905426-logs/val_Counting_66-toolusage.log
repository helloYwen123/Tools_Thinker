def calculate_gloves():
    # Path of the image file
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_66_image_1.jpg'
    
    # Image file and language codes for the OCR model
    image = image_path
    languages = ['en', 'zh']
    
    # Level of detail
    detail = 1
    
    # Run the OCR tool
    result = Text_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
    
    # Filter and return letters detected in the image. You can modify the 'results' list for specific analysis.
    detected_letters = []
    for _, _, letter, score in result:
        detected_letters.append({'bbox': letter, 'text': letter, 'score': score})
    
    return detected_letters

final_result = calculate_gloves()
category = 'gloves'
gloves_count = len(final_result) - (3 if 'glove' in category else 0)
print(f'{category}: {gloves_count}')
