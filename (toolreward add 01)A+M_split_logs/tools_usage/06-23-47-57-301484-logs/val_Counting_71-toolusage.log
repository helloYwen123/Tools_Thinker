from letter_detector import Letter_Detector_Tool

with open('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_71_image_1.jpg', 'rb') as image_file:
    image_data = image_file.read()

result = Letter_Detector_Tool.execute(image=image_data)

final_result = []
for (bounding_box, letter, score) in result:
    if letter == 'A':
        final_result.append(([bounding_box, letter, score]))

print(final_result)
