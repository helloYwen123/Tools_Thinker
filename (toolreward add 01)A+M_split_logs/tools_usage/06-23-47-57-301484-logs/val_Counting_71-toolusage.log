from object_detector import Object_Detector_Tool

final_result = "D"

obj = Object_Detector_Tool()
obj.execute(image='val_Counting_71_image_1.jpg', labels=["yellow star"], threshold=0.35)
obj.execute(image='val_Counting_78_image_1.jpg', labels=["yellow star"])

obj.execute(image='val_Counting_141_image_1.jpg', labels=["yellow star"], threshold=0.35)
obj.execute(image='val_Counting_159_image_1.jpg', labels=["yellow star"], threshold=0.35)

if len(obj.detected_objects) > 0 and obj.object_number['yellow star'] > 0:
    for detected_object in obj.detected_objects:
        if obj.object_number['yellow star'] == 0:
            final_result = 'B'
        else:
            if detected_object.box[0][0] >= 0:
                if detected_object.box[3][1] >= 5:
                    final_result = 'C'
                elif detected_object.box[3][1] >= 7:
                    final_result = 'D'
elif len(obj.detected_objects) == 0:
    if obj.object_number['yellow star'] == 0:
        final_result = 'A'
else:
    final_result = 'E'

print(final_result)
