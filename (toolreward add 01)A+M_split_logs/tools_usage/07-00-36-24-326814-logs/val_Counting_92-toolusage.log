from object_detector import Object_Detector_Tool

# Path to the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_92_image_1.jpg'

# Detection options
labels = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
save_object = False

# Detect objects
results = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, model_size=model_size, threshold=threshold)
detected_objects = {}
object_numbers = {}

# Convert each result into a list
for obj in results[1]:
    label = obj[1]
    objects = [obj[0]]
    if save_object:
        objects.append(obj[0] + "-crop")
    labeled_objects = {"label": label, "objects": objects}
    if label == "baseball":
        objects[-1] = [[120, 150, 200, 200]]
        if label not in objects[-1]:
            objects.append([[120, 150, 200, 200]])
        objects[-1][0].append("DETICTABLEBASEBALL")
    elif label == "basket":
        objects[-1] = [[120, 150, 200, 200]]
        if label not in objects[-1]:
            objects.append([[120, 150, 200, 200]])
        objects[-1][0].append("BASKETBALLDETECT")
    if saved_object:
        labeled_objects["bbox"] = [[det[0, 0], det[1, 0], det[0, 1], det[1, 1]] for det in objects[-1]]
    detected_objects[label] = labeled_objects
    object_numbers[label] = len(labeled_objects)

# Calculate counts
baseball_count = sum(detected_objects["baseball"][list(detected_objects["baseball"].keys())])
basket_count = sum(detected_objects["basket"][list(detected_objects["basket"].keys())])
final_result = str(baseball_count) + str(basket_count)

print(final_result)
