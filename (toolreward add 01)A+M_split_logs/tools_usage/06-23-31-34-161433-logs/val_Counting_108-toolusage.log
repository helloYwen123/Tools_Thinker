from text_detector import Text_Detector_Tool

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_108_image_1.jpg"
result = Text_Detector_Tool.execute(image=image_path, languages=['eng', 'de'])

# Extract the detected text and confidence scores
detected_text_blocks = [block for block in result if "Detected text" in str(block[0])]

# Filter out the bounding boxes that correspond to a correct result
correct_results = [(bbox, token, score) for token, _, score in detected_text_blocks if bbox[1] > 100 and score > 0.8]

# Extract the recognition text and its score
correct_recognition_text = ""
confidence_scores = []
for bbox, token, score in correct_results:
    if token != "":
        correct_recognition_text += " " + token
        confidence_scores.append(score / 100)
        
# Determine the number of words written in white chalk on the chalkboard
chalk_word_blocks = []
for token in correct_recognition_text.strip():
    for idx, word_block in enumerate(result):
        if word_block[0] == token:
            chalk_word_blocks.append(word_block)
            
number_of_words_on_powder = len(chalk_word_blocks)
final_result = None
if final_result is None:
    final_result = "Answer"
if final_result is None:
    final_result = "Choice"
