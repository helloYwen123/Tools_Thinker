from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool
import os

def count_words_on_chalkboard(image_path: str) -> int:
    """
    This function returns the number of words written in white chalk on the chalkboard.
    """
    # Load the image
    image = Image.open(image_path)

    # Detect the words on the chalkboard
    detected_words = Text_Detector_Tool.execute(image=image, languages=['English'])
    
    # Count the words
    word_count = len(detected_words)
    
    return word_count

