from object_detector import Object_Detector_Tool

# Load model, weights, and configuration
object_detector_tool = Object_Detector_Tool()

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_42_image_1.jpg"
image_info = object_detector_tool.execute(image=image_path)

# Specify language codes as "en" for English, "de" for German
languages = ["en", "de"]

# Detect text in the image
result = object_detector_tool.execute(image=image_path, languages=languages)

# Check the result and get the number of detected objects
text_detected_results = result[0]
if len(text_detected_results) > 0:
    detected_objects = [box_dict["bbox"] for box_dict in text_detected_results]
    total_count = len(detected_objects)
else:
    detected_objects = []
    total_count = len(detected_objects)

# Extract the number of flower pots
flower_pots_count = len(detected_objects)
final_result = str(flower_pots_count)
