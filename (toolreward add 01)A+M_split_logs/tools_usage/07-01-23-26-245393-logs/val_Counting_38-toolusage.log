from tools import Object_Detector_Tool, Text_Detector_Tool, Letter_Detector_Tool 

final_result = ""

# Load model
obj_detector = Object_Detector_Tool()
text_detector = Text_Detector_Tool()
letter_detector = Letter_Detector_Tool()

# Load image
