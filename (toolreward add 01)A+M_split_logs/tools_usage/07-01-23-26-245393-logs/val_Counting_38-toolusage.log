obj_detector.execute(image=image_path, labels=["dog"])
text_response = text_detector.execute(image=image_path, languages=["en", "de"])
letter_response = letter_detector.execute(image=image_path)

# Process the objects
obj_list = obj_detector.output["detected_objects"]
for obj in obj_list:
    if obj["box"][2] - obj["box"][0] > 10 and obj["box"][3] - obj["box"][1] > 10:
        # Process the letter
        letter_list = letter_detector.output["detected_letters"]
        for letter in letter_list:
            if letter["box"][2] - letter["box"][0] > 5 and letter["box"][3] - letter["box"][1] > 5:
                text = letter["text"]
                conf = letter["score"]
                final_result += f"{text}, {conf}"

# Process the texts
text_list = text_detector.output["detected_texts"]
for text in text_list:
    text = text["text"]
    conf = text["score"]
    final_result += f"{text}, {conf}"

# Process the letters
