def count_white_pillows(image_path):
    from object_detector import Object_Detector_Tool
    from text_detector import Text_Detector_Tool

    with Object_Detector_Tool(image_path) as detector:
        labels = ["baseball", "basket"]
        languages = ["en", "de"]
        detail = 1

    detected_objects = detector.execute(labels=labels, languages=languages, detail=detail)
    white_pillow_count = 0

    for det_obj in detected_objects:
        if det_obj['box'] == (detectable_objects[0]['box']) and det_obj['score'] > 0.35:
            white_pillow_count = white_pillow_count + 1

    print(f"Detected {white_pillow_count} white pillows.")
    return white_pillow_count

