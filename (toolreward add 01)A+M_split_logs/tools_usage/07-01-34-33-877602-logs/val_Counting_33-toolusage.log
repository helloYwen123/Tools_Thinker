def get_white_pillows(image_path):
    import_object_detector = Object_Detector_Tool()
    object_info = import_object_detector.execute(image_path, ["pillow"], save_object=True, saved_image_path="detected_objects")
    pillow_count = object_info.get('pillow', {})
    
    for label in ["pillow", "quilt"]:
        if label in pillow_count:
            total_pillows = pillow_count.get(label)
            if total_pillows > 0:
                return total_pillows
    return 0

final_result = get_white_pillows("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_33_image_1.jpg")
print("Number of white pillows:", final_result)
