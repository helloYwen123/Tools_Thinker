def count_chicken_nuggets():
    # Assuming Image objects exist
    def get_bbox_and_label(image_path, languages=['en', 'en']):
        detector = Text_Detector_Tool()
        result = detector.execute(image_path, languages=languages)
        # Example output assuming 'chicken nugget' was found
        if 'chicken nugget' in [t['recognized_text'] for t in result]:
            return [t['bbox'], 'chicken nugget', 0.95, "chicken nugget"]
        return []
    
    def count_detected_nuggets(image_path):
        result = get_bbox_and_label(image_path)
        detected_nuggets = []
        for bbox, label in result:
            if label == 'chicken nugget':
                detected_nuggets.append((bbox[0][0], bbox[0][1], bbox[0][2], bbox[0][3], 'chicken nugget'))
        count = sum([bbox[2] for bbox in detected_nuggets])
        print(f"Detected {count} pieces of chicken nuggets.")
        return count
        
    count_detected_nuggets('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_55_image_1.jpg')
