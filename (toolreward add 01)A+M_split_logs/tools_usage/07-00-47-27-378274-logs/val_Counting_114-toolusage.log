def count_people(image_path, left, top, right, bottom):
    import object_detector
    result = object_detector.execute(image=image_path, save_object=False, labels=None, saved_image_path='')
    detected_objects = result['detected_objects']
    people_count = 0
    for detected_object in detected_objects:
        if detected_object['box'][0] >= left and detected_object['box'][2] <= right and detected_object['bbox'][1] >= top and detected_object['bbox'][3] <= bottom:
            people_count += 1
    return people_count

final_result = count_people('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_114_image_1.jpg', 50, 50, 500, 500)
print(f"The person(s) standing near the right of the giraffe is/are {final_result}.")
