import os
import numpy as np
from object_detector import Object_Detector_Tool, text_detector, letter_detector

# Get the image path from the question
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_72_image_1.jpg'

# Initialize the Object_Detector_Tool
o_df = Object_Detector_Tool(input_types={"image": "path/to/image.jpg"}, labels=["baseball", "basket"], threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects")

# Detect the objects in the image
detected_objects = o_df.execute(image=image_path, labels=["baseball", "basket"])

# Get the object count dictionary
object_count = {label: len(detected_objects[label]) for label in detected_objects}

# Print the object count dictionary
print("Object Count:")
print(object_count)

# Check if there are any purple planes in the annotated objects
purple_count = object_count['baseball']

final_result = 'A' if purple_count >= 1 else 'C'
print(final_result)
