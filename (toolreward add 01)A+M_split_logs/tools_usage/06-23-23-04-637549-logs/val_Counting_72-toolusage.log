from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Load detection tool and create an object detector for the image
tool_obj = Object_Detector_Tool()
results = tool_obj.execute(
    image="/path/to/image.jpg",
    labels=["baseball", "basket"],
    save_object=True,
    saved_image_path="detected_objects"
)

# Get the total number of detected objects
num_objects = results[0][0].get("number")

# Initialize counters
baseball_count = 0
basket_count = 0

for detection_result in results:
    # Check if the detected object is a baseball
    if detection_result.get("label") == "baseball":
        # Increment the count if found
        baseball_count += 1
    # Check if the detected object is a basketball
    elif detection_result.get("label") == "basket":
        # Increment the count if found
        basket_count += 1

print(f"The total count of detected baseballs is: {baseball_count}")
print(f"The total count of detected baskets is: {basket_count}")
final_result = baseball_count > basket_count
print(final_result)
