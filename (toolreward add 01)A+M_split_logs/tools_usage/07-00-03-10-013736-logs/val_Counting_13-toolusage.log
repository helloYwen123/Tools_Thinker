from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_13_image_1.jpg"

# Detect objects using the ImageNet model and set confidence threshold
result = Object_Detector_Tool.execute(image=image_path, languages=['en', 'de'], threshold=0.5)

# Check if there are any detections
if len(result) > 0:
  # Print detected objects and details
  for i, obj in enumerate(result):
    det_box, obj_name, score = obj
    print(f"Detected {obj_name} with box ({int(det_box[0][0]), int(det_box[0][1]), int(det_box[0][2]), int(det_box[0][3])})")
else:
  print("No text detected")
