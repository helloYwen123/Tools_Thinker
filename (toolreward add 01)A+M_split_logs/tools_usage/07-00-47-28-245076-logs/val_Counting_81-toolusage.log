from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Load the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_81_image_1.jpg'
detector = Object_Detector_Tool()
results = detector.execute(image_path=image_path)

# Process the results
detected_objects = []
object_number = {}

for result in results:
    if result['label'] in ['Mansons', 'red', 'Red']:
        # Process the object
        x1, y1, x2, y2 = result['box']
        detected_objects.append((x1, y1, x2, y2))
        object_number[result['label']] = len(detected_objects)

# Process the text
result_text = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en'])
text_blocks = []
for text_block in result_text:
    if text_block[1] in ['baseball', 'basket', 'soccer ball']:
        # Process the text
        start_x, start_y, end_x, end_y = text_block[2]
        text_blocks.append((start_x, start_y, end_x, end_y))

# Process the letters
results = Letter_Detector_Tool.execute(image=image_path)
if results:
    detected_letters = results[2]
    text_blocks.extend(results[1])

# Output the detected objects and text
print(f"Detected objects with object_number: {object_number}")
print(f"Detected letters {text_blocks}")
