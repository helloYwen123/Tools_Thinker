def count_sinking_boats():
    # Import necessary tools
    import_object_detector = Object_Detector_Tool(input_types={'image': '../val/images/val_Counting_96_image_1.jpg', 'labels': ['sinking', 'boat'], 'threshold': 0.5, 'model_size': 'tiny', 'save_object': True, 'saved_image_path': 'sinkingboaters_images'})
    object_number = import_object_detector.execute()

    return object_number['sinking', 'boat'] if object_number['sinking', 'boat'] else '0'

final_result = count_sinking_boats()
print(final_result) # Expected output: 0
