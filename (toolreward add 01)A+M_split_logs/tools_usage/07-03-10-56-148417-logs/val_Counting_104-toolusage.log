    for letter in image:
        if letter['text'] == "face":
            letter_result.append([letter['bbox'], letter['text'], letter['score']])

    faces = [x for x in letter_result if x[2] == 'face']

    final_result = []
    for result in faces:
        final_result.append({'score': result[2], 'words': result[1].replace(' ', '').title() if result[1] != '' and len(result[1]) > 0 else ''})
    return final_result

