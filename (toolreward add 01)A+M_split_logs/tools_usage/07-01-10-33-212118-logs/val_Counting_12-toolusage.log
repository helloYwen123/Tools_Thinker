from object_detector import Object_Detector_Tool

# Execute the object detector tool
detected_objects, object_number = Object_Detector_Tool.execute(image="path/to_pizza_image.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Extract the detected letters from detected_pizza object
results = []
for label in detected_objects.keys():
    for detection in detected_objects[label]:
        results.append([detection['box'], detection['text'], detection['score']])

# Filter and select the letter 'A'
final_result = None
for result in results:
    if result[2] == 'A':
        final_result = result
        break

final_result
