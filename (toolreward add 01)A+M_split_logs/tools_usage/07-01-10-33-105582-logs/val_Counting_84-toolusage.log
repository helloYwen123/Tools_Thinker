def count_people_with_white_hats():
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_84_image_1.jpg"
    object_detector = Object_Detector_Tool(image_path, labels=["white hat"], save_object=True)

    detected_objects = object_detector.execute()
    object_numbers = {label: len([obj for obj in detected_objects if obj["label"] == "white hat"]) for label, obj in detected_objects}

    return object_numbers

# Sample usage
final_result = count_people_with_white_hats()
print(f"Number of people wearing a white hat: {final_result['white hat']}")
