from typing import List, Dict, Tuple

def detect_objects(image_path: str, labels: List[str], save_object:bool=True, saved_image_path: str=None) -> Tuple[List[Dict], int]:
    # Load the image using OpenCV
    img = cv2.imread(image_path)

    # Detect objects using the text detector tool
    result = Text_Detector_Tool.execute(image=f"{' ' * 100}{' '.join(labels)}", languages=["en", "de"])

    # Convert the results to a list of dictionaries with bounding box coords, detected texts and scores
    result_list = []
    for i, (bbox, text, score) in enumerate(result):
        box = [bbox[0], bbox[1], bbox[2], bbox[3]]
        result_list.append({"bbox": box, "text": text, "score": score})

    if save_object:
        save_path = saved_image_path if saved_image_path else "detected_objects"
        for obj in result_list:
            img = cropped_bbox(img, obj["bbox"])
            cv2.imwrite(save_path, img)

    return result_list, len(result_list)

final_result = detect_objects("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_72_image_1.jpg", ["baseball"], 3, "detected_objects")
