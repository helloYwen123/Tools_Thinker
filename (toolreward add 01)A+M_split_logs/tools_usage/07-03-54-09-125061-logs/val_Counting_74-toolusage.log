from object_detector import Object_Detector_Tool

# 读取图片
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_74_image_1.jpg"

# 使用Object_Detector_Tool执行检测
final_result = Object_Detector_Tool.execute(image_path, ["baseball"], save_object=True, saved_image_path="detected_objects")

object_number = final_result["object_number"]
detected_objects = final_result["detected_objects"]

if not detected_objects:
    print("No detected objects found.")
else:
    print("Detected objects:")
    for obj in detected_objects['baseball']:
        print(f"Name: {obj['name']}, Box: {obj['box']}")
        print(f"Score: {obj['score']}")

if "basket" in detected_objects:
    print("Basket detected:")
    for obj in detected_objects['basket']:
        print(f"Name: {obj['name']}, Box: {obj['box']}")

final_result_str = ""
for key, value in final_result.items():
    final_result_str += f"{key}: {value}:\n"
print(final_result_str)

if "basket" in final_result_str:
    print("Basket detected.")
else:
    print("Basket not detected.")
============================== END ==============================
