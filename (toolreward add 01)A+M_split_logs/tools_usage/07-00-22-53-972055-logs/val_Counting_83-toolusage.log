from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_83_image_1.jpg"

# Detection options
labels = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Run detection
object_results = Object_Detector_Tool.execute(image_path="path/to/image.jpg", labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)
object_number = {"baseball": 1, "basket": 2}

# Run text detection
text_results = Text_Detector_Tool.execute(image_path="path/to/image.jpg", languages=["en", "de"])
detected_text = text_results

# Run letter detection
letter_results = Letter_Detector_Tool.execute(image_path="path/to/image.jpg")

# Process detected objects
final_result = []
for label, detected_objects in object_results.items():
    if label in letter_results:
        letter_bbox = letter_results[label]
        letter_score = letter_bbox[3][2] * 100  # Convert score to percentage
        final_result.append({"bbox": letter_bbox, "label": label, "score": letter_score})

# Process detected text
if detected_text:
    detected_text = [det for det in detected_text for det_bbox in det[1] for det_text in det_bbox[3] for det_score in det_bbox[2]]
    detected_text = [[det_bbox, det_text] for det_bbox in detected_text for det_text in det_bbox[3] for det_score in det_bbox[2] / 100]

# Process detected letters
for letter_bbox, letter_score in letter_bbox:
    detected_letter = [det for det in letter_results for det_bbox in det[1] for det_score in det_bbox[2] / 100]
    detected_letter.append([letter_bbox, letter_score])
    final_result.append(detected_letter)

# Print final result
print(final_result)
