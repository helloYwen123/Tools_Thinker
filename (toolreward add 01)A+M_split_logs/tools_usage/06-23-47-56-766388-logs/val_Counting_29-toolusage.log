def detect_labels(image_path, language_codes, detail=0):
     import tool_module.object_detector as object_detector
     import tool_module.text_detector as text_detector
     import tool_module.lletter_detector as letter_detector

     results = []
     language_options = {'ch_sim': 'Simplified Chinese', 'de': 'German', 'en': 'English', 'ja': 'Japanese'}

     for language_code in language_codes:
         result = text_detector.execute(image=image_path, languages=[language_code], detail=detail)
         results.extend(result['result'])

     return results
