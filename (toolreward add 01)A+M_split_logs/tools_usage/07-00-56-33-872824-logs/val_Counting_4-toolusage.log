def get_people_count(image_path, obj_labels):
    with Object_Detector_Tool(image_path, labels=obj_labels, save_object=True, saved_image_path="detected_objects") as tool:
        detected_objects = tool.execute()
        object_number = len(detected_objects)
        return object_number

