def count_fingers(image_path):
    # Import tools
    from object_detector import Object_Detector_Tool
    from text_detector import Text_Detector_Tool
    from letter_detector import Letter_Detector_Tool

    # Load the image
    image = Image.open(image_path)

    # Detect objects
    object_labels, object_number = Object_Detector_Tool.execute(image=image, labels=["hand"], save_object=True, saved_image_path="detected_objects")

    # Get the position of the hand
    detected_objects = object_labels["hand"]

    # Find the hands
    hand_bboxes = [bbox for row in detected_objects for box in row["bbox"]]

    # Get the digits
    letter_results = Letter_Detector_Tool.execute(image=image)

    # Count the fingers
    finger_bboxes = [bbox for row in letter_results for box in row["bbox"] if box[2] == "g"]

    # Count the fingers
    finger_count = len(finger_bboxes)

    final_result = "finger_count"
    if finger_count == 4:
        final_result = "(A) 4"
    elif finger_count == 2:
        final_result = "(B) 2"
    elif finger_count == 3:
        final_result = "(C) 3"
    elif finger_count == 2 or finger_count == 3:
        final_result = "(D) 2 or 3"
    else:
        final_result = "(E) Other"

    return final_result

# Provided image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_18_image_1.jpg"

# Count and print the fingers count
print(count_fingers(image_path))
