from text_detector import Text_Detector_Tool

# Load image and execute function
result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en', 'de'])

# Iterate through the result and process
detected_results = []
for r in result:
    text = r[3]
    if text == 'baseball':
        detected_results.append([r[0][0][0], r[0][0][1] + 10, r[0][0][2] + 10, r[0][0][3] + 10, 'baseball', 0.95])
    elif text == 'basket':
        detected_results.append([r[0][0][0], r[0][0][1] + 10, r[0][0][2] + 10, r[0][0][3] + 10, 'basket', 0.85])

# Save text results
Text_Detector_Tool.save_objects(detected_results)
