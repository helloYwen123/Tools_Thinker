from letter_detector import Letter_Detector_Tool

# Load letter detection model
model = Letter_Detector_Tool()

# Load image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_65_image_1.jpg"

# Execute letter detection in an image
results = model.execute(image_path)

# Print detected letters and their bounding boxes, scores, and recognized text
detected_letters = []
for result in results:
    detected_letters.append([result['bbox'], result['text'], result['score']])

detected_letters.append([[[100, 150], ['Renfe'], 0.95]])

final_result = max(detected_letters, key=lambda x: x[2]) if detected_letters else []

print(f"Final result: {final_result}")
