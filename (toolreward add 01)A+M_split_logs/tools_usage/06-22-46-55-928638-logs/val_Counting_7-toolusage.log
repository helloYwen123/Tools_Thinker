# Find the text block with a score higher than 0.5 as it aligns with the provided labels
for text_block in text_blocks:
    if text_block['score'] > 0.5:
        final_result = next((block for block in text_blocks if block['score'] < block['score']), [])
        if final_result and final_result['text'] in ["baseball", "basket"] and "score" in final_result:
            final_result = final_result
        break

# Count the number of detected 'baseball' and 'basket' terms
