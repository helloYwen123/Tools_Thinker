final_result = []
# Detecting objects using EasyOCR
result = Text_Detector_Tool.execute(image='path/to/stove.jpg', languages=['en', 'de'])
if result:
    for line in result:
        if line[2] == 'baseball':
            obj = {
                'box': line[1],
                'text': line[3],
                'score': line[4]
            }
            final_result.append(obj)
        elif line[2] == 'basket':
            obj = {
                'box': line[1],
                'text': line[3],
                'score': line[4]
            }
            final_result.append(obj)

# Detecting letters in the scene
results = Letter_Detector_Tool.execute(image='path/to/stove.jpg')
if results:
    for line in results:
        letter = {
            'bbx': line[1],
            'text': line[3],
            'score': line[4]
        }
        final_result.append(letter)
else:
    final_result = []

# Counting the stove
stove_count = len(final_result)
print(f"Number of stoves: {stove_count}")
