import object_detector

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_45_image_1.jpg"
input_dimensions = "384,288"

# Detect the number of doors
detect_object = object_detector.execute(image=image_path, labels=["door", "door"])


if detect_object:
    door_count = len([bbox for bbox in detect_object[0]['bbox'] if "door" in bbox[0]])

    if door_count < 2:
        final_result += "<(C)"
else:
    final_result += "<(A)"

# Detect the number of motors near the bus
motor_counts = []
for motor_track in detect_object[0]['detected_motors']:
    for motor_box in motor_track:
        # Calculate the number of motors
        motor_num = len([motor for motor in motor_box['motor_labels'] if 'motor' in motor])
        motor_counts.append(motor_num)

    for motor_box in motor_track:
        if "motor" in motor_box[0][0]['motor_labels'][0]['label']:
            motor_counts.append(1)

if max(motor_counts) > 0:
    final_result += "<(D)"
else:
    final_result += "<(A)"

# Add the label for the bus for the count
detect_object[0]['label'] += ' Bus'
detect_object[0]['label'] += f' Motor-{motor_counts[-1]}s'
detect_object[0]['label'] += ' Arriva'

final_result += str(detect_object[0]['count'])
