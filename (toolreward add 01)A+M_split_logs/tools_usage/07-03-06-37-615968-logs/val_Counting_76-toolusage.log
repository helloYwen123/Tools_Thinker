def main():
    # Initialize object detector tool
    object_detector = Object_Detector_Tool()

    # Execute object detection
    detected_objects = object_detector.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_76_image_1.jpg", labels=["skiing"], save_object=True, saved_image_path="detected_objects")

