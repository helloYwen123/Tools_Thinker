from object_detector import Object_Detector_Tool

final_result = "0"

def count_people_on_slope(image_path):
    # Load the image
    detector = Object_Detector_Tool()
    image = detector.execute(image=image_path)

    # Detect people
    people = [d['bbox'] for d in image if d.get('bbox', None)]

    # If there are any people detected
    if people:
        people_number = len(people)
    else:
        people_number = 0

    return people_number

final_result = count_people_on_slope("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_76_image_1.jpg")

print(final_result)
