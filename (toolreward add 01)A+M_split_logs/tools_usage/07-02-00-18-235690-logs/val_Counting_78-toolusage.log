from letter_detector import Letter_Detector_Tool

def count_people_on_wall(image_path):
    tool_instance = Letter_Detector_Tool(image_path)
    results = tool_instance.execute()
    if len(results) > 0:
        first_result = results[0]
        wall_area = int(first_result[0][2]) + int(first_result[0][3])
        people_count = int(first_result[1][1])
        return f"{people_count} people are climbing on the wall in the image."
    else:
        return "0 people are climbing on the wall in the image."

final_result = count_people_on_wall("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_78_image_1.jpg")
print(final_result)
