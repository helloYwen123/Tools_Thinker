final_result = None

try:
    result = Object_Detector_Tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_1_image_1.jpg", labels=["Kantina"], save_object=True, saved_image_path="detected_objects")
    detected_objects = result["detected_objects"]
    object_number = result["object_number"]
    
    if 'baseball' in detected_objects:
        baseball_detection = [det for det in detected_objects if det["label"] == "baseball"]
        baseball_score = baseball_detection[-1]["score"]
    if 'basket' in detected_objects:
        basketball_detection = [det for det in detected_objects if det["label"] == "basket"]
        basketball_score = basketball_detection[-1]["score"]
    
    if baseball_score >= baseball_threshold and basketball_score >= basketball_threshold:
        final_result = 2
    elif baseball_score >= baseball_threshold and basketball_score < basketball_threshold:
        final_result = 1
    elif baseball_score < baseball_threshold and basketball_score >= basketball_threshold:
        final_result = 3
    elif baseball_score < baseball_threshold and basketball_score < basketball_threshold:
        final_result = 0

except:
    final_result = None

final_result
