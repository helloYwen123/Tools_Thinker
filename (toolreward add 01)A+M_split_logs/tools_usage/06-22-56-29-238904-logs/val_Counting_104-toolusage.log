from object_detector import Object_Detector_Tool

# Set up the object detector tool
detector = Object_Detection_Tool(detector_module, detector_class)

# Execute the tool and obtain the face detection results
result = detector.execute(image_path, labels, thresholds, model_size, save_object)
face_results = result['face_detection']
face_results_list = []
confidence_scores = []
for row in face_results:
    confidence_score = row[2]
    if confidence_score > 0.5:
        for box_index in range(4):
            x1, y1, x2, y2 = row[box_index]
            face_results_list.append([[x1, y1, x2, y2, 'Face']])  # append bounding box
            confidence_scores.append(confidence_score)

detected_signs = []
for sign in face_results_list:
    sign_count = len(sign)
    if sign_count == 1:  # Check if there is a face on the sign
        detected_signs.append(sign[0])  # Append only the face info
detected_signs_count = 0
for sign_info in detected_signs:
    if sign_info[3] == 'Face':  # Filter out boxes with faces
        detected_signs_count += 1

final_result = 'A'
if detected_signs_count == 4:  # Verify that there are at least 4 faces on the signs
    final_result = 'B'

print(final_result)
============================== END ==============================

