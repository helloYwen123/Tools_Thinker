def detect_objects(image_path):
    try:
        detector = Text_Detector_Tool(input_type=image_path)
        detected_results = detector.execute()
        return detected_results
    except Exception as e:
        return []

def count_objects(image_path, languages):
    try:
        detector = Text_Detector_Tool(input_type=image_path, languages=languages)
        detected_results = detector.execute()
        return detected_results
    except Exception as e:
        return []

def letter_detector(image_path):
    try:
        detector = Letter_Detector_Tool(input_type=image_path)
        return detector.execute()
    except Exception as e:
        return []

# Image path
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_37_image_1.jpg'

