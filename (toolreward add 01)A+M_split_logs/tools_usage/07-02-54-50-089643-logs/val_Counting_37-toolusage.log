from text_detector import Text_Detector_Tool

# Image path
img_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_37_image_1.jpg"

# Text detection parameters
languages = ["en", "de"]
detail = 1

# Execute text detection
if Text_Detector_Tool.execute(image=img_path, languages=languages, detail=detail):
  results = Text_Detector_Tool.execute(image=img_path, languages=languages, detail=detail)

  # Filter and extract relevant text information
  final_result = None
  if results:
    for result in results:
      detected_text = result[-1]
      final_result = detected_text if final_result is None or detected_text > final_result else final_result

  final_result
