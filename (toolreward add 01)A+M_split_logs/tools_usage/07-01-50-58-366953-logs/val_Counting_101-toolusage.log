from object_detector import Object_Detector_Tool

# Path to the image file
file_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_101_image_1.jpg'

# Object labels to detect
labels = ['building', 'clock'] 

# Confidence threshold for detection
threshold = 0.35

# Size of the model to use (tiny or base)
model_size = 'tiny'

# Whether to save the detected objects as images
save_object = True

# Directory to save the detected object images
saved_image_path = 'detected_objects'

# Execute object detection and label count
detected_objects, object_number = Object_Detector_Tool.execute(
    image=file_path,
    labels=labels,
    save_object=save_object,
    threshold=threshold,
    model_size=model_size,
    saved_image_path=saved_image_path,
    labels=object_number,
    debug=True
)

# Print result
final_result = detected_objects
print("Detected objects:", final_result)
