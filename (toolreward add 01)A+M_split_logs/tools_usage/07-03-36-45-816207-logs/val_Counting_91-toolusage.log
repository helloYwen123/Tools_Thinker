from letter_detector import Letter_Detector_Tool

# Path to the image file
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_91_image_1.jpg'

#Execute the tool
results = Letter_Detector_Tool.execute(image=image_path)

# Get the detections list for each detected letter in the image
results = results[0][0][1:]  # Skip the first entry, which is the letter itself

# Count the number of detections for each detected letter
letter_counts = {result[2] if result[2] else result[1] for result in results}

final_result = max(letter_counts, key=letter_counts.get)

final_result
============================== END ==============================
