def count_players_in_red_shirt(image_paths):
    num_red_shirt_players = 0
    for path in image_paths:
        image = Image.open(path)
        players = [player for player in image.split() if player.find("Red") > -1]
        if players:  # Check if any players are wearing red shirts
            num_red_shirt_players += len(players)
    return num_red_shirt_players

# Image paths
