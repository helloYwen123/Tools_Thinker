from object_detector_tool import Object_Detector_Tool

img_path = "/home/stud/www/BD_Archive/Counting/BD_Teddy_Orkay/Friday_9_Calvin_F.jpg"

def detect_objects(img_path, languages=['en']):
    results = []
    try:
        with open(img_path, 'rb') as f:
            detector = Letter_Detector_Tool()
            letter_ids = []
            letters = []
            bbx = []
            words = []
            for line in f:
                detection = detector.process(line)
                letter_ids.append(detection[0])
                letters.append(detection[1])
                bbx.append(detection[2])
                words.append(detection[3])
            results = [[
