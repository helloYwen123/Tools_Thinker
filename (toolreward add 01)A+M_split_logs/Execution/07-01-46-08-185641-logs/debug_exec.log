def detect_objects(img_path, use_objects, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    object_detector = Object_Detector_Tool()
    detected_objects = object_detector.execute(image=img_path, labels=use_objects, save_object=save_object, saved_image_path=saved_image_path)
    return detected_objects

def detect_text(img_path, languages=['en', 'de'], detail=0):
    text_detector = Text_Detector_Tool()
    result = text_detector.execute(image=img_path, languages=languages, detail=detail)
    return result

def letter_detector(img_path):    
    letter_detector = Letter_Detector_Tool()
    results = letter_detector.execute(image=img_path)
