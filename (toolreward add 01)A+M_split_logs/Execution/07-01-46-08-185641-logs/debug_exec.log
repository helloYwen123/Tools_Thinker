def analyze_counting_image(path):
    from object_detector import Object_Detector_Tool
    from text_detector import Text_Detector_Tool
    from letter_detector import Letter_Detector_Tool

    image_path = path[:-4] + '_counting.jpg'  # Assuming the file name has the .jpg extension for the calculation

    detector = Object_Detector_Tool(image=image_path)
    object_labels = detector.execute(labels=["baseball", "basket"], detail=1, languages=['en'])
    if not object_labels:
        return False

    object_number = {
        'baseball': len(object_labels),
        'basket': len(object_labels)
    }

    detection_objects = object_labels[0]  # Assuming the first detection entry contains detected objects

    # Filter objects based on the image path
    only_baseball = [det for det in detection_objects if str(det['bbox'][0]).split(':')[0] == "Baseball"]
    only_basket = [det for det in detection_objects if str(det['bbox'][0]).split(':')[0] == "Basket"]


    # Check if the number of baseball and basketball objects matches the groundtruth counts
    final_result = True
    for label in ['baseball', 'basket']:
        if not object_number.get(label, 0):
            continue
        if len(only_baseball) != object_number.get(label):
            print(f'Difference: {len(only_baseball) - object_number.get(label)} baseball object(s)')
            final_result = False
        if len(only_basket) != object_number.get(label):
            print(f'Difference: {len(only_basket) - object_number.get(label)} basket object(s)')
            final_result = False

    final_count = sum(object_number.values())
    if not final_result:
        print(f'Number of objects: {final_count}')

    return final_result

