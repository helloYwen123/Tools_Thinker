from object_detector import Object_Detector_Tool

# The image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_77_image_1.jpg"

# The label to detect (baseball in this case)
label_to_detect = "baseball"

# Initial attempts to detect the object
initial_attempts = 5

# Initialize the detected objects list
all_detected_objects_list = []

# Initialize object count dictionary
object_count = {"baseball": 0, "basket": 0}

# Initial detection attempts
for i in range(initial_attempts):
    # Add the label to the detection tool's labels parameter
    tool_labels = [label_to_detect]

    # Try to detect the object
    detected_objects, detected_object_count = Object_Detector_Tool.execute(
        image=image_path, labels=tool_labels, save_object=True, saved_image_path="detected_objects"
    )

    # Add the detected object list to the objects detected list
    all_detected_objects_list.append(detected_objects)

    # Print a notification message after each detection attempt
    print(f"Attempt {i + 1}:")

    # Check if there are multiple detections and break when only one detection is present
    if len(detected_objects) == 1:
        break

    # Update the object count dictionary
    for detected in detected_objects:
        object_count[detected["label"]] += 1

    # Display the current object count
    print(f"Detected detected objects with labels: {detected_objects}")
    print(f"Object count dictionary: {object_count}")

# Check if only one object was detected
# If detected_objects list is empty, no more attempts needed.
if not all_detected_objects_list:
    detected_text_blocks_list = []
    for detected_objects_list in all_detected_objects_list:
        detected_text = [detected for detected in detected_objects_list if detected["label"].startswith("text")]
        detected_text_blocks_list.append(detected_text)

    # Find the most frequently occurring letter in the text blocks
    most_common_letter = max(detected_text_blocks_list, key=lambda x: len(set(x).intersection(set(detected_text_blocks_list[0]))))

    # Collect all detected object bounding boxes
    detected_object_boxes_list = [[detected["bbox"] for detected in detected] for detected in all_detected_objects_list]
    bounding_box_string_list = [[f"bounding_box: [{bbox[0]}, {bbox[1]}, {bbox[2]}, {bbox[3]}]" for bbox in detected_object_boxes_list] for detected_object_boxes_list in detected_object_boxes_list]

    # Calculate the number of detected objects per detected label
    detected_object_count_dict = {detected["label"]: detected["bbox"].count() for detected in detected_objects}

    # Return object count and object labels detection results
    return detected_object_count_dict, bounding_box_string_list, object_count


