from letter_detector import Letter_Detector_Tool

# Load image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_77_image_1.jpg"

# Detect letters
results = Letter_Detector_Tool.execute(image=image_path)

# Filter and count letters
letter_blocks = []
letter_found = False
for bbox, text, score in results:
  if text.lower() in ["baseball", "basket"]:
    if not letter_found:
      letter_blocks.append([[bbox], text, score])
      letter_found = True

# Count letters
letter_blocks_count = len([bb for bbox, text in letter_blocks for _, score in bbox])

final_result = "B" if letter_blocks_count >= 1 else "C"


