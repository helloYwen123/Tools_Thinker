from object_detector import Object_Detector_Tool
final_result = Object_Detector_Tool.execute(image="path/to/image.png", labels=["wines"], saved_image_path="")
detected_objects = final_result['detected_objects']
object_number = final_result['object_number']

if detected_objects:
    bottle_number = [int(obj['saved_image_path'].split('.')[0].split('_')[-1]) for obj in detected_objects['baseball'] if 'baseball' in detected_objects['baseball']][0] or 0
else:
    # Assume the first match is the correct one
    bottle_number = 0

if object_number == 3:
    final_result["object_number"] = "D"
else:
    final_result["object_number"] = "C"

if bottle_number >= 2:
    final_result["final_result"] = "D"
else:
    final_result["final_result"] = "C"


