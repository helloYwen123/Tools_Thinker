from text_detector.text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

def get_detected_objects(image_path, languages=['en', 'de'], detail=0):
    result = []
    detector = Object_Detector_Tool()
    detector.execute(image_path, labels=['baseball', 'basket'], languages=languages, detail=detail)
    
    detected_objects = detector.detected_objects
    if detected_objects is not None:
        data = {'labels': detected_objects['labels'].tolist(), 'object_number': detected_objects['object_number'].tolist()}
        result.extend(data)
    
    letter_data = Letter_Detector_Tool.execute(image=image_path)
    if letter_data is not None:
        for letter_data in letter_data:
            result.append({'bbox': letter_data[0], 'letter': letter_data[1], 'score': letter_data[2]})
            
    return result

