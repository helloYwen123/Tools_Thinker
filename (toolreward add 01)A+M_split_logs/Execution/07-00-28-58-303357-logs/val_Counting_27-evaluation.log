def count_people_and_poodle(image_path):
    with open(image_path, 'rb') as img_file:
        image_data = img_file.read()
    detector = Object_Detector_Tool()
    result = detector.execute(image=image_data, labels=['woman', 'dog'], thresholds=[0.3], saved_image_path=None, save_object=False)
    
    if result['object_number'][0][1] == 1:
        final_result = 'A'
    else:
        final_result = result['object_number'][0][1]
    
    if result['object_number'][1] == 2:
        final_result += ', B'
    elif result['object_number'][1] == 1:
        final_result += ', C'
    elif result['object_number'][1] == 0:
        final_result += ', D'
    else:
        final_result += ', E'
    
    return final_result

