def count_words_on_blackboard(image_path):
    try:
        # Import letter detector tool
        letter_detector_tool = Letter_Detector_Tool()
        
        # Load image
        image = Image.open(image_path)

        # Detect letters using image
        results = letter_detector_tool.execute(image=image)
        
        # Find words in detected text
        word_blocks = []
        for block in results:
            word_lines = block[3].split()
            for line in word_lines:
                words = text_detection(word_lines)
                if all(word.lower() in ['pizza', '4', 'stagioni', 'boulevard', 'the', 'rampagne', 'lalaguna', 'the', 'lalaguna', 'the', 'the', 'piazza', 'pizza'] for word in words):
                    word_blocks.append([block[0][1], block[2], block[3]])
                    break
        
        # Return total number of words
