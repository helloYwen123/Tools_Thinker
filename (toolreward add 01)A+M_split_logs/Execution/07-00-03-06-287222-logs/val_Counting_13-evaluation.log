from object_detector import Object_Detector_Tool

final_result = []

# Image processing
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_13_image_1.jpg"

# Use the object_detector tool to count and locate baseball and basket in the image.
detector_tool = Object_Detector_Tool()
result = detector_tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Process the results
if 'baseball' in result:
    baseball_result = result['baseball']
    total_baseball = baseball_result.index.get('object_number', {})
    print("\nNumber of baseballs detected:", total_baseball['baseball'])
else:
    print("No baseball detected")

if 'basket' in result:
    basket_result = result['basket']
    total_basket = basket_result.index.get('object_number', {})
    print("\nNumber of baskets detected:", total_basket['basket'])
else:
    print("No basket detected")

# Output:
print("Number of people wearing hat:")
print("Person 1:", baseball_result[0]['object_number'])
print("Person 2:", total_baseball['baseball'])

if "baseball" in final_result:
    final_result.append("Number of baseballs detected: 2")
if "basket" in final_result:
    final_result.append("Number of baskets detected: 2")
if len(final_result) == 1:
    print('The correct answer is:', final_result[0])
else:
    print('The correct answer is: (A) 2')


