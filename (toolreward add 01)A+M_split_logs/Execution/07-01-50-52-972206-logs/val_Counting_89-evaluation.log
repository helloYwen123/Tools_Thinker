from object_detector import Object_Detector_Tool
final_result = Object_Detector_Tool.execute(image="counter image.jpg", labels=["plate"], threshold=0.45, model_size="tiny", save_object=False)

plate_count = 0
for det in final_result["detected_objects"]:
    if det["box"][0][0] > plate_count and det["box"][2][1] < plate_count:
        plate_count += 1
    else:
        counter_count = 1
plate_count += counter_count

counter_count = 0
for det in final_result["detected_objects"]:
    if det["box"][0][0] < counter_count and det["box"][1][0] > counter_count:
        counter_count += 1
else:
    counter_count += 1

final_result = {"plate": plate_count, "countercabinet": counter_count}

