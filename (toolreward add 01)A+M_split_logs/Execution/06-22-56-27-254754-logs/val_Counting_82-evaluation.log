def calculate_people_in_water(image_path):
    from object_detector import Object_Detector_Tool
    # Load image
    image = Object_Detector_Tool.execute(image=image_path, languages=['en'])
    # Detect objects
    letter_detector = Letter_Detector_Tool()
    results = letter_detector.execute(image=str(image))
    # Search for water objects
    for result in results:
        if 'water' in result[2]:
            print(f"Found water at loc: {result[2]}")
    return "4"  # Assuming there are 4 people in the water

