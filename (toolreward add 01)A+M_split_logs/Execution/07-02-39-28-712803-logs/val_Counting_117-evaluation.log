final_result = ''
try:
    # Detect objects in the image (in this case, letters)
    detector = Object_Detector_Tool()
    
    # Load an image of interest
    detector_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_117_image_1.jpg"
    detector_image_data = image_data(detect=True, image_path=detector_image_path)
    detected_objects = detector.image_to_pandas_df(detector_image_data.tolist())
    
    # Extract the bounding boxes and confidence scores for the detected letters
    detected_letters = detected_objects.filter(like='baseball').df.to_dict(orient='records')
    
    if len(detected_letters) > 0:
        for detected_letter in detected_letters:
            if 'baseball' in detected_letter['score'] and (detected_letter['score'] > 0.35):
                final_result = str(detected_letter['bbox']) + " - BaseBall " + str(detected_letter['box'][0] + 1) + " - BaseBall " + str(detected_letter['box'][2] - 1) + " - BaseBall " + str(detected_letter['box'][1] + 1) + " - BaseBall " + str(detected_letter['box'][3] - 1)
    else:
        final_result = "No Baseball detected"
except Exception as e:
    final_result = "Error detecting objects: " + str(e)


