from Letter_Detector_Tool import Letter_Detector_Tool

# Load image
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg"
detected_words = Letter_Detector_Tool.execute(image=path_to_image)

final_result = None
if len(detected_words) > 0:
    # Extract the recognized text from each detected word
    for word in detected_words:
        detected_words_per_word = {}
        confidences = []
        for word_result in word:
            detected_words_per_word[word_result[3]] = [word_result[1], word_result[2], word_result[2] - word_result[0], word_result[4]]
            confidences.append(word_result[2])
        max_confidence_word = max(confidences)
        if max_confidence_word in detected_words:
            word_text = detected_words_per_word[max_confidence_word][1]
            word_confidence = detected_words_per_word[max_confidence_word][2]
            word_bbox = detected_words_per_word[max_confidence_word][0]
            
            final_result = word_text, max_confidence_word, word_bbox, word_confidence
else:
    final_result = (None, None, None, 0)

# Print the final result
print("Final result:", final_result)


