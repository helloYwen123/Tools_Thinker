try:
    from object_detector import Object_Detector_Tool
    import sys 

    if len(sys.argv) < 2:
        sys.exit("Please provide an image to detect objects with.")

    image_path = sys.argv[-1]
    labels = sys.argv[-2:]
    threshold = 0.35
    model_size = "tiny"
    save_objects = False

    options = {
        "image": image_path,
        "labels": labels,
        "threshold": threshold,
        "model_size": model_size,
        "save_object": save_objects,
        "saved_image_path": get_saved_image_path(image_path, labels, model_size)
    }
    object_detector_tool = Object_Detector_Tool()
    detection_results = object_detector_tool.execute(options=options)

    object_number = {
        "baseball": detection_results["baseball"]
    }

    letter_detector_tool = Letter_Detector_Tool()
    letters = letter_detector_tool.execute(image=object_detector_tool.get_detected_objects(image_path))[0]
    
