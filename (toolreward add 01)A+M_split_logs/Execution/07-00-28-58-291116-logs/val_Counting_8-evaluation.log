from Object_Detector_Tool import Object_Detector_Tool
final_result = "1"

# Load the object detector tool
detector_tool = Object_Detector_Tool()

# Define a list of possible labels to detect
possible_labels = ["red_shirt"]

# Set the confidence threshold and model size
detector_tool.set_configuration(image_file_path="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_8_image_1.jpg",
                                 labels=possible_labels,
                                 confidence_threshold_threshold=0.35,
                                 model_size="tiny")

# Detect the labels
labels = detector_tool.execute()

# Count the total number of detected objects in the image
object_number = len(labels)

# If the image has more than 1 possible label, set the count to 1
if object_number > 1:
    object_number = 1

# Determine the color of the first label and check if it is red
for label in labels:
    if label['color'] == "red":
        final_result = "B"
        break

# Output the result
if final_result not in ["B", "A", "C"]:
    print("Error:", final_result)
else:
    print(final_result)


