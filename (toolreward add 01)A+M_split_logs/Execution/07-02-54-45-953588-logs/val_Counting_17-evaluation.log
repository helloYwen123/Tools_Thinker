def count_people_with_red_coat(image_path):
    from object_detector import Object_Detector_Tool
    from text_detector import Text_Detector_Tool
    from letter_detector import Letter_Detector_Tool
    # Load detected objects
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=["red coat"], save_object=True, languages=['en'])
    # Count people wearing red coat
    total_count = 0
    for detected in detected_objects:
        if detected.get("text", "") == "red coat":
            total_count += 1
    return total_count

final_result = count_people_with_red_coat("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_17_image_1.jpg")
