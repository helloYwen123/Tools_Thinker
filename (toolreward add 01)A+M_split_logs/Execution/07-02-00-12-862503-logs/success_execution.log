def count_blue_floats(white_truck_image_path):
    import Object_Detector_Tool
    import Text_Detector_Tool

    # Execute the text detection on the image
    detected_text_blocks = Text_Detector_Tool.execute(image=white_truck_image_path, languages=['en', 'de'])

    # Convert the list of detected text blocks to a list of tuples
    detected_text_blocks = [tuple(block) for block in detected_text_blocks]

    # Filter the detected blocks that contain the word 'float'
    detected_text_blocks_with_float = [block for block in detected_text_blocks if 'float' in block[3]]

    # Count the number of blocks with the word 'float'
    num_float = len(detected_text_blocks_with_float)

    # Ensure there are at least two detected blocks with 'float' for the final result
    if num_float < 2:
        return 0

    # Filter the detected text blocks with 'float' to get only one in case of multiple detected blocks
    detected_text_blocks = [block for block in detected_text_blocks_with_float if len(block[1]) == 4]

    # Count the number of detected blocks with 'float'
    num_float_included = len(detected_text_blocks)

    # Calculate the number of blue floats
    num_blue_floats = num_float - num_float_included

    return num_blue_floats
