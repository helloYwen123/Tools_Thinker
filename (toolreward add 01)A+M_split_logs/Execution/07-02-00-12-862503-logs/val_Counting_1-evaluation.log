from object_detector import Object_Detector_Tool
  from text_detector import Text_Detector_Tool
  from letter_detector import Letter_Detector_Tool
  import os
  final_result = None

  # Load image (path/to/image.png)
  image_path = 'path/to/image.png'

  # Detect objects
  object_labels = Object_Detector_Tool.execute(image=image_path, labels=['float', 'baseball', 'basket'], threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects")

  # Detect text
  text_labels = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'], detail=1)

  # Detect letters
  letter_labels = Letter_Detector_Tool.execute(image=image_path)

  # Check if text detection failed and try again
  if not text_labels:
    text_results = []
  else:
    text_results = text_labels

  # Check if objects detection failed and try again
  if not object_labels:
    object_results = []
  else:
    object_results = []

  # Combine results into final_result
  if object_results:
    final_result = {
      'objects': object_labels,
      'text': text_labels,
      'letters': letter_labels
    }

  return final_result


