from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool

final_result = None

image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg"
labels = ['baseball']
threshold = 0.7
model_size = 'tiny'
save_object = False

objects = Object_Detector_Tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=f'detected_objects')
object_number = objects['object_number']

letter_results = Letter_Detector_Tool.execute(image=image)
letters = []
for result in letter_results:
    if len(result.get('box')) >= len(image.split(',')[0]) and len(result) >= 2:
        letter = ''.join(result['box']).replace('\n', ' ')
        letters.append([result['box'], letter, result['score']])

for letter in letters:
    if letter[1] in ['baseball', 'basket']:
        final_result = B if letter[1] == 'baseball' else C

if final_result is None:
    raise ValueError('No suitable object detected in the image.')


