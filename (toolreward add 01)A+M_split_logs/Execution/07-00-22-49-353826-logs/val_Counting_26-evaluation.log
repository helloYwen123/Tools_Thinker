final_result = []
import object_detector
import text_detector
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_26_image_1.jpg"

# Detect buses from the image
buses = object_detector.detect_objects(image=image_path, labels=['buses'], save_object=True)

for bus in buses:
    bus_info = bus[0]
    if bus_info['label'] == 'buses':
        bus_info['count'] = 1
        final_result.append(bus_info)

# Detect text in the image
text_results = text_detector.detect_image(image=image_path, languages=['en'])

for result in text_results:
    letter_results = result[0]
    if letter_results[2] == 'buses':
        letter_results[2]['count'] = 1
        final_result.append(letter_results)

if buses:
    final_result.extend(buses)
print(final_result)


