from object_detector import Object_Detector_Tool

def detect_people_and_food(image_path):
    # Load the model
    object_detector = Object_Detector_Tool()

    # Execute the process
    result = object_detector.execute(image_path, languages=["en", "ja"], save_object=True)

    # Determine if the task was successful
    if len(result["baseball"]) > 0 and len(result["basket"]) > 0:
        return "2"

    return "0"

