        det_len = len(detection[0])
        if det_len < 3:
            continue
            
        # Add 1 to object's score
        detection[3]['score'] += 1

# Save text detection objects to a file
if 'result' in globals():
    result = object_detector_tool.execute(image='path/to/beef_image.jpg', languages=['en', 'de'])
    with open('text_detection_results.txt', 'w') as file:
        for detection in result:
            print(f"> \"{detection[0]}\"",
                  file=file)
        print("Text detection results saved.")

