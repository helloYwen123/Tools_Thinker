from letter_detector import Letter_Detector_Tool

# Load the image
result = Letter_Detector_Tool.execute(image='path/to/image.png')

# Extract the detected letters as lists
results = []
for bbox, letter, score in result:
    results.append([[[bbox[0], bbox[1]], [-bbox[2], -bbox[3]], [bbox[2], bbox[3]], [-bbox[0], -bbox[1]]],
                    letter,
                    score])

# Get the number of detected letters
