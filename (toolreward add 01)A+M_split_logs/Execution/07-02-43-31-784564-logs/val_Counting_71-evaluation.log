def count_yellow_stars():
    # Load the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_71_image_1.jpg"
    
    # Use the Text_Detector_Tool to detect text in the image
    detection_result = Text_Detector_Tool.execute(image=image_path, languages=['ja'])
    if detection_result:
        text_blocks = detection_result[0]
        if text_blocks and text_blocks[1][1] == 'yellow':
            return len([t for t in text_blocks[0] if t[0][1] == 255 and t[1][1] == 1)]
    
    return 0

final_result = count_yellow_stars()
print(final_result)


