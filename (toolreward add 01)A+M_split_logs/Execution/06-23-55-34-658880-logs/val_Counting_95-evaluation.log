from text_detector import Text_Detector_Tool

# Convert the image file path to the tool's format
results = []
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_95_image_1.jpg"

# Convert the image file path to the tool's format
lang_codes = ['en', 'ja']
lang_code = 'en'

# Threshold for the confidence score
threshold = 0.5

# Set the level of detail
detail = 1

# Execute the text detection
for language in lang_codes:
    result = Text_Detector_Tool.execute(image=image_path, languages=[language], detail=detail)
    detected_text_blocks = []
    detected_text = ''

    for detection in result[0]:
        if detection[0] > threshold:
            detected_text_blocks.append([detection[2], detection[1], detection[2], detection[3]])
            detected_text += ' '.join(detection[1:]) + ' '
    detected_text_blocks.append([detected_text, detected_text, 0.5])
    results.append(detected_text_blocks)

    # For debugging
    # print('Detected text:', detected_text)

# Filter the detected text blocks
filter_text = ['baseball']
text_blocks = [result for result in results if result[1] in filter_text]

# Count the number of text blocks
count = len(text_blocks)
final_result = None
for text_block in text_blocks:
    count -= 1
    if count > 0:
        final_result = text_block

final_result


