def count_people(image_path, saved_image_path, languages=['en', 'de'])):
    result = []
    results = Text_Detector_Tool.execute(image=image_path, languages=languages)
    if 'error' in results:
        print(f"Error: {results['error_message']}")
        return
    results = [box, text, score] for bbox, text, score in results
    if not results:
        print("Text detection failed.")
        return
    for bbox, text, score in results:
        if text not in ["person"]:
            continue
        result.append(bbox)
        break
    return result

giraffe_info = Image.open('/path/to/giraffe_image.jpg')
final_result = count_people(image_path=giraffe_info.path, languages=['en', 'de'])
