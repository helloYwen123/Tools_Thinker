from object_detector import Object_Detector_Tool

object_detector = Object_Detector_Tool()
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_93_image_1.jpg"

object_detector.execute(image=image_path, labels=["hand"], save_object=False)
results = object_detector.results

hand_bbox = None
number_of_people_washing_hands = 0

for result in results:
    bbox = result[0]
    if "hand" in bbox[1]:
        hand_bbox = result[1]
        if not hand_bbox[0]:
            number_of_people_washing_hands += 1

number_of_people_washing_hands


