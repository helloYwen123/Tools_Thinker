def count_words_on_chalkboard():
    # Load the image
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_108_image_1.jpg'
    image = Image.open(image_path)

    # Use Text_Detector_Tool to detect and count the words
    result = Text_Detector_Tool.execute(image, Languages=['en'], detail=1)

    # Count the word count
    word_count = sum(1 for line in result for word_line in line for word in word_line.split())

    return word_count

# Calculate the number of words on the chalkboard
number_of_words = count_words_on_chalkboard()

final_result = 'D'
if number_of_words in [A, B, C, D, E]:
    final_result = number_of_words
else:
    final_result = 'C'

print("The number of words written in white chalk is:", final_result)


