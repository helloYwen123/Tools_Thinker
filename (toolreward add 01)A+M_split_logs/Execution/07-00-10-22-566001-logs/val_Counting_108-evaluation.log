from letter_detector import Letter_Detector_Tool


# Load the image
image = 'path/to/image.png'

# Detect letters in the image
results = Letter_Detector_Tool.execute(image=image)


# Get the number of words written in white chalk on the chalkboard
total_words = 22


# Iterate through each detected letter and count the letter
for results_ in results:
    word = str(results_["letter"])
    if word in ['pizza', 'boulevard', 'the']:
        total_words -= 1
        break


