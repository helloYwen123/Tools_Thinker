from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

def count_copies(image_path):
    final_results = {}
    
    # Detect and count objects (in this case, only the man without hat)
    detector = Object_Detector_Tool(image_path)
    detections = detector.execute(labels=['no hat'], languages=['en'])
    
    for label, detection in detections.items():
        if label == 'no hat':
            if not final_results.get(label):
                final_results[label] = {'box': [], 'score': 0}
            final_results[label]['box'] += [detection['box']]
            final_results[label]['score'] += detection['score']
    
    # Collect all detected 'no hat' objects
    detected_no_hats = [object_info for object_info in final_results.values() if 'no hat' in object_info['bbox']]
    
    # Calculate the number of 'no hat' object detections
    num_detections = len(detected_no_hats)
    
    return {'no hat detections': num_detections}
```


