from text_detector_tool import text_detector
from letter_detector_tool import letter_detector

text_results = text_detector.execute(image='path/to/image.png')
final_result = []

for text_result in text_results:
    text = text_result[1]
    common_vowels = 'aeiou'
    if text in common_vowels:
        final_result.append({**{'name': 'Common', 'count': 1}, **text})
    if text_is_glowing(text):
        final_result.append({**{'name': 'Glowing', 'count': 1}, **text})

if not final_result:
    final_result.append({"name": "No common vowels found."})

if final_result:
    for result in final_result:
        for letter in sorted(result['name']):
            print(f"({letter} appeared {result['count']} times)")
else:
    print("No common vowels found.")


