def count_batman(batman_bbox, batman_conf):
    """
    Count objects in an image.
    Parameters:
    - batman_bbox: List of bounding box coordinates, e.g. [[x0, y0], [x1, y1], [x2, y2], [x3, y3]]
    - batman_conf: Confidence score, e.g. 0.95
    Returns:
    - int: The number of objects.
    """
    return int(batman_bbox[-1]) + 1

batman_bbox1 = [[200, 50], [350, 150], [400, 200], [100, 200]]
batman_conf1 = 0.95

# Example usage
final_result = count_batman(batman_bbox1, batman_conf1)
print(final_result)  # Output: 3


