from object_detector import Object_Detector_Tool

# Path to the image file
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_91_image_1.jpg'

# Call the tool to detect text in the image
results = Object_Detector_Tool.execute(image=image_path)

# Extract the letter detection results and their scores
detected_letters = [{"boxed_x": result["boxed_x"], "boxed_y": result["boxed_y"], "recognized_text": result["recognized_text"], "score": result["score"]} for result in results]

# Find the letter with the lowest score (closest to 'i')
lowest_score_letter = min(detected_letters, key=lambda x: x["score"])

if lowest_score_letter and 'i' in lowest_score_letter["recognized_text"]:
    final_result = "B"  # Corresponding line, we would check and modify final_result based on the detection result here
else:
    final_result = "D"  # This line indicates that "D" or "E" will be chosen based on detection results if "i" is not found in text

