from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Define the path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_20_image_1.jpg"

# Create an object detector tool
od = Object_Detector_Tool()

# Convert the image file path to a string
image_string = str(image_path)

# Execute the text detection tool and save detected text
result = Text_Detector_Tool.execute(image=image_string, languages=["en", "de"])
detected_text_blocks = result[0]

# Execute the letter detection tool and filter out irrelevant letters
results = Letter_Detector_Tool.execute(image=image_string)
letter_blocks = results[0]

# Convert detected texts to their bounding boxes (to ensure coordinates and scores are in the same order)
detected_text_blocks_filtered = [(bbox + [letter] + [score]) for bbox, text, score in detected_text_blocks]

# Filter out invalid boxes (i.e., those with a score of 0) and create a final list of valid boxes
valid_boxes = [(bbox[0][0], bbox[0][1], bbox[1][0], bbox[1][1], 0.95) for bbox in detected_text_blocks_filtered if score > 0.95 and bbox[3] not in letter_blocks]

# Count the valid boxes
valid_boxes_count = len(valid_boxes)

final_result = choices((A, B, C, D, E))[valid_boxes_count]
print("Number of toilets to the left of basins:", final_result)


