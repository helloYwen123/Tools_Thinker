from object_detector import Object_Detector_Tool
from imageai.Ocr import Model
from letter_detector import Letter_Detector_Tool

threshold = 0.35
objects = ["baseball", "basket"]

result = None

try:
    # Load the model
    obj_detector = Object_Detector_Tool()
    obj_detector.setModelTypeAsTinyModel()
    obj_detector.setModelConfiguration("TinyModel")
    obj_detector.setModelFile("/path/to/my_model.tiny")
    obj_detector.setLicensePlateDetection(True)
    obj_detector.setObjectLabels(objects)
    obj_detector.setModelImage("Detected_objects.jpg")
    result = obj_detector.run()

except Exception as e:
    print(f"An error occurred: {e}")

if result:
    boxes, scores, labels = [], [], {}
    for detected_object in result['detections']:
        try:
            box = detected_object['bbox']
            score = detected_object['score']
            labels[labels.get('baseball', 0)] += 1
            labels[labels.get('basket', 0)] += 1
            box = tuple(tuple(min(x, w) for x, w in zip(box[i], box[i + 1 :])) for i in range(3, 5))
            boxes.append(box)
            scores.append(score)
            labels[detected_object['label']] = 0
        except:
            pass

    letter_labels = [
        "baseball",
        "basket",
        "football",
        "baseball_1",
        "basket_1",
        ...
    ]
    letter_results = []
    for l in letter_labels:
        try:
            letter = obj_detector.getLetterLabels(l)
            if letter:
                letter_results.append((letter[0], letter[3], letter[4]))
        except Exception as e:
            print(f"Error processing letter {l}: {e}")
            continue

    if letter_results:
        max_confidence = max([v[4] for v in letter_results])
        highest_confidence_label = max([v['label'] for v in letter_results], key=lambda x: x[4])
        highest_confidence_text = ''.join([v[1] for v in letter_results if v[4] == highest_confidence_label][0])
        highest_confidence_bbox = tuples_to_bbox(letter_results[0][1], letter_results[0][3], letter_results[0][4])
        letter_results = sorted(letter_results, key=lambda x: x[4], reverse=True)

        for i, (bbox, letter, confidence) in enumerate(letter_results):
            if confidence > threshold:
                for letter_in_bbox in letter_labels:
                    if letter[1] == letter_in_bbox[0] and letter[3] in (bbox[0], bbox[1], bbox[2]) and letter[4] < boxes[i]:
                        labels[letter_in_bbox[0]] = labels[letter_in_bbox[0]] + 1
                        if letter[3] == highest_confidence_bbox[0]:
                            letter[3] = highest_confidence_bbox[1]
                            letter[4] = max(highest_confidence_bbox[0], letter[4])
                        else:
                            letter[3] = highest_confidence_bbox[1]
                            letter[4] = highest_confidence_bbox[3] - letter[4]
                break
else:
    objects = []
    for label in objects:
        objects.append(len(result['detections']) - obj_detector.count(label) + min(scores) + 1)

final_result = labels[objects.index(max(objects))]
print(final_result, len(labels))


