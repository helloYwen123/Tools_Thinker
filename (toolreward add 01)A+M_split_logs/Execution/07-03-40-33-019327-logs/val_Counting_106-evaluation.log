def count_white_vertical_lines(image_path):
    det_result = Object_Detector_Tool.execute(image=image_path, labels=["white"], model_size="tiny", save_object=True, saved_image_path="detected_objects")
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_106_image_1.jpg"
    text_result = Text_Detector_Tool.execute(image=image_path, languages=["en", "de"], detail=1)
    letter_result = Letter_Detector_Tool.execute(image=image_path)
    
    detected_objects = [[bbox, ' detected'] for _, obj in det_result.items()]
    if "baseball" in detected_objects and "basket" in detected_objects:
        detected_objects, object_number = detected_objects
    
    white_vertical_lines = 0
    for box in letter_result:
        if 'basket' in str(box[2]):
            white_vertical_lines += 1
    
    final_result = {
        "A": (0 if white_vertical_lines == 0 else detected_objects, object_number),
        "B": (0 if white_vertical_lines == 0 else detected_objects, object_number),
        "C": (0 if white_vertical_lines == 0 else detected_objects, object_number),
        "D": (0 if white_vertical_lines == 0 else detected_objects, object_number),
        "E": None
    }
    
    return final_result

# Using the tool modules
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_106_image_1.jpg"
result = count_white_vertical_lines(image_path)
print("Detected white vertical lines:", result)


