import object_detector
from object_detector import *

PATH = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_80_image_1.jpg"

def get_blue_seats(image_path):
    labels = ["blue seat"]
    threshold = 0.35
    model_size = "tiny"

    # Load the model
    model = load_object_detector_model(model_size)

    # Execute the detection
    results = model.detect(image_path, labels, threshold)

    # Get the bounding box coordinates for each detected object
    bounding_box_coords = []
    for box in results[0]:
        bounding_box_coords.append((box[0], box[1], box[2], box[3]))

    # Filter and extract only the empty blue seats
    empty_blue_seats = [
        bounding_box for bounding_box in bounding_box_coords
        if bounding_box[2] <= 150 and bounding_box[3] >= 65
    ]

    empty_blue_seat_count = len(empty_blue_seats)

    return empty_blue_seat_count

total_seat_count = get_total_seats(image_path)
total_persons = get_total_people(image_path)

# Check if total_seat_count is even to ensure there are empty blue seats
if total_seat_count % 2 != 0:
    empty_blue_seat_count = total_seat_count
else:
    empty_blue_seat_count = (total_seat_count + 1) // 2

empty_blue_seat_count


