def count_people(image_path):
    objects = Object_Detector_Tool(image_path, labels=["people"], threshold=0.35).outputs['detected_objects']
    if objects:
        detections = []
        for obj in objects:
            detections.append({'bbox': obj['bbox'], 'text': obj['text'], 'score': obj['score']})
        detected_objects = objects[0]
        final_result = len(detected_objects['bbox'])
        det_results = objects[1]
        object_number = len(detected_objects['bbox'])
        return {'det_results': det_results, 'object_number': object_number}
    else:
        return {}

result = count_people('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_49_image_1.jpg')
final_result = result.get('det_results')
if final_result:
    for det_obj in final_result:
        for obj in det_obj['bbox']:
            print("Number of people detected:", obj['bbox'][2] - obj['bbox'][0] + 1)
else:
    print('There is no information about people in the image.')


