from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

final_result = 2

# Load object detector tool
object_detector_tool = Object_Detector_Tool()
object_detector_tool.set_image_path("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_49_image_1.jpg")
object_detector_tool.set_labels(["baseball", "basket"])
object_detector_tool.set_threshold(0.35)
object_detector_tool.set_model_size("tiny")
object_detector_tool.set_save_object(True)
object_detector_tool.set_saved_image_path("detected_objects")

# Detect objects with object detector
detected_objects = object_detector_tool.execute()

# Load text detection tool
text_detector_tool = Text_Detector_Tool()
textDetector_tool.set_image_path("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_49_image_1.jpg")
textDetector_tool.set_languages(["en", "de"])
textDetector_tool.set_detail(1)
text_detector_tool.execute()

# Detect letters with letter detection tool
letter_detector_tool = Letter_Detector_Tool()
letterDetector_tool.set_image_path("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_49_image_1.jpg")
letterDetector_tool.execute()

# Get text detected objects
text_objects = text_detector_tool.execute()

# Count objects
count_baseball = len(detected_objects)
count_basket = len(text_objects)

final_result = count_baseball + count_basket


