from object_detector import Object_Detector_Tool
import sys
import imageio

image_path = sys.argv[1]

# Load the image and detect objects
obj_detector = Object_Detector_Tool(image_path, labels=["baseball"], threshold=0.35)
result = obj_detector.run()

# Initialize dictionaries to keep track of the object information and the number of objects
object_count = {}

# Iterate through the list of detected objects and count each object
for detected in result:
    # Get the box coordinates, object name, and confidence score
    box = [det[0] for det in detected]
    object_name = f"Object #{det[1]}"

    # Add the object to the dictionary
    object_count[object_name] = object_count.get(object_name, 0) + 1

final_result = max(object_count.values(), key=object_count.get)

if final_result < 2:
    final_result = "2"
else:
    final_result = "3"

print(final_result)


