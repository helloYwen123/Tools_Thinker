def detect_skiers(image_path):
    import Image
    import pytesseract

    image = Image.open(image_path)

    # Convert to grayscale
    gray = image.convert('L')

    # Detect text
    text = pytesseract.image_to_string(gray, language='ch_sim')

    # Check if there are any skiing references in the text
    skiing_references = []
    for line in text.split('\n'):
        if '滑雪' in line.lower():
            skiing_references.append(line.strip())

    return skiing_references

final_result = detect_skiers('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_76_image_1.jpg')
