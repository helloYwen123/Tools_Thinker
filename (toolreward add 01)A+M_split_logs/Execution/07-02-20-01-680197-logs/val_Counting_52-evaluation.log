from object_detector import Object_Detector_Tool

image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_52_image_1.jpg"
labels = ["red", "motorcycle"]
threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"
object_number = {"red": 2, "motorcycle": 0}

detector = Object_Detector_Tool(is_save_object=save_object, saved_image_path=saved_image_path)
detected_objects, object_number = detector.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size)

final_result = max(detected_objects, key=object_number.get)


