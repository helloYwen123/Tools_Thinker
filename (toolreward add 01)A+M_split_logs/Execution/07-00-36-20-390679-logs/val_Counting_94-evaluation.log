def count_pride_parade_drivers(driver_path):
    # Load the image
    img = Image.open(driver_path)
    
    # Use the letter detector tool to detect letters on the motorcycle
    letter_results = Letter_Detector_Tool.execute(img)
    
    # Check if there are any letters detected
    if len(letter_results) == 0:
        return False  # No letters detected
    
    letter_results_list = []
    for result in letter_results:
        text = result[2]
        confidence_score = result[3]
        
        # Check if the detected letter is recognizable
        if text.lower() == 'p' or text.lower() == 'r' or text.lower() == 'e':
            letter_results_list.append((result[0], text, confidence_score))
    
    count = sum([1 for _, text, _ in letter_results_list])
    
    return count


