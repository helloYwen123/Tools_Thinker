def count_phones(phone_img):
    from_tool: Object_Detector_Tool
    object_box = from_tool.execute(image=phone_img, labels=['cellular', 'phone'])
    
    if len(object_box) > 0:
        bbox = object_box[0]['bbox']
        conf = object_box[0]['score']
        return bbox, conf
