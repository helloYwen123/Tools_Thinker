from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

final_result = None

# Read the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_91_image_1.jpg"
image = open(image_path, 'rb').read()

# Detect text
result = Text_Detector_Tool.execute(image=image, languages=['en', 'de'])
detected_texts = result[0]

# Print the detected text blocks
print("Detected text blocks:")
for i in range(len(detected_texts)):
  print(f"[[{{x0, y0}, {x1, y1}}, {detected_texts[i][1], detected_texts[i][2]}}], {detected_texts[i][4]}")

# Detect letters
result = Letter_Detector_Tool.execute(image=image)
detected_letters = result[0]

# Print the detected letter list
if len(detected_letters) > 0:
  print(f"Detected letters: {detected_letters}")
else:
  print("No text detected")

if final_result is None:
  if detected_texts:
    final_result = 1
  else:
    final_result = 0
else:
  if detected_texts == final_result:
    final_result += 1
  elif detected_texts != final_result:
    final_result -= 1

print(f"Final number of words with 'i' in the image: {final_result}")


