from object_detector import Object_Detector_Tool
  from letter_detector import Letter_Detector_Tool

  def count_letters(image_path):
    tool = Object_Detector_Tool
    result = tool.execute(image=image_path)
    
    if "baseball" in result["object_number"] or "basket" in result["object_number"]:
      print("The image contains a baseball or a basket, but not both.")
      return
    
    tool = Letter_Detector_Tool
    detected_letters = tool.execute(image=image_path)

    max_confidence = 0
    detected_letters_list = []
    for detection in detected_letters:
      confidence = detection[3]
      if confidence > max_confidence:
        max_confidence = confidence
        detected_letters_list = [detection] if not detected_letters else [x for x in detected_letters if x[3] == confidence]

    print(f"Detected letters with confidence: {max_confidence:.2f}")
    for letter in detected_letters_list:
      print(f"* {letter[2]}, {letter[1]}, {letter[1]:.2f}")

  count_letters("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_91_image_1.jpg")


