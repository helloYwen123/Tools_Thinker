from object_detector import Object_Detector_Tool

def count_people_with_suit(image_path):
    # Load the image
    object_detector = Object_Detector_Tool()
    
    # Run the detection process
    detected_results = object_detector.execute(image_path, labels=["suit"], save_object=True, saved_image_path="detected_objects")
    
    # Count the number of people wearing a suit
    people_count = len(detected_results) if detected_results else 0
    
    return people_count

