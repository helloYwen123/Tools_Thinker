def detect_image_tools(image_path):
    object_detector = Object_Detector_Tool 
    text_detector = Text_Detector_Tool
    letter_detector = Letter_Detector_Tool

    # Step 1: Detect text
    try:
        detected_text_blocks = text_detector.execute(image_path, languages=["en", "de"])
        print(f"Text detected in the image: {detected_text_blocks}")
    except Exception as e:
        print(f"Error: {e}")

    # Step 2: Detect letters
    try:
        detected_letters = letter_detector.execute(image_path)
        print(f"Letters detected in the image: {detected_letters}")
    except Exception as e:
        print(f"Error: {e}")

    # Step 3: Combine results
    result = []
    if detected_text_blocks and detected_letters:
        for text_block in detected_text_blocks:
            for letter_details in detected_letters:
                if text_block and letter_details:
                    try:
                        score = text_block[5]  # Confidence score - 0 for no text (assuming this part is provided in text_detector output)
                        letter_details.append({"bbox": letter_details[0], "letter": text_block[3], "score": score})
                    except Exception as e:
                        print(f"Error with letter details: {e}")
    else:
        result = []

    final_result = None  # Store the final result
    return result


