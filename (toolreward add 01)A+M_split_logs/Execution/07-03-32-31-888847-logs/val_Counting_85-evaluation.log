from object_detector import Object_Detector_Tool, text_detector
final_result = "B"

# Convert the path of the image to a file object
filename = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_85_image_1.jpg"

# Execute the object detector tool to detect the number of telephone poles
detector = Object_Detector_Tool()
labels_output = detector.execute(image=filename, labels=["telephone pole"], save_object=False)
object_number = {label: len(detected_objects) for label, detected_objects in labels_output.items()} 

print(f"The number of telephone poles to the right of the truck is: {object_number.get('telephone pole', [])[0]}")

# Execute the text detector tool to count the occurrence of baseball and basket
detected_objects = text_detector.execute(image=filename, languages=["eng"], detail=1)
total_baseball = 0
total_basket = 0
for _, letter, score in detected_objects:
    if letter == "baseball":
        total_baseball += 1 
    elif letter == "basket":
        total_basket += 1

print(f"The total occurrence of baseball and basket in the image: {total_baseball}.")


