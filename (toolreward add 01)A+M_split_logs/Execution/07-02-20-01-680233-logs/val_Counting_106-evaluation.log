from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_106_image_1.jpg", labels=["tennis player"], save_object=True, saved_image_path="detected_objects")

detected_objects = final_result["detected_objects"]
object_number = final_result["object_number"]

print(f"Number of white vertical lines on the ground: {detected_objects['tennis player'][0]['bbox'][1] - detected_objects['tennis player'][0]['bbox'][1]}")

if detected_objects:
    for detected_object in detected_objects["tennis player"]:
        if "box" in detected_object:
            if detected_object["bbox"][1] > detected_object["bbox"][1] and detected_object["bbox"][2] > detected_object["bbox"][2]:
                continue
        if detected_object["bbox"][1] < detected_object["bbox"][3] and detected_object["bbox"][2] < detected_object["bbox"][4]:
            continue
        print(f"\tDetected tennis player: {detected_object['bbox'][1]},{detected_object['bbox'][3]},{detected_object['bbox'][2]},{detected_object['bbox'][4]}")
else:
    print("No detected tennis player.")


