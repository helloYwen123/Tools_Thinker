def count_red_buses(buses):
    red_buses = []
    for bus in buses:
        if bus['color'] == 'red':
            red_buses.append(bus)
    return red_buses

final_result = count_red_buses([{'color': 'red', 'number': 4, 'number_of_routes': 14}, {'color': 'blue', 'number': 5, 'number_of_routes': 11}, {'color': 'green', 'number': 6, 'number_of_routes': 10}] )
