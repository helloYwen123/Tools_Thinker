from letter_detector import Letter_Detector_Tool

final_result = ""

# Step 1: Detect and save detected letters
results = Letter_Detector_Tool.execute(image='/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_103_image_1.jpg')

# Step 2: Count the detected letter instances
num_letter_instances_dct = {}
for result in results:
    letter, score = result
    if letter not in num_letter_instances_dct:
        num_letter_instances_dct[letter] = 1
    else:
        num_letter_instances_dct[letter] += 1

# Check if any letter was detected and if it is considered as yellow
yellow_jackets = [label for label, instance_count in num_letter_instances_dct.items() if instance_count >= 2 and label == 'yellow_jacket']

final_result = '0' if yellow_jackets != [] else '1'

print(final_result)


