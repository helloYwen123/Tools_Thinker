from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool
object_count = 0
letter_count = 0
final_result = 0
with Object_Detector_Tool(image="path/to/image.png") as objects:
    for object in objects:
        if isinstance(object, str):
            final_result += 1
        else:
            for letter in object:
                if isinstance(letter, str):
                    letter_count = 1
                    if letter in "0123456789":
                        letter_count += 1
                        letter_count = 2
                    else:
                        letter_count = 3
                else:
                    letter_count = 0

with Letter_Detector_Tool(image="path/to/image.png") as letters:
    for letter in letters:
        final_result += 1
        if letter in "0123456789":
            final_result += 1
        else:
            final_result += len(letter)

total_count = object_count + letter_count
print("Total count:", total_count)
print("Final result:", final_result)
if final_result == object_count:
    final_result = letter_count
final_result


