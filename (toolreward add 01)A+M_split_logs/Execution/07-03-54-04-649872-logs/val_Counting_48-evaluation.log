from letter_detector import Letter_Detector_Tool

# Import the available tools
OBD = Object_Detector_Tool()
TD = Text_Detector_Tool()
LD = Letter_Detector_Tool()

# The paths to the images you want to analyze
paths = ['/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_48_image_1.jpg']

# Analyzing each image
for i, path in enumerate(paths):

    # Execute the Letter Detector Tool
    results = LD.execute(image=path)

    # Extract the letter information from the output of Letter Detector Tool
    for result in results:
        if 'letter' in result[1] and 'A' in result[1]:
            # Final result
            final_result = 'A'
            break

    # If there is no letter in the image
    if not final_result:
        final_result = 'None'
        break


