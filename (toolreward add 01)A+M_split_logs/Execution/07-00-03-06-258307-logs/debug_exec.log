def find_ski_flip(image_path):
    import object_detector
    detected_objects = object_detector.execute(image=image_path, labels=["skier"], save_object=True, saved_image_path="detected_objects")

    if len(detected_objects) > 0:
        ski_flip_count = len([obj for obj in detected_objects if "skier" in obj.get("bbox", [])])

        return (ski_flip_count, len(detected_objects))
    else:
        return (0, 0)

