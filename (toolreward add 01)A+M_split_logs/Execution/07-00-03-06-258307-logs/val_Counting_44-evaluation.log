def identify_ski_flips(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=['skier'], save_object=True, saved_image_path="detected_objects")
    total_objects = object_number = {}
    for obj in detected_objects['bbox']:
        label = obj['text']
        num_objects = detected_objects[label][0]
        if label == 'skier':
            object_number['skier'] = num_objects
            total_objects[label] = total_objects.get(label, 0) + num_objects
    return f"{} skiers are doing a flip\n\nTotal number of skiers: {total_objects['skier']}",
final_result = identify_ski_flips("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_44_image_1.jpg")
