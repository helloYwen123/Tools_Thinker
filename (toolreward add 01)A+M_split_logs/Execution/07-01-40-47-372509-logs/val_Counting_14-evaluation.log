from object_detector import Object_Detector_Tool

# Execute the object detector tool
final_result = Object_Detector_Tool.execute(image="path/to/image.png", labels=["horse"])

# Check if the tool executed without errors
if final_result:
    print("The object detector tool executed without errors.")
else:
    print("The object detector tool encountered an error.")

# Retrieve the returned objects dictionary
object_count = final_result['object_number']

if object_count:
    print("The horse has been identified with", object_count, "object(s) detected.")
else:
    print("No object(s) detected near the horse.")


