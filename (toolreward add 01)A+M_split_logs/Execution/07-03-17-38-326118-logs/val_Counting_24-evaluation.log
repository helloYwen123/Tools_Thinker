# Import the necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Define the image path
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_24_image_1.jpg'

# Use the object_detector tool to detect the number of objects in the image
detected_objects = Object_Detector_Tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Use the text_detector tool to detect the presence of words ("Elyssium") in the image
available_languages = ['en', 'de']
results = Text_Detector_Tool.execute(image=image_path, languages=available_languages)

available_languages = ['en', 'ch_sim', 'de']
results = Text_Detector_Tool.execute(image=image_path, languages=available_languages)  # Only English and simplified Chinese detected


# Use the letter_detector tool to detect the letters in the image
letter_detector = Letter_Detector_Tool()
results = letter_detector.execute(image=image_path)

# Set a threshold for the number of detected objects in the front and not the sides of the bus to identify the front
threshold = 1
front_results = detected_objects["baseball"]

num_front_results = len(list(filter(lambda x: x["bbox"][2] - x["bbox"][0] > threshold and x["bbox"][4] - x["bbox"][2] > threshold, front_results)))

# Answer with the final result
if num_front_results == 2:
    final_result = "A"
elif num_front_results == 3:
    final_result = "C"
else:
    final_result = "D"

print(final_result)


