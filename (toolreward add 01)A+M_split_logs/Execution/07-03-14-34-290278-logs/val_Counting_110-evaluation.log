def find_red_bikes(image_path):
    obj_detector = Object_Detector_Tool()
    detected_objects = obj_detector.execute(image=image_path, labels=["baseball", "basket"], save_object=False, saved_image_path=None)
    object_number = {}

    for label in detected_objects['baseball']:
        box = label['bbox']
        score = label['score']
        object_number[label['bbox'][0]] = object_number.get(box[0], 0) + 1
    
    for label in detected_objects['basket']:
        box = label['bbox']
        score = label['score']
        object_number[label['bbox'][0]] = object_number.get(box[0], 0) + 1

    return object_number

