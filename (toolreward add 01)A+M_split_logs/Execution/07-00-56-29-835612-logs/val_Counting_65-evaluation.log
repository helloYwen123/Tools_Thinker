def analyze_letters(image_path):
    with open(image_path, 'r') as file:
        contents = file.read()
        result = Letter_Detector_Tool.execute(contents)
        detections = [{'bbox': detection.bbox, 'letter': detection['text'], 'score': detection['score']} for detection in result]
        return detections

def count_letters(image_path):
    detections = analyze_letters(image_path)
    letter_counts = {}
    for detection in detections:
        letter = detection['letter']
        if letter in letter_counts:
            letter_counts[letter] += 1
        else:
            letter_counts[letter] = 1
    return letter_counts

# Read image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_65_image_1.jpg'
print(count_letters(image_path))


