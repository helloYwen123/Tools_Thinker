def count_object_labels(image_path, labels, threshold, model_size, save_object, saved_image_path):
    try:
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
        object_number = {'baseball': 0, 'basket': 0}
        for label, bounding_box in detected_objects.items():
            x, y, w, h = bounding_box
            box = (x, y, x + w, y + h)
            object_number[label] += 1
        return detected_objects, object_number
    except:
        return None

def detect_text(image_path, languages, detail):
    try:
        result = Text_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
        text_blocks = []
        for i, detection in enumerate(result):
            if detection.confidence_score >= threshold:
                bbox = detection.bounding_box
                text_block = (bbox[0][0], bbox[0][1], bbox[1][0], bbox[1][1])
                text_block[0] = max(text_block[0], x1)
                text_block[1] = max(text_block[1], y1)
                text_block[2] = min(text_block[2], x2)
                text_block[3] = min(text_block[3], y2)
                text_blocks.append(text_block)
        return text_blocks
    except:
        return None

def detect_letters(image_path):
    letters = letter_detector.Letter_Detector_Tool.execute(image_path)
    return [bounding_box for _, bounding_box in letter_detector.Letter_Detector_Tool.execute(image_path)]

def process_image(image_path):
    if image_path.endswith('.jpg'):
        return count_object_labels(image_path, ('baseball',), 0.35, 'tiny', True, None)
    elif image_path.endswith('.png'):
        try:
            image = Image.open(image_path)
        except Exception as e:
            return print(f'An error occurred: {e}')
        languages = ('en', 'de')  # You can add more languages if needed
        detected_objects, object_number = process_image(image_path)
        text_blocks = detect_text(image_path, languages, 0)
        detected_letters = detect_letters(image_path)
        return {'detect_objects': detected_objects, 'object_number': object_number, 'text_blocks': text_blocks, 'detected_letters': detected_letters}
    else:
        return print(f'Invalid image file type: {image_path}')

