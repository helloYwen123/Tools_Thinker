from object_detector import Object_Detector_Tool

def count_toilets_with_lids(image_path):
    tool_instance = Object_Detector_Tool()
    detected_objects = tool_instance.execute(image=image_path, labels=["toilet"], save_object=True, saved_image_path="detected_objects")
    
    if detected_objects:
        num_toilets_with_lids = len(detected_objects["toilet"])
        return num_toilets_with_lids
    else:
        return ""

