def get_children_on_bench(image_path):
    from object_detector import Object_Detector_Tool

    detector_tool = Object_Detector_Tool(
        save_object=True,
        image=image_path,
        labels=["skateboard", "sidewalk"],
        threshold=0.35
    )

    result = detector_tool.execute()
    object_number = result.object_number

    return (object_number, "The number of children sitting on the bench is", object_number)

final_result = get_children_on_bench("val/Counting/35_image_1.jpg")
