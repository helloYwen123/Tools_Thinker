def count_parking_meters(image_path):
    output_dir = 'detected_objects'
    detector = 'Object_Detector_Tool'
    model_size = 'tiny'
    save_object = True
    language_code = 'en'
    
    try:
        detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, languages=[language_code], model_size=model_size, threshold=0.35, save_object=save_object, saved_image_path=output_dir)
        
        # Extract necessary text information
        extracted_text = []
        for detected_object in detected_objects:
            text_parts = detected_object['object']
            extracted_text.append(text_parts[1])
        
        # Count parking meters
        parking_meters = 0
        for text in extracted_text:
            if 'Parking Meter' in text:
                parking_meters += 1
                
        return parking_meters
    except Exception as e:
        return 0

