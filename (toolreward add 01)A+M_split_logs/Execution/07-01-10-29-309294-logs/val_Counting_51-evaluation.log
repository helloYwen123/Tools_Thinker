def get_image_data(path):
    import os
    import os.path as osp
    # Load the image
    image = Image.open(path)
    
    # Detect objects
    detected_objects, object_number = Object_Detector_Tool.execute(image=image, labels=["buns", "hot_dogs", "lettuce"), save_object=True, saved_image_path="detected_objects")
    # Find bounding boxes and text scores for detected items
    text_objects = Text_Detector_Tool.execute(image=image, languages=['en'], detail=2)
    # Create a list of dict objects with bounding boxes, recognized texts, and text scores for each detected item
    bbox_text_score = []
    for label, bbox, scores in zip(detected_objects['baseball'], text_objects['bbox'], text_objects['score']) + detected_objects['basket'], text_objects['bbox'], text_objects['score']:
        bbox_text_score.append([bbox, label, scores[0]])
    
    return detected_objects, object_number, bbox_text_score

