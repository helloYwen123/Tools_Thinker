def count_doors(img):
    # Load the image and apply the threshold to filter out the doors
    filtered_img = gray_img.apply(threshold_filter)
    
    # Apply the object_detection algorithm to detect doors
    detector = Object_Detector_Tool()
    detected_objects, object_number = detector.execute(image=img, labels=["door"], limit=1, save_object=True)
    
    # Count the doors that have a higher score than the threshold
    door_count = 0
    for obj in detected_objects:
        if obj["score"] > threshold:
            door_count += 1
    
    return door_count

