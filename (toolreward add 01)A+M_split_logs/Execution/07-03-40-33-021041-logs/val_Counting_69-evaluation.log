final_result = 5

# Step 1: Use the Letter_Detector_Tool to detect letters
results = Letter_Detector_Tool.execute(image='path/to/image.png')

# Count the number of detected letters
if results and 'letters' in results:
    num_letters = sum(1 for _, _, _, _ in results if 'letter' in results[0])
    final_result = num_letters

# Step 2: Check if there are common vowels (a, e, i, o, u)
common_vowels = {
    'a': 0,
    'e': 0,
    'i': 0,
    'o': 0,
    'u': 0
}

for letter in results:
    if letter and 'letter' in letter[0]:
        for l in letter[0]:
            if l.lower() in 'aeiou':
                common_vowels[l.lower()] += 1

# Step 3: Calculate the count of common vowels
common_vowel_count = sum(common_vowels.values())

if common_vowel_count > 0:
    final_result = 'B'
else:
    final_result = 'D'

final_result


