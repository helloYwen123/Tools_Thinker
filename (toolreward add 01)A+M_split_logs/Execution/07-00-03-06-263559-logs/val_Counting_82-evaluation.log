def count_people_in_water(image_path):
    """
    Counts the number of people in the water.
    """
    with open(image_path, 'rb') as f:
        image_as_bytes = f.read()

    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path)
    if 'basket' in detected_objects or 'baseball' in detected_objects:
        print(f"Number of people in the water: {(len(detected_objects ['basket']) + len(detected_objects  {'baseball'}))}")
        return

    for detected_target in detected_objects:
        detected_target_value = detected_objects[detected_target]
        letters = detected_target_value['box']
        detected_people_string = f"Detected {len(detected_target_value['bbox'])} people in the water"
        return detected_people_string

