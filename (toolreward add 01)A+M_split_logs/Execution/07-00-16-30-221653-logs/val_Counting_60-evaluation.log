def get_final_result():
    # Use the Object_Detector_Tool tool to detect sandwiches
    tool_args = {
        "tool_module_name": "object_detector",
        "tool_class_name": "Object_Detector_Tool",
        "tool_description": "Detect sandwiches in the image",
        "input_types": {"image": "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_60_image_1.jpg", "labels": ["sandwiches"], "threshold": 0.5, "model_size": "tiny", "save_object": True,
                       "saved_image_path": "/home/stud/wxie/BLINK_Dataset/Counting/val/images/saved_object"}
    }
    objects = []
    detected_objects = Tool().execute(**tool_args)

    # Count the total number of sandwiches
    sandwich_count = len(detected_objects)

    # Get the bounding box coordinates of the sandwiches
    sandwich_bboxs = []
    for obj in detected_objects:
        if 'sandwich' in obj['bbox']:
            bboxes = [(obj['bbox'][1], obj['bbox'][0], obj['bbox'][3], obj['bbox'][2])]
            sandwich_bboxs.append(bboxes)

    # Get the recognized text of the sandwiches
    sandwich_texts = []
    for obj in detected_objects:
        if 'sandwich' in obj['bbox']:
            bbox = obj['bbox']
            if bbox:
                texts = ["".join(detected_objects[bbox[2] + 1 : bbox[3]]) for detected_objects in sandwich_bboxs]
            else:
                texts = []
            sandwich_texts += [texts]

    final_result = (
        sandwich_count,
        sandwich_text,
        sandwich_bboxs
        if len(sandwich_bboxs) > 0
    )

    return final_result


