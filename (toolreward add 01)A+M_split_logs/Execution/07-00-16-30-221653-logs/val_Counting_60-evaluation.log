def classify_salad_and_get_number_of_recipes(labels, saved_image_path):
    # Check if the detection results are available
    if "baseball" in labels and "basket" in labels:
        baseball_number = len([det['box'] for det in labels if det['score'] >= 0.35 and det['text'] == 'Baseball'])
        basket_number = len([det['box'] for det in labels if det['score'] >= 0.35 and det['text'] == 'Basket'])
        print("Baseball:", baseball_number, "basket:", basket_number)
    else:
        print("Text not found in image.")
    return baseball_number, basket_number

