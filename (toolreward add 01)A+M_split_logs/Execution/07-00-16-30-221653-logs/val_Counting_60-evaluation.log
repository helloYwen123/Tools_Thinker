def count_dishes(bread_orders, sandwich_orders, counter):
    """
    Counts the total number of dishes in the image, excluding bread orders.
    :param bread_orders: List of dishes that were part of bread orders.
    :param sandwich_orders: List of dishes that were part of sandwich orders.
    :param counter: A counter object to sum up the dishes.
    :return: Total number of dishes in the image, including sandwich orders.
    """
    bread_counter = 0
    for order in bread_orders:
        if order == 'bread':
            bread_counter += 1
        elif order == 'sandwich':
            counter += 1
    return counter

