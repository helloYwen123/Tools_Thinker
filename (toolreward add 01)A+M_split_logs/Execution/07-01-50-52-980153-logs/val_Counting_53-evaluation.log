def calculate_wine_bottles_detected(image_path, wine_bottles_path_or_string):
    wine_bottles = []
    text = Text_Detector_Tool.execute(image=image_path, languages=['en'])
    
    for result in text:
        if 'basket' in result[2]:
            wine_bottles.append({'box': (result[0][0], result[0][1], result[0][2], result[0][3]),
                                 'score': result[1]})
    
    if wine_bottles:
        wine_bottles_count = len(wine_bottles)
    else:
        wine_bottles_count = 0

    return wine_bottles_count

