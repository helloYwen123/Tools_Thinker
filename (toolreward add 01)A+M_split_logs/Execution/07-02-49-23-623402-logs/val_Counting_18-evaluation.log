def count_fingers_in_bathtub(plate_image):
    import image_doctor

    # Load image
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_18_image_1.jpg'
    image = image_doctor.doctor_tool(image_url=plate_image, allow_video=True)
    
    with image_doctor.image_doctor(image_path, image=image) as img, image.image_doctor(img):
        # Detect fingers in the image
        detection_result = image_letter_detector(image_doctor=instance.Doctor(img.get("rgb")), save_path=None)
        if detection_result:
            # Count fingers
            image_result = img.get("fg")
            letter_boxes = []
            for _, letter, score in detection_result[2]:
                letter_boxes.append((letter_box["bbox"], letter, score) for letter_box in letter_boxes if letter_box["bbox"][2] >= letter_box["bbox"][3])
            detected_fingers = [box for _, letter, score in (letter_boxes for letter_box in detected_fingers for detected_finger in letter_boxes if letter_box["bbox"][2][3] < detected_finger["bbox"][3])]

            if detected_fingers:
                fingers_found = len(detected_fingers)
            else:
                fingers_found = 0
            # Calculate the number of fingers in front of the bathtub
            fingers_in_bathtub = fingers_found // 4 if fingers_found >= 4 else 2
    return fingers_in_bathtub

