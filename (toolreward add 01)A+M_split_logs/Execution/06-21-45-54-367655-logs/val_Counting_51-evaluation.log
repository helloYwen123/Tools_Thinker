def detect_hotdogs(image_path):
    # Load the image
    image = Image.open(image_path)
    
    # Load the detection tool
    detection_tool = detection_tool_from_module(tool_module_name='object_detector', tool_class_name='Object_Detector_Tool')
    
    # Execute the detection
    detected_objects, object_number = detection_tool.execute(image=image, labels=["ketchup", "mustard"], save_object=True, saved_image_path="detected_objects")
    
    # Return the count of people
    return object_number

