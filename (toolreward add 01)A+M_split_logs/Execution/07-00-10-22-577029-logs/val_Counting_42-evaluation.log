def count_flower_pots(image_path=None):
    if not image_path:
        image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_42_image_1.jpg"

    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=["plastic_plant_pot"], save_object=True, saved_image_path="detected_objects")

    if detected_objects and "baseball" in detected_objects:
        baseball_boxes = detected_objects["baseball"]
        baseball_score = detected_objects["baseball"][0]["score"]
        num_baseballs = sum(1 for box in baseball_boxes if "baseball" in box["bbox"][0])

    if detected_objects and "basket" in detected_objects:
        basket_boxes = detected_objects["basket"]
        basket_score = detected_objects["basket"][0]["score"]
        num_baskets = sum(1 for box in basket_boxes if "basket" in box["bbox"][0])

    return num_baseballs, num_baskets

final_result = count_flower_pots()
print("Total flower pots:", final_result)

if final_result[0] > 1 and final_result[1] > 2:
    flower_pot_count = "B"
elif final_result[0] > 2 and final_result[1] > 1:
