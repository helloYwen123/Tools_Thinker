def count_people_in_red_shirt(img_path):
    with object_detector_tool(path_to_image=img_path):
        detected_objects = Object_Detector_Tool.execute(input_types={'image': img_path, 'labels': ['red shirt'], 'saved_image_path': 'detected_objects', 'threshold': 0.5, 'model_size': 'tiny'})
        total_objects = len(detected_objects)
        
        if total_objects == 1:
            return ('B', f'{total_objects} person in red shirt')
        else:
            return ('A', total_objects)

final_result = count_people_in_red_shirt('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_8_image_1.jpg')
print(final_result)


