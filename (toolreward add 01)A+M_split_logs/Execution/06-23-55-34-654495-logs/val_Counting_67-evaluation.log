from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool

def count_white_umbrellas(object_list):
    total_white_umbrellas = 0
    for item in object_list:
        for value in item.values():
            if value[2] == 0.65:  # Assuming the score threshold
                total_white_umbrellas += value[4]
    return total_white_umbrellas

