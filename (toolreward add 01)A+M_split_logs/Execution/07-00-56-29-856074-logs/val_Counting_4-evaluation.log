def get_people_count(image_path, obj_labels):
    with Object_Detector_Tool(image_path, labels=obj_labels, save_object=True, saved_image_path="detected_objects") as tool:
        detected_objects = tool.execute()
        object_number = len(detected_objects)
        return object_number

people_present = get_people_count('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_4_image_1.jpg', ['old_female'])
final_result = 'The image may have less than 3 people in total. '
if people_present >= 3:
    final_result += f"There are {people_present} people in the image."
else:
    final_result += f"There are {people_present} people in the image, but no more than 3 people."

print(final_result)


