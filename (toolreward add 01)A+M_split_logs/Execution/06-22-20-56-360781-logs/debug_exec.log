import re

def find_ski_skier(image_path):
    with open(image_path, 'rt', encoding='utf-8') as image_file:
        lines = image_file.readlines()
    lines = [l.split() for l in lines]

    detected_objects = [obj for obj in lines if obj[1] in ["baseball","basket"]]

    total_count = []
    for obj in detected_objects:
        for x, y, w, h in obj[-1].split()[1:]:
            (left, top, right, bottom) = re.findall(r"\d+", f"(.*?(\s|[a-zA-Z])*)(\d+)x(\d+)y(\d+)h(\d+)")
            total_count.append(f'total_count : {total_count[1]}')
            x, y = int(x), int(y)
            left = x + int(l)
            top = y + 1

            width = int(w[1:3])
            height = int(w[3:])
            top = top + 2
            bottom = top - 1
            if bottom > len(lines):
                bottom = len(lines)
            left = left + 1
            right = left + width
            if right > len(lines):
                right = len(lines)

            width = left - right + 1
            height = bottom - top + 1

            x, y, width, height = map(int, [x, y, width, height])

            if height + top - 1 > len(lines):
                height = len(lines) - top + 1
                top = top + height - 1

            x += int(l)
            y += 1

            top = top + height
            bottom = top + height - 1

            if bottom < 0:
                bottom = 0
            row = []

            for (x1, y1, x2, y2) in lines[top:bottom+1]:
                if x1 <= x <= x2:
                    if y1 == y:

                        row.append((left, top, width, y))
                        width = x2 - x1
                        height = max(height, y2 - y1) - top + 1
                        break
                width = x2 - x1

            for (x, y) in row:
                row.append((left, top, width, y))

        if detected_objects:
            with open(image_path, 'at', encoding='utf-8') as image_file:
                lines = lines + [(obj[0], *obj[1:])
        else:
            with open(image_path, 'at', encoding='utf-8') as image_file:
                lines[:] = []

    if total_count:
        return {"count": total_count[0][0], "label": total_count[0][1], "score": total_count[0][2]}
    else:
        return dict()

