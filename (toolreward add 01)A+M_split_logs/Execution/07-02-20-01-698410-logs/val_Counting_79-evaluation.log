def calculate_consonant_count(image_path):
    # Load the image
    image = np.array(Image.open(image_path))

    # Detect text in the image
    results = Text_Detector_Tool.execute(image, languages=['en', 'de'])

    # Initialize counters for consonant and all letters
    consonant_count = 0
    total_letters_count = 0

    # Extract the bounding boxes, words, and scores from the detected text
    detected_words = [det[1] for det in results if det[2] == 'char']

    # Calculate the number of consonants in the detected words
    for word in detected_words:
        letter_count = 0
        for char in word:
            letter_count += letter_detector.Letter_Detector_Tool(image=char)
        consonant_count += letter_count

    # Calculate the total number of letters detected
    total_letters_count = len(results) + len(detected_words)

    # Calculate the number of consonants per letter and record the result
    letter_consonant_counts = {c: 1 for c in detected_words}
    total_letters = len(results) + len(detected_words)
    letter_consonant_counts = {k: v / total_letters for k, v in letter_consonant_counts.items()}

    return consonant_count, total_letters_count, letter_consonant_counts

# Example usage
consonant_count, total_letters_count, letter_consonant_counts = calculate_consonant_count('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_79_image_1.jpg')
final_result = max(letter_consonant_counts, key=letter_consonant_counts.get)
print(final_result)
