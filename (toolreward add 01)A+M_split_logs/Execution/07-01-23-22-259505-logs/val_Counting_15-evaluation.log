def detect_people(image_path):
    # Load the image
    image = Image.open(image_path)
    
    # Define the model and other parameters
    model = model_path
    threshold = 0.35
    save_images = True
    
    # Use the text detector tool
    text_results = text_detector.execute(image=image, languages=['eng', 'de'], detail=1)
    
    # Use the letter detector tool to detect people
    letter_results = letter_detector.execute(image=image)
    
    # Extract detected people from the text and letter results
    people_results = []
    for text_result in text_results:
        people_results.extend(text_result[3])
    
    # Filter out people that are not wearing glasses
    filtered_results = [result for result in people_results if "glasses" in result[1]]
    
    # Return the number of people wearing glasses
    return len(filtered_results)

