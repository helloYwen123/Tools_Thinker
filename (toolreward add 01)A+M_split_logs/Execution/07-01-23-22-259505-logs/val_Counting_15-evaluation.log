# Import necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Path to image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_15_image_1.jpg"

# Detect glasses in the image
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=["glasses"], save_object=True, saved_image_path="detected_objects")

final_result = []
for _, labels, _ in object_number.items():
    for label in labels:
        # Detect text in each detected object
        text_detector = Text_Detector_Tool()
        result = text_detector.execute(image=image_path, languages=["en", "de"], detail=1)

        # Collect detected letters
        if len(result) > 0:
            letter_detector = Letter_Detector_Tool()
            detected_letters = letter_detector.execute(image=image_path)

            # Count detected letters that are glasses
            for detected_letter in detected_letters:
                detected_letter["glasses"] = 1

            final_result.append(detected_letter)
        else:
            final_result.append(None)

# Example output (as a list of dictionaries): [{"glasses": 1, "text": "I have glasses.", "score": 0.97}, ...]
final_result


