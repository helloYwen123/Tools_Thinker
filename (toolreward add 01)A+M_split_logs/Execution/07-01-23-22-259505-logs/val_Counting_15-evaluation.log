def count_people_with_glasses(image_path):
    detector = Letter_Detector_Tool()
    result = detector.execute(image=image_path)
    
    total_people_glasses = {label: count for count, (bbox, letter, score) in result.items() if letter == "glasses"}
    
    if total_people_glasses:
        return total_people_glasses
    else:
        return 0

