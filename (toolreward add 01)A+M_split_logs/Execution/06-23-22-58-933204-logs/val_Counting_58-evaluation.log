def detect_images(image_path, languages, detail):
    # Load image
    img = image_tool.load_image(image_path)
    
    # Detect text in the image
    results = text_detector.detect_text(img, languages=languages, detail=detail)
    
    return results

# Function to count the drive wheels on the train
def count_wheels(deets):
    # Extract the drive wheel bounding box from each deetcted text block
    drive_wheel_bbox = [d[2] for d in deets if re.match(r"drive wheel", d[1])]
    
    # Convert the number of bounding boxes to integer
    count_wheels = len(drive_wheel_bbox)
    
    return count_wheels

# Load image
