from torch.utils.data import Dataset

def find_number_of_wheels(engine):
	if engine.rpm > 0:
		# Engine speed is greater than 0, therefore
		# the train appears to be moving
		return 4

	elif engine.rpm < 0:
		# Engine speed is less than 0, therefore
		# the train appears to be still
		return 1

	else:
		# Engine speed is exactly 0, therefore
