from object_detector import Object_Detector_Tool, Letter_Detector_Tool

# Load the toolkit and set up for image detection
tool = Object_Detector_Tool()
labels = ['baseball', 'basket']
tool.confidence_threshold = 0.2
tool.model_name = 'tiny'
tool.save_object = True

# Execute image detection
detected_objects, object_number = tool.execute(image="path/to/image.jpg", labels=labels)

final_result = object_number['baseball'] + object_number['basket']
print(final_result)


