def count_objects(filename):
    try:
        # 使用Object_Detector_Tool检测图像中的文字
        detected_objects = Object_Detector_Tool.execute(image=filename, languages=['en', 'de'],
                                                        detail=1)
        
        # 检查是否检测到至少一个单词
