def find_people_with_red_coat(image_path):
    label_list = ['red coat']
    import module_name: Object_Detector_Tool, import_name: Text_Detector_Tool
    tool = Object_Detector_Tool()
    tool_parameters = {"input_types": {'image': "img.jpg", 'labels': label_list, 'threshold': 0.2, 'model_size': 'tiny', 'save_object': True, 'saved_image_path': "detected_objects"}, "output_types": "{ (1) a dict mapping each label to a list of detection entries, e.g. {'baseball': [{'box': (x1, y1, x2, y2), 'score': 0.95, 'saved_image_path': 'path/to/saved/image.png'}]}, (2) a dict mapping each label to the number of detected objects in the image."}
    tool.execute()
    if tool_output["detected_objects"]:
        object_label = tool_output["detected_objects"][label_list[0]]["bbox"]
        object_score = tool_output["detected_objects"][label_list[0]]["score"]
        total_object_count = len(tool_output["detected_objects"])
        return {"result1": total_object_count, "result2": object_label}
    else:
        return {"result": 0}  # This is in case the image cannot be converted to text

