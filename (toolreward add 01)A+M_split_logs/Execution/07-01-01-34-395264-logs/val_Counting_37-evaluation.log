from object_detector import Object_Detector_Tool

# Function to check how many people are wearing a white uniform
def count_white_uniforms(image_paths):
    num_white_uniforms = 0
    for image_path in image_paths:
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=["white_uniform"], save_object=True, saved_image_path="detected_objects")

        if len(detected_objects) != 0:
            object_number = {}
            for detected_object in detected_objects:
                label = detected_object["label"]
                object_number[label] = object_number.get(label, 0) + 1

        if "baseball" in object_number and "basket" not in object_number:
            num_white_uniforms += 1

    return num_white_uniforms

# Example usage
image_paths = [
    "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_37_image_1.jpg"
]
final_result = count_white_uniforms(image_paths)

print(final_result)  # Expected output: 1


