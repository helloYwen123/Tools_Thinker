from letter_detector import Letter_Detector_Tool

# Load the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_6_image_1.jpg"

# Set the language to Simplified Chinese
languages = ["ch_sim"]

# Set the level of detail to 1
level_of_detail = 1

# Execute the letter detector tool
results = Letter_Detector_Tool.execute(image=image_path, languages=languages, level_of_detail=level_of_detail)

# Extract the detected letters from the results
all_letters = [letter[2] for results in results for letter in results[0]]

# Count the detected letters
letter_count = len(all_letters)

# Display the letter count
final_result = f"If there are 4 big nuts in the green bowl, there are {letter_count} big letters that the letter detector is able to recognize."


