def count_blue_circles(image_path):
    from object_detector import Object_Detector_Tool
    image = Image.open(image_path)
    
    object_detector = Object_Detector_Tool()
    detected_objects_result = object_detector.execute(image=image, labels=["blue"], save_object=True, saved_image_path="detected_objects")
    object_number = {i["label"]["key"]: i["total"]["count"] for i in detected_objects_result["object_number"]}

    results = []
    for block in object_detector["detected_blocks"]:
        block = Block(block)
        results.append(block.text)

    return {"numbers_of_blue_circles_circles": object_number.get("blue", 0), "text_results": results}

final_result = count_blue_circles("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_46_image_1.jpg")
print(final_result)


