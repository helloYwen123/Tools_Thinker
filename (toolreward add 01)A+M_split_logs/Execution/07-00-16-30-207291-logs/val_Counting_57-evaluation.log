from letter_detector import Letter_Detector_Tool

final_result = []
letter_count = 0
for image in ["val_Counting_57_image_1.jpg", "val_Counting_57_image_2.jpg", "val_Counting_57_image_3.jpg"]:
    letters = Letter_Detector_Tool.execute(image=image)
    for letter in letters:
        if letter["score"] > 0.3:
            final_result.append([[int(x) for x in letter["bbx"]], letter["letter"], letter["score"]])
            letter_count += 1

final_result


