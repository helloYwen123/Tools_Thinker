def count_wooden_beams(path_to_image):
    # Load the image and apply the letter detector tool to detect the number of wooden beams
    detected_results = Letter_Detector_Tool.execute(image=path_to_image)

    # Check if any wooden beams were detected
    if len(detected_results[0]) > 0:
        # Initialize counters
        wooden_beam_count = {}

        for result in detected_results:
            # Check if the bounding box coordinates are within the range of wooden beams
            if 'baseball' in result[0] and 'basket' not in result[0] and 'crossbar' not in result[0]:
                bounding_box = result[0]
                wooden_beam_count[bounding_box[0] - 30:bounding_box[1] + 50] = "counted"

        # Calculate the total number of wooden beams
        total_count = len(wooden_beam_count)

        return total_count
    else:
        return 0
