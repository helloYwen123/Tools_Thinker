from object_detector import Object_Detector_Tool


def calculate_tiled_count(image_path, tile_size=2):
    detected_images = []
    total_detected_objects = 0

    objects = Object_Detector_Tool.execute(image=image_path, labels=[('tile',)],
                                           threshold=0.35,
                                           model_size="tiny", save_object=True,
                                           saved_image_path="temp_images")

    for label in set(objects):
        for detected_object in objects[label]:
            detected_images.append((detected_object['bbox'], "Tile", detected_object['score']))
            total_detected_objects += detected_object['score']

    max_confidence_score = max([img[2] for img in detected_images])[2]

    filtered_images = [img for img in detected_images if img[2] > max_confidence_score]

    if len(filtered_images) > 0:
        max_confidence_score = max([img[2] for img in filtered_images])[2]
        filtered_detected_images = [img for img in filtered_images if img[2] == max_confidence_score]
        total_detected_objects -= filtered_objects = [sorted_obj for img in filtered_detected_images for sorted_obj in img['bbox']][0:2]
        filtered_detected_images = [sorted_obj for img in filtered_detected_images for sorted_obj in img['bbox']][0:2]
    else:
        filtered_detected_images = [sorted_obj for img in filtered_detected_images for sorted_obj in img['bbox']]

    objects = {"tiles": {}}
    for img in filtered_detected_images:
        x1, y1, x2, y2 = img
        objects["tiles"][int(x1 // tile_size)] = (x1, y1, x2, y2)

    final_result = {
      'tiles': objects,
      'tiles_count': total_detected_objects < 1e-5
    }

    return final_result


