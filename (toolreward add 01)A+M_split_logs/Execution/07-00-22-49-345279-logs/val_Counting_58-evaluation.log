from letter_detector import Letter_Detector_Tool

# Load the image (replace 'path/to/image.png' with the actual image path)
results = Letter_Detector_Tool.execute(image='path/to/image.png')

# Extract the detected letter list using [bbx, letter, and score]
final_result = [list(map(tuple, bbox)) for bbox in results]

# Extract the corresponding coordinates, text, and score for each detected letter in the list
final_result = list(map(lambda bbox: tuple(map(int, bbox))), final_result)

print(final_result)


