def get_people_count(image_path):
    detector = Letter_Detector_Tool()
    try:
        detected_letters = detector.execute(image_path)
        if len(detected_letters) > 0:
            detected_letters = [detected_letter for detected_letter in detected_letters if 'person' in detected_letter[3]]
            if len(detected_letters) > 0:
                return len(detected_letters)
            else:
                return 0
        else:
            return 0
    except:
        return 0

final_result = get_people_count('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_78_image_1.jpg')
