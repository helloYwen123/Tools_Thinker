    detected_objects = Object_Detector_Tool().execute(image=image_path, labels=["trunk"], threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects")
    count_trunks = len(detected_objects['trunk'])
    return count_trunks

def count_trunks_right(image_path):
    detected_objects = Object_Detector_Tool().execute(image=image_path, labels=["trunk"], threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects")
