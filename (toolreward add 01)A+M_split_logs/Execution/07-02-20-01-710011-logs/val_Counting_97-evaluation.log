import os
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg'
labels = ['baseball', 'basket']
save_object = True
saved_image_path = 'detected_objects'
object_number = {}
total_number = 0
failed = False

def get_object_image(image_file, labels, object_number, object_number_output):
    try:
        image = Image.open(image_file)
        detections = object_detector( image=image, labels=labels)
        for obj in detections:
            key = f'{obj["image"]} {obj["bbox"]} {obj["score"]}'
            object_number[key] = object_number.get(key, 0) + 1
            if save_object:
                im_pil = image.crop((obj['bbox'][0], obj['bbox'][1], obj['bbox'][0] + obj['bbox'][2], obj['bbox'][1] + obj['bbox'][3]))
                im_pil.save(os.path.join(saved_image_path, f'saved_object_{total_number}_{key}.jpg'), "JPEG", quality=90)
    except Exception as e:
        if failed == False:
            print('Failed to load image with error', e)
            failed = True
        return None

    total_number += 1

def get_text(image_file):
    image = Image.open(image_file)
    if image.mode != 'RGB' or len(image.split()) != 3:
        return
    texts = extract_text(image)
    return texts

def letter_detector(image_file):
    detection_result = letter_detector(image=image_file)
    return detection_result

# Step 1: Detect the Object using object_detector tool
object_result = object_detector(image=path, labels=labels, save_object=True, saved_image_path=saved_image_path)

# Step 2: Detect the Text using text_detector tool
text_result = text_detector(image=image, languages=['en', 'de'], detail=1)
if text_result is None:
    print('Failed to detect text in image')
text_list = text_result[0]
letters = ''
for line in text_list:
    for bbx in line[1]:
        letters += bbx[0] + ' '
letter_list = ''
for letter in letters.split():
    letter_list += letter + ' '
letter_result = letter_detector(image=path)
if letter_result is None:
    print('Failed to detect letters in image')
letter_list = letter_result[1]
labels = []
scores = []
for text in text_list:
    labels.append(text[0])
    scores.append(text[1])

# Step 3: Count the number of detect objects/letters using object_detector tool
total_number_detect_objects = object_number.pop('count_objects')
total_number_detect_letters = object_number.pop('count_letters')

# Step 4: Concatenate the results using the final_result variable
final_result = {'object_result': object_result, 'text_result': text_result, 'letter_result': letter_result, 'total_number': {'detect_objects': total_number_detect_objects, 'detect_letters': total_number_detect_letters}, 'text_list': text_list, 'letter_list': letter_list}

# Update the object_number dict with new counts
final_result['object_number'] = object_number
print(final_result)


