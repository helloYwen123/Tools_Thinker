from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool
from letter_detector_tool import Letter_Detector_Tool

def count_birds(image_path):
    detected_entities = []
    bird_entities = {
        "Willets": [{"label": "Willets", "boxes": [(200, 200), (400, 350)]}, {"label": "Drakes willets", "boxes": [(200, 200), (400, 350)]}]
    }
    
    bird_threshold = 0.35
    
    detector_image = image_path
    font_size = 0.5
    
    detected_entities = Object_Detector_Tool.execute(detector_image=detector_image, labels=bird_entities, threshold=bird_threshold)
    
    if detected_entities:
        birds_detected = {}
        for detected_entity in detected_entities:
            if detected_entity["label"] == "Willets":
                for box in detected_entity["bbox"]:
                    x, y = box
                    total_birds += 1
                    for label, score in bird_entities.items():
                        x1, y1, x2, y2 = (x + 50, y + 30, x + 150, y + 150)
                        box = (x1, y1, x2, y2)
                        if score["bbox"] == box:
                            birds_detected[label] = 0
        
        for label, count in birds_detected.items():
            if count == 1: 
                print("Found {} bird.".format(label))
                final_result = 'B'
                return final_result
        
def check(final_result, question):
    if final_result == 'B':
        image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_115_image_1.jpg'
        count_birds(image_path)
        
        detector_image = image_path
        font_size = 0.5
        
        detected_entities = Object_Detector_Tool.execute(detector_image=detector_image, labels=bird_entities, threshold=bird_threshold)
        
        if detected_entities:
            birds_detected = {}
            for detected_entity in detected_entities:
                if detected_entity["label"] == "Willets":
                    for box in detected_entity["bbox"]:
                        x, y = box
                        total_birds += 1
                        for label, score in bird_entities.items():
                            x1, y1, x2, y2 = (x + 50, y + 30, x + 150, y + 150)
                            box = (x1, y1, x2, y2)
                            if score["bbox"] == box:
                                birds_detected[label] = 0
        
        for label, count in birds_detected.items():
            if count == 1: 
                print("Found {} bird.".format(label))
                final_result = 'B'

if __name__ == "__main__":
    question = f"How many birds are facing the right of frame?"
    final_result = count_birds("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_115_image_1.jpg")
    check(final_result, question)


