from letter_detector import Letter_Detector_Tool

# Load the image data and apply the letter detection tool
results = Letter_Detector_Tool.execute(image='val_Counting_99_image_1.jpg')

# Extract the detected text and confidence score for each letter
results_text_confidence = {}
for result in results:
    result_text = result[2]
    result_confidence = result[1]
    if result_text:
        results_text_confidence[result_text] = result_confidence

# Analyze the text results
text_results = {k: v for k, v in results_text_confidence.items() if k in ["baseball", "basket"]}
letter_count = {}
for text, confidence in text_results.items():
    for bbbox, letter in text_results.items():
        if bbbox in results_text_confidence[letter] and bbbox != text:
            if results_text_confidence[letter][bboxbox][0] < confidence:
                results_text_confidence[letter][bboxbox] = [bboxbox, letter, confidence]

# Count the number of people in the red car front of the train
people_count = 0
for detections in results_text_confidence.values():
    for detection in detections:
        letter = detection[2]
        if letter == 'red':
            people_count += 1

final_result = "People present in the red car front of the train are Countings Number {}".format(people_count)


