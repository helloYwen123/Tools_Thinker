def analyze_image(image_path):
    # Use Text_Detector_Tool to find text
    text_results = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])
    for text_result in text_results if text_result else []:
        final_result = 1

    # Use Letter_Detector_Tool to find letter
    letter_results = Letter_Detector_Tool.execute(image=image_path)
    unique_letters = list(set([det[1] for det in letter_results if det[1] not in {'', ' '}] if det[1] else ''))
    if unique_letters:
        final_result = 1

        for letter in unique_letters:
            for result in text_results:
                text_result = result[0]
                if str(letter) in [str(x[1]) for x in result[0]]:
                    final_result = 1

    return final_result

