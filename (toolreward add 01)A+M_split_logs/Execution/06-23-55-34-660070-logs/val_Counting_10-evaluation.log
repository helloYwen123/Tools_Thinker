from letter_detector import Letter_Detector_Tool

# The path to the image file
path_to_image = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_10_image_1.jpg'

try:
    # Execute letter detection on the image
    results = Letter_Detector_Tool.execute(image='path/to/image.png')

    # Check if enough attempts were made, otherwise detect the text
    if len(results) == 0:
        results = Text_Detector_Tool.execute(image='path/to/image.png')

        # Extract the detected text
        text = [t[1] for t in results]
        conf_scores = [t[2] for t in results]

        # Final result
        final_result = ""
        for i in range(len(text)):
            if i == len(text) - 1:
                final_result += text[i]
            else:
                final_result += text[i] + ","
        final_result = final_result[:-1].replace(',', "")

        # Display results
        print(f"Detected text: {final_result} with confidence score: {conf_scores[-1] * 100:.2f}%")
except Exception as e:
    print(f"Error: {e}")
finally:
    if path_to_image:
        os.remove(path_to_image)


