from text_detector import Text_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_59_image_1.jpg"

# Call the text_detection function with the necessary parameters
result = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])

# Check if text detection was successful
if not result:
    final_result = "Failed"
    print("Failed to detect text in the image.")
else:
    # Extract the text information and determine the number of people wearing white hats
    detected_text = result[0]
    white_hat_count = detected_text[0][1].split()[1]

    # Assign the final result based on the text detection count
    if white_hat_count > 0:
        final_result = "Person with white hat: " + str(white_hat_count)
    else:
        final_result = "No people with white hat detected."

print(final_result)


