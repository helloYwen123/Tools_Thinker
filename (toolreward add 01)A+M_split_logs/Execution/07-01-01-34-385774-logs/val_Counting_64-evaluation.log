import os
import glob
import numpy as np
from object_detector import Object_Detector_Tool

# Find all files matching the pattern "val_Counting_64_image_*.jpg"
files = glob.glob('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_64_image_*.jpg')

# Detect objects in all images
tool = Object_Detector_Tool()
for file in files:
    det_dict = tool.execute(image=os.path.join(file), labels=['baseball', 'basket'], save_object=False)
    detected_objects = det_dict['object_number']

    # Filter detected objects
    filtered_objects = [det for det in detected_objects.values() if any(b'baseball' in i for i in det)]
    
    # Display the detection results
    print(f"Detections for file: {os.path.basename(file)}")
    print(detected_objects)
    print(filtered_objects)
    print()
