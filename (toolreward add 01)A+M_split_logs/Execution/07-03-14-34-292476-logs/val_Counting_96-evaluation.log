def count_sinking_bowls(image_path):
    detected_objects = Object_Detector_Tool.execute(image_path=image_path, labels=["sinking boats"], threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects")
    if "sinking boats" in detected_objects:
        num_bowls = detected_objects["sinking boats"][0]["score"]
        return f"{num_bowls}"
    else:
        return "0"

final_result = count_sinking_bowls("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_96_image_1.jpg")
print(f"The number of sinking boats is: {final_result}")


