final_result = ""
with Object_Detector_Tool() as object_detector:
    with Text_Detector_Tool() as text_detector:
        with Letter_Detector_Tool() as letter_detector:
            image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_96_image_1.jpg"
            try:
                object_list = object_detector.execute(image=image_path, languages=["en", "de"])
                try:
                    text_list = text_detector.execute(image=image_path)
                except ValueError:
                    text_list = []
                letters = letter_detector.execute(image=image_path)
                final_result = f"{len(object_list)}\n{len(text_list)}\n{len(letters)}"
                final_result = " ".join(final_result.split())
print(final_result)


