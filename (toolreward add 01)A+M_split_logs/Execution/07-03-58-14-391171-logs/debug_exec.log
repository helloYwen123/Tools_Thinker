def detect_objects(image_path: str, labels: List[str], save_object:bool=True, saved_image_path: str=None) -> Tuple[List[Dict], int]:
    # Load the image using OpenCV
    img = cv2.imread(image_path)

    # Detect objects using the text detector tool
    result = Text_Detector_Tool.execute(image=f"{' ' * 100}{' '.join(labels)}", languages=["en", "de"])

    # Convert the results to a list of dictionaries with bounding box coords, detected texts and scores
    result_list = []
