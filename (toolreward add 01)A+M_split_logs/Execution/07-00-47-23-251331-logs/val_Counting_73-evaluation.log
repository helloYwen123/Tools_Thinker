def count_elephants(image_path):
    detector_tool = Object_Detector_Tool()

    label_list = ['elephant']
    threshold = 0.35
    model_size = 'tiny'
    save_object = True
    
    if detector_tool.execute(image_path, labels=label_list, save_object=save_object, threshold=threshold, model_size=model_size) != 'false':
        detected_objects, object_number = detector_tool.output()

        if save_object:
            for label, result in detected_objects.items():
                print(f"{label} : {len(result)}")
        
        if object_number['elephant'] in (1, 2):
            final_result = object_number['elephant']
        else:
            final_result = None
    else:
        final_result = None

    return final_result

image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg'
elephants_in_water = count_elephants(image_path)
print("Number of elephants in the water:", elephants_in_water)


