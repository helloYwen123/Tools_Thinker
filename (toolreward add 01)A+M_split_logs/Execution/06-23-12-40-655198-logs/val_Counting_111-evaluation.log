from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Load image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_111_image_1.jpg"
object_detector = Object_Detector_Tool()
labels = ['sheep', 'wall']
save_object = False
threshold = 0.35
model_size = 'tiny'
saved_image_path = "detected_objects"

# Detect objects
detected_objects, object_number = object_detector.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)

# Detect text
text_deetector = Text_Detector_Tool()
languages = ['en', 'de']
detail = 1
result = text_deetector.execute(image=image_path, languages=languages, detail=detail)

# Detect letters
letter_detector = Letter_Detector_Tool()
results = letter_detector.execute(image=image_path)

# Count objects
sheep_count = sum([1 for _, label, _ in detected_objects if label == "sheep"])
final_result = {
    'sheep': sheep_count
}

# Print results
print(final_result)


