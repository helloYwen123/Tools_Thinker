    text_objects = pytesseract.image_to_string(image, font=font).split()
    for text in text_objects:
        # Check if the text starts with a lowercase letter
        if text[0].islower():
            objects.append((tuple(image.convert("P").crop((int(text[0]), int(text[1]), int(text[2]), int(text[3]))).size()), text[1], float(text[2]-text[0]+1)))

    # Count objects
    stop_sign_count = len([bbox for bbox in objects if 'STOP' in text])  # count objects with stop sign
    sunset_trail_sign_count = len([bbox for bbox in objects if 'SUNSET' in text])  # count objects with sunset trail

