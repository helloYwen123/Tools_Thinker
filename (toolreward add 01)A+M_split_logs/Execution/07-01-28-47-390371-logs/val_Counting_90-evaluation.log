def count_number_of_signs(image_path, language='en'):
    import object_detector as od
    import text_detector as td
    import letter_detector as ld

    # Load the image
    image = Image.open(image_path)

    # Detect street signs
    street_signs = od.execute(image=image, languages=language)

    # Detect text in the sign
    text_blocks = td.execute(image=image, languages=['en', 'de'])

    # Detect letters in the text
    filtered_letters = ld.execute(image=image)

    # Count the number of street signs with text found
    count = 0
    for street_sign in street_signs:
        if len(text_blocks[street_sign['label']]) > 0:
            x, y, w, h = street_sign['bbox']
            bbbx = [x, y, x+w, y+h]
            letter_blocks = filtered_letters[street_sign['label']][i] for i in range(len(filtered_letters[street_sign['label']]))
            letter_blocks = [(x, y, len(letter_blocks[i][0]), len(letter_blocks[i][1])) for i in range(len(letter_blocks))]
            if bbbx[-1] >= 0:
                # Calculate the difference between the top of the sign and the top of the detected text
                sign_top = image.subpix(0, image.size[1]-50)
                if sign_top.overlaps(bbvx):
                    score = letter_blocks[i][1] - letter_blocks[i-1][1] + 1
                else:
                    score = 0
                count += 1
    return count

# Check the code with provided data points
