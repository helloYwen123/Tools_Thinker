import os
import numpy as np
import cv2

# Load the image
img_path = 'path/to/image.png'
img = cv2.imread(img_path)
# Detect objects
objects = Object_Detector_Tool.execute(image=img, labels=["baseball", "basket"], save_object=True, saved_image_path='')
# Extract text and letters
results = Letter_Detector_Tool.execute(image=img)
# Process detected objects and letters
final_result = []
for obj in objects:
    if 'basket' in obj['text']:
        for letter in results:
            if letter['text'] == 'basket':
                final_result.append([obj['bbox'], letter['text'], obj['score']])
        continue
    result = [[obj['bbox'], obj['text'], obj['score']] for obj in results if obj['text'] == 'baseball']
    if result:
        final_result.append(result[-1])
for result in final_result:
    if result:
        final_result[-1].insert(3, result[-1][-2:])
final_result = np.array(final_result)

# Print the final result
print(final_result)


