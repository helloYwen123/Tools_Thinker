def count_fingers(image_path):
    # Load the image
    image = Image.open(image_path)
    
    # Detect the fingers
    hands = HandHandsDetector(object_detection=True)
    hands_result = hands.detect(image)
    
    # Count the fingers
    total_fingers = 0
    for hands_result in hands_result:
        total_fingers = total_fingers + max(0, len(hands_result[2]) - len(hands_result[1]))
    
    final_result = min([f'{} fingers'.format(total_fingers), f'{total_fingers} fingers', f'{total_fingers} digits', f'{total_fingers} finger', 'no digits'], key=len)
    return final_result

# Path of the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_18_image_1.jpg'

# Calculate the number of fingers
count_fingers(image_path)


