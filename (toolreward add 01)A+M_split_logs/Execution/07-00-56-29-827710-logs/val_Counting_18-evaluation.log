from object_detector import Object_Decetector_Tool

def count_fingers():
    # Convert image path to PIL format
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_18_image_1.jpg'
    
    object_detector = Object_Decetector_Tool(image=image_path, labels=["finger"], threshold=0.35, model_size="tiny", save_object=True, saved_image_path='detected_objects')

    detected_objects = object_detector.execute()

    finger_count = {detected_labels[1]["name"] : detected_objects[detected_labels[1]["name"]][0] for detected_labels in detected_objects.values()}

    print(f"Number of fingers detected in the image: {list(finger_count.values())[0]['score']}")
    
    final_result = 'Number of fingers detected in the image'
return final_result


