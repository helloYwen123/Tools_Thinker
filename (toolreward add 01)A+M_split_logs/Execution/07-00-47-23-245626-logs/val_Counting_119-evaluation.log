def count_people(path):
    from tool_module_name import execute_tool
    tool_result = execute_tool(tool_module_name="object_detector", tool_class_name="Object_Detector_Tool", tool_description="Detect people in an image using the Grounding DINO model, return a dictionary with 'id' and 'name' keys.", tool_version='1.0.0', input_types={"image": path, "labels": ["women"], "threshold": 0.35, "model_size": 'tiny'}, output_types={"detected_objects": "dictp", "object_number": "dictp"})
    # count people wearing yellow shirt
    if "women" in tool_result["detected_objects"][0]["bbox"]:
        if tool_result["detected_objects"][0]["bbox"][0] < 100 and tool_result["detected_objects"][0]["bbox"][2] > 70 and tool_result["detected_objects"][0]["bbox"][1] < 60 and tool_result["detected_objects"][0]["bbox"][2] > 400:
            final_result = "A"
        else:
            final_result = "C"
    return final_result

