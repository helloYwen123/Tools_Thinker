from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image="path/to/table_img.jpg", labels=["sun"], save_object=True)

detected_objects = final_result[0]

if detected_objects.get('sun'):
    table_area = detected_objects['sun'][0].get('box')
    for bounding_box in table_area:
        if bounding_box.get('x') + bounding_box.get('y') < 200 or bounding_box.get('x') + bounding_box.get('y') + 100 > 350:
            print("Green frogs:", (200 + bounding_box.get('x')) ** 2 + (350 - bounding_box.get('y')) ** 2)

if detected_objects.get('table') == [] and detected_objects.get('sun') == [] and detected_objects.get('chair') == []:
    print("No objects detected under the table")
    final_result: [(0.92,), {'sun': 2}]
else:
    print("Objects detected under the table")
    final_result: [('sun', (200, 150), 0.95, {'sun': 1, 'table': (300, 500)}, {'chair': (100, 150), 'table': (350, 500)} if detected_objects.get('chair') != [] else []))


