from object_detector import Object_Detector_Tool

# Execute the image detection
detector = Object_Detector_Tool()
detection_results, object_count = detector.execute(image="path_to_image1.jpg", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Analyze the detected objects
baseball_objects = detection_results["baseball"]
basket_objects = detection_results["basket"]

# Count the objects
baseball_count = len(baseball_objects)
basket_count = len(basket_objects)

final_result = {
    "A": {"baseball": baseball_count, "basket": basket_count},
    "B": baseball_count,
    "C": basket_count,
    "D": basketball_count,
    "E": baseball_count + basket_count,
}[f"{'B' if baseball_count > basketball_count else 'A'}.count"]
final_result.final_result


