    image_path = "/path/to/your/image.jpg"
    image = Image(image_path)

    # Detect and count empty glasses
    detected_objects = object_detector.execute(image=image, labels=["Empty Glasses"], save_object=True, saved_image_path="detected_glasses")
    count_glasses = len(detected_objects.get("Empty Glasses", []))

    return count_glasses

