def find_empty_glass(glass_count):
    empty_glass_count = 0
    for i in range(len(glass_count)):
        if glass_count[i] == 0:
            empty_glass_count += 1
    return empty_glass_count

# Example usage
glass_count = [2, 1, 0, 1]
empty_glasses = find_empty_glass(glass_count)
print("Number of empty glasses:", empty_glasses)


