from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_118_image_1.jpg"

# Load the object detector tool
tool = Object_Detector_Tool(tool_module_name="object_detector",
                           tool_class_name="Object_Detector_Tool",
                           tool_description="A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding.",
                           tool_version="1.0.0",
                           input_types={"image": image_path, "labels": ["blue", "black"], "threshold": 0.35, "model_size": "tiny", "save_object": True, "saved_image_path": "detected_objects"},
                           output_types={"detected_objects", "object_labels": {"blue": 1, "black": 0, "total": 2}})

# Execute the tool to detect objects
detected_objects, object_labels = tool.execute(image=image_path, labels=["blue", "black"], save_object=True, saved_image_path='detected_objects')

# Count the number of people without a blue hat
blue_hats = object_labels["blue"]
not_with_blue_hats = len(detected_objects)
not_with_blue_hats_count = int(not_with_blue_hats)

final_result = not_with_blue_hats_count


