# Import necessary tools
    from object_detector import Object_Detector_Tool, Text_Detector_Tool, Letter_Detector_Tool

    # Set the image path
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_16_image_1.jpg'

    # Run the object detector to detect any text in the image
    detected_objects = Object_Detector_Tool.execute(image_path, ["baseball", "basket"], save_object=True, saved_image_path="detected_objects")
    object_number = {
        'baseball': len(detected_objects['baseball']),
        'basket': len(detected_objects['basket'])
    }

    # Run the text detector to detect text in the image
    text_detected = Text_Detector_Tool.execute(image_path, languages=['en', 'de'], detail=0).astype()
    result = []

    for t, detection in detected_objects.items():
        for bbx, letter, score in text_detected['detected text']['bbox']:
            try:
                # Make sure to extract the required text according to the needs
                extracted_text = text_detected['detected text']['text'][tuple(bbx)]
                result.append([[tuple(bbx), letter, score], extracted_text])
            except Exception as e:
                print(f"Error:Failed to extract text in the image. Details: {e}")

    # Run the letter detector to detect letters in the image
    results = Letter_Detector_Tool.execute(image_path)

    final_result = ""

    if results:
        final_result += "Number of texts detected: " + str(len(results))
        if detected_objects:
            final_result += " " + str(detected_objects)
        if results:
            final_result += "\n"
        if detected_objects and results:
            final_result += "Letter detection results:" + "\n"
            final_result += " " + str(detected_objects)
            final_result += "\n"
            final_result += " " + str(results)
    else:
        final_result += "No text detected."

    return final_result


