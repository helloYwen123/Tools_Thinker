def count_green_train_carts(image_path):
    # Load the image
    img = Image.open(image_path)
    
    # Detect green train carts
    green_train_carts = detect_objects(img, 'green', threshold=0.25, save_object=True)
    
    # Count the number of green train carts
    total_count = len(green_train_carts)
    
    return total_count, green_train_carts

