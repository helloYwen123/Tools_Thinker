from object_detector import Object_Detector_Tool
 from text_detector import Text_Detector_Tool
 from letter_detector import Letter_Detector_Tool

# Set up tool instances
object_detector = Object_Detector_Tool()
text_detector = Text_Detector_Tool()
letter_detector = Letter_Detector_Tool()

# Initialize flag for retry detection attempts
retry_attempts = 1

# Simulate counting attempts
for _ in range(1000):
    try:
        # Count glasses using object_detector
        detected_objects = object_detector.execute(image="path_to_wine_vessel.jpg", labels=["glasses"], threshold=0.5, model_size="tiny", save_object=True, saved_image_path="detected_objects")
        total_obj_counts = {lbl: len(detected_objects) for lbl in detected_objects}
        break  # If detected, break the loop upon the first match.

    except Exception as e:
        print(f"Exception occurred: {e}")
        print(f"Retrying count attempt after error: total_obj_counts={total_obj_counts}")

        # Break the loop after a total timeout of retries
        if retry_attempts >= 10:
            final_result = e
            break  # If retries exceed the limit, break the loop.

    if detected_objects is not None:
        break  # If detection success, break the loop.

# Count glasses by summing up detections
total_glasses = sum(total_obj_counts.values())

# Count empty glasses
total_empty_glasses = len(detected_objects) - total_obj_counts

# Ensure we only use total_obj_counts, since empty_glasses is calculated from det, no need to add
total_glasses -= total_empty_glasses

final_result = e


