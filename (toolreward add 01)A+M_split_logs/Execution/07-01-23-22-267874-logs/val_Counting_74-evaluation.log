from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Define the path to the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_74_image_1.jpg'

# Use the letter_detector and text_detector to detect text and characters in the image
results = Letter_Detector_Tool.execute(image=image_path)
detected_text = [f"Detected text: {result[2]}" for result in results]
labels = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'], detail=1)
character_detected = [f"Detected character: {char_result[2]}" for char_result in results]
text_detected = '.'.join(character_detected)

# Calculate the number of empty glasses
empty_glasses = 0
num_glasses = len(detected_text.split(', '))
num_glasses -= detected_text.count('A')
num_glasses -= detected_text.count('*')
num_glasses -= detected_text.count('é')
num_glasses -= detected_text.count('F')
num_glasses -= detected_text.count('u')
num_glasses -= detected_text.count('g')

final_result = [f"{empty_glasses}"]
for text in detected_text.split(', '):
    empty_glasses += detected_text.count(text)
    final_result.append(str(empty_glasses))

print("final_result: {}".format(final_result))
A = 0
B = 2
C = 3
D = 1
if D in final_result:
    final_result[D] = 1
if A == D:
    final_result[A] += 1

final_result.sort(reverse=True)
print("final_result: ", final_result)


