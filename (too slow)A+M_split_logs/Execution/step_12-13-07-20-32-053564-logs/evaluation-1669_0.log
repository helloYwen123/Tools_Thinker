from object_detector import Object_Detector_Tool

# Define the image path
path = '/path/to/image.png'

# Define the labels to detect (table and chairs)
labels = ['baseball', 'basket']

# Define the confidence threshold
threshold = 0.35

# Define the model size
model_size = 'tiny'
save_object = False

# Run the detection
detected_objects, object_number = Object_Detector_Tool.execute(image=path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

# Print the object number and objects detected
if len(detected_objects) > 0:
  print(f"Total of {sum(object_number.values())} objects detected.")
  print(detected_objects)

# Check the chair detection if exist
if 'chair' in detected_objects:
  chair_box = detected_objects['chair'][0]['bbox']
  chair_left, chair_top, chair_right, chair_bottom = chair_box

  # Calculate the relative positions
  chair_x_offset = chair_right - chair_left
  chair_y_offset = chair_bottom - chair_top

  # Check where the chair is located regarding the table
  if chair_x_offset / chair_right >= 0.8:
    print(f"The chair ({chair_left}, {chair_top}) is above the brown table")
  else:
    print(f"The chair ({chair_left}, {chair_top}) is below the brown table")


