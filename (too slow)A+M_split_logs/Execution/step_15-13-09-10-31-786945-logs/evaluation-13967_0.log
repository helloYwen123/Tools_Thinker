from object_detector_tool import Object_Detector_Tool

# Set the image paths
image_path1 = '/nfs/data8/liao/wxie/SAT/SAT_image_1_2712_0.png'
image_path2 = '/nfs/data8/liao/wxie/SAT/SAT_image_1_2712_1.png'

# Set the thresholds and model sizes
threshold = 0.35
model_size = 'tiny'

# Detect DeskLamp and holmo_v_floor lamp
detected_objects = {}

# Execute the detection tool
detected_objects = Object_Detector_Tool.execute(image=image_path1, labels=['DeskLamp', 'holmo_v_floor lamp'], save_object=True, saved_image_path='detected_objects', threshold=threshold, model_size=model_size)

# Print the results
for object_name, detection_results in detected_objects.items():
    if object_name == 'holmo_v_floor lamp':
        print(f"Holmo_v_floor lamp detected with score: {detection_results['score']}")
    elif object_name == 'DeskLamp':
        for result in detection_results:
            box = result['bbox']
            score = result['score']
            result_name = f'{object_name}_{result_name}'
            if results is not None:
                results[object_name].append(
                    {'bbox': box, 'score': score, 'result_name': result_name, 'image_path': image_path1})  # Save detected objects to the image_paths

    # Save the detected objects as images
