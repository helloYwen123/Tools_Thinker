        if model_size == 'tiny':
            # Tiny model size
            result_name = f'detected_objects/{detected_obj}/tiny'
            results[detected_obj] = [{'bbox': box, 'score': score, 'result_name': result_name, 'image_path': image_path1}]  # Save detected objects to the image_paths
