final_result = {
  "baseball": 0,
  "basket": 0,
  "letters": []
}

result_list = []
for label in ["baseball", "basket"]:
    detected_result = Object_Detector_Tool.execute(image="path_to_your_image.png", labels=[label], save_object=True)
    object_detection = detected_result["detected_objects"]
    
    object_count = detect_object(object_detection)
  
    if label in object_detection["objects"]:
        final_result[label] = object_count

    result_list.append([object_detection[label]["bbox"], object_detection[label]["text"], object_detection[label]["score"]])

    letter_result = Letter_Detector_Tool.execute(image="path_to_your_image.png")
    letters = []
    for letter in letter_result:
        letters.append(letter)
    
    final_result["letters"].append(letters)

result = final_result["baseball"] or final_result["basket"] or final_result["letters"]
if not final_result:
    result = 0
final_result["baseball"] = result
final_result["basket"] = result
final_result["letters"] = [str(char) for char in final_result["letters"]]
print(final_result)


