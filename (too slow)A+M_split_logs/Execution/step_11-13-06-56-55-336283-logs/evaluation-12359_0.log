from object_detector import Object_Detector_Tool

# Define the labels to detect
labels = ['baseball', 'basket', 'chair_with_chairs']

# Function to execute the object detector tool
def execute(labels, save_object, saved_image_path=None):
    detected_objects = []
    total_objects_number = 0

    # Execute detecting objects in the image
    result = Object_Detector_Tool.execute(image='path/to_image.png', labels=labels)
    
    if len(result) > total_objects_number:
        detected_objects = result['detected_objects']
        objects_number = result['total_count']
    else:
        total_objects_number = len(result['totla_objects'])

    return detected_objects, objects_number

# Read the path to the image file
image_path = 'path/to/image.png'

# Execute image detection
detected_objects, total_objects_number = execute(labels=labels, save_object=True, saved_image_path='detected_objects')

# Check if texts were successfully detected
if not detected_objects or not 'basket' in detected_objects:
    print("Text detection failed.")
else:
    # For demonstration purposes, let's assume that the detected texts are 'baseball' and 'basket'.
    detected_text = '\n'.join([f"Detected text: {detect['text']}" for detect in detected_objects])

    # Save the detected objects
    saved_image_path = 'detected_objects/image_baseball_1.png'
    save_object = True
    image_results = Object_Detector_Tool.execute(image_path=image_path, save_object=save_object, outdir='./vis_depth')
    
    # Create a dictionary to store the detected objects with their bounding box coordinates, recognized text, and confidence score
    detected_objects_dict = {}
  
    # Iterate through the detected texts and record the coordinates, text, and confidence score
