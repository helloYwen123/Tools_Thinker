def detect_paintings(image_path, labels=[],
                     model_size='tiny', threshold=0.35, save_object=False):
    from object_detector import Object_Detector_Tool
    from text_detector import Text_Detector_Tool
    from letter_detector import Letter_Detector_Tool

    # Detect objects in the image
    labels = []
    image = Image.open(image_path).convert('RGB')
    print("Detected objects:")
    for label in labels:
        result = Object_Detector_Tool.execute(image=image, saved_image_path="detected_objects")
        for detected_obj in result:
            print(f"Detected object: {label} with: box: {detected_obj['bbox'].tolist()},{label}: {detected_obj['confidence']}")
    
    # Detect the presence of paintings in the image
    painting_count = 0
    print("Paintings detected in the image:")
    for label in labels:
        detected_obj = None
        detected_image = None
        if save_object:
            detected_obj, detected_image = Letter_Detector_Tool.execute(image_path=image_path, languages=['en', 'de'], output=False)
            detected_obj, detected_image = Image.open(detected_image), Image.open(detected_image)
        if detected_obj and detected_obj['bbox'].get('bbox') and detected_obj['confidence'] > threshold:
            frame, detected_obj_bbox, detected_obj_txt = ImageDraw.Draw(image).text_rectangle((detected_obj_bbox[0][0], detected_obj_bbox[1][1]), detected_obj['text'], (0, 0, 255, 255))
            print(f"{detected_obj_txt}, {detected_obj_bbox}")
            if 'artwork' in detected_obj['text']:
                print(f"Artwork detected.")
                painting_count += 1
            # Save the detected object for later analysis
            if save_object:
                img_path = "detected_objects/image" + str(painting_count) + ".png"
                detected_obj['bbox'].to((100, 100), (100, 200), (200, 200), (100, 200))
                detected_obj_bbox.to((100, 100), (100, 200), (200, 200), (100, 200))
                detected_obj_txt.to((100, 100), (200, 200), (200, 200), (100, 200))
                image.save(img_path)

    print(f"Paintings detected in the image: {painting_count}")

detect_paintings(image_path='path/to/image.png')


