from object_detector import Object_Detector_Tool

# Set the image path, labels, and optional parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/two_artist_139.png"
labels = ["baseball", "basket"]
threshold = 0.4

# Execute the object detection tool and get the results
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path="detected_objects")

# Get the list of detected objects from the tool results
objects = detected_objects['object_number']

# Extract the list of object IDs and confidence scores from the object_number 'detected_objects' dictionary
object_ID = [(obj['Object_ID'], obj.get('Confidence', 1)) for obj in Object_Detector_Tool.get_object_names_from_id(detected_objects['object_number'])]

# Create a dictionary with the number of detected objects for each label
object_number_dict = {obj[1]: obj[0] for obj in object_ID}
final_result = '0'

if len(objects) > 0:
    final_result = ', '.join([f'{l} : {o}' for (l, o) in sorted(object_number_dict.items())])
if detected_objects.get('save_object', False):
    # Create a dictionary mapping each label to the number of detected objects in the image
    object_number_dict = {f'{l} : {o}' for (l, o) in sorted(object_number_dict.items()),}

# Determine the number of Paintings using the object ID list
# Note that painting IDs are not included in the labels parameter as they are not detected in this tool
paintings = sum([1 for painting_ID in object_number_dict])

# Print the final result
print(final_result)


