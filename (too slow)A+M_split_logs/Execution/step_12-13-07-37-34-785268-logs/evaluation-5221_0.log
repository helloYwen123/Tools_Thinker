def count_dining_tables(image_path):
    import_object_detector = Object_Detector_Tool
    labels = ['DiningTable']
    threshold = 0.5
    model_size = 'tiny'
    save_object = True
    saved_image_path = 'detected_objects'
    
    detected_objects = import_object_detector.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    if detected_objects:
        object_number = len(detected_objects)
        if save_object:
            import_path_generator = saved_image_path + f'/{j}' for j in range(1, len(detected_objects))
            for obj in detected_objects:
                obj['saved_image_path'] = os.path.join(import_path_generator, obj['saved_image_path'])
    else:
        object_number = len(detected_objects)
    return object_number

