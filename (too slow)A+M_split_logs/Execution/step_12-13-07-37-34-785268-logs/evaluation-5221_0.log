def count_dining_tables(image_path) -> dict:
    # Load the image
    image = cv2.imread(image_path)

    # Perform text-based image analysis to count dining tables
    text_detected = Text_Detector_Tool.execute(image_path= image_path, languages=['en', 'de'])
    
    # Extract dining tables from the text
    detected_regions = []
    for block in text_detected:
        x0y0, x1y1, x2y2, __ = block
        if 'Dining Table' in block[1]:
            detected_regions.append((x0y0, x1y1, x2y2, x3y3))

    # Count the number of dining tables
    dining_tables_count = len(detected_regions)

    return {"table_count": dining_tables_count}


