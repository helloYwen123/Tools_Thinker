def count_sinks(image_path):
    # Load the image using the image_path
    image = Image.open(image_path)
    
    # Apply the letter_detector tool to detect the sink
    results = letter_detector.execute(image='path/to/image_path')

    # Check if there are any detected letters
    if results:
        # If there are, convert to a list of lists and check the fourth element
        detected_letters = results[0][3]
        
        # Count the number of detected sinks
        sink_count = sum(1 for x in detected_letters if 'sink' in x)
        
        return sink_count
    else:
        return 0

