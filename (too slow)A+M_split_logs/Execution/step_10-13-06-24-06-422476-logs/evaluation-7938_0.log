from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool
from Letter_Detector_Tool import Letter_Detector_Tool

final_result = []

# Detect objects
detected_objects = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Extract text information
results = []
for desc in detected_objects['objects']:
    results.append((desc['bbox'], desc['text'], desc['score']))
   
# Print results
results.sort(key=lambda x: x[2])

# Print length of results list
print(f"Number of detected objects: {len(results)}")
# Print text information at each detected location
for detected_object in results:
    for desc in detected_objects['objects']:
        if desc['text'] == detected_object[1]:
            print(f'{detected_object[1]}: BoundingBox: {detected_object[0]}, Text: {detected_object[1]}, Confidence: {detected_object[2]}')

# Print letter information
results = Letter_Detector_Tool.execute(image='path/to/image.png')
for found_letter in results:
    print(f'Found letter {found_letter[1]}. BoundingBox: {found_letter[0]}, Confident: {found_letter[2]}')


