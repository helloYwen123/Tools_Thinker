def detect_interest_objects(image_path, labels, save_data=False, saved_image_path=None):
    # Use the Object_Detector_Tool to detect interest-objects
    detected_objects = []
    for label in labels:
        result = Object_Detector_Tool.execute(image=image_path, labels=[label], save_object=True, saved_image_path=saved_image_path)
        if len(result['object_number']) < 1 and save_data:
            detected_objects.append({label: result})
    return detected_objects

