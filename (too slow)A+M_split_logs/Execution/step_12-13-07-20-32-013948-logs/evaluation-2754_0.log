current_image = pygame.display.get_current_image()

# Detect words in the image
word_results = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])
print(word_results)

# Detect text blocks in the image
text_results = Text_Detector_Tool.execute(image=image_path)
print(text_results)

# Detect low-profile bed
lowprofile_bed = []
for res in text_results:
    bounding_box = res[0][2]
    x1, y1, x2, y2 = bounding_box[0]
    if bounding_box[1] == 'lowprofile':
        lowprofile_bed.append({'bbox': bounding_box, 'text': 'lowprofile bed', 'score': res[1]})

# Detect blue bedding
blue_bed = []
for res in text_results:
    bounding_box = res[0][2]
    x1, y1, x2, y2 = bounding_box[0]
    if bounding_box[1] == 'blue bedding':
        blue_bed.append({'bbox': bounding_box, 'text': 'blue bedding', 'score': res[1]})

# Detect black TV
black_tv = []
for res in word_results:
