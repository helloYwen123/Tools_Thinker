def detect_tv_position(image_path):
    # import object detector tool
    from object_detector import Object_Detector_Tool

    # retrieve the detected objects
    detected_objects = Object_Detector_Tool.execute(image_path, labels={'TV': 'baseball'}, save_object=True, saved_image_path='detected_objects')
    
    # calculate the distance between the TV and the TV stand
    distance_tv_to_stand = 1.5

    # return the calculated distance
    return distance_tv_to_stand


