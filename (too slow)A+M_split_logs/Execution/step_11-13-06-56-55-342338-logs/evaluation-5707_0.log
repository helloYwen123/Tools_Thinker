from object_detector_class import Object_Detector_Tool

# Create an instance of the Object_Detector_Tool class
detector_tool = Object_Detector_Tool()

# Detect objects in image labeled as 'basball' and 'basket'
labels = ['basball', 'basket']
saved_image_path = 'detected_objects'

# Create a dictionary containing the bounding box, score, and saved image path for each detected object
detected_object_dictionary = {'basball': [{'box': (34, 50, 200, 220), 'score': 0.92, 'saved_image_path': 'detected_objects/image_baseball_1.png'}], 'basket': [{'box': (220, 100, 400, 350), 'score': 0.85, 'saved_image_path': 'detected_objects/image_basket_1.png'}]}

# Call the tool to process the image
result = detector_tool.execute(labels=labels, save_object=True, saved_image_path=saved_image_path)

# Extract the number of detected objects for each label
object_number = {label: len(result) for label in result}

# Print the results
print(f"Number of detected objects in total: {object_number}")
print(result)
print(object_number)


