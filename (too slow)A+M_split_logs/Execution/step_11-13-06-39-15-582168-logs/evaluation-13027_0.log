from object_detector import Object_Detector_Tool

detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Detecting baseball and basket in the image using the `baseball` and 'basket' labels

if object_number['baseball'] == 1 and object_number['basket'] == 2:
    for label, detection in detected_objects.items():
        if detection[1] != 'None':
            print(f'Detected {label}:')
            for item in detection:
                print(f"- {item['boxed'][0]} {item['boxed'][1]}, {item['boxed'][2]} {item['boxed'][3]}, {item['boxed'][4]} {item['boxed'][5]}, {item['bbox_accuracy']}')

            print(f"Confidence score: {item['bbox_accuracy']}")
    else:
        print('Nothing detected')
else:
    print('Not enough data')


