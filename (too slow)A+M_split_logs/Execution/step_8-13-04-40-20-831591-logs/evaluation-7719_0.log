            results = text_detector.execute(image_image_path, languages=labels[0], detail=0)
            print(f"Text detected in image_path. Result: {results}")
            break

        except Exception as e:
            print(f"Failed to detect text with labels: {labels[0]}, retry {retry}. Error: {e}")
            pass

    return detected_objects

