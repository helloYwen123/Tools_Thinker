from object_detector import Object_Detector_Tool

final_result = ""
# Execute the Object_Detector_Tool
result = Object_Detector_Tool.execute(image="path_to_image.png", labels=["painting"], save_object=True, saved_image_path="detected_objects")

# Extract bounding box coordinates from images and convert to list of tuples
detected_objects = []

for obj in result["detected_objects"]:
    # Convert object data to tuple
    detection_data = {
        "bbox": (tuple.from_sequence(obj["bbox"])),
        "score": obj["score"],
        "saved_image_path": f"detected_objects/{obj['saved_image_path']}"
    }
    detected_objects.append(detection_data)

if detected_objects:
    # Join bounding box data into a single list
    bounding_boxes = [f"[{bbox[0]}:{bbox[1]}]" for bbox in detected_objects]
    
    # Join each bounding box into a single string: "x1,y1,x2,y2"
    detected_boxes_str = ", ".join(bounding_boxes)
    
    # Convert to string representation of detected objects
    final_result = f"Detected paintings: {detected_boxes_str}\n"
else:
    
    # If no paintings detected, return an empty string
    final_result = ""


