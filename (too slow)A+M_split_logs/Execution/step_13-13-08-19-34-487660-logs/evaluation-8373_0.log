from object_detector import Object_Detector_Tool

def classify_object(image_path, object_labels, save_object=False, saved_image_path="detected_objects"):
    # Create an instance of Object_Detector_Tool
    object_detector = Object_Detector_Tool(image_path=image_path, labels=object_labels, save_object=save_object, saved_image_path=saved_image_path)
    detected_objects, object_number = object_detector.execute()
    
    final_result = {
        "detected_objects" : detected_objects,
        "object_number" : object_number
    }
    
    return final_result


