    detected_labels = pytesseract.image_to_string('.'.join([os.path.dirname(__file__).replace("sat_images_train", ""), os.path.basename(image_path)]), lang='chi_sim')
    font_path = 'assets/{}.txt'.format('chi_sim.ttf')
    font = pygame.font.Font(font_path, 24)
    label_box = font.render('chair', True, (255, 255, 255))  # (H, W)
    chair_boxes = [[label_box.getbbox()]]

    draw_image = Image.new('RGB', (244, 250), (111, 222))
    draw = ImageDraw.Draw(draw_image)
    for bbox in chair_boxes:
        xy = bbox[0]
        draw.rectangle(xy, fill=(0, 255, 0), outline=(0, 0, 0))
        x = xy[0][0]
        y = xy[0][1]
        width = bbox[2][0] - bbox[0][0]
        height = bbox[2][1] - bbox[0][1]
        ch = DrawChar(bbox[0][0]+200, bbox[0][1]+100, 'chair', 2, label=detected_labels, style='black')
        draw_image.paste(ch, (x, y))
        if save_object:
            new_x, new_y = x - win.width/2., y + win.height/2.
            res = cv2.rectangle(win, (new_x - win.width/2, new_y - win.height/2),
                                (new_x + win.width/2 + win.width, new_y + win.height/2 + win.height),
                                (255, 0, 0), 1)
            res = cv2.cvtColor(res, cv2.COLOR_BGR2RGB)
            cv2.imwrite('new.jpg', res)

               

if __name__ == '__main__':
