from object_detector import Object_Detector_Tool

detected_objects, object_number = Object_Detector_Tool.execute(image="path/to/image.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

a_result = {}
for i in range(len(detected_objects)):
    if detected_objects[i]["box"]:
        if detected_objects[i]["box"][0] < 400:
            a_result["baseball"] = "baseball" if detected_objects[i]["box"][0] > 800 else "basket" if detected_objects[i]["box"][1] > 800 else "unidentified"
        elif detected_objects[i]["box"][1] < 300:
            a_result["basket"] = "basket" if detected_objects[i]["box"][0] < 400 else "baseball"
            if detected_objects[i]["box"][0] > 200:
                a_result["basket"] = "basket" if detected_objects[i]["box"][0] < 300 else "unidentified"
        else:
            a_result["unidentified"] = "unidentified" if detected_objects[i]["box"][1] < 200 else detected_objects[i]["box"]
    else:
        a_result["unidentified"] = "unidentified"

for key, value in object_number.items():
    a_result["num"] = value

final_result = f"Based on the image provided, the 'baseball' is located in the area outside the bounding box limit when the object is within the bounding box.", a_result["baseball"]

print(final_result)

