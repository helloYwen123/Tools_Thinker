from object_detector import Object_Detector_Tool

# Set the confidence threshold and model size
confidence_threshold = 0.35
model_size = "tiny"

# Execute the object detection and count baseball instances
detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball'], save_object=False, threshold=confidence_threshold, model_size=model_size)

# Output the results
print(f"Detected baseball instances: {detected_objects} (#{sum(object_number.valuesATIO) objects detected)")
```

