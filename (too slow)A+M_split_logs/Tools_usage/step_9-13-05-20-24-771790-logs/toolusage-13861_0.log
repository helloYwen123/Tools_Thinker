import object_detector

def detect_position(image_path):
    detected_objects = object_detector.execute(image=image_path, labels=[{'class': 'Television', 'bbox': (-0.3, -0.5, -0.02, -0.05)}, {'class': 'Television stand', 'bbox': (-0.22, 0.46, -0.38, 0.54)}])

    television_bbox = detected_objects['Television']['bbox']
    television_bbox_top = ((television_bbox[0][0] + television_bbox[2][0]) / 2, television_bbox[1][1] - television_bbox[1][2])
    television_bbox_bottom = ((television_bbox[0][0] + television_bbox[2][0]) / 2, television_bbox[1][1] + television_bbox[1][2])

    television_bbox_left = (television_bbox[2][0] + (television_bbox[0][0] - television_bbox[2][0]) / 2, television_bbox[3][3] - television_bbox[3][1])
    television_bbox_right = (television_bbox[2][0] + (television_bbox[0][0] - television_bbox[2][0]) / 2, television_bbox[3][3] + television_bbox[3][1])

    television_bbox_top &= pygame.sprite.collide_mask(Dark_blue_rectangle_obj,
                        television_bbox)
    television_bbox_bottom &= pygame.sprite.collide_mask(Dark_blue_rectangle_obj,
                        television_bbox)
    television_bbox_left &= pygame.sprite.collide_mask(Dark_blue_left_obj,
                        television_bbox)
    television_bbox_right &= pygame.sprite.collide_mask(Dark_blue_right_obj,
                        television_bbox)

    television_bbox_top &= pygame.sprite.collide_mask(Bkg_obj,
                        television_bbox)
    television_bbox_bottom &= pygame.sprite.collide_mask(Bkg_obj,
                        television_bbox)
    television_bbox_left &= pygame.sprite.collide_mask(Bkg_obj,
                        television_bbox)
    television_bbox_right &= pygame.sprite.collide_mask(Bkg_obj,
                        television_bbox)

    television_bbox_top &= pygame.sprite.collide_mask(Led_obj,
                        television_bbox)
    television_bbox_bottom &= pygame.sprite.collide_mask(Led_obj,
                        television_bbox)
    television_bbox_left &= pygame.sprite.collide_mask(Led_obj,
                        television_bbox)
    television_bbox_right &= pygame.sprite.collide_mask(Led_obj,
                        television_bbox)

    television_bbox_top &= pygame.sprite.collide_mask(Dummy_obj,
                        television_bbox)
    television_bbox_bottom &= pygame.sprite.collide_mask(Dummy_obj,
                        television_bbox)
    television_bbox_left &= pygame.sprite.collide_mask(Dummy_obj,
                        television_bbox)
    television_bbox_right &= pygame.sprite.collide_mask(Dummy_obj,
                        television_bbox)

    if 'Television stand' not in detected_objects.keys() or detected_objects['Television stand'][0]['bbox'][1][2] < television_bbox[1][2]:
        print("Television is below the black open-shelf TV stand.")
    else:
        print("Television is above the black open-shelf TV stand.")

