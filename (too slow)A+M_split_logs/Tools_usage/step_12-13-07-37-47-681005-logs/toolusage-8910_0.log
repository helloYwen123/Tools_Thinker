from object_detector import Object_Detector_Tool

def answer_question():
    detected_objects = None
    object_count = {
        'red chair': 0,
        'green candle': 0,
        'table': 0,
        'doorway': 0
    }
    
    image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/8910_0.png'
    labels = ['red chair', 'green candle', 'table', 'doorway']
    threshold = 0.35
    model_size = 'tiny'
    
    # Detect objects using the Grounding DINO model
    with Object_Detector_Tool(image_path, labels, model_size, threshold) as detector:
        detected_objects = dict(detector.execute())
        
        # Count the total number of objects seen
        object_count = detector.object_number
        
    # Check for the presence of objects in the image: 'red chair', 'green candle', 'table', 'doorway'
    if 'red chair' in image_path or 'green candle' in image_path or 'table' in image_path or 'doorway' in image_path:
        final_result = f"Doorway with respect to Table is {object_count['red chair']}, {object_count['red chair']} Objects."
    else:
        final_result = 'No objects found in the image.'

    return final_result

# Example usage
print(answer_question())

