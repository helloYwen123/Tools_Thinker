    if "score" in det_result:
        det_result["score"] = detection["score"]

    if "image" in det_result:
        det_result["image"].append(["Detected text", "Baseball detected...", score])

    if "file_path" in det_result:
        det_result["file_path"].append("Path to image")

# For a video:
