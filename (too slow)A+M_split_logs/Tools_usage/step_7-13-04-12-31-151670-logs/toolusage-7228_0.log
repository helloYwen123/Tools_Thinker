for _, detection in detected_objects.items():
    if detection["label"] == "baseball":
        # Add 1 to the total number of detections in the image
        object_number["baseball"] += 1
    elif detection["label"] == "basket":
        # Add 2 to the total number of detections in the image
        object_number["basket"] += 2

