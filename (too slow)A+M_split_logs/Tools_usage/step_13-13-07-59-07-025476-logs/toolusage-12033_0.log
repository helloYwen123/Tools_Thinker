import Object_Detector_Tool
import Text_Detector_Tool
import Letter_Detector_Tool
import Pixel_Depth_Tool
import os

def detect_interestObjects(image_path):
    # Detect objects using Object_Detector_Tool
    detected_objects = Object_Detector_Tool.execute(image_path, ["TV", "Window"], save_object=False)
    
    # Detect text using Text_Detector_Tool
    text_blocks = Text_Detector_Tool.execute(image_path, ["en", "de"], 0)
    
    # Detect letters using Letter_Detector_Tool
    letter_blocks = Letter_Detector_Tool.execute(image_path)
    
    # Save detected objects images
    if "detected_objects" in detected_objects.keys():
        for obj_dict in detected_objects["detected_objects"]:
            save_path = img_name + "_" + obj_dict["label"] + ".png"
            os.makedirs(os.path.dirname(save_path), exist_ok=True)
            img = obj_dict["image_result"]
            dest = os.path.join(img_name, save_path)
            cv2.imwrite(dest, img)
    if "video_results" in detected_objects.keys():
        for video_name, depth_map in detected_objects["video_results"].items():
            video_depth = np.array(depth_map)
            dest = os.path.join(outdir, video_name + "_depth.mp4")
            cv2.imwrite(dest, video_depth)
            shutil.copyfile(dest, os.path.join(outdir, video_name + ".mp4"))
    return detected_objects, text_blocks, letter_blocks

def visualize_interestObjects(image_path, obj_dict, obj_ner_dict):
    obj_name = obj_dict["label"] + "-" + str(obj_ner_dict)
    detected_objects = obj_dict["image_result"]
    detected_objects["label"] = obj_name
    detected_objects = np.array(detected_objects)
    obj_bbox_dict = {obj_ner_dict: obj_bbox for obj_ner_dict, obj_bbox in detected_objects.bbox.items()}
    return detected_objects, obj_bbox_dict

def answer_interestObjects(image_path):
    # Load input images
    detected_objects, text_blocks, letter_blocks = detect_interestObjects(image_path)
    
    # Visualize detected objects
    for obj_ner_dict, obj_bbox in letter_blocks.items():
        img_name = image_path.split("/")[-1].split(".")[0][:-4]
        obj_bbox_dict = obj_bbox_dict.pop(list(letter_blocks))[obj_ner_dict]
        obj_bbox = list(obj_bbox_dict.values())
        obj = Image.fromarray(detected_objects["image_result"])
        if "label" not in detected_objects:
            detected_objects["label"] = str(obj_ner_dict)
        detected_objects, obj_bbox_dict = visualize_interestObjects(image_path, detected_objects, obj_ner_dict)
        dest = os.path.join(outdir, img_name + ".png")
        obj.save(dest)
        cv2.rectangle(dest, (obj_bbox[0], obj_bbox[1]), (obj_bbox[2], obj_bbox[3]), (255, 255, 0), 2)
    
    # Write detected objects to text file
    f = open(interestObjects_path, "wb")
    f.write("{0:}".format(detected_objects["label"]))
    for bbox in detected_objects["bbox"]:
        f.write(" ")
        f.write("{0}:".format(bbox))
    f.write("\n")
    f.close()
    return detected_objects, detected_objects["label"]
```
To use this program, save the Python script to a file (e.g. `visualIZE.py`), create the output directory if it doesn't exist (`mkdir -p outdir`), and set the path `outdir` to the directory where you want to save the images and videos. Then run `visualIZE.py` by providing the path to the input image or video file and the name of the output file.
Note: This code only works for Windows platform.
