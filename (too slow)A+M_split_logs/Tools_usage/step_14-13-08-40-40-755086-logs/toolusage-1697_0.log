def get_object_area(image_path, labels, save_object=True):
    detected_objects = []
    object_number = {}
    
    objects_to_check = {
        "baseball": [f"/Users/{os.getlogin()}/Desktop/SAT_images_train/{image_path}", "baseball"],
        "basket": [f"/Users/{os.getlogin()}/Desktop/SAT_images_train/{image_path}", "basket"]
    }
    
    num_labels_to_check = len(labels)

    for idx, label in enumerate(labels):
        if label in objects_to_check:
            box_y1, box_y2, box_x1, box_x2, confidence = None, None, None, None, None
            for box in objects_to_check[label]:
                image_path_to_check, label_to_check = box.split(", ")
                try:
                    object_to_check = Object_Detector_Tool.execute(image_path=image_path_to_check, 
                                                                   labels=labels[idx], 
                                                                   threshold=0.35, 
                                                                   save_object=False, 
                                                                   saved_image_path=image_path_to_check[:-4]+f"_bbox.png")
                    box_y1, box_y2, box_x1, box_x2, confidence = object_to_check["bbox"][idx]
                    detected_objects.append({"box": [box_y1, box_y2, box_x1, box_x2], "confidence": confidence})
                    object_number[label_to_check] += 1
                except ValueError:
                    print("Failed to detect", label_to_check, "in", image_path_to_check)
        
            if save_object:
                result = Image.open(image_path).convert("RGB")
                detection_results = pd.DataFrame(detected_objects).assign(box=detected_objects["box"], confidence=0.4 * detected_objects["confidence"])
                box_names = [detection_results["box"][idx]["box"] for idx in range(len(detection_results))]

                image_path = f"{image_path_path}/{label_to_check}.PNG"
                image_path_to_check = f"{image_path_path}/{label_to_check}.PNG"
                detection_results.to_csv(image_path_path, index=False)
                
                if idx == num_labels_to_check - 1:
