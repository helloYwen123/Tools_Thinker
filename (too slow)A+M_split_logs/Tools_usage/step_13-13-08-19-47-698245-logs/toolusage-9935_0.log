from object_detector import Object_Detector_Tool, Text_Detector_Tool, Pixel_Depth_Tool

# Create an Object_Detector_Tool instance
detector_tool = Object_Detector_Tool()

# Set the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9935_0.png"

# Set the labels (in this case, only the first one is relevant)
labels = ["Doorway"]  # Change to ['Doorway', 'stainless steel kitchen sink']

# Set the threshold and model size
threshold = 0.35
model_size = 'tiny'

# If we want to save the detected objects
save_object = True

# If we want to save the detected objects
saved_image_path = "/tmp/detected_objects"

# Detect objects in the image
detected_objects, object_number = detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)

# Calculate object number
object_number = object_number['baseball'] + object_number['basket']

# Iterate through the detected objects list
for object_label, object_results in detected_objects.items():
    object_path = "detected_objects/" + object_label + "_" + object_label + "_" + object_number + ".png"
    detector_tool.save_object(object_label, object_results, object_path, save_object=save_object, saved_image_path=saved_image_path)
    object_number -= 1

print("Final result:", object_number)

============================== END ==============================


