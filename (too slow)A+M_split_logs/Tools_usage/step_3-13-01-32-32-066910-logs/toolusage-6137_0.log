def answer_question(final_result):
    # Check if text detection failed after retries
    if not final_result["detected_objects"]:
        return "Text detection failed after retries."
    # Extract detected objects
    detected_objects = final_result["detected_objects"]
    
    # Iterate over detected objects and count their frequency
    detected_objects_count = {}
    for detected_objects_list in detected_objects.values():
        for detected_objects in detected_objects_list:
            id = detected_objects["label"]
            count = detected_objects_count.get(id, 0)
            detected_objects_count[id] = count + 1
            
            # Get detected text
            text = detected_objects["text"]
            if text:
                recognized_text = str(detected_objects["score"])
                confidence_score = detected_objects["score"]
                detected_objects["confidence_score"] = confidence_score
                detected_objects["text"] = text
                
    if detected_objects_count:
        final_result["counts"] = detected_objects_count
    else:
        final_result["counts"] = {}
    
    return final_result

# Load image
image_path = 'path/to/image.png'

# Use Object_Detector_Tool to detect objects and return a tuple with detected label and detected count
detected_objects, object_count = Object_Detector_Tool.execute(image=image_path, labels=[*final_result["total_labels"]], save_object=False, saved_image_path='detected_objects')

# Use Text_Detector_Tool to detect text in the image
text_results = Text_Detector_Tool.execute(image=image_path, languages=['eng', 'de'], detail=0)

# Combine detected objects and text results
combined_results = detected_objects + text_results

# Assign final answer to a variable
final_result = answered_question(combined_results)

# Print final result
print(final_result)
