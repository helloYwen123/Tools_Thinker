```python
import Pixel_Depth_Tool

# Assuming the coordinates are in a pixel grid system
# window x and y coordinates are the first coordinates in the center of the image
# television x and y coordinates are the second coordinates in the center of the image
# if distance (z) value is higher for window than television, then window is to the right of television

# Estimate window depth with a certain confidence level
window_depth_result = Pixel_Depth_Tool.execute(image_path=image_path, output=True, outdir='./vis_depth')

# Compare window depth to television depth
