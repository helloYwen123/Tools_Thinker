window_depth_map = window_depth_result['output_image_path']  # Get the path to the output depth map
tv_depth_map = TV_depth_result['output_image_path']  # Get the TV depth image path

# Compare the two depth images with a certain confidence level
confidence_threshold = 0.85  # Set the confidence threshold for comparison

# Extract pixel depths, convert images to grayscale, and calculate similarity for TV depth map
if np.mean(window_depth_map - tv_depth_map) > confidence_threshold:
    print("Window is to the right of the television.")
