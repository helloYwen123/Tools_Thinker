# Function to calculate the distance between a chair (in blue) and a doorway (in red)
def calculate_distance(chair_bbox, doorway_bbox):
    chair_ox = chair_bbox[0]
    chair_oy = chair_bbox[1]
    doorway_width = doorway_bbox[2] - doorway_bbox[0]
    doorway_height = doorway_bbox[3] - doorway_bbox[1]
    
    chair_ox_diff = (chair_ox - doorway_bbox[0]) - (doorway_bbox[2] - doorway_bbox[0])
    chair_oy_diff = (chair_oy - doorway_bbox[1]) - (doorway_bbox[3] - doorway_bbox[1])
    
    distance = np.hypot(chair_ox_diff**2 + chair_oy_diff**2)**0.5
    return distance

# Function to get the distance between a black chair (in blue) and a doorway (in red)
# Using the image of the room
