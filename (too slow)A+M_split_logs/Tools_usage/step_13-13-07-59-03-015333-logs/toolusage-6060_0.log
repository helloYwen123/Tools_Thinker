from object_detector import Object_Detector_Tool, detected_objects, object_number

def detect_objects(image_path, labels, save_object=True, saved_image_path="detected_objects", threshold=0.35):
    # Load the image
    image = Image.open(image_path)
    
    # Detect the objects
    result = Object_Detector_Tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold)
    
    # Extract the detected objects
    detected_objects = result[0]
    detected_object_numbers = result[1]
    
    return (detected_objects, detected_object_numbers)

# Example usage
image_path = 'path/to/image.png'
labels = ['baseball', 'basket']
detected_objects, detected_object_numbers = detect_objects(image_path, labels, save_object=True, saved_image_path='detected_objects')
print(detected_objects)
print(detected_object_numbers)
```

This program will process the image according to the documentation provided by the `object_detector` class, detecting and counting basebal and basket in the given image. The detected objects would be returned as a dictionary and their count as well.
