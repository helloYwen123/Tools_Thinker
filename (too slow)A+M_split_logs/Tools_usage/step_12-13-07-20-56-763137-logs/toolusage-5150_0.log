from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool
from Letter_Detector_Tool import Letter_Detector_Tool
from Pixel_Depth_Tool import Pixel_Depth_Tool

def answer_riddle():
    # Load the images
    image_path = 'path/to/image.png'

    # Detect the framed landscape painting and airship in the image
    image_results = Pixel_Depth_Tool.execute(image_path=image_path, output=True, outdir='./vis_depth')
    if 'depth_map' in image_results:
        depth_map = image_results['depth_map']
        depth_images = image_results.get('deep_image', [])
        # Get the bounding boxes for the detected objects from the image path
        boxes = [image_results['bbox'] for image_results in image_results['assets']]
        # Try to find the boxes corresponding to the airship and painting
        try:
            airship_boxes = [box for box in depth_map[:, 3] if 'airship' in box and depth_map[:, 1] > 0.7][0]
            painting_boxes = [box for box in depth_map[:, 3] if 'painting' in box and depth_map[1] > 0.5 and depth_map[:, 1] > 0.7][0]
        except IndexError:
            return "Could not find boxes for airship and painting."
        return f"The framed landscape painting with airship is located in: {(airship_boxes[0]}, {(airship_boxes[1]}, {(airship_boxes[2]}, {(airship_boxes[3]}),\n              {(painting_boxes[0]}, {(painting_boxes[1]}, {(painting_boxes[2]}, {(painting_boxes[3]}),\n              {'box': (75, 75)}}")
    else:
        return "Could not find any objects."

# Example call
result = answer_riddle()
print(result)
