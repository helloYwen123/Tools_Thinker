from pixel_level_depth_estimator_tool import Pixel_Depth_Tool

class ImageData:
    def __init__(self):
        self.boxes = []  # Initialize the boxes
        self.labels = []  # Initialize the labels list
        
class DetectorsDataset:
    def __init__(self):
        self.datalist = []

class ResultsDatasetGenerator:
    def __init__(self, detectors_dataset):
        self.detectors_dataset = detectors_dataset
        self.results_dataset = ResultsDataset()

    def create_dataset(self):
        data = []
        labels = [i for i in range(len(self.datalist))]
        while len(labels) > 0:
            image = self.datalist[labels[length(labels) - 1]]
            for i in range(1, len(self.datalist[labels[length(labels) - 1]])):
                box1 = self.datalist[labels[length(labels) - 1]][i - 1]
                box2 = self.datalist[labels[length(labels) - 1]][i]
                labels.remove(labels[length(labels) - 1])
                data.append([data, [box1, box2], box1, box2, labels])
            self.results_dataset.datalist.extend(data)
        self.results_dataset.data = data
        self.results_dataset.labels = labels
        self.results_dataset.datalist = data
        self.results_dataset.data = [list(datum) for datum in data]


class ImageDataset:
    def __init__(self, path):
        self.path = path
        self.labels = []
        self.data = []

    def load_image(self):
        image = Image.open(self.path)
        self.data = image.resize((128, 128))
        self.labels = self.data.split(" ")
        self.labels = [i.strip() for i in self.labels]
        return self.data, self.labels

class ObjectsDetector:
    def __init__(self, path):
        self.object_detector = Object_Detector_Tool()
        self.object_detection_results = []

    def predict(self, path):
        result = self.object_detector.execute(path, ["baseball"], save_object=True, saved_image_path="detected_objects")
        self.object_detection_results = result[0]
        return self.object_detection_results

class PixelDepth_Tool:
    def __init__(self, paths):
        self.imagedata = [ImageDataset(path) for path in paths]
        self.image_datasets = [i for i in self.imagedata if isinstance(i, ImageDataset)]
        
    def execute(self, path):
        res = self.image_datasets[path].load_image()
        res.image = res.image.resize((res.image.shape[1] // 2, 128))
        res.detectors_dataset().create_dataset()
        return res


