from object_detector import Object_Detector_Tool, Text_Detector_Tool

def answer_question(image):
  object_result = Object_Detector_Tool.execute(image=image, labels=['chair'], threshold=0.35, save_object=False, saved_image_path='detected_objects')
  chair_bbox_result = object_result['detected_objects'][0]['bbox']

  if chair_bbox_result[0][2] < chair_bbox_result[0][1] * 2 or chair_bbox_result[1][2] < chair_bbox_result[1][1] * 2:
    return 'further away'

  text_result = Text_Detector_Tool.execute(image=image, languages=['en', 'de'], detail=0)
  text_result = [i for i in text_result if 'chair' in (str(i)['text'] or (str(i)['bbox'][0] == chair_bbox_result[0] and str(i)['bbox'][1] == chair_bbox_result[1]))].pop()
  
  if text_result:
    return text_result[0]['text']
  else:
    return chair_bbox_result[0][2] * 2 + chair_bbox_result[1][2] * 2

