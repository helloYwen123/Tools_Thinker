from Pixel_Depth_Tool import image_results, video_results

# Load image with empty padding
with open(image_path[0], 'rb') as image_file:
    image_data = image_file.read()
image = Image.open(image_file)

# Detect the objects using object_detector
labels = []
for i in range(1, image.n_frames + 1):
    frame = image[i]
    results = obj_detector.execute(image_path=[image_path[i]], labels=labels, save_object=True)
    label_names = list(results[0].keys())
    for lb in label_names:
        bbox = results[0][lb]['bbox'].numpy()  # Use numpy function
        score = results[0][lb]['score']
        label = lb.split('.')[-1].split('_')[0].capitalize()  # Take the first part of the label name
        boxes = [bbox[1], bbox[3], bbox[2], bbox[4]].astype(int)  # Convert bbox to integer coordinates
        labels.append({'bbox': boxes, 'score': score, 'label': label})

# Calculate the detection result
total_result = {label: [len(labels), len(result['bbox'].numpy())*result['bbox'].numpy().shape[0] if result['bbox'].numpy().shape[0] else len(result['bbox'])] for label in labels}

# Save the detected objects
for img_name, result_dict in total_result.items():
    result_dict['output_image_path'] = 'detected_objects/' + '.'.join(img_name.split('/')[-1].split('.')[:-1]) + '.png'

