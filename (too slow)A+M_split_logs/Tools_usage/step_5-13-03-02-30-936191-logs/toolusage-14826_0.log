def estimate_distances(image_path, labels=['baseball'], show=False, save_output=True):
    objects = []
    object_count = {}
    for label in labels:
        detected_objects = []
        for detection_object in detected_objects:
            if 'bbox' in detection_object:
                x1, y1, x2, y2 = detection_object['bbox']
                detected_object['bbox'] = [x1, y1, x2, y2]
                x1, y1, x2, ey3y = detection_object['bbox']
                detected_object['bbox'] = [x1, y1, x2, ey3y]
            x1, y1, x2, ey3y = detection_object['box']
            if 'score' in detection_object:
                detected_object['score'] = detection_object['score']
                detected_object['box'] = [x1, y1, x2, ey3y]
            if 'bbox' in detected_object:
                box = [x1, y1, x2, ey3y]
                objects.append({'bbox': box, 'label': label, 'score': detected_object['score'], 'saved_image_path': detected_object['saved_image_path']}) 
        if show:
            for key, detections in objects.items():
                print(f'The detected object {key} was found in {detections[0]} with bbox: {detections[0]} and score: {detections[0]["score"]}')
        object_count[label] = len(detections)
        if save_output:
            obj_dict = {'bbox': [[0, 0, 100, 100, 0.9], [50, 50, 150, 150, 0.95]])]}}
            img_folder = "./vis_depth"
            img_results = {'assets/image1.jpg': {'depth_map': detected_object['bbox'][0][:, :, 0], 'output_image_path': Path(img_folder) / Obj_label} for Obj_label in detected_objects}
            if save_output:
                obj_results = {'assets/image1.jpg': {}}
                for key, detections in obj_dict.items():
                    obj_results['assets/image1.jpg'][key] = {'depth_map': detected_object['bbox'][0][:, :, 0], 'output_image_path': Path(img_folder) / Obj_label}
                Pixel_Depth_Tool.execute(image_path='assets/image1.jpg', img_results=obj_results, outdir="/vis_depth")
                return img_results

