# Import necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Define the image path and corresponding labels
image_path = 'path/to/image.png'
label_list = [ 'baseball', 'basket' ]

# Detect text in the image
text_result = Text_Detector_Tool.execute(image=image_path, languages=label_list)

# Convert image result to a list for each label
label_results = []
for label in label_list:
    label_results.append([ [box, text.text, confidence_score] for box, text, confidence_score in text_result.loc[text_result['labels'] == label].iterrows()])

# Convert text results to a string for display
text_results = ""
for label_results_list in label_results:
    text_results += " ".join([f"'{text.text}'" for _, text, confidence_score in label_results_list]) + "\n"

# Print the text results as a string
print(text_results)

# Execute the letter detector
letter_result = Letter_Detector_Tool.execute(image=image_path)

# Convert letter result to a list for display
letter_results = []
for label in label_list:
    letter_results.append([bbox for _, text, confidence_score in letter_result.loc[letter_result['labels'] == label].iterrows()])

# Print the letter results as a string
print(letter_results)
