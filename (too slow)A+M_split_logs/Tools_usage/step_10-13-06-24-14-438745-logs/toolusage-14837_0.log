def analyze_image(input_path):
    detected_objects = object_detector.execute(image=input_path, labels=["baseball", "basket"], save_object=False)
    text_results = text_detector.execute(image=input_path, languages=["en", "de"])
    letter_results = letter_detector.execute(image=input_path)
    
    # Calculate relative distances (y-direction: distance from countertop)
    countertop_distance = 0  # Assume zero for demonstration
    
    # Find the left x-coordinate of the blue square wall painting
    left_paint_x = 0
    box1, box2 = detected_objects[0]["bbox"]
    for i in range(len(detected_objects)):
        lb, rb = detected_objects[i]["bbox"]
        if 'bxmin_x' in detected_objects[i] and 'bxmax_x' in detected_objects[i]:
            left_paint_x = max(rb["bxmin_x"], lb["bxmin_x"]) if 'bxmin_x' in detected_objects[i] else max(rb["bxmax_x"], lb["bxmax_x"])
    
    # Calculate center of the counter
    counter_center_x = detected_objects[0]["bxmax_x"] // 2
    counter_center_y = detected_objects[0]["bxmax_y"] // 2
    counter_width = detected_objects[0]["bxmin_x"] - detected_objects[0]["bxmax_x"]
    counter_height = detected_objects[0]["bxmin_y"] - detected_objects[0]["bxmax_y"]
    
    # Calculate relative depth
    relative_depth = 0
    if "bxmin_x" in detected_objects[0] and "bxmax_x" in detected_objects[0]:
        relative_depth = (left_paint_x - counter_center_x) / (counter_width // 2) + (left_paint_x - counter_center_x - (counter_width // 2)) / (counter_width // 2)
    
    # Return the results
    for i in range(len(detected_objects)):
        if detected_objects[i]["object_name"] == "basket":
            right_bottom_x = rb["bxmax_x"]
            left_top_x = lb["bxmin_x"]
            top_y = detected_objects[i]["bbox_shifted_r"][0][1]
            bottom_y = detected_objects[i]["bbox_shifted_b"][0][1]
            
            detected_object = {
                "bbox": detected_objects[i]["bbox"],
