from object_detector import Object_Detector_Tool

final_result = {}
labels = ['baseball', 'basket']
threshold = 1.0  # Set the confidence threshold
model_size = 'tiny'
save_object = True

detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/input_image', labels=labels, save_object=save_object, saved_image_path='detected_objects')

for label in object_number:
    for obj in object_number[label].values():
        if threshold >= obj['score']:
            if label == 'baseball':
                final_result['B', obj[0], obj[-1]] = 1
            elif label == 'basket':
                final_result['A', obj[0], obj[-1]] = 1
data = {'final_result': final_result}
print(data)

