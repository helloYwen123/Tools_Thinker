from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool

def question_to_answer(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    # Load the image file in an empty list and count the number of detected objects
    detected_objects = {}
    object_number = {'baseball': 0, 'basket': 0}
    
    # Execute the object detection tool with the given parameters
    result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    
    # Iterate through the detected object results and update the object_number dict
    for label, rect in result['detected_objects'].items():
        object_number[label] += 1
    
    final_result = f'''
  The paths of images: {labels}
  The paths of objects: {label}
  The paths of objects detected: {labels}
  The number of detected objects: {object_number}
    '''
    
    return final_result

final_result = question_to_answer('path/to/image.png', ['baseball', 'basket'], save_object=True)
print(final_result)

============================== END ==============================


