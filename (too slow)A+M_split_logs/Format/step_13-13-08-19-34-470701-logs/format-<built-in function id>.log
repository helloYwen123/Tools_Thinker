    import Object_Detector_Tool
    import_letters = Letter_Detector_Tool

    # Retrieve detected objects from the image using Object_Detector_Tool
    detected_objects = Object_Detector_Tool.execute(image=image_path, save_object=False).detected_objects

    # Retrieve detected letters from the image using Letter_Detector_Tool
    detected_letters = Letter_Detector_Tool.execute(image=image_path)

    # Count the number of doorways visible in the scene
    total_doorways = len(detected_objects)

    return total_doorways

