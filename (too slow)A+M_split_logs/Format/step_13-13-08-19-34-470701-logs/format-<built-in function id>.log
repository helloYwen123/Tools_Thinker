from letter_detector import Letter_Detector_Tool

result = Letter_Detector_Tool.execute(image='336_0.png')

depth_images = {}
video_results = {}

for i, detection in result:
    depth = detection[0]
    output_image_path = f'assets/image{i}.png'
    depth_images[output_image_path] = {'depth_map': depth, 'output_image_path': output_image_path}

    if not video_results.get('assets/video{i}.mp4'):
        video_results[output_image_path] = {'video_depth_map': depth.flatten(), 'output_video_path': f'assets/video{i}.mp4'}
    else:
        video_results[output_image_path]['video_depth_map'].append(depth.flatten())

