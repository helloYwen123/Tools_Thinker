def get_num_doors(image_path):
    tool = 'object_detector'
    tool_args = ['image', 'label', 'threshold', 'model_size', 'save_object']
    detector_results = tool.execute(image_path, label=['door'], threshold=0.35, model_size='base', save_object=True)
    door_labels = [label for label in detector_results['total_labels_for_each_label'] if label[1] == 'door']
    num_doors = len(door_labels)
    return num_doors

final_result = get_num_doors('path/to/your_image.png')
print(final_result)
