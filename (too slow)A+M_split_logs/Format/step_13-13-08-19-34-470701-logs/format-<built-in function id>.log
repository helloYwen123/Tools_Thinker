    video_depth_map_path = f'asset/video{len(video_results)+1}.mp4'
    output_image_path = f'assets/video{len(video_results)+1}.img'
    video_results[video_depth_map_path] = {'video_depth_map': video_depth_map, 'output_video_path': output_image_path}

for key, output in video_results.items():
