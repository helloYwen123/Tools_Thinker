from object_detector.object_detector import Object_Detector_Tool

# Sample path of the input image file
input_image_path = "/path/to/input/image.png"

# Specify the labels to detect. In this case, we're detecting two main categories, 'baseball' and 'basket'.
labels = ['baseball', 'basket']

# Set the confidence threshold for detection.
confidence_threshold = 0.35

# Set the size of the model to use.
model_size = "tiny"

# Execute the object detection on the input image
detected_objects = Object_Detector_Tool.execute(image=input_image_path, labels=labels, save_object=False, model_size=model_size, confidence_threshold=confidence_threshold)

# Display the detected objects
print("Detected objects:")
for key, value in detected_objects.items():
    print(f"  {key}: {value}")

# Calculate the distances between the detected objects
distance_basket_to_fridge = (detected_objects['basket'][0]['box'][2] - detected_objects['baseball'][0]['box'][2]) / 2
distance_baseball_to_fridge = (detected_objects['baseball'][0]['box'][2] - detected_objects['basket'][0]['box'][2]) / 2

print(f"Basket distance to fridge: {distance_basket_to_fridge:.2f} meters")
print(f"Baseball distance to fridge: {distance_baseball_to_fridge:.2f} meters")
