import object_detector
import letter_detector
import letter_classifier

def analyze_objects(image_path):
    # Detect letters
    letter_detector_results = letter_detector.execute(image_path=image_path)
    
    # Analyze each letter
    for i, letter_results in enumerate(letter_detector_results):
        if letter_results != []:
            # Extract letter from detection
            letter_detected = letter_results[0][2]
            # Calculate score
            letter_score = letter_detector_results[0].total_scores[i]
            # Add letter to results list
            results[i].append(f"Found '{letter_detected}' letter with score {letter_score}")
    
    # Process detected objects
    object_detector_results = object_detector.execute(image_path=image_path)
    
    # Collect detected objects (excluding letters)
    detected_objects = []
    for i, det_results in enumerate(object_detector_results):
        if det_results != []:
            object_detected = det_results[0][2]
            detected_objects.append(object_detected)
            
            for _, obj in det_results[1]:
                # Extract bounding box from object
                box_coordinates = obj[1].bbox
                # Extract text from object
                text_detected = object_detector_results[0].detect_text(obj[1], text_search=1)

                detected_objects[i].append(f"Found '{object_detected}' with bounding boxes at {box_coordinates} and text detected as '{text_detected}'")
                
    return detected_objects

# Provided image path
