def get_dining_table_positions(image_path, target_dining_table_pos=None):
    # Read the image
    image = Object_Detector_Tool.execute(image=image_path)

    # Display the image
    obj_detector_tool.display_detections(image, show=True)

    # Count the number of objects in the image
    detected_objects = {}
    for label in target_dining_table_pos:
        detected_objects[label] = len(image[label])

    # Return the object counting dictionary
    return detected_objects

final_result = get_dining_table_positions('path_to_your_image.png', {'A': 3, 'B': 4, 'C': 2})
print(final_result)
</command>
