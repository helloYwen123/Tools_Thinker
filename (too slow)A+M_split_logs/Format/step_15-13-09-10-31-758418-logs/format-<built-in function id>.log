from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['float_countertop', 'door', 'window'], save_object=False, saved_image_path='detected_objects')

if final_result[0]['save_object']:
    # Save detected object images
    for label, entries in final_result[0].items():
        for entry in entries:
            entry['saved_image_path'] = 'detected_objects/' + label + '_' + entry['name'] + '_1.png'
else:
    print("Failed to detect objects.")
