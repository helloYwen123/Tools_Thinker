def draw_object(image, label, bbox, score):
    img = cv2.rectangle(image, bbox, (bbox[0][0]+5, bbox[0][1]+5), (0,0,255), cv2.FILLED)
    img = cv2.putText(img, str(score), (bbox[0][0]+10, bbox[0][1]+10), cv2.FONT_HERSHEY_SIMPLEX, 1, (0,0,150), 2)
    img = cv2.rectangle(image, (bbox[0][0],bbox[0][1]), (bbox[0][0] + 150, bbox[0][1] + 150), (0,255,0), 3)
    img = cv2.rectangle(image, (bbox[0][0] + 150, bbox[0][1]), (bbox[0][0] + 300, bbox[0][1] + 300), (255,255,0), 3)
    return img
