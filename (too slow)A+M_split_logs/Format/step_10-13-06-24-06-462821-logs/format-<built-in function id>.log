def get_object_distances(image_paths):
    """
    Returns a dictionary with detected object labels and their coordinates.
    """
    
    detected_objects_by_label = {}
    object_number = {}
    
    for image_path in image_paths:
        result = Object_Detector_Tool.execute(image=image_path, save_object=True)
        
        if result:
            for label, detection in result['detected_objects']:
                detected_objects_by_label[label] = detected_objects_by_label.get(label, []) + [detection['bbox']]
                object_number[label] = object_number.get(label, 0) + 1
                
    return detected_objects_by_label, object_number

def get_letter_positions(image_path):
    """
    Returns a list of positions where letters appear in the image.
    """
    
    letter_positions = []
    
    for label, bounding_box in image_objects.items():
        if "letter" in label.lower():
            letter_positions.append([
                bounding_box['bbox'][0],
                bounding_box['bbox'][1],
                bounding_box['bbox'][2],
                bounding_box['bbox'][3]
            ])
    
    return letter_positions

