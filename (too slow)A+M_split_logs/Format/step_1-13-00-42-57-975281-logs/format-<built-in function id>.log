# Python program to detect objects in a room image based on visual inputs

import image_utility_tool

def detect_objects(image_path):
    # Detect objects and save individual object images with empty padding
    detected_object_results = image_utility_tool.object_detector.execute(
        image=image_path, labels=[['baseball'], ['basket']], save_object=True)
    
    # Extract relevant objects and create final_result dictionary
    final_result = {}
    for label in ["baseball", "basket"]:
        objects_with_label = detected_object_results["object_number"][label]
        total_objects = detected_object_results["object_number"].values().sum()
        
        detected_objects_with_label = []
        for i, result in enumerate(detected_object_results["detected_objects"]):
            if label == result["label"]:
                detected_objects_with_label.append(result)
        
        if total_objects > 0:
            detected_objects_with_label.sort(key=lambda obj: (obj["bbox"][1] - obj["bbox"][3], obj["bbox"][2] - obj["bbox"][0] + 1, (obj["bbox"][2] - obj["bbox"][0] + 1, obj["bbox"][3] - obj["bbox"][1] + 1)), reverse=True)
        
        detected_objects_with_label_info = []
        for obj in detected_objects_with_label:
            detected_objects_with_label_info.append({
                "label": label,
                "bbox": obj["bbox"],
                "score": detected_object_results["object_number"][label],  # Use score from object_detector tool
                "result_file_path": f"detected_objects/{label}_result_{{:,}}.png"
            })
        
        detected_objects_with_label_info.sort(key=lambda obj: (obj["bbox"][1] - obj["bbox"][3], obj["bbox"][2] - obj["bbox"][0] + 1, (obj["bbox"][2] - obj["bbox"][0] + 1, obj["bbox"][3] - obj["bbox"][1] + 1)), reverse=True)
        
        final_result[label] = {"objects": detected_objects_with_label_info}
        
    return final_result

# Usage example
input_path = "/path/to/your-image.jpg"
results = detect_objects(input_path)
print(results)
