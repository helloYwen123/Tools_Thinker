def detect_objects(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    if save_object:
        detected_objects = {}
        object_number = {'baseball': 0, 'basket': 0}
        with open(saved_image_path, 'w') as f:
            f.write('')

        for label in labels:
            for bbox in detected_objects[label]:
                for detection in detected_objects[label]:
                    if bbox[0] <= detection[0] and detection[2] >= bbox[2] and bbox[1] <= detection[1] and detection[3] >= bbox[3]:
                        detected_objects[label].append(detection)
                        detected_objects[label].reverse()
        detected_objects = {**detected_objects}
        for label in detected_objects:
            object_number[label] = len(detected_objects[label])
        print("detected_objects : ", detected_objects)
        print("object_number : ", object_number)
    else:
        with open(saved_image_path, 'w') as f:
            f.write('')

detect_objects(image_path='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
