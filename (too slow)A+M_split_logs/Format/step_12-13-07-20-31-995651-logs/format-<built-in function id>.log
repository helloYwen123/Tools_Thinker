import Object_Detector_Tool

def detect_doorways(image_path):
    detected_objects = Object_Detector_Tool.execute(image_path, labels=['Doors'], save_object=True)
    
    if detected_objects:
        total_objects = len(detected_objects['Doors'][0][0])
        
        return total_objects
    else:
        return 0

# Check the image path
