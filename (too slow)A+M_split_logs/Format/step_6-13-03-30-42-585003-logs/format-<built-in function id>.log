# Import necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from Letter_Detector_Tool import Letter_Detector_Tool

# Function to count objects in an area based on given labels
def count_objects_in_area(image_path, labels, threshold=0.35, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    if detected_objects:
        detected_objects = {k: v["scores"] for k, v in detected_objects.items()}
    else:
        detected_objects = {}
    if object_number:
        object_number = {obj["label"]: obj["count"] for obj in object_number}
    else:
        object_number = {}
    return detected_objects, object_number

# Import text from image
text_detected = Text_Detector_Tool.execute(image_path=image_path, languages=["en", "de"],
    detail=1)

# Import letters from image
