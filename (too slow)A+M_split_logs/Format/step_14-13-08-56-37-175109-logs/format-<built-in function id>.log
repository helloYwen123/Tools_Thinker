<command>
from object_detector import Object_Detector_Tool

from numpy import pi

def estimate_distance_and_label(obj_name, detected_objects):
    distance_c = detected_objects[0]['bbox']['x2'] - detected_objects[0]['bbox']['x1']
    distance_b = detected_objects[0]['bbox']['y2'] - detected_objects[0]['bbox']['y1']

    distance_c = distance_c / pi
    distance_b = distance_b / pi

    distance = distance_c + distance_b

    if obj_name == 'Basket':
        return {'distance': distance}, 1
    elif obj_name == 'Baseball':
        return {'distance': distance}, 2
    else:
        return {}, 0

final_result = estimate_distance_and_label('Baseball', detected_objects)

print("The estimated distance is %.0f meters" % final_result['distance'])
print("Has a baseball?")
if final_result["distance"] >= 1:
    print("Yes")
else:
    print("No")
</command>
