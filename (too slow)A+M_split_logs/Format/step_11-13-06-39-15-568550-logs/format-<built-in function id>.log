--- Completion 8 ---
<command>
from Pixel_Depth_Tool import execute

def detect_chairs(image_path, chairs_count):
    results = execute(mode='image', image_path=[image_path], output=True)
    chair_count = 0
    detected_objects = []
    for result in results:
        for obj in result['objects']:
            if obj['label'] == 'Chair':
                detected_objects.append(obj)
                chair_count += 1
                break
    final_result = {'chair_count': chair_count} if chair_count > 0 else {}
    final_result['chair_count'] = chair_count
    return detected_objects, final_result
</command>
