<command>
from object_detector import Object_Detector_Tool

final_result = {
    "left": False,
    "right": False
}

if True:
    image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/7898_0.png'
    labels = ["U-shaped countertop", "l-shaped countertop", "sink"]
    threshold = 0.5
    model_size = 'tiny'
    save_object = False

    # Use Object_Detector_Tool to find objects in the image
    result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

    # If text detection passes after retries (with more than 5 attempts), extract bounding box, text, and confidence score
    if result > 5 and isinstance(result[0].get("bbox"), tuple) and result[0].get("bbox") and result[0].get("bbox")[2] <= 250 and result[0].get("bbox")[3] <= 300:
        text_confidence = max([bbox[1] / 800 for bbox in result[0].values()])

        final_result["left"] = True
        final_result["right"] = False

        if text_confidence > 0.2:
            for object_info in result.values():
                text_info = object_info["saved_image_path"].split('/')[-1].split('.')[0]
                final_result["left"] = final_result["left"] or "U-shaped countertop" in text_info
    else:
        print("Failed to detect object. Reason:", "Failed to process the image after retries.")

    # If text detection passes after retries, extract bounding box, text, and confidence score
    if final_result["right"] == False:
        if final_result["left"] == True and isinstance(final_result.get("left", None), tuple) and final_result.get("left") and (
                final_result.get("left")[0] <= 150 and final_result.get("left")[3] <= 250):
            text_confidence = max([bbox[1] / 800 for bbox in result[0].values()])

            final_result["right"] = True

            for object_info in result.values():
                text_info = object_info["saved_image_path"].split('/')[-1].split('.')[0]
                final_result["right"] = final_result["right"] or "U-shaped countertop" in text_info
        else:
            print("Failed to process the image after retries.")

if final_result["left"] == final_result["right"]:
    final_result["left"] = final_result["right"] = False
elif final_result["left"] == True or final_result["right"] == True:
    final_result["right"] = final_result["left"] = False
else:
    final_result["left"] = final_result["right"] = False

print(final_result)
</command>
