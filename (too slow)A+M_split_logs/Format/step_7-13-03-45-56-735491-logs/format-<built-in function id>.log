def count_counter_tops(image_path):
    import Object_Detector_Tool
    import Text_Detector_Tool

    object_results = Object_Detector_Tool.execute(image_path, labels=["CounterTop", "Shelf"], threshold=0.35, model_size="tiny")
    object_count = {label: object_results["object_number"]["CounterTop"] + object_results["object_number"]["Shelf"]} # Check if a counter-top was detected in each shelf. A counter-top is detected at any point in the image.

    # The image is divided into counters (countertops) within the shelves. Counters are detected outside the shelves.
    object_results = object_results["output_objects"]

    counter_tops_number = len(object_results["list_counts"]['CounterTop'])

    detected_objects = []

    for box in object_results["detected_objects"]:
        box["bbox"] = [box["bbox"][0], box["bbox"][1], box["bbox"][2], box["bbox"][3]]

        # Check if the box is a counter-top and the bounding box is in the correct position in the shelves.
        if counter_tops_number <= (box["bbox"][0] + (box["bbox"][2] / 2)) and ((box["bbox"])[0] - (box["bbox"])[1] < box["bbox"][2] / 2) & ((box["bbox"])[0] // box["bbox"][3] >= 0) and ((box["bbox"])[0] // box["bbox"][3] > -1) and ("CounterTop" in object_results["output_objects"][box["bbox"]]["data"]["label"]) :
            detected_objects.append(box)

    return Counter_tops_number, detected_objects

