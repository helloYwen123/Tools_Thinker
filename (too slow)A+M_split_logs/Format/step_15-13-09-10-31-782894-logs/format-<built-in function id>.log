from object_detector import Object_Detector_Tool
import numpy as np

model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

# Load the image
file_path = 'path/to/image.png'  # Change this to the actual file path of your image
image = np.array(Image.open(file_path))

# Detect the bed in the image
detections = Object_Detector_Tool.execute(
    image, labels=['bed'], save_object=save_object, saved_image_path=saved_image_path)

if detections:
    # Get the bounding box and coordinates of the bed
    bed_bb = detections['bed'][0]['box']

    # Check if the bed is within the bounding box
    if bed_bb[0] < 0 or bed_bb[2] > image.shape[1] or bed_bb[1] < 0 or bed_bb[3] > image.shape[0]:
        print("Bed is not within the bounding box of the image.")
        return

    # Detect the dog in the image
    detected_object_count = [d['bbox'] for d in detections['bed'][0]['detected_objects']]

    if len(detected_object_count) == 0:
        print("No dog detected in the image.")
        return

    print(f"{detected_object_count} dog(s) were detected.")
else:
    print("Could not detect any objects in the image.")

This Python program uses the `object_detector` tool to detect objects in an image. It specifically looks for a bed in the image and checks its bounding box coordinates to ensure it is within the image. The program then detects objects inside the bed using the `detect_objects` function and counts the number of each detected object. The results are printed to the console.
