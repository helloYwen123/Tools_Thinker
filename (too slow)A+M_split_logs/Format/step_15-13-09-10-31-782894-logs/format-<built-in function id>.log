def find_beds(image_path):
    # Load the image
    img = Image.open(image_path)

    # Detect objects
    results = object_detector(image=img, labels=['Bed'], save_objects=True)

    # Count the number of beds
    bed_count = len(results['object_number'].keys())

    # Print the final answer
    final_result = f"1 Bed\n"
    if bed_count == 1:
        final_result += f"{bed_count}床.\n"
    if bed_count > 1:
        final_result += f"{bed_count}-bed.\n"

    return final_result

final_result = find_beds('path/to/image.png')
print(final_result)
