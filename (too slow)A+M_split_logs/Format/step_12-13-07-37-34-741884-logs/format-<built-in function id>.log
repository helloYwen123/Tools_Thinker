from object_detector import Object_Detector_Tool

detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['books'], save_object=True, saved_image_path='detected_objects')

if detected_objects:
    book_boxes = [obj['bbox'] for obj in detected_objects['baseball']['bbox']]

    # Calculate the number of books
