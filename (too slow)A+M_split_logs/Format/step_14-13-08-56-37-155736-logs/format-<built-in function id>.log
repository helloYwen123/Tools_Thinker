from pixel_level_depth_estimator import Pixel_Depth_Tool

# Execute the tool with input image paths
depth_results = Pixel_Depth_Tool.execute(image_path=['path/to/0.jpg', 'path/to/1.jpg'], output=True, outdir='./vis_depth')

# Check if the tool failed to detect any images
if not 'depth_results' in globals():
  final_result = "0"
else:
  # Extract the detected objects
  detected_objects = Pixel_Depth_Tool.get_results_by_output(output=True, outdir='./vis_depth')

  # Count the number of detections
  object_number = {}

  for image_path in detected_objects.keys():
    label = detected_objects[image_path]['label']
    num_detections = detected_objects[image_path].get('num', 0)
    object_number[label] = num_detections

  # Convert the object_count_dict to a string
  object_number_str = str(object_number)

  # Final result
  final_result = object_number_str

# Print the final result (as an integer)
print(final_result)
