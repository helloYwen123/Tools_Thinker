import object_detector  # Import the object_detector tool
import letter_detector  # Import the letter_detector tool
import pixel_depth_estimator

def calculate_distance(object1, object2):
    return max((o.distance(object1) for o in object2))

def find_closest_object(image_path, objects, languages=['en', 'de']):
    detector = letter_detector.LetterDetector_Tool()
    results = []
    for obj_name, lb in objects.items():
        lb['bbox'] = [int(o.bbox[0]) for o in lb['bbox']]
        lb['text'] = []
        for l in lb['languages']:
            lb['languages'].append(('x' + l, 'y' + l))
        lb['bbox'] = object_detector.detected_objects(image_path=image_path, labels=lb['bbox'], model_size='tiny', save_object=False, saved_image_path='detected_objects')['bbox']

        for obj in lb['bbox']:
            box = (obj['x'], obj['y'], obj['x'] + obj['width'], obj['y'] + obj['height'])
            detector.detect_letter(image_path=image_path, bounding_box=box, confidence_threshold=None)
            distances = []
            for letter, line in lb['languages']:
                letter_width = detector.find_text_rectangle(letter, (0, 0), (box[0] + box[2], box[1] + box[3]))
                distances.append(abs(box[0] - box[1] + letter_width[0]) * calculate_distance(image_path=image_path, object1=lst[0][3:], object2=lst[1][3:], languages_languages=languages))
            nearest_index = min(range(len(distances)), key=lambda i: distances[i])
            lb['bbox'][nearest_index] = object_detector.detected_objects(image_path=image_path, labels=lb['bbox'][nearest_index], model_size='tiny', save_object=False, saved_image_path='detected_objects')['bbox'][nearest_index]
            results.append(lb)
    return objects

def find_closest_color(image_path, objects, lang):
    lst = []
    for obj_name, l in objects.items():
        for lb in l['bbox']:
            if lb['text']:
                lst.append((obj_name, lb['language'][0], lb['bbox'][0], lb['bbox'][1]))
    object_name, language, x1, x2 = min(lst), min(l['bbox'].index((x1, y1)), max(l['bbox'].index((x2, y2))))
    image_info = object_detector.detected_objects(image_path=image_path, labels=lb, model_size='tiny', save_object=False, saved_image_path='detected_objects/')
    return (image_path, language, x1, x2, image_info)

def print_results(final_result, object_type, object_type_name):
    if object_type == 'bbox':
        print(f'{object_type_name.capitalize()}s: {final_result[0][0].keys()}')
    elif object_type == 'text':
        print(f'{object_type_name.capitalize()}s: {final_result[0][0].keys()}')
    elif object_type == 'image':
        print(f'# ({image_info[0].get("filename", "")}) [{language}]', final_result[0][0])
    else:
        print(f'No {object_type_name} detected in the image')

object1 = {
'detection_results': [{'bbox': ((302, 67, 466, 28), {'language': 'en', 'score': 0.97}), {'bbox': ((170, 25, 261, 77), {'language': 'de', 'score': 0.85})}, {'bbox': ((336, 58, 445, 213), {'language': 'en', 'score': 0.83}, {'bbox': ((450, 100, 549, 350), {'language': 'en', 'score': 1.0})})}, ...]},
'bbox': [(bbox, ...) for bbox, lst in final_result[0][0].values() for lst in lst['bbox']],
}
objects = find_closest_object(image_path=image_path, objects=final_result[0][0], languages=['en', 'de'])
image_path, language, x1, x2, detected_objects_info = find_closest_color(image_path=image_path, objects=objects, lang='en')

print_results(detected_objects_info, 'text', 'text')
print_results(detected_objects_info, 'bbox', 'bbox')
print_results(detected_objects_info, 'image', 'image')
