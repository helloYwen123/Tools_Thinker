def count_object(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    detected_objects = {}
    object_number = {}
    for label in labels:
        result = None
        for retries in range(3):
            try:
                result = Object_Detector_Tool.execute(image=image_path, labels=[label], save_object=save_object, saved_image_path=saved_image_path)            
                if result:
                    detected_objects[label] = [bbox, score] for bbox, score in result['bbox'] if label in bbox
                else:
                    break
            except Exception as e:
                print(f"Error processing the label '{label}' with image '{image_path}. Check logs for details.")                    
                print(e)
                break
        if result is not None:
            object_number[label] = len(detected_objects[label])
    return detected_objects, object_number

detected_objects, object_number = count_object("path/to/image.png", ["baseball", "basket"], save_object=True)

for label, boxes in sorted(detected_objects.items(), key=lambda item: item[1][0]):
    print(f"{label}: {boxes}")
