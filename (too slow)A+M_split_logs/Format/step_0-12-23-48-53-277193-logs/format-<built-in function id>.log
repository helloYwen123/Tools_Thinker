def count_laptops(image_path):
    detected_objects = {}
    object_number = {}
    try:
        with open(image_path, 'r') as f:
            lines = f.readlines()
            image_content = [line.strip() for line in lines]
        text_objects = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])[0]
        for obj in text_objects:
            object_id = obj[2]
            if object_id in detected_objects:
                object_list = detected_objects[object_id]
                if 'box' in obj:
                    object_list.append([x for x in obj if x not in object_list[0].box])
                elif 'score' in obj:
                    object_list.append([x for x in obj if x['score'] > 0])
                else:
                    object_list.append([x for x in obj] if object_list else [obj])
            else:
                object_list = [obj]
            detected_objects[object_id] = object_list

            try:
                image_results = Pixel_Depth_Tool.execute(output=True, outdir='./vis_depth', image_path=image_path)
                if 'depth_map' in image_results:
                    detected_objects[object_id].extend(image_results['assets/depth_map'])
            except FileNotFoundError:
                continue
    except FileNotFoundError:
        return {'count': 0, 'objects': []}
    result = {}
    for obj_id in detected_objects:
        if 'bbox' in obj_id:
            x1, y1, x2, y2 = detected_objects[obj_id][0]
            x3, y3 = detected_objects[obj_id][1]
            x4, y4 = detected_objects[obj_id][2]
            x5, y5 = detected_objects[obj_id][3]
            detected_objects[obj_id].pop()
            result[obj_id] = [x1, y1, x2, y2, x3, y3, x4, y4, x5, y5]
    return {'count': len(detected_objects), 'objects': result}

final_result = count_laptops('path_to_image.jpg')
print(final_result)
