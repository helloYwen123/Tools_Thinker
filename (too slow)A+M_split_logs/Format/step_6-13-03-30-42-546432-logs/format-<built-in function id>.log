            image_results = Pixel_Depth_Tool.execute(image_path=image_path, outdir= '.', mode= 'image')
            result.extend(image_results)
            
        if mode == 'video' and image is not False and video_path is not False and image_path.endswith('mp4') and len(image_path) > 50:  # Assuming the command only works with specified video paths
            video_results = Pixel_Depth_Tool.execute(image_path=image_path, outdir= '.', mode= 'video')
            if mode == 'video':
                for video in video_results:
                    result.append({"video_depth_map": [video['video_depth_map'][j][i] for j in range(len(video['video_depth_map'])) for i in range(len(video['video_depth_map'][j]))]})

        if result:
            final_result = str(result)
        else:
            final_result = "No detected objects in the specified image."

    return final_result

