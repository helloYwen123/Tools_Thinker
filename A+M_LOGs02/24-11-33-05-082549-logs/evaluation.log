def count_reflected_people(image_path):
    model = 'tiny'
    threshold = 0.3
    detection = tool.execute(image=image_path, labels=['person'], threshold=threshold, model_size=model, padding=0)
    if detection:
        detected_objects = detection['output_type'][0]
        number_people = len([obj for obj in detected_objects if obj['label'] == 'person'])
        return number_people
    else:
        return 0

