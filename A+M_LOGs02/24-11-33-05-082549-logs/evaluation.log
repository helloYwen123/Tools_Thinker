Code: def count_people(image_path, threshold=0.5, model_size="tiny", padding=20):
    import object_detector_tool

    # Load the model from the provided path
    execution = object_detector_tool.execute(image_path=image_path,
                                              labels=["person"],
                                              threshold=threshold,
                                              model_size=model_size,
                                              padding=padding)

    # Filter the detected people based on their bounding boxes
    people = [obj for obj in execution[0] if "person" in obj.keys()]

    # Count the detected people
    count = len(people)

    return count

# Provided image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_75_image_1.jpg"

