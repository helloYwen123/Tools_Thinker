def get_cupcake_price(image_path, woman_model_id, cupcake_model_id):
    detection_result = object_detector_tool.execute(
        image_path,
        woman_model_ids=[woman_model_id, cupcake_model_id],
        threshold=0.55
    )

    # Determine if the woman is holding a cupcake
    cupcake_model = image_reconstructor.find_model(name="cupcake")
    cupcake_location = detection_result["boxes"]

    if cupcake_model and cupcake_location:
        cupcake_location_y = cupcake_location[0][2]
        cupcake_location_x = cupcake_location[0][0]
        cupcake_location_height = cupcake_model["bbox"][2] - cupcake_model["bbox"][0]
        cupcake_location_width = cupcake_model["bbox"][1] - cupcake_model["bbox"][3]
        cupcake_distance_y = cupcake_location_y - cupcake_location_height / 2.0
        cupcake_distance_x = cupcake_location_x
        cupcake_height = cupcake_location_height / 2.0
        cupcake_width = cupcake_location_width
    else:
        cupcake_distance_y = cupcake_location_height / 2.0
        cupcake_distance_x = cupcake_location_x
        cupcake_height = cupcake_location_height
        cupcake_width = cupcake_location_width

        # No cupcake detection found
        return False

    if woman_model_id == "woman":
        cupcake_price = 3.00
    elif cupcake_model == "cupcake":
        cupcake_price = 2.00
    else:
        cupcake_price = False

    return cupcake_price

