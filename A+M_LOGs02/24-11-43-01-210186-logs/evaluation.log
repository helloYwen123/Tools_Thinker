def count_green_jackets(image_path, labels=['jacket', 'green']):
    detected_objects = []
    for label in labels:
        count = 0
        for obj in detected_objects:
            if obj['label'] == label and obj['confidence score'] > 0.3:
                count += 1
        for obj in detected_objects:
            if obj['label'] == label and obj['confidence score'] < 0.3:
                detection_count -= 1
        detected_objects.append({'label': label, 'confidence score': obj['confidence score'], 'box': obj['box'], 'saved_image_path': obj['saved_image_path']})

    total_green_jackets = sum([1 for obj in detected_objects if obj['label'] == 'jacket' and obj['confidence score'] > 0.3])
    final_result = {"green_jackets": total_green_jackets, "total_objects": len(detected_objects), 'image_path': image_path}
    
