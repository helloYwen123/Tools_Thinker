def count_people_wearing_green_jacket(image_path: str, color: str) -> int:
    # Load the image
    image = Image.open(image_path)

    # Use the object detector tool to detect the green jacket
    output = object_detector_tool.execute(image_path=image_path, labels=["green_ jacket"], threshold=0.35, padding=20)

    for item in output:
        if item['label'] == "green_jacket":
            # Count the number of green-jacketed individuals
            count = int(item['confidence score'])

    return count

def get_nof_green_jacket_people(image_path: str) -> int:
    # Load the image
    image = Image.open(image_path)

    # Use the object detector tool to detect the green jacket
    output = object_detector_tool.execute(image_path=image_path, labels=["green_ jacket"], threshold=0.35, padding=20)

    # Count the number of green-jacketed individuals
    count = int(sum(item['confidence score'] > 0.35 for item in output))

    return count

