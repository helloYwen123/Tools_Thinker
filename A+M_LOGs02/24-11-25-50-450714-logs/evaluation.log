Code: from object_detector_tool import tool

def count_people(image_path):
    # Load the image
    image = tool.execute(image=image_path, labels=["car", "person"], threshold=0.35, model_size="base", padding=15)

    # Get the coordinates of all detected persons
    all_persons = []
    for person in image:
        x, y, w, h = person["bbox"]
        all_persons.append((x, y, w, h, person["label"]))

    # Sort the persons by x coordinate in ascending order
    all_persons.sort(key=lambda x: x[0])

    # Get the number of people
    person_count = len(all_persons)

    return person_count

# Get the image path
