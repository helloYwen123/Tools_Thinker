def count_people_driver_image(image_path):
    detector = ObjectsDetector()
    detection_result = detector.execute(image_path)
        
    people_in_car = [
        obj for obj in detection_result[0].values()
        if obj['label'] == 'person' and 'person' in obj and obj['confidence'] > 0.35
    ]
    
    if people_in_car:
        driver_count = len(people_in_car)
        final_result = f"人数: {driver_count}"
    else:
        final_result = "人数: 0"
    
    return final_result

