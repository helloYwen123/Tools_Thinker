# Function to count people and cars
def count_vehicle_types(image, labels=["car", "person"], threshold=0.5, model_size="base", padding=20):
    def check_label(label):
        if label == "car" or label == "person":
            return True
        return False

    detection = tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    count_car = 0
    count_person = 0

    for obj in detection:
        if check_label(obj['label']):
            if obj['label'] == "person" and obj['confidence_score'] >= 0.7:
                count_person += 1
            elif obj['label'] == "car" and obj['confidence_score'] >= 0.3:
                count_car += 1
                
    return count_car, count_person

