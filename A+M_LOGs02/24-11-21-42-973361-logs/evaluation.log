Code: def count_people(image_path):
    import pytesseract

    # Load the image file
    image = pytesseract.image_to_string(open(image_path).read(), config='--psm 9')

    # Split the image into lines using the newline character
    lines = image.split('\n')

    # Initialize a counter for the number of lines containing "person"
    count = 0

    # Iterate through each line of the image
    for line in lines:
        # Check if the line contains the word "person"
        if 'person' in line:
            # Increase the counter if the line contains "person"
            count += 1

    return count

