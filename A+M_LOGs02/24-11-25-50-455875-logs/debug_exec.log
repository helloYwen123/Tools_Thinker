def people_driving_white_motorcycle(white_motorcycle_img):
    import object_detector_tool
    detection_result = object_detector_tool.execute(image=white_motorcycle_img, labels=["baseball"], threshold=0.9)
    people_in_white_motorcycle = [obj for obj in detection_result['output_type'] if obj[0] == "person"]
    print("Number of people driving white motorcycle:", len(people_in_white_motorcycle))
    return len(people_in_white_motorcycle)
