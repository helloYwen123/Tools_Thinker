def detect_parking_meters(input_image, labels, threshold=0.7):
    # Load the ground-dino model for object detection
    from object_detector_tool import Object_Detector_Tool
    detection_tool = Object_Detector_Tool()

    # Detect parking meters in the garden
    for parking_meter in detection_tool.execute(image=input_image, labels=labels, threshold=threshold, model_size=None):
        # Check if the parking meter is located near the flower garden
        if parking_meter['predicted_label'] == 'parking meter':
            return True
    return False

