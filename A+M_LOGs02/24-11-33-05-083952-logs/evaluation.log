Code: def count_people_carrying_tennis_rackets():
    # Load the image and get object labels
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_92_image_1.jpg"
    execution = tool.execute(image=image_path, labels=["tennis racket"])
    
    # Get all object paths as paths
    all_paths = []
    for obj in execution[1]:
        all_paths.append(obj['saved_image_path'])
    
    # Filter the paths according to the threshold
    filtered_paths = []
    for path in all_paths:
        if "tennis racket" in path:
            filtered_paths.append(path)
    
    # Convert the paths to strings
    filtered_paths = [x for x in filtered_paths]
    
    # Count the number of tennis racket paths as count
    count = len(filtered_paths)
    
    return count

final_result = count_people_carrying_tennis_rackets()
print(final_result)

