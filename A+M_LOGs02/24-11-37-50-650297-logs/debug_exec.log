code:from object_detector_tool import object_detections_dino  # Import the Object_Detection_Tool class

def count_people_playing_tennis(image_path):
    # Load the detection tool
    detection_tool = object_detections_dino(image_path=image_path)

    # Detect the players in the image
    detected = detection_tool.detect()

    # Get the labels and their confidence scores for players
    player_labels = [det['label'] for det in detected]
    confidence_scores = [det['confidence'] for det in detected]

    # Initialize counters for visible and visible_and_hidden
    visible_count = 0
    visible_and_hidden_count = 0

    # Loop through detected players
    for label, confidence in zip(player_labels, confidence_scores):
        # Check if player is visible in the image
        if conf = confidence_scores.label == 'baseball':
            visible_count += 1

        elif conf < 0.8:
            # If player is visible, increment the 'visible_and_hidden_count' 
            visible_and_hidden_count += 1

    return [visibility_count, visible_and_hidden_count]

