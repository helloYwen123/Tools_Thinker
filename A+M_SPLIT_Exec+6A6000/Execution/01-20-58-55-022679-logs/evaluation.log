Code: from object_detector import Object_Detector_Tool

# Get the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_31_image_1.jpg"

# Create an Object_Detector_Tool instance
detector = Object_Detector_Tool()

# Execute the detection.
labels = ["baseball", "basket"]
confidence_threshold = 0.45
model_size = "tiny"
saved_object = False
detected_objects, object_number = detector.execute(image_path, labels, confidence_threshold, model_size, saved_object, image_path)

# Check whether the tennis ball was detected
if "baseball" in detected_objects:
    no_of_green_train_carts = detected_objects["baseball"]["boxes"][0]["y_max"]
else:
    no_of_green_train_carts = 0

print("Number of green train carts in the picture:", no_of_green_train_carts)
final_result = no_of_green_train_carts

