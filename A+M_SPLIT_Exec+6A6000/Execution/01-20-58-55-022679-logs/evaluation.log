# Detect and count train carts
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path,
                                                                  labels=['green'],
                                                                  save_object=True,
                                                                  saved_image_path="detected_objects")

# Extract the detected objects into a dictionary
detected_objects['detected_images'].clear()  # Clear the existing detected images dictionary
for label in detected_objects['detected_images']:
    detected_objects['detected_images'][label['label']] = {
        'boxes': label['boxes'],
        'confidence_scores': label['confidence_scores'],
    }

# Count the green train carts
for train_carts in detected_objects['detected_images']:
    for img in detected_objects['detected_images'][train_carts]:
        for bbox in img['boxes']:
            if bbox['confidence_scores'] >= 0.45:
                visible_cart = {'bbox': label['bbox'], 'model_name': 'train', 'cart_number': int(bbox['label'])}
                if visible_cart not in final_result['detected_images']:
                    final_result['detected_images'][train_carts].append(visible_cart)
                    final_result['object_count'] += 1

# Save the results to a dictionary for demonstration
final_result = {'detected_images': final_result['detected_images'],
                'object_count': final_result['object_count']}

