from object_detector import Object_Detector_Tool

def answer_image_question(image_path, labels, threshold, model_size='tiny', save_object=True, saved_image_path='detected_objects'):
    # Load the image
    object_detector = Object_Detector_Tool()
    objects, object_number = object_detector.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

