from object_detector import Object_Detector_Tool

# Load the image
input_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_67_image_1.jpg"
labels = ["baseball", "basket"]
threshold = 0.45
model_size = "tiny"
save_object = True

# Use the object_detector tool to detect faces
final_result = Object_Detector_Tool.execute(input_image_path, labels, threshold, model_size, save_object, saved_image_path="detected_objects")

# Extract the number of white umbrellas from the tool output
if isinstance(final_result, tuple):
    labels = [label for label in final_result[0].keys() if label not in labels]
    detected_objects = final_result[0]
    boxes = [boxes for labels, boxes in detected_objects.items() if label == "baseball"]
    confidence_scores = [confidence_scores for _, confidence_scores in detected_objects.items() if label == "baseball"]
    white_umbrellas = [box for box in boxes for idx, (box, score) in enumerate(zip(confidence_scores, boxes))]
    if debug:
        print("White umbrellas detected:", white_umbrellas)
else:
    print("No detected objects detected.")

