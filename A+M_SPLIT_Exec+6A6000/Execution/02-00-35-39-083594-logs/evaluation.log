Code: from object_detector import Object_Detector_Tool

# Load the image
# Load the list of labels to detect (assuming they are in "baseball" and "basket")
labels = ["baseball", "basket"]

# Set the threshold and model size (if not provided, the base model will be used)
threshold = 0.45
model_size = "base"

result = Object_Detector_Tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_10_image_1.jpg", labels=labels, save_object=True, threshold=threshold, model_size=model_size)

# Check if the object detection was successful
if result[0] is None:
    print("Object detection was unsuccessful.")
else:
    # Extract the counts for each detected label
    counts = {}
    for label in result[0]:
        count = result[0][label]["count"]
        counts[label] = count

    # Print the counts for 'baseball' and 'basket'
    print("Counts for 'baseball':")
    print(counts["baseball"])
    print("\nCounts for 'basket':")
    print(counts["basket"])

