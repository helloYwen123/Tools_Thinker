Code: from object_detector import Object_Detector_Tool

# Example image path
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_110_image_1.jpg'

# Initialize the Object_Detector_Tool
detector = Object_Detector_Tool(image_path)
labels = detector.process()

# Define the number of red bikes
num_red_bikes = 0

# Check if any red bikes are detected
for label in labels.values():
    if label['label'] == 'red_bike':
        if label['boxes']:
            for box in label['boxes']:
                if 'red_bike' in [i['label'] for i in box['grouped_result']]:
                    num_red_bikes += 1

# Final result
final_result = {'num_red_bikes': num_red_bikes}
print('Final result:', final_result)

