Code: from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_110_image_1.jpg"

# Check if the tool is available
available_tool = object_detector.detect_available_tool('Object_Detector_Tool')

if available_tool is not None:
    try:
        # Execute the object detection
        result = Object_Detector_Tool.execute(image=image_path, labels=["baseball", "basket", "motorcycle", "car"], save_object=True, saved_image_path="detected_objects")
        
        # Get the total count of detected objects for the label 'motorcycle'
        counted_objects = result['objects']['motorcycle']
        
        # Check if there are any motorcycle-like objects in the image
        motorcycles = {k for k, v in counted_objects.items() if 'motorcycle' in v.get('objects', [])}

        # Count motorcycles in the image
        count_motorcycles = len(motorcycles)
    
        final_result = {"motorcycles": count_motorcycles}
    
        return final_result

    except Exception as e:
        print(f"An error occurred: {str(e)}")
        final_result = {}
    
else:
    print("Object detection tool is not available.")
    final_result = {}

print("final_result:", final_result)

