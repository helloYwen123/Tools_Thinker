Code: from object_detector import Object_Detector_Tool

class ImageAnalyzer:
    def analyze_image(self, image_file):
        detector = Object_Detector_Tool()
        data = detector.execute(image=image_file, labels=["baseball", "basket"], save_object=True, save_object=True, labels=["baseball", "basket"])
        
        if data[0] and len(data[0]) > 0:
            baseball_count = data[0]["baseball"][0]["boxes"].size()[0]
            basket_count = data[0]["basket"][0]["boxes"].size()[0]
            
            return {"baseball": baseball_count, "basket": basket_count}

ImageAnalyzer().analyze_image("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_35_image_1.jpg")

