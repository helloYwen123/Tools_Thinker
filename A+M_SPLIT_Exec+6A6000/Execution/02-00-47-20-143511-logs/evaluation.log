Code: from object_detector import Object_Detector_Tool

# Load image file and get labels
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_98_image_1.jpg"
labels = ["baseball", "basket"]  
detected_object = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=True)

# Iterate over detected objects dictionary and count each label
object_count = {}
for label, detection_result in detected_object["output_types"][0].items():
    counts = detection_result["count"]
    object_count[label] = counts

# The count for each label is the key of the final result
final_result = {label: counts for label, counts in object_count.items()}

final_result

