Code: from object_detector import Object_Detector_Tool

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_98_image_1.jpg"
detector = Object_Detector_Tool()
result = detector.execute(image=image_path, labels=["train_class"], save_object=True)

# Process the result
data = result[0]
for label, results in data.items():
    print(f"{label}:")
    
    for k, v in results.items():
        print(f"  - {k}:")
        
        for box in v["boxes"]:
            print(f"    - {box[0]}-{box[1]}")
        
        print("  - confidence score: {:.2f}".format(v["confidence_scores"][0]))
        
print(f"Total count: {len(data)}")

