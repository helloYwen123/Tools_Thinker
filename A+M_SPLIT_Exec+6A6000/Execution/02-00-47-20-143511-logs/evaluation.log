def detect_objects(image_path, labels, threshold, model_size, save_object):
    object_detector_tool = Object_Detector_Tool(image_path, labels, threshold, model_size, save_object)
    results = object_detector_tool.execute()
    for label in results:
        label_counts[label] = results[label]
    return label_counts

