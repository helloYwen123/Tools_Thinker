from object_detector import Object_Detector_Tool

final_result = {}
labels = ['baseball', 'basket']
confidence_threshold = 0.45
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

object_number = {}
total_labels = 0

detector_tool = Object_Detector_Tool()
labels_for_detection = set(labels) - {'0'}

for label in labels_for_detection:
    labels = [label] if label in labels else labels
    if label == "baseball" or label == "basket":
        continue
    detections_data = detector_tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_45_image_1.jpg", labels=labels, save_object=save_object, threshold=confidence_threshold, model_size=model_size)
    if detections_data:
        total_labels += len(detections_data)
        for label_name, bbox, confidence, box_scores in reversed(detections_data['grounded boxes']):
            object_number[label_name] = object_number.get(label_name, 0) + 1
            if label_name == "baseball":
                final_result["baseball"] = object_number.get("baseball", 0) + 1
            elif label_name == "basket":
                final_result["basket"] = object_number.get("basket", 0) + 1
            else:
                final_result[label_name] = object_number.get(label_name, 0) + 1
for label_name in sorted(object_number):
    if label_name not in {"baseball", "basket"}:
        final_result[label_name] = object_number[label_name]

final_result
