Code: from object_detector import Object_Detector_Tool


def get_num_colors_above_basin(image_path):
    detector = Object_Detector_Tool(
        image_path,
        labels=["tile"],
        save_object=True,
        threshold=0.45,
        model_size="base"
    )
    results = detector.execute()
    
    # Extract information from the first detected tile
    first_tile = results[0]
    first_color = first_tile['boxes'][0]['rgb_channels'][0][0]
    
    # Calculate the count of colored tiles above the sink
    num_colors = sum(result['boxes'][0]['rgb_channels'][0][0] == first_color for result in results)
    return num_colors


final_result = get_num_colors_above_basin("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_5_image_1.jpg")
print("Number of colored tiles above the sink:", final_result)

