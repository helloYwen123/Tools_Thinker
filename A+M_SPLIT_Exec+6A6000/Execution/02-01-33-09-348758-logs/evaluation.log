Code: from object_detector import Object_Detector_Tool

final_result = {}
labels = ["soap_bottle", "detergent_bottle"]

# Load the image data
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_5_image_1.jpg"
image = Object_Detector_Tool.image(image_path)

# Detect labels in the image
labels_data = []

for label in labels:
    detected_details = image.detect_objects(label, threshold=0.5)
    if detected_details:
        labels_data.append({"label": label, "boxes": detected_details[0], "confidence_scores": detected_details[1], "box_score_min": detected_details[2]})

# Count the occurrences of each label
for detected_details in labels_data:
    label_count = final_result.get(detected_details["label"], 0)
    final_result[detected_details["label"]] = label_count + 1

# Write the final result to a dictionary
final_result = dict(final_result)

# Print the result
for label, count in final_result.items():
    print(f"{label}: {count}")

