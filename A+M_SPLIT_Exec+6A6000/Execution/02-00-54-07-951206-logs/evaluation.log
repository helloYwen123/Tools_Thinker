class Player:
    def __init__(self):
        self.heat_index = 0
        self.virtue = 0
        self.total_score = 0

    def score_reach(self, score):
        self.total_score += score
        self.heat_index += 1
        if self.heat_index >= 10 and self.virtue < 0:
            self.virtue = 0
        elif self.heat_index == 20:
            self.virtue = 10

def calculate_score(data):
    base = 20  # default value
    if 'baseball' in data['labels']:
        base = 100
    if 'basket' in data['labels']:
        base = 60
    if 'counting_59_image_1_image' in data['path']:
        base = 1000

    return base

@app.route('/analyze_image', methods=['POST'])
def analyze_image():
    image_url = request.args.get('image_url')
    image_data = requests.get(image_url)
    
    player = Player()
