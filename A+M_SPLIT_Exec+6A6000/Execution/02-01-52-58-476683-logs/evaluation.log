from object_detector import Object_Detector_Tool

def detect_parking_meters(path_to_image):
    object_detector = Object_Detector_Tool()

    # Convert image path to absolute
    image_path = os.path.join(os.path.dirname(__file__), "..", path_to_image)

    # Convert image format to RGB
    with open(image_path, 'rb') as image_buffer:
        image = np.array(Image.open(image_buffer))

    # Run object detector
    object_detection = object_detector.execute(image=image, labels=["parking_meter"], threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects")

    # Calculate number of parking meters detected
    detected_objects = object_detection["detected_objects"]["parking_meter"]
    num_parking_meters = len(detected_objects["boxes"])

    return num_parking_meters

