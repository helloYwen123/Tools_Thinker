code:from object_detector import Object_Detector_Tool

def count_i_words(image_path, labels=['i'], threshold=0.45, model_size='tiny', save_object=False, saved_image_path="detected_objects"):

    object_detector_tool = Object_Detector_Tool(image_path, labels=labels,
                                               threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    detected_results = object_detector_tool.execute()

    word_count = {result['label']: result['boxes'] for result in detected_results}

    # Filter results for words that contain the letter 'i'
    filtered_results = [{'label': key, 'boxes': boxes} for key, boxes in word_count.items() if 'i' in key]

    # Count the number of words in the filtered results
    i_word_counts = len(filtered_results)

    return {'i_word_counts': i_word_counts}

# Path to image containing ski trails
