# Convert the image file from the given file path to a string
file_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_48_image_1.jpg"

# Check if the image needs to be processed with Grounding DINO
if label_to_check in question:
    detector = Object_Detector_Tool( 
        input_type = "image",
        labels=[
            # Convert string to a list for labels
            label_to_check.lower()
        ],
        model_size = "tiny", 
        threshold = 0.45,
        save_object = False,
    )
else:
    # If the question does not contain the label to check, set the label to be detected
    label_to_check = "lozenge"

# Split the question into a list for loop
parts = question.split()

for part in parts:
    if label_to_check in part:
        # Check if the object should be detected and saved in the image
        object_number = label_to_check
        final_result = {"objects": [ 
            {
                "name": f"lozenge {object_number}",
                "bbox": [],
                "boxes": [],
                "confidence": 100,
                "saved_image_path": ""
            }
        ]}
        # Check if the object needs to be saved in the image
        if "save_object" in vars(getattr(detector, 'user_metadata', {}).get('output_types', [])) and (len(detector.object_number) > 0):
            final_result["objects"].append({
                "name": f"lozenge {object_number}",
                "bbox": [],
                "boxes": [],
                "confidence": 100,
                "saved_image_path": f"detected_objects/lozenge_{object_number}_images.jpg"
            })
    elif "save_object" in vars(getattr(detector, 'user_metadata', {}).get('output_types', [])):
        final_result = {"objects": [ 
            {
                "name": f"lozenge {object_number}",
                "bbox": [],
                "boxes": [],
                "confidence": 100,
                "saved_image_path": f"detected_objects/lozenge_{object_number}_images.jpg"
            }
        ]}

# Print the final result
print("Final result:", final_result)

