Code: import object_detector

def count_red_letters(path_to_image):
    """Detects red letters in an image and returns the number of red letters."""
    # Load the image and detect red letters
    detections = object_detector.execute(image=path_to_image, labels=["red letter"], save_object=True, model_size="tiny")
    # Check if red letters were detected
    if "red letter" in detections:
        return len(detections["red letter"])
    else:
        return None

final_result = count_red_letters("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_65_image_1.jpg")
print("Red letters on the front of the train:", final_result)

