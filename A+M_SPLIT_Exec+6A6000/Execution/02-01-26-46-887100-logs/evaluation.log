Code: from object_detector import Object_Detector_Tool

# Load the image and detect objects
tool = Object_Detector_Tool()
objects, object_number = tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_65_image_1.jpg", labels=["red", "letter"], save_object=True, saved_image_path="detected_objects")

# Count the red letters and save the detected objects with padding
denotation = {"red": 0}
for object in object_number:
    if "letter" in object:
        if object["label"] == "letter":
            denotation["red"] += object_number[object]["count"]

final_result = {}
for key in denotation:
    if key != "red":
        final_result[key] = denotation[key]

final_result

