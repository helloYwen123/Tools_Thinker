# Load the image
with open('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_13_image_1.jpg', 'rb') as img_file:
    img_data = img_file.read()

class Image:
    def __init__(self, image_path, labels, save_object):
        self.labels = labels
        self.save_object = save_object
        self.labels_detector = Object_Detector_Tool(image=image_path, labels=labels, save_object=save_object)

    # Function to detect objects in the image
    def execute(self):
        detect_results = self.labels_detector.execute(image=img_data, labels=self.labels, save_object=self.save_object, threshold=0.45, model_size='tiny')
        if detect_results:
            # Loop over the detected objects
            for obj in detect_results:
                yield (obj['label'], f"detected {obj['label']} at y={obj['ymin']}, x={obj['xmin']}, width={obj['width']}, height={obj['height']}, boxes={obj['boxes']}, confidence={obj['confidence']}")
        else:
            return None

def count_objects(labels, image_path, save_object):
    object_count = Image(image_path, labels, save_object)
    return object_count.execute()

