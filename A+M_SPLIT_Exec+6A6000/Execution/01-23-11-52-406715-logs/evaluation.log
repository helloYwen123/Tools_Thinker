Code: from object_detector import Object_Detector_Tool

tool_description="A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding."
output_types=("tuple - A tuple containing two elements: (1) a dictionary mapping each detected label to its grouped detection results, where each value is a dictionary with keys 'boxes', 'confidence_scores', and 'saved_image_paths'; (2) a dictionary mapping each label to its total count in the image.")

label_names = ["baseball"]
threshold = 0.45
save_object = True
saved_image_path = "detected_objects"
count = {}

for label in label_names:
    tool_input = {
        "image": "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_13_image_1.jpg",
        "labels": [label],
        "save_object": save_object,
        "model_size": "base",
        "threshold": 0.45,
        "saved_image_path": saved_image_path
    }
    tool_output = Object_Detector_Tool.execute(tool_input)
    boxes = tool_output[1]["boxes"]
    count[label] = count.get(label, 0) + len(boxes)

final_result = {label: count.get(label, 0) for label in count if label != "baseball"}

print("The number of people wearing a hat:", final_result)

