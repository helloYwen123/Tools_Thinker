def answer_question():
    # Load the image
    det = Object_Detector_Tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_90_image_1.jpg")

    # Print the total count
    print("Total signs:", det['object_number']['stop'])

    # Calculate the number of black letter signs
    black_letter_signs = det['object_number']['stop'] - det['label_data']['stop']

    # Print the number of black letter signs
    print("Number of black letter signs:", black_letter_signs)

    return black_letter_signs

final_result = answer_question()
print("Final result:", final_result)

