Code: from object_detector import Object_Detector_Tool

# Sample image path
sample_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg"

# Initialize the Object_Detector_Tool
tool = Object_Detector_Tool()

# Execute the object detection
detected_objects, object_number = tool.execute(image=sample_image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Check if detected objects exist
if detected_objects:
    # Extract relevant information
    box_count = object_number["baseball"].pop("boxes", [])
    basket_count = object_number["basket"].pop("boxes", [])
    # Calculate totals
    total_baseball = sum(box_count)
    total_basket = sum(basket_count)

    # Print results
    print(f"There are {total_baseball} baseball images detected.")
    print(f"There are {total_basket} basket images detected.")
else:
    print("No objects detected.")

final_result = {"total_baseball": total_baseball, "total_basket": total_basket}

