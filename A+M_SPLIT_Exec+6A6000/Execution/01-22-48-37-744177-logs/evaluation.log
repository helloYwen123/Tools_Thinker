Code: from object_detector import Object_Detector_Tool

# Function to check the correctness of the detection tool
def check_detection(tool_module_name, tool_class_name, image_path, labels, save_object=True, saved_image_path=None):
    tool_module = getattr(Object_Detector_Tool, tool_module_name, None)
    if tool_module:
        tool = tool_module(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
        return tool.detection_results
    else:
        return False

# Usage the function to detect and count basketball players
final_result = check_detection('Object_Detector_Tool', 'Object_Detector_Tool', "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg", ["basket"], True)
if final_result:
    detected_objects = final_result[0]
    total_count = final_result[1]
    print(f"The total number of detected players is {total_count}")
else:
    print("Detection failure.")

