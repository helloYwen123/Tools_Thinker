Code: def count_people_in_image(image_path):
    from object_detector import Object_Detector_Tool

    try:
        # Load the input image
        detector_tool = Object_Detector_Tool()
        image = detector_tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True)

        # Extract the number of people standing
        standing_people = sum(image['object_number']['baseball'] == 1 and image['object_number']['basket'] == 1)

        return standing_people
    except Exception as e:
        print(f"Error: {e}")
        return 0

