def count_green_tiles(image_path):
    image = Object_Detector_Tool.execute(image=image_path, labels=["green_tile"], threshold=0.45, saved_image_path="green_tile detections")
    total_green_tiles = {"count": 0}
    for box in image["boxes"]:
        for coord in box["coordinates"]:
            for tile_color in ["green"]:
                if tile_color in coord:
                    total_green_tiles["count"] += 1
                    break
    return total_green_tiles

