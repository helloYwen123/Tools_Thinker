def guess_number_of_green_tiles(image_path):
    """
    detects and counts green tiles in an image.
    :param image_path: str - File path to the image.
    :return: int - Number of green tiles.
    """
    detector_tool = Object_Detector_Tool(image_path)
    tile_colors = ["green"]

    # Set the model size and save the objects as images
    detector_tool.set_model_size("tiny")
    detector_tool.set_save_object(True)
    detector_tool.execute()

    # Iterate through the image to count green tiles
    detected_objects = {}
    for label, groups in detector_tool.output_types[1]['detected_objects'].items():
        if label in tile_colors:
            detected_objects[label] = len(groups)

    # Return the number of green tiles
    return detected_objects["green"]

