def get_green_tiles(image_path):
    # Load the image
    detector = Object_Detector_Tool(image_path=image_path)
    
    # Detect the green tiles
    green_tiles = detector.detect_objects(['green_tile'], only_gts=True, threshold=0.45)
    
    # Collect the green tiles detections and return count
    return len(green_tiles)

