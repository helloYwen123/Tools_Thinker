Code: # Load the Grounding DINO model
import numpy as np
from object_detector import Object_Detector_Tool

# Load the image
image = 'path/to/image.jpg'

# Detect objects in the image
labels = ['birthday cake', 'candles', 'knife']  # Change these labels as needed
object_detector = Object_Detector_Tool()
object_detector_labels = object_detector.execute(image=image, labels=labels, save_object=True)

# Extract the number of people reading the book
person_count = 0
if 'baseball' in object_detector_labels.object_labels:
    person_count += 1  # Count if any baseball object is detected
if 'basket' in object_detector_labels.object_labels:
    person_count += 1  # Count if any basket object is detected
final_result = {"person_count": person_count}
print("Final result:", final_result)

