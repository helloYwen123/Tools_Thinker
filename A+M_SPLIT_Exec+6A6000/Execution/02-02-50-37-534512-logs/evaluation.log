Code: from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_47_image_1.jpg"

# Labels to detect
labels = ["baseball", "basket"]

# Confidence threshold
threshold = 0.45
model_size = "tiny"

# Save object images
save_object = True
saved_image_path = "detected_objects"

# Execute tool
output = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=float(threshold), model_size=model_size, save_object=bool(save_object), saved_image_path=saved_image_path)

# Get object count from detected_objects dictionary
object_count = {label: len(result['boxes']) for label, result in output['object_number'].items()}

# Determine final result based on object_count dictionary elements
final_result = {"A": object_count if sum(object_count.values()) > 0 else "D"}

