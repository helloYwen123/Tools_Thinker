from object_detector import Object_Detector_Tool

# Image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_47_image_1.jpg"

# Function to execute object detection
def execute_image(image_path, labels=["baseball", "basket"], save_object=False, saved_image_path="detected_objects", **kwargs):
    # Load the object_detector tool
    oc = Object_Detector_Tool(image_path, labels, save_object, saved_image_path)

    # Detect objects
    detected_objects, object_number = oc.execute(**kwargs)

    # Collect detected object information
    detected_objects = {obj['label']: obj for obj in detected_objects}

    # Return the final result
    return detected_objects, object_number
