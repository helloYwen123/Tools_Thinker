from object_detector import Object_Detector_Tool

# Generate a list of object labels
labels = ["baseball", "basket"]

# Set the confidence threshold
threshold = 0.45

# Set the model size as 'tiny'
model_size = "tiny"

# Set whether to save object detection results
save_object = True

# Set the path of the saved object detection results
saved_image_path = "detected_objects"

# Execute the object detector tool
result = Object_Detector_Tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_29_image_1.jpg", labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Extract the detection result and count each object label
final_result = result[0]
counter = final_result[1].get(f"{labels[0]}", 0)
final_result_dict = [f"{labels[i]} has been detected in this image": counter for i in range(len(final_result[0]))]
final_result_dict.append("No detected objects found.")

print(f"Counter for {final_result_dict} is {final_result[2]}")

