Code: from object_detector import Object_Detector_Tool

# Read image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_88_image_1.jpg"

# Initialize object detector tool
object_detector_tool = Object_Detector_Tool()

# Detect objects in the image
labels = "baseball, basket"
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, saved_object=True)

# Check if 'basket' is detected
if 'basket' in detected_objects.values():
    basket_box = detected_objects[labels]["boxes"]
    basket_box = [box["bbox"] for box in basket_box]
    basket_conf = detected_objects[labels]["confidence_scores"]
    for (bbox, conf) in zip(basket_box, basket_conf):
        print(bbox, conf)
    
    final_result = sum(conf for (bbox, conf) in basket_box)
    
    if final_result > 0:
        print("Basket detected. Number of basket detected objects: ", int(final_result))
else:
    print("Basket not detected.")

# Print number of detected bears
if 'baseball' in detected_objects.values():
    ball_box = detected_objects[labels]["boxes"]
    ball_box = [box["bbox"] for box in ball_box]
    ball_conf = detected_objects[labels]["confidence_scores"]
    for (bbox, conf) in zip(ball_box, ball_conf):
        print(bbox, conf)

number_of_bears = sum(conf for (bbox, conf) in ball_box)
print("Number of bears: ", number_of_bears)

