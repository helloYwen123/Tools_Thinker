Code: from object_detector import Object_Detector_Tool

tool_args = {"image": "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_75_image_1.jpg", "labels": ["woman1", "shower_ducts", "mirror", "toilet"], "threshold": 0.45, "model_size": "tiny", "save_object": True, "saved_image_path": "detected_objects"}

