final_result = detected_objects
for label, value in object_number.items():
    final_result[label]["boxes"] = [item for sublist in detected_objects.values() for item in sublist[label]["boxes"]]
    final_result[label]["boxes"] = [item[0] for sublist in detected_objects.values() for item in sublist[label]["boxes"] if type(item) is str].pop()
    final_result[label]["boxes"][len(final_result[label]["boxes"])].pop("boxes")

for label in final_result.keys():
    final_result[label]["boxes"].sort(key=len)
