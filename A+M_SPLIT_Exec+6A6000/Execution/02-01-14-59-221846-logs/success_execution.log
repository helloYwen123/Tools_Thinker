from object_detector import Object_Detector_Tool

class App:
    def __call__(self, image, labels=['baseball'], threshold=0.45, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
        # Load model and labels
        detected_objects, object_number = Object_Detector_Tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

        # Print object number
        print(f"Total {object_number} objects detected in the image.")

        # Loop through each label and print the count
        for label, count in object_number.items():
            print(f"--- {label} --- Count: {count}")

if __name__ == '__main__':
    # Load image path
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_92_image_1.jpg'

    # Create App object
    app = App()

    # Check the number of athletes walking with tennis rackets
    # Call the method to detect the specific objects in the image
    app(image_path)
