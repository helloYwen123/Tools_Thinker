Code: from object_detector.object_detector import Object_Detector_Tool

object_detector_tool = Object_Detector_Tool()

input_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_24_image_1.jpg"
labels_to_search = ["windows"]

# Parameters for the tool
object_detector_tool.set_tool_module('object_detector')
object_detector_tool.set_tool_class_name('Object_Detector_Tool')
object_detector_tool.set_tool_description('A tool for detecting objects using the Grounding DINO model.')
object_detector_tool.set_tool_version('1.0.0')
object_detector_tool.set_input_types({'image': 'str', 'labels': 'list', 'threshold': 'float', 'model_size': "str", 'save_object': 'bool', 'saved_image_path': 'str'})
object_detector_tool.set_output_types({'detected_objects': 'tuple', 'object_detection_results': 'dictionary'})
object_detector_tool.set_command('detected_objects, window_count = object_detector_tool.execute(image=input_image_path, labels=labels_to_search)')
object_detector_tool.set_save_object(True)
object_detector_tool.set_saved_image_path('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_24_image_1_detected_windows')
object_detector_tool.set_obj_search_results(True)

result = object_detector_tool.get_output_types()
detected_objects = result[0]
window_count = result[1]

final_result = {'detected_windows': detected_objects, 'window_count': window_count}

