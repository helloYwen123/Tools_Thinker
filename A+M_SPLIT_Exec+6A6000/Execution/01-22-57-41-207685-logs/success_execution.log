from object_detector import Object_Detector_Tool

def count_fingers(image_path):
    # Load the model
    detector = Object_Detector_Tool(
        input_types={'image': image_path},
    )

    # Detect objects in the image
    labels = detector.execute(input_types={'image': image_path})
    object_numbers = labels['object_number']

    # Return the count of objects in front of the bathtub
    return object_numbers[1]

