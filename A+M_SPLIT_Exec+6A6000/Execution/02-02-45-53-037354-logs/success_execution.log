from object_detector import Object_Detector_Tool

# Open the detection tool
object_detector_tool = Object_Detector_Tool()

# Read the input image file
with open('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg', 'rb') as f:
    input_image = f.read()

# Specify the labels to be detected
labels = ["baseball", "basket"]

# Set the confidence threshold
threshold = 0.45

# Set the model size to 'tiny'
model_size = "tiny"

# Set whether to save the detected objects as images
save_object = True

# Save the detected objects as images
object_detector_tool.execute(image=input_image, labels=labels, save_object=True, saved_image_path=f'detected_objects')

# Retrieve the detected objects as a dictionary
detected_objects = object_detector_tool.output_types[0][0]

# Count the number of detected baseballs
num_baseball = len(detected_objects) // 5  # Assuming 'baseball' is 5 objects in the image
num_basket = len(detected_objects) - num_baseball

final_result = {'num_baseball': num_baseball, 'num_basket': num_basket}
