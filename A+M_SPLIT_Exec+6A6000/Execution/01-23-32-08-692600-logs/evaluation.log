Code: from object_detector import Object_Detector_Tool

# Sample image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_5_image_1.jpg"

# Initialize the detection tool with the image path
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=["basil", "basilaceae"], save_object=True, saved_image_path="detected_objects")

# Print the detected objects
for obj in detected_objects:
    print(f"Detected {obj['name']} with boxes: {obj['boxes']}, confidence: {round(obj['confidence'] * 100, 2)}%")

# Calculate the number of detected objects
total_num = 0
for obj in detected_objects.values():
    total_num += sum(obj['count'] for obj in obj.values())

# Print the total number of detected objects
print(f"The total number of detected objects is {total_num}.")

# Get the number of colored tiles above the sink
total_tiles = detected_objects["ColorTile"]["Count"]
unique_colors = list(set(detected_objects["ColorTile"]["names"].tolist()))
tile_categories = {
    "Blue": len(detected_objects["BlueTile"]["names"].tolist()),
    "Brown": len(detected_objects["BrownTile"]["names"].tolist()),
    "Green": len(detected_objects["GreenTile"]["names"].tolist()),
    "Orange": len(detected_objects["OrangeTile"]["names"].tolist()),
    "Yellow": len(detected_objects["YellowTile"]["names"].tolist()),
    "Red": len(detected_objects["RedTile"]["names"].tolist()),
    "White": len(detected_objects["WhiteTile"]["names"].tolist())
}
total_categs = sum(tile_categories.values(), 0)

# Calculate the number of colored tiles above the sink
total_categs += 1
total_categs %= total_tiles
category = unique_colors[total_categs]
categories = [unique_colors[total_categs - 1], number, total_categs % total_tiles]

# Print the categories of colors above the sink
print(f"The number of colored tiles above the sink is {category}.")

# Calculate the total number of tiles above the sink
total_tiles = detected_objects["TileSize"]["Count"]
categories = [unique_colors[total_categs - 1], number, total_tiles]

# Print the category of tiles above the sink
print(f"The category of tiles above the sink is {categories}.")

