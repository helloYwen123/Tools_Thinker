Code: from object_detector import Object_Detector_Tool

def count_dropped_boats(image_path):
    detector_tool = Object_Detector_Tool()

    # Load the image
    with open(image_path, 'rb') as image_file:
        image_data = image_file.read()

    # Detect objects
    results = detector_tool.run_with_labels(["boat"], image_data, threshold=0.45, model_size="tiny", save_object=True)

    # Count the boxes of the 'boat' label
    num_dropped_boats = len(results[1]['boxes']) if results[1]['boxes'] else 0

    return num_dropped_boats

# Calculate the total number of sinking boats
