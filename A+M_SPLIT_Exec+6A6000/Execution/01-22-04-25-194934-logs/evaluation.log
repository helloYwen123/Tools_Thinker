from object_detector import Object_Detector_Tool

def count_people_without_hats(image_path, labels=["baseball", "basket"]):
    tool = Object_Detector_Tool()

    # Function to retrieve object counts from the tool.
    def get_object_categorization_info(count_list):
        categorization = {"category_count": count_list}
        for label, count in categorization.items():
            if isinstance(count, list):
                categorization[label] = {"boxes": count[0], "confidence_scores": count[1]}
            else:
                categorization[label] = {"boxes": count, "confidence_scores": 0.}
        return categorization

    # Analyze the image and count individuals and labellables.
    image = tool.execute(image_path, labels=labels, threshold=0.45, model_size="tiny")
    categorized_data = get_object_categorization_info(image)

    # Count 'baseball' and 'basket' in the image.
    tennis_players = categorized_data["baseball"]["boxes"]
    basketball_players = categorized_data["basket"]["boxes"]

    # Calculate the total count for the new category not labeled 'baseball' or 'basket'.
    new_category_total = len([box["boxes"] for box in tennis_players or basketball_players]) - len(tennis_players) - len(basketball_players) + 1

    # Extract the count for people not labeled 'baseball' or 'basket'.
