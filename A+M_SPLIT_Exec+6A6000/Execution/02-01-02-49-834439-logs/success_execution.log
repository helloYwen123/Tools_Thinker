from object_detector import Object_Detector_Tool

# Define the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_62_image_1.jpg"

# Create an Object_Detector_Tool instance
detector = Object_Detector_Tool()

# Detect the objects in the image
detected_objects = detector.execute(image_path, ["baseball"], threshold=0.45, save_object=False)
final_result = {}

# Process the detected objects and their counts
for obj in detected_objects:
    count = len(detected_objects.obj_detection_results[obj][1].keys())
    final_result[detected_objects.obj_detection_results[obj][0]] = count

final_result
