Code: from object_detector import Object_Detector_Tool

# Load image
from_module: 'object_detector'
import_name: 'Object_Detector_Tool'

image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_62_image_1.jpg'
image = Image.open(image_path)

# Detect objects
labels = ['baseball', 'basket']
confidence_threshold = 0.45
saved_image_path = 'detected_objects'

detected_objects, object_number = Object_Detector_Tool.execute(image=image, labels=labels, confidence_threshold=confidence_threshold, saved_image_path=saved_image_path)

# Analyze results
final_result = {}

for detected_object in detected_objects:
    label = detected_object[0]
    boxes = detected_object[1]
    
    if label in final_result:
        for i, _ in enumerate(boxes):
            if i < len(final_result[label]) and boxes[i] == final_result[label][i]:
                final_result[label][i].append(boxes[i])
            else:
                final_result[label].append([boxes[i], 1])
    else:
        final_result[label] = [[boxes[0], 1]]

print(final_result)

