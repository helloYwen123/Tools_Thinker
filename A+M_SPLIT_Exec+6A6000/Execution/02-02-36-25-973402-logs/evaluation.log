Code: from object_detector import Object_Detector_Tool

def count_kids_in_bench(image_path):
    obj_detector = Object_Detector_Tool(
        labels=["Boy"],
        threshold=0.45,
        model_size="tiny",
        save_object=True,
        saved_image_path="detected_objects"
    )

    obj_detector.execute(image_path=image_path)

    total_objs = {'Boy': 0}
    for label, obj_data in obj_detector.output_types[1].items():
        if obj_data['label'] == "Boy":
            total_objs[label] += 1

    return total_objs

