Code: from object_detector import Object_Detector_Tool

def count_blue_circles(input_image_path, labels, save_object=False, saved_image_path="detected_objects"):
    detector = Object_Detector_Tool(input_image_path, labels=labels, threshold=0.45, model_size="tiny", save_object=save_object, saved_image_path=saved_image_path).execute()
    detected_labels = detector["output_types"][0]["grouped_detection_results"][0]["saved_image_paths"]
    blue_circle_count = 0
    for label in detected_labels:
        if "baseball" in label:
            blue_circle_count += 1
    final_result = {"count": blue_circle_count}
    return final_result

