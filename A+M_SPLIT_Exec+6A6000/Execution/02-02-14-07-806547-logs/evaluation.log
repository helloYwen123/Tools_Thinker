Code: from object_detector import Object_Detector_Tool

# Function to check if any person is eating apples
def count_people_eating_apples():
    try:
        # Load the image file using Object_Detector_Tool
        tool = Object_Detector_Tool()
        image = tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_87_image_1.jpg", labels=["person"], threshold=0.45, save_object=False, saved_image_path=None)

        # Check the number of people eating apples
        if 'person' in image:
            count_people_eating_apples = len(image['person'])
        else:
            count_people_eating_apples = 0

        return count_people_eating_apples
    except Exception as e:
        print(f"An error occurred: {e}")
        return None

# Call the function to count people eating apples
final_result = count_people_eating_apples()
print(f"Number of people eating apples: {final_result}")

