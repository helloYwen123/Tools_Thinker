Code: from object_detector import Object_Detector_Tool

# Load the image and set the confidence threshold
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_87_image_1.jpg"
confidence_threshold = 0.45
model_size = "tiny"

# Execute the Object_Detector_Tool with the labels
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=["apple"], confidence_threshold=confidence_threshold, save_object=True, model_size=model_size)

# Print the detected object summary
print("Detected apple objects (total count):", object_number)

# Check the value to determine the options
if detected_objects:
    total_count = detected_objects[0]["objects"].values()[-1]
    options = ["(A) 0", "(B) 1", "(C) 3", "(D) 2"]
    chosen_option = max(options, key=lambda x: object_number - total_count)
    print(f"We have {''.join(chosen_option.split())} people eating apples!")
else:
    print("(A) 0")

