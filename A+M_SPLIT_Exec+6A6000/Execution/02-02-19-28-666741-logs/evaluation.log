Code: from object_detector import Object_Detector_Tool

# Path to the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_31_image_1.jpg'

# Create the object detector tool
detector = Object_Detector_Tool()

# Set the labels to detect (in this case, 'baseball' and 'basket')
labels_to_check = ['baseball', 'basket']

# Set the confidence threshold
threshold = 0.45

# Set the model size (tiny or base)
model_size = 'tiny'

# Set whether to save the detected objects as images
save_object = True

# Execute the object detection
(detected_objects, object_number) = detector.execute(image_path, labels=labels_to_check, threshold=threshold, model_size=model_size, save_object=save_object)

final_result = {}

for label, objects in detected_objects.items():
    if label in labels_to_check:
        if save_object:
            for obj_name, obj in objects.items():
                obj_path = f'detected_objects/{label}_{obj_name}.png'
                obj.save(obj_path)

        final_result[label] = { "boxes": objects, "confidence_scores": detected_objects[label], "saved_image_paths": [f'detected_objects/{label}_{obj_name}.png'] }

print("Counting Baseball and Basketball: ", detector.generate_output())

