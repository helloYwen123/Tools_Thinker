Code: from object_detector import Object_Detector_Tool

# Read the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_64_image_1.jpg"

# Create an instance of the Object_Detector_Tool
tool = Object_Detector_Tool(image_path, ["baseball", "basket"], save_object=False)

# Get the results from the tool
results = tool.execute()

# Convert the detected objects dictionary to a list of detected labels
labels = results["output_type1"]

# Count the detected objects
