# Get the number of burners on the stove
burners = 4

# Function to check if the number of labels is equal to the number of burners
def check_labels(num_labels, burners):
    if num_labels == burners:
        return "Correct"
    else:
        return "Incorrect"

# Example usage for verification
if check_labels(num_labels, burners):
    print("Correct")
else:
    print("Incorrect")

# The final result is the number of burners
final_result = num_labels
print(final_result)

