def create_image_obj_with_boxes(label, boxes, scores, model_type):
    width, height = 10, 10
    obj = {
        "label": label,
        "width": width,
        "height": height,
        "boxes": boxes,
        "scores": scores,
    }
    if model_type == 'tiny':
        size = 'tiny'
    else:
        size = 'base'
    return f"{size}_img.png", obj

