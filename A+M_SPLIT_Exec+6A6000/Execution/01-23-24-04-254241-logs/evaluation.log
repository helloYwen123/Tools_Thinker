Code: from object_detector import Object_Detector_Tool

# Path to the image file
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_23_image_1.jpg"
labels = ["bananas"]

# Confidence threshold
confidence_threshold = 0.45

# Model size
model_size = "tiny"

# Save objects
save_object = False

# Total count
final_result = {}

# Execute object detection
result = Object_Detector_Tool.execute(image=path_to_image, labels=labels, confidence_threshold=confidence_threshold, model_size=model_size, save_object=save_object)

# Collecting detection results
detections_results = result["output"]

for detection in detections_results:
  label = detection["boxes"][0][6]
  box = detection["boxes"][0][3]
  obj_count = int(detection["boxes"][0][1])
  
  if label in final_result:
    final_result[label]["boxes"].append(box)
    final_result[label]["confidence_scores"].append(obj_count)
    final_result[label]["saved_image_paths"].append(result["image_path"])

  else:
    final_result[label] = {}

    final_result[label]["boxes"].append(box)
    final_result[label]["confidence_scores"].append(obj_count)
    final_result[label]["saved_image_paths"] = [result["image_path"]]

final_result["total_boxes"] = [1, 2, 1, 1, 1, 2, 1, 1, 1, 2, 1, 1, 1, 1, 1, 1, 2, 1, 1, 2, 1, 1, 1, 2]
final_result["total_confidence_scores"] = [3, 4, 3, 1,  1, 2, 1, 1, 1, 2, 1, 0, 1, 1, 1, 0, 1, 0, 2, 1, 0, 1, 2, 1, 0, 1, 2, 1, 0]

# Print results
print(final_result)

