code:from object_detector import Object_Detector_Tool

def get_blue_seats_count(image):
    detector = Object_Detector_Tool()
    label_results = detector.execute(image=image, labels=["blue_seat"], save_object=True, saved_image_path="blue_seat_results")
    total_blue_seats = 0
    for result in label_results["object_number"]["blue_seat"]:
        if result["boxes"]["bbox"][2] >= 1 and result["boxes"]["bbox"][3] >= 1:
            total_blue_seats += 1
    return total_blue_seats

