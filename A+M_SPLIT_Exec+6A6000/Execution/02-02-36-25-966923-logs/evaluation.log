Code: from object_detector import Object_Detector_Tool

final_result = {}
planes = [
    "72", "7", "71", "19", "4", "2342",
    "15.5", "15", "8", "20"
]

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_72_image_1.jpg"  # Path to the image file
image_objects = Object_Detector_Tool.execute(image_path, planes=planes, threshold=0.8)

for label, detection_results in image_objects.items():
    for value in detection_results.values():
        boxes = [bbox for bbox in value['boxes'] if "baseball" in bbox]  # Check for purple airplanes
        if boxes:
            if label in final_result:
                final_result[label] += len(boxes)
            else:
                final_result[label] = len(boxes)
                final_result['purple airplanes'] = len(boxes)

result = final_result

result_count = len(result['purple airplanes'])

print(result_count)

