Code: from object_detector import Object_Detector_Tool

def answer_image_question(image_path, labels=None, threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
    object_detector = Object_Detector_Tool()
    object_detector.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    found_objects = object_detector.output_types[0]
    final_result = []
    for label, count in found_objects.items():
        final_result.append((label, count["boxes"], count["confidence_scores"], "predicted" if count["score"] > 0.45 else "detected"))
    print("detected_objects:", final_result)
    return final_result

final_result = answer_image_question("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_25_image_1.jpg")
print("Final result:", final_result)

