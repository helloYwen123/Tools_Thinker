Code: import os
import numpy as np
from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_74_image_1.jpg"

# Create an instance of the Object_Detector_Tool class
object_detector = Object_Detector_Tool(image_path, labels=["baseball"], save_object=True)

# Get the bounding boxes, scores, and image paths for each detected object
detected_objects = object_detector.execute()

# Count the number of empty glasses
empty_glasses_counter = len(detected_objects)

# Save the detected objects
if detected_objects[detected_objects["boxes"].min()]["saved_image_paths"]:
    print(detected_objects[detected_objects["boxes"].min()]["saved_image_paths"])
    print(detected_objects[detected_objects["boxes"].min()]["boxes"][-1]["x"], detected_objects[detected_objects["boxes"].min()]["boxes"][-1]["y"], detected_objects[detected_objects["boxes"].min()]["boxes"][-1]["width"], detected_objects[detected_objects["boxes"].min()]["boxes"][-1]["height"])

# Initialize the list to store the final result
final_result = []

# Check if there are any empty glasses detected
if empty_glasses_counter > 0:
    empty_glasses_counter = empty_glasses_counter - 1
    final_result.append(f"{empty_glasses_counter}")
else:
    final_result.append(0)

final_result

