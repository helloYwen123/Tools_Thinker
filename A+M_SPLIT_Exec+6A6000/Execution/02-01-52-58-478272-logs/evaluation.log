Code: import object_detector as objd
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_74_image_1.jpg"
labels = ["bottle", "glass", "wineglass", "wine bottle"]
threshold = 0.5
model_size = "small"
save_object = True
final_result = None

detector = objd.Object_Detector_Tool(image_path, labels, threshold, model_size, save_object, saved_image_path="detected_objects")
results = detector.execute()

if not saved_object:
    print("No objects detected.")
else:
    for label, results in results.items():
        if "bottle" in label:
            if results["boxes"]:
                print(f"{label}瓶：{len(results['boxes'])}")
        elif "glass" in label:
            if results["boxes"]:
                print(f"{label}杯：{len(results['boxes'])}")
    if "bottle" in final_result:
        if final_result["bottle"] > len(results["boxes"]):
            final_result["bottle"] = len(results["boxes"])
    if "glass" in final_result:
        if final_result["glass"] > len(results["boxes"]):
            final_result["glass"] = len(results["boxes"])
    if "wineglass" in final_result:
        if final_result["wineglass"] > len(results["boxes"]):
            final_result["wineglass"] = len(results["boxes"])
    if "wine bottle" in final_result:
        if final_result["wine bottle"] > len(results["boxes"]):
            final_result["wine bottle"] = len(results["boxes"])
    print("Bottles: ", final_result)
    print("Glasses: ", final_result)
    print("Wine glasses: ", final_result)

