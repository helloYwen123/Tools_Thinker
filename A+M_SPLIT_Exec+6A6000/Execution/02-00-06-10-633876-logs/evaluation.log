Code: from object_detector import Object_Detector_Tool

# Provide the path to your image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg"

# Detect the objects in the image
labels = ["soccer"]
threshold = 0.45
model_size = "tiny"
save_object = True

detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, model_size=model_size, threshold=0.45)

# Count the number of objects in the image
total_objects = len(detected_objects)

# Check if the number of detected objects is greater than zero
if total_objects > 0:
    # Count each detected object
    object_counts = {label: detected_objects[label]['count'] for label in detected_objects}
    
    # Print the number of detected objects and their counts
    print(f"detected_objects detected objects with count: {total_objects}")
    
    print(object_counts)
else:
    print("No detected objects found.")

