Code: from object_detector import Object_Detector_Tool

# Path to the image
image_filepath = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg"

# Labels to detect
labels = ["baseball", "basket"]

# Confidence threshold
threshold = 0.45

# Model size
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Detect the objects
detected_objects, object_number = Object_Detector_Tool.execute(image=image_filepath, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size, threshold=threshold)

# Initialize total count for each label
total_count = {}

for label in labels:
    total_count[label] = 0

# Update label counts
for detected_object in detected_objects:
    label = detected_object["label"]
    total_count[label] += detected_object["count"]

# Check if any objects were detected
if total_count:
    # Find the label corresponding to the most detected object
    highest_object_count = max(total_count, key=total_count.get)
    
    # Count objects in the highest detected label and add to final result
    final_result = {
        "objects_detected": detected_objects,
        "objects_count": {"baseball": int(highest_object_count), "basket": 0},
        "total_count": total_count
    }

    # Check if the number of blue shirts detected is between 0 and 1
    if len(detected_objects) > 0 and detected_objects["label_count"]["blue shirt"] > 0:
        final_result["blue shirt_count"] = detected_objects["label_count"]["blue shirt"]
    else:
        final_result["blue shirt_count"] = 0
else:
    final_result = None

print(final_result)

