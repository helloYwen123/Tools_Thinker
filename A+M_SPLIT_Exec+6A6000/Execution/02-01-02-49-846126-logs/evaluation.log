Code: from object_detector import Object_Detector_Tool

# Load the labels of interest from the 'labels' parameter
labels = ["baseball", "basket"]

# Load the confidence threshold from the 'threshold' parameter
threshold = 0.9

# Load the size of the model from the 'model_size' parameter
model_size = "tiny"

# Load the save path from the 'saved_image_path' parameter
saved_image_path = "detected_objects"

# Call the function to detect objects in the image
detected_objects, obj_count = Object_Detector_Tool.execute(
    image="path/to/image.png",
    labels=labels,
    threshold=threshold,
    model_size=model_size,
    save_object=True,
    saved_image_path=saved_image_path
)

# Extract the results of the detection by label and count
for i, obj in enumerate(labels):
    obj_count[i]["boxes"] = [*detected_objects[obj]["boxes"]]
    obj_count[i]["confidence_scores"] = [*detected_objects[obj]["scores"]]
    obj_count[i][obj]["saved_image_paths"] = saved_image_path

# Check if the model has detected any objects
if not obj_count:
    print(f"No objects detected in the image. The model missed most of the objects.")
else:
    print(f"Detected objects in the image.")
    for obj, data in obj_count.items():
        print(f"Detected {obj}:")
        for p in data["boxes"]:
            print(f"  - {p}")
        print(f"  - Confidence: {data['confidence_scores']}")
        print(f"  - Image Path: {data['saved_image_paths']}")

# Find the number of people wearing a cap
cap_count = 0
for person in detected_objects.values():
    for cap in person["heads"]:
        cap_count += 1

final_result = cap_count if cap_count > 0 else 0

print(f"Number of people wearing cap is {final_result}.")

