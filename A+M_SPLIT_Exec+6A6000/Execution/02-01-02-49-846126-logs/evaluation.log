Code: from object_detector import Object_Detector_Tool

class Image:
    def __init__(self, path):
        self.path = path
        self.object_detector = Object_Detector_Tool(self.path)
        labels = self.object_detector.label_detection()
        self.object_count = self.object_detector.object_count()
        self.detections = self.detection_labels()

    def detection_labels(self):
        labels = []
        detections = self.object_detector.detect_image()
        for det in detections:
            for label in det:
                labels.append(label[0])
        return labels

    def object_count(self):
        counts = {}
        for label in self.object_count:
            counts[label] = self.object_detector.object_count(label)
        return counts

def get_person_count(image_path):
    image = Image(image_path)
    final_result = image.object_count()
    for labels in final_result:
        count = final_result[labels]
        if count == 1:
            return count
        else:
            return "Multiple"


final_result = get_person_count("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_83_image_1.jpg")
print(final_result)

