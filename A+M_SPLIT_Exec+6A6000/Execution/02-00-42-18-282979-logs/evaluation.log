Code: from object_detector import Object_Detector_Tool

def find_skier_on_the_crest(image_path):
    detector_tool = Object_Detector_Tool()
    detector_tool.execute(image_path, labels=["skier"], model_size="tiny")
    results = detector_tool.output_types[0][1]
    
    # Count the number of skiers on the crest
    num_skiers = len(results["boxes"])
    
    return num_skiers

