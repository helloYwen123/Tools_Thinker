Code: from object_detector import Object_Detector_Tool

def count_skiers(image_path):
    tool = Object_Detector_Tool(image_path, labels=["snowboarders"])
    tool.set_threshold(0.20)
    tool.set_save_object(True)
    detected_objects, object_number = tool.execute()

    total_count = 0
    detected_objects['baseball'] = {'boxes': None, 'confidence_scores': None}
    detected_objects['basket'] = {'boxes': None, 'confidence_scores': None}

    for obj in detected_objects['basket']['boxes']:
        total_count += 1
    for obj in detected_objects['snowboarders']['boxes']:
        total_count += 1

    if total_count > 1:
        final_result = "There are 2 skiers doing a flip."
    else:
        final_result = "No skiers are doing a flip."

    return final_result

# Use the function with the provided image path
final_result = count_skiers('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_44_image_1.jpg')
print(final_result)

