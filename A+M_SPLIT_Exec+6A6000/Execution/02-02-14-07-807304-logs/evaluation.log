    data = img_file.read()

# Load the image and apply object detection
detected_objects = Object_Detector_Tool.execute(image=data.decode('utf-8'), labels=['candelight'], save_object=False, saved_image_path=None)

final_result = {}

# Loop through each detected object
for obj_label, detections in detected_objects["objects"].items():
    # Count the total number of candlelights in the image
    total_count = total = 0
    for x, box in detections["boxes"].items():
        if 'candelight' in obj_label:
            total += 1
        if obj_label not in final_result:
            total_result = {obj_label: total}
        else:
            total_result = total
            if obj_label not in final_result:
                final_result[obj_label] = total_result
            else:
                final_result[obj_label][obj_label] = total_result

