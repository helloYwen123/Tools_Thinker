Code: from object_detector import Object_Detector_Tool

# Specify the size of the model
model_size = 'tiny'

# Set the confidence threshold
threshold = 0.45

# Set the model type (e.g., tiny or base)
model_type = 'tiny'

# Specify the image path to use
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_120_image_1.jpg"

# Initialize the Object_Detector_Tool object
detector = Object_Detector_Tool(image_path=image_path, model_size=model_size, threshold=threshold, model_type=model_type, save_object=True)

# Get the labels to detect and count
labels_to_detect = ["baseball", "basket"]

# Detect the objects and count them
results, final_results = detector.execute(labels=labels_to_detect)

# Print the results
if results:
    for label, group_results in final_results.items():
        print(f"Label: {label}")
        print("Baskets:")
        print(group_results["saved_image_paths"])
        print("Baseballs")
        print(group_results["boxes"])
else:
    print("No objects detected.")

# Check the final results
for label, count in final_results.items():
    print(f"Label: {label}, Count: {count}")

