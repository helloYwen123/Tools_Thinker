Code: from os.path import join

# path to the image file
file_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_64_image_1.jpg"

# object labels to detect (basically, the same labels as in the object_detector module's demo_commands())
detected_labels = ['baseball', 'basket']

# create the result dictionary
result_dict = {
    "detected_objects": {
        "boxes": {},
        "confidence_scores": {},
        "saved_image_paths": {}
    }
}

# open the image and iterate over the bounding boxes
with Object_Detector_Tool(file_path, labels=detected_labels) as tool:
    tools_results = tool.execute()

    # initialize the object counts
    count_dict = {"baseball": 0, "basket": 0}

    for i, objects in enumerate(tools_results["detected_objects"].values()):
        for obj in tools_results["detected_objects"].items():
            if obj[0] == obj[1]:
                count_dict["baseball"] += 1
            elif obj[0] == obj[1]:
                count_dict["basket"] += 1

            # save the detected object as a save_object_image
            tool.save_object(obj[1], saved_image_path.joinpath(obj[1].split("/")[-1]))

    # update the result dictionary
    result_dict["detected_objects"]["boxes"] = tools_results["detected_objects"]
    result_dict["detected_objects"]["confidence_scores"] = tools_results["confidence_scores"]
    result_dict["detected_objects"]["saved_image_paths"] = tools_results["saved_image_paths"]

    # get the total count of detected objects
    total_count = sum(result_dict["detected_objects"][x]["boxes"] for x in result_dict["detected_objects"])

    # calculate the ratio of ball: basket detection
    ratio_ball_basket = count_dict["baseball"] / count_dict["basket"]

    # set the final result
    final_result = {"ratio_ball_basket": ratio_ball_basket, "count_ball": count_dict["baseball"], "count_basket": count_dict["basket"]}

