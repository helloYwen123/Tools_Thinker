Code: from object_detector import Object_Detector_Tool

# Load the image
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_36_image_1.jpg"
object_detector_tool = Object_Detector_Tool()
labels = ["baseball", "basket"]
threshold = 0.5
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Detect objects in the image
final_result = object_detector_tool.execute(image=path_to_image, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size, saved_image_path=saved_image_path)

# Print the results
print(final_result)

