# Function to analyze water glass and pizza image
def analyze_image(image_path):
    # Load the image
    object_detector_tool = Object_Detector_Tool()

    # Execute the tool
    detected_objects, object_number = object_detector_tool.execute(image=image_path, save_object=True)

    # Extract relevant information from the detected objects
    water_glasses = detected_objects["baseball"]
    water_glasses_boxes = detected_objects["boxes"]
    water_glasses_scores = detected_objects["scores"]
    water_glass_image_paths = detected_objects["saved_image_paths"]

    return water_glasses, water_glasses_boxes, water_glasses_scores, water_glass_image_paths

# Analyze the water and pizza image
final_result = analyze_image("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_12_image_1.jpg")
water_glasses, _, _, _ = final_result
water_glasses_count = sum(int(water_glasses) for _, water_glasses_box, _, _ in water_glasses)
final_result["water_glasses_count"] = water_glasses_count

# Calculate pizza size
pizza_width, pizza_height = detected_objects["boxes"][-1][2] - detected_objects["boxes"][0][2], detected_objects["boxes"][0][3] - detected_objects['boxes'][0][1]
pizza_area = pizza_width * pizza_height
final_result["pizza_area"] = pizza_area

# Get the number of slices
number_of_slices = 8  # Estimated number of pieces, may need adjustments

# Determine the coordinates of the top slice
top_slice_coordinates = [detected_objects["boxes"][0][0], detected_objects["boxes"][0][y] for y in range(1, number_of_slices)]
del number_of_slices

for coordinates in top_slice_coordinates:
    # Determine if the pizza is whole
    if detected_objects["boxes"][0][2] == coordinates[2] and detected_objects["boxes"][0][3] == coordinates[3]:
        pizza_full = True
    else:
        pizza_full = False
        
    # Determine if the slices are arranged in ascending order by x-position
    if sorted([detected_objects["boxes"][0][x] for x in range(4, number_of_slices)]) >= sorted([detected_objects["boxes"][x][x] for x in range(3)]):
        slices_arranged = True
    else:
        slices_arranged = False

return final_result

