Code: from object_detector import Object_Detector_Tool

final_result = ''
path_to_image = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_100_image_1.jpg'

# Detect and count white refrigerators
object_detector_tool = Object_Detector_Tool()
labels_to_detect = ['baseball', 'basket']
threshold = 0.45
model_size = 'tiny'
save_object = True
detected_objects, object_number = object_detector_tool.execute(image=path_to_image, labels=labels_to_detect, threshold=threshold, model_size=model_size, save_object=save_object)

# Analyze the results and add the refrigerator count
for fridge_label, fridge_result in detected_objects['results'].items():
    fridge_boxes = fridge_result['boxes']
    fridge_confidence = fridge_result['confidence_scores']
    fridge_count = sum(fridge_boxes[fridge_label]['num'] for fridge_label, fridge_confidence in fridge_result['confidence_scores'].items())
    final_result += f'White refrigerator with labels {labels_to_detect}: {fridge_count}\n'

print(final_result)

