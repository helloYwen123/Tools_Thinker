if labels:
    detected_objects, object_number = object_detector.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_83_image_1.jpg", labels=labels, save_object=True, saved_image_path="detected_objects")
    
# Print detected objects
for label, detections in detected_objects.items():
    print(f"{label}: {len(detections[0])}")

# Calculate total number of objects detected
total_objects = sum(len(detections[0]) for detections in detected_objects.values())
final_result = {"total_objects": total_objects}
print(final_result)

