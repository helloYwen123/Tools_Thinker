from object_detector import Object_Detector_Tool
 
def count_nuggets(image_path):
    detector = Object_Detector_Tool() 
    result = detector.execute(image_path=image_path, labels=["nugget"], threshold=0.45, save_object=False)
    
    total_nuggets = len(result['total']['detected_objects'])
    return total_nuggets
