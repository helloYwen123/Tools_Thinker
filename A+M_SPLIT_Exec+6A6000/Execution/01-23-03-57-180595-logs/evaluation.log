Code: from object_detection import Object_Detector_Tool

def count_trains_in_station(image_path):
    detection_tool = Object_Detector_Tool()
    image = detection_tool.execute(image_path, labels=['train'], save_object=True)
    
    # Detect bounding boxes and confidence scores
    boxes = image['detected_objects']['bbox']
    scores = image['detected_objects']['scores']
    
    # Calculate the number of trains
    num_trains = sum(boxes.tolist() == [1])
    
    # Return the total number of trains
    return num_trains

# Example usage
train_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_98_image_1.jpg"
result = count_trains_in_station(train_image_path)
print(f"Number of trains stopped at the station: {result}")

