from object_detector import Object_Detector_Tool

# Check if the path is provided, else prompt the user
import os
if not os.path.exists("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_25_image_1.jpg"):
    final_result = "The image file does not exist or is not a valid file path."
else:
    warnings.filterwarnings("ignore")
    # Load the image
    with open("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_25_image_1.jpg") as f:
        img_path = f

    # Execute the object detection tool
    labels, object_number = Object_Detector_Tool.execute(image=img_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

    # Count the objects for each category
    category_count = {"baseball": 0, "basket": 0}

    for i in object_number:
        category = labels[i]["category"]
        if category == "baseball":
            category_count["baseball"] += 1
        elif category == "basket":
            category_count["basket"] += 1

    # Extract the target information
    target_image_path = "detected_objects/baseball.png"
    target_count = category_count["baseball"]

    # Display the result
    final_result = f"{target_image_path} - {target_count}"

# Print the final result or user input
print(final_result)

