from object_detector import Object_Detector_Tool

def count_yellow_stars(image_path):
    # Load the ground-truth object annotations
    obj_annotations_path = "val_Counting_71_image_1_labels.txt"
    
    # Load the image data
    with open(image_path, "rb") as image_file:
        image_data = image_file.read()
    
    # Load the object annotation data
    with open(obj_annotations_path, "r") as obj_file:
        obj_labels = obj_file.readline().strip()
        obj_anno_data = []
        for _ in range(len(obj_labels)):
            lines = obj_file.readline().strip().split()
            obj_anno_data.append((lines[0], float(lines[1]), float(lines[2]), float(lines[3])))
    
    # Perform object detection
    object_detector_tool = Object_Detector_Tool(image_path, labels=["giantstar"], model_size="tiny", save_object=True, saved_image_path="detected_objects")
    object_detection_results = object_detector_tool.execute()
    
    # Count yellow stars
    yellow_star_count = 0
    for detection in object_detection_results["results"]["giantstar"]:
        if detection["confidence_score"] > 0 and detection["category_id"] == 1:
            yellow_star_count += 1
    
    return yellow_star_count
