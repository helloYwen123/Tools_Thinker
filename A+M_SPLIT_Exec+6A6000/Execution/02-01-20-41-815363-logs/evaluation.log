def count_earles(human_readable_label_list):
    human_readable_label_list = human_readable_label_list if isinstance(human_readable_label_list, list) else [human_readable_label_list]
    try:
        tool_config = {
            'save_object': True,
            'saved_image_path': '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg',
        }
        detection_tool = Object_Detector_Tool(input_type='image', input_path='val_Counting_73_image_1.jpg', labels=["elephant"], threshold=0.5, model_size='tiny', save_object=tool_config['save_object'], saved_image_path=tool_config['saved_image_path'])
        detections = detection_tool.run()

        person_count = {'elephant': 3, 'mankind': 0}

        for person in detections['obj']:
            if person['labels'][0] != 'person':
                person_count = person_count + {'elephant': 1}
            else:
                person_count['mankind'] = person_count['mankind'] + 1

        person_count["extra"] = len(detections['person'])
        return person_count
    except Exception as e:
        print(str(e))
        return 0

print(count_earles([f"elephant {count}" for count in range(5000))))

