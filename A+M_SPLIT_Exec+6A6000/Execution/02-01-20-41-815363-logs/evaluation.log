Code: from object_detector import Object_Detector_Tool

final_result = {}
labels = ["elephant", "baby"].list()

for label in labels:
    try:
        obj = Object_Detector_Tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg", labels=[label], confidence_threshold=0.45, save_object=True, saved_image_path="detected_objects")
        res = obj.get("result")
    except Exception as e:
        print ("Exception caught while executing the tool:", e)
        continue

    if res and "boxes" in res:
        detections = res["boxes"]

        if label == "elephant":
            num_obj = len(detections)

        elif label == "baby":
            num_obj = len(detections) - 1

        else:
            num_obj = 0

        final_result[label] = {"count": num_obj, "boxes": detections}

    else:
        print ("Failed to get boxes information. Checking if 'boxes' is present.")
        num_obj = 0

if final_result:
    print("Total number of detected objects in the image: ", sum(final_result.values()))
else:
    print("No objects detected in the image.")

