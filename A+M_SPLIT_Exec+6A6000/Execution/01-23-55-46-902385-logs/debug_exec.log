code:from object_detector import Object_Detector_Tool

def find_candle_position(image_path):
    object_detector = Object_Detector_Tool()
    labels = ["candle"]
    confidence_threshold = 0.45
    model_size = "base"
    save_object = True

    detected_objects, object_count = object_detector.execute(image=image_path, labels=labels, save_object=save_object, threshold=confidence_threshold, model_size=model_size)

    candle_positions = []
    for label, label_counts in detected_objects.items():
        if "candle" in label and "box" in label_counts:
            x, y, width, height = label_counts['box']
            candle_positions.append((x, y, width, height))

    return candle_positions

# Get candle positions for the image 1.jpg
