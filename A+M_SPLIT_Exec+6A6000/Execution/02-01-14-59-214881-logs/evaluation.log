Code: import numpy as np
from object_detector import Object_Detector_Tool

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_21_image_1.jpg"

detector = Object_Detector_Tool()
labels = ["red"]
threshold = 0.45
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Detect objects
objects, object_number = detector.execute(image_path, labels, threshold, model_size, save_object, saved_image_path)

for index, object in enumerate(objects):
    if object["label"].lower() == "red":
        count = object_number.get(index, 0) + 1
        final_result[index] = count

if save_object:
    detector.save_object(objects)

if object_number:
    print("Number of red buses:", object_number)

