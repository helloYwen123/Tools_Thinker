Code: import object_detector

def get_buses(image_path):
    # Load the image with Grounding DINO
    obj_detector = object_detector.Object_Detector_Tool()
    results = obj_detector.detect_objects(image_path)

    # Extract the bus labels from the results
    buses = results["object_detection_results"].get("orange_and_black", {}).get("boxes", [])
    bus_labels = set()
    for bus_box in buses:
        bus_label = bus_box["labels"][0]
        bus_labels.add(bus_label)

    return bus_labels

final_result = get_buses("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_21_image_1.jpg")
print("Number of red buses:", final_result)

