labels = ["baseball", "basket"]
confidence_threshold = 0.45
model_size = "tiny"
save_object = True

# Execute and get the detection results
detection_results = detector.execute(labels=labels, confidence_threshold=confidence_threshold, model_size=model_size, save_object=save_object)

# Get the count of detected objects
object_count = detection_results['output_types'][0]['object_number']

# Calculate the color counts
color_counts = {}
for label in detection_results['output_types'][0]['result']:
    color_count = 0
    for obj_result in detection_results['output_types'][0]['result'][label]:
        if obj_result['color'] in color_counts:
            color_counts[obj_result['color']] += obj_result['count']
        else:
            color_counts[obj_result['color']] = obj_result['count']
            color_counts[obj_result['color']]['count'] = obj_result['count']
    color_counts[label]['count'] = color_counts[label].get('count', 0) + obj_result['count']

final_result = {"labels": labels, "count": object_count, "colors": color_counts}

