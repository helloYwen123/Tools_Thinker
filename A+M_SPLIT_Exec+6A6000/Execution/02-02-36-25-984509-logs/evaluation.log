from object_detector import Object_Detector_Tool

# Assign the path of the image to the variable 'image_path'
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_66_image_1.jpg'

# Create an object from the Object_Detector_Tool class
detector_tool = Object_Detector_Tool()

# Read the image path
image = detector_tool.read_image(image_path)

# Run the object detection algorithm
results, object_number = detector_tool.execute(image_path, labels=["snowboarder"], save_object=True, saved_image_path="detected_objects")

# Extract the count for the target label
target_labels = [labels for labels in results.values() if "snowboarder" in labels]
count = len(target_labels)

# Check if more than one color is shown on a hand
glove_masks = [detector_tool.extract_mask_by_coord(label) for label in count if count[0].get("box") and ("index" in label and label["index"].endswith("glove"))]
fingers = [mask for mask in glove_masks if mask["mask"] and mask["bbox"][2] >= mask["bbox"][0] and mask["bbox"][4] >= mask["bbox"][2]][0]
color = None
while color is None and fingers:
    coordinates = [mask["bbox"] for mask in fingers]
    coordinates.extend(coordinates[: coordinates.index(fingers[-2]["bbox"], 1)])

    for i,coord in enumerate(coordinates):
        if (i % 2) == 1:
            color = f"black" if colors[i] == "pink" else f"blue"
        else:
            color = f"white" if colors[i] == "pink" else f"red"

    try:
        colors.append(color)
    except:
        colors.append(None)
    fingers = fingers[: coordinates.index(fingers[-1]) + 1]

# Check if more than one color is shown on a hand
if count and len(count) > 1:
    print(f"More than one color on the woman's hands: {color}")
else:
    print(f"No more than one color is shown on the woman's hands.")

# Clean up the object detection results
detector_tool.close()

# Print the remaining colors in use
for color in colors[::-1][::-1]:
    print(f"Remaining color: {color}")

