def detect_objects(image_path, labels, threshold=None, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
    try:
        detection_result = Image_Load(image_path=image_path, labels=labels)
        if detection_result:
            if threshold:
                if detection_result['image']:
                    detection_result['detected_objects'] = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)
                    return detection_result
            else:
                return detection_result
    except Exception as e:
        print(f"An error occurred: {e}")
    return {"result": "", "error": "An error occurred"}

def main():
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_113_image_1.jpg"
    labels = ["baseball", "basketball"]
    final_result = detect_objects(image_path=image_path, labels=labels)
