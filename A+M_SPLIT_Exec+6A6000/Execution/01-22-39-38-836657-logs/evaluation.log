Code: from object_detector import Object_Detector_Tool

def count_birds_facing_right(image_path):
    # Initialize the object detector tool
    detector_tool = Object_Detector_Tool(image_path, ['birds'],
                                        [1.0],
                                        "tiny",
                                        ["detected_objects"])

    # Detect birds in the image and group them by label and score
    detection_results = detector_tool.execute()

    # Calculate the total count of birds
    total_birds = sum(1 for results in detection_results.values() if "birds" in results.keys())

    # Check the number of birds facing the right of frame
    right_birds = sum(results["boxes"][0][0][0] < result["boxes"][0][1][0] for result in detection_results.values() if results["labels"] == 'birds')

    return total_birds, right_birds

