# Function to execute the tool
def execute_tool(tool_config):
    input_path = tool_config.get('image', 'The image path is not provided in the command.')
    labels = tool_config.get('labels', ['baseball', 'basket'])
    threshold = tool_config.get('threshold', 0.45)
    model_size = tool_config.get('model_size', 'tiny')
    save_object = tool_config.get('save_object', False)
    saved_image_path = tool_config.get('saved_image_path', 'detected_objects')
    
    # Execute the tool
    results = Object_Detector_Tool.execute(input_image_path=input_path, labels=labels, confidence_threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    # Access and process the results
    final_result = {
        'count': results[1]['object_number']
    }
    
    return final_result

