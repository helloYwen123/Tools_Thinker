def count_red_building(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    detector = Object_Detector_Tool(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    if detector.object_number.values() and labels:
        for label, count in detector.object_number.items():
            print(f"{label}: {count}")
    else:
        print("There are no red buildings detected in the image.")

