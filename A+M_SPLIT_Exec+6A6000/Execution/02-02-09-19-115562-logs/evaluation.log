Code: import numpy as np
from object_detector import Object_Detector_Tool

def find_tigers(image_path):
    # Read the image
    img = np.array(Image.open(image_path))

    # Initialize the object detector
    detector = Object_Detector_Tool()

    # Detect the objects in the image
    results = detector.predict(img)

    # Find the bounding boxes of the tigers
    tigers = ['cat', 'dog', 'duck']
    boxes = []
    for i in range(len(results.data)):
        if results.data[i]['label'].lower() in tigers:
            ymin, xmin, ymax, xmax = results.data[i]['bbox']
            boxes.append({"bbox": ( xmin, ymin, xmax, ymax), "label": "tiger", "confidence": results.data[i]['confidence']} )
    if boxes:
        # Find the object with the highest confidence
        max_confidence = max([box['confidence'] for box in boxes])
        i = boxes.index({'label': 'tiger', 'confidence': max_confidence})
        return {"label": "tiger", "bbox": boxes[i]['bbox'], "id": i, "confidence": max_confidence}
    else:
        return {"label": "tiger", "bbox": [-1,-1,-1,-1], "id": -1, "confidence": -1}

