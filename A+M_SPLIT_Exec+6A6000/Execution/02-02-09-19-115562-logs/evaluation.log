Code: def calculate_tigers(image_path):
    object_detection_tool = Object_Detector_Tool()
    image_path = image_path
    labels = ["tiger"]
    save_object = True
    saved_image_path = "detected_objects"
    threshold = 0.45

    object_detection_tool.model_size = "base"
    detected_objects, object_number = object_detection_tool.execute(image_path, labels, save_object, threshold)

    if object_number[0]["baseball"] > 0:
        object_number[0]["baseball"] = object_number[0]["baseball"] + 1

    final_result = {0: object_number[0]}
    return final_result

# Use the function with your image path
