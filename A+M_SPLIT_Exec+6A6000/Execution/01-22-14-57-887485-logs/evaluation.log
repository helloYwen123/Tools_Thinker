Code: from tool_object_detector_tool import Object_Detector_Tool

def count_red_bikes(image_path):
    label_list = ["red_bike"]
    threshold = 0.45
    model_size = "tiny"

    detector = Object_Detector_Tool(image_path, label_list, threshold, model_size, save_object=True)
    
    # Detect red bikes
    results = detector.execute()
    
    # Extract red bike count
    red_bike_count = results[0]["saved_image_paths"]

    return red_bike_count

final_result = count_red_bikes("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_110_image_1.jpg")

