from object_detector import Object_Detector_Tool

def count_players_with_face_guards(image_path):
    """Detects players with face guards in an image and counts them."""
    try:
        object_detector_tool = Object_Detector_Tool(image_path, labels=["face guard"])
        ground_objects = object_detector_tool.execute()
        if "face guard" in ground_objects["output_types"][0]["fields"].keys():
            face_guard_count = ground_objects["output_types"][0]["fields"]["face guard"]["count"]
        else:
            face_guard_count = 0
    except Exception as e:
        face_guard_count = 0

    return face_guard_count

