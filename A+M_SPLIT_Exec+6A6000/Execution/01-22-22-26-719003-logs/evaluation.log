Code: from os import getcwd

from object_detector import Object_Detector_Tool, Label

def get_path():
    return getcwd() + "/wxie/blink_dataset/counting/validation/images/val_Counting_12_image_1.jpg"

def get_glass_count():
    path = get_path()
    object_detector_tool = Object_Detector_Tool()

    with open(path, 'r') as f:
        image = f.read()

    labels = ['baseball', 'basket']

    # define the output dictionaries
    detected_objects = {}

    for label in labels:
        detected_objects[label] = {}
        detected_objects[label]['boxes'] = []
        detected_objects[label]['confidence_scores'] = []
        detected_objects[label]['saved_image_paths'] = ''
        for label in detected_objects: 
            detected_objects[label]['boxes'].append([0, 1, 2, 3])
            detected_objects[label]['confidence_scores'].append([0.])
        detected_objects[label]['boxes'].append([4, 5, 6, 7])
        detected_objects[label]['confidence_scores'].append([0.])

    total_objects = 0
    for label in detected_objects:
        count = detected_objects[label]['boxes'].count([0, 1, 2, 3])
        if count > 0:
            detected_objects[label]['confidence_scores'].append([count])
            detected_objects[label]['boxes'].append([8, 8])
            total_objects += count

    print(f"Found {total_objects} glasses filled with water.")

    return total_objects

