code:from object_detector import Object_Detector_Tool

def answer_question(image_path, labels=None, threshold=0.45, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    results, object_count = Object_Detector_Tool.execute(image_path, labels, threshold, model_size, save_object, saved_image_path)
    final_result = {"total_results": results, "labels": []}
    for label, result in results.items():
        total_count = sum([result["total_count"] for each_result in result["boxes"] for each_label in each_result])
        if len(result["boxes"]) > 0:
            final_result["labels"].append({"label": label, "count": total_count, "boxes": result["boxes"]})
    return final_result

