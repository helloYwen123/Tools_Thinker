Code: from object_detector import Object_Detector_Tool as ODTC

def count_glasses(image_path: str) -> int:
    final_result = {}
    object_detector_tool = ODTC()
    labels = ["glasses", "glasses"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True

    # Detect glasses in the image
    glasses_detections = object_detector_tool.detect_objects(image_path,
                                                             labels=labels,
                                                             threshold=threshold,
                                                             model_size=model_size,
                                                             save_object=save_object)

    if glasses_detections:
        for glasses_detection in glasses_detections:
            glasses_label = glasses_detection["label"]
            glasses_count = glasses_detection["bbox_count"]
            final_result[glasses_label] = glasses_count
    else:
        print("No glasses detected in the image")

    return final_result

