# Size of the model to use (tiny or base)
model_size = "tiny"

# Whether to save the detected objects as images
save_object = True

# Path to save the detected objects (if save_object is True)
saved_image_path = "detected_objects"

# Detect objects in the image
detected_objects, object_number = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)

# Calculate the total number of detections
total_object_number = len(detected_objects) + object_number

# Determine how many people are wearing glasses
glasses_count = set(detected_objects.keys()).intersection({"glasses"})

final_result = total_object_number if glasses_count == 0 else total_object_number - set(glasses_count).cardinality()

print("Final result:", final_result)

