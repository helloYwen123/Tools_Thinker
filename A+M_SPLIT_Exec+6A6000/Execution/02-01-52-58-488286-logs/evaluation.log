Code: from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_15_image_1.jpg"

# Labels to detect
labels = ["baseball", "basket"]

# Confidence threshold
threshold = 0.45

# Size of the model to use
model_size = "tiny"

# Whether to save the detected objects as images
save_object = True
 saved_image_path = "detected_objects"

object_detector_tool = Object_Detector_Tool(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Get total count for each label
label_count = object_detector_tool.user_metadata['output_types'][1]

# Calculate the number of people wearing glasses
number_of_people_wearing_glasses = 0
for value in label_count.values():
    if "person" in value:
        number_of_people_wearing_glasses += 1

final_result = number_of_people_wearing_glasses

print("Number of people wearing glasses:", final_result)

