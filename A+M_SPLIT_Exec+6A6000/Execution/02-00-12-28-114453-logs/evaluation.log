def count_empty_glasses():
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_74_image_1.jpg"
    labels = ["wineglasses"]
    threshold = 0.3
    model_size = "tiny"
    save_object = False

    tool = Object_Detector_Tool()
    result = tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

    if "object_count" in result:
        wineglasses_count = result["object_count"]["wineglasses"]
    else:
        return None

    empty_glasses_count = 0
    for _, boxes in result["detected_wineglasses"].items():
        empty_glasses_count += 1

    empty_glasses_count -= 1  # The first empty glass is counted twice

    final_result = {"count": empty_glasses_count}
    return final_result

result = count_empty_glasses()
print("Total empty glasses:", result["count"])

