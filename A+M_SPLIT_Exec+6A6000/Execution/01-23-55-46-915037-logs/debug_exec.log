code:from object_detector import Object_Detector_Tool

def count_tigers(image_path):
    detector_tool = Object_Detector_Tool()

    class_labels = ["tiger"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True
    saved_image_path = "detected_objects"
    
    result_dict = detector_tool.execute(image=image_path, labels=class_labels, save_object=save_object, threshold=threshold, model_size=model_size, output_type=("detected_objects"))

    count_dict = result_dict["total_count"]
    result_dict["detected_objects"].sort(key=lambda x: x["boxes"], reverse=True)
    count_dict["tigers"] = result_dict["detected_objects"].keys().count("tiger")
    return count_dict

