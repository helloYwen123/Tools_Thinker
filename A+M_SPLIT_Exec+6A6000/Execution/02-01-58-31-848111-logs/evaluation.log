Code: from object_detector import Object_Detector_Tool

# Function to extract number of telephone poles to the right of the truck
def count_poles(image_path):
    # Load image
    tool = Object_Detector_Tool(image_path)

    # Execute detection
    results = tool.execute(labels=["telephone pole"], threshold=0.45, model_size="tiny")

    # Extract telephone pole count
    pole_counts = {label: count for label, count in results['object_number'].items()}

    return pole_counts

# Provided image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_85_image_1.jpg"

# Get telephone pole count on the road
final_result = count_poles(image_path)

print(final_result)

