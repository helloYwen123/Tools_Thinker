# Check the result
if detected_objects and object_number:
    # Analyze the results
    for obj in detected_objects:
        # print(obj)
        for key in obj:
            print(obj[key])

    # Print the total number of detected objects
    print("Total detected objects:", len(detected_objects))
else:
    print("No objects detected.")

