    if label in ["baseball", "basket"]:
        bbox = detection['bbox']
        bbox_dict[str(bbox[0]) + '_' + str(bbox[1])] = [bbox[2], bbox[3], label]
        object_number_dict[label] = obj_detections['object_number']

