from object_detector import Object_Detector_Tool

# Function to count chicken nugget pieces
def count_chicken_nuggets(image_path):
    # Set the confidence threshold to 0.8
    threshold = 0.8
    
    # Create an object_detector tool instance with the path to the image
    tools_inst = Object_Detector_Tool(image_path, labels=["chicken_nugget"], save_object=True)

    # Detect chicken nuggets using the object detector
    results_dict = tools_inst.execute()
    
    # Count the chicken nugget pieces in the image
    total_chicken_nuggets = 0
    chicken_nugget_detection = results_dict['detected_objects']
    for detection in chicken_nugget_detection['boxes']:
        x1, y1, x2, y2 = detection['bbox']
        x1, y1, x2, y2 = [int(x * tools_inst.model_size) for x in (x1, y1, x2, y2)]
        area = (x2 - x1 + 1) * (y2 - y1 + 1)
        total_chicken_nuggets += area
    
    return total_chicken_nuggets
