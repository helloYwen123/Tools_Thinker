# Function to create a list of labels for the object detection
def create_labels_from_image(image_path):
    obj_detector_tool = Object_Detector_Tool(
        image_path,
        labels=["yellow School Bus"],
        save_object=False
    )
    return obj_detector_tool.execute()

# Function to get the count of each label from the detection results
def get_label_count(detected_objects):
    label_count = {}
    for label, result in detected_objects.items():
        if label in label_count:
            label_count[label] += 1
        else:
            label_count[label] = 1
    return label_count

