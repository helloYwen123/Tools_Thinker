Code: from object_detector import Object_Detector_Tool

def count_vowel_letters(image_path):
    object_detector_tool = Object_Detector_Tool()
    labels = ["baseball", "basket"]
    model_size = "tiny"
    threshold = 0.45
    save_objects = False
    saved_image_path = "detected_objects"

    obj_num = object_detector_tool.execute(image_path="image_path", labels=labels, model_size=model_size, save_objects=save_objects, threshold=threshold, saved_image_path=saved_image_path)

    vowel_letters = ["a", "e", "i", "o", "u"]

    vowel_count = 0
    for detection_obj_result in obj_num: 
        for box in detection_obj_result["boxes"]:
            letter = detection_obj_result["labels"][0]
            if letter in vowel_letters:
                vowel_count += 1

    return vowel_count

