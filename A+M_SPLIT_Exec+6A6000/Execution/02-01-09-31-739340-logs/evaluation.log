Code: from object_detector import Object_Detector_Tool  # Load the object_detector tool

def count_common_vowels(image_path):
    # Load the image
    image = Object_Detector_Tool.load_image(image_path)
    
    # Detect text on the image
    detected_text = Object_Detector_Tool.detect_objects(image, "letters", 0.45, "tiny", save_object=True)
    
    # Initialize a dictionary to hold the vowel counts
    vowel_counts = {}
    
    # Count the occurrences of each vowel
    for letter in detected_text["detected_objects"]:
        if letter["letter"].lower() in "aeiou":
            if letter["label"] not in vowel_counts:
                vowel_counts[letter["label"]] = 0
            vowel_counts[letter["label"]] += 1
    
    # Return the count of common vowels
    return vowel_counts
    
# Function to find common vowels in a given image path
def find_common_vowels(image_path):
    vowel_count = count_common_vowels(image_path)
    most_common_vowel = max(vowel_count, key=vowel_count.get)  # Find the most common vowel
    
    return most_common_vowel
    
find_common_vowels("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_69_image_1.jpg")
final_result = find_common_vowels("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_69_image_1.jpg")
print("The most common vowel is: ", final_result)

