from object_detector import Object_Detector_Tool

# Instantiate the object_detector_tool
object_detector_tool = Object_Detector_Tool()

# Get information from the command
command_output = input("Enter the command: ")

# Execute the object_detector_tool
detected_objects, object_count = object_detector_tool.execute(image=command_output, labels=['Baseball', 'Basket'], save_object=True, saved_image_path="detected_objects")

# Convert the detected results to a string
final_result = ""
for label, detection in detected_objects.items():
  final_result += f"{'Baseball' if label == 'Baseball' else 'Basket' if label == 'Basket' else label}:\n" + \
                 f"  {'saved_image_path':0} {detection['saved_image_path']}\n" + \
               f"{'count':0} : {detection['count']} \n"

print(f"Detected results: {final_result}")


