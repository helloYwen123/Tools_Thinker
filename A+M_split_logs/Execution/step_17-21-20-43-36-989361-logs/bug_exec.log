def calculate_chairs(image_path):
    object_detector_tool = Object_Detector_Tool()
    detected_objects = object_detector_tool.execute(image=image_path, save_object=True, saved_image_path='detected_objects')
    
    chair_count = {}
    for detected_objects in detected_objects:
        chair_label = detected_objects["label"]
        if chair_label in chair_count:
            chair_count[chair_label] += 1
        else:
            chair_count[chair_label] = 1
    
