from object_detector_tool import Object_Detector_Tool

# Define the input image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2942_0.png"

# Define the list of detected labels to be checked and the confidence threshold
labels = ["baseball", "basket"]
confidence_threshold = 0.35  # Confidence threshold for detection

# Execute the object detection
object_detection_tool = Object_Detector_Tool()
detected_objects, object_number = object_detection_tool.execute(image=image_path, labels=labels, confidence_threshold=confidence_threshold, threshold=None, model_size="tiny", save_object=True, saved_image_path="/detected_objects")

# Prepare the final result
final_result = {}

# Check if a label is detected
for label in labels:
  # Count the number of detected objects for the label
  detected_objects_per_label = object_number.get(label, 0)
  if detected_objects_per_label > 0:
    # Collect the bounding box coordinates of detected objects
    bounding_box_coordinates = [obj['box'][0] for obj in detected_objects_per_label]
    
    # Calculate the total number of detected objects for the label
    total_detected_objects = sum(obj['saved_image_path'].count() for obj in detected_objects_per_label)
    
    # Prepare the object results for each label
    object_results_per_label = [None] * len(detected_objects_per_label)
    object_results_per_label[labels.index(label)] = {
        'object_result': bounding_box_coordinates, 'label': label, 'total_detected_objects': total_detected_objects
    }
    
    # Extract and append the extracted text
    extraction_tool = Text_Detector_Tool()
    text_result = extraction_tool.execute(image=''.join(detected_objects_per_label), languages=['en', 'de'], detail=0)
    if text_result:
      text_results = []
      for language in languages:
        for _, language_details in text_result.items():
          language_result = ''
          for t, info in language_details.items():
            if isinstance(t, str) and t == language and info:
              language_result += t + ' '
          text_results.append(language_result.strip())
      final_result[label] = object_results_per_label + [text_results]
    else:
      final_result[label] = None

# Print the final results
final_result


