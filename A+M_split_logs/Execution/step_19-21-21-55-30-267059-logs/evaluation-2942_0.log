from Object_Detector_Tool import Object_Detector_Tool

def count_objects(image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects"):
    # Load the model
    detector_tool = Object_Detector_Tool()
    input_image = detector_tool.execute(image_path, labels, save_object, saved_image_path)
    if input_image is None:
        return None

    # Process the model's output
    if input_image[0]:
        object_data = input_image[1]
    else:
        return None

    objects_detected = object_data[0]
    object_number = object_data[2]

    return objects_detected, object_number


