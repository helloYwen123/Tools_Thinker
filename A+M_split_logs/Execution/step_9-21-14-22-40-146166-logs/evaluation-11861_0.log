from object_detector_tool import Object_Detector_Tool

def count_stools():
    object_detector = Object_Detector_Tool()
    detected_objects = object_detector.execute(image='path/to/image', labels=['Stool'], threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects')
    
    for stool in detected_objects['Stool']:
        stool_score = stool['score']
        stool_count = stool['box'][0][0] // stool['box'][1][0] + stool['box'][0][1] // stool['box'][1][1]
        
    return stool_count

final_result = count_stools()
print("Image:", "path/to/image")
print("Detected stools:", final_result)


