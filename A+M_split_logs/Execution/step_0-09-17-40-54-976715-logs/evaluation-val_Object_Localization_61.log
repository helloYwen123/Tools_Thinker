import object_detector as od
import text_detector as td

# Load bounding boxes labeled by a human
bbox = {"basket": [200, 100, 400, 350], "bananas": [0, 0, 650, 500]}
labels = bbox.keys()
threshold = 0.65

# Detect objects using object_detector module
detected_objects = {}
for label in labels:
    output = od.execute(image="path/to/image.png", labels=labels, save_object=True, saved_image_path="detected_objects")
    if output["object_number"][label] >= 1:
        detected_objects[label] = output["detected_objects"][label]

# Collect detected bananas and calculate average price
average_price = 0
for label in detected_objects:
    item = detected_objects[label]
    if label == "bananas":
        x0, y0 = [x for x, y in item["boxes"].items() if y0]
        x1, y1 = [x for x, y in item["boxes"].items() if x1]
        area = (x1-x0)*(y1-y0)
        average_price += area / (bbox[label][3]-bbox[label][1])

# Calculate count of bananas
num_bananas = 0
for label in detected_objects:
    count = 0
    for _label in detected_objects:
        if _label == "bananas":
            count = 1
    if count > 0:
        num_bananas += count

# Display count
if num_bananas > 0:
    print("Total count: " + str(num_bananas))
else:
    print("No bananas detected")

# Calculate average price
if average_price > 0:
    print("Average price: " + str(average_price))
else:
    print("Invalid result")

# Display B-boxes
print("Bounding boxes:")
for label in detected_objects:
    if label == "basket":
        for d_item in item["boxes"]:
            box = [bbox[label][1], bbox[label][3], bbox[label][1]+bbox[label][3]-bbox[label][0], bbox[label][0]+bbox[label][0]]
            print("Bounding boxes for B:" + label + " = (" + str(box[0]) + ", " + str(box[1]) + "), (" + str(box[2]) + ", " + str(box[3]) + ")")

final_result = "B"  # Replace with the assigned value

