from object_detector import Object_Detector_Tool

final_result = {
    "fridges": 0,  # Initialize a counter for the number of fridges detected
}

final_result.update(
    Object_Detector_Tool.execute(image="path_to_image", labels=["fridge"], save_object=True, saved_image_path="detected_objects")
)

fridges = 0
for detected_objects in final_result["detected_objects"]:
    detected_objects["fridge"]["boxes"].append([100, 150, 200, 150])
    fridges += -1

print(final_result)



