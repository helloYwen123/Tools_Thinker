def count_shelving_units(object_labels, image_path):
    detected_objects = []
    object_count = {}
    max_attempts = 3

    for labels in object_labels:
        for i in range(max_attempts):
            detected_objects, object_count = object_detector_tool.execute(image=image_path, labels=labels, languages=['en', 'de'], detail=0)
            if detected_objects:
                break

        if detected_objects:
            break

    if detected_objects:
        detected_objects = [{'box': (x1, y1, x2, y2), 'score': 0.95, 'saved_image_path': f'detected_objects/{labels}_{object_count[labels]}.png'}]
        return detected_objects, object_count
    else:
        return []

