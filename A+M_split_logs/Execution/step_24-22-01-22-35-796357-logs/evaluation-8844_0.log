from object_detector.Tool import Object_Detector_Tool

def get_shelving_units(image_path):
    tool = Object_Detector_Tool()
    labels_to_locate = ['baseball', 'basket']
    tool.execute(image=image_path, labels=labels_to_locate)
    detected_objects = tool.output_object_number
    if not 'baseball' in detected_objects or not 'basket' in detected_objects:
        return 0
    box_list = []
    object_counts = {}
    for label, bentry1 in detected_objects:
        box_indices = [(i, j) for i, j in bentry1 if len([1 for (x, y) in bentry1 if x == i and y == j])]
        box_dict = {'name': label, 'boxes': [box for box in box_indices]}
        if label == 'baseball':
            box_list.append(box_dict)
        else:
            cv2.rectangle(cap0, (bbox[0], bbox[1]), (bbox[2], bbox[3]), color=([128, 0, 255], .3) if label == 'basket' else [0, 255, 128], 1)
            object_counts[label] = object_counts.get(label, 0) + 1
    return len(box_list) - 1 + len([box_dict['boxes'][-1][2] - box_dict['boxes'][0][0] for box_dict in object_counts.items() if sum(box_dict['boxes']) <= 1 and box_dict['boxes'][-1][2] - box_dict['boxes'][0][0] > 0])

def get_captioned_image(image_path, languages=['en', 'de']):
    tool = Text_Detector_Tool()
    result = tool.execute(image=image_path, languages=languages)
    caption = ''
    for block in result['result']:
        if block.get('name', 'none') == 'Detected text':
            caption += f"Detected text in {block.get('language', 'None')}: {block.get('bbox')} with {block.get('confidence', '0.'):0.2f}%\n"
    return caption

final_result = get_shelving_units('/home/yourcomputer/user/8844_0.png', languages=['en', 'de'])
print(final_result)


