from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels=['basketball', 'baseball'], save_object=True, saved_image_path="detected_objects"):
    try:
        object_detector_tool = Object_Detector_Tool()
        
        detected_objects = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
        
        return detected_objects
    except Exception as e:
        print(f"Error occurred while detecting objects: {e}")
        return None

final_result = detect_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/8844_0.png", labels=['basketball', 'baseball'], save_object=True, saved_image_path="detected_objects")

if final_result:
    # Extract detected objects and count each label
    object_count = {}
    for label in final_result[0]:
        if label:
            object_count[label['score']] = label['box']
    
    print(f"Detected Objects:")
    for i, (box, score) in enumerate(object_count.items()):
        print(f"Obj {i}: {(box[0], box[1], box[2], box[3])}, Score: {score:.2f}")
    print(f"Total Objects: {len(object_count)}")

else:
    print("No objects detected in the image")


