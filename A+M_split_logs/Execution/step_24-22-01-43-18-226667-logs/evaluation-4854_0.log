from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold=0.35, model_size='tiny', save_objects=True):
    object_detector_tool = Object_Detector_Tool()
    labels_list = labels if isinstance(labels, list) else [labels]  # Ensure labels is a list
    detected_objects = object_detector_tool.execute(image_path=image_path, labels=labels_list, threshold=threshold, model_size=model_size, save_object=save_objects)
    return detected_objects

detected_objects, object_number = detect_objects(image='path/to/dining_table_image.png', labels=['Table', 'Chair'])
print(f"Number of dining tables: {len(detected_objects)}")
print(f"Detected dining tables: {detected_objects}")
