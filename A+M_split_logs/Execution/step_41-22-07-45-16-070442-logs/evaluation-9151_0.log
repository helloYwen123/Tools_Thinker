def find_common_text(image_loc, languages=['en', 'de']):
    text_detector_tool = Text_Detector_Tool()
    text = text_detector_tool.execute(image=Str(image=image_loc), languages=languages)
    
    if "Detected text" not in text:
        return False

    detected_texts = [
        [[col[0][0], col[0][1], col[0][2], col[0][3]], text["Detected text"], text["Detected text confidence"]]
    ]
    
    for language in text.split(";")[1].split(','):
        text_detector_tool = Text_Detector_Tool()
        detected_texts += [
            [[col[0][0], col[0][1], col[0][2], col[0][3]], text["Detected text", 0.5], text["Detected text confidence"]]
            for col in text.split(";")[0].split('\n') if col != 'text'
        ]
    
    return detected_texts

