def count_beds(image_path):
    try:
        detected_objects = object_detector_tool.execute(image=image_path, labels=['Bed'], save_object=True)
        for label in detected_objects:
            if label['label'] == 'Bed':
                return int(label['count'])
        return 0
    except Exception as e:
        error = str(e)
        print(f"Error detected: {error}")
        return 0

final_result = count_beds('/nfs/data8/liao/wxie/SAT/SAT_images_train/3769_0.png')
print("Count of beds:", final_result)

if final_result == 0:
    print("There are no beds visible in the image.")
else:
    print(f"There are {final_result} beds visible in the image.")


