from object_detector_tool import Object_Detector_Tool

final_result = {}
labels_to_count = ['baseball', 'basket']

def count_detected_balls(boxes, scores, saved_image_path="detected_objects"):
  for label in labels_to_count:
    detected_objects = [
      {"objects": [{"box": box, "score": score, "saved_image_path": saved_image_path}] for box, score in scores[label].items()}
    ]
    if detected_objects:
      detected_objects_dict = {"{}: {}".format(label.title(), len(detected_objects)): detected_objects}

    elif labels_to_count:
      detected_objects = {
        "{}: 0".format(label.title()[:2]) if label else None for _ in range(len(labels_to_count) - 1)
      }
      detected_objects["{}: {}".format(label.title(), len(detected_objects))] = detected_objects

    else:
      detected_objects = {}

  return detected_objects

if __name__ == "__main__":
  image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3769_0.png"
  labels_to_count = ['baseball', 'basket']

  detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels_to_count, save_object=True, saved_image_path="detected_objects")
  
  final_result["detected_objects"] = count_detected_balls(detected_objects, object_number)
  
  print(final_result)


