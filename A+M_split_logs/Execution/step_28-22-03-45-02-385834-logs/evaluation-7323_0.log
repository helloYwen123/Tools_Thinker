from Object_Detector_Tool import Object_Detector_Tool

class ImageVisualizer:
    def __init__(self):
        self.object_detected_image = None
        self.label_count_dict = None
        self.label_to_count = None

    def execute(self, image_path, labels, save_object=False, saved_image_path=""):
        if not save_object:
            return "Saving object images is not set"

        detector = Object_Detector_Tool()

        with open(image_path, 'rb') as file:
            image_data = file.read()
            labels_output = []

            for label in labels:
                results = detector.execute(image_data, model_size='tiny', labels=[label], save_object=True, saved_image_path=saved_image_path)  # Change model_size to use a different model, e.g., 'large'

