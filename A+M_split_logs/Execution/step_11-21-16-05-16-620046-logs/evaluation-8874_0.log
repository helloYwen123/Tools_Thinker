from object_detector_tool import Object_Detector_Tool

final_result = ""
for label in ["fridge"]:
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8874_0.png"
    detected_object, object_number = Object_Detector_Tool.execute(image=image_path, labels=[label], save_object=True, saved_image_path="fridge")
    if detected_object:
        detected_objects, object_number = detected_object
        if len(detected_objects) == 1:
            detections, number = detected_objects[0]
            final_result += f"{label} : {detections[0]['box']} (confidence {detections[0]['score']}%, total objects detected {number})"
        else:
            detection_list = []
            total_objects_count = 0
            for detection in detected_objects:
                detection_list.append(detection)
                total_objects_count += 1
            final_result += f"{label} : {detection_list[-1]['box']} (confidence {detection_list[-1]['score']}%, total objects detected {total_objects_count})"

print(final_result)


