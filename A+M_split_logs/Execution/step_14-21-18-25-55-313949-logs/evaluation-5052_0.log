def count_doors(image_path, labels):
    # No need to import the necessary tools, as they are not needed for this task.
    # The tool is not required in this case, since the question relates to the presence of doors in a 3D virtual space.

    # Sample image path
    image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5052_0.png'

    # Sample labels ('baseball', 'basket')
    labels = ['baseball', 'basket']

    # Sample save_object=True, saved_image_path='detected_objects'
    save_object = True
    saved_image_path = 'detected_objects'

    # Sample threshold=0.35
    threshold = 0.35

    try:
        detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=(save_object, saved_image_path), threshold=threshold)
        if detected_objects['baseball']:
            total_detected_baseball = detected_objects['baseball'][0]['boxed']['boxes']["object_number"] + 1
            total_detected_basket = detected_objects['basket'][0]['boxed']['boxes']["object_number"]
        elif detected_objects['basket']:
            total_detected_baseball = detected_objects['baseball'][0]['boxed']['boxes']["object_number"]
            total_detected_basket = detected_objects['basket'][0]['boxed']['boxes']["object_number"] + 1
        else:
            total_detected_baseball = detected_objects['baseball'][0]['boxed']['boxes']["object_number"]
            total_detected_basket = detected_objects['basket'][0]['boxed']['boxes']["object_number"]
        return total_detected_baseball, total_detected_basket
    except Exception as e:
        print(f"Error occurred: {e}")
        return 0, 0

