def countDoors(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    count = len(detected_objects)
    detected_objects = {k: v for k, v in detected_objects.items() if k not in labels}
    return count, detected_objects

result = countDoors('/nfs/data8/liao/wxie/SAT/SAT_images_train/5052_0.png', ['Door'])
print("Number of doort instances identified:", result[0])
for key, value in result[1].items():
    print(f"{key} detected {value}: {value[0]}")


