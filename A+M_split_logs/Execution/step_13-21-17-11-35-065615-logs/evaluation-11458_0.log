from object_detector_tool import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/11458_0.png")

if final_result:
    detected_objects = final_result["detected_objects"]
    total_objects = final_result["object_number"]

    print(f"It contains {len(detected_objects)} objects in total.")
    print(f"Detected objects found in the image are as follows:")
    for label, result in detected_objects.items():
        if result:
            box = result["box"]
            score = result["score"]
            saved_image_path = result["saved_image_path"]
            text = f"Detected text: {label}\nConfidence: {score}\nCoordinates: {box}"

            print(f"\t{label} - {box}, {len(result['bbox'])} detection results.")
            print(text)

            if saved_image_path:
                print(f"Additional details saved in: {saved_image_path}")
else:
    print("Text detection failed.")


