from object_detector_tool import Object_Detector_Tool

final_result = ""
# Execute object_detector_tool
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image="path/to/image", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Check for empty image path in saved_image_path
if saved_image_path is not None:
    detected_objects.pop(0)

# Calculate total count for each detected label
total_objects = {"baseball": object_detector_tool.object_number["baseball"], "basket": object_detector_tool.object_number["basket"]}

print(final_result.format("detected_objects : {"))
for object, detection in detected_objects.items():
    print(f"    {''.join([f"'{object}'", f":[{f'[{box[0], box[1]},{box[2], box[3]}]}' for box in detection['box']])}" if len(detected_objects) > 1 else f"    {''.join([f"{''.join([f'{box[0]}, {box[1]}, {box[2]}, {box[3]}'}}' for box in detection['box']])}" if len(detected_objects) == 1 else "    {''.join([f"{''.join([f'{box[0]}, {box[1]}, {box[2]}, {box[3]}'}}' for box in detection['box']])}" if len(detected_objects) == 2 else "    {''.join([f"{''.join([f'{box[0]}, {box[1]}, {box[2]}, {box[3]}'}}' for box in detection['box']])}" if len(detected_objects) == 3 else "",
              "score={:.2f}".format(detection['score'])}, {'saved_image_path':
                                                         f"{detected_objects['saved_image_path'][object]}, {\"total_count\": \"{object_number[object]}\", \"total_objects\": {total_objects[object]}}}"))
print("\"}")

final_result += "\"}" + "\nobject_number : {"
for object, count in total_objects.items():
    final_result += f"\t{object} : {count},\n"

print(final_result)


