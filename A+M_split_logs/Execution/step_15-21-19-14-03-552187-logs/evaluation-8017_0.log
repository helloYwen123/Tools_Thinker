def calculate_number(text_blocks):
    total_texts = 0
    for block in text_blocks:
        total_texts += block[2]
    return total_texts

# Combining results
final_result = (detected_text_objects, {
    'baseball': calculate_number( detected_text_objects ), 'basket': calculate_number( detected_text_objects )}) if detected_objects else ([])


