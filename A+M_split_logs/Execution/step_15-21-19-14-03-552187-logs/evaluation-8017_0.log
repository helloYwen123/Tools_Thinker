from object_detector_tool import Object_Detector_Tool

class Image_Analysis:
    def analyze_scene(scene_image_path):
        detected_objects = {}

        # Detect baseball base and basketball in the image
        object_detector_tool = Object_Detector_Tool()
        result_object_number = object_detector_tool.execute(image=scene_image_path, languages=['en', 'de'], detail=2)

        
        if result_object_number['basketball'] is not None:
            basketball_objects = result_object_number['basketball']
            for obj in basketball_objects:
                object_type = 'basketball'
                object_box = obj['box']
                object_score = f'{obj["score"]}' if 'score' in obj else None
                detected_objects[object_type] = detected_objects.get(object_type, []) + [
                    {
                        'box': object_box,
                        'score': objects['score'],
                        'saved_image_path': object_detector_tool.saved_image_path + f'/scene/image_{object_type}_{result_image_number}_{object_box[0]}.png'
                        if scene_image_path.endswith('.png')
                        else f'https://yjcdn.baidu.com/pemedia/memories/{object_box[0]}/baidu_image.jpg'
                    }
                    for objects in object_score
                ]

        if result_object_number['baseball'] is not None:
            baseball_objects = result_object_number['baseball']
            for obj in baseball_objects:
                object_type = 'baseball'
                object_box = obj['box']
                object_score = f'{obj["score"]}' if 'score' in obj else None
                detected_objects[object_type] = detected_objects.get(object_type, []) + [
                    {
                        'box': object_box,
                        'score': objects['score'],
                        'saved_image_path': object_detector_tool.saved_image_path + f'/scene/image_{object_type}_{result_image_number}_{object_box[0]}.png'
                        if scene_image_path.endswith('.png')
                        else f'https://yjcdn.baidu.com/pemedia/memories/{object_box[0]}/baidu_image.jpg'
                    }
                    for objects in object_score
                ]

        return detected_objects, result_object_number['baseball'], result_object_number['basketball'], result_object_number['total_image_objects']

if __name__ == '__main__':
    final_result = analyze_scene(scene_image_path='path_to_your_image_path.png')



