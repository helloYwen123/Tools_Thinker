from object_detector_tool import Object_Detector_Tool

def count_tvs(image_path):
    detected_objects = []
    object_number = {}
    model_size = 'tiny'

    # Detect TVStands in the image
    object_detector = Object_Detector_Tool()
    object_detector.execute(image=image_path, labels=['tv_stand'], save_object=True, saved_image_path='detected_objects')

    for i in object_detector['detected_objects']:
        object_number[i['label']] = i['count']

    return object_number

def count_balls(image_path):
    detected_objects = []
    object_number = {}

    # Detect baseballs in the image
    object_detector = Object_Detector_Tool()
    object_detector.execute(image=image_path, labels=['baseball'], save_object=True, saved_image_path='detected_objects')

    for i in object_detector['detected_objects']:
        if 'box' in i and 'score' in i and 'baseball' in i['label']:
            object_number[i['label']] += 1

    return object_number

def is_playing_tvs():
    """
    Helper function to check if TVStands are on
    """
    # Assume that the TVStands have an indicator light which is on or off.
    on_tv_stand = False
    for i in range(1, 2):
        # Simulate checking the TVStands one by one
        for tv_stand in range(9, 10):
            if 'on' in object_detector['detected_objects'][tv_stand-i].get('status', False):
                on_tv_stand = True

    return on_tv_stand

# Assuming the image paths for TVStands and baseballs have been set by the user
on_tv_stand = is_playing_tvs()

detected_objects = count_balls(image_path)
object_number = count_tvs(image_path)

final_result = {'obj_number': object_number, 'tv_stand_on': on_tv_stand}
print(final_result)


