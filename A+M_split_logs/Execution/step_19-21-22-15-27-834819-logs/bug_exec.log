from object_detector_tool import Object_Detector_Tool

# Function to count the number of dining tables in an image
def count_dining_tables(image):
    tool = Object_Detector_Tool()
    results = tool.execute(image=image, labels=['table', 'baseball'], save_object=True)

    # Loop through the results to count the number of dining tables
    dining_tables_found = 0
    for det_results in results["dining_tables"]:
        for desc in det_results["detected_objects"]:
            if desc["score"] > 0.5:
                dining_tables_found += 1

    return dining_tables_found

