from object_detector import Object_Detector_Tool

# Initialize the tool with the image path and parameters
object_detector_tool = Object_Detector_Tool()

# Execute the tool with the relevant parameters
detected_objects, object_number = object_detector_tool.execute(image="path/to/image", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

print("Detected objects:")
print("Detected objects:")
for label, detection in detected_objects.items():
    print(f"{label}:")
    print(detection)
    print("- Score: ", detection[3])
    if detection[4]:
        print(detection[4][".saved_image_path"])
    print("- Number of detections: ", detection[2])

print("\nObject number:")
print(object_number)


