from Object_Detector_Tool import object_detector_tool

# Define a dictionary to hold the object labels
object_labels = ['baseball', 'basket']

# Specify the required confidence threshold
confidence_threshold = 0.35

# Set up the detection tool options based on the provided examples
tool_options = {
  "threshold": confidence_threshold,
  "model_size": "tiny",
  "save_object": True,
  "saved_image_path": "detected_objects"
}

# Execute the object_detection tool with the provided image data and options
final_result = object_detector_tool.execute(image="image_path", labels=object_labels, save_object=True, **tool_options)

# Extract the number of objects per label from the returned result
object_number = final_result["object_number"]
for label, detected_objects in final_result["detected_objects"].items():
    if label in object_labels:
        print(f"Number of {label}: {len(detected_objects)}")


