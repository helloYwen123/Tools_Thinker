<command># Define the question parameters
question = {
  "image": "path/to/image",
  "labels": ["baseball", "basket"],
  "threshold": 0.35,
  "model_size": "tiny",
  "save_object": False,
  "saved_image_path": "detected_objects"
}

<command># Create the Object_Detector_Tool instance
object_detector_tool = Object_Detector_Tool()

<command># Execute the object detection
detected_objects, object_number = object_detector_tool.execute(
  image=question["image"],
  labels=question["labels"],
  save_object=question["save_object"],
  saved_image_path=question["saved_image_path"]
)

<command># Get the total count for each detected label
total_detection_count = {detected_label: len(detected_objects) for detected_label in detected_objects}
