from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

def count_desk_lamps(image_path):
    tool = Object_Detector_Tool()
    object_labels = ['desk_lamps']
    tool.execute(image_path=image_path, labels=object_labels, threshold=0.35)

    tool = Text_Detector_Tool()
    lang_codes = ['ar']  # English and German
    tool.execute(image_path=image_path, languages=lang_codes, detail=0)

    detected_objects = tool.execute()

    total_objects = len(detected_objects)
    
    final_result = {
        'total_objects': total_objects
    }

    if detected_objects:
        for i in range(total_objects):
            detected_object = detected_objects['baseball'][i] if detected_objects['baseball'] else detected_objects['basket'][i]
            if detected_object:
                final_result['baseball_count'] = len(detected_objects['baseball'])
                final_result['basket_count'] = len(detected_objects['basket'])

    return final_result


