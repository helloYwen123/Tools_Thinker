 def count_windows(image_path):
    from object_detector_tool import Object_Detector_Tool
    detection_tool = Object_Detector_Tool()
    detected_objects, object_number = detection_tool.execute(image_path, labels=["window"], save_object=True)
    window_count = sum((obj["bbox"] for obj in detected_objects if "window" in obj["bbox"]))
    return {'count': window_count, 'object_number': len(detected_objects)}

final_result = count_windows("/nfs/data8/liao/wxie/SAT/SAT_images_train/1616_0.png")
