from object_detector_tool import Object_Detector_Tool

def count_basball_baskets(image_path, save=False):
    detector_tool = Object_Detector_Tool()
    detected_objects = detector_tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=save)
    
    if not detected_objects:
        return "No detected text"
    
    if len(detected_objects[0]["box"]) == 2:
        returned_value = {}
        for label in detected_objects[0]:
            return_value[label] = len(detected_objects[0])
    else:
        detected_objects = detected_objects[0]
        return_value = {}
        for i in range(len(detected_objects)):
            for j in range(len(detected_objects[i])):
                if detected_objects[i][j][0] == [50, 100] and detected_objects[i][j][1] == [200, 200]:
                    return_value["basket"] = len(detected_objects[i])
        
        return return_value


