from Object_Detector_Tool import object_detector_tool

def count_and_locate_interest_objects(image_path, labels=['baseball'], save_object=True, saved_image_path="detected_objects"):
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    
    detected_labels = []
    object_number_dict = {}
    object_count = {}
    
    for obj in detected_objects:
        if obj["label"] in object_count:
            object_count[obj["label"]] += 1
        else:
            object_count[obj["label"]] = 1
        object_number_dict[obj["label"]] = object_count.keys()[0]
        detected_labels.append(obj["label"])
    
    return detected_labels, object_number_dict

final_result = count_and_locate_interest_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/1616_0.png")
