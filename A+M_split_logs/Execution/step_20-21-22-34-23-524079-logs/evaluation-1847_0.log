from object_detector import Object_Detection_Tool

def get_chairs_in_room():
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1847_0.png"
    labels = ['chair']
    threshold = 0.35
    model_size = "tiny"
    save_obj = False

    detection_tool = Object_Detection_Tool()
    detected_images, object_count = detection_tool.execute(image=image_path, labels=labels, save_obj=save_obj, threshold=threshold, model_size=model_size)

    chairs = []
    for label, detection in detected_images:
        if label == 'chair':
            chairs.append(detection)

    return chairs

chairs_in_room = get_chairs_in_room()

if chairs_in_room:
    chairs_result = {"detected_objects": chairs_in_room, "object_number": object_count}
else:
    chairs_result = {"detected_objects": [],
                     "object_number": 0}

final_result = chairs_result


