from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

def get_anchors(image_path):
    image = Image.open(image_path)
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image, labels=["baseball", "basket"], languages=["en", "de"])
    return detected_objects, object_number

def find_text(image_path, languages=["en", "de"], detail=0):
    text_detector_tool = Text_Detector_Tool()
    result = text_detector_tool.execute(image=image_path, languages=languages, detail=detail)
    return result

def answer():
    # Example usage
    detected_objects, object_count = get_anchors("/nfs/data8/liao/wxie/SAT/SAT_images_train/1847_0.png")
    text_analysis = find_text("/nfs/data8/liao/wxie/SAT/SAT_images_train/1847_0.png", languages=["en", "de"], detail=2)

    if text_analysis:
        for det_label, det_box in text_analysis[0]:
            print(f"Text: {det_label}, x: ({det_box[0]}, {det_box[1]}, {det_box[2]}, {det_box[3]}), y: ({det_box[1]}, {det_box[2]}, {det_box[2]}, {det_box[3]}), confidence: {det_box[3]}")
    else:
        print("Text Detection Failed after retries")

# Example to test with a specific path
answer()

