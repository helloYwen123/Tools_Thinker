from tools.object_detector import object_detector_tool
from tools.text_detector import text_detector_tool

# Assuming the image path is in the same directory as the script and contains 'baseball' and 'basket' text.
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1847_0.png"

# Using the text detector tool to find text.
result = text_detector_tool.execute(text=("baseball", "basket"),
                                      language_codes=("en", "de"))

# Using the object detector tool to find baseball and basket in the image.
detected_objects, object_number = object_detector_tool.execute(
    image=image_path, 
    labels=["baseball", "basket"], 
    languages=["en", "de"],
    save_object=True)

# Creating a dictionary to store the detected objects.
objects_detected = {"baseball": [], "basket": []}

# Iterating through the detector result to create the dictionary.
for result in result:
    object_name = result[0]
    for block in result[1]:
        for detection_entry in block:
            if detection_entry["label"] in ["baseball", "basket"]:
                objects_detected["baseball"].append((1, detection_entry["score"]))
                objects_detected["basket"].append((1, detection_entry["score"]))

final_result = {**object_number, **objects_number}


