from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold=0.35, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    object_num = {}
    for label in labels:
        results = []
        detection_engine = Object_Detector_Tool()
        detected_objects = detection_engine.execute(image_path, labels, save_object, saved_image_path)
        for obj, res in detected_objects.items():
            res["box"] = (res["bbox"][0], res["bbox"][1], res["bbox"][2], res["bbox"][3])
            res["confidence"] = res["score"] if save_object else 0.0
            if not save_object:
                object_num[label] = object_num.get(label, 0) + 1
                results.append(res)
        if not save_object:
            results = [x for x in results if x["confidence"] >= threshold]
        # Convert results to JSON
        results_json = [{"bbox": x["bbox"], "score": x["score"]} for x in results]
        object_num[label] = object_num.get(label, 0) + 1
        y = {"detected_objects": results_json, "label_num": object_num}
        final_result = (y, object_num)

    return final_result

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11643_0.png"
labels = ["baseball", "basket"]

result = detect_objects(image_path, labels)
print("\nDetected Objects\n", result[0])
print("Number of Labels\n", result[1])


