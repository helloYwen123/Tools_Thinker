from text_detector import Text_Detector_Tool

# Function to count and locate all text in a given image
def count_and_locate_text(image_path):
    text_detector = Text_Detector_Tool()
    result = text_detector.execute(image_path, languages=['en', 'de'], detail=0)
    text_blocks = result['text_blocks']
    return text_blocks

# Given image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11643_0.png"

# Counting and Locating all Text in the Given Image
count_and_locate_text(image_path)


