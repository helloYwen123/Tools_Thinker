from tools.object_detector import Object_Detector_Tool

# Define the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8921_0.png"
# Define the labels to detect (in this case, 'baseball' and 'basket' are detected)
labels_to_detect = ['baseball', 'basket']
# Set the confidence threshold and model size
confidence_threshold = 0.35
model_size = 'tiny'
# Set to True if text in the image should be detected
detect_text = True

# Create the object detector tool and run the detection
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels_to_detect, conf_threshold=confidence_threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")

# Extract the bounding boxes, text, and scores for each detected object
text_blocks = []
for label in detected_objects:
    bounding_box = label['bbox']
    text = label['saved_image_path'].split('.')[0].upper()
    score = label['score']
    text_blocks.append([[bounding_box], text, score])

# Combine the objects and text information
total_detected_objects = []
total_text_blocks = []
for detections in detected_objects:
    bounding_box = detections['bbox']
    text = detections['saved_image_path'].split('.')[0].upper()
    score = detections['score']
    for object in object_number:
        if object['label'] == label['label']:
            object['bbox'] = (object['bbox'][0] + bounding_box[0], object['bbox'][1] + bounding_box[2], object['bbox'][0] + bounding_box[2], object['bbox'][1] + bounding_box[1])
            object['text'] = text
            object['score'] = score
            total_detected_objects.append(object)
            total_text_blocks.append(text_blocks)

final_result = [(0 if not total_detected_objects else total_detected_objects[0]['bbox']), 
                (0 if not total_detected_objects else total_detected_objects[0]['text'])]


