def identify_counting_objects(image_path, object_type, languages=['en', 'de'], detail=0):
    from object_detector_tool import execute as oc

    detected_objects, object_numbers = oc.execute(image=image_path, labels=[object_type], languages=languages, detail=detail)

    if len(detected_objects) == 0:
        return []
  
    detected_objects = {label: [] for label in detected_objects}
    object_numbers = {label: len(detected_objects[label]) for label in detected_objects}

    for label, objects in detected_objects.items():
        for box in objects:
            detected_objects[label].append({'box': box['box'], 'label': label, 'score': box['score']})
    
    # Sort objects by score
    sorted_objects = sorted(detected_objects, key=lambda x: x['score'], reverse=True)
    
    detected_objects = [{'box': obj['box'], 'label': obj['label'], 'score': obj['score'], 'type': 'bounding_box'} for obj in sorted_objects]

    # Create markdown output
    markdown_output = '| ' + '| '.join(detected_objects) + '| '
    markdown_output += '| '.join([f'{len(detected_objects)} | ' + str(i + 1) for i in object_numbers.values()]) + ' | '
    
    return markdown_output

