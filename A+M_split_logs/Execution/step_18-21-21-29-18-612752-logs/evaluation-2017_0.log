from Object_Detector_Tool import object_detector_tool
from Text_Detector_Tool import text_detector_tool

input_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2017_0.png"

# 1. Detect objects in the image
detected_objects, object_count = object_detector_tool.execute(image=input_image_path, labels=["baseball", "basket"],
                                                                save_object=True, saved_image_path="detected_objects")

# 2. Detect text in the image using English and German languages
result_langs = ["en", "de"]
result = text_detector_tool.execute(image=input_image_path, languages=result_langs, detail=3)

# Concatenate detected objects and text results into a single list
text_blocks = []
for block in result:
    for entry in block:
        if entry["label"] == "baseball":
            text_blocks.append(entry)
        elif entry["label"] == "basket":
            text_blocks.append(entry)
result = text_blocks + detected_objects

text_blocks = sorted(text_blocks, key=lambda x: x[1])
total_texts = {entry["label"] + ": " + entry["text"] + " (" + str(entry["conf"]) + ")" for entry in result}

print("Detected objects:")
for obj in detected_objects:
    print(f"\n  {obj[0]:s}: ({obj[1]:.1f}, {obj[2]:.1f} - {obj[3]:.1f}, {obj[4]:.1f})")
    print(f"Confidence score: {obj[5]:.1f}/100")
    print(f"Confidence score (repetition): {obj[5]:.1f}/100")
    print(f"Detected text: {obj[6]:<30}")

print("Detected texts:")
for text in total_texts:
    print(f"\n  {text: <30}: {total_texts[text]:<30}, {float(total_texts[text]):<3.1f}%")


