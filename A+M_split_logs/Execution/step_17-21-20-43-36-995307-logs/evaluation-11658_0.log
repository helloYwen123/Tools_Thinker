from object_detector import Object_Detector_Tool

# Define the image path
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/11658_0.png'

# Define the labels to detect
labels = [ 'baseball', 'basket', 'garbage', 'trash', 'cardboard']

# Set the confidence threshold
confidence_threshold = 0.35

# Set the name of the saved object image
object_save_folder = 'detected_objects'

# Execute the tool
tool = Object_Detector_Tool()
result = tool.execute(image_path, labels=labels, confidence_threshold=confidence_threshold, save_object=True, saved_image_path=object_save_folder)

# Check for successful detection
if 'detected_objects' in result.keys():
    # Check if the labels are present in the result
    detected_objects = result['detected_objects']
    object_number = len(detected_objects)

    # Convert the detected objects to a list of strings
    detected_objects_list = [[detected_objects, {'score': detected_objects['score']}]]

    # Convert the object number to a dictionary
    object_number_dict = {'baseball': object_number, 'basket': 1}

    # Format the final result
    final_result = f"Number of detected objects: {object_number}\nDetected objects ({\"score\": detected_objects['score']}): {detected_objects_list}\nTotal number of detected objects: {"'.join(object_number_dict.keys())*" "}"

    return final_result
else:
    return "Text detection failed after retries."


