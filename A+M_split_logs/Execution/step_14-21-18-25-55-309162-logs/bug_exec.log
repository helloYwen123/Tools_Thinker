from mmcv import SingleImageMultiscaleDetector

def count_doors(image_path):
    # Load the image and perform detection
    detector = SingleImageMultiscaleDetector(
        "object_detector_tool",
        {
            "image": image_path,
            "labels": ["door"],
            "save_object": False,
            "saved_image_path": "detected_objects"
        },
        ["baseball", "basket"],
        language_list=["en"]
    )
    
    # Detect doors
    res = [[{} for _ in range(4)] for _ in range(2)]
    
    # Simulate retries until at least 1 door is detected
    retries = 2
    while len(res[0]) == 0 and retries > 0:
        try:
            res[0] = detector(
                image=image_path,
                languages=Detector.Tool.language_list,
                details=Detector.Tool.data.get("detail", 0)
            )
            retries -= 1
        except Exception as e:
            continue
    
    # Remove failed retries if any
    if retries:
        res = res[1:]
    
    # Count doors
    door_count = sum([len(detected_objects) for (labels, detected_objects) in res])
    
    return door_count, res

if __name__ == "__main__":
    door_count, detected_objects = count_doors("test_image.jpg")
    print("Number of doors detected:", door_count)
    for label, boxes in detected_objects.items():
