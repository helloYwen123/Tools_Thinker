from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool().execute(image='path/to/image', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

if final_result:
    detected_objects = final_result[0]
    object_number = final_result[1]

    print("Number of detected objects: ", object_number)
    print("Detected objects:")
    for block in detected_objects:
        print("Block: ", block)
else:
    print("No text detected.")

