save_object = True

# Save image path
saved_image_path = "detected_objects"

final_result = Object_Detector_Tool().execute(image=path_to_image, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=confidence_threshold, model_size=model_size)


