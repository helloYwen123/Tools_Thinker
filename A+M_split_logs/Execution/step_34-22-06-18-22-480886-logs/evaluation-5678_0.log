from object_detector import Object_Detector_Tool

# Path to the image file
path_to_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5678_0.png"

# Labels to be detected
labels = ["baseball", "basket"]

# Confidence threshold
confidence_threshold = 0.35

# Model size
