from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool().execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/5678_0.png", labels=['TV'], thresholds=[0.55], model_sizes=['tiny'], save_object=False)

if final_result and not final_result["object_number"]:
    print("No dressers")
else:
    detected_dressers = final_result["object_number"].values()
    number_of_dressers = sum(detected_dressers.values())

    print(f"""\nNumber of dressers: {number_of_dressers}\n""", 
          detected_dressers.keys(), 
          sep='\n',
          sep='\n',
          end='\n')

if not final_result:
    print("No dressers detected in the image.")
else:
    details = final_result["object_number"]

    print(f"""\n{'Details': <100}".format(details.keys()))

print("\n")


