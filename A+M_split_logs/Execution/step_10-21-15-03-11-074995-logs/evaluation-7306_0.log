from object_detector_tool import object_detector

# Get the image path from the question
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/7306_0.png"

# Create an object detector instance
object_detector_instance = object_detector()

# Execute the object detector tool with the given parameters
# label_list = ['baseball', 'basket']
label_list = ['baseball', 'basket']

# Create a results dictionary to store the detected objects
detected_objects = {}

# Retry the object detection with higher confidence threshold
for label in label_list:
    try:
        # Set the confidence threshold to a value significantly higher than the default value
        conf_threshold = 1.0
        # Execute the object detection
        results = object_detector_instance.execute(image=image_path, labels=label_list, save_object=True, saved_image_path=f'detected_objects')

        # Add the detected objects to the detected_objects dictionary
        detected_objects[label] = results

        # Print each detected object's information
        print(f'The {} was detected in the image. Conf: {results[0].get("score", 0)}')
    except Exception as e:
        # Handle any exceptions that occur during the detection process
        print(f'Error in object detection for {} : {e}')

final_result = detected_objects
final_result = sorted(final_result.items(), key=lambda x: x[1][0][2], reverse=True)
final_result = [f'The {key} was detected in the image. Conf: {value[0].get("score", 0)}' for key, value in final_result]
final_result


