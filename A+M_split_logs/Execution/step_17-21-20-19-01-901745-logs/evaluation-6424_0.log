from object_detector_tool import Object_Detector_Tool

# Given input paths and options
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6424_0.png"
labels = ["baseball", "basket"]
threshold = 0.3
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Initialize the Object_Detector_Tool
object_detector_tool = Object_Detector_Tool()

# Execute the detection tool
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, threshold=threshold, save_object=save_object, saved_image_path=saved_image_path)

final_result = {"Detected text": []}
for label in object_number:
  # Check if there is a detected object for the label
  if label != {}:
    # Extract bounding box, recognized text, and confidence score
    bounding_box = [{"x0": detected_objects[label][0][0], "y0": detected_objects[label][0][1], "x1": detected_objects[label][0][2], "y1": detected_objects[label][0][3]},
                    detected_objects[label][1]]
    recognized_text = detected_objects[label][1]
    confidence_score = detected_objects[label][2]
    if model_size.lower() == "tiny":
      confidence_score += det_text_score = text_detector_tool.execute(image=''.join(bounding_box), languages=['en'], detail=0).det_text_score
    elif model_size.lower() == "base":
      confidence_score += text_detector_tool.execute(image=''.join(bounding_box), languages=['en'], detail=1).det_text_score
    else:
      print("Error: Invalid model_size. Use 'tiny' or 'base'.")

    # Add detected object to the final result
    final_result["Detected text"].append([[[x0, y0], [x1, y1], [x2, y2], [x3, y3]], "Detected text", confidence_score]
    )
    recognized_text = 'Detected text'

result = [{"bbox": bounding_box, "text": recognized_text, "score": confidence_score}, ...]
final_result["Detected text"].append(result)

print(final_result)


