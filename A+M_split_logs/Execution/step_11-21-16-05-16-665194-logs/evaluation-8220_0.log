from object_detector_tool import Object_Detector_Tool

# Executing the object detection tool
object_number = {}
detected_objects = {}

try:
    object_detector_tool = Object_Detector_Tool()
    result = object_detector_tool.execute(image='/nfs/data8/liao/wxie/SAT/SAT_images_train/8220_0.png', labels=['basketball', 'baseball'], model_size='base', save_object=True, saved_image_path='detected_objects')
       

    detected_objects['baseball'] = [det for det in result if 'baseball' in det['label']]
    detected_objects['basketball'] = [det for det in result if 'basket' in det['label']]

    object_number = {k: len(detected_objects.get(k, [])) for k in detected_objects.keys()}

except Exception as e:
    print('Error:', e)

print(f"Detected objects: {detected_objects}")  # Debugging
print(f"Number of detected objects: {object_number}\n")


