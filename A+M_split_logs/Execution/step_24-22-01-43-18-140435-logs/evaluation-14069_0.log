from object_detector_tool import Object_Detector_Tool

def calculate_doors(image_path=None, labels=None, window_size='base', save_object=False, saved_image_path="detected_objects"):

    # Initialize Object_Detector_Tool with required parameters
    object_detector_tool = Object_Detector_Tool()

    # Execute the function and get the result
    detected_objects = object_detector_tool.execute(image=image_path, labels=labels, window_size=window_size, save_object=True, saved_image_path=saved_image_path)

    # Extract door counts from the result
    door_counts = {}
    if 'baseball' in detected_objects:
        door_counts['baseball'] = detected_objects['baseball'][0].get('score')
    if 'basket' in detected_objects:
        door_counts['basket'] = detected_objects['basket'][0].get('score')

    # Return the door count
    return door_counts

# Assuming the image path path_to_image and the labels 'baseball' and 'basket' are already set
door_counts = calculate_doors(image_path='/nfs/data8/liao/wxie/SAT/SAT_images_train/14069_0.png', labels=['baseball', 'basket'])

print(f"Door counts: {door_counts}")


