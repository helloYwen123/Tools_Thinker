from object_detector_tool import Object_Detector_Tool

def count_doors_and_window(open_image_path, labels, save_object=False, saved_image_path="detected_objects"):
    with open(open_image_path) as file:
        image = file.read()
    
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    
    number_of_doors, number_of_windows = 0, 0
    
    for each in detected_objects:
        if 'Baseball': number_of_doors += 1
        if 'Basket': number_of_windows += 1
    
    return detected_objects, object_number


# Usage example
count_doors_and_window(image="path/to/image", labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects")
