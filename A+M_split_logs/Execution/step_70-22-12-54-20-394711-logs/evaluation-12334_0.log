def count_shelving_units(image_path):
    # Load object detector
    object_detector_tool = Object_Detector_Tool()
    
    # Execute detection
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['ShelvingUnit'], save_object=True, saved_image_path='detected_objects')
    
    # Count shelving units
    shelving_units = len(detected_objects['ShelvingUnit'])
    return shelving_units

final_result = count_shelving_units('/path/to/image.png')
print(final_result)  # Output: 3


