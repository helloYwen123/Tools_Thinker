from Object_Detector_Tool import Object_Detector_Tool

# Initialize the Object_Detector_Tool object
object_detector_tool = Object_Detector_Tool()

# Define labels to detect
labels = ["baseball","basket"]

# Set the saved image path
saved_image_path = "detected_objects"

# Create a dictionary with the number of detected objects for each label
object_number = {}

# execute the objectDetector_tool
detected_objects, object_number = object_detector_tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/1815_0.png", labels=labels, save_object=True, saved_image_path=saved_image_path)

# Create a list to store text blocks
text_block = []

try:
    # Iterate over the detected objects
    for label, obj in detected_objects['baseball']:
        if obj.get('score') > 0.2:
            block = [[[[x[0], y[0]], [x[1], y[1]], [x[-1], y[-1]], [x[-2], y[-2]]] for x, y in obj.get('box')]
                    + ["Detected text", label]]
            text_block.append(block)
        else:
            text_block.append([])

finally:
    # Convert the dictionary to a list
    detected_objects = list(detected_objects)

    # Convert the text blocks to a list
    text_blocks = list(detected_objects['baseball'])

    # Calculate the total number of detected objects
    total_objects = len(text_blocks)

    # Generate the final result dict
    final_result = {
        "detected_objects": {
            label: [block[0] for block in text_blocks],
            "total_objects": total_objects
        }
    }

    final_result["object_number"] = object_number

# Print the final result
print(final_result)
