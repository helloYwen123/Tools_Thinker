# Import necessary tool from the metadata dictionary
from object_detector import Object_Detector_Tool

# Initialize the Object_Detector_Tool
object_detector_tool = Object_Detector_Tool()

# Set input parameters
image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13278_0.png"
labels = ["baseball"]
threshold = 0.35
model_size = "tiny"
save_object = False
saved_image_path = "detected_objects"

# Execute the object_detector_tool
result = object_detector_tool.execute(image, labels, threshold, model_size, save_object, saved_image_path)

# Check the number of detected objects and the results
if not result[1]:
    final_result = "4"
else:
    final_result = "{}".format(result[1])

# Output the final result
print(f"Number of chairs visible: {result[0]}")


