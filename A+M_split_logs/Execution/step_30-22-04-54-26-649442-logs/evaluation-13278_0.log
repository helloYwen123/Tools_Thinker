from Object_Detector_Tool import Object_Detector_Tool

def count_chairs(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path)
    chair_count = {'baseball': 0, 'basket': 0}
    for label, detection_results in detected_objects.items():
        box, score = (point[0] for point in (bounding_box for bounding_box in detection_results if 'box' in bounding_box) if score is not None)
        if label == 'baseball':
            chair_count['baseball'] += 1
        elif label == 'basket':
            chair_count['basket'] += 1
    total_chairs = chair_count['baseball'] + chair_count['basket']
    final_result = {
        'number_of_chairs': total_chairs,
        'labels_count': chair_count
    }
    return final_result

image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/13278_0.png'
chair_count = count_chairs(image_path)
print(f"Number of chairs in the image: {chair_count['number_of_chairs']}\nNumber of detected chairs for each label: {chair_count['labels_count']}")


