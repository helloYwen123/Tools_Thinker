from Object_Detector_Tool import Object_Detector_Tool

def count_objects_in_image(image_path, labels, threshold=0.35, model_size='tiny', save_object=False):
    object_detector_tool = Object_Detector_Tool()
    
    if save_object:
        object_detector_tool.save_image = True
    
    objects_results, object_number = object_detector_tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)
    
    final_result = {}
    for object_label, detection_results in objects_results.items():
        if detection_results:
            object_number[object_label] = len(detection_results)
        else:
            object_number[object_label] = 0
            
            if save_object:
                image_path, box, score = detection_results[0]
                if image_path:
                    box = (box[0], box[1], box[0] + box[2], box[1] + box[3])
                    object_detector_tool.save_image = True
                    object_detector_tool.save_object_image(f"{image_path}", box, f"{object_label}_image")
                    
    final_result['object_number'] = object_number
    
    return final_result

# Your question for object counting
count_result = count_objects_in_image(
    image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/1768_0.png",
    labels=["baseball", "basket"],
    threshold=0.35,
    model_size='tiny'
)

print(f"Object count: {count_result['object_number']}")


============================== END ==============================

