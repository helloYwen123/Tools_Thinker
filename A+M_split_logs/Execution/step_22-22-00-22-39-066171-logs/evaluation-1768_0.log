    detected_objects, object_number = object_detector_tool.execute(image=image, labels=['DiningTable'], save_object=False, saved_image_path="detected_objects")

total_objects = {}
for label, detections in detected_objects.items():
    if label == "DiningTable":
        total_objects["DiningTable"] = len(detections)

final_result = {
    "number_of_objects": total_objects,
    "detection_result": detected_objects
}
print("The total number of DiningTables observed in the scene is =", final_result["number_of_objects"]["DiningTable"])


