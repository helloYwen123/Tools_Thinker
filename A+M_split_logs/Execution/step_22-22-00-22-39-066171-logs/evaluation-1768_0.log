from object_detector_tool import Object_Detector_Tool

# Input image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1768_0.png"

# Paths for output detection results
detected_objects = {}
labels_count = {}

# Execute object detection
tool = Object_Detector_Tool()
detection_result = tool.execute(image_path, ["baseball", "basket"], save_object=True)

# Print the detected object's bounding box for easy identification
for label in detection_result:
    boxes = label["box"]
    # Output text recognition based on languages detected
    languages = ["en", "de"]
    language = "en"
    text_analysis_result = tool.execute(
        image_path, languages=languages, detail=0
    )
    text_blocks = []
    for lang in text_analysis_result:
        text_blocks.extend(lang["boxes"])
    labels_count[label["label"]] = len(text_blocks)

detected_objects = {label: [
    {"bbox": box, "score": detections["score"], "saved_image_path": detections["saved_image_path"]}
    for label, detections in detected_objects.items()]
for label, detection in labels_count.items():
    detected_objects[label] = [
        {"bbox": box, "score": detection["score"]}
        for detection in detection
    ]

# Display the results in a structured format
final_result = (
    f"Number of Detected Items: {detected_objects.keys()}"
    + "\n"
    + f"Detected Objects:\n\n"
    + "-------------------------------------------------\n"
    + " ".join(
        f"{detected_objects[label]} (Score: {detection['score']})"
        for label, detection in detected_objects.items()
    )
    + "\n"
    + "-------------------------------------------------\n"
)

print(final_result)


