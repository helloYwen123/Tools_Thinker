from object_detector import Object_Detector_Tool

# Function to count and locate interests
def count_interests(image_path, labels, save_object, saved_image_path):
    # Initialize object detector
    object_detector = Object_Detector_Tool()
    
    # Execute object detection
    object_results = object_detector.execute(image_path, labels, save_object, saved_image_path)
    
    # Example result
    detected_objects = object_results[0]
    total_objects = object_results[1]
    
    return detected_objects, total_objects

# Usage example
