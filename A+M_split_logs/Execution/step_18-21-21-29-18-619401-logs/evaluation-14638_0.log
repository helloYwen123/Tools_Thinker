def count_chairs(image_path):
    objects_output = object_detector_tool.execute(image=image_path, labels=['chair'], save_object=True)
    chair_boxes = [obj_output['bbox'] for obj_output in objects_output['detected_objects']]
    chair_count = sum(1 for box in chair_boxes if box[2] is not None)
    return chair_count, objects_output

