from object_detector import Object_Detector_Tool

final_result = {}

# Possible objects for detection
objects_to_detect = ['baseball', 'basket']

# Possible captions to match to the objects
caption_pairs = [(obj, "Detected baseball") for obj in objects_to_detect] + [(obj, "Detected basketball") for obj in objects_to_detect]

# Run the detection program
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image='path/to/image', labels=objects_to_detect, save_object=True, saved_image_path='detected_objects')

# Convert the list of detected objects to a Python object
detected_objects = [
    {label: [
        {'box': [x0, y0, x1, y1], 'score': score, 'saved_image_path': saved_image}

        for label, objects in object for object in objects
    ]
} for label, texts in detected_objects
for detected_objects, details in detected_objects.items()

# Summarize the results
total_objects = object_number.get('baseball', 0) + object_number.get('basket', 0)
detected_objects = [
    *[detected_objects.get(key, []) for key in objects_to_detect
    for obj in objects_to_detect
] + [(total_objects - len(detected_objects), "Overall")]
final_result['detected_objects'] = detected_objects
final_result['object_number'] = object_number


