from object_detector import Object_Detector_Tool

saved_object = False
save_path = "detected_objects"
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9420_0.png"  # path where the image is located
labels = ['baseball', 'basket']

try:
    detected_objects, object_number = Object_Detector_Tool().execute(image=image_path,
                                                                     labels=labels, save_object=saved_object,
                                                                     saved_image_path=save_path)

    # Assuming text detection was successful
    text_blocks = Object_Detector_Tool().execute(image=image_path, languages=['en', 'de'], detail=0)  # Text detection here

    final_result = f"Detected objects: {object_number} objects detected, image_path: {image_path}\nDetected text:\n{text_blocks}"
except Exception as e:
    final_result = "ObjectDetectorTool error: " + str(e)

print(final_result)

