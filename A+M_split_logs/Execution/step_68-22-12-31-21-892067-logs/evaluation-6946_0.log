from object_detector import Object_Detector_Tool

final_result = {}
final_result["detected_objects"] = []
final_result["object_number"] = {}

exec(open('/path/to/image').read())
image, labels = 'path/to/image', ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'

object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=True, saved_image_path='detected_objects')

for obj_label, obj_results in detected_objects.items():
    for obj_result in obj_results:
        if obj_result['score'] >= threshold:
            result = {'box': obj_result['box'], 'saved_image_path': obj_result['saved_image_path'], 'object_label': obj_label}
            final_result["detected_objects"].append(result)
            final_object_number = final_result["detected_objects"].index(result)
            object_number[obj_label[-1]] = final_object_number

print(final_result)
print(object_number)


