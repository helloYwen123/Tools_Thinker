# Sample input to demonstrate the function
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/9960_0.png'
labels_to_detect = ['baseball', 'basket']
save_object = True
saved_image_path = 'detected_objects'

# Run the function
