detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels_to_detect, save_object=save_object, saved_image_path=saved_image_path)

# Extract the detected objects' information
if detected_objects:
    detected_objects = detected_objects[0]
    num_detected_objects = object_number[0] + num_detected_objects
    print(f"Number of detected objects: {num_detected_objects}")
else:
    print("Text detection failed.")

# Output the detected objects with confidence scores
if detected_objects:
            detected_objects = detected_objects[1:]
            print(f"Detected text blocks:")
            for block in detected_objects:
                x0, y0, x1, y1, x2, y2, x3, y3 = block[0]
                text_block = block[1]
                print(f"Detected text '{text_block}': {text_block}, Coefficient of confidence: {len(text_block)} / {len(labels_to_detect)}")
        final_result = "\n".join(f"Detected objects with confidence score>=0.35: {detected_objects}") if detected_objects else "No detected objects."


