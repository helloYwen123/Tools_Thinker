from tool_objects import object_detector_tool, text_detector_tool

# Step 1: Identify the location of the objects for detection
objects_to_detect = ["baseball", "basket"]

# Step 2: Use the object_detector_tool to count and locate the specified objects
# For simplicity in this example, we only count the objects detected.
object_count = object_detector_tool.execute(image='path/to/image', labels=objects_to_detect, save_object=True, saved_image_path='detected_objects')

# Step 3: Use the text_detector_tool to count the detected text coordinates and confidence scores
text_results = text_detector_tool.execute(image='path/to/image', languages=['en', 'de'], detail=0)

# Step 4: Merge the counts from the object count output and the text results
detected_objects = object_count['detected_objects']
total_objects_detected = len(detected_objects[0])

detected_objects_with_text = [
    [[bbox[0], bbox[1], bbox[2], bbox[3]], "Detected text", confidence]
    for detection in detected_objects
    for _, object in detection.items()
    for bbox in object[1:2]
    if bbox and ('words' in object and 'text' in object['words'])
]

total_text = len(detected_objects_with_text)

final_result = {"detected_objects": detected_objects_with_text, "total_objects_detected": total_objects_detected, "total_text": total_text}


