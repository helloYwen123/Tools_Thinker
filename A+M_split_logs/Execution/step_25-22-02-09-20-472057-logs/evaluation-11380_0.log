def detect_objects(image_path, label_name, threshold=0.35, model_size='tiny', save_object=True):
    result = []  # Initialize an empty list to store detected results
    
    # Execute the object classifier
    object_detector(tool_name='Object_Detector_Tool',
                   label_name=label_name,
                   threshold=threshold,
                   model_size=model_size,
                   image_path=image_path,
                   save_object=save_object)
    
    # Iterate through each detected object and add the detection details to the result list
    if isinstance(result, list):  # Check if the result is a list
        for detected_object in result:
            result.append({
                'box': detected_object['box'],
                'score': detected_object['score'],
                # Optional: add more detection details if needed
                # For example: detected_object['confidence'] or detected_object['detected_text']
            })
    
    return result, len(result)  # Return the detected object results and the number of labels detected


