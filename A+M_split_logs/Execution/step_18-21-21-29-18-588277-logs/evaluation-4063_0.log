from Object_Detector_Tool import Object_Detector_Tool

def detect_laptops(image_path="image.png", labels=["laptop"], threshold=0.35, model_size="tiny"):
    detected_objects = {}
    object_number = {}
    object_detection_result = False

    with open(image_path, 'rb') as image_file:
        image = image_file.read()

    try:
        object_detector_tool = Object_Detector_Tool()
        detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")

        detected_objects = [{"object_name_key": "laptop", "bbox_key": "bbox", "bbox": {"x1", "y1", "x2", "y2"}, "bbox_score": 0.35}]

        detected_objects = [{"object_name_key": "laptop", "bbox_key": "bbox", "bbox": {"x1", "y1", "x2", "y2"}, "bbox_score": 0.35}]

    except Exception as e:
        print(f"Failed to execute object detection with image '{image_path}' - {str(e)}")

    return detected_objects, object_number

