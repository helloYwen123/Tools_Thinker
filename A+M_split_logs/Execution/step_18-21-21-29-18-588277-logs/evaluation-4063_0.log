from object_detector_tool import Object_Detector_Tool as ODTool

def count_laptops(image_path, labels=[], threshold=0.35, model_size="tiny", save_object=False, saved_image_path="detected_objects/"):
    try:
        detected_objects, object_number = ODTool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
        
        count = len([obj for obj in detected_objects if obj.get("label") == 'laptop'])
        laptop_count = object_number.get('laptop', 0)
        
        return {"count": count, "laptop_count": laptop_count}
    except Exception as e:
        return {"error": str(e)}

print(count_laptops("/nfs/data8/liao/wxie/SAT/SAT_images_train/4063_0.png", ["laptop"], threshold=0.35, model_size="base"))


