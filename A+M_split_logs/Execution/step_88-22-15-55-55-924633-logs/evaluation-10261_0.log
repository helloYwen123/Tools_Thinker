from object_detector import Object_Detector_Tool
final_result = Object_Detector_Tool().execute(image='path/to/image', labels=['baseball', 'basket'], save_object=False)

for det in final_result:
  if det['label'] == 'baseball':
    print(f'Found baseball: {det["bbox"]} with a score of {det["score"]}.')

for det in final_result:
  if det['label'] == 'basket':
    print(f'Found basketball: {det["bbox"]} with a score of {det["score"]}.')

if final_result:
  print('No baseballs were found.')
else:
  print('Basketballs were found but no baseballs were found.')


