from object_detector_tool import Object_Detector_Tool

def count_windows(image_path):
    # Load the detector model and save file name
    detector_tool = Object_Detector_Tool()
    save_path = 'detected_objects'
    detected_objects, object_number = detector_tool.execute(image=image_path, labels='all', save_object=True)
    if not detected_objects:
        return None  # No windows detected

    # Calculate the number of windows
    total_objects = []
    saved_images = []
    for label in detected_objects.keys():
        detected_entries = detected_objects[label]
        for detection_entry in detected_entries:
            box = detection_entry['box']
            window = detection_entry['name']
            box = (box[1], box[0], box[3], box[2])
            total_objects.append((window, len(detection_entry)))
            saved_files = []
            for f in detection_entry:
                if '.png' in f:
                    saved_files.append(f)
            saved_image = f'{label}_windows_{f}.jpg'
            saved_images.append(saved_image)
            if saved_image in saved_images:
                total_objects.append(1)
            else:
                total_objects.append(0)
        if saved_image not in saved_images:
            warning = f"No saved window image for {label} found among the detected objects."
            total_objects.append(0)

    if object_number in object_number:
        object_number[object_number.keys()] = len(total_objects)
    else:
        object_number.clear()

    return total_objects, object_number


