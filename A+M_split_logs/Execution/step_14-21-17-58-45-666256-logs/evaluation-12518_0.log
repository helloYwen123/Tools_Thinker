from object_detector_tool import Object_Detector_Tool

def count_windows_in_room(image_path):
    result = Object_Detector_Tool(
        input_types={"image": image_path, "labels": ["window"]})).execute(save_object=True).detected_objects[0].box[0][0:].to_list()
    return len(result)

