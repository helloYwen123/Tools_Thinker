from object_detector_tool import Object_Detector_Tool

def count_shelving_units(image_path):
    try:
        with open(image_path, 'rb') as file:
            image = file.read()
        object_detector_tool = Object_Detector_Tool()
        object_labels = object_detector_tool.execute(image, [
            f"shelf"
        ]).get('bbox', [])
        number_of_tables_and_rungs = len(object_labels) - 2
        return number_of_tables_and_rungs
    except Exception as e:
        print(f"Error counting shelving units: {e}")
        return 0

final_result = count_shelving_units('/nfs/data8/liao/wxie/SAT/SAT_images_train/8747_0.png')
print(final_result)


