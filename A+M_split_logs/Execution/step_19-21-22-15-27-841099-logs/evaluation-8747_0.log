from object_detector_tool import object_detector_tool as ot_tool

def count_objects(inputs):
    try:
        # Assuming the inputs are provided as dictionary pairs
        label_list = inputs.get("labels")
        threshold = inputs.get("threshold")
        model_size = inputs.get("model_size")
        save_object = inputs.get("save_object")
        saved_image_path = inputs.get("saved_image_path")
        
        input_image = inputs.get("image")
        
        # Attempt text detection for the 'baseball' and 'basket' labels
        try:
            ball_labels = ["baseball"] if "baseball" in label_list else []
            basket_labels = ["basket"] if "basket" in label_list else []
            
            detections = ot_tool.execute(image=input_image, labels=ball_labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)
            basket_detections = ot_tool.execute(image=input_image, labels=basket_labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)
            
            object_labels = [d[0] for d in detections] + [d[0] for d in basket_detections]
            total_objects = len(object_labels)
            
            if len(ball_labels) > 0:
                object_labels += [d[0] for d in detections if d[0] in ball_labels]
                total_objects = len(object_labels)
            elif len(basket_labels) > 0:
                object_labels += [d[0] for d in basket_detections if d[0] in basket_labels]
                total_objects = len(object_labels)
                
            if save_object:
                ot_tool.execute(image=input_image, labels=object_labels, save_object=save_object, saved_image_path=saved_image_path, threshold=0, model_size=model_size)
            
            return {"labels": object_labels, "total_objects": total_objects}
        except Exception as e:
            return {"error": "Failed to detect 'baseball' and 'basket' objects", "details": str(e)}
    except Exception as e:
        return {"error": "Failed to execute object_detector_tool", "details": str(e)}


