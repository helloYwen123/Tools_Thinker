import tools_module

def count_shelving_unit(image_path):
    """
    Counts the number of shelves in an image.
    """
    image = Image.open(image_path)
    objects = tools_module.text_detector_tool.execute(image=image, languages=['en', 'de'])
    if len(objects) == 1:  # Check if there's exactly one detected object
        shelf_area = objects[0][0][2]  # Get the bounding box coordinates of the shelf
        shelf_width = shelf_area[2]  # Calculate shelf width
        shelf_height = shelf_area[1]  # Calculate shelf height
        num_shelving_unit = max(shelf_height / 0.08, shelf_width / 0.08)  # Floor area of one shelf
        return num_shelving_unit

def main():
    """
    Returns the number of shelves in the scene.
    """
    scene_dir = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8747_0.png"
    detection_result = tools_module.object_detector_tool.execute(image=scene_dir, labels=['baseball', 'basket'], threshold=0.35, save_object=True, saved_image_path="detected_objects")
    objects = detection_result["detected_objects"]
    shelves_count = count_shelving_unit(image_path=scene_dir)
    print(f"The number of shelves in the scene is: {shelves_count}")

if __name__ == "__main__":
    main()


