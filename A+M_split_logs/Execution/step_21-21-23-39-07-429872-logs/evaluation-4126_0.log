import Object_Detector_Tool as object_detector_tool

# Set the input image and output directory
input_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4126_0.png"
output_path = "detected_objects"
save_output = True

# Initialize the object detector tool
object_detector_tool = object_detector_tool.Object_Detector_Tool()

# Execute the tool with the input image
detected_objects, object_number = object_detector_tool.execute(image=input_path, labels=["baseball", "basket"], save_object=True, saved_image_path=output_path)

# Define a function to check the count of detected objects for each label
def check_object_count():
    # Initialize a dictionary to hold the object count for each label
    object_counts = dict()

    # Check the 'baseball' label
    for label in detected_objects['baseball']:
        object_counts[label['label']] = 0

        # Check if the count is as expected from the output
        if len(label['detected_objects']) == 1:
            object_counts[label['label']] = 1

        else:
            print(f"Error: Label '{label['label']}' in image '{output_path}' has more than one detected object!")
            break

    # Check the 'basket' label
    for label in detected_objects['basket']:
        object_counts[label['label']] = 0

        # Check if the count is as expected from the output
        if len(label['detected_objects']) != 0:
            object_counts[label['label']] = len(label['detected_objects'])

    return object_counts

object_counts = check_object_count()

# Print the object counts
print("Object Counts:")
for label, count in object_counts.items():
    print(f"- {label}: {count}")


