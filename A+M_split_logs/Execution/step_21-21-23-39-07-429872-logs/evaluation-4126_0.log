from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

# Get the path to the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4126_0.png"

# Create the object detection object
object_detector_tool = Object_Detector_Tool()
object_detector_tool.configure(
    input_types={
        "image": image_path,
        "labels": ["baseball", "basket"],
        "threshold": 0.35,
        "model_size": "tiny",
        "save_object": True,
        "saved_image_path": "detected_objects"
    }
)

# Check if the object was successfully detected
if object_detector_tool.execute_labels():
    detected_objects = object_detector_tool.execute_image()

    object_number = {
        "baseball": detected_objects["baseball"].__len__(),
        "basket": detected_objects["basket"].__len__()
    }

    text_detector_tool = Text_Detector_Tool()
    text_detector_tool.configure(
        input_types={
            "image": image_path,
            "languages": ["en", "de"],
            "detail": 1
        }
    )
    
    detected_text = text_detector_tool.execute_image()

    final_result = {
        "detected_objects": {
            "baseball": detected_objects,
            "basket": detected_objects
        },
        "object_number": object_number,
        "detected_text": detected_text
    }
else:
    final_result = {}



