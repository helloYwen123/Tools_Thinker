        detected_rectangle = {"bbox": (detections[0]["box"][0], detections[0]["box"][1], detections[0]["box"][2], detections[0]["box"][3]),
                              "bbox2d":
                              (np.round(detections[0]["box"][0], 2),
                               np.round(detections[0]["box"][1], 2)),
                              "bbox2d": [detections[0]["bbox"][0]+.1, detections[0]["bbox"][1]+.1, detections[0]["bbox"][2]-.1, detections[0]["bbox"][3]-.1],
                              "bbox2d": [detections[0]["bbox"][0]-.1, detections[0]["bbox"][1]-.1, detections[0]["bbox"][2]+.1, detections[0]["bbox"][3]+.1],
                              "bbox2d": [detections[0]["bbox"][0]+.2 + detections[0]["bbox2d"][0], detections[0]["bbox"][1]+.2 + detections[0]["bbox2d"][1], detections[0]["bbox"][0]+.8 + detections[0]["bbox2d"][2], detections[0]["bbox"][1]+.8 + detections[0]["bbox2d"][3]],
                              "confidence": detections[0]["score"],
                              "label": label}
        output.append([[detected_rectangle, "Detected text", object_number['baseball']]])

print(output)
