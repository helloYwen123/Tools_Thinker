def detect_objects(image_path, labels, threshold=0.35, model_size="tiny", saveObject=False, saved_image_path="detected_objects"):
    object_detector = Object_Detector_Tool()
    labels_list, object_number = object_detector.execute(image=image_path, labels=labels, save_object=saveObject, saved_image_path=saved_image_path)
    detected_objects = object_detector.output_types[1]  # Step 1: Extract detected objects
    object_number = object_detector.output_types[0]  # Step 2: Extract total number of detected objects

    return detected_objects, object_number

# Data preparation
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6052_0.png"
labels = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
saveObject = True
saved_image_path = "detected_objects"

# Detecting objects
detected_objects, object_number = detect_objects(image_path, labels, threshold, model_size, saveObject, saved_image_path)

# Generating answer strings
final_result = f"""
Detected objects:
{detected_objects}

Object number:
{object_number}
"""

# Markdown output
result_text = f"**Detected objects:**

