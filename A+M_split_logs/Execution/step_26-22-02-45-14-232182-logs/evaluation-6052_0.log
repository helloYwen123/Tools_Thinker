import Object_Detector_Tool as OD

# Call the tool
object_detector_tool = OD.Object_Detector_Tool()
result = object_detector_tool.execute(
    image="/nfs/data8/liao/wxie/SAT/SAT_images_train/6052_0.png",
    labels=["baseball", "basket"],
    threshold=0.35,
    save_object=True,
    saved_image_path="detected_objects"
)

# Get the results from the tool
detected_objects = result[0]
object_number = result[1]

# Extract the number of objects and their bounding boxes
objects_info = []
for label, entry in detected_objects.items():
    boxes, scores = entry["bbox"], entry["score"]
    objects_info.append([[*bbox, *score] for bbox, score in zip(boxes[0:4], scores)])

# Extract only baseball and basket for visual comparison
baseball_info = []
basket_info = []
for obj in objects_info:
    if obj[2][1] == "baseball" or obj[2][1] == "basket":
        baseball_info.append(obj)
    else:
        basket_info.append(obj)

print(f"1. Detected baseball objects: {baseball_info}")
print(f"2. Detected basketball objects: {basket_info}")

# Output the total counts of detected objects
total_objects = []
for label, count in object_number.items():
    total_objects.append(count)
print(f"Total objects: {", ".join([f'{label}: {count}' for label, count in object_number.items()])},")


