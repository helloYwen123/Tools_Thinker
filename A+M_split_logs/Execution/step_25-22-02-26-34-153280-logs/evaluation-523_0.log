from Object_Detector_Tool import Object_Detector_Tool

def detect_paintings(image_path):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['painting'], save_object=True, saved_image_path='detected_objects')

    if len(detected_objects) == 0:
        final_result = "No paintings detected in the image. The output is an empty list."
    else:
        total_paintings = len(detected_objects)
        final_result = f"Total paintings detected: {total_paintings}"

    return final_result

# Sample image file path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/523_0.png"

# Run the function with the sample image path as the input
final_result = detect_paintings(image_path)
print(final_result)


