from Object_Detector_Tool import Object_Detector_Tool

def count_paintings(image_path):
    # Define the path to save detected objects
    saved_object_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/saved_objects'
    
    # Call the tool with the image path
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=['painting'], save_object=True, saved_image_path=saved_object_path)
    
    # Initialize the variable to keep track of the number of paintings
    number_of_paintings = 0
    
    # Iterate over the detected objects
    for obj in detected_objects:
        if obj["type"] == 'painting':
            number_of_paintings += obj["count"]
    
    return number_of_paintings

# Path to the image
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/523_0.png'
number_of_paintings = count_paintings(image_path)

final_result = {"total_paintings_count": number_of_paintings}
print("Total paintings count: ", final_result)


