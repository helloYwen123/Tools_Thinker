from object_detector_tool import Object_Detector_Tool

final_result = ""
object_labels = ["baseball", "basket"]

try:
    detected_objects, object_number = Object_Detector_Tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/523_0.png", labels=object_labels, save_object=True, saved_image_path="detected_objects")
except ValueError:
    obj_number = dict({})

finally:
    final_result += "detected_objects :{}\n".format({**{label: [detected_obj] for label, detected_obj in detected_objects}, **{label: object_number[label] for label in object_labels}})
    final_result += "object_number : {}\n".format(object_number)

print(final_result)


