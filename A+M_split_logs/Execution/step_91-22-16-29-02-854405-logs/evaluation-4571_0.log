from object_detector import Object_Detector_Tool

final_result = {"chairs": 2}

with Object_Detector_Tool() as object_detector_tool:
    detected_objects, object_number = object_detector_tool.execute(image="path/to/dining_table_image.png", labels=["chair"], save_object=True, saved_image_path="detected_objects")
    chairs = [box for detection_result in detected_objects for box in detection_result['box'] if box['category'] == 'chair']

    final_result["chairs"] = chairs

print(final_result)


