from Object_Detector_Tool import Object_Detector_Tool

def detect_chairs(image_path, save_chairs_image=False, saved_image_path="detected_chores"):
    tool = Object_Detector_Tool()
    chairs = tool.execute(image=image_path, labels=["chair"], save_object=save_chairs_image, saved_image_path=saved_image_path)
    return chairs

total_chairs = 4
for chair in chairs["baseball"]:
    # Check if chair is visible and has the correct bounding box with a score above 0.35
    if chair["bbox"][1] > 0 and chair["bbox"][3] > 0 and chair["score"] > 0.35:
        chair["num_chairs"] = 1  # Mark as spotted
        total_chairs += 1

final_result = {
    "total_chairs": total_chairs
}


