from object_detector_tool import Object_Detector_Tool

demo_commands = """
from object_detector_tool import Object_Detector_Tool

detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image', labels=[{"baseball": "Baseball", "basket": "Basket"}, {"baseball": "Tug of War"}, {"ball": "Puzzle"}], save_object=True, saved_image_path='detected_objects')
"""

