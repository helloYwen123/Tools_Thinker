from tool_module.object_detector import Object_Detector_Tool

def find_objects(image, labels, threshold=0.35, model_size='tiny', save_object=True,
                saved_image_path="detected_objects"):
    # Load the model
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size, threshold=threshold)
    
    return detected_objects, object_number

# Example usage
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6593_0.png"
labels = ['baseball', 'basket']

detected_objects, object_number = find_objects(image_path, labels)
print(f"Detected objects:\n{detected_objects}")
print(f"Number of detected objects: {object_number}")


