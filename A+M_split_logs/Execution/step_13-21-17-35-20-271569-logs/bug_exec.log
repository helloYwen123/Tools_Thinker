from tools import object_detector_tool, text_detector_tool

def count_objects_in_image(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    """
    Count and locate objects in an image using object_detector_tool.

    :param image_path: str - Path to the image file.
    :param labels: list - A list of object labels to detect.
    :param save_object: bool - Whether to save the detected objects.
    :param saved_image_path: str - The path to save the detected object images.
    """
    object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    # Load the detected images
    result = object_detector_tool.execute(image=image_path, language="English", saved_image_path=saved_image_path)

    detected_objects = []
    objects_count = {}

    for block in result:
        label = block[0][-1].split(".")[0]  # Extract the object label from the bounding box coordinates
        if label not in objects_count:
            objects_count[label] = 0

        for item in block[3]:
            if item["box"][0] >= 0 and item["box"][2] >= 0 and item["box"][1] >= 0:
                objects_count[label] += 1
                detected_objects.append({"label": label, "bbox": item["box"]})

    return objects_count, detected_objects

