from tools import object_detector_tool, text_detector_tool

# Path to the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/10755_0.png"

# List of languages
languages = ['en', 'de']

# Level of detail in the output
detail_level = 1

# Execute the tool
result = {}

object_result = object_detector_tool.execute(image_path, languages, detail_level)
if object_result['detected_objects']:
    detected_objects = object_result['detected_objects']
    if object_result['object_number']:
        object_number = object_result['object_number']
else:
    detected_objects = []
    object_number = {}

text_result = text_detector_tool.execute(image_path, languages)
if text_result['detected_text']:
    detected_text = text_result['detected_text'][0]
    detected_text = detected_text[0][0]
    confidence_score = text_result['confidence']
else:
    detected_text = []
    confidence_score = []
finally:
    # Combine the object and text results
    result['detected_objects'] = detected_objects
    result['object_number'] = object_number
    result['detected_text'] = detected_text
    result['confidence_score'] = confidence_score

final_result = result


