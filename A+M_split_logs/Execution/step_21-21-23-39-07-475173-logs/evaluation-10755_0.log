from object_detector_tool import Object_Detector_Tool

# Define the input image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/10755_0.png"

# Read the image data
with open(image_path, 'rb') as file:
    image_data = file.read()

# Initialize the Object_Detector_Tool
object_detector_tool = Object_Detector_Tool()

# Use the tool to detect objects in the image
detected_objects, object_number = object_detector_tool.execute(image_data, labels=["baseball", "basket"], save_object=True,  saved_image_path="detected_objects")

# Check if the object was detected
if "baseball" in detected_objects:
    print(f"Detected baseball in the image.")
else:
