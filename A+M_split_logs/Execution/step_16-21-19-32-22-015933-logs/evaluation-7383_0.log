from object_detector_tool import Object_Detector_Tool

# Define object labels for detecting baseball and basket
labels = ['baseball', 'basket']

# Set the confidence threshold to 0.35
confidence_threshold = 0.35

# Use the object detector tool
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image="path/to/image", labels=labels, save_object=True, threshold=confidence_threshold, model_size="tiny", saved_image_path="detected_objects")

# Output the detected objects
final_result = {
    'detected_objects': {
        label: [detected_object['box'], detected_object['score'] for detected_object in detected_objects]
        for label in object_number.keys()
    }
}
print(final_result)


