from object_detector_tool import Object_Detector_Tool, text_detector_tool

class ImageDetecting:
    def detect(self, image_path):
        try:
            detected_objects_by_label = self.find_objects_by_label(image_path, labels=["baseball", "basket"])
            object_number = self.count_objects_on_image(detected_objects_by_label)
            
            detected_text = self.find_text(image_path)
            
            return {
                "detected_objects_by_label": detected_objects_by_label, 
                "object_number": object_number, 
                "text": detected_text
            }
        except Exception as e:
            print("Error detected:", e)
            return {"error": "Something went wrong while processing the image."}

    def find_objects_by_label(self, image_path, labels):
        image = Image(image_path)
        return object_detector_tool.execute(image=image, labels=labels, model_size="tiny", save_object=True, saved_image_path="detected_objects")

    def count_objects_on_image(self, detected_objects):
        total_objects = len(detected_objects)
        text_objects = self.find_objects_by_label(image_path, labels=["text"], model_size="tiny")
        return total_objects - len(text_objects)

    def find_text(self, image_path):
        image = Image(image_path)
        return text_detector_tool.execute(image=image, languages=["en", "de"]), ["text", 0.95]


