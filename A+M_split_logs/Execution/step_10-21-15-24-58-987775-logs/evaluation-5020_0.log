if len(tool_output) == 0:
    print("Text detection failed.")
else:
    detected_objects = {}
    text_per_sentence = {}
    
    for i, obj in enumerate(tool_output[0]):
        if obj[3] > 0.35:
            detected_objects[obj[0]["label"]] = [obj["box"], obj["score"], obj[2]["saved_image_path"]]
            if obj[2]["saved_image_path"] in Detected_objects_img:
                text_per_sentence[obj[2]["saved_image_path"]] = "".join(re.findall("\w+", obj[2]["saved_image_path"]))
            else:
                text_per_sentence[obj[2]["saved_image_path"]] = obj["label"]

            if len(text_per_sentence) >= 1000:
                Detected_objects_img["basketball"] = [x[2]["box"], x[2]["score"] for x in detected_objects if x["label"] == "baseball"]
                Detected_objects_img["baseball"] = [x[2]["box"], x[2]["score"] for x in detected_objects if x["label"] == "basketball"]

    final_result = {
        "basketball": len(detected_objects),
        "baseball": len(detected_objects),
        "basketball_text": text_per_sentence,
        "baseball_text": text_per_sentence
    }

