def detect_objects(image_path, labels=['baseball', 'basket']):
    object_detector_tool = Object_Detector_Tool()
    result = object_detector_tool.execute(image_path, labels, save_object=True)
    if result:
        detected_objects = result['detected_objects']
        for label in detected_objects:
