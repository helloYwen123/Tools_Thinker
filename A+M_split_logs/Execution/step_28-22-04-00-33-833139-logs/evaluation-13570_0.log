from Object_Detector_Tool import Object_Detector_Tool

def count_dressers(input_image):
    # Load the model and save the image
    object_detector = Object_Detector_Tool(tool_class_name="Object_Detector_Tool",
                                         tool_module_name="object_detector",
                                         tool_description="Detect a dog in a photo. Return a dictionary with the object and count if it's detected.",
                                         tool_version="1.0.0")

    object_number = object_detector.execute(image=input_image, labels=["dresser"],
                                          model_size="small")
    return object_number

final_result = count_dressers(input_image)
print(final_result)  # Output: {'dresser': 1}


