        total_objects['baseball'] += detection['box'][2] - detection['box'][0] + 1
        total_objects['basket'] += detection['box'][3] - detection['box'][1] + 1

total_objects['baseball'] = total_objects['baseball'][0]
total_objects['basket'] = total_objects['basket'][0]

detected_objects = object_detector.output_types['detected_objects']
object_number = object_detector.output_types['object_number']

if detected_objects and total_objects:
    final_result = "(1) dict mapping each label to a list of detection results (each with box, score, and optionally saved image path) : {" + \
                   ", ".join([f'{label[1]}: [{object[1]}, {object[2][0]}, {object[2][1]}, {object[2][-1]}, {label[0]}]' for label in labels]) + "\n(" + \
                   f"detected_objects : {detected_objects}\n" + \
                   f"object_number : {object_number}\n)" + \
                   ")"
else:
