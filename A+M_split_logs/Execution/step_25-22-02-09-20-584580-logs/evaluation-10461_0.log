from object_detector import Object_Detector_Tool

object_detector_tool = Object_Detector_Tool()  # Import tool module

# Define the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/10461_0.png"

# Detect objects
labels = ["baseball", "basket"]
result = object_detector_tool.execute(image=image_path, labels=labels, save_object=True)

detected_objects = result['detected_objects']
object_number = result['object_number']

# Convert detected objects into a format suitable for text generation
final_result = {"detected_objects": {}, "object_number": {}}

if detected_objects:
    for object in detected_objects:
        name = object['name'].lower()  # Convert object name to lowercase for exact match
        bounding_box = object['box']
        confidence_score = object['score']

        # Create a list to store detected objects
        detected_objects[name].append({
            "box": bounding_box,
            "confidence_score": confidence_score,
        })
        
        # Create a list to store the total number of detections for each object
        detected_objects[name].append({'number': len(detected_objects[name])})

        if save_object:
            saved_image_path = object['saved_image_path']
            # Save detected objects as images and extract them using numpy
            for name in detected_objects[name]:
                saved_image = save_object(name, image_path, bounding_box, confidence_score, saved_image_path)
                
                # Write detection results to a text file
                text_generator = generate_text(name.lower())
                text = text_generator.generate_text(bounding_box, confidence_score, saved_image_path)
                with open(f"{saved_image}/result.txt", "w") as file:
                    file.write(text)
                    file.close()
            
    final_result["detected_objects"] = detected_objects
    final_result["object_number"] = object_number
else:
    final_result["detected_objects"] = {}
    final_result["object_number"] = {}


