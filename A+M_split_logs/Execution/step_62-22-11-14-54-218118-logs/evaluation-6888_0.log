from object_detector import Object_Detector_Tool

def object_detector_tool(image, labels, save_object=True, saved_image_path='detected_objects'):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    return detected_objects, object_number

final_result = object_detector_tool('/path/to/image.jpg', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
print(final_result)


