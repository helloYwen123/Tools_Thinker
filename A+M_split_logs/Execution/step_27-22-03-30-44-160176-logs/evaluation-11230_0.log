import Object_Detector_Tool

labels = ['basket', 'baseball']
save_object = True

file_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/11230_0.png'

detected_objects, object_number = Object_Detector_Tool.execute(image=file_path, labels=labels, save_object=save_object)
detected_object_names = [f'{label} ({detected_object["number"]})' for label, checked_objects in detected_objects.items()]
detected_object_count = object_number.values()
text_detected = [
    [
        [[detected_object["bbox"], detected_object["text"], detected_object["score"]]]
        for detected_object in detected_objects.keys()
    ]
    for label, checked_objects in detected_objects.items()
]
final_result = {
    'detected_objects': detected_object_names,
    'object_number': object_number,
    'text_detected': text_detected
}


