from object_detector_tool import Object_Detector_Tool, save_object

def detect_objects(image_path, labels=None, threshold=0.35, model_size="tiny", save_object=True, saved_image_path=None):
    if saved_image_path is None:
        saved_image_path = f"{image_path.split('/')[-2]}_{image_path.split('/')[-1]}"
    
    detected_objects = []
    label_count = {}

    object_detector_tool = Object_Detector_Tool()
    labeled_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object)

    # Detecting 3D objects
    for label in object_number.keys():
        if len(label_number[label]['bbox']) < 3:
            continue  # Skipping if object with less than 3 bounding boxes

        for bbox in label_number[label]['bbox']:
            objects_amount = detected_objects.copy()
            objects_amount[label.name] = object_number.get(label.name, 0)
            
            object_name_list = []
            for pos in objects_amount:
                bbox0, score0, box0 = detected_objects[pos]
                if box0[3] - box0[1] < threshold:
                    continue  # Skipping if object is too small

                bbox1 = pos[0] + bbox[0], pos[1] - bbox[1], pos[2] + bbox[2], pos[3] - bbox[2]
                if bbox1[3] >= bbox0[3] - bbox0[1] and bbox1[0] >= bbox0[0]:  # If bounding boxes overlap
                    object_name_list.append(pos.name)
                    detected_objects[pos] = bbox1
                    objects_amount[pos.name] += 1
                    break

            if object_name_list:
                labeled_objects.append(
                    (bbox0, score0, object_number[label.name], saved_image_path if save_object else None)
                )
    
            label_count[label.name] = objects_amount.get(label.name, 0) + sum(x for b in objects_amount for (bbox, score) in detected_objects[b])

    final_result = {
        "detected_objects": [
            {
                "bbox": bbox,
                "text": text,
                "score": score
            }
            for bbox, text, score in detected_objects
        ],
        "label_count": label_count
    }

    return final_result


