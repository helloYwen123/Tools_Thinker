from objects_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

def count_pillows(image_path):
    try:
        object_detector_tool = Object_Detector_Tool()
        total_pills = 0
        detected_objects = object_detector_tool.execute(image=image_path, save_object=False)
        
        for label, detections in detected_objects.items():
            pillow_count = len(detections)
            if label == "pillow":
                total_pills += pillow_count
            elif label == "pillows":
                if pillow_count > 0:
                    total_pills += pillow_count
            
        return total_pills
    except Exception as e:
        return 0

def detect_text(image_path, languages=['en', 'de']):
    try:
        text_detector_tool = Text_Detector_Tool()
        detected_text = text_detector_tool.execute(image=image_path, languages=languages, detail=0)
        detected_text = [{'bbox': bbox, 'text': txt, 'score': score} for bbox, txt, score in detected_text]
        return detected_text
    except Exception as e:
        return []

def find_image(pillow_path=0):
