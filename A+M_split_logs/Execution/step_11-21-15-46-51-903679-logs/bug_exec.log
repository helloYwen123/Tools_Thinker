        pillow_images = []
        object_detector_tool = Object_Detector_Tool(image=pillow_path, model_size='base')
        if object_detector_tool.results != []:
            results = object_detector_tool.results
        else:
            results = object_detector_tool.results
        for result in results:
            detected_image_path = object_detector_tool.save_object(result)
            pillow_images.append(detected_image_path)
        return pillow_images
    except Exception as e:
        return []

def calculate_pillow_count(image_path, languages=['en', 'de']):
