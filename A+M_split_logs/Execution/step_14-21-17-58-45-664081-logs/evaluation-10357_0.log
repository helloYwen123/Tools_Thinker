from tools.object_detector import Object_Detector_Tool
final_result = []

# Load image
with open("/nfs/data8/liao/wxie/SAT/SAT_images_train/10357_0.png", 'rb') as image_file:
    image_data = image_file.read()
tool = Object_Detector_Tool()
labels = ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

# Detect objects
objects = tool.execute(image=image_data, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size, saved_image_path=saved_image_path)

if labels:
    for object_ in objects['detected_objects']:
        for label in labels:
            if label in object_['labels']:
                detected_objects = {
                    label: object_['labels']
                }
                break
        else:
            detected_objects = {}
else:
    detected_objects = ''

if labels and save_object and 'detected_objects' in dir:
    detected_objects['detected_objects'] = detected_objects['detected_objects']
else:
    detected_objects = {labels[-1]: 1}

# Count detected objects
total_objects = sum(deprecated_objects['detected_objects'] for deprecated_objects in objects.values())

if labels:
    final_result.append((detected_objects, total_objects))
else:
    final_result.append(detected_objects)

if total_objects > 0:
    final_result[0].append('object_number', total_objects)
    final_result[0].append('object_number', Objects)
else:
    final_result[0].append('object_number', '0')


