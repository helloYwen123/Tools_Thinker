from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool().execute(image="path/to/image", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

print("Detected Objects:")
for label, detection in final_result["detected_objects"]:
    print(f"{label}:")
    for entry in detection["boxes"]:
        print(f"- [x1, y1, x2, y2] {entry['box']}")  # Extract detected coordinates
    print()
  
    print(f"{label} Count: {final_result['object_number'][label]}")


