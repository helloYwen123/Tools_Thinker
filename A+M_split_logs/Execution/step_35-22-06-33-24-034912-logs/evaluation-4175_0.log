def count_plants(image_path):
    # Load Grounding DINO model
    model = GroundingDINO()
    
    # Load image
    image = cv2.imread(image_path)
    
    # Detect HousePlants
    detected_objects = model.detect_objects(image, labels=['HousePlants'])
    
    # Count detected objects
    object_number = len(detected_objects)
    
    return detected_objects, object_number

# Specify image path as input
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4175_0.png'

# Call function to calculate objects and count them
detected_objects, object_number = count_plants(image_path)

# Print the detected objects and the count
detected_objects


