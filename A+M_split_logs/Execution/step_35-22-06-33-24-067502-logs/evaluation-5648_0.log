# Import necessary tool modules
from Object_Detector_Tool import Object_Detector_Tool

# Set the image file path
image_path = '/path/to/image'

# Set the labels for baseball and basket
labels = ['baseball', 'basket']

# Set the confidence threshold for detection (default: 0.35) and the size of the model to use (default: 'tiny')
confidence_threshold = 0.35
model_size = 'tiny'

# Initialize Object_Detector_Tool
object_detector_tool = Object_Detector_Tool()

# Call the object_detector_tool to detect sports items
detected_objects, object_count = object_detector_tool.execute(image=image_path, labels=labels, save_object=False, saved_image_path='detected_objects')

# Generate a summary of detected objects
final_result = {
  "detections_summary": {
    "total_detections": len(detected_objects),
    "total_labels": len(labels),
    "objects": [], # Output a list of object detections with bounding box, score, and saved_image_path
  },
  "object_count": object_count,
  "detections": detected_objects
}


