import numpy as np

def count_safes(image_path):
    # Load image and perform text detection
    image = image_path
    languages = ['en', 'de']
    result = text_detector_tool.execute(image=image, languages=languages)
    
    # Define variables
    detected_safes = []
    total_safes = 0
    
    # Loop through detected text blocks in the image
    for block_info in result:
        # Extract bounding box coordinates
        x0, y0 = block_info[1][0]
        x1, y1 = block_info[1][1]
        x2, y2 = block_info[1][2]
        x3, y3 = block_info[1][3]
        
        # Check if text block is for a save object
        text = block_info[3]
        if "S" in text and "afe" in text:
            # Add detection to list of safes
            detected_safes.append([x0, y0, x1, y1, x2, y2, x3, y3])
            # Update total count of safes
            total_safes += 1
    
    # Save detected objects as images
    for det in detected_safes:
        x0, y0, x1, y1, x2, y2, x3, y3 = det
        image_box = np.array([x0, y0, x1, y1], dtype=np.int32)
        image_box = (image_box.astype(np.int32) - np.array([800, 1000], dtype=np.int32)).astype(np.uint32)
        cv2.rectangle(image, (x0, y0), (x1, y1), (255, 0, 0), 2)
        cv2.putText(image, "SAFE", (x2, y2), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2)
        # Save image
        imwrite_path = imgwrite_path + "S" + "_s" + str(total_safes) + ".png"
        cv2.imwrite(imwrite_path, image)
    
    return detected_safes, total_safes


