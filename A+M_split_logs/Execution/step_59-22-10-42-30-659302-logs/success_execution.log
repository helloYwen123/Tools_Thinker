from object_detector import Object_Detector_Tool

final_result = {
  "detected_objects": {},
  "object_number": {}
}

try:
  object_detector_tool = Object_Detector_Tool()
  
  detected_objects, object_number = object_detector_tool.execute(image='path/to/image', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
  
  if detected_objects:
    for label in detected_objects[0].keys():
      detected_objects[0][label].append({'bbox': detected_objects[0][label][0], 'score': detected_objects[0][label][1]})
      object_number[label] = detected_objects[0][label][1]
    
  final_result["detected_objects"] = detected_objects
  final_result["object_number"] = object_number
  
except Exception as e:
  final_result["detected_objects"] = {}
  final_result["object_number"] = {}
  final_result["error"] = str(e)

