    labels = ["baseball", "basket"]
    
    text_demonstration = False

    try:
        detector_tool = Object_Detector_Tool()
        detected_objects = detector_tool.execute(image=image_path, labels=labels)

        object_number = total_objects = {}
        for obj in detected_objects:
            total_objects += 1
            for label in labels:
                obj_number = detected_objects[label].count()
                object_number[label] = total_objects - obj_number
                if text_demonstration:
                    print(text_object)
