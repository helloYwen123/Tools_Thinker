                    text_data = object_tool.execute(image=image_path, languages=["en", "de"])
                    print(text_data)

    except Exception as e:
        print("Error:", e)
    else:
        print(f"Detected objects: {detected_objects}")
        print(f"Total objects detected: {total_objects}")

