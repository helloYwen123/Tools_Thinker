import numpy as np
from object_detector import Object_Detector_Tool

def analyze_rooms_in_scene(room_coordinates, images_dict):
    """
    Analyzes the given room coordinates and images dictionary to count the number of chairs in the scene.
    """
    
    # Load the object detector tool
    object_detector = Object_Detector_Tool()
    
    # Execute the tool to count chairs
    detected_objects, object_count = object_detector.execute(image=room_coordinates, labels=['chair'], save_object=True)
    
    return detected_objects, object_count


