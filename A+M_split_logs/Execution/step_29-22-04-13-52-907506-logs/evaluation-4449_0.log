def count_tables(image_path):
    object_detector = Object_Detector_Tool()

    detected_objects = object_detector.execute(image=image_path, labels=['餐桌'], save_object=False)
    total_tables = detected_objects[0]["total_objects"]
    for obj_id, obj_details in Detected_objects.items():
        table_details = obj_details[0].get('box', [0, 0, 0, 0])
        
