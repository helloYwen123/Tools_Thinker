from object_detector_tool import Object_Detector_TOOL

def count_identified_beds(image_path):
    """
    Function to count and locate beds in an image.
    """
    object_dector = Object_Detector_TOOL()

    # Assuming the input path is 'path/to/image.png'
    # and you want to detect baseball and basket
    labels = ['baseball', 'basket']
    threshold = 0.4  # custom threshold value
    model_size = 'tiny'  # choose model_size as 'tiny' and 'base'
    save_object = True  # Boolean for saving the detected objects in images

    if save_object:
        image = 'path/to/image.png'
        result = object_dector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)
        # Process the detected objects to get total count
    else:
        result = []

    # Display the results
    total_count = len(result)
    print(f"Total beds found: {total_count}")

