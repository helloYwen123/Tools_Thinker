from object_detector_Tool import Object_Detector_Tool

def count_beds(image_path):
    # Load the image
    image = Image.open(image_path)
    
    # Convert the image to grayscale
    image_gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    
    # Calculate the median blur of the image
    median_blurred = cv2.medianBlur(image_gray, 5)
    
    # Define parameters for object detection
    model_size = "tiny"
    label_list = ["bed"]

    # Detect objects using object_detector_Tool
    object_detector = Object_Detector_Tool(
        model_size=model_size, 
        labels=label_list, 
        threshold=0.35, 
        save_object=True, 
        saved_image_path="detected_objects"
    )
    detected_objects, object_number = object_detector.execute(image=median_blurred)

    bed_count = len(detected_objects.get("bed", []))
    
    # Convert the detected objects to a list format
    detected_objects = [{"box": DetectionEntry.box, "score": DetectionEntry.score, "saved_image_path": DetectionEntry.saved_image_path} for DetectionEntry in detected_objects["baseball"]]
    
    # Return the detected objects list and the bed count as a tuple
    return {"objects": detected_objects, "bed_count": bed_count}

# Usage example
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8144_0.png"
final_result = count_beds(image_path)
print("Number of beds in the scene:", final_result["bed_count"])
final_result

