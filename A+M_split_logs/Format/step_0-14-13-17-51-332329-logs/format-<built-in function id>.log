```python
import mmcv

from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels=['Doorway', 'Dark blue fabric armchair'], save_object=True, saved_image_path='detected_objects'):
    result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    return result

# Basic parameters
image_path = './SAT_images_train/2416_0.png'
labels = ['Doorway', 'Dark blue fabric armchair']
save_object = True
saved_image_path = 'detected_objects'

# Execution
result = detect_objects(image_path, labels, save_object=save_object, saved_image_path=saved_image_path)
```

This code will attempt to identify the objects by labels you provide and save the object detection results in the `detected_objects` directory with the specified image path and saved path.
