<command>
from object_detector import Object_Detector_Tool

# Use the Object_Detector_Tool tool to detect objects in the scene
object_detector_tool = Object_Detector_Tool()
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4961_0.png'

# Set the labels 'baseball' and 'basket' to detect
labels = ['baseball', 'basket']

# Check if the detected objects need to be saved
save_object = True

# Set the saved image path
saved_image_path = 'detected_objects'

# Call the tool and get the detected objects and their count
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

# Return results
final_result = {
    "detected_objects": detected_objects,
    "object_number": object_number
}
</command>

