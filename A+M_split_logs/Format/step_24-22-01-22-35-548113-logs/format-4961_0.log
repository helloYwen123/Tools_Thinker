from Object_Detector_Tool import object_detector_tool

# Assuming the paths to the image file, labels to detect, and threshold are available
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4961_0.png'
labels_to_detect = ['baseball', 'basket']
confidence_threshold = 0.35

result = object_detector_tool.execute(image=image_path, labels=labels_to_detect, threshold=confidence_threshold, save_object=True)

# Extracting detected objects and their count
detected_objects = []
object_number = {}

for det in result[0]:
    detected_objects.append({
        'bbox': ((det['bbox'][0], det['bbox'][1]), (det['bbox'][2], det['bbox'][3])),
        'score': det['score'],
        'saved_image_path': det['saved_image_path']
    }) 
    
    object_number[det['bbox'][0]] = len(detected_objects)

final_result = {"detected_objects": detected_objects, "object_number": object_number}
</command>
