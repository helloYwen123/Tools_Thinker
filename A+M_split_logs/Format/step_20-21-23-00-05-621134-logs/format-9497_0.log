from Object_Detector_Tool import Object_Detector_Tool

# Check the number of paintings
def count_paintings(image_path):
    # Load the image using OpenCV
    cap = cv2.VideoCapture(image_path)
    if not cap.isOpened():
        return 0

    numberOfPaintings = 0
    # 1. Detect objects by class ('baseball', 'basket') using object detection and save each detected baseball or basketball
    for label in ["baseball", "basket"]:
        ret, frame = cap.read()  # Read the active object frame
        result = object_detector_tool.execute(image=frame, labels=[label], save_object=True)
        numberOfPaintings += len(result.get('baseball', [])) + len(result.get('basket', []))

    return numberOfPaintings

result = count_paintings("/nfs/data8/liao/wxie/SAT/SAT_images_train/9497_0.png")
final_result = {"number of paintings detected": result}
print(json.dumps(final_result, indent=2))
