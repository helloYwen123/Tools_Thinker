from tool_module import Object_Detector_Tool, Text_Detector_Tool

image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/1615_0.png'  # Change the path to the image file
labels = ['wall', 'door']  # List of labels for door and wall

# Initialize the text detector tool with the specified languages
text_detector_tool = Text_Detector_Tool()
result = text_detector_tool.execute(image=image_path, languages=['en', 'de'])

doorways = 0  # Initialize the door count
text = []  # List to store detected text blocks

for block in result:
    if block[0][4] == 0:  # Check if the block contains the 'wall' label
        doorway = block[0]
        if doorway in labels:
            doorway += ' (wall)'
            doorways += 1
            text.append(block)
        elif doorway:
            doorway += ' (door)'
             


# Print the detected text blocks and count the number of doorways
for block in text:
    print(block)

# Print the total number of doorways
print("Number of doorways: ", doorways)
```

