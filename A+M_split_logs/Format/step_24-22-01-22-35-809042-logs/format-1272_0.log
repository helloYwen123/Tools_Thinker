        if label["saved_image_path"] is not None:
            final_result.append({"label": label["label"], "count": res["object_number"][label["label"]], "detected_objects": label["detected_objects"]})
else:
    final_result.append({"label": "text", "count": 0, "detected_objects": ["No text detected"]})

if res["detected_objects"]:
    for det_objects in res["detected_objects"]:
        final_result.append(det_objects)
else:
    final_result = []

