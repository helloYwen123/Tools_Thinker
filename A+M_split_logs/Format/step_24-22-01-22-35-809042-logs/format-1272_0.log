```python
from pathlib import Path

# The image path to be detected
image_path = Path("/path/to/image_file").resolve().as_posix()

# Initialize the object detector
object_detector = Object_Detector_Tool()

# Create a detection dictionary
detection_dict = {}
detection_dict_total_obj = {}

# Execute object detection and initialize the object detector
object_detector.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Retrieve the total number of detected objects
object_detector_name = "baseball"
object_detector_num = object_detector.get_object_number(object_detector_name)

# Iterate through the detected detection entry
for label in object_detector.get_label_list():
    for entry in object_detector.get_detection_all_label_list(label):
        # Check if the entry contains a bounding box
        if entry["box"]:
            # Add the object to the detection dictionary
            detection_dict_label = detection_dict.get(label, [])
            if len(detection_dict_label) >= 1:
                detection_dict_label.append(entry)
                for det in detection_dict_label:
                    if det["box"]:
                        for obj in det["box"]:
                            if "baseball" == label and obj[2] - obj[0] == obj[3] - obj[1] and obj[4] - obj[2] == obj[5] - obj[3]:
                                detection_dict_total_obj["baseball"] = detection_dict_total_obj.get("baseball", 0) + 1
                            elif "basket" == label and obj[2] - obj[0] == obj[3] - obj[1] and obj[4] - obj[2] == obj[5] - obj[3]:
                                detection_dict_total_obj["basket"] = detection_dict_total_obj.get("basket", 0) + 1

# Loop to count the number of baseball and basket detected objects
for key, value in detection_dict.items():
    if key in ["baseball", "basket"]:
        keys_to_check = ["box", "score"]
        total_objects = 0
        for entry in value:
            for k in keys_to_check:
                if k not in entry:
                    break
            else:
                total_objects += 1

# Output the result
final_result = f"Number of detected objects for the items: baseball, basket: {total_objects}\n"
final_result += f"For the base ball: Total baseball detection
