from object_detector_Tool import Object_Detector_Tool

def count_chairs():
    chair_boxes = []
    for i in range(4):
        chair_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/782_2.png"
        chair_boxes.append([i, 1, chair_image])
    
    chair_number = len([ch for ch in chair_boxes if "chair" in ch['box'][0]])
    chair_labels = [ch for ch in chair_boxes if "chair" in ch['box'][0]]

    return {"chair": {"count": chair_number, "labels": chair_labels}}, chair_number

final_result = count_chairs()
