from Object_Detector_Tool import Object_Detector_Tool

final_result = ""
tool_version = "1.0.0"

def detect_objects(image_path, desired_labels):
    object_detector_tool = Object_Detector_Tool()
    if image_path:
        label_detection_result = object_detector_tool.execute(image=image_path, labels=desired_labels)
        if label_detection_result:
            return label_detection_result

def count_labels(image_path, labels):
    label_count = {}
    labels_to_check = set(labels)
    total_detected_objects = 0
    for label in labels_to_check:
        label_detection_result = object_detector_tool.execute(image=image_path, labels=[label])
        total_detected_objects += len(label_detection_result)
        if label in label_count:
            label_count[label] += 1
        else:
            label_count[label] = 1

    return total_detected_objects, label_count
