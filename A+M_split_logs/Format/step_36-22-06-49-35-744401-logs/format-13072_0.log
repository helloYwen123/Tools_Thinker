<command>
def count_plungers(image_path, sinks='basin', details=0):
    detected_objects = []
    object_number = {}
    
    # Load the model and create detection objects
    object_detector_tool = Object_Detector_Tool()
    
    # Detect sinks in the image
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=[sinks], threshold=0.4, model_size='tiny', save_object=True)
    detected_objects = {key: (object[0] for object in value) for key, value in detected_objects.items()}
    
    # Check if any sink is detected
    if any(detected_objects.values()):
        for sink in sinks:
            if sink in detected_objects:
                number = detected_objects[sink]
                object_number[sink] = number
    else:
        object_number[sinks] = 0
    
    return object_number

final_result = count_plungers('/nfs/data8/liao/wxie/SAT/SAT_images_train/13072_0.png', sinks='basin')
print(final_result)
</command>
