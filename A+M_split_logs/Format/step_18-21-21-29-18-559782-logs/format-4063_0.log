from object_detector_tool import Object_Detector_Tool

class ImageAnalyzer:
    def analyze_image(self, image_path, language="en", detail=False):
        tool = Object_Detector_Tool()
        result = tool.execute(image=image_path, languages=[language], detail=detail)

        if result is None:
            return []

        detected_objects = []
        object_number = {}

        for detected_object in result:
            label = None
            if 'labels' in detected_object:
                label_dict = detected_object['labels']
                label = label_dict.get("baseball")
                if label is not None:
                    object_number[label] = object_number.get(label, 0) + 1

            box = [int(x) for x in detected_object['bbox"]]
            score = detected_object['score']
            saved_image_path = detected_object.get('saved_image_path', '')
            detected_objects.append((label, {'box': box, 'score': score, 'saved_image_path': saved_image_path}))

        return detected_objects, object_number

# Example usage
if __name__ == "__main__":
    from_module = "object_detector_tool"
    import_name = "Object_Detector_Tool"
    final_result = ImageAnalyzer().execute(image="path/to/image", labels=["baseball"], languages=["en"])
    print(final_result)

