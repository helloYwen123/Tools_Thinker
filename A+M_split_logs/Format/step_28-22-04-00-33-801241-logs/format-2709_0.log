from object_detector import Object_Detector_Tool


class ImageProcessor:
    def process_image(self, image_path, labels, threshold=0.35, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
        # Initialize Object_Detector_Tool with given parameters
        object_detector_tool = Object_Detector_Tool()

        # Execute the tool to detect objects in the image
        detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

        # Convert the detected objects dictionary to a list
        if object_number:
            final_result = {"count": 1, "labels": []}
            for label in object_number["labels"].keys():
                object_count = object_number["labels"][label]
                final_result["count"] += object_count
                final_result["labels"].append({"bbox": label, "score": object_number["labels"][label]})

        return final_result


