from Object_Detector_Tool import Object_Detector_Tool

def count_counter_tables(image_path):
    label_to_object_number = {}
    object_number = 0
    
    # Detect table
    detected_objects = Object_Detector_Tool().execute(image=image_path, labels=["table"], save_object=True, saved_image_path="")
    detected_table_objects = detected_objects["detected_objects"]

    # Count counter tables
    for detected_table in detected_table_objects:
        label_to_table_number = detected_table["label"] not in label_to_table_number or label_to_table_number[detected_table["label"]] < detected_table["count"] else detected_table["count"]
        label_to_number = {detected_table["label"] : label_to_table_number}
        object_number += label_to_number["table"]

    return {"total": object_number, "counter_tables": label_to_number}

final_result = count_counter_tables("/nfs/data8/liao/wxie/SAT/SAT_images_train/2709_0.png")

final_result = [value for sublist in final_result["counter_tables"].values() for value in sublist.values()]
print(final_result)
print("Total counter table in the image is: ", final_result[0])
print("Counter table with the most number of objects: ", final_result[1]) 
