from Object_Detector_Tool import Object_Detector_Tool

def count_countersaces_and_save_counterfaces(image_path):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['Counterface'], save_object=True, saved_image_path="counted_objects")
    
    countersace_count = len(detected_objects)
    final_result = {
        'countersaces': countersace_count
    }
    
    return final_result

# Example usage
