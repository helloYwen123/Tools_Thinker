from object_detector_tool import *
import os

# Example image path where the "baseball" and "basket" are detected
import_path = "/path/to/example/image.jpg"

# Generate path for detected object images
saved_image_folder = "/path/to/save/detected/objects"

# Execute object detector
result = object_detector_tool.execute(image=import_path, labels=["baseball", "basket"], save_object=True, saved_image_path=saved_image_folder)

# Check if detected objects were saved successfully
if 0 <= len(result) <= 2:
    # Save object images
    for i in range(len(result)):
        img_path = os.path.join(saved_image_folder, f"detected_objects/image_{i}.png")
        object_detector_tool.generate_from_result(result[i])

    final_result = {'label_count_dict': {'baseball': result[0][0][0]}, 'basket': result[1][0][0]}
elif result:  # If more than two objects are detected
    print("Error: More than two objects detected. Please check and try again.")
else:  # If no objects are detected
    print("Error: No objects detected.")

