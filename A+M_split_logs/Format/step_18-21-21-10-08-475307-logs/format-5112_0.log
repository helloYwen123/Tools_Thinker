        image = Image.open(image_path)
        image = preprocess_image(image)
        label_results = detect_labels(image, labels=labels)
        object_labels, object_scores, object_boxes = extract_labels_and_scores(label_results)
        total_objects = len(object_labels)

        if save_object:
            detected_objects = count_objects_in_image(image, labels=labels)
            save_detected_objects(detected_objects)

    return {'total_objects': total_objects}

