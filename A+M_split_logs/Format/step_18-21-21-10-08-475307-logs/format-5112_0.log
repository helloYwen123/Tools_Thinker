from object_detector_tool import Object_Detector_Tool

def count_dressers(image_path):
    object_detector = Object_Detector_Tool(image_path, labels=['dresser'], save_object=True)
    detected_objects = object_detector.execute()
    
    dressers_count = {}
    
    for detected_object in detected_objects:
        if detected_object['category'] == 'dresser':
            dressers_count[detected_object['category']] = detected_object['number']
    
    return dressers_count

final_result = count_dressers('/nfs/data8/liao/wxie/SAT/SAT_images_train/5112_0.png')
print(final_result)
