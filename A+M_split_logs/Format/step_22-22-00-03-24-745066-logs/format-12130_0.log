from tool_module import object_detector_tool, text_detector_tool

def count_doors(image_path):
    detections = object_detector_tool.execute(image=image_path, save_object=True, saved_image_path="counted_objects")
    door_count = 0
    for detection in detections:
        if 'baseball' in detection['labels'] and 'door' in detection['coordinates']:
            door_count += 1
    return door_count, len(detections)

def count_text(image_path, languages=['en', 'de']):
    result = text_detector_tool.execute(image=image_path, languages=languages)
    text_blocks = result['result']
    text_count = 0
    for block in text_blocks:
        if block[2] >= 0.75:
            text_count += 1
    return text_count

if __name__ == '__main__':
    image_path = '' # Path to the image file
    door_count, _ = count_doors(image_path)
    text_count = count_text(image_path, languages=['en', 'de'])

    print(f"Number of doors in the image: {door_count}")
    print(f"Number of text blocks in the image: {text_count}")

    # Assuming the text blocks represent different door types, e.g., doors with a baseball emblem, a basketball emblem, etc.
    if text_count == 3:
        print(f"Detected 3 doors in the image.")
    else:
        print("No detected doors.")
