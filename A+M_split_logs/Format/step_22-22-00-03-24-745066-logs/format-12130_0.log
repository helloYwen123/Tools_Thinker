from object_detector_tool import Object_Detector_Tool

final_result = {}

# Define the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12130_0.png"

# Set the parameters
labels = ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'

# Execute the object detection
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path='detected_objects')

if type(detected_objects) is tuple:
    detected_objects, object_number = tuple(detected_objects)

# Determine the number of doorways
total_objects = len(detected_objects)
total_number_of_objects = int(object_number['baseball']) + int(object_number['basket'])

if total_objects == total_number_of_objects:
    doorways = total_objects
else:
    doorways = 0

final_result['doorways'] = doorways
final_result['total_objects'] = total_objects

# Display the result
print(final_result)
