from Object_Detector_Tool import Object_Detector_Tool

def check_rooms(images):
    for image in images:
        object_detector = Object_Detector_Tool()
        objects, num_objects = object_detector.execute(image=image, labels=['door'], languages=['en'])
        detected_doorways = []
        for obj in objects:
            if obj['box'][0] < 100 and obj['box'][1] < 100:
                detected_doorways.append((obj['box'][0], obj['box'][1]))
        return detected_doorways

def count_object_in_image(images, labels):
    result = []
    for image in images:
        result.append(len([obj for obj in object_detector.execute(image=image, labels=labels) if obj['box'][0] < 100 and obj['box'][1] < 100]))
    return result

