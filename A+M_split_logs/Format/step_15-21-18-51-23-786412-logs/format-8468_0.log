from object_detector_tool import Object_Detector_Tool

# Set configuration parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8468_0.png"
labels_to_check = ["baseball", "basket"]
save_objects = True
model_size = "tiny"
save_image_path = "detected_objects"

# Execute object detection
result = Object_Detector_Tool(image_path, labels=labels_to_check, model_size=model_size, save_objects=save_objects, saved_image_path=save_image_path).execute()

# Output object Detection Data
detected_objects = result[0]
object_number = result[1]

# Output result
print(f"Detected objects:")
for label in detected_objects:
  print(f"{label}:")
  print(f"    Box coordinates: {label['box']['x1'].numpy()} {label['box']['y1'].numpy()} {label['box']['x2'].numpy()} {label['box']['y2'].numpy()}")
  print(f"    Confident score: {label['score']}")
  if 'saved_image_path' in label:
    print(f"    Saved Image: https://0.0.0.0:8000/saved/{label['box']['x1'].numpy()}/img.png")

final_result = f"Detected objects: {detected_objects} with {object_number} item(s)"
print(final_result)
