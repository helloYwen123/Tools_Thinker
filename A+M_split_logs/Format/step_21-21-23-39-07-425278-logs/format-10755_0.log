              'synonym': {1:'one', 2:'two', 3:'three'},
              'hypothesis': {1:'thing', 2:'a thing', 3:'two things'},
              'abbreviation': {1:'a', 2:'the', 3:'and'},
              'symbol': {1:'\u00e7', 2:'x'},
              'unknown': 'unknown'},
        'ja': {'words': list('ある ある', 'ただ', 'だけ', '一つだけ', '一つしか'),
              'synonym': {1:'一つつの', 2:'一つつの',
                            3:'一つの', 4:'いくつかつの'},
              'abbreviation': {1:'',
                                2:'',
                                3:'',
                                4:'いくつつの'},
              'symbol': {1:'～', 2:'～', 3:'～'},
               'unknown': 'a'},
          'de': {'words': list('a b z c ...'),
                 'synonym': {1:'ein',
                              2:'eine',
                              3:'eins',
                              4:'zwei'},
                 'abbreviation': {1:'a',
                                2:'eins',
                                3:'zeigen'},
                 'symbol': {'~': '¬'}},   
        }
        
        word_index = 0
        text = ''

        for line in image.split('\n'):
            for word in line.split()[1:]:
                if word in langs:
                    if word_index in langs[word] and not langs[word][word_index]:
                        if lang_dictionaries[langs[word] + 'words'][words[word_index]]:
                            if len(word) <= 3:
