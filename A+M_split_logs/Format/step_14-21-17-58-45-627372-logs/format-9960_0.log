def count_doors(image_path, door_labels=['door']):
    image = Image.open(image_path)
    object_detector_tool = Object_Detector_Tool() # Import Object_Detector_Tool from the given tool module
    detected_objects, object_count = object_detector_tool.execute(image=image, labels=door_labels, save_object=True)
    
    door_count = len(set(detected_objects['baseball']['box'][1]))
    if door_labels == ['door']:
        door_count += 1
    
    return object_count, door_count

answer = count_doors('/nfs/data8/liao/wxie/SAT/SAT_images_train/9960_0.png', ['baseball'])
print(f"Doorways visible: {answer[1]} Doorways in total: {answer[0]}")
