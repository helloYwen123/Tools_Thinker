from object_detector_Tool import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/scene_image.png', labels=None, threshold=0.35, model_size='tiny', save_object=False)

if 'detected_objects' in final_result:
    detected_objects = final_result['detected_objects']
    object_number = {'baseball': 0, 'basket': 0}

    for label, data in detected_objects.items():
        if label == 'basket':
            object_number['basket'] += 1
        if label == 'baseball':
            object_number['baseball'] += 1

    return {
        'images': [
            f"basketdetected_{object_number['basket']}image.png",
            f"balldetected_{object_number['baseball']}image.png"
        ],
        'number_of_objects': object_number
    }
else:
    return []
