from object_detector import Object_Detector_Tool

# Set the image file path
image_path = "/nf/data/sat_images/train/10602_0.png"

# Set the labels to detect
labels = ["baseball", "basket"]

# Set the confidence threshold
confidence_threshold = 0.35

# Set the model size to 'tiny'
model_size = "tiny"

# Set the save_object to True
save_object = True

# Set the saved_image_path to 'detected_objects'
saved_image_path = 'detected_objects'

# Create an Object_Detector_Tool instance
object_detector_tool = Object_Detector_Tool()

# Execute the object_detection function
detect_result, object_num = object_detector_tool.execute(image=image_path, labels=labels, threshold=confidence_threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Extract the number of detected objects
total_objects = {"baseball": object_num["baseball"], "basket": object_num["basket"]}

# Join the list with semicolon, format by newline
final_result = "\n".join(f"{label}: {num_objects}" for label, num_objects in total_objects.items())

# Append empty string to the final result string
final_result += " "
