<command>
from Object_Detector_Tool import Object_Detector_Tool

# Define the image path and parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13012_0.png"
label_list = ["baseball", "basket"]
confidence_threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Create the Object_Detector_Tool object
object_detector_tool = Object_Detector_Tool()

# Detect objects in the image
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=label_list, confidence_threshold=confidence_threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Convert the result to a dict for output
final_result = {
  "detected_objects": {
    *[{'box': det['bbox'], 'score': det['score'], 'saved_image_path': det['image_path']} for det in detected_objects]
  },
  "object_number": object_number
}

# Print the final result
print(final_result)
</command>
