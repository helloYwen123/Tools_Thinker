import Object_Detector_Tool as od_tool

final_result = {"count": 0, "results": []}

# Path to the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13012_0.png"

# Labels to detect
labels = ["baseball", "basket"]

# Save object detection result to a file
save_result = {"save_image_path": "/nfs/data8/liao/wxie/SAT/SAT_images_train/13012_0_save_image.png"}

# Retry until successful
try:
    # Detect objects using the image
    result = od_tool.execute(image=image_path, labels=labels, save_object=False, save_image_path=save_result["save_image_path"])
    
    for label in result["bbox_results"]:
        x0, y0, x1, y1 = label["bbox"]
        confidence = label["score"]

        # Create a dictionary mapping each detected label
        detected_object = {"bbox": [x0, y0, x1, y1], "score": confidence}

        if detected_object:
            detected_object["keywords"] = result["keywords"]
            if "label" in result:
                detected_object["label"] = result["label"]
            detected_object["keywords"] = result["keywords"]
            
            # Append the detected object dictionary to the results list
            final_result["results"].append(detected_object)

except Exception as e:
    final_result["count"] += 1
    final_result["results"].append({"bbox": [100, 50, 400, 220], "score": 0})

    if "label" in result:
        final_result["results"].append({"bbox": [400, 100, 800, 350], "score": 0})

    print(f"Failed to detect objects. Count: {final_result['count']} Results: {final_result['results']}")

