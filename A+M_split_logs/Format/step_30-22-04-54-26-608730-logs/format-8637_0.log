def text_detector(image_path):
    text_detector = Text_Detector_Tool()
    result = text_detector.execute(image=image_path, languages=['en', 'de'])
    detected_text = []
    for det_result in result:
        tx = det_result[2]
        x = int(det_result[3][0])
        y = int(det_result[3][1])
        width = int(det_result[4])
        height = int(det_result[5])
        detected_text.append([x, y, width, height])
    return detected_text

