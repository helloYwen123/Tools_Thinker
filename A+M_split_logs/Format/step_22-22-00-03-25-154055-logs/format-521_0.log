from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

final_result = []

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/521_0.png"
languages = ["en", "de"]
detail = 1

try:
    object_results = Object_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
    detected_objects = []

    for object_label, object_detection in object_results.items():
        object_detection = [det for det in object_detection if det['score'] > 0.35]

        if object_label in ["baseball", "basket"]:
            box = object_detection[0]['box']
            detected_objects.append({'box': box, 'label': object_label})

        if object_label == "box":
            if len(object_detection) > 1:
                box = object_detection[1]['box']
                detected_objects.append({'box': box, 'label': object_label})

    if len(detected_objects) == 0:
        detected_objects = []
        object_number = {}
        object_results[object_label] = 0

    object_labels = set([det['label'] for det in detected_objects])

    object_number = {label: len(detected_objects) for label in object_labels}

    if save_object:
        # Crop and save detected objects
        for obj_obj in detected_objects:
            if obj_obj['label'] == "baseball":
                image_path = "detected_objects/image_baseball_{0}.png".format(obj_obj['score'])
            elif obj_obj['label'] == "basket":
                image_path = "detected_objects/image_basket_{0}.png".format(obj_obj['score'])

            from_bbox_tool import bbox_tool
            to_bbox, bbox = bbox_tool(image_path)
            bbox_tool.bbox_tool.to_bbox_tool(bbox)
            bbox_tool.bbox_tool.to_txt_tool()

    final_result.append({"detected_objects": detected_objects, "object_number": object_number})
    final_result.append({
        "detected_objects": detected_objects
            if object_label == "baseball"
            else {label: {len(detected_objects)}}
    })
except Exception as e:
    final_result.append({"detected_objects": {}, "object_number": {}})
    print(f"Error: {e}")
