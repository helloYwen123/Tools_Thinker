from object_detector import Object_Detector_Tool

class Floor:
    def __init__(self):
        self.floor = {
            'image': '/nfs/data8/liao/wxie/SAT/SAT_images_train/9341_0.png',
            'labels': ['baseball', 'basket', 'dining_table', 'sofa'],
            'threshold': 0.35,
            'model_size': 'tiny',
            'save_object': True,
            'saved_image_path': 'detected_objects'
        }

    def object_detector(self):
        object_detector_tool = Object_Detector_Tool()
        detected_objects, object_number = object_detector_tool.execute(image=self.floor['image'], labels=self.floor['labels'], save_object=True, saved_image_path=self.floor['saved_image_path'])
        final_result = {'detected_objects': detected_objects, 'object_number': object_number}
        print(final_result)
