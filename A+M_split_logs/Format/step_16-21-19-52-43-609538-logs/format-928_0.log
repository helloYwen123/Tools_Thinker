from object_detector import Object_Detector_Tool

final_result = []
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/928_0.png'
object_labels = ['baseball', 'basket']
save_object = True
model_size = 'tiny'

try:
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path,
                                                                   labels=object_labels,
                                                                   save_object=save_object,
                                                                   model_size=model_size)
except:
    final_result.append("failed")
finally:
    del object_detector_tool

if detected_objects:
    if 'baseball' in detected_objects:
        for detection in detected_objects['baseball']:
            final_result.append(f"({' '.join([det['box'][0], f' {det["box"][1]", ({det["score"]}).' for det in detected_objects['baseball']])})")
    if 'basket' in detected_objects:
        for detection in detected_objects['basket']:
            final_result.append(f"({' '.join([det['box'][0], f' {det["box"][1]}"'),]).' for detected_objects['basket']])")

if 'baseball' in object_number:
    final_result.append(f"({object_number['baseball']}, {' '.join([det['box'][0], f' {det["box"][1]}"'),}).'\n")
if 'basket' in object_number:
    final_result.append(f"({object_number['basket']}, {' '.join([det['box'][0], f' {det["box"][1]}"'),}).'\n')

if 'baseball' in detected_objects:
    final_result.append(f"{' ".join(det['box'][0] for det in detected_objects['baseball']).strip()}\n")
if 'basket' in detected_objects:
    final_result.append(f"{' ".join(det['box'][0] for det in detected_objects['basket']).strip()}\n")
