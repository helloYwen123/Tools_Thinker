from object_detector import Object_Detector_Tool

final_result = "The path of image with specified label can be found here."

object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image="path/to/image", labels=["baseball"], save_object=True, saved_image_path="detected_objects")

for label, objects in detected_objects.items():
    final_result += f"object_number for {label}: {len(objects)}\n"
    for obj in objects:
        final_result += f"{detected_objects[label]:}<item>{obj:<d}<bbox>[{obj[0][0]}, {obj[0][1]}, {obj[1][0]}, {obj[1][1]}]</item>\n"

print(final_result)
</command>
