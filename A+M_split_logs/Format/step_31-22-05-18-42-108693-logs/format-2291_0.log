from object_detector import Object_Detector_Tool

# Function to count and return the number of detected objects
def count_obj_detection(image_path, labels, model, save_object):
    object_detector = Object_Detector_Tool()
    detected_objects, object_number = object_detector.execute(image=image_path, labels=labels, save_object=save_object, model=model)
    return detected_objects, object_number

# Function to detect text in an image and provide the number of detected lines (max. 1000 lines per image)
def text_detection(image_path, languages=['en', 'de'], detail=0):
    text_detector = Text_Detector_Tool()
    result = text_detector.execute(image=image_path, languages=languages, detail=detail)
    total_lines = len(result) if result else 0
    return result, total_lines

# Usage example
detected_objects, object_number = count_obj_detection("/nfs/data8/liao/wxie/SAT/SAT_images_train/2291_0.png", ["baseball", "basket"], "tiny", True)
print(f"Number of detected objects: {object_number}")
print(json.dumps(detected_objects, sort_keys=True))
