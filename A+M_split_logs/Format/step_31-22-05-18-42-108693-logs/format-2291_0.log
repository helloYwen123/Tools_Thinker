<command>
from Object_Detector_Tool import Object_Detector_Tool

final_result = Object_Detector_Tool().execute("path/to/image", ["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

if "detected_objects" in final_result:
    detected_objects = final_result["detected_objects"]
    object_number = final_result["object_number"]
    result = ["Detected objects:", f"{'  ' * max(len([obj['box'] for obj in detected_objects]), 30)}"]
    for obj in detected_objects:
        result.append(f"{'  ' * 6}Box: ({obj['box'][0]} {obj['box'][1]}, {obj['box'][2]} {obj['box'][3]}, {obj['box'][4]} {obj['box'][5]}, {obj['score']}).")
    result.append("Object number: " + ', '.join([f'{obj["box"]}[0]} {obj["box"]}[1],' if obj["box"] else None for obj in detected_objects])
    print("\n".join(result))
else:
    print("Text detection failed.")
</command>
