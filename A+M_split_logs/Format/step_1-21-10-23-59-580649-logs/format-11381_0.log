from object_detector_tool import Object_Detector_Tool

objects, counts = Object_Detector_Tool.execute(
    image='path/to/image',
    labels=['baseball', 'basket'],
    save_object=True,
    saved_image_path='detected_objects'
)

detected_objects = {}
object_number = {}

for lbl, obj in objects:
    if obj['score'] > 0.35 and (lbl not in detected_objects or obj['score'] > detected_objects[lbl][1]['score']):
        detected_objects[lbl] = {
            'bbox': obj['bbox'],
            'score': obj['score'],
            'filename': 'detected_objects/' + obj['filename']
        }
        counts[lbl] = 1

    if obj['score'] > detected_objects[lbl]['score'] and (lbl not in counts or (counts[lbl] != 0 and counts[lbl] > 0)):
        detected_objects[lbl] = {
            'bbox': obj['bbox'],
            'score': obj['score'],
            'filename': 'detected_objects/' + obj['filename']
        }
        counts[lbl] = 1

for lbl, obj in detected_objects.items():
    obj['bbox'] = (int(obj['bbox'][0]), int(obj['bbox'][1]), int(obj['bbox'][2]), int(obj['bbox'][3])) 

detected_objects
