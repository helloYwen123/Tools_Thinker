--- Completion 5 ---
<command>
from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool().execute(image='path/to/image', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

if final_result is not None:
    detected_objects = final_result['detected_objects']
    object_number = final_result['object_number']

    print(f'Total detected objects: {object_number["baseball"]} baseballs and {object_number["basket"]} baskets.')
    for bbox, label, score in detected_objects:
        print(f'Detected {label}: box({bbox[0]}, {bbox[1]}, {bbox[2] - bbox[0]}, {bbox[3] - bbox[0]}), score: {score}')
else:
    print('Text detection failed.')
</command>
Reward: 1.0

