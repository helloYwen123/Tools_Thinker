```python
from object_detector_tool import Object_Detector_Tool

generated_lines = ""

def execute_image(image_path, labels, languages, threshold, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    if not any((labels, languages, threshold, model_size, save_object)):
        return {"error": "Missing labels, languages, threshold, model size, or save_object parameters."}
    
    detector_tool = Object_Detector_Tool()
    detected_objects, object_number = detector_tool.execute(image_path, labels, thresholds=[threshold], languages=languages, save_object=save_object, saved_image_path=saved_image_path)
    
    if detected_objects:
        for detected_object in detected_objects:
            total_number_of_objects = {label: detected_object.get('number', 0) + object_number.get(label, 0) for label, detected_object in detected_objects.items()}
            final_result = {
                "object_list": detected_object.get('objects', [dict(box=dict(x0=0, y0=0, x1=250, y1=250), score=i)) for i, detected_object in detected_objects.items()
                },
                "total_number_of_objects": total_number_of_objects
            }
            generated_lines += f"Total Number of detected objects: {total_number_of_objects}\n"
            generated_lines += f"Detected objects for each label: {detected_object}\n"
    else:
        generated_lines += "No objects detected."

    return {"objects_detected": detected_objects, "total_number_of_objects": object_number}

# usage
execute_image = execute_image
```
