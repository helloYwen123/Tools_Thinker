def count_windows(image_path, labels, threshold, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    detected_objects = []
    object_number = {}
    
    detector = Object_Detector_Tool()
    
    try:
        for label in labels:
            label_output = detector.execute(image_path=image_path, labels=[label], threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=f"detected_objects/{label.lower()}_window")
            
