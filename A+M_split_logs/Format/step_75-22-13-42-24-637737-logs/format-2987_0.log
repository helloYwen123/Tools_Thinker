# Initialize the object detector tool
object_detector_tool = Object_Detector_Tool()

# Define the image path and labels to detect
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/2987_0.png'
labels = ['baseball', 'basket']

# Set the confidence threshold and model size
file_detection_image = image_path
image_detection_labels = labels
threshold = 0.35
model_size = 'tiny'

# Execute the object detection tool
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=image_detection_labels, save_object=True, saved_image_path="detected_objects")

final_result = detected_objects
print("Number of detections:", object_number)

print("Detected objects:")
for i in range(len(detected_objects)):
