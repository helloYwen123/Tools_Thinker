from object_detector_tool import Object_Detector_Tool

def count_baselines_in_room():
    # Specify the path of the image
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12470_0.png"
    
    # Specify the labels to detect: baseball and basket
    labels_to_detect = ["baseball", "basket"]
    
    # Specify the threshold for confidence
    threshold = 0.5
    
    # Specify the model size
    model_size = "tiny"
    
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels_to_detect, threshold=threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")
    
    # Count the detected objects
    baselines_detected = sum(len(b) for b in detected_objects.values())
    
    return object_number, baselines_detected

object_number, baselines_detected = count_baselines_in_room()
final_result = {"object_number": object_number, "baselines_detected": baselines_detected}

print(final_result)
