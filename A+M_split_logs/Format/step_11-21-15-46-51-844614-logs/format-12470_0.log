import object_detector_tool

def get_objects(path_to_image, *labels):
    if labels:
        labels = [" ".join(label) for label in labels]
    object_numbers = {}

    detected_objects = []
    
    for label in labels:
        # Detect objects for each label
        try:
            detected_objects += object_detector_tool.execute(image=path_to_image, labels=[label], save_object=True, saved_image_path="detected_objects")

            # Check if a text was detected
            if object_detector_tool.detect_text(path_to_image, languages=[label]) is not None:
                text_blocks = object_detector_tool.detect_text(path_to_image, languages=[label]).split(".")

                for text_block in text_blocks:
                    object_numbers[label] += 1
                    detected_objects += [["[[" + str(x) + "]", label, label] for x in text_block]
                    
                objects = [{"box": [x[0][0][0], x[0][0][1], x[0][1][0], x[0][1][1]], "score": x[1], "text": str(x[3])] for x in detected_objects}
                detected_objects = objects

        except Exception as e:
            print(f"Failed to detect text for {label}. Error: {e}")
            return []

    return detected_objects, object_numbers

# Example usage
path_to_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12470_0.png"
labels = ["baseball", "basket"]

final_result = get_objects(path_to_image, *labels)
print(final_result)
