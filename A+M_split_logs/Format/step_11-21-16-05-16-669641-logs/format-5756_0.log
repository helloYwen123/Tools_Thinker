from object_detector import Object_Detector_Tool

# Import necessary module for text detection
from text_detector import Text_Detector_Tool

# Define function to count and detect objects in an image
def count_andDetectObjects(image_path, labels, threshold, model_size, save_object):
    object_detector_tool = Object_Detector_Tool()
    object_detection_results = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object)

    return object_detection_results

# Define function to retrieve text detection results and coordinates
def retrieveTextDetectedBlocks(image_path, languages, detail):
    text_detector_tool = Text_Detector_Tool()
    text_detection_results = text_detector_tool.execute(image=image_path, languages=languages, detail=detail)

    return text_detection_results

# Initialize object and text detection tools
