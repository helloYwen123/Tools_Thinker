# Initialize object detector with default configuration
detector = obj.Object_Detector_Tool()
detector.max_output_size = 1  # Reduce memory usage

# Execute the detection with 'text_detector_tool' for English and German detection
result = detector.execute(image='path/to/image', languages=['en', 'de'])

# Check if text detection is successful
if result:
    detected_texts = result['text']
    for det_text in detected_texts:
        detection_details = det_text[1]
        confidence_score = detection_details['score']
        box = (det_text[0], det_text[1], det_text[2], det_text[3])
        print(f"Detected {det_text[0]} text with confidence {confidence_score}")
    print(f"Total detected text with confidence score > 0.35: {len(detected_texts)}")
else:
    print("No text detected in the image.")
