<command>final_result = []
try:
    text_detector_tool = Text_Detector_Tool()
    result = text_detector_tool.execute(image='path_to_image.jpg', languages=['en', 'de'])
    for block in result:
        bounding_box = [int(x) for x in block[0]]
        recognized_text = block[1]
        confidence_score = block[2]
        final_result.append([bounding_box, recognized_text, confidence_score])

except Exception as e:
    print(f"Error: {e}")
finally:
    if isinstance(final_result, list):
        final_result = None

print(final_result)
