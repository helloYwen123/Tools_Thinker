from object_detector import Object_Detector_Tool

final_result = {
    "SideTables": {}
}

object_detector_tool = Object_Detector_Tool()

detected_objects, _ = object_detector_tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/5695_0.png", labels=["table"], save_object=True, saved_image_path="detected_objects")

if detected_objects:
    table_boxes = [obj["bbox"] for obj in detected_objects]
    table_ids = [obj["id"] for obj in detected_objects if obj["bbox"][0] in table_boxes]

    if table_ids:
        count = sum(1 for _ in table_ids)
        final_result["SideTables"] = {"1" if len(table_ids) == 1 else 0} if any(table_ids) else {}
    else:
        final_result["SideTables"] = 0

final_result = {**final_result, **{
    "baseball": len(detected_objects),
    "basket": 0,
    **final_result["baseball"]
}, 
"basketball": 0, 
"baseball": 0
}}
