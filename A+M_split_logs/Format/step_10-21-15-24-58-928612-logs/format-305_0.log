# Check if text detection was successful
if 'basket' in detections:
    basket_detection = detections['basket']
    basket_box = basket_detection[0]['box']
    basket_area = int(basket_box[0])
    print(f'The basketball field is {basket_area} square units')

# Check if baseball detection was successful
else:
    baseball_detection = detections['baseball']
    baseball_box = baseball_detection[0]['box']
    baseball_area = int(baseball_box[0])

# Calculate total number of DogBeds
total_dogbeds = basket_area + baseball_area

print(f'Three DogBeds are visible in the scene: {total_dogbeds} square units.')
