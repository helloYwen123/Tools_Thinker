from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

def count_counter_tops(image_path):
    object_detector_tool = Object_Detector_Tool()
    object_number = {}
    detected_objects, image_count = object_detector_tool.execute(image=image_path, labels=['counter', 'sink'], save_object=False, saved_image_path='detected_objects')
    for object in detected_objects:
        if 'counter' in object['label'] or 'sink' in object['label']:
            object_number[object['label']] = object_number.get(object['label'], 0) + 1
    
    for label, count in object_number.items():
        print(f"{label} : {count}")

def classify_text(image_path, languages=['en', 'de']):
    text_detector_tool = Text_Detector_Tool()
    result = text_detector_tool.execute(image=image_path, languages=languages, detail=0)
    text_blocks = []
    for block in result:
        text_blocks.append({
            "bbox": block["bbox"],
            "text": block["text"],
            "confidence": block["confidence"]
        })
    return text_blocks

def main():
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1494_0.png"
    counter_top_count = count_counter_tops(image_path)
    for label, count in counter_top_count.items():
        print(f"{label} {count}")

    text_blocks = classify_text(image_path)
    print("Text Blocks:")
    for block in text_blocks:
        print(f" {block['text']} : {block['confidence']}")
</command>

final_result = main()
