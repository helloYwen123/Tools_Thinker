from object_detector_tool import object_detector_tool  # Import Object_Detector_Tool

def count_objects(image_path, labels, threshold=0.35, model_size='tiny', save_object=False):
    """
    Detects objects in an image using the Grounding DINO model.
    """
    
    detected_objects = {'baseball': [], 'basket': []}
    object_number = {'baseball': 0, 'basket': 0}
    
    image = image_path.split('/')[-1].replace('.png', '')  # Extract the file extension from the image filename
    
    if not save_object:
        try:
            object_detector_tool = object_detector_tool()
            result = object_detector_tool.execute(image, labels, threshold, model_size, save_object)
        
            for label, detection in result['bbox']:
                if label in labels:
                    if detection['score'] > 0.35:
                        detected_objects[label].append({'box': detection['box'], 'score': detection['score'], 'saved_image_path': detection['saved_image_path']})
                    object_number[label] += 1
        except Exception as e:
            print(f"Exception: {e}")
    
    return detected_objects, object_number
