from object_detector_tool import Object_Detector_Tool

# Define the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1494_0.png"

# Perform object detection
result = Object_Detector_Tool.execute(image_path, ["baseball", "basket"], False, "base")

# Check if objects were detected successfully
if result is not None:
    for label in ["baseball", "basket"]:
        # Filter the detected objects by specific label
        filtered_results = [entry for entry in result if entry['label'] == label]
        
        # Get the number of detected objects
        objects_count = len(filtered_results)

        # Print the results
        print(f"Number of {label} detected objects: {objects_count}")
    
else:
    print("Failed to detect the specified objects.")
