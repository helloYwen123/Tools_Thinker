<command>from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

def count_shelving_units(image_path):
    detected_objects = Object_Detector_Tool().execute(image=image_path, save_object=False, threshold=0.35, saved_image_path='detected_objects')
    object_labels = [obj['label'] for obj in detected_objects['detected_objects']]
    total_objects = len([obj['label'] for obj in detected_objects['detected_objects']])

    shelving_units = {'counted_objects': 0, 'objects': object_labels}
    for i, label in enumerate(object_labels):
        shelving_units['counted_objects'] += detected_objects['detected_objects'][label]['count'] - total_objects
        shelving_units['objects'].append(object_labels[i])

    return shelving_units

def identify_text(image_path, languages=['en', 'de']):
    text_detection_result = Text_Detector_Tool().execute(image=image_path, languages=languages, detail=0)
    text_blocks = [[item['bbox'], item['text'], item['confidence']] for item in text_detection_result]
    text_blocks.sort(key=lambda x: x[0][1])

    text_blocks_with_confidence = [item for sublist in [text_blocks, [item for i, item in enumerate(text_blocks) if i < sublist[0][0][1]]] for sublist in sublist]
    text_blocks = [[item[0][0], item[0][1], item[1]] for sublist in text_blocks_with_confidence for item in sublist]
    text_blocks = [[item[2]] for item in text_blocks if item[1]]

    return text_blocks

def analyze_space_property(image_path):
    shelving_units = count_shelving_units(image_path)

    object_labels = identify_text(image_path)
    room_size = 100  # Assume a dummy room size for illustration purposes

    final_result = {
        'shelf_units': shelving_units,
        'object_labels': object_labels,
        'total_area': room_size ** 2  # Since it's a 2D space, calculate total area
    }
    return final_result

