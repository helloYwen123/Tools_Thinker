from object_detector.Tool import Object_Detector_Tool

def count_objects_and_save(image_path):
    try:
        with open(image_path, 'rb') as img_file:
            image = img_file.read()
        if len(image) == 0:
            return []
    except TypeError:
        return []

    labels = ['baseball', 'basket']

    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=True)
     
    saved_object_path = f'detected_objects/{image.split('.')[0]}.png'

    return [(f'Detected {label} with coordinates', f[0]['box'], f[0]['score'], f[0]['image_name']) for f in detected_objects]
