from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

def handle_image(image_path, labels, languages, detail):
    try:
        object_labels = object_dct.execute(image=image_path, labels=labels, save_object=True, saved_image_path='objects')
        text_detection_result = text dct.execute(image=image_path, languages=languages)

        objects_detected = object_labels['objects']

        if len(text_detection_result) > 0:
            detected_text = []
            for text_bbox in text_detection_result:
                text = text_detection_result[text_bbox]['Detected text']
                detected_text.append([text_bbox, text, text_detection_result[text_bbox]['score']])

            detected_objects = [{'box': detected_object[0], 'text': detected_text[-1][1], 'score': detected_text[-1][-1] * 0.95} for detected_object in objects_detected]

            return (object_labels, detected_objects, text_detection_result.text_detection_result_text)
        else:
            return object_labels, []

    except Exception as e:
        return object_labels, []
