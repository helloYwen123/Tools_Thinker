import Object_Detector_Tool

def find_objects_in_room():
    # Load image with object detector
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_count = object_detector_tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/8796_0.png", labels=["Bed", "Dresser"], save_object=True, saved_image_path="detected_objects/objects")

    # Extract room features using Text_Detector_Tool
    text_detector_tool = Text_Detector_Tool()
    detected_text_blocks = text_detector_tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/8796_0.png", languages=["en", "de"])

    # Extract room features including dresser and items above/described as "objects"
    if detected_objects:
        room_text_blocks = [x["box"] for x in detected_objects if x.get("score") > 0.5]  # Choose text blocks with confidence score > 0.5
        objects_on_floors = detected_text_blocks[:3]  # First 3 detections are assumed to be the Dresser above and below the bed + items described as "objects" here
    else:
        objects_on_floors = []

    return detected_text_blocks, object_count, objects_on_floors
