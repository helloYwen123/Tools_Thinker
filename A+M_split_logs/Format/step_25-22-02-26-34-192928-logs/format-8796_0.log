from object_detector_tool import Object_Detector_Tool

def count_objects(image_path, labels=None, threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
    object_detector = Object_Detector_Tool()
    detected_objects = object_detector.execute(image=image_path, labels=labels, model_size=model_size)
    object_number = dict() # Initialize object_number with all labels as 0
    for l in detected_objects:
        object_number[l['label']] = object_number.get(l['label'], 0) + 1 # Update object_number
    
    # Filter detected objects to get only those with a score above threshold
    filtered_objects = [{'box': x, 'score': y, 'label': x label, 'saved_image_path': f'detected_objects/{label}.png'} for x, y, label in detected_objects if x['score'] >= threshold]
    
    return (detected_objects, filtered_objects, object_number)

object_detector = Object_Detector_Tool()
detected_objects, filtered_objects, object_number = count_objects("/mnt/data8/liao/wxie/SAT/SAT_images_train/8796_0.png")
filtered_objects = [{"box": [x["box"][0], x["box"][1], x["box"][2], x["box"][3]], "score": x["score"], "label": x["label"]} for x in filtered_objects]
object_number

final_result = []
for label, count in object_number.items():
    final_output = [{"box": x["box"], "score": x["score"], "label": label, "count": count }]
    final_result += final_output

