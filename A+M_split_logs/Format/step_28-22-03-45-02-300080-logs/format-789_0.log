from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool().execute(
    image="/nfs/data8/liao/wxie/SAT/SAT_images_train/789_0.png",
    labels=["baseball", "basket"],
    save_object=True,
    saved_image_path="detected_objects"
)

if not final_result[0].get("baseball", []) or not final_result[0].get("basket", []):
    print("No objects detected in the image.")
else:
    print("\nDetected Objects:")
    for label in final_result[0]:
        if label["score"] > 0.90:
            print(f"{label.get('box')} [{label.get('score', 0.0)}] {label.get('score', 0.0)}")
    print("Object Count:")
    print(final_result[1])

</command>
