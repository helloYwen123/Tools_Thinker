final_result = {}

# Initialize object detector tool
detector_tool = Object_Detector_Tool()

# Execute the object detector tool with given parameters
result = detector_tool.execute(image="1752_0.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

if "baseball" in result[0].keys():  # Check if the detected baseball is present
  detected_objects = result[0]
  if "score" in detected_objects["baseball"][0].keys():  # Check if the score is correctly calculated
    detection_count = detected_objects["baseball"][0]["score"]
    final_result["baseball_count"] = detection_count

# Initialize text detector tool
text_detector_tool = Text_Detector_Tool()

# Execute the text detector tool with given parameters
result = text_detector_tool.execute(image="1752_0.png", languages=["en", "de"])

if result and "boxes" in result:
    detected_text = result["boxes"]
    if detected_text:
      for text in detected_text:
        text_block = text[0]
        final_result["detected_text"] = text_block[0][0]
        
    if "score" in result["boxes"][0][0]:
      final_result["score"] = result["boxes"][0][0]["score"]
