def number_of_beds(image_path="1210_0.png", save_objects=True):

    # Load image and convert to grayscale
    img = Image.open(image_path).convert("L")

    # Get bed object bounding boxes
    bed_detection_results = bed_detector.execute(image_content=img, labels="bed", threshold=0.35)
    beds_count = len(bed_detection_results["bed"]) if len(bed_detection_results["bed"]) >= 1 else 0

    # Convert bounding box data to dictionary
    beds_detection_data = {
        "baseball": bed_detection_results["baseball"],
        "basket": bed_detection_results["basket"]
    }

    # Save detected objects if required
    if save_objects:
        beds_detection_data.update({"beds_saved": [img.crop((bbox[0], bbox[1]), (bbox[2], bbox[3])).save("detected_objects/image_" + str(i) + ".png") for i, bbox in enumerate(beds_detection_data["baseball"]) if i >= 0]}
        beds_detection_data.update({"basket_saved": [img.crop((bbox[0], bbox[1]), (bbox[2], bbox[3])).save("detected_objects/image_" + str(i) + ".png") for i, bbox in enumerate(beds_detection_data["basket"]) if i >= 0]})

    return beds_detection_data

