Here is a simple Python script based on your given tools to count the number of Doorways in the given scene and to visualize the count with a different label (In this case, 'Baseball') and bounding box. This basic implementation is still simple for our current context.

```python
import os
import json
from time import time
from subprocess import called

# Set your path to save the image
save_image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4189_0.png'
image_name = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4189_1.png'

@called(['object_detector_tool', 'object_detector_tool', 'object_detector_tool'])
def object_detector_orbit(tool_args):
    detected_objects = {}
    object_number = {"Baseball": 0}
    
    for label in tool_args['labels']:
        if tool_args['model_size'] == 'base':
            detected_objects[label] = []
            object_number[label] = 0.00
            
        else:
            detected_objects[label] = []
            object_number[label] += 0.001
                
        time.sleep(0.1)
        detected_objects[label].append(tool_args['object_detector_tool'].execute(image=image_name, labels=[label], save_object=True, saved_object_path="detected_objects"))
    
    for label in detected_objects:
        for detection in detected_objects[label]:
            object_number[label] += detection['score']
            
    with open(os.path.join(os.path.dirname(__file__), 'detected_objects.json'), 'w') as f:
        f.write(json.dumps(detected_objects))
        
    f.close()

object_detector_orbit({'model_size': 'base', 'threshold': 0.5, 'labels': ['Baseball'], 'save_object': True, 'saved_image_path': saved_image_path})
# Check the number of Doorways detect in each image
with open(os.path.join(os.path.dirname(__file__), 'detected_objects.json')) as f:
    detected_objects = json.load(f)

for label, detection in detected_objects.items():
    baseball_objects = [det for det in detection if 'Baseball' in det['bbox']]
    
    if baseball_objects:
        print(f'Number of {label} doorway objects: {object_number[label]}')
    else:
        print(f'No {label} doorway objects detected')
