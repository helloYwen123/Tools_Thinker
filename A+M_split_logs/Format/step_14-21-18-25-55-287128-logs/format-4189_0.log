from module_object_detector_tool import *  # Import Object_Detector_Tool class
from module_text_detector_tool import *  # Import Text_Detector_Tool class

def detect_objects(image_path, labels=("baseball", "basket"), language="en", detail=0):
    try:
        res = object_detector_tool.execute(image=image_path, labels=labels, languages=language, detail=detail)
        if len(res) == 0:
            return "An error occurred during text detection."
        else:
            return res
    except Exception as e:
        return str(e)

def detect_text(image_path, languages=["en", "de"], detail=0):
    try:
        res = text_detector_tool.execute(image=image_path, languages=languages, detail=detail)
        if len(res) == 0:
            return "An error occurred during text detection."
        else:
            return res
    except Exception as e:
        return str(e)

def count_objects(image_path):
    detected_objects, object_count = [], []
    labels_to_count = set([l.split("(")[0].strip() for l in text_detector_tool.execute(image=image_path, languages=["en"], detail=0)])
    if not labels_to_count:
        return f"No object detected. Image: {image_path}"
    for l in labels_to_count:
        res = [1 if x["recognized_text"] == l else 0 for x in detected_objects if x["recognized_text"] == l]
        object_count.append(sum(res))
    object_count = {"baseball": sum(x if x else 0 for x in object_count)}, {"basket": sum(x if x else 0 for x in object_count)}
    object_count_output = ["{'baseball': {}}", "'basket': {0}"]
    object_count_output = ['\n'.join(object_count_output)]
    return object_count_output[0][:-1] if len(object_count_output) else 0

# Example usage with image 'image_path'/label 'basketball'
final_result = detect_objects(image_path="Path_to_your_image.jpg", labels=("basketball",), languages="en")
print(final_result)

final_result = detect_text(image_path="Path_to_your_image.jpg", languages=["en", "de"])
print(final_result)
