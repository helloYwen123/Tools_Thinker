<command>
from object_detector_tool import Object_Detector_Tool

final_result = []

if "/nfs/data8/liao/wxie/SAT/SAT_images_train/536_0.png" in object_detector_tool.input_types["image"]:
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/536_0.png"
    labels = ["baseball", "basket"]
    save_object = True
    saved_image_path = "detected_objects"
    object_number = {"baseball": 1, "basket": 2}

    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    if detected_objects and "baseball" in labels and "basket" in labels:
        total = len(labels)
        detected_objects = [{"labels": labels, "count": total}]

        # Crop and save detected objects
        for label in labels:
            if label in ["baseball", "basket"]:
                for detector_entry in detected_objects:
                    if detector_entry["labels"].get(label) is None:
                        break
                    if detector_entry["labels"].get(label):
                        cropped_image = detector_entry["labels"].get(label).detected_object.crop()
                        cropped_image.save(f"{saved_image_path}/{label}_{object_number[label]}.png")
                        object_number[label] += 1

        print("Detected objects (in {})".format(detected_objects[:2]))
        print("Total objects found: {}".format(total))
    else:
        print("Text detection failed.")
</command>
