def count_object_images(path_to_image, labels, save_object=True, languages=None, detail=None):
    result = []
    for label in labels:
        if label in ["basket", "baseball"]:
            output = find_labels(path_to_image, label, languages, detail)
            if output:
                result.append({
                    "labels": [label],
                    "count": output.count()
                })
        else:
            print(f"No object found for label {label}")
    # Check if 'save_object' is true, then save the detected objects.
    if save_object:
        from module import object_detector
        detected_objects_for_language, object_number = object_detector.execute(image=path_to_image, save_object=True)
        if detected_objects_for_language:
            for detected_objects in detected_objects_for_language:
                if 'baseball' in str(detected_objects.keys()):
                    detected_objects.pop('baseball')
                if 'basket' in str(detected_objects.keys()):
                    detected_objects.pop('basket')
                for detected_object in detected_objects:
                    detected_object.pop('saved_object')
        return final_result
    else:
        return final_result
