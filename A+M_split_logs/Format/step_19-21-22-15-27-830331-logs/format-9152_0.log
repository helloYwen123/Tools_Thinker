from torch.utils.data import DataLoader
import torch
from object_detector_tool import Object_Detector_Tool

def count_shelving_units(image_path, labels=['shed'],
                         save_object=True, saved_image_path=None):
    """Detect and count the number of shelves in a scene."""
    object_detector = Object_Detector_Tool()
    detected_objects = object_detector.execute(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    object_number = {obj['labels'][0]: obj['count'] for obj in detected_objects.get('num', 0)}
    
    return object_number

def detect_text(image_path, languages=['en', 'de'],
                detail=0):
    """Detect text in an image using EasyOCR."""
    text_detector = Text_Detector_Tool()
    text_results = text_detector.execute(image_path, filters=languages, detail=detail)

    return text_results

