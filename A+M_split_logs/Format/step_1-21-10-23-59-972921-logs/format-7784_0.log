from object_detector_tool import *
from text_detector_tool import *

object_number = {'baseball': 0}

image_path = 'path/to/image'
labels = set(['baseball', 'basket'])
threshold = 0.35
model_size = 'tiny'
save_object = False

detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

if detected_objects:
    result = detected_objects
else:
    result = []

for detected_object in result:
    box = (detected_object['bbox']['left'], detected_object['bbox']['top'], detected_object['bbox']['right'], detected_object['bbox']['bottom'])
    text = detected_object['bbox']['text']
    score = detected_object['bbox']['score']
    result.append([box, text, score])

generated_lines = []
for detected_object in result:
    generated_lines.append(f"{detected_object['bbox']['left']}, {detected_object['bbox']['top']}, {detected_object['bbox']['right']}, {detected_object['bbox']['bottom']}")
text = ' '.join(generated_lines[::-1]) # Reverse the list of bounding box coordinates to get strings
translated_text = text_to_english(text, languages=[u'en', u'de'])
translated_result = [{"bbox": detected_object['bbox'], "text": translated_text, "score": detected_object['bbox']['score']}]

detected_objects = [translated_result]
object_number = {'baseball': len(detected_objects[0]), 'basket': 0}
