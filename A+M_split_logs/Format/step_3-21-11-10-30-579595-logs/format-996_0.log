# Step 1: Check the available tools
tools_metadata = {
    "Object_Detector_Tool": {"tool_class_name": "Object_Detector_Tool", "tool_description": "A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding."},
    "Text_Detector_Tool": {"tool_class_name": "Text_Detector_Tool", "tool_description": "A tool that detects text in an image using EasyOCR."}
}

# Step 2: Determine the tool to use based on available tools
for tool in tools_metadata.values():
    if tool["tool_class_name"] == "Object_Detector_Tool":
        tool_module_name = tool["tool_module_name"]
        tool_class_name = tool["tool_class_name"]
        available_options = tool.get("tools_metadata", {}).keys()
        suitable_tool = [opt for opt in available_options if opt.startswith(tool_class_name + "_Tool")]
        tool_module_name = suitable_tool[0] if suitable_tool else tool_module_name
        break
else:
    tool_module_name = None
    tool_class_name = None

# Step 3: Use the appropriate tool
if tool_module_name:
    from_module = tool_module_name
    from_name = tool_class_name
    object_detector_tool = getattr(Object_Detector_Tool, from_name)()
else:
    object_detector_tool = None

# Step 4: Execute the detection command
if object_detector_tool:
    detected_objects = object_detector_tool.execute(
        image="/nfs/data8/liao wxie/SAT/SAT_images_train/996_0.png",
        labels=["basball", "basket"],
        save_object=True,
        saved_image_path="detected_objects"
    )

    # Step: Assign the final answer (as a string) to a variable named final_result
    final_result = detected_objects.get("detected_objects", {}) or 1
    detailed_results = detected_objects.get("object_number", {})
    for label, obj in detailed_results.items():
        print(f"{label}: {''.join(str(box) for box in obj)} [{obj['score']:.1f}]")
else:
    print("Object detection failed or no available tool available.")

