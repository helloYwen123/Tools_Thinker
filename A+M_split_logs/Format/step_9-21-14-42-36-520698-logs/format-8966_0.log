from object_detector_tool import Object_Detector_Tool

class Object_Detector_Tool:
    model_size = "tiny"  # model size
    threshold = 0.35  # threshold for detection
    save_object = False  # save object images

    def execute(self, image, labels=[], save_object=True, saved_image_path="detected_objects"):

        # Detect objects in the image
        object_detector_tool = Object_Detector_Tool()
        detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

        # Process detected objects
        processed_objects = {
            label: [],
            number: 0,
        }
        for object_detection in detected_objects["detected_objects"]:
            processed_objects[object_detection["labels"]].append(
                {"box": [object_detection["bbox"][0], object_detection["bbox"][1], object_detection["bbox"][2], object_detection["bbox"][3]],
                 "score": object_detection["score"],
                 "saved_image_path": object_detection["saved_image_path"]})
            processed_objects["number"] += 1
        
        # Return processed objects and object number
        return [[process_object] for process_object in processed_objects.values()], processed_objects["number"]

    def save_json(self, detected_objects, object_number):
        """
        Save detected objects to a json file
        :param detected_objects: A dictionary mapping each detected object to the list of detection results.
        """
        file_path = f"{detected_objects['folder_name']}/detected_objects.json"
        if self.save_object:
            detected_objects["detected_objects"].to_json(file_path, orient="records")  

    def execute_single_label(self, image, labels, save_object):
        """
        Execute detection for a single detected object label
        :param image: The image to detect in.
        :param labels: A list of detected labels of interest.
        :return: A dictionary mapping each detected label to the list of detection results.
        """
        object_number = {}
        for label in labels:
            result = self.execute(image, save_object = save_object, labels=[label], save_object=save_object)
            object_number[label] = result[1]
            self.save_json(result[0], object_number)
        return object_number

