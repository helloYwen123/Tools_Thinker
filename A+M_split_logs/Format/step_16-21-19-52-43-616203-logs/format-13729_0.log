from object_detector_tool import Object_Detector_Tool

final_result = []

# Example image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13729_0.png"

# Function to execute the object detector tool
def execute(image, labels=("baseball", "basket"), saved_object=False, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=saved_object, saved_image_path=saved_image_path)
    return detected_objects, object_number

# Execute the tool to detect objects
detected_objects, object_number = execute(image_path)

# Assuming detected_objects looks similar to the example expected (with bounding box, score, and saved_image_path), we can use this as an example for how we might access the data
for detected_object in detected_objects:
    for lb, obj in detected_object.items():
        final_result.append({"label": lb, "object_num": len(detected_object[lb])})

# Assuming "lb" represents the label for each detected box
for found_label, count in object_number.items():
    final_result.append({"label": found_label, "count": count})

print(final_result)
