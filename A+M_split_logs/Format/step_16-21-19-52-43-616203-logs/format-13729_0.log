from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

final_result = []

# Detect objects in the scene
object_classifier = Object_Detector_Tool()
object_classifier.execute(image_path="path/to/scene_image.png", labels=["pillow", "sofa", "chair"], save_object=True, saved_image_path="detected_objects")

# Process the detected objects
for label_ in object_classifier["detected_objects"]:
    result = []
    if label_["saved_image_path"] is not None:
        detected_image_path = label_["saved_image_path"].split("\\")[-1]
        processed_image = object_classifier.model.load_image(detected_image_path)
        detected_image = object_detector_tool.detect_image(processed_image, use_objects=True, language="en", details=True)
        result.append([detected_image, label_["score"], "detected_object"])
        object_classifier["detected_objects"].remove(label_)

    # Process the detected objects
    text_classifier = Text_Detector_Tool()
    text_classifier.execute(image_path="detected_objects/detected_object.png", languages=["en"])
    detected_text = text_classifier["result"]
    text_classifier = Text_Detector_Tool()
    text_classifier.execute(image_path="detected_objects/detected_object.png", languages=["zh"])
    detected_text_zh = text_classifier["result"]

    if detected_text and detected_text_zh:
        final_result.append([detected_text[:-1], detected_text_zh[0].replace(" ", "").strip(), len(detected_text[:-1])])
    else:
        final_result.append(["", "", 0])

print("Text detected: ", final_result)
