# Set path to the image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5926_0.png"

# Set labels to detect
labels = ["baseball", "basket"]

# Set the confidence threshold
confidence_threshold = 0.35

# Set the model size to 'tiny'
model_size = "tiny"

# Set the path to save detected objects
saved_object_path = "/results/objects"

# Execute the object detection tool
