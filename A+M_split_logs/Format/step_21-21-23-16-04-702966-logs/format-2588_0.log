from object_detector_tool import Object_Detector_Tool

def count_chairs(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    object_detector = Object_Detector_Tool()
    object_detector.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    detected_objects = object_detector.output[0]
    chair_count = len(detected_objects)
    return chair_count

