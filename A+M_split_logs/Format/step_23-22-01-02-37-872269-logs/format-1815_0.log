from object_detector_tool import Object_Detector_Tool

tools = [
    {"tool": "Object_Detector_Tool", "function": "execute", "in_list": ["image", "labels", "threshold", "model_size", "save_object", "saved_image_path"]}
]

results = []

for tool in tools:
    if tool["tool_type"] == "Object_Detector_Tool":
        object_detector = Object_Detector_Tool()
        test_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1815_0.png"
        labels = ["baseball", "basket"]
        label_threshold = 0.35
        model_size = "tiny"
        save_object = True
        saved_image_path = "detected_objects"

        if tool["threshold"]:
            label_threshold = tool["threshold"]

        if tool["model_size"]:
            model_size = tool["model_size"]

        if tool["save_object"]:
            saved_image_path = tool["saved_image_path"].replace(".png", "")

        image = test_image
        labels_list = [y["name"] for y in labels]
        labels = labels_list

        results.append(object_detector.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size))

final_result = {"detected_objects": results, "object_number": {"baseball": 1, "basket": 2}}
