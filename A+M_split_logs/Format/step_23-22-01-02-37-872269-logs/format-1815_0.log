from Object_Detector_Tool import Object_Detector_Tool

def check_objects(images_path, labels, save_object=True, saved_image_path="detected_objects"):
    detected_objects, object_number = None, None
    try:
        # Load the image and its bounding boxes
        image, boxes, objects = image_bbox_reader.process_image(images_path)

        # Detect objects and save as images if required
        if save_object:
            object_number = object_number + 1
            detected_objects = np.empty((object_number, len(images_path), len(labels), len(boxes)), dtype=object_number)
            for label in labels:
                box = boxes[objects == label]
                if len(box) == 0:
                    continue
                saved_boxes = np.stack([bbox[0] for _, bbox in box.tolist()], axis=-1)
                if object_number % 2 == 0:
                    detected_objects[object_number // 2][objects == label] = [box, label, saved_boxes]
                else:
                    detected_objects[object_number // 2][objects == label] = [saved_boxes, label]
    
            # Save detected objects as images and return
            path_to_save_image = os.path.join(saved_image_path, f"detected_objects/{label}.png")
            cv2.imwrite(path_to_save_image, detected_objects[objects == label][0])
            print(f"Saved detected objects as {label}.png.")
        else:
            detected_objects = np.empty((len(images_path), len(labels)), dtype=object_number), None
            if object_number is not None:
                for label in labels:
                    box = boxes[objects == label]
                    detected_objects = np.append(detected_objects, box, axis=2) 

                    detected_objects[objects == label].astype(np.float32)  # Convert to float for compatibility

        return detected_objects, object_number
    except Exception as e:
        print(f"Error processing image: {e}")
        return None, None 

