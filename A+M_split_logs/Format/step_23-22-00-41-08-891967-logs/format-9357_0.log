from object_detector_tool import Object_Detector_Tool

class App:

    def execute(self, input_image, labels, threshold=0.35, model_size='tiny', save_object=False, saved_image_path='detected_objects'):
        import_name = 'Object_Detector_Tool'
        tool_module_name = "object_detector_tool"

        image = input_image
        labels_list = labels

        # Detect objects in the image
        object_detector = Object_Detector_Tool()
        detected_objects, object_number = object_detector.execute(image=image, labels=labels_list, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

        final_result = {"detected_objects": detected_objects, "object_number": object_number}
        return final_result

    def start_application(self):
        img_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/9357_0.png'
        labels = {'baseball': 1, 'basket': 1, 'football': 0, 'baseball': 1, 'basket': 1}

        # Run the detection tool
        result = self.execute(img_path, labels, threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects')

        print("Detected objects:")
        for label in result["detected_objects"]:
            print(f"{label}: {result['detected_objects'][label]}")

        print("Number of detected objects: ", result["object_number"])
