import object_detector_tool

def count_counter_tops(image_path):
    # Replace 'image_path' with the actual path to the image
    object_count = object_detector_tool.execute(image=image_path, labels=['CounterTop'], threshold=0.35, model_size='base', save_object=True, saved_image_path='')
    
    # Print and return the results
    print("Number of Counter Tops detected:", object_count['object_number'])
    print("Detected Countertops (labels):", object_count['detected_objects'])

