def find_tv_stands_count():
    tv_stand, num_tv_stands = count_tv_stands()
    total_tv_stands = total_tv_stands if total_tv_stands else {}

    result = []
    for det in tv_stand:
        caption = det[2].split('.')[-1]

        if caption in total_tv_stands:
            result.append(det)

    return (result, total_tv_stands['TV Stand'])

final_result, total_tv_stands = detect_text_caption()

result = find_tv_stands_count()
print(result)
