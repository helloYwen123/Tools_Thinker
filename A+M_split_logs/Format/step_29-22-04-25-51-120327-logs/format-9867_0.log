import Object_Detector_Tool

def analyze_image(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    try:
        detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    except ValueError as e:
        print(f"An error occurred while executing the detection tool: {e}")
        return []

    return detected_objects
