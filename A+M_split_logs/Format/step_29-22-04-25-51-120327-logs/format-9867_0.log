import text_detector

def detect_text_caption():
    text_detector_tool = text_detector.Text_Detector_Tool()
    result = text_detector_tool.execute(image='path_to_dreamy_home', languages=['en', 'de'], detail=0)
    final_result = []

    for block in result:
        if 'Detected text' in block[2]:
            final_result.append(block)

    return (final_result, result)
</command>

