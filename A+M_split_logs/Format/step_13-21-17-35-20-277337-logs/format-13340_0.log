from object_detector_tool import Object_Detector_Tool

def count_tv_stands(image_path, labels=["tv_stand"], save_object=True, saved_image_path="detected_objects"):
    """
    Counts the number of TV stands in an image and saves the detected results as images.

    Parameters:
    image_path (str): The path to the image file.
    labels (list of str): A list of labels in the form ['tv_stand', 'table', ...].
    save_object (bool): Whether to save the detected objects as images.
    saved_image_path (str, optional): The path to save the detected object images.
    """
    assert labels, "Labels must be provided when saving object images."
    object_detector = Object_Detector_Tool()
    detected_objects = object_detector.execute(image=image_path, labels=labels, threshold=0.35, save_object=save_object, saved_image_path=saved_image_path)
    
    if save_object:
        detected_objects = [obj for obj in detected_objects if obj['score'] > 0.3, f'&{obj["label"]}']
        return detected_objects, len(labels) - len(set(labels)) + 1

# Usage
final_result = count_tv_stands("path/to/image.jpg", ["tv_stand"])
print(final_result)

