from object_detector_tool import Object_Detector_Tool

def count_tv_stands():
    detection_result = {"baseball": [], "basket": []}
    total_count = {"baseball": 0, "basket": 0}

    # Detect text in the image
    text_detector_tool = Text_Detector_Tool()
    if "Detected text" in text_detector_tool.execute(image=image_path, languages=['en', 'de']) or "Detected text" in text_detector_tool.execute(image, languages=['en', 'de']):
        detection_result = text_detector_tool.execute(image_path)
        total_count = {}  # Reset the total count for each detected label
    
    # Count the number of TV stands
    tv_stand_count = {"baseball": 0, "basket": 0}
    for label in detection_result:
        if label == "baseball":
            # Check if the detection is valid (ensure a bbox and score)
            if detection_result[label][0] is not None and detection_result[label][2] < 0.8:
                tv_stand_count["baseball"] += 1
        elif label == "basket":
            # Check if the detection is valid (ensure a bbox and score)
            if detection_result[label][0] is not None and detection_result[label][2] < 0.8:
                tv_stand_count["basket"] += 1
    
    return {"total_count": total_count, "tv_stand_count": tv_stand_count}

