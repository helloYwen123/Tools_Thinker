from object_detector import Object_Detector_Tool

class Image_Analysis_Tool:
    def __init__(self):
        self.object_detector_tool = Object_Detector_Tool()

    def analyze_image(self, image_path, labels, save_object, saved_image_path='detected_objects'):
        detected_objects, object_number = self.object_detector_tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path=saved_image_path)
        return detected_objects, object_number

final_result = Image_Analysis_Tool().analyze_image("/nfs/data8/liao/wxie/SAT/SAT_images_train/14450_0.png", ["baseball", "basket"], True, "detected_objects")
print(final_result)
</command>
