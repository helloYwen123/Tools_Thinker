# Step 3: Extract object count and saved object images
object_labels = {label[0]: label[1] for label in object_results[0].values()}  # Convert to dictionary for output

if object_labels:
    objects_num = {label[0]: len(object_results[0].keys()) for label in object_labels}
    final_result = {"detected_objects": object_results, "object_number": objects_num}
else:
    final_result = {"error": "No text detected."}

print(f"Detected objects: {final_result['detected_objects']}\nObject count: {final_result['object_number']}")
