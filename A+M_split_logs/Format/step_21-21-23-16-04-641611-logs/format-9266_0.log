from object_detector import Object_Detector_Tool

def detect_objects(image_path, object_labels, labels=None, model_size='tiny', save_object=False, saved_image_path='detected_objects'):
    if save_object:
        return Object_Detector_Tool.execute(image_path=image_path, labels=labels, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    else:
        return Object_Detector_Tool.execute(image=image_path, labels=labels)

# Example usage
