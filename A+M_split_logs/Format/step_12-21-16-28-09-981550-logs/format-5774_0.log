# Set the confidence threshold
threshold = 0.35

# Set the size of the model to use, in this case, 'tiny'.
model_size = "small"

# Set the path to save the detected object images.
saved_image_path = "/nfs/data8/liao/wxie/SAT-detected_objects/"

# Set whether to save the detected objects as images.
save_object = True

# Execute the tool with the image and detect objects.
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=["baseball", "basket"], threshold=threshold, model_size=model_size, save_object=False, saved_image_path=saved_image_path)

# Create a dictionary for the detected objects.
detected_objects_dict = {}
for detected_objects_entry in detected_objects:
    box = detected_objects_entry['box']
    label = detected_objects_entry['label']
    score = detected_objects_entry['score']
    detected_objects = detected_objects_dict.get(label, [])
    if detected_objects:
        detected_objects.append({
            "box": box,
            "score": score
        })
    else:
        detected_objects.append({
            "box": [box[0], box[1], box[2], box[3]],
            "score": score
        })

# Create a dictionary for object number.
object_number_dict = {}
for key, value in object_number.items():
    object_number_dict[key] = value

# Create a dictionary for detected information.
detected_info = {
    "detected_objects": detected_objects_dict,
    "object_number": object_number_dict
}

# Convert the detected objects dictionary to a JSON string.
json_string = json.dumps(detected_info)

# Determine how many objects are detected in the image.
total_objects_detected = len(detected_objects)

final_result = {
    "Doorways": 0,
    "Objects_detected": total_objects_detected
}

# Validate the result.
if final_result["Objects_detected"] == total_objects_detected:
    print(f"The image has {total_objects_detected} objects detected.")
else:
    print(f"The image has {total_objects_detected} objects detected.")

