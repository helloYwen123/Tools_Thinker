# Code for image object detection

```python
from object_detector_tool import object_detector_tool

def object_detector_tool(image_name, labels, threshold, model_size, save_object):
    object_numbers = {}
    detected_objects = {}

    # Load object labels and run detection
    label_list, num_objects = object_detector_tool.execute(
        labels=labels, image=image_name, model_size=model_size, threshold=threshold, save_object=save_object
    )

    # Count objects in detected objects
    for label_list in detected_objects.values():
        # Calculate object count for each label
        object_numbers[label_list[0]] = object_numbers.get(label_list[0], 0) + 1

    return object_numbers, detected_objects

# Example usage
image_name = "/nfs/data8/liao/wxie/SAT/SAT_images_train/47_0.png"
labels = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
save_object = False
object_numbers, detected_objects = object_detector_tool(image_name, labels, threshold, model_size, save_object)
final_result = [
    "Number of detected objects in 'baseball':",
    "{}".format(object_numbers.get("baseball", 0)),
    "Basket ball detected",
    "Total number of detected objects: {}".format(len(detected_objects))
]

# The object_detector_tool function is used here
