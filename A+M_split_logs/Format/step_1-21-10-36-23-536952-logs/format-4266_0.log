from object_detector_tool import Object_Detector_Tool

def detect_shelves():
    # Extract detection data
    object_labels, number_of_objects = get_object_detection_results(image_image, labels=["shelf"], save_object=True)

    # Calculate shelf counting
    total_shelves = len(number_of_objects)

    # Return results
    return total_shelves

def get_object_detection_results(image, language="no_lang", languages=["no_lang"], detail=0):
    object_detector = Object_Detector_Tool()
    return object_detector.execute(image=image, languages=languages, language_codes=language, detail=detail)

def detect_shelving_units(image_path):
    # Load image
    image = Image.open(image_path)
    
    # Detect shelves
    shelf_count = detect_shelves()

    # Determine number of shelves
    return shelf_count
