from object_detector_tool import Object_Detector_Tool, text_detector_tool

class ImageDetecting:
    def detect(self, image_path):
        try:
            image_data = Image.open(image_path)
            labels = ["baseball", "basket"]

            for label in labels:
                detected_objects, object_number = self.execute(image=image_data, labels=[label], save_object=True)

            # Determine the number of detected objects
            detected_objects_count = object_number.pop(label, 0)

            return (detected_objects, object_number, (1.0, detected_objects_count) if not object_number else (0.0, detected_objects_count))

        except Exception as e:
            print(f"An error occurred: {str(e)}")
            return ([], {}, 0)

