from object_detector_tool import Object_Detector_Tool

def count_windows(image_path=None, labels=None, save_object=False, saved_image_path=None):
    detected_objects = {}
    object_number = {}
    
    if image_path is not None:
        image = Image.open(image_path)
    
    object_detector_tool = Object_Detector_Tool()
    
    detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    return detected_objects, object_number

final_result = count_windows(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/6083_0.png", labels=["windows"], save_object=True, saved_image_path="/Users/user/Desktop/window_output.png")
