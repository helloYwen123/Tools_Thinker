import object_detector_tool
import text_detector_tool
import os

# Image path
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/11552_0.png'

# Call the object_detector tool to identify objects
object_detector_tool = object_detector_tool.Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image=image_path)

# If there are detected objects, save them
if detected_objects:
    saved_image_path = object_detector_tool.save_object(detected_objects)
    image_name = os.path.basename(image_path)
    # Check if 'detect_objects' has been toggled
    has_save = detected_objects[0]['detect_objects'][0].get('save_object', False)

    if has_save:
