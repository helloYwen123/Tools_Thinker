<command>
from object_detector import Object_Detector_Tool

def count_dressers(image_path):
    object_detector = Object_Detector_Tool()
    detected_objects, object_number = object_detector.execute(image=image_path, labels=['Dresser'], save_object=True, saved_image_path="detected_objects_")

    if detected_objects:
        return detected_objects, object_number
    else:
        return [], None

final_result = count_dressers("/nfs/data8/liao/wxie/SAT/SAT_images_train/6114_0.png")
final_result[0].items()
</command>
