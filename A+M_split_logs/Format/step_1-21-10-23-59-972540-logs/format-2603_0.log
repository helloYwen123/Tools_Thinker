```python
import object_detector_tool

# Example usage (use Text_Detector_Tool for example, replace 'path/to/image' and 'en' for English and German detection languages)
text_result = text_detector_tool.execute(image='path/to/image', languages=['en'], detail=0)

if len(text_result) > 0:
    # Find text blocks by checking the confidence score
    text_blocks = [(txt[1], txt[3], txt[4], txt[2]) for txt in text_result if txt[4] > 0.5]

    if len(text_blocks) > 0:
        # Calculate the number of detected Paintings
        detected_paintings = [txt[1]['Detected text'][0] for txt in text_blocks if txt[1]['detected_text'] == 'baseball'][0]
        all_paintings = [txt[3]['detected text'] for txt in text_blocks]
        found_paintings = [detected_paintings] + all_paintings

        print(f"Number of detected Paintings: {len(set(found_paintings))}")
        print(f"Detected Paintings: {set(found_paintings)}")

    else:
        print("No detected Paintings found")
else:
    print("Failed to detect text in image.")
```

Note: The provided data path 'path/to/image' corresponds to the image file that needs to be analyzed and detected. It may be different from your actual image path.
