from object_detector_tool import Object_Detector_Tool

final_result = []

def execute(image):
    try:
        object_detector = Object_Detector_Tool()
        detected_objects, object_number = object_detector.execute(image, labels, save_object, saved_image_path)
        return object_number
    except Exception as e:
        return (None, 0.0)

# Assuming the paths are as follows
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3506_0.png"  # modified to suit different image paths
labels = ["baseball", "basket"]  # modified to suit different labels
save_object = True

object_number = execute(image_path)
print(f"Object Number: {object_number}")
for label in labels:
    detected_objects_per_label = detected_objects.get(label, [])
    if detected_objects_per_label:
        object_number_per_label = len(detected_objects_per_label)
        final_result.append((len(detected_objects_per_label), label, object_number_per_label))
    else:
        final_result.append((0, label, 0))
    print(f"Detected Image: {label} - Result: {object_number_per_label}")

final_result
