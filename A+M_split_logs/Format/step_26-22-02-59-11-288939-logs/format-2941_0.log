from Object_Detector_Tool import Object_Detector_Tool

# Command to execute object_detector_tool
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image="2941_0.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Extracting number of detected objects for each label
number_of_objects_each_label = {}
for label in detected_objects["baseball"]:
    number_of_objects_each_label[label["baseball"][0]["box"][0]["x1"]] = len(label["baseball"])

for label in detected_objects["basket"]:
    number_of_objects_each_label[label["basket"][0]["box"][0]["x1"]] = len(label["basket"])

# Print the extracted number of detected objects for each label
print(f"Number of detected objects for each label: {number_of_objects_each_label}")

detected_objects
