from Object_Detector_Tool import Object_Detector_Tool

def count_fridges(image_path):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_count = object_detector_tool.execute(image=image_path, labels=['Fridge'], save_object=True)
    return detected_objects, object_count

final_result = count_fridges('/path/to/image.png')
print("Number of Fridges detected:", final_result[0]['baseball'])

