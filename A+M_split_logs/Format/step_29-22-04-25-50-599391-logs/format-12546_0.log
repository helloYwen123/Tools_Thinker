from object_detector_tool import Object_Detector_Tool

final_result = {"window_count": 0}

# Import necessary classes
from object_detector_tool import Object_Detector_Tool

# Function to count objects in the image
def count_objects(image_path):
    label_list = ["baseball"]
    model_size = "tiny"
    save_object = True
    saved_image_path = "detected_objects" 

    # Create object detector
    otd_tool = Object_Detector_Tool()
    
    # Execute object detection
    detected_objects, object_number = otd_tool.execute(image=image_path, labels=label_list, save_object=True, saved_image_path=saved_image_path)
    
    # Count the number of objects
    window_number = 0 if len(detected_objects) == 0 else detected_objects[0]["baseball"][1]["score"]
    final_result["window_count"] = window_number

    return final_result

# Call the function
final_result = count_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/12546_0.png")

print("Number of Windows detected:", final_result["window_count"])
</command>
