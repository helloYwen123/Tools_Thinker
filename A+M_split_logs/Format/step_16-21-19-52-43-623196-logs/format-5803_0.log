from object_detector_tool import object_detector_tool

def count_bedrooms():
    # Assume the path to the image file
    image_path = '/path/to/image.jpg'

    # Set the default count to 1
    count, detected_objects = object_detector_tool.execute(image=image_path)

    # Check if objects were detected
    if count == 1:
        object_number = count
    else:
        object_number = None

    return object_number

final_result = count_bedrooms()
print(final_result)
