def detect_objects(tool_module, image_file, labels=None, threshold=None, model_size='tiny', save_object=False, saved_image_path=None):
    tool = getattr(tool_module, tool_module + '_' + tool_class_name)
    results = tool(image=image_file, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    detected_objects = {}
    object_number = {}

    for class_name, detection_results in results.items():
        if class_name in labels:
            detected_objects[class_name] = []
            object_number[class_name] = len(detection_results)
        else:
            detected_objects[class_name] = [{'box': (0, 0, 0, 0), 'score': 0.0, 'saved_image_path': ''}]
            object_number[class_name] = 0

    return detected_objects, object_number

final_result = detect_objects(Object_Detector_Tool, "/nfs/data8/liao/wxie/SAT/SAT_images_train/11003_0.png", ("baseball", "basket"))
print(final_result)
</command>
