# Initialize the object_detector_tool
object_detector_tool = Object_Detector_Tool()

# Define the question
question = """
How many Doorways are visible in the scene? 
- 3
- 1
- 2
- 0
- 4
"""

# Run the demo command with the question
result = object_detector_tool.execute(image="path/to/image.png",
                                      labels=["Door"],
                                      save_object=True,
                                      saved_image_path="detected_objects")

# Get the total count of objects
total_objects = result["object_number"]

# Determine the total number of Doorways
total_doors = sum((2, 1, 0, 4))  # (3, 1, 2, 0 or Doorways in Question) * (Door, Doorway, Door, Doorway or Doors)
final_result = {
    "Final result": f"The total number of Doorways is {total_doors}.",
    "Conclusion": "Based on the provided labels and image analysis, there are {total_objects} objects in the scene, where {total_doors} are Doorways. The rest may include additional items. If `save_object` is enabled, the detected objects will be saved as images.",
    "Example usage": "To save detected objects, set `save_object=True` and specify the image path."
}
