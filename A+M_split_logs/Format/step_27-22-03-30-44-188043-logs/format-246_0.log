from Object_Detector_Tool import Object_Detector_Tool

# Set the image file and labels
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/246_0.png"
labels = ['baseball', 'basket']

# Create the tool object
object_detection_tool = Object_Detector_Tool()

# Execute the tool
detected_objects, object_number = object_detection_tool.execute(image=image_path, labels=labels)

# Process the detected objects
final_result = []
if len(detected_objects) > 0:
    detected_objects = detected_objects['baseball']
    for i, object in enumerate(detected_objects):
        bounding_box = object['bbox']
        score = object['score']
        image_path = object['saved_object'][0]
        label_id = detected_objects[i]['ID']
        final_result.append({'label': labels[label_id], 'bbox': bounding_box, 'score': score, 'image_path': image_path})
else:
    final_result.append('No results found for text detection. Check the image and try again.')

# Extract the object numbers from the detected objects dictionary
object_number = {label: len(detected_objects) for label in labels}

final_result = [{'labels': label, 'number': number} for (label, number) in object_number.items()]
final_result.append({
    'label': 'object',
    'number': len(detected_objects)
})

final_result
