def count_windows(image_path):
    from object_detector import Object_Detector_Tool

    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['window'], save_object=False)
    
    final_result = {}
    for label in detected_objects:
        if label['label'] == 'window':
            num_objects = object_number[label['label']]
            final_result[label['label']] = num_objects
    
    return final_result

final_result = count_windows('/nfs/data8/liao/wxie/SAT/SAT_images_train/14500_0.png')
print(final_result)
</command>
