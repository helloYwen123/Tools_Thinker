from object_detector import Object_Detector_Tool

def count_sofas():
    objects, object_number = Object_Detector_Tool().execute(image='path/to/scene', labels=['sofa'], save_object=True, saved_image_path='detected_objects')
    
    sofa_count = {label: sum(1 for _, score, _, text in objects if label == label) for label, _, _, text in objects}
    
    return sofa_count
</command>
