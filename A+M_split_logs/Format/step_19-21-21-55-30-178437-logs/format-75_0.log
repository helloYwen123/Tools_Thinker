from object_detector_tool import Object_Detector_Tool

# Generate the Python program
def detect_objects_in_image(image_path, labels, threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    result = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)
    
    # Convert the detected results dictionary into a tuple
    converted_result = (
        {
            det_label: [
                {
                    "box": det_bbox,
                    "score": det_score,
                    "saved_image_path": det_img_path or None
                }
                for det_bbox, det_score in det_items.items()
                if det_score > det_threshold
            ]
            for det_label in result
        }
        if result
        else []
    )

    # Convert the language code to the corresponding language code for easy processing
    language_code = labels[0] if isinstance(labels, list) else labels
    language_code = {"ch_sim": "Simplified Chinese", "en": "English", "de": "German", "ja": "Japanese"}

    # Return the results as a string containing the det_label count and the converted_result
    return (
        "det_label count: "
        + str(len(result)) if len(result) else "0"
        + "\n"
        "converted_result:\n"
        + str(converted_result)
        + "\n"
    )

final_result = detect_objects_in_image("/nfs/data8/liao/wxie/SAT/SAT_images_train/75_0.png", ['baseball', 'basket'], threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects")  # Run the command to process the image
final_result
