from object_detector import Object_Detector_Tool

def count_objects(image_path, detect_threshold=0.35, model_size='tiny', save_objects=False, saved_image_path="detected_objects"):
    with open(image_path) as img_file:
        image_data = img_file.read()
    object_detector_tool = Object_Detector_Tool()
    detected_objects, total_objects = object_detector_tool.execute(image=image_data,
                                labels=[detect_object], detect_threshold=detect_threshold, save_object=save_objects, saved_image_path=saved_image_path)
    final_result = {"count_of_objects": total_objects}
    for index, label in enumerate(object_detector_tool.output_labels, 1):
        for detection_result in object_detector_tool.labels[label]: 
            final_result[label] = {"count_of_objects": total_objects}
            final_result[label][f"{label}_count_of_objects"] = total_objects
            for result in detection_result:
                final_result[label][f"{label}_count_of_objects"].append({
                    "bbox": [result["bbox"][0], result["bbox"][1], result["bbox"][2], result["bbox"][3]],
                    "score": result["score"],
                    "detected": True
                })
                if result["bbox"][4] - 1 <= len(image_data):
                    final_result[label]["image_path"] = saved_image_path.replace("\\", "/") + "/" + f"{label}_image.svg"
                    if model_size == "tiny":
                        final_result[label]["image_path"] = "detected_objects/" + f"{label}_image.{model_size}_{detect_threshold}.png"
                    else:
                        final_result[label]["image_path"] = "detected_objects/" + f"{label}_{detect_threshold}_image.png"

            # Add the detected object to the final result if the detection score is above the threshold
            if "score" in detection_result[0] and detection_result[0]["score"] > detect_threshold:
                final_result[label]["bbox"] = detection_result[0]["bbox"]
                final_result[label]["image_path"] = saved_image_path 
                
                if model_size == "tiny":
                    final_result[label]["image_path"] = "detected_objects/" + f"{label}_image.{model_size}_{detect_threshold}.png"
                else:
                    final_result[label]["image_path"] = "detected_objects/" + f"{label}_{detect_threshold}_image.png"

    return final_result

