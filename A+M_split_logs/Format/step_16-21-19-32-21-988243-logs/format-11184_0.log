def get_objects(labels=None, thresholds=None, model_size=None, save_object=False, saved_image_path=None):
    object_detection_tool = Object_Detector_Tool()
    labels = labels or []
    thresholds = thresholds or [0.7]
    model_size = model_size or 'base'
    save_object = save_object or True
    saved_image_path = saved_image_path or 'detected_objects'

    objects = object_detection_tool.execute(image='path/to/image', labels=labels, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path, save_object=save_object)
    object_number = {
        'baseball': 0,
        'basket': 0
    }
    
    for label, obj in objects.items():
        object_number[label] = len(obj['bbox'])

    return (objects, object_number)

# Example code to check the tool
detected_objects, object_number = get_objects()

real_result = {
    'baseball': 0,
    'basket': 0,
}

for label in detected_objects.keys():
    if 'bbox' in detected_objects[label]:
        if len(detected_objects[label]['bbox']) > 0:
            real_result[label] = len(detected_objects[label]['bbox'])
    
for label in object_number:
    if label in real_result.keys():
        object_number[label] = real_result[label]

final_result = {'detected_objects': objects, 'object_number': object_number}
