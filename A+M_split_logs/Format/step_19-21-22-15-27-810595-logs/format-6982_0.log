from object_detector_tool import object_detector_tool

def count_dining_tables(image_path):
    detected_objects = object_detector_tool.execute(image=image_path, labels=['table'], save_object=True, saved_image_path='detected_objects')
    object_number = {label: len(detected_objects[label]) for label in detected_objects}
    return object_number

# Example usage
