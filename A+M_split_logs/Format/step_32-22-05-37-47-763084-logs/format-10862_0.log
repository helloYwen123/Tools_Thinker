from Object_Detector_Tool import Object_Detector_Tool

def count_paintings(image_path):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_count = object_detector_tool.execute(image=image_path)
    
    painting_count = 0
    for label in detected_objects:
        if label['saved_image_path'] == "/nf/data8/liao/wxie/SAT/SAT_images_train/10862_0.png":  # Assuming the painting image is at /nf/data8/liao/wxie/SAT/SAT_images_train/10862_0.png for now
            painting_count += 1
    
    return painting_count

final_result = count_paintings('/nf/data8/liao/wxie/SAT/SAT_images_train/10862_0.png')
print("Number of paintings:", final_result)  # Assuming final_result is a dictionary with painting_count
</command>
