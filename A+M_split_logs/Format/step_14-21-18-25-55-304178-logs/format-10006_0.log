from Object_Detector_Tool import object_detector_tool
from Text_Detector_Tool import text_detector_tool

def count_and_locate_interessting_objects(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    """
    Detects objects in an image using the Grounding DINO model.
    """
    # Detecting baseball and basket in the image. Returns a tuple:
    # (1) a dict mapping each object label to a list of detection results (each with box, score, and optionally
    # saved image path); (2) a dict with the total count for each detected object. If 'save_object' is True,
    # detected objects are cropped and saved to the specified directory.
    detected_objects, object_number = object_detector_tool(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    
    # Filtering the detected objects
    filtered_objects = {label: objects for label, objects in detected_objects.items() if label in labels}
    
    # Returning the filtered objects
    return filtered_objects

def count_and_locate_text(image_path, languages, detail=0):
    """
    Detects text in a given image by using EasyOCR model.
    """
    # Detecting texts in the image by using multiple languages (English and German).
    # Note: 'languages' is a list with different language codes (e.g., ['en', 'de']) and 'detail' controls the detail level of the output (e.g., 0 for simpler, 1 for more detailed).
    result = text_detector_tool.execute(image=image_path, languages=languages, detail=detail)
    
    # Filtering the detected text blocks by returning only those that match the specified criteria or more detailed (depending on the 'detail' parameter).
    filtered_text_blocks = [block for text_block in result if 'Detected text' in text_block[1] if len(text_block[0]) > 10]  # Example: Filter based on the text being present
    return filtered_text_blocks

final_result = count_and_locate_interessting_objects(image_path="sat_images_train/10006_0.png", labels=[",", "\","], save_object=True, saved_image_path="detected_objects")
print(final_result)
