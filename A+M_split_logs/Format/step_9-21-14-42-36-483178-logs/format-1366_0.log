from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool
final_result = {}
final_result['object_count', 0] = {}
final_result['number_of_balls', 0] = {}
final_result['number_of_basketballs', 0] = {}
result = Object_Detector_Tool.execute(image='path/to/image', labels=['baseball', 'basketball'], save_object=True, saved_image_path='detected_objects')
detected_objects = result['detected_objects']
number_of_balls = len(detected_objects)
number_of_basketballs = detected_objects['basketball']
final_result['object_count', detected_objects] = len(detected_objects)
final_result['number_of_bells', number_of_balls] = number_of_balls
final_result['number_of_bells', number_of_basketballs] = number_of_basketballs
for num in ['baseball', 'basketball']:
  final_result['number_of_bells', number_of_bells[num] + number_of_basketballs[num]] = number_of_balls[num] + number_of_basketballs[num]
final_result['number_of_bells', [number_of_balls, number_of_basketballs]] = number_of_balls + number_of_basketballs
print(final_result)
