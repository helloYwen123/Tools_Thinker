from tool_module_name import Object_Detector_Tool

# Define input paths and options
input_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12637_0.png"
labels = ['baseball', 'basket']  # Add labels as needed
threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects/"
model_module = "object_detector_tool"
image_module = "object_detector_tool"

# Initialize object detector tool
detector = object_detector_tool

if "detected_objects" in saved_image_path:
    object_labels = saved_image_path.split("/detected_objects/")[1]
else:
    # Extract object labels from image
    object_labels = image_module.call(image=image_module, labels=labels)

# Detect objects and calculate object count
if "object_number" not in saved_image_path:
    detected_objects, object_number = detector.execute(image=input_image_path, labels=object_labels, save_object=save_object, saved_image_path=saved_image_path)

    # Clean up the detected objects dictionary by removing keys with no values
    for label, detection_outputs in object_number.items():
        if not detection_outputs[0]:
            del object_number[label]

final_result = {"detected_objects": detected_objects, "object_number": object_number}
