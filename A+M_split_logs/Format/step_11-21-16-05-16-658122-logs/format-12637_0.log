from object_detector_tool import object_detector_tool

def detect_objects(image_path, labels, threshold, model_size, save_object=True, saved_image_path="detected_objects"):
    try:
        object_detector_tool = object_detector_tool()
        detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)
        return detected_objects, object_number
    except:
        return None

final_result = detect_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/12637_0.png", ["baseball", "basket"], 0.35, "small")
if final_result is not None:
    detected_objects = final_result[0]
    object_number = detected_objects[0]
    detected_objects = detected_objects[1]
else:
    final_result = None

if final_result is not None:
    detected_objects = final_result
    if "basket" in detected_objects:
        detected_objects = detected_objects[detected_objects.index({"basket": 1})]["box"]
    else:
        detected_objects = detected_objects[detected_objects.index({"baseball": 1})]["box"]

final_result = [detected_objects]
print(f"Detected objects: {detected_objects}")
print(f"Total objects detected: {final_result[0]["score"]}")
