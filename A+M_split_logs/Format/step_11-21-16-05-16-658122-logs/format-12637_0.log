from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

def count_objects(image_path):
    image = Object_Detector_Tool.from_path(image_path)
    
    if image is None:
        return {}, {}  # Return an empty dictionary

    labels = {}
    object_count = {}
    detected_objects = []

    for label, item in image.items():
        object_obj = image[label]

        for obj, details in object_obj.items():
            object_count[label] += 1
            if len(details) != 0:
                box = [details[0][0], details[0][1], details[1][0], details[1][1]]
                label_name = label.capitalize()
                detected_objects.append([box, label_name, item[label_name].score])

    for label in object_count:
        for i, det in enumerate(detected_objects):
            if det[2] == label:
                del detected_objects[i]

    if len(detected_objects) == 0:
        return {}, {}  # Return an empty dictionary

    detected_objects = sorted(detected_objects, key=lambda x: (x[0][0], x[0][1]), reverse=True)
    for i, det in enumerate(detected_objects):
        detected_objects[i] = tuple(det[0]) + (det[1] + "-", det[2])

    return detected_objects, object_count
