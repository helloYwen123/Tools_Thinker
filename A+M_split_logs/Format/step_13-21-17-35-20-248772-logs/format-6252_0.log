from module_name import object_detector_tool, text_detector_tool

# Sample question data
question = {
  "image_path": "/nfs/data8/liao/wxie/SAT/SAT_images_train/6252_0.png",
  "labels": ["baseball", "basket"],  # Test question: Number of Baseballs and Baskets
  "threshold": 0.35,  # Confidence threshold for detection 
  "model_size": "tiny",  # Model to use
  "save_object": True,  # Saving detections as images (optional)
  "saved_image_path": "detected_objects"
}

# Python program
object_result = object_detector_tool.execute(image=question["image_path"], labels=question["labels"], save_object=True, saved_image_path=question["saved_image_path"])
object_number = object_result["object_number"]

text_result = text_detector_tool.execute(image=question["image_path"], languages=["en", "de"], detail=0)
text_blocks = text_result["result"]

# Answer to the question
final_result = f"{len(object_result['detected_objects'].keys())}/{len(text_result['result'])} Beds in the scene"
for block in text_blocks:
    if len(block) > 0:
        final_result += "\n" + str(block[0][2].split("\n")[1].strip()) # Ex: [[''Detected text 'basketball', 0.97], ]
for block in text_blocks:
    if len(block) > 0:
        final_result += " ({}-{})".format(block[0][8], "Basketball" if "basketball" in final_result else "Baseball")
final_result += "."
result = {
  "detected_objects": object_result["detected_objects"],
  "object_number": object_number,
  "detected_objects_result": object_result["result"],
  "text_blocks_result": text_blocks
}
