from object_detector_tool import Object_Detector_Tool
object_number = 0

def object_count(image_path):
    result = Object_Detector_Tool.execute(image=image_path, labels=["baseball", "basket"], save_object=False)
    
    for label, box_num in result.items():
        label_number = list(result[label]["score"])[0]
        object_count_dict = {label: label_number}
        object_count_dict["baseball"] += box_num["baseball"]
        object_count_dict["basket"] += box_num["basket"]

    return object_count_dict

final_result = object_count("/path/to/image.png")
print(final_result)
