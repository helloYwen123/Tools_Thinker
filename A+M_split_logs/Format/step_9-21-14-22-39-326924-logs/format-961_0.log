from object_detector_tool import Object_Detector_Tool

def detect_objects(image_path, labels=['baseball', 'basket'], threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects'):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

    if detected_objects:
        result_list = []
        for label, detection_results in detected_objects.items():
            bounding_box = [detection_results[0]['box'][0], detection_results[0]['box'][1], detection_results[0]['box'][2], detection_results[0]['box'][3]]
            score = detection_results[0]['score']
            detected_object = (label, bounding_box, score)
            result_list.append(detected_object)

        return result_list

    else:
        object_number = {}
        for label, total_objects in object_number.items():
            if not labels:
                labels = [label]
            existing_objects = object_number[label]
            existing_object_count = existing_objects + [total_objects]
            object_number[label] = existing_object_count

        return object_number

final_result = detect_objects('path/to/image')
print(final_result)
</command>
