# Function to generate an answer based on tool outputs
def generate_answer(detected_objects, object_number):
    for label, details in detected_objects.items():
        max_score = max(details[2], default=0.0)
        max_label = max(label, key=lambda l: details[2])
        details.append((max_score, max_label, max_score * label))
    result = []
    for label in object_number:
        count = object_number[label]
        result.append({"label": label, "count": count})
    return result

