from object_detector_tool import Object_Detector_Tool

def count_sports_in_image(image_path, labels=None, save_object=False):
    tool = Object_Detector_Tool()
    detected_objects, object_number = tool.execute(image=image_path, labels=labels, save_object=save_object)
    total_objects = {"baseball": 0, "basket": 0}
    
    for label, objects in detected_objects.items():
        if objects:
            total_objects[label] += len(objects)
    
    return total_objects

final_result = count_sports_in_image(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/3830_0.png", labels=["baseball", "basket"])
print("Number of sports detected:", final_result)

