from object_detector import Object_Detector_Tool, Text_Detector_Tool

final_result = {}
final_result["object_number"] = {}

# Check how many baseballs and baskets are visible
# The first door is always open
for i in range(5):
    if i == 0:
        tool = Object_Detector_Tool()
        detected_objects = tool.execute(image='path/to/image', labels=['baseball'], save_object=True, saved_image_path='detected_objects')
        object_number = len(detected_objects.get('baseball', []))
        final_result["object_number"]["baseball"] = object_number
    elif i == 0:
        tool = Text_Detector_Tool()
        result = tool.execute(image='path/to/image', languages=['ch_sim'], detail=1)
        detected_blocks = result['result'][0]['detected_blocks']
        for block in detected_blocks:
            if block['bbox'][1] < 150:
                final_result['baseball'] = block['bbox']
                break

    # Check how many chairs are visible
    for j in range(4):
        if j != 0:
            tool = Object_Detector_Tool()
            detected_objects = tool.execute(image='path/to/image', labels=['basket'], save_object=True, saved_image_path='detected_objects')
            object_number = len(detected_objects.get('basket', []))
            final_result["object_number"]["basket"] = object_number


============================== END ==============================


