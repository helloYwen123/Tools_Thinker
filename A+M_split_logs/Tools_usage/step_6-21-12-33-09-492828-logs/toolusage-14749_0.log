from object_detector_tool import object_detector_tool, object_number
from text_detector_tool import text_detector_tool

# Define the image path and text languages for detection
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/14749_0.png"
languages = ["en", "ja"]
level_of_detail = 1

# Execute the object detection algorithm
detected_objects, object_number = object_detector_tool(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects", threshold=0.35, model_size="tiny")

# Execute the text detection algorithm
result = text_detector_tool(image=image_path, languages=languages, level_of_detail=level_of_detail)
text_blocks = result[0]

# Combine the results into a final list
final_result = []

if detected_objects:
    for label in detected_objects:
        box = detected_objects[label][0]
        text = detected_objects[label][1]
        score = detected_objects[label][2]
        final_result.append([box, text, score])
        
if result:
    final_result.extend(result)

if text_blocks:
    final_result.extend(text_blocks)

# If text detection is successful, add the text information to the result
if detected_objects and text_blocks:
    final_result += text_blocks 

# Display the final results
for obj in final_result:
    print(obj)
    print()

print(f"Found {len(final_result)} objects ({', '.join(final_result[0])})")
print(f"Found {len(final_result)} text ({', '.join(final_result[-1])})")

if "baseball" in final_result[0]:
    print(f"Found 1 baseball object with coordinates [{final_result[0][0][0]}, {final_result[0][0][1]}], score {final_result[0][1]}" if "baseball" in text_blocks else f"Found 0 baseball object with score {final_result[0][1]}")

if "basket" in final_result[0]:
    print(f"Found 1 basketball object with coordinates [{final_result[0][0][0]}, {final_result[0][0][1]}], score {final_result[0][1]}" if "basket" in text_blocks else f"Found 0 basketball object with score {final_result[0][1]}")
