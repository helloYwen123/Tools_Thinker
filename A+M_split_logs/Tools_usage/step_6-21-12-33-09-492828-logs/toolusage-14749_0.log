import text_detector_tool

def count_windows(image_path):
    detected_objects = text_detector_tool.execute(image=image_path, languages=['en', 'de'])
    window_count = 0
    for detected in detected_objects:
        label, coordinates = detected[1].split(' ')
        x1, y1, x2, y2 = coordinates
        if 'window' in label:
            window_count += 1
    if window_count >= 1:
        return True
    else:
        return False

final_result = count_windows("/nfs/data8/liao/wxie/SAT/SAT_images_train/14749_0.png")
print(final_result)
