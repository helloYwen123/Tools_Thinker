import numpy as np
import matplotlib.pyplot as plt
from object_detector_tool import Object_Detector_Tool, Text_Detector_Tool

def count_dressers(image_path):
    tool = Object_Detector_Tool()
    tool.execute(image=image_path)

    # Load the object dictionary with 'baseball' and 'basket' labels
    labels = tool.object_labels

    # Create a dictionary to count the number of occurrences per label
    object_number = {
        'baseball': 0,
        'basket': 0
    }

    total_objects = {
        'baseball': 0,
        'basket': 0
    }

    # Count the occurrences of 'baseball' and 'basket' in the image
    for label in labels:
        if label in ('baseball', 'basket'):
            object_number[label] += len(tool.detect_objects([label]))
            total_objects[label] += 1

    return object_number

def show_image(image_path):
    tool = Object_Detector_Tool()
    img = tools.tools(image_path)

    tool.export()

    tool.execute(image='path/to/image')

    plt.imshow(img)

    plt.axis('off')
    plt.show()

image_path = 'path/to/image'
object_number = count_dressers(image_path)
show_image(image_path)

print(f"Number of dressers: {object_number}")

final_result = {'Number of Dressers': object_number}

