def calculate_dresser_count(image_path):
    detected_objects = {}
    total_objects = 0

    # Detect the dresser
    object_detector_tool = Object_Detector_Tool()
    detected_objects = object_detector_tool.execute(image_path=image_path, labels=["Dresser"], threshold=0.93, model_size="tiny", save_object=True)

    if detected_objects:
        object_number = len(detected_objects['Dresser'])
        detected_objects['Dresser'] = [{'box': det['box'], 'score': det['score'], 'saved_image_path': f'detected_objects/{det["label"]}_box={det["box"]}_score={det["score"]}.png'} for det in detected_objects['Dresser']]
        total_objects += object_number

    # Detect the remaining objects
    text_detector_tool = Text_Detector_Tool()
    result = text_detector_tool.execute(image_path=image_path, languages=['en', 'de']).result()

    if result:
        detected_objects = {**detected_objects, **result}
        detected_objects = sorted(detected_objects.items(), key=lambda x: x[1]['score'], reverse=True)
        detected_objects = [{'box': det['box'], 'score': det['score'], 'text': det['text']} for det in detected_objects]

        total_objects += len(detected_objects)

    return detected_objects, total_objects

