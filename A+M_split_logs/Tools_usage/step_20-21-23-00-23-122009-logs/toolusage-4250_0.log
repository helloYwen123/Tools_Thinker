from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

def object_count(image_path, labels=("baseball", "basket"), save_object=False, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    object_count: dict = {}
    total_objects = 0
    for label, detection_results in detected_objects.items():
        object_count[label] = len(detection_results)
        total_objects += len(detection_results)
    
    return object_count, total_objects

def text_detection(image_path, languages=("en", "de"), detail=1):
    text_detector_tool = Text_Detector_Tool()
    result = text_detector_tool.execute(image=image_path, languages=languages, detail=detail)
    if not result:
        return []
    
    detected_text_blocks = result[0][0]
    detected_sentences = []
    for block in detected_text_blocks:
        if block[-1] == "Detected text":
            text = block[len(block)-2]
            if languages[-1] == 'en':
                detected_sentences.append(text)
            elif languages[-1] == 'ja':
                detected_sentences.append(text.strip().replace('\n', ' ').strip())
            else:
                detected_sentences.append(text.strip() if 'space' not in text else text.strip().replace(' ', '').replace('\n', ' '))
    
    return detected_sentences

def analyze_image(image_path, languages=("en", "de"), extra_language=None):
    object_count, total_objects = object_count(image_path, labels=("baseball", "basket"), languages=languages, languages_to_exclude=[extra_language])
    detected_text_block_list = text_detection(image_path, languages=languages)
    
    return object_count, detected_text_block_list

