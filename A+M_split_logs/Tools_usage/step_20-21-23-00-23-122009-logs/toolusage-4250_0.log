    # Define variables
    detected_safes = []
    total_safes = 0
    
    # Loop through detected text blocks in the image
    for block_info in result:
        # Extract bounding box coordinates
        x0, y0 = block_info[1][0]
        x1, y1 = block_info[1][1]
        x2, y2 = block_info[1][2]
        x3, y3 = block_info[1][3]
        
