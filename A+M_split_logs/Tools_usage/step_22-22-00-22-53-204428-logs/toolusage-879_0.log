from object_detector_tool import Object_Detector_Tool

# Define input parameters
image_path = "/path/to/image.png"
labels = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
save_object = False

final_result = Object_Detector_Tool(
    labels=labels,
    save_object=save_object,
    model_size=model_size,
    threshold=threshold,
    save_object_path="detected_objects"
).execute(image_path, labels)
detected_objects = final_result['detected_objects']

total_objects = sum([len(detected_objects[label]['boxes']) for label in detected_objects])
