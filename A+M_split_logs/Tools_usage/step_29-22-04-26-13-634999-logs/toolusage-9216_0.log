from Object_Detector_Tool import Object_Detector_Tool

class ImageDetection:
    def image_detection(self, image_path, labels, save_object):
        try:
            object_detector_tool = Object_Detector_Tool()
            detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object)
            return detected_objects, object_number
        except Exception as e:
            print(f"An error occurred: {e}")
            return None

final_result = ImageDetection().image_detection("path/to/image.png", ["baseball", "basket"], True)
if final_result:
    detected_objects = final_result[0]
    object_number = final_result[1]

    for box_object in detected_objects:
        print(f"Detected Text Block: [{", .join(map(str, box_object[1:]))}, 'Score: ', "{box_object[3]}", '"]')
else:
    print("No detected objects.")
