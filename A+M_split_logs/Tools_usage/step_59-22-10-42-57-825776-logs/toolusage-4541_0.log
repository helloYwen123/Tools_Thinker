from object_detector import Object_Detector_Tool

def detect_sofas(image_path, sofa_labels=['couch'], save_image=True, saved_image_path="detected_objects"):
    # Initialize the object detector tool
    object_detector_tool = Object_Detector_Tool()
    
    # Execute the detection
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=sofa_labels, save_object=save_image, saved_image_path=saved_image_path)
    
    # Return the detected sofa objects
    return detected_objects, object_number

# Example usage
final_result = detect_sofas("/nfs/data8/liao/wxie/SAT/SAT_images_train/4541_0.png", sofa_labels=['couch'])
final_result

============================== END ==============================


