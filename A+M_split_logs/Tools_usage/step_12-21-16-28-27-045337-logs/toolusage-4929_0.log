from object_detector_tool import Object_Detector_Tool

final_result = {}
model_name = "base"

# Set the model size
if model_name == "tiny":
  model_size = "tiny"
else:
  model_size = model_name

# Execute the object detector tool
object_detector_tool = Object_Detector_Tool(model_size=model_size)
detected_objects, object_number = object_detector_tool.execute(image="path/to/image", labels=["basket", "baseball"], save_object=True, saved_image_path="detected_objects")

# Check if text analysis is enabled
if model_name != "base":
  text_detector_tool = Text_Detector_Tool()
  result = text_detector_tool.execute(image="path/to/image", languages=["en"], detail=1)
  detected_text_blocks = []
  for res in result:
    detected_text_blocks.append({"box": res["bbox"], "text": res["content"], "score": res["score"]})

  if not detected_text_blocks:
    print("Text detection failed")

# Final result
final_result.update({"text_detection_results": detected_text_blocks})
if detected_text_blocks:
  final_result["text_number"] = len(detected_text_blocks)
else:
  final_result["text_number"] = 0

print(final_result)

