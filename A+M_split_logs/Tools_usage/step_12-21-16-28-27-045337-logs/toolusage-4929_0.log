from object_detector_tool import Object_Detector_Tool  # import_object_module: "object_detector_tool"

class ImageDetectionResult:
    def __init__(self):
        self.detected_objects = {}
        self.object_number = {}
    
    def execute(self, image_path, labels=None, labels_to_exclude=None, save_object=True, saved_image_path=""):
        object_detector = Object_Detector_Tool()
        detected_objects = object_detector.execute(image_path, labels=labels, labels_to_exclude=labels_to_exclude)
        
        object_detector = ImageDetectionResult()

        for obj, box, score in detected_objects:
            if obj in object_detector.detected_objects:
                object_detector.detected_objects[obj].append({**box, "score": score})
                object_detector.object_number[obj] += 1

        result = {}
        for label in object_detector.object_number:
            if label in labels or (labels_to_exclude is None or label not in labels_to_exclude):
                result[label] = {**object_detector.detected_objects[label], "number": object_detector.object_number[label]}
        if save_object:
            return result
        return ""

