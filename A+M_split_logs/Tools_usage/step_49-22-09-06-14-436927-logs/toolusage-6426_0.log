from object_detector import Object_Detector_Tool

# Function to count the number of detected objects
def detect_objects_tool(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    return detected_objects, object_number

# Given image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6426_0.png"

# List of labels to detect (e.g., 'baseball', 'basket')
labels = ['baseball', 'basket']

# Call the function
final_result, number_of_objects = detect_objects_tool(image_path, labels)

print(f"The total number of detected objects is {number_of_objects}.")

