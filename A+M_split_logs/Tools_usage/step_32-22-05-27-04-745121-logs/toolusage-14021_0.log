from Object_Detector_Tool import Object_Detector_Tool
object_detector_tool = Object_Detector_Tool()

# Call the object_detection tool with the given paths
detected_objects, object_number = object_detector_tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/14021_0.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

print("Detected objects:")
for label, detection in detected_objects.items():
    print(f"- {label}: {detection}, score, saved_image_path")

print("Number of detected objects:", object_number)

