from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool().execute(
    image="/nfs/data8/liao/wxie/SAT/SAT_images_train/11706_0.png",
    labels=["baseball", "basket"],
    save_object=False,
    saved_image_path="detected_objects"
)

print("Detected objects:")
for obj in final_result["detected_objects"]:
    print(f"Label: {obj['label']}, Score: {obj['score']}, Box coordinates: {obj['box']}")
print("\nNumber of detected objects:", final_result["object_number"])

