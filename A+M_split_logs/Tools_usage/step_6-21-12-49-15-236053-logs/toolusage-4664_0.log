from object_detector_tool import Object_Detector_Tool

class Object_Detector_Tool:
    def execute(self, image, labels=None, save_object=True, saved_image_path=None):
        if labels is None:
            labels = ['chair'] * 3

        object_detector_tool = Object_Detector_Tool()

        detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

        if detected_objects != []:
            total_objects = len(detected_objects)
            final_result = {"detected_objects": []}
            for label, detected_results in detected_objects.items():
                if total_objects > 1:
                    final_result["detected_objects"].append({"name": label, "objects": detected_results})
                    total_objects -= 1
                else:
                    final_result["detected_objects"].append({"name": label, "objects": detected_results[0]})
            total_labels = len(labels)
            object_number[label] = total_objects
            final_result["object_number"] = object_number
        else:
            final_result["detected_objects"] = []

if save_object:
    generated_line = "final_result: " + str(final_result)
else:
    generated_line = ""

print(generated_line)
