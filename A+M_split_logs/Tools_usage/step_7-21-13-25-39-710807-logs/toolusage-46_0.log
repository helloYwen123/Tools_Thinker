from tool_object_detector_Tool import Object_Detector_Tool

object_detector_tool = Object_Detector_Tool()

# Run the object detector tool
detected_objects, object_number = object_detector_tool.execute(image="path/to/image", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Extract the baseball bat information
baseball_bats = [dict(box=f[0], score=f[1], saved_image_path=f[2]) for f in detected_objects if "baseball" in f[1]]

final_result = ""
if len(baseball_bats) > 0:
    final_result += f"Number of baseball bats visible in the scene: {detected_objects}"
    final_result += f"Baseball bats found: {' | '.join([b['saved_image_path'] for b in baseball_bats])}"
else:
    final_result += "No baseball bats found."

if len(object_number) > 0:
    final_result += f"Number of objects detected in the scene: {object_number}"
    final_result += f"Objects detected: {' | '.join([f["baseball"] for f in object_number])}"
else:
    final_result += "No objects detected."

print(final_result)
