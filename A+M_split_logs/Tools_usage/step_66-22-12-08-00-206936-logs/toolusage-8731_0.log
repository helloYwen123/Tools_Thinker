from object_detector import Object_Detector_Tool

def answer_question(scene):
    model_size = "tiny"
    save_object = False
    labels = ["baseball", "basket"]

    if labels:
        detected_objects, object_number = Object_Detector_Tool().execute(image=scene, labels=labels, threshold=0.3, save_object=True, saved_image_path="detected_objects")

        if detected_objects:
            final_result = {"detected_objects": [{"label": label, "bbox": box, "score": score}, ...] for label, box, score in detected_objects if label in labels}
            return f"{final_result}"
        else:
            return f"No objects detected in the scene."
    else:
        return "No labels were provided for object detection."

final_result = answer_question("image_path")
print(final_result)

