from Object_Detector_Tool import Object_Detector_Tool

# Parameters
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/3276_0.png'
labels = ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

final_result = Object_Detector_Tool().execute(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

labels_count = {'baseball': 0, 'basket': 0}

# Detect Boxing Objects
for label in final_result:
    if label['label'] in labels:
        if label['score'] >= threshold:
            labels_count[label['label']] += 1 

print("Labels Count: ", labels_count)

