try:
    # Execute the Object_Detector_Tool to detect sports balls and baskets
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True)

    # Extract text information from the detection结果
    # Assuming the text extracted block has the form [[[[x1, y1], [x2, y2], [x3, y3]], "Detected text", score], ...]

    text_result = [(box, "Detected text", conf_score) for box, text, conf_score in detected_objects]

    final_result += f"Detected objects (text detection):\n{Text_Detector_Tool.run(image=image_path, languages=['en', 'de'])}\n"

    final_result += f"Extraction of additional detected text blocks:\n"

    with open('detected_objects.txt', 'w') as fp:
