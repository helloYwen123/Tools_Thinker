import object_detector_tool as obj
import text_detector_tool as text

def count_object_count(image_path):
    """Count object detection."""
    labels = ["baseball", "basket"]
    saved_image_path = image_path

    detection_results = obj.execute(image=image_path, labels=labels, save_object=True, saved_image_path=saved_image_path)

    if "baseball" in detection_results and "basket" in detection_results:
        object_number = len(detection_results["baseball"])
        return object_number
    elif "baseball" in detection_results:
        return 1
    elif "basket" in detection_results:
        return 2
    else:
        return 0

def detect_text(text_path):
    """Detect text in an image using EasyOCR."""
    languages = ['en', 'de']
    return text.execute(image=text_path, languages=languages, detail=1)

def count_text(text_path):
    """Count text detection."""
    languages = ['en', 'de']
    result = detect_text(text_path)

    text_blocks = result['result']['detected_blocks']

    text_count = len([block for block in text_blocks if block['text']])
    return text_count


# Sample image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3049_0.png"

# Count baseball and basketball in the image
baseball_count = count_object_count(image_path)
basketball_count = count_object_count(image_path)

# Sample text path
text_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3049037/550_0.png"

# Count detected text in the image
text_count = count_text(text_path)

final_result = {
    "baseball_count": baseball_count,
    "basketball_count": basketball_count,
    "text_count": text_count
}

print(final_result)
