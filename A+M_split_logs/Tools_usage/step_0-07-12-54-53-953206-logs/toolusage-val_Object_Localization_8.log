import imageio

def box_overlap(box1, box2):
    """Return the overlap of two bounding boxes."""
    x1, y1, x2, y2 = box1
    x3, y3, x4, y4 = box2
    x_overlap = max(0, min(x4, x2) - max(x3, x1))
    y_overlap = max(0, min(y2, y4) - max(y3, y1))
    if x_overlap > 0 and y_overlap > 0:
        return x_overlap * y_overlap
    return 0

