# Import libraries
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Path of image
path_to_image = "/home/stud/wxie/BLINK_Dataset/Object_Localization/val/images/val_Object_Localization_8_image_1.jpg"

# Initialize the object detector
detector_tool = Object_Detector_Tool()
labels = ["baseball", "basket"]

# Set the threshold
detector_tool.set_threshold(0.35)

# Set the model size as 'tiny'
detector_tool.set_model_size("tiny")

# Set the save object flag to True to save the detected objects
detector_tool.set_save_object(True)

# Set the saved_image_path as 'detected_objects'
detector_tool.set_saved_image_path("detected_objects")

# Run object detection
detected_objects, object_number = detector_tool.execute(image=path_to_image, labels=labels)

# Run text detection by multiple languages
result = Text_Detector_Tool.execute(image=path_to_image, languages=['en', 'de'])

# Run letter detection
results = Letter_Detector_Tool.execute(image=path_to_image)

# Filter out letters which are not in the expected location
filtered_results = []
for result in results:
    if result[0][3] in labels:
        filtered_results.append(result)
    
# Combine all detected objects
detected_objects = {**detected_objects, **filtered_results}

# Combine the detection results by object label
result_dict = {}
for label in labels:
    result_dict[label] = detected_objects[label]
    
# Combine the number of detected objects
object_number_dict = {label: len(detected_objects[label]) for label in labels}

# Convert the results (dict) to a list
result_list = list([result for result in result_dict.values()])

# Print the detected objects
for result in result_list:
    print(result)

# Final selection based on the bounding box coverage and confidence scores
if result[0][1] > result[1][1]:
    final_result = "B"  # Box B encloses the train better
else:
    final_result = "A"  # Box A encloses the train better

print(f"Which bounding box more accurately localizes and encloses the train? {final_result}")
