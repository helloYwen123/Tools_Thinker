exists = False
for i in detected_objects:
    if 'box' in i:
        top_left = i['box'][0]
        bottom_right = i['box'][1]
        # Get the difference in y-coordinates
        y_diff = bottom_right[0] - top_left[0]
        # If there are three chairs, detect chair in the top right corner if not chair in y_diff
