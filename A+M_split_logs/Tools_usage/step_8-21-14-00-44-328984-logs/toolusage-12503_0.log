from object_detector_tool import object_detector_tool
from text_detector_tool import text_detector_tool

class ImageAnalyzer:

    def analyze_image(self, image_path, labels_to_track, save_output=True, saved_image_path="detected_objects"):
        detected_objects = []
        for label in labels_to_track:
            threshold = 0.6
            model_size = "base"
            detection_caption = "Objects detected in image."
            saved_output_name = f"{saved_image_path}_{label}_detected_objects.png"
            object_detector_tool = object_detector_tool(image_path, labels=[label], save_output=save_output, saved_output_path=saved_output_name)
            detected_objects.extend(object_detector_tool.execute(threshold=threshold, model_size=model_size))
            object_number = {label: object_detector_tool.object_number[self.label]}
            detection_caption += f" (number of detected objects in image: {len(detected_objects)}.)"
        
            text_detector_tool = text_detector_tool(image_path, languages=["en", "de"])
            detected_objects.extend(text_detector_tool.execute(["en", "de", label], detail=0))
        
        final_result = {
            "detected_objects": detected_objects,
            "object_number": object_number
        }

        return final_result

# Example usage
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12503_0.png"
labels_to_track = ["baseball", "basket"]
analyzed_image = ImageAnalyzer().analyze_image(image_path, labels_to_track)

# You can explore the content of 'detected_objects' and 'object_number' variables within the final result.
