final_result = 2

from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

saved_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/490_0.png"

text_output = text_detector_tool.execute(image="N/A", languages=["ar", "en", "fr"], detail=0)

if text_output != []:
    text_blocks = text_output[0]["result"]
    detected_texts = []

    for text in text_blocks:
        detected_texts.append({"box": text["bbox"], "recognized_text": text["text"], "score": text["score"]})

    sorted_texts = sorted(detected_texts, key=lambda x: x["score"], reverse=True)
    
    if sorted_texts:
        last_three_detected_text_scores = [sorted_texts[0]["score"], sorted_texts[1]["score"], sorted_texts[2]["score"]]
        if all(sorted_texts[i]["score"] < last_three_detected_text_scores[i - 1] for i in range(3)):
            final_result = 2  # number of detected texts

if final_result == 2:
    for text in text_output:
        if text["text"] and text["text"] not in final_result:
            if text["language"] == "en" and text["score"] > 0.5:
                final_result.append(text)

if final_result == 2:
    output = "[[""Detected text"":'',"score"": 0.95],...]"
    print(output)
else:
    print(final_result)
