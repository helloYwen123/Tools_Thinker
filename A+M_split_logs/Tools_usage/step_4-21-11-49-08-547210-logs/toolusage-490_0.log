from Tool.Tool import *  
from Tool.Text_Detector_Tool import *  

def detect_objects(image_path, labels, languages, detail):
    try:
        text_output = text_detector_tool.execute(image=image_path, languages=languages, detail=detail)  
        text_blocks = [Box(box=[x[0, 0], y[0, 1], x[1, 0], y[1, 1]], text=Block[box[0, 0], y[0, 1], text], confidence=0) for box, text, confidence in text_output] 
        obj_output = 0
    
        for label in labels:
            objects = [Box(box=[x[0, 0], y[0, 1], x[1, 0], y[1, 1]], text=label, confidence=num) for box, label, num in text_output] 
            obj_output += len(objects)
            
            objects = [Block([bbox[0], ybbox[1], xbbox[2], ybbox[3]], text, confidence=confidence) for bbox, ybbox, xbbox, confidence in objects] 
            obj_output += len(objects)

        return (obj_output, text_output), 648  # Adding a placeholder for the total count
    except Exception as e:
        return ([], 648)

final_result = detect_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/490_0.png", ["baseball", "basket"], ["en"], 0)
print(f'max output: {final_result[0]}')
print(f'output count: {final_result[1]}')
