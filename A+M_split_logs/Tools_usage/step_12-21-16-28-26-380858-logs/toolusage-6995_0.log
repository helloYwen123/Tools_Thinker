def detect_objects_and_texts(image_path):
    detected_results = object_detector_tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects")
    
    for label in detected_results:
        for detection in detected_results[label]:
            print(f"{label} :")
            print(f"    Bounding box: ({detection['box'][0]}, {detection['box'][1]}, {detection['box'][2]}, {detection['box'][3]})")
            print(f"    Score: {detection['score']}")

        print(f"-----------------------------------")
    
    if "baseball" in detected_results and "basket" in detected_results:
        # If both baseball and basket are detected, continue with text detection
        print("Detected baseball and basket texts:")
