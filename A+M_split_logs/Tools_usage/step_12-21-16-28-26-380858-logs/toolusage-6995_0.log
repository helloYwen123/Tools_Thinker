from . import object_detector_tool, text_detector_tool

class ImageAnalysisTool:
    def analyze_image(self, label_list, threshold, model_size, save_object):
        labels = label_list
        labels, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)
        text_blocks = text_detector_tool.execute(image=image_path, languages=languages, detail=detail)

        # Convert the text blocks to a list of (bbox, text, confidence score)
        text_info = []
        for block in text_blocks["result"]:
            box = block["boxes"] * [x + (y - 50) for (x, y) in zip(block["bbox"], block["bbox"])]
            text = block["text"]
            confidence = block["score"]
            text_info.append((box, text, confidence))
        text_info = text_info if text_info else []

        # Calculate the total number of objects if save_object is True
        if save_object:
            object_count = {label: len(text_info) for label, text_count in object_number.items() for text_info in text_info if label in text_count}

            for label, count in object_count.items():
                with open(f"detected_objects/{label}.txt", "w") as f:
                    for i, info in enumerate(text_info, start=1):
                        f.write(f"{info[0]}: {info[1]}, {i}\n")

        return labels, object_number, text_info
