from object_detector_tool import Object_Detector_Tool
import_name: 'Object_Detector_Tool'
tool_version: '1.0.0'

def detect_paintings(image_path, labels=['painting'], save_object=False, saved_image_path='detected_objects'):

    # Perform object detection
    detected_objects = object_detector_tool.execute(image_path, labels, save_object=save_object, saved_image_path=saved_image_path)

    # Check if paintings are detected
    total_paintings = 0
    for label in labels:
        if label == 'painting':
            total_paintings += len(detected_objects.get(label, []))

    return detected_objects, total_paintings

