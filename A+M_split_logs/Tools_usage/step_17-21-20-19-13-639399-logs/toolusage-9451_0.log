import object_detector_tool
import text_detector_tool

def detect_objects(image_path, labels, threshold=0.35, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    """
    Detects 'baseball' and 'basket' in the image. Returns a tuple: (1) a dict mapping each label to a list of detection results (each with box, score, and optionally saved image path); (2) a dict with the total count for each detected label. If 'save_object' is True, detected objects are cropped and saved to the specified directory.
    """

    detected_objects = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    results_dict = {}
    number_dict = {}
    for label, detections in detected_objects.items():
        if label == 'baseball':
            number_dict[label] = len(detections)
            results_dict[label] = {'bbox': detections[0]['bbox'] if 'bbox' in detections[0] else None, 'box': detections[0]['bbox'] if 'box' in detections[0] else None, 'score': detections[0]['score'], 'image_path': None}
        if label == 'basket':
            number_dict[label] = len(detections)
            results_dict[label] = {'bbox': detections[0]['bbox'] if 'bbox' in detections[0] else None, 'box': detections[0]['bbox'] if 'box' in detections[0] else None, 'score': detections[0]['score'], 'image_path': None}
        elif 'total' in label or 'boxes' in label:
            number_dict[label] = 1
            results_dict[label] = {'bbox': None, 'box': None, 'score': detections[0]['score'], 'image_path': saved_image_path}
    results_dict.pop('total')  # Removes 'total' key if detected_objects contain it

    return results_dict, number_dict

