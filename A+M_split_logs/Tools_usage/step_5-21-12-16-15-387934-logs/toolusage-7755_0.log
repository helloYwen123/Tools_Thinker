from object_detector_tool import object_detector_tool
detected_objects, object_number = object_detector_tool.execute(image='/nfs/data8/liao/wxie/SAT/SAT_images_train/7755_0.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

