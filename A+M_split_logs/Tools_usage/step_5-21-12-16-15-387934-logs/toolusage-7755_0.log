    for i in detected_items:
        final_result.append(
            json.loads(f"{{\"label\": \"{label}\", \"bbox\": {json.dumps(i)}, \"score\": {i['score']}}}")
        )

for label, count in object_number.items():
    final_result.append({"label": label, "count": count})

