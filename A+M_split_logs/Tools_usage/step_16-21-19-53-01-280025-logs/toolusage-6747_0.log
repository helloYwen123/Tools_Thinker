from text_detector_tool import Text_Detector_Tool

def count_doors():
    image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/door_0.png'
    
    # Load the image using OpenCV
    image = cv2.imread(image_path)
    
    # Detect text in the image
    languages = ['en', 'de']
    result = Text_Detector_Tool.execute(image=image, languages=languages)
    
    number_of_doors = 0
    for entry in result:
        if 'baseball' in entry and 'baseball' in entry[1]:
            number_of_doors += 1
    
    return number_of_doors

final_result = count_doors()
print("Number of Doorways visible in the scene:", final_result)

