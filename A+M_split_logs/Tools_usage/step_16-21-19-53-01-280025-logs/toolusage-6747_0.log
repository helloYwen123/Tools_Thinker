from text_detector_tool import Text_Detector_Tool

def count_doorways(image_path):
    # Load the image using the Text Recognizer
    detector = Text_Detector_Tool()
    text = list(detector.execute(
        image=image_path, languages=['en', 'de']),
        detail=0)

    doorway_count = 0
    for text_block in text:
        if text_block[0][3] == "baseball":
            doorway_count += 1
        elif text_block[0][3] == "basket":
            doorway_count += 2

    return doorway_count

# Sample image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6747_0.png"
