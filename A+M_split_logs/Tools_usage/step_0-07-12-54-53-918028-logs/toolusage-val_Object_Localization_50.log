import object_detector as od
import text_detector as td

# Load the image and obtain a list of detected objects
image_path = "val/Object_Localization_50_image_1.jpg"
labels = ["baseball", "basket"]
bboxes = od.Object_Detector_Tool.execute(image_path, labels, save_object=True, threshold=0.35, model_size="tiny")

# Convert the results list to a tuple
final_result = None
for _, _, box, score in bboxes[0]:
    letter_results = td_letter_detector.execute(image_path=box[0])
    if letter_results and "letter" in letter_results and letter_results["letter"][-1] == 'B':
        final_result = box

# Determine which bounding box is more accurately localizing and enclosing the bench
if final_result:
    print("The bench is more accurately localized and encloses the bench in bounding box A.")
else:
    print("There is no bounding box identified for the bench.")

if not final_result:
    print("No bounding box identified for the bench.")
