from object_detector_Tool import Object_Detector_Tool

def count_windows(image_path, languages=['en', 'de'], detail=0):
    # Read the image
    image = Image.open(image_path)
    
    # Detect windows
    window_results = object_detector_Tool.execute(
        image=image,
        languages=languages,
        detail=detail
    )

    # Get the total number of windows
    window_count = None
    for (label, results) in window_results:
        if label == "window":
            for result in results:
                if "box" in result:
                    x0, y0, x1, y1 = result["box"]
                    windows_count = len(results)
                    window_count = {
                        label: windows_count
                    }
                    break

    # Return the window count
    return window_count

