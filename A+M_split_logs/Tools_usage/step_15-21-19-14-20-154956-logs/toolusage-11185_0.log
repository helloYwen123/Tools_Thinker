def find_objects(image_path, target_labels):
    detector = Object_Detector_Tool()
    label_dict = {}
    total_objects = 0
    detections = []

    for label in target_labels:
        label_key = "baseball" if label == "baseball" else label

        found_objects = detector.execute(image_path=image_path, labels=[label_key], save_object=False)

        if found_objects:
            detections.append(found_objects)

            if label_key in label_dict:
                if len(label_dict[label_key]) < len(found_objects):
                    label_dict[label_key] = found_objects
            else:
                label_dict[label_key] = found_objects

            total_objects += 1

    if label_dict:
        label_dict = dict.sort_by_total_objects(label_dict)
        total_objects = len(label_dict)

