from Tool_Accessory import Object_Detector_Tool, text_detector_tool

def image_object_detection(image_path, labels, save=False, saved_image_path="detected_objects"):
    object_detection_result = object_detector_tool.execute(image_path, labels, save, saved_image_path)
    result = []
    for label in object_detection_result.keys():
        object_detection_result_per_label = object_detection_result[label]
        if object_detection_result_per_label:
            box = [bbox[0] for bbox in object_detection_result_per_label]
            score = [box[4] for box in object_detection_result_per_label]
            if "Score" in labels or "box score" in labels:
                score = max(score)
            if save:
                text_info_per_object = text_detector_tool.execute(image_path, labels)
                for text_info in text_info_per_object:
                    result_dict = {
                        "box": [text_info[0]], 
                        "text": text_info[1], 
                        "score": text_info[2]
                    }
                    result.append(result_dict)
            else:
                result_dict = {
                    "box": [bbox[0]], 
                    "text": label, 
                    "score": score[0]
                }
                result.append(result_dict)
    return result

# Initialize and set language
languages = ['en', 'de']

# Start reasoning
result = image_object_detection(image_path, languages, "Details")
# Display the result
for r in result:
    if r:
        box = [((box[0] - 50), (box[1] - 50)), (box[0] + 50, box[1] + 50)]
        text_info = r["text"]
        score = r["score"]
        print("Detected box:", box, "Recognized text:", text_info, "Score:", score)
    else:
        print("Error: Text Detection failed after retries.")

