from Object_Detector_Tool import Object_Detector_Tool

def detect_objects(image_path, labels, confidence_threshold=0.35, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    detected_objects = object_detector_tool.execute(image_path, labels, save_object, saved_image_path)
    
    total_objects = {label: object_detector_tool.object_number[label] for label in labels}
    returned_result = {'detected_objects': detected_objects, 'object_number': total_objects}

    return returned_result

# Example usage
total_objects = detect_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/2742_0.png", ["baseball", "basket"], confidence_threshold=0.35, save_object=True)

final_result = {
    "total_objects": total_objects,
    "additional_info": {"example1": ["baseball", detection1], "example2": ["basket", detection2]}
}

print("Total Objects:", ", ".join(final_result["total_objects"]))

