from Object_Detector_Tool import Object_Detector_Tool

def count_tvs_in_scene(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, languages=['en', 'de'], detail=2)
    tv_objects = [obj for obj in detected_objects if obj[0][1] == 'Tv']
    tv_count = len(tv_objects)
    return tv_count

