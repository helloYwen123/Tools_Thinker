def count_fridges_in_image(image_content):
    fridge_pattern = re.compile(r'(https?)://[^/]*(?:fridges/)?')
    fridge_count = 0
    fridges_found = False
    
    for start_index, end_index in fridges_pattern.finditer(image_content):
        if fridge_found:
            continue
        
        frame_start_index = start_index - 91 // 10
        image_content = image_content[frame_start_index:frame_start_index + end_index]
        
