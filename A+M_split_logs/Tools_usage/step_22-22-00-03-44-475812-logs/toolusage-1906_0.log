from Object_Detector_Tool import Object_Detector_Tool

def detect_fridges(image_path):
    detector_tool = Object_Detector_Tool()

    detected_objects, object_number = detector_tool.execute(image=image_path, labels=['fridge'])
    refrigerator_count = {f'refrigerator': detected_objects[0]['box'][0]}

    return refrigerator_count

# Function to display the number of detected fridges
def display_fridge_count(estimated_fridge_count):
    print(f"There are approximately {estimated_fridge_count} fridges in the scene.")
    
def predict_fridge_count(image_path):
    fridge_count = detect_fridges(image_path)
    if fridge_count:
        print(f"Based on the image, there are {fridge_count['fridge']} fridges in the scene.")
    else:
        print("No fridges were detected in the image.")

# Example call to the predict function
