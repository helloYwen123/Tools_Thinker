def execute(image, labels, save_image_path=True):
    object_detector_tool = object_detector_Tool(image=image, labels=labels)
    detected_objects, object_number = object_detector_tool.execute()
    detected_objects = sorted(detected_objects, key=lambda x: x['score'], reverse=True)  # Sort by score in descending order
    if save_image_path:
        for i, obj in enumerate(detected_objects):
