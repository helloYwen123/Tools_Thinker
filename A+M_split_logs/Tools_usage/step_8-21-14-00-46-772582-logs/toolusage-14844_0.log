from object_detector_tool import Object_Detector_Tool

object_labels = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
save_object = True

if model_size == "tiny":
    object_detector_tool = Object_Detector_Tool()
else:
    object_detector_tool = Object_Detector_Tool(model_class="Object_Detection_Tool")

result = object_detector_tool.execute(image="14844_0.png", labels=object_labels, threshold=threshold, save_object=save_object, saved_image_path="detected_objects")

detected_objects = {
    label: [
        Object_Detector_Tool(
            input_type="tuple",
            tool_name="Object_Detector_Tool",
            tool_class="Object_Detector_Tool",
            tool_version="1.0.0",
            tool_description="A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding.",
            input_types={"image": "str", "labels": "list", "threshold": "float", "model_size": "str"},
            output_types={
                "image": "str",
                "labels": "list",
                "threshold": "float",
                "model_size": "str",
            },
            user_metadata={
                "potential usage": "The tool can be used for counting and locating interest-objects in images by utilizing the bounding boxes"
            },
        )
        for label in result["detected_objects"]
    ]
}

final_result = {
    "detected_objects": detected_objects,
    "object_number": len(detected_objects),
}

final_result = [detected_objects, object_number]

print(final_result)

