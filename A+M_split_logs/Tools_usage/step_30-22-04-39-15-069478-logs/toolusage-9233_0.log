from Object_Detector_Tool import Object_Detector_Tool

final_result = Object_Detector_Tool().execute(image='path/to_image')
if final_result[0][0].get('number_count', 0):
  numberOfObjects = int(final_result[0][0].get('number_count'))
else:
  numberOfObjects = 0
final_result['text_objects'] = [{
  'box': [bbox[0], bbox[1], bbox[0]+bbox[2], bbox[1]+bbox[3]],
  'words': words,
  'confidence': confidence
} for boxes, words, confidence in final_result[0][0].values()]
final_result['total_objects'] = {
  'baseball': int(final_result[0][0].get('number_count', 0)),
  'basket': int(final_result[0][0].get('number_count', 0))
}
if numberOfObjects == 0:
  print("No objects detected.")
else:
  print(f"{numberOfObjects} detected objects.")

