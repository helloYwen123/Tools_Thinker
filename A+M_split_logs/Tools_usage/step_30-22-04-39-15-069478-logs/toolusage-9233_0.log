from Object_Detector_Tool import object_detector
from Text_Detector_Tool import text_detector

try:
    detected_objects, object_number = object_detector.execute(image='path/to_image.jpg')

    # Use text_detector to obtain more detailed text information
    result = text_detector.execute(image='path/to_image.jpg', languages=['en', 'de'])

    with_result = dict()
    for detected_object in detected_objects:
        block = result[detected_object[0]]
        if block:
            with_result[detected_object[0]] = {'bbox': detected_object[1], 'text': block['text'], 'confidence': block['score']}

    final_result = {
        'Number of detected objects': len(detected_objects),
        'Objects and their information': with_result
    }

except Exception as e:
    final_result = {
        'Exception': str(e)
    }

