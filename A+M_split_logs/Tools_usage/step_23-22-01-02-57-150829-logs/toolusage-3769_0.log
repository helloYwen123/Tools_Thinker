def count_detected_balls(boxes, scores, saved_image_path="detected_objects"):
  for label in labels_to_count:
    detected_objects = [
      {"objects": [{"box": box, "score": score, "saved_image_path": saved_image_path}] for box, score in scores[label].items()}
    ]
    if detected_objects:
      detected_objects_dict = {"{}: {}".format(label.title(), len(detected_objects)): detected_objects}

    elif labels_to_count:
      detected_objects = {
        "{}: 0".format(label.title()[:2]) if label else None for _ in range(len(labels_to_count) - 1)
      }
      detected_objects["{}: {}".format(label.title(), len(detected_objects))] = detected_objects

    else:
      detected_objects = {}

  return detected_objects

