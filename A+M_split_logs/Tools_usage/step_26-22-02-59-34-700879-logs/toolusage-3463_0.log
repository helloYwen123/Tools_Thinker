from Object_Detector_Tool import object_detector_tool

# Input information
file_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3463_0.png"
labels = ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'
save_object = True
