from object_detector import Object_Detector_Tool

def count_fridges(image_path):
    # Define a list of objects of interest
    fridge_labels = ['fridge']
    
    # Load the object detector model
    object_detector_tool = Object_Detector_Tool()
    
    # Execute the object detection with the provided labels
    detected_objects, object_number = object_detector_tool.execute(image_path=image_path, labels=fridge_labels, threshold=0.5, model_size="base")

    # Count the number of refrigerators detected in the image
    fridge_count = sum(1 for _ in detected_objects if "fridge" in _["labels"])

    return "1", {"fridge": fridge_count}

