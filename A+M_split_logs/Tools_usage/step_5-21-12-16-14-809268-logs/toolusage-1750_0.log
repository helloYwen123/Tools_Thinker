# Function to check if box is in bounding box and perform action on box
def check_box_in_box(box, box2):
    # Check if the box is inside the bounding box
    if box[0] <= box2[0] <  box2[2] and box[2] <= box2[1] < box2[4]:
        return True
    else:
        return False

# Example usage
detected_objects, object_number = find_number_of_boxes(image_path, labels)
print(detected_objects)

final_result = len(detected_objects)
print(f"The number of boxes found in the image is: {final_result}")
