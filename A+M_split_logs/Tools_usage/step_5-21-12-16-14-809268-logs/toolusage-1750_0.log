from tool_module_name.object_detector_tool import execute

def find_number_of_boxes(image_path, labels, language="en", retry=3, detail=0):
    labels.extend(["basket", "baseball"])
    languages.extend(["en", "de", "en"])
    for language in languages:
        try:
            detected_objects, object_number = execute(image_path=image_path, labels=labels, language=language, retry=retry, detail=detail)
            return detected_objects, object_number
        except Exception as e:
            print(f"Error detected: {e}")

# Provided image path and labels
