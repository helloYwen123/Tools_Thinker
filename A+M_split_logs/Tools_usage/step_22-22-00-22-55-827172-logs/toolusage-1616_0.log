def text_detector_tool(image, languages):
    # Detect text in the given image using EasyOCR
    result = None
    
    # Use the available languages to detect text, including 'en' and 'de'
    detected_languages = set(languages) if languages else languages
    
    # Retrieve the text detection result
    detected_languages.extend('ch_sim', 'ja', 'de') if (languages or "en" not in languages) else languages
    
    try:
        result = Text_Detector_Tool.execute(image=image, languages=set(detected_languages))
    except Exception as e:  # This should catch most OCR Exceptions
        print(f"Error detected: {e}")
        result = None
    
    return result

