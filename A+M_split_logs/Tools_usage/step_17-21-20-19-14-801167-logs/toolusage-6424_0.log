from object_detector_tool import *
from text_detector_tool import *

def text_detection(image_path, languages=['en', 'de'], detail=1):
    result = []
    for language in languages:
        try:
            result.append([image_path, language, detail])
            text = extract_text(image_path, language)
            result.append([text])
        except Exception as e:
            print(f"Failed to detect text for image from '{image_path}': {e}")
    return result

