    if image_path is None or not os.path.exists(image_path):
        print(f"The image path does not exist or is not valid: '{image_path}'")
        return []

    if save_object:
        image = cv2.imread(image_path)
        image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
        _, hist = cv2.threshold(image, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
