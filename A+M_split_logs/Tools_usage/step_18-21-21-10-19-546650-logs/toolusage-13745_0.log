from object_detector_tool import Object_Detector_Tool

class Object_Detector_Tool:
    def execute(self, image, labels, save_object=True, saved_image_path="detected_objects"):
        object_data = []

        for obj in labels:
            objects = self.object_detector_tool(image, labels=[obj], save_object=save_object)

            for obj_dict in objects:
                i = obj_dict.get('obj_name')
                box = (
                    (int(obj_dict.get('bbox', 0)))
                    + (int(i.get('bbox', (0, 285))))
                    + (int(i.get('bbox', (0, 0))))
                    - (int(i.get('bbox', (0, 0))))

                # Calculate object coordinates on the image
                left = int(obj_dict.get('bbox', (0, 285)))
                top = int(obj_dict.get('bbox', (0, 0)))
                right = int(obj_dict.get('bbox', (0, 0)))
                bottom = int(obj_dict.get('bbox', (0, 285)))

                object_data.append({"box": box, "score": float(i.get('score')), "saved_image_path": saved_image_path})

        return object_data

