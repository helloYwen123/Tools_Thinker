import Object_Detector_Tool as object_detector_tool

def extract_detection_results(image_path, labels, threshold=0.5, model_size='tiny', save_object=False, saved_image_path='detected_objects'):
    detected_objects = {}
    detected_objects_number = {}
    
    detector_tool = object_detector_tool.Object_Detector_Tool()
    
    labels = labels if labels else ['baseball', 'basket']
    
    try:
        resized_images, detection_results = detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size)
    except Exception as e:
        print(f"Error occurred during detection: {e}")
        return detected_objects, detected_objects_number
    
    for label in labels:
        detected_objects[label] = []
        object_number = len(detection_results[label])
        detected_objects_number[label] = object_number
    
    for label in labels:
        for detection_result in detection_results[label]:
            coordinates = detection_result['box']
            score = detection_result['score']
            
            box = [round(x) for x in coordinates]
            box.insert(0, 0)  # Add a zero at the start
            detected_objects[label].append({
                'box': box,
                'score': score,
                'saved_image_path': detection_result['saved_image_path']
            })
    return detected_objects, detected_objects_number

# Example usage
desired_languages = ["en", "de"]  # Replace with the desired languages for text detection
detected_objects, detected_objects_number = extract_detection_results("/home/user/SAT_images_train/12518_0.png", labels=["baseball", "basket"], languages=desired_languages, detail=0)

for detected_object in detected_objects.values():
    for detection_result in detected_object:
        print(f"Detected {detected_object['labels'][0]} {detected_object['labels'][1]} of {detected_object[detected_object.index(detected_object[-1])]['score']}")
```

This Python program uses the `Object_Detector_Tool` class from the `tool_module_name` to detect objects and their bounding boxes. It compares the detection results with the given `labels` and counts the total number of detected objects for each labeled object. The output includes details about the detected objects, such as their bounding box coordinates, score, and the name of the object.
