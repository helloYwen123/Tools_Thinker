```python
from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

object_detector_tool = Object_Detector_Tool()
labels = ['baseball', 'basket']
model_size = 'tiny'
save_object = False

if object_detector_tool.execute(image='path/to/image', labels=labels, save_object=save_object):
    detected_objects = object_detector_tool.execute(image='path/to/image', labels=labels, save_object=save_object)
    detected_objects = detected_objects if save_object else [{}]
else:
    detected_objects = []

try:
    text_detector_tool = Text_Detector_Tool()
    text_blocks = text_detector_tool.execute(image='path/to/image', languages=['en', 'de'], detail=1)
    
    for lb, text_block in zip(labels, text_blocks):
        text_match = lb + '.' + text_block
        
        if text_match:
            detected_objects[lb]['text'] = text_match

except Exception as e:
    print(f"Error detected: {e}")
    
object_number = {}
for label, details in detected_objects.items():
    if details:
        objects = [det['bbox'] for det in details['detected_objects']]
        object_number[label] = max(len(objects)) if objects else 0

final_result = {'detected_objects': detected_objects, 'object_number': object_number}

print(final_result)
```
