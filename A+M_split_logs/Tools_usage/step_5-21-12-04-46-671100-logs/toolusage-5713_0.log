from Object_Detector_Tool import Object_Detector_Tool

# Use the object_detector_tool class to detect baseball and basket with default settings
final_result = {'object_number': {'baseball': 1, 'basket': 2}, 'detected_objects': []}

# Execute the command to extract the objects and their bounding boxes
result = Object_Detector_Tool().execute(image="path/to/image", labels=["baseball", "basket"], save_object=True)

if result:
    for label in set(result[0]['labels']):
        for box in result[0]['boxes']:
            if label == 'baseball' and box[3] >= 35 and box[4] <= 220 and box[1] >= 100 and box[2] <= 200:
                objects = [{**x, 'box': box} for x in result if x['labels'] == label]
                final_result.update({"detected_objects": detected_objects if final_result.get("detected_objects") is None else [objects + final_result.get("detected_objects")]})

# Finally execute the text_detector tool to detect text
final_result.update(text_detector_tool.execute(image="path/to/image"))


if final_result['detected_objects']:
    final_result['detected_objects'].pop()

text_detected_objects = final_result['detected_objects']
text_detected_objects.insert(0, {'box': text_detected_objects.pop()[0][0:2], 'score': text_detected_objects.pop()[1]})
text_detected_objects.pop(0)

text_detected_objects = [f'[{b[0]}, {b[1]},{b[3]}, {b[2]}]' for b in text_detected_objects]
final_result['detected_objects'] = text_detected_objects

final_result['object_number'] = len(result) - len(del(result[0]['detected_objects']))

# Display the result
print("List of detected objects:", final_result["detected_objects"])
print("Number of detected objects:", final_result["object_number"])
