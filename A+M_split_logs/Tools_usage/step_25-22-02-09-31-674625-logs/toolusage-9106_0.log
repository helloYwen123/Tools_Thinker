def count_counterops(image_path, languages=[]):
    detector_tool = Text_Detector_Tool()
    language_codes = ['en', 'de']  # Use the first two supported languages
    result = detector_tool.execute(image=image_path, languages=language_codes)
    counterops_text = []
    for result_entry in result:
        box = result_entry[1]
        recognized_text = result_entry[2]
        score = result_entry[3]
        
        # Check if the text is detected for a counterop (baseball or basketball)
        if recognized_text == 'basketball' or recognized_text == 'baseball':
            detected_obj = {'box': box, 'score': score, 'text': recognized_text, 'count': 0}
            if (recognized_text == 'baseball' and languages != ['en']) or (recognized_text == 'basketball' and languages != ['de']):
                detected_obj['count'] = 1
                detected_obj['text'] = ''

            # Add the detected object to the counterops_text list
            counterops_text.append(detected_obj)
    return counterops_text

