from Object_Detector_Tool import object_detector_tool
final_result = object_detector_tool.execute(image='path/to/image', labels=['basket', 'baseball'], save_object=True, saved_image_path='detected_objects')

if 'detected_objects' in final_result.keys():
  detected_objects = final_result['detected_objects']
  image_suffix = '_'.join(detected_objects[0]['box'][2].split('+')[0:2])
  
  object_number = {}

  for i in detected_objects:
    if i['label'] not in object_number:
      object_number[i['label']] = 1
    else:
      object_number[i['label']] += 1

  print(f"Detected objects: {detected_objects}")
  print(f"Object count: {len(Object_Detector_Tool.output_types)} images (saved as: {image_suffix})")
else:
  print("Text detection failed. Consider using 'save_object' to crop and save detected objects as images.")

