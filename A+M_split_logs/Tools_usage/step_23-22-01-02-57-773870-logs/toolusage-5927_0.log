from object_detector_tool import Object_Detector_Tool

# Define input variables
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5927_0.png"  # Path of the image to be analyzed.
label_list = ["/nfs/data8/liao/wxie/SAT/SAT_images_train/basketball.jpg", "/nfs/data8/liao/wxie/SAT/SAT_images_train/paint.jpg"]   # Path of label images to recognize. Note: /nfs is a placeholder for the actual file path.
save_object = True  # Save detected objects to be cropped.
saved_image_path = "detected_objects"  # Saved image path for detected objects.

# Initialize the detector class
object_detector_tool = Object_Detector_Tool()

# Execute the tool
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=label_list, save_object=save_object, saved_image_path=saved_image_path)

# Output the results
if detected_objects:
    detected_objects = {o['label']: o['detected_rectangle_list'] for k, o in detected_objects.items()}
    object_number_output = {o['label']: len(detected_objects[o['label']]) for o in object_number}

    print(f"Detected objects: {detected_objects}")
    print(f"Object count: {object_number}")
else:
    print("Failed to detect any objects in the image.")

