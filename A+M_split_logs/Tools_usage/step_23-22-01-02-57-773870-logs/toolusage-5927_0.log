import object_detector_tool as odt

def count_paintings(image_path, painting_labels, threshold, model_size="tiny", save_object=False):
    try:
        labels = odt.detect_objects(image_path, painting_labels, threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")
    except Exception:
        labels = []
        
    paint_count = {}
    
    if save_object:
        paint_count["name"] = "detected paintings"
        for painting, details in labels["baseball"]:
            if painting not in paint_count:
                paint_count[painting] = {name: 1 if details["box"][0] > 300 else 0 for name in painting_labels}
            else:
                if details["box"][0] > 300:
                    paint_count[painting]["num"] += 1
                    
    total_paintings = len(set([paint["name"] for paint in paint_count.values()]))

    return total_paintings
            

# Sample usage of the tool
total_paintings = count_paintings(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/5927_0.png", painting_labels=["baseball", "basket"], threshold=0.35, save_object=True)
print("Total Paintings:", total_paintings)

