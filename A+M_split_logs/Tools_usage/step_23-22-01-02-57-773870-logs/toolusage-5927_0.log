def draw_objects(image_path, target_languages=['en', 'de']):
    # Detect objects in the image
    object_detector = Object_Detector_Tool()
    detected_objects, object_number = object_detector.execute(image=image_path, languages=target_languages)

    # Draw objects on the image
    for label in target_languages:
        print(f"Detected {label} in {image_path}")
        for object in detected_objects[label]["results"]:
            print(f"  - Box: {object['box'][0]}, {object['box'][1]}")
            print(f"  - Score: {object['score']}")
            if 'saved_image_path' in object:
                print(f"  - saved_image_path: {object['saved_image_path']}")

    return detected_objects, object_number

# Check the demonstration
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5927_0.png'  # Path to the image
target_languages = ['en', 'de']
draw_objects(image_path, target_languages)

