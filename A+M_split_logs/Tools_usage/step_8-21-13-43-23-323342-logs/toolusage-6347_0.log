def count_bat(image_path, object_classes):
    object_detector_tool = Object_Detector_Tool()
    
    # Running object detector
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=object_classes)
    
    # Counting the total number of detected objects
    num_bat = 0
    for key in object_number:
        num_bat += object_number[key]
    
    return num_bat

result = count_bat('/nfs/data8/liao/wxie/SAT/SAT_images_train/6347_0.png', ['baseball', 'basket'])
final_result = {
    'num_objects': result,
    'desc': f'Counted {result} baseball bats in the image.'
}

