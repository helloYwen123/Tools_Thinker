from object_detector import Object_Detector_Tool

class Text_Detector_Tool:
    def execute(self, image, languages):
        """
        Execute text detection using EasyOCR.
        :param image: the path to the image file.
        :param languages: a list of language codes.
        :return: [detected_text_blocks, text_quality][]
            - [detected_text_blocks]: list of detected text blocks.
            - [text_quality]: list of text quality scores.
        """
        tool_kwargs = {
            "tool_class_name": "text_detector_tool_class_name",
            "image_description": image,
            "tool_class": "text_detector_Tool",
        }
        languages = [lang for lang in languages if lang not in "en"]
        result = self.execute_tool(tool_kwargs)
        if not languages:
            return []
        
        detected_text_blocks = []
        text_quality = []
        
        for language in languages:
            detected_text_blocks.append(self.detect_language(image, language))
            text_quality.append(self.score_text_blocks(detected_text_blocks))
        
        if not detected_text_blocks:
            return []
        
        return detected_text_blocks, text_quality

    def detect_language(self, image, language):
        """
        Detect text in an image at a given language.
        :param language: the language code.
        :return: detected_text_blocks: list of detected text blocks.
            - text_quality: list of text quality scores.
        """
        tool_kwargs = {
            "languages": [language],
            "tool_class_name": "text_detector_tool_class_name",
            "tool_class": "text_detector_Tool",
        }
        result = self.execute_tool(tool_kwargs)
        if not result:
            return []
        
        detected_text_blocks = []
        text_quality = []
        for detected_text_block in result['detected_text_blocks']:
            text_quality.append(self.score_text_blocks(detected_text_block))
            detected_text_blocks.append(detected_text_block[1])
        
        return detected_text_blocks

    def score_text_blocks(self, detected_text_blocks):
        """
        Calculate text quality scores.
        :param detected_text_blocks: a list of detected text blocks.
        :return: [score]: list of text quality scores.
        """
        detected_text_blocks = [block[1] for block in detected_text_blocks]
        return detected_text_blocks

