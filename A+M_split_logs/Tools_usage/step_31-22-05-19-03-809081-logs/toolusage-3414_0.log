from object_detector import Object_Detector_Tool

def count_house_plants(input_image_path):
    object_detector = Object_Detector_Tool()
    result = object_detector.execute(image=input_image_path, labels=["house plant"], save_object=False)
    house_plants = result[0]
    house_plants_dict = {}
    for idx, plant_dict in enumerate(house_plants):
        if "house plant" in plant_dict["labels"]:
            house_plants_dict[idx] = plant_dict
    return house_plants_dict

final_result = count_house_plants("/nfs/data8/liao/wxie/SAT/SAT_images_train/3414_0.png")
print(final_result)

============================== END ==============================


