from Object_Detector_Tool import Object_Detector_Tool

# Detect objects in the image using the Grounding DINO model
label_detector = Object_Detector_Tool()
detected_objects, object_number = label_detector.execute(image="path/to/image", labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects")

label_data = {}
total_objects = label_number = 0

# Extract and count the number of baseball and basketball detections
for detected_object in detected_objects['baseball']:
  total_objects += 1
  if detected_object.get('box') is not None: label_data['baseball'].append(detected_object)
for detected_object in detected_objects['basket']:
  total_objects += 1
  if detected_object.get('box') is not None: label_data['basket'].append(detected_object)

label_data['baseball'] = [detected_object for detected_object in label_data['baseball'] if detected_object.get('score')]
label_data['basket'] = [detected_object for detected_object in label_data['basket'] if detected_object.get('score')]

final_result = {
  "total_objects": total_objects,
  "label_data": label_data,
  "object_number": total_objects
}

