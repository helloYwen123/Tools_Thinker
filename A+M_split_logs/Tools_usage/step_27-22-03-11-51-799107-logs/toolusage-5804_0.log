from object_detector import Object_Detector_Tool

def count_arm_chairs(image_path, labels, threshold=0.35, model_size='tiny', save_object=False, saved_image_path='detected_objects'):

    tool_object = Object_Detector_Tool()
    detected_objects, object_number = tool_object.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size, threshold=threshold)
     
    final_result = {}
    for label in labels:
        if label in detected_objects:
            bounding_boxes = [bbox for bbox in detected_objects[label] if bbox['score'] >= threshold]
            for box in bounding_boxes:
                x1, y1, x2, y2 = box['box']
                final_result[label] = {'number': len(bounding_boxes), 'boxes': [[x1, y1, x2, y2]], 'detected_objects': bounding_boxes}
                
    return final_result

============================== END ==============================


