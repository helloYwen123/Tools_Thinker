from object_detector import Object_Detector_Tool
final_result = []
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4219_0.png'
object_labels = ['baseball', 'basket']

def execute(image_path, labels, save_object):
    object_detector_tool = Object_Detector_Tool()
    detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object)
    return detected_objects, object_number

if 'save_object' in locals():
    (detected_objects, object_number) = execute(image_path, object_labels, 'save_object')
else:
    (detected_objects, object_number) = execute(image_path, object_labels)

final_result = [["detected_objects", detected_objects], ["object_number", object_number]]

