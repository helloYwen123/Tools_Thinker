def calculate_text_blocks(image_path, languages=['en', 'de']):
    detected_blocks = []
    for language in languages:
        result = text_detector_tool.execute(image=image_path, languages=[language])
        for block_info in result:
            if block_info[1] == language:
                detected_blocks.append({'bbox': block_info[0], 'recognized_text': block_info[2], 'confidence_score': block_info[3]})
    return detected_blocks

