from object_detector import Object_Detector_Tool

def count_tv_stands():
    object_detector_tool = Object_Detector_Tool()
    tv_stand, num_tv_stands = object_detector_tool.execute(image='path_to_dreamy_home', labels=['TV Stand'], save_object=True, saved_image_path='detected_objects')
    final_result = []

    for label, entry in tv_stand.items():
        if label == 'TV Stand':
            for det in entry:
                final_result.append(det)

    total_tv_stands = dict(filter(lambda x: x[0] == 'TV Stand', final_result))
    final_result = [det for det, _ in final_result if total_tv_stands[det["label"]]]

    return (final_result, total_tv_stands)

