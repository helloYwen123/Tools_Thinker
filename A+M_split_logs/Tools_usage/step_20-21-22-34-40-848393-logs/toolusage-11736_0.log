                    if label.label in label_list:
                        label_list = label_list + [result[0]]
                    else:
                        label_list.append(result[0])

            for label in label_list:
                bbox, score = label.box, label.score
                box = (bbox[0], bbox[1], bbox[2], bbox[3])
