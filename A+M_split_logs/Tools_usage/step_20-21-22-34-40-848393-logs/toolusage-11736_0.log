from object_detector_tool import Object_Detector_Tool

def count_furniture_and_object_detection(image_path, labels=['sofa'], threshold=0.35, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    detected_objects = {}
    object_number = {}

    for label in labels:
        if label.startswith("sofa"):
            object_number[label] = 0
        elif label.startswith("book"):
            object_number[label] = 0
        elif label == "basket":
            detected_objects["basket"] = []
        elif label == "coffee_table":
            detected_objects["coffee_table"] = []

    # Detect sofas and books
    sofa_results = []
    for label in labels:
        if label.startswith("sofa"):
            result = object_detector_Tool.execute(image=image_path, labels=[label], threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=None)
            sofa_results += result[0]['baseball']

    for label in detected_objects:
        if label in sofa_results:
            object_number[label] += 1

    return sofa_results, detected_objects, object_number


============================== END ==============================


