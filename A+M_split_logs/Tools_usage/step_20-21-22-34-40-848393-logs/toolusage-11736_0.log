class Object_Detector_Tool:
    def execute(self, image, labels, save_object, saved_image_path):
        detected_objects = {}
        object_number = {}
        object_list = []

        object_detectorTool = object_detector_Tool()

        for label in labels:
            label_list = []
            for _, result in object_detectorTool.execute_image(image, language=['english'], detail=1).model.output().items():
