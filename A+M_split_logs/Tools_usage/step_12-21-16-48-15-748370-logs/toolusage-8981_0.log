from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

def get_dining_tables():
    try:
        image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/8981_0.png'
        
        # Detect Objects
        object_detector_tool = Object_Detector_Tool()
        detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['table'], save_object=True, saved_image_path='detected_objects')
        
        # Save Objects
        text_detector_tool = Text_Detector_Tool()
        text_objects = text_detector_tool.execute(image=image_path, languages=['en', 'de'], detail=0)
        
        # Analysis
        dining_tables = ['table']
        for det_result in detected_objects:
            for te_result in text_objects:
                if det_result['boxes'][0][0] in te_result['boxes']:
                    dining_tables.append(det_result['boxes'][0][0])
                    break
        
        return 'Dining Tables', dining_tables
    except FileNotFoundError:
        return 'No Diners', []

final_result = get_dining_tables()
