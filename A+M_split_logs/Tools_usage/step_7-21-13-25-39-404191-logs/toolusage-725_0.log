from object_detector_tool import Object_Detector_Tool

def count_objects_in_image(image_file_path):
    with open(image_file_path, 'rb') as image_file:
        image_data = image_file.read()
    image_name = os.path.basename(image_file_path)
    result = None
    label_to_objects = {"baseball": 0, "basket": 0}
    labels_to_objects = {"baseball": 0, "basket": 0}

    try:
        result = Object_Detector_Tool().execute(image=image_data, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")
        detected_objects = [{"box": box[3], "score": box[4], "saved_image_path": image_name + "." + box[2]} for box in result["detected_objects"] if "score" in box]
        label_to_objects = {label: len(detected_objects) for label, detected_objects in result.items()}
        print("Detected objects:")
        print("\n".join([f"{key}: {data}" for key, data in result.items() if not data["count"]]))

        for label in label_to_objects:
            labels_to_objects[label] = label_to_objects[label]
        print("Object Counts:")
        print(f"{labels_to_objects.get('baseball', 0)} baseball")
        print(f"{labels_to_objects.get('basket', 0)} basketball")

        return {
            "detected_objects": detected_objects,
            "label_counts": labels_to_objects
        }
    except Exception as e:
        print(f"Error occurred while detection: {e}")

    return None

# Example usage:
image_file_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/725_0.png"
final_result = count_objects_in_image(image_file_path)
print(final_result)

