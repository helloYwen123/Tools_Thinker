from object_detector_tool import Object_Detector_Tool

def count_dressers(image_path, object_labels=('bed', 'dresser'), conf_threshold=0.8, model_size="tiny"):
    detected_objects = {}
    object_number = {}
    
    for label in object_labels:
        detected_objects[label] = []
        object_number[label] = 0
        
        for image_str in object_labels:
            object_detector_tool = Object_Detector_Tool()
            detected_objects[label].append(object_detector_tool.execute(image=image_path, labels=[label], threshold=conf_threshold, model_size=model_size)["detected_objects"])
            object_number[label] += len(detected_objects[label])
            
    return detected_objects, object_number

count_dresser_1, dressers_count = count_dressers("/path/to/image.jpg")
dressers_count, detected_objects_dressers = count_dressers("/path/to/basket_image.jpg")
dressers, count_dressesers = count_dressers("/path/to/baseball_image.jpg")
detecting_dressers = detected_objects_dressers["baseball"]
for dressers_label, detected_items in detecting_dressers.items():
    dressers_count[dressers_label] += len(detected_items)

final_result = {
  "dresses": dressers_count,
  "detected_objects_dressers": (dressers_count, detected_objects_dressers)
}

