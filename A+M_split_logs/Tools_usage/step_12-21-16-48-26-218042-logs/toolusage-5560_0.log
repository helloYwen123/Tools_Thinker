# Function to convert the returned list of labels to a dictionary of counts.
def count_labels(labels, object_labels):
    labels_dict = {}
    object_count = 0

    for label in object_labels:
        if label in labels:
            label_count = labels.count(label)
            labels_dict[label] = label_count
            object_count += 1

    return labels_dict, object_count

# Detect objects in the image.
