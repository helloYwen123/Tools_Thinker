from object_detector import Object_Detector_Tool

def count_beds(image_path):
    total_beds = 0
    object_detector = Object_Detector_Tool()
    result = object_detector.execute(image=image_path, labels=['bed'], save_object=True, saved_image_path='detected_objects')
    for detected_object in result['detected_objects']:
        bed = detected_object['bbox'][0]  # Assuming bed is at the bottom of the image. Adjust this as needed.
        if bed[0] > 50 and bed[2] < 500:  # Adjust the bounding box position as needed
            total_beds += 1
    return total_beds

