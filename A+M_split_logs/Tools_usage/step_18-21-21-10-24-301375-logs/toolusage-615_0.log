import Object_Detector_Tool

# Function to count and locate interest-objects in the image based on their bounding boxes.
def count_objects(image_path, labels, save_objects):
    object_detector = Object_Detector_Tool.Object_Detector_Tool()
    object_detection, object_count = object_detector.execute(image=image_path, labels=labels, save_objects=bool(save_objects))
    return object_detection

# Check if a floor lamp is visible in the image.
def count_lamp(image_path):
    lamp_detector = Object_Detector_Tool.Object_Detector_Tool()
    lamp_detection_result = lamp_detector.execute(image=image_path)
    lamp_count = len(lamp_detection_result['baseball'])
    return lamp_detection_result

