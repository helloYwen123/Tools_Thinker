from object_detector_tool import Object_Detector_Tool

def count_and_estimate_text(image_path, languages=["en", "de"], detail=1):
    object_detector_tool = Object_Detector_Tool()
    with open(image_path, 'rb') as img_file:
        image_content = img_file.read()

    labels = object_detector_tool.labels(image_content, languages=languages, detail=detail)

    # Filter text labels
    text_labels = [label for label in labels if label['type'] == 'text']
    
    # Count text labels
    number_of_text_labels = len(text_labels)

    # Return text counts
    return {"number_of_text_labels": number_of_text_labels}

