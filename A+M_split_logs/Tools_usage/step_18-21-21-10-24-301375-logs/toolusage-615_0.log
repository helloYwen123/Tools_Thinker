from Object_Detector_Tool import object_detector_tool

def count_objects_and_objects_per_label(image_path, labels, languages=['en', 'de']):
    # Load the image
    image = Image.open(image_path).convert('RGB')  # Convert the image to RGB format
    
    # Create a new list to store the text detection results
    text_results = []
    
    # Detect text in the image using the text_detector tool
    for lang in languages:
        result = text_detector_tool.execute(image=image_path, languages=[lang])
        if result:
            text_results.append(result)
    
    # Check if there is at least one detected text in the image
    if len(text_results) > 0:
        # Detect objects in the image
        detected_objects, object_count = object_detector_tool.execute(image=image_path, labels=labels, languages=languages, threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects')
        if detected_objects:
            # Determine the number of objects per label
            object_count_per_label = {}
            for label, objects in detected_objects.items():
                for obj in objects:
                    if 'box' in obj and obj['box']:
                        # Convert bounding box coordinates to tuple
                        x1, y1, x2, y2 = tuple([int(coord) for coord in obj['box']])
                    
                        # Add the label to the object_count_per_label dictionary with the number of detected objects matching the label
                        count = object_count.get(label, 0)
                        if count == 0 and detected_objects[label]:
                            object_count_per_label[label] = 1
                        else:
                            object_count_per_label[label] += detected_objects[label]
                # Output the results
                object_count = {
                    'baseball': detected_objects['baseball'],
                    'basket': detected_objects['basket']
                }
                return text_results, object_count
    else:
        # Return an empty result if text is not detected after retries
        return []

