def count_dining_tables(image_path):
    # Define paths to load weights, labels, and conf threshold
    weight_path = "/path_to_weights/tiny_moviment_240_384_224_1x1_384x384.dino"
    label_path = "/path_to_labels/"
    conf_threshold = 0.35
    model_size = "tiny"

    # Initialize the object detector
    object_detector = Object_Detector_Tool()

    # Execute the object detector with the image path
    object_detector.execute(image=image_path)

    # Load the labels dictionary
    labels_path = label_path + "labels.json"
    labels = object_detector.labels
    
    # Define a list to store the dining tables and their counts
    dining_tables = []
    total_dining_tables = 0

    # Check if the object has been detected in the image
    for label in labels:
        if label[0] == "DiningTable":
            # Retrieve the bounding box and confidence score for each detected table
            bounding_box = label[3]
            confidence_score = label[5]

            # If the confidence score is above the threshold, add the bounding box to the list
            if confidence_score > conf_threshold:
                dining_tables.append([bounding_box, confidence_score])

    # Count the total dining tables in the image
    for table in dining_tables:
        total_dining_tables += table[-1]

    return dining_tables, total_dining_tables

