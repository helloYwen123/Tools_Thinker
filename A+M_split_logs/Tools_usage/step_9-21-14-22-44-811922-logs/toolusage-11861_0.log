from object_detector_tool import Object_Detector_Tool

# Assuming the image path is 'path/to/image' and you want to detect objects labeled as 'baseball' and 'basket'

try:
    object_detector = Object_Detector_Tool()
    detected_objects, object_number = object_detector.execute(image="path/to/image", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")
except Exception as e:
    print(f"Error occurred: {e}")
    print("Failed to execute object detection tool.")
    final_result = ""
    return final_result

if len(detected_objects) > 0:
    detected_objects = [det[0] for det in detected_objects]
    object_number = {det[1]["label"]:det[1]["score"] for det in detected_objects}
    text_results = []
    for det in detected_objects:
        if det[1]["label"] in ["baseball", "basket"]:
            text = "Detected " + det[1]["label"]
            if det[1]["score"] > 0.5:
                confidence = f'{det[1]["score"]} ({det[1]["label"]})'
            else:
                confidence = "Unknown"
            text_results.append([[det[0], det[1]["box"], text, confidence], ...])
else:
    text_results = [[...]]

finally:
    print(f"Detected objects are - {detected_objects}")
    print(f"Total number of detected objects is - {len(detected_objects)}")

    num_text_blocks = len([entry for boxes in text_results for entry in boxes])
    num_baseball = [num for (num, _) in object_number.items() if "baseball" in _].count(True)
    num_basket = [num for (num, _) in object_number.items() if "basket" in _].count(True)

    final_result = f"Number of detected objects (with more than 0.5 confidence): {num_text_blocks}\n" \
                  f"Number of detected 'baseball': {num_baseball}\n" \
                  f"Number of detected 'basket': {num_basket}\n"
    final_result = "Detected objects:\n" + str(detected_objects) + "\nTotal number of detected objects is: " + str(object_number.values()) + "\n" + final_result

print(final_result)
