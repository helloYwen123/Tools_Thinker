# Set the model size to 'tiny'
model_size = 'tiny'

# Set save_object to True
save_object = True

# Set saved_image_path to 'detected_objects'
saved_image_path = 'detected_objects'

# Call the object_detector_tool function
final_result = object_detector_tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
print(final_result)

