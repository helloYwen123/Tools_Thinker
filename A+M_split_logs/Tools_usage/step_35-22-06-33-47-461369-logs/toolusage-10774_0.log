from object_detector import Object_Detector_Tool

# Create an Object_Detector_Tool instance
object_detector_tool = Object_Detector_Tool()

# Set the path to the image file
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/10774_0.png'

# Set the labels to detect ('baseball' and 'basket')
labels = ['baseball', 'basket']

# Set the confidence threshold to 0.35
