import object_detector

def detect_floor_lamps(image_path, labels=['lamp'], threshold=0.35, model_size='tiny', save_model_image=False):
    with open(image_path, "rb") as image:
        result = object_detector.execute(image=image, labels=labels, save_model_image=False, threshold=threshold, model_size=model_size)
        total_results = result["detected_objects"]
    num_lamps = {label: total_results.count({"box": {"bbox": [bbox], "label": label, "confidence": score}, "score": score}) for label, _ in total_results}
    return total_results, num_lamps

final_result = detect_floor_lamps("/nfs/data8/liao/wxie/SAT/SAT_images_train/13961_0.png")

