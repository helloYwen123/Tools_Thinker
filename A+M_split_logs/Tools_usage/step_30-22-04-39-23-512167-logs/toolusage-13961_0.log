from object_detector import Object_Detector_Tool

# Initialize model and configuration
object_detector_tool = Object_Detector_Tool()

# Image file path and object labels
image_file = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13961_0.png"
object_labels = ["baseball"]

# Set threshold and model size
object_detector_tool.set_threshold(0.35)
object_detector_tool.set_model_size("tiny")

# Define object number for saved images
object_number = 1

# Execute detection
result = object_detector_tool.execute(image=image_file, labels=object_labels, save_object=True, saved_image_path=f'detected_objects')

# Extract the number of detected objects
object_number = {label: count for (label, count) in result['detected_objects'].items() if count == object_number[-1]}
final_result = (result, object_number)

