from object_detector_tool import Object_Detector_Tool

def count_paintings(image_path, labels, threshold=0.35, model_size="tiny", save_objects=False):
    detected_objects = []
    object_number = {}

    print(f"Detecting objects in {image_path}...")

    image = Object_Detector_Tool().execute(image=image_path, labels=labels, save_object=True, saved_image_path=f"detected_objects")

    if save_objects:
        Object_Detector_Tool().save_object(image, f"detected_objects/generated_image_{image}"))

    for label in labels:
        object_number[label] = object_number.get(label, 0) + len(image[image > threshold])

    detected_objects = [
        {"bbox": [bbox[0], bbox[1],bbox[2],bbox[3]], "score": score, "saved_image_path": None}
        for bbox, score in object_number.items()
        if score >= threshold
    ]

    return {'total': len(image), 'detected_objects': detected_objects, 'number': object_number}

