from object_detector_tool import Object_Detector_Tool

def count_paintings(image_path):
    # Use the object_detector tool to detect paintings
    object_detector_tool = Object_Detector_Tool()
    
    # Execute the tool with the image path and get the detected objects
    detected_objects, num_paintings = object_detector_tool.execute(image=image_path, save_object=True)
    
    # Return the number of paintings
    return num_paintings

# Create a new object detector tool instance
object_detector_tool = Object_Detector_Tool()
# Use the object_detector_tool to find the painting in the given image
num_paintings = count_paintings(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/11833_0.png")

# Check the result
if num_paintings == 2:
    print("There are 2 paintings in the image.")
else:
    print("There are", num_paintings, "paintings in the image.")

