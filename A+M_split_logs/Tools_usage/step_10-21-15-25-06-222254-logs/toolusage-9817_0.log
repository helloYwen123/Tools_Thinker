from object_detector_tool import Object_Detector_Tool

# Assuming the image path is given as a command-line argument
image_path = "path/to/image"

# Initialize an Object_Detector_Tool instance
detector = Object_Detector_Tool()

# Execute the detection
detected_objects, object_number = detector.execute(image=image_path, labels=['baseball', 'basket'], save_object=False, saved_image_path='detected_objects')

# Convert the detected objects dictionary to a list of dictionaries
detected_objects_list = [detected_dict for detected_dict in detected_objects.values()]

# Determine the number of detected objects
num_objects = sum([len(detected_dict['box']) for detected_dict in detected_objects_list])

# Determine the languages and confidence score for each detected object
language_scores = [[detected_container[2] for detected_container in detected_objects_list], [detected_container[1] for detected_container in detected_objects_list]]

# Handle English and Simplified Chinese separately
english_language_scores = [box[2] for box in language_scores if 'en' in detected_container[0] and 'chs' not in detected_container[0]]
simplified_chinese_language_scores = [box[2] for box in language_scores if 'zh' in detected_container[0] and 'chs' in detected_container[0]]

# Convert English scores to the given format
english_language_scores = [[box[1] for box in english_language_scores], [box[0] for box in english_language_scores], [0.92]]
simplified_chinese_language_scores = [[box[1] for box in simplified_chinese_language_scores], [box[0] for box in simplified_chinese_language_scores], [0.85]]

# Convert simplified Chinese scores to the given format
simplified_chinese_language_scores = [[box[1] for box in simplified_chinese_language_scores], [box[0] for box in simplified_chinese_language_scores], [0.95]]
language_scores = [english_language_scores, [0.92], simplified_chinese_language_scores]

# Print the number of detected objects and their language and confidence scores
print(f"Number of detected objects: {num_objects}")
print(f"English language: {language_scores[0]}")
print(f"Simplified Chinese language: {language_scores[1]}")
