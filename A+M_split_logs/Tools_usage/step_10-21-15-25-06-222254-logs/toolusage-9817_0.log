def count_armchairs(image_path):
    with open(image_path, 'rb') as file:
        data = file.read()

    object_detection_model = Load_Model('object_detector_tool')
    object_detection_image = object_detection_model(data=data)

    labels = ['chair', 'armchair']
    num_armchairs = object_detection_image["object_number"]["chair"]
    num_armchairs += object_detection_image["object_number"]["armchair"]
    return f'{num_armchairs} armchairs visible in {image_path}.'

