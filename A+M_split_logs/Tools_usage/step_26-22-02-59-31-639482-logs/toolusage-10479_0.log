import json

# Available tools
object_detector_tool = None
text_detector_tool = None

# Use the Object_Detector_Tool tool for object detection
if object_detector_tool is None:
  object_detector_tool = Object_Detector_Tool()

# Use the Text_Detector_Tool tool for text detection
if text_detector_tool is None:
  text_detector_tool = Text_Detector_Tool()

# Define the question with the image path and related labels
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/10479_0.png'
labels = ['baseball', 'basket']
confidence_threshold = 0.35
model_size = 'tiny'
save_object = True

# Execute the tool and get the result
result = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=confidence_threshold, model_size=model_size)

# Execute the tool and get the result
result_text = text_detector_tool.execute(image=image_path, languages=['en', 'de'], detail=0)

# Create the final result string
final_result = " {'detected_objects': {}, 'object_number': {} }"

# Add the detected objects and object numbers
for detected_object in result['detected_objects']:
    final_result += f", {'baseball': {detected_object['box']}}, {detected_object['score']}"

# Add the text detection for additional text beyond the expected result
if result_text:
    for detected_text in result_text:
        final_result += f", {'de': {detected_text['box']}}, {detected_text['score']}"

print(final_result)

