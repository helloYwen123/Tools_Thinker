from Object_Detector_Tool import Object_Detector_Tool

def count_beds(image_path):
  # Initialize the Object_Detector_Tool object with the specified parameters
  object_detector_tool = Object_Detector_Tool()

  # Execute detection
  detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['bed', 'twin_bunk'], save_object=True)

  # Initialize a dictionary to count the number of beds detected in the image
  bed_count = {}

  # Iterate over the detected objects and update their count in bed_count
  for det_obj in detected_objects['baseball']:
    bed = det_obj['bbox'][0] + 40  # assuming this is the starting index of beds
    bed_count[bed] = bed_count.get(bed, 0) + 1
  return bed_count

