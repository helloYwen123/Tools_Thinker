    return object_numbers

def count_baseball(image_path):
    object_counts = get_object_counts(image_path)

    total_baseball_objects = 0
    for label, obj_counts in object_counts.items():
        total_baseball_objects += obj_counts.get('baseball', 0)

    return total_baseball_objects

