from object_detector import Object_Detector_Tool

# Initialize the object detector tool
object_detector_tool = Object_Detector_Tool()

# Execute the tool with the input image, labels, and save_object parameter
detected_objects, object_number = object_detector_tool.execute(image="path/to/image", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

if detected_objects:
    # Create a dictionary to store detected objects and their counts
    detected_objects_dict = {}

    # Iterate over the detected objects
    for label in detected_objects:
        # Get all detected objects for a specific label
        detected_objects_per_label = detected_objects[label]

        # Count the total number of detected objects for the label
        total_detected_objects = sum(1 for objects in detected_objects_per_label for _ in objects)

        # Add the label, number of detected objects to the dictionary
        detected_objects_dict[label] = {'num_objects': total_detected_objects}

    # Iterate over the dictionary and print the count for each label
    for label, details in detected_objects_dict.items():
        print("Detected Objects Count for", label, ":", len(details['num_objects']))

else:
    print("Text detection did not return any detected objects.")

