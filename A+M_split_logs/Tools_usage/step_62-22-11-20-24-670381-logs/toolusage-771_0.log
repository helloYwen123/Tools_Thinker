from object_detector import Object_Detector_Tool

# Sample image path
image_path = "/path/to/your/image.png"

# Sample labels
labels_to_detect = ['dog', 'cat']

# Detection threshold & model size
detect_threshold = 0.8
detect_model_size = 'base'

# Save object
save_objects = True

# Generate object detection
final_result = Object_Detector_Tool().execute(
    image=image_path,
    labels=labels_to_detect,
    save_object=save_objects,
    detect_model_size=detect_model_size
)

