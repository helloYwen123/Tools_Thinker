import object_detector as od
import text_detector as td
import letter_detector as ld
from image_utils import get_image_path

result_databse = {}

questions = [
    {
        "question": "How many people are holding a baseball bat?",
        "question_image_path": "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_68_image_1.jpg",
        "options": [
            {"text": "2", "probability": 0.3},
            {"text": "0", "probability": 0},
            {"text": "3", "probability": 0.35},
            {"text": "1", "probability": 1}
        ],
        "correct_answer": "1"
    }
]

for question in questions:
    img_path = get_image_path(question["question_image_path"])
    object_detector = od.Object_Detector_Tool()
    texts = object_detector.execute(img_path).get("detected_objects")
    if texts:
        results_list = [
            {"box": bounding_box, "text": text} for bounding_box, text in texts.items()
        ]
        if question["question"] in results_list:
            results_list = [x for x in results_list if x["text"] == question["question"]]
            if results_list:
                results_list = [result for result in results_list if result["text"] in question["options"]]
                final_result = results_list[0]
                break
            else:
                result_databse["{}".format(question["correct_answer"])] = 1
    else:
        result_databse["{}".format(question["prompt"]) + " (2) " + " (2) " + " (2) " + " (2) " + " (2) was missing"] = 1

final_result = str(result_databse.values())
final_result = "{}, {} {}".format("The correct answer is ", results_list[0])

print(final_result)
