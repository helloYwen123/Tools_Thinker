from object_detector_tool import Object_Detector_Tool

# Specify the path to the image file
image_path = "/path/to/image.png"

# Detect objects such as 'baseball' and 'basket'
detected_objects, object_number = Object_Detector_Tool().execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

final_result = {"num_objects_detected": object_number["baseball"] + object_number["basket"]}
final_result["detected_objects"] = detected_objects

print("Detected objects:")
for det_obj in detected_objects["baseball"]:
    print(det_obj)

print("\nDetected objects:")
for det_obj in detected_objects["basket"]:
    print(det_obj)

print("\nNumber of detected objects:")
for key, value in object_number.items():
    print(f"{key}: {value}")

