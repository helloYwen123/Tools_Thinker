from object_detector_tool import Object_Detector_Tool

# Set path to an image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11690_0.png"

# Set labels to detect ('baseball', 'basket')
labels = ["baseball", "basket"]

try:
    # Execute object detection operation
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels,
                                                                      threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects")

    # Assign the total number of detected objects to object_number
    object_number["basket"] = 0

    # Calculate total count of all detected objects
    total_objects = sum([len(detected_objects[label]) for label in labels])

except Exception as e:
    print(f"Error: {str(e)}")
    final_result = "Error during object detection."
    return final_result

# Final result output
final_result = {
    "detected_objects": detected_objects,
    "object_number": object_number,
    "total_objects": total_objects
}

============================== END ==============================


