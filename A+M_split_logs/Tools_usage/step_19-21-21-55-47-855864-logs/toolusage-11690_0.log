from object_detector_tool import Object_Detector_Tool

def count_chairs(image_path, label="chair"):
    detected_objects = []
    label_count = {}
    
    # Load object detector model and execute tool to count chairs
    tool = Object_Detector_Tool()
    tool.confidence_threshold = 0.35
    tool.save_object = True
    tool.labels.extend([label])
    
    result = tool.execute(image=image_path)
    
    for result_entry in result:
        if label in result_entry["labels"]:
            detected_objects.append(result_entry["labels"][0])
            label_count[result_entry["labels"][0]] = result_entry["count"]
    
    return detected_objects, label_count

# Sample image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11690_0.png"

# Calculate detected objects and label count
(chairs, label_count) = count_chairs(image_path)


