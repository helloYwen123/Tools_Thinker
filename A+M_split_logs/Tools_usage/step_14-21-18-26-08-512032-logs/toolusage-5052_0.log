    saved_image_path = 'detected_objects'

    # Sample threshold=0.35
    threshold = 0.35

    try:
        detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=(save_object, saved_image_path), threshold=threshold)
