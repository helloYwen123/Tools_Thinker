from object_detector_tool import *

# execute the object detector tool
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = object_detector_tool.execute(image='path/to/image', labels=['bed', 'chair'], save_object=True)

# extract bed detection
bed_detections = [d['boxes'][-1] for d in detected_objects.values() if 'baseball' in d['label']]

final_result = f"Visible beds: {bed_detections}" if bed_detections else "No beds visible."

import text_detector_tool

# execute the text detector tool
text_detector_tool = Text_Detector_Tool()
result = text_detector_tool.execute(image='path/to/image', languages=['en', 'de'])

final_result += f".\n{' '.join(map(str, result))}"
