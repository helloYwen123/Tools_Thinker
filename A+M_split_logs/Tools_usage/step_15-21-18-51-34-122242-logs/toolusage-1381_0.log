def detect_chairs(image_path):
    from object_detector_tool import Object_Detector_Tool

    # Load detected objects
    detected_objects = []
    object_number = {}

    try:
        # Create an object detector
        object_detector_tool = Object_Detector_Tool()

        # Detect chairs in the image
        detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=['chair'], save_object=False, saved_image_path='detected_objects')

        # Convert the dictionary to a list for easier handling
        detected_objects = [list(entry.items()) for entry in detected_objects]

        # Check if chairs were detected
        if "chair" in detected_objects:
            print("Found chairs in the image.")
        else:
            print("No chairs found in the image.")

        for chair_box, chair_score, saved_image_path in detected_objects:
            chair_image_path = f"detected_objects/{chair_box[0]}{chair_box[1]}, {chair_box[1]}, {chair_box[2]}{chair_box[3]}{chair_box[4]}.png"
            with open(chair_image_path, 'wb') as f:
                f.write(object_detector_tool.to_bytes(box=chair_box))
                f.write(object_detector_tool.to_bytes(score=chair_score))
            object_number['chair'] += 1

    except Exception as e:
        print(f"An error occurred: {e}")

    return detected_objects, object_number

# Given image path
img_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/1381_0.png'

# Detect chairs
detected_objects, object_number = detect_chairs(img_path)

# Print the results
final_result = {
    "number_of_chairs": len(detected_objects)
}

if object_number:
    for label in object_number:
        final_result[label] = object_number[label]
    final_result = str(final_result)
else:
    print("No chairs found.")

print(final_result)

