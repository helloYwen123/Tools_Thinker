from PIL import Image
import torch
import os
from object_detector_tool import Object_Detector_Tool

class ImageFolderExample:
    def __init__(self, train_folder, language='en', scale='base'):
        self.train_folder = train_folder
        self.language = language
        self.scale = scale
        self.object_detector = Object_Detector_Tool()
        self.data = []

    def process_folder(self):
        for filename in os.listdir(self.train_folder):
            if filename.endswith('.png'):
                image_path = os.path.join(self.train_folder, filename)
                img = Image.open(image_path)
                self.data.append(img)
    
    def detect_objects(self):
        self.process_folder()
        img_data = self.data

        for img in img_data:
            image = self.object_detector.execute(image=img, languages=[self.language],
                                                  detail=self.scale)
            for obj_list in image[0]:
                obj_info = self.object_detector.export_object(obj_list)
                for label, info in obj_info.items():
                    x, y, w, h = info['box']
                    confidence = info['score']
                    bounding_box = [x, y, x + w, y + h]
                    self.data.append(bounding_box)

            # Make sure to save the detected objects as images, if required
            self.save_objects()

        print(f"Detected {len(self.data)} objects.")

    def save_objects(self):
        path = os.path.join(self.train_folder, "detected_objects")
        os.makedirs(path, exist_ok=True)
        for img, bbox in self.data:
            img = img.permute(2, 0, 1).unsqueeze(0)
            img = torch.tensor(img)
            img = img.requires_grad_()
            img = img.to(self.object_detector.model.device)
            img = self.object_detector.model(image=img, return_predictions=True)[0]
            img = img[0].data.cpu().permute(1, 2, 0).numpy()
            img = img * 255
            img2 = Image.fromarray(img).convert('L')
            img2.save(os.path.join(path, f'image_{self.object_detector.model.model_name}_bbox_point.txt'))

if __name__ == '__main__':
    train_folder = '/path/to/train_folder'  # Replace with your train folder path
    language = 'de'
    scale = 'base'
    model = ImageFolderExample
