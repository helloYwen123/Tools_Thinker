from object_detector import Object_Detector_Tool
import_object = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11380_0.png"

def detect_objects(image_path, labels, threshold, saved_object):
    try:
        object_count = 0
        objects = {}
        labels_detected = {}

        # Load the object detector tool
        tool = Object_Detector_Tool()
        input_data = {
            "image": image_path,
            "labels": labels,
            "model_size": "base"
        }

        # Call the function to detect objects
        detected_objects, object_number = tool.execute(input_data, save_object)

        # Check if objects were detected
        if detected_objects:
            for label in labels:
                if label in detected_objects.keys():
                    objects[label] = detected_objects[label]
                    objects[label].update({"count": object_number[label]})

            return objects
        else:
            return objects
    except Exception as e:
        print(f"Error executing the object detector tool: {e}")
        return {}

response = detect_objects(import_object, ["baseball"], 0.3, True)
final_result = {
    "Detected objects": response
}
final_result = {
    "Detected objects": {
        **final_result["Detected objects"], **{"baseball": 1}
    }
}

print(final_result)

