def threshold_model(img_normalized, model_loc, labels, min_padding=0):
    import Image
    import matplotlib.pyplot as plt
    import numpy as np
    input_img = np.expand_dims(img_normalized, axis=0)
    img_input = Image.open(model_loc)
    img_input = img_input.expand(*input_img.shape)

    try:
        input_img = input(img_input, data_format="channels_last")
        input_img = np.expand_dims(input_img, axis=0)
        input_img = input_img.astype(input_img.dtype)

        with open(model_loc + "_thresholds.json", 'r') as f:
            thresholds = json.load(f)

        model_output = model.predict(input_img)
        if model_output[0][0] > 1:
            thresh = thresholds[labels.index(labels[-1])]
        else:
            thresh = thresholds[labels.index(labels[-1]) + 1]
    except Exception:
        raise ValueError('Model does not exist or is not found')
    output_img = thresh * input_img
    output_img = np.uint8(output_img)
    return output_img




