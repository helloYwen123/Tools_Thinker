Code: from object_detector import Object_Detector_Tool

image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_43_image_1.jpg'

output = Object_Detector_Tool.execute(image=image_path,
                                        labels=["water", "elephant"],
                                        saved_object=True,
                                        saved_image_path="out")

if 'detected_objects' in output:
    num Elephants_water = output['detected_objects'][0]['boxes'][0]['x1'][0] * output['detected_objects'][0]['boxes'][0]['x2'][0]
    num Elephants_trunk_in_water = sum(x for x in output['detected_objects'][0]['boxes'][1:2] if 'water' in x)
    final_result = max(num Elephants_water, num Elephants_trunk_in_water)
    
    if final_result == 2:
        final_result = 0
    else:
        final_result = 2

else:
    final_result = 0

