Code: from object_detector import Object_Detector_Tool

final_result = "D"

# Step 1: Load the image
detector_tool = Object_Detector_Tool()

# Step 2: Detect objects in the image
labels = ["baseball"]
labels.extend(["basket"])
objects, object_number = detector_tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_70_image_1.jpg", labels=labels, save_object=True)

for label, detection_results in objects.items():
    for detection_result in detection_results:
        if "boxes" in detection_result:
            for box in detection_result["boxes"]:
                if box["name"] == "door":
                    door_count = object_number.get(label, 0)
                    if door_count == 0:
                        final_result = label
                        break

# Step 3: Check if a door was detected
if final_result != "":
else:
    print("No doors detected in the image.")

