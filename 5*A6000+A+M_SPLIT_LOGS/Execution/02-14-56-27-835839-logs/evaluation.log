Code: from object_detector import Object_Detector_Tool

final_result = 'B'

# Load the object detector tool
obj_detc = Object_Detector_Tool()

# Read the image file path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_63_image_1.jpg"

# Execute the detection tool
detected_objects, object_number = obj_detc.execute(image=image_path, labels=["cow"], save_object=True, saved_image_path="detected_objects")

# The detection results are in the form of two dictionaries:
# 1. 'boxes': bounding boxes of the detected objects
# 2. 'confidence_scores': confidence scores of each object
# 3. 'saved_image_paths': image paths for saved objects

# The detections count is the sum of the 'boxes' in each result dictionary
total_detections = sum([len(boxes) for _, boxes, _ in detected_objects.values()])

# Final result based on the question text
if total_detections == 1:
    final_result = "C"
elif total_detections > 1:
    final_result = "A"
else:
    final_result = "D"

print(final_result)

