Code: from object_detector import Object_Detector_Tool

# Load the image and get bounding boxes and confidences
tool = Object_Detector_Tool()
image = 'path/to/image.png'
labels = ['baseball', 'basket']
threshold = 0.45
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

# Get detection results
detected_objects, object_number = tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Calculate total count
total_count = sum(object_number.values())

# Choose the minimum number to determine the correct answer
options = ['A', 'B', 'C', 'D', 'E']
final_result = min(range(len(options)), key=lambda i: int(int(total_count) / 4) == i, default=len(options) % 4)
print(f"The number of players wearing face guards in the image is: {final_result}")

