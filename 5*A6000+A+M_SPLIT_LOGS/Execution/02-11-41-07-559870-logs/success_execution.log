from object_detector import Object_Detector_Tool

class tennis_player:
    def __init__(self, image_path):
        self.image_path = image_path
        self.object_detector_tool = Object_Detector_Tool(image_path, labels=["tennis_player"], threshold=0.45, model_size="base", save_object=False)

    def detect(self):
        detected_objects = self.object_detector_tool.execute()
        label_groups = detected_objects[0]['counted_label_groups']

        tennis_player_count = detected_objects[1]['count']
        total_players_in_image = detected_objects[0]['boxes'][0]['label_group_count']

        ball_count = 1 # Assuming there is one ball in the image
        racket_count = 0
        for label_group in label_groups['box_clusters']:
            racket = [box for box in label_group['boxes'] if label_group['label'] == 'tennis_racket'][0]
            racket_count += racket['num_of_boxes']

        final_result = [label_groups['total_labels'], tennis_player_count, total_players_in_image, racket_count, ball_count]

        return final_result
