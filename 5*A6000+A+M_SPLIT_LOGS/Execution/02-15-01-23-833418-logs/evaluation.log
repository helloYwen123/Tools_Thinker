Code: import os
from object_detector import Object_Detector_Tool

final_result = 'A'

# Input image file path
input_image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_110_image_1.jpg'

# Initialize the Object_Detector_Tool
detector = Object_Detector_Tool()

# Execute the tool to detect and return 'boxs' and 'confidence_scores' for each detected object in the image
detected_objects, object_number = detector.execute(image=input_image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Define the detected objects (in this case, 'baseball' and 'basket' are sufficient)
detected_objects = {'baseball' : 'boxs', 'basket' : 'boxes'}

# Check the number of detected objects
num_baseball = object_number['baseball']
num_basket = object_number['basket']

# Initialize the maximum count of detected objects in the image
max_counts = {'baseball':0, 'basket':0}

# Loop through the returned dictionary and update the max_counts
for key in detected_objects:
  max_counts[key] = max(max_counts.get(key,0), len(detected_objects[key]))

# Determine the correct category based on the number of baseball and basket detections
if num_baseball <= num_basket:
  final_result = 'B'
else:
  final_result = 'C'

final_result

