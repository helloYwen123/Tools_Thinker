import os
import numpy as np

object_detector = Object_Detector_Tool()
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_90_image_1.jpg"
labels = ["stop", "Grandview", "Sunset Terr Dr", "grass"]
threshold = 0.45
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects/"

result = object_detector.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
# print(result)
if len(result['detected_objects'][0]['boxes']) != 0:
    black_letter_count = 0
    total_count = result['total_objects'][0]['count']
    for i in range(1, len(result['detected_objects']) - 1):
        detected_objects = result['detected_objects'][i]
        for label_name in detected_objects:
            if result['detected_objects'][i - 1]['boxes'][label_name]['class_id'] == 1 and result['detected_objects'][i - 1]['boxes'][label_name]['confidence_score'] > 0.45:
                black_letter_count += 1
                total_count -= 1
                break
    final_result = "A" * black_letter_count + "B" * (1 - black_letter_count)
else:
    print("No detected objects found in the image.")

final_result

