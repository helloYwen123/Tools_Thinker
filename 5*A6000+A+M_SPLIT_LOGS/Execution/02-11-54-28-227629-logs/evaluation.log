Code: from image_object_detector import Object_Detector_Tool

# Initialize the object detector tools
tool_class_name = 'Object_Detector_Tool'
object_detector = Object_Detector_Tool()

# Load an image file
file_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_90_image_1.jpg'
tool_args = {
    'image': file_path,
    'labels': ["STOP"],
    'threshold': 0.45,  # Confidence threshold
    'model_size': 'tiny',  # Model type
    'save_object': True,
    'saved_image_path': 'detected_objects'
}

# Detect objects in the image
object_detector.execute(**tool_args)

# Collect the detected object names and their counts
labels, object_number = object_detector.handle_output()

# Filter the results
stop_sign_labels = ['STOP']
final_result = {label: object_number[label] for label in stop_sign_labels}

# Output the result
final_result = list(final_result.items())
final_result.sort(key=lambda x: -x[1])
end_time = time()
print(f"Number of signs with black letters found: {final_result[0][1]}")

