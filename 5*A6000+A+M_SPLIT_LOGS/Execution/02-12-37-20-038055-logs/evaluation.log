Code: from object_detector import Object_Detector_Tool

def describe_person_images():
    image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_35_image_1.jpg"
    labels = ["baseball", "basket"]
    save_object = True
    saved_image_path = "detected_objects"
    
    detector = Object_Detector_Tool(image=image, save_object=save_object, saved_image_path=saved_image_path, thresholds=[0.5])  
    results = detector.execute(labels=labels)
    
    if not results:
        print("No object detected.")
        return
    
    detected_objects = results[1]
    total_labels = detected_objects['object_number']
    print(f"Number of objects detected: {total_labels}")
    
    label_counts = results[0]['object_number']
    print("Label Counts:")
    for label, count in label_counts.items():
        print(f"{label}: {count}")
    
    final_result = min(total_labels, 5, max(1, total_labels // 5))  # Choose the minimum number of detected children to display
    
    print(f"Total number of labeled objects: {total_labels}")
    print(f"Minimum number of children: {final_result}")
    
    return final_result

result = describe_person_images()

