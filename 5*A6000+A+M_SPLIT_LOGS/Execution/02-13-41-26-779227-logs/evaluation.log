detected_objects, object_number = object_detector.execute(image=image_path, labels=labels, confidence_threshold=confidence_threshold, model_size="tiny", save_object=True, saved_image_path="detected_objects")

if "detected_objects" in object_number:
    total_objects_count = sum(detected_objects["object_number"])
    if detected_objects["detected_objects"] and total_objects_count >= 1:
        final_result = f"{total_objects_count} person(s) wearing a green jacket"
    else:
        final_result = "No person(s) wearing a green jacket"
else:
    final_result = "No detected objects."

final_result

