Code: from object_detector import Object_Detector_Tool as object_detector_tool

# Load an image
img_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg"

# Create an Object_Detector_Tool object
detector_tool = object_detector_tool()

# Detect objects
labels_to_find = ["baseball", "basketball"]
detected_objects, object_num = detector_tool.execute(image=img_path, labels=labels_to_find, save_object=True)

# Count detected objects
for label in labels_to_find:
    object_num[label] += detected_objects[label]

# Calculate the percentage of detected objects
total_objects = sum(object_num.values())
if total_objects > 0:
    detected_objects_percentage = (object_num.values() / total_objects) * 100
else:
    detected_objects_percentage = 0

final_result = detected_objects_percentage

print("The detected objects percentage in the image:", final_result)

