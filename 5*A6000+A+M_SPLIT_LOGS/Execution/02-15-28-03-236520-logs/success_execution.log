from object_detector import Object_Detector_Tool

# Function to detect and count skiing activities
def count_skiing_activities(image_path):
    # Load the image
    detector_tool = Object_Detector_Tool()

    # Detect objects in the image
    labels = ["skiier"]
    detections = detector_tool.run(image_path, labels, 0.3)

    # Count skiers by observing their bounding boxes
    skiers_count = sum(1 for _, box in detections["boxes"] if box["label"] == "skier")

    final_result = skiers_count
    return final_result

# Example usage: count_skiing_activities("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_44_image_1.jpg")
