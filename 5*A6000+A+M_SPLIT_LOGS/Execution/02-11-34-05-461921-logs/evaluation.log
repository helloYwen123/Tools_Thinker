Code: from object_detector import Object_Detector_Tool

# Function to count people wearing yellow shirts in the image
def count_people_wearing_yellow_shirt(image_path):
    tool = Object_Detector_Tool()
    
    # Load the image file and perform object detection
    detected_object_images = tool.execute(image_path, labels=["yellow shirt"], save_object=True)
    
    total_count = {}
    
    # Iterate over each detected object
    for label, detected_objects in tool.output['object_number']:
        if label == "yellow shirt":
            # Count the number of objects with a yellow shirt
            total_count[label] = 1 + len(detected_objects['boxes'])
    
    return total_count
    
# Path of the image
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_119_image_1.jpg"

# Count people wearing yellow shirts in the image
total_count = count_people_wearing_yellow_shirt(path_to_image)
final_result = max(total_count, key=total_count.get)
print(final_result)

