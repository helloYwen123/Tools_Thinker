Code: from object_detector import Object_Detector_Tool

# Load image
object_detector = Object_Detector_Tool()

# Execute tool
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_100_image_1.jpg'
labels = ["baseball", "basket"]
save_object = True
saved_image_path = "detected_objects"

result = object_detector.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

# Analyze result
result_analysis = {
    "number": result["output_types"][1]["object_number"],
    "detection_results": result["output_types"][1]["detected_objects"]
}

final_result = max(result_analysis, key=result_analysis.get)

print(final_result)

