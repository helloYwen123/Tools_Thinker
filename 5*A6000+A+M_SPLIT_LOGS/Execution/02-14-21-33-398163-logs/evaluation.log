Code: from object_detector import Object_Detector_Tool

# Call the tool to detect 'baseball' and 'basket' in the image.
detected_objects, object_number = Object_Detector_Tool.execute(image="path/to/schoolbus.jpg", labels=["baseball", "basket"],  save_object=True, saved_image_path="detected_objects")

if detected_objects:
    for label, details in detected_objects.items():
        if "boxes" in details:
            num_kids = 0
            for box in details["boxes"]:
                # Assuming the box is around the front of the bus. You may need to adjust this based on the bus layout.
                if box["x1"] < 0.1 or box["x2"] > len(detected_objects) * box["y2"] - 1:
                    continue
                else:
                    num_kids += 1
            final_result = f"Number of kids in front of the yellow schoolbus: {num_kids}"
else:
    final_result = "No detectable objects."

print(final_result)

