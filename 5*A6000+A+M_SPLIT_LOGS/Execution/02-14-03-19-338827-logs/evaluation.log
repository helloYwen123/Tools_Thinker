Code: # This program uses the Object_Detector_Tool tool to detect and count tomatoes in the image.
            # The input path is assumed to be the path to the image.
            # The detected object labels are set to 'tomatoes' for counting.
            # The threshold is set to 0.45 to have a high confidence for detection.
            # The saved_object flag is set to True to save the detected objects.
            # The output is a tuple containing dictionary data and a dictionary with tomato counts.
    
            def count_tomatoes(image):
                tool_path = "path/to/grounding_dino_tool"
                tool_params = {'image': image, 'labels': ['tomatoes'], 'threshold': 0.45, 'save_object': True}
                detected_objects, object_number = Object_Detector_Tool.execute(image=image, labels=["tomatoes"], save_object=True, **tool_params)
                
                tomato_count = object_number.get('tomatoes', 0)
                returned_data = {
                    'detected_objects': detected_objects,
                    'tomato_count': tomato_count
                }
                
                return returned_data, tomato_count
            

# Using the provided image_path
