Code: from object_detector import Object_Detector_Tool

# Set the image path
object_detector_tool = Object_Detector_Tool()
# Set the labels to detect
labels = [1, 2]  # Labels: 1 for train, 2 for stopped train
# Set the confidence threshold
threshold = 0.45  # Default threshold
# Set the model size (tiny or base)
model_size = "tiny"

# Call the tool
result_dict = object_detector_tool.execute(image="path/to/image.jpg", labels=labels, threshold=threshold, model_size=model_size, save_object=False)

# Extract the train label and its count
train_count = result_dict["object_number"]["baseball"]
final_result = train_count
print(final_result)

