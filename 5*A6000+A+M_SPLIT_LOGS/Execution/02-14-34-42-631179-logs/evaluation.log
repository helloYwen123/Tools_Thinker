        threshold=threshold,
        model_size=model_size,
    )

    if final_result["object_number"] == 2:
        print("Correct result: There are 2 blue towels in the picture.")
    else:
        print("Wrong result: The number of blue towels is not correct.")

if __name__ == "__main__":
    main()

