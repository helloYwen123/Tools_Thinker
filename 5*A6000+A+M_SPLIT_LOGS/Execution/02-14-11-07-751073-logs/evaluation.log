Code: import image_object_detector  # Using a hypothetical Image Object Detection Tool object_name

def find_blue_circle(image_path):  # Using the image_path variable
    object_number_dict = {}  # A dictionary to store the blue circles' information
    blue_circle_count = 0  # A counter to keep track of the number of blue circles
    
    # Detect blue circles using Object_Detector_Tool
    object_results = image_object_detector.execute(image_path, labels=["blue_circle"])
    
    for object_result in object_results:
        # Extract blue circle information
        x, y, width, height = object_result['bbox']['x'], object_result['bbox']['y'], object_result['bbox']['width'], object_result['bbox']['height']
        circle_count = object_result['bbox']['count']
        circle_x = x + round(width / 2)
        circle_y = y + round(height / 2)
        
        # Check if the circle is in the target region
        if circle_x >= x and circle_x < x + width and circle_y >= y and circle_y < y + height and x < circle_x < (x - width) and y < circle_y < (y - height):
            blue_circle_count += circle_count
    
        # Store blue circle information in the dictionary
        object_number_dict[object_result.get('label')] = {'boxes': [object_result.get('bbox')], 'confidence_scores': object_result.get('score'), 'total_count': circle_count}
        blue_circle_count += 1
    
    return {'total_count': blue_circle_count, 'number_of_found_blue_circles': blue_circle_count, 'number_of_labels': len(object_number_dict), 'object_number_dict': object_number_dict, 'final_result': final_result}

