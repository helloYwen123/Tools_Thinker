def count_i_words_in_sign(image_path):
    # Load the image and detect objects
    detector_tool = object_detector.Object_Detector_Tool()
    detected_objects, object_count = detector_tool.execute(image_path, labels=["I", "i", "i", "i"], save_object=False, saved_image_path="Detected_Sign")

    # Count the number of words containing 'i' in each found object
    word_counts = {}
    for label in object_count:
        # Filter objects with 'i' in their name
        words_with_i = [object['name'] for object in detected_objects[label] if 'i' in object['name']]
        for i, word in enumerate(words_with_i):
            word_counts[word] = word_counts.get(word, 0) + 1

    # Final result
    final_result = sum(word_counts.values())
    return final_result
