void test_object(int input, int output) {
    string label = "Sheep";
    std::vector<int> saved_images;
    double confidence_threshold = 0.45;

    cv::Mat image(input, cv::IMWRITE_JPEG_QUALITY, 90);
    if (opencv::image_detect(image, label, saved_images, confidence_threshold) == 0) {
        std::cerr << "Failed to detect " << label << " in image. " << std::endl;
