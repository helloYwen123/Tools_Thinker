Code: from object_detector import Object_Detector_Tool

# Define the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_52_image_1.jpg"

# Initialize the object detector tool
detector_tool = Object_Detector_Tool(image_path, save_object=True)

# Detect the 'baseball' and 'basket'
detected_objects = detector_tool.execute(labels=["baseball", "basket"], save_object=True)

# Get the count of the detected objects
labels = "baseball"
count = len(detected_objects["labels"].get(labels, {}))
final_result = max(count.values())  # Return the maximum occurrence as their count
print("Occurrences of baseball and basket:", final_result)
if count:
    print("Detected baseball and basket in the image.")
else:
    print("No baseball and basket detected.")

