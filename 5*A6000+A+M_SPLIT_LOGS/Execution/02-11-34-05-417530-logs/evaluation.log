Code: from object_detector import Object_Detector_Tool

# Load the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_115_image_1.jpg"
object_dto = Object_Detector_Tool(image_path)

# Detect labels and count birds
labels = ["sandpiper", "black-beak"]
boxes, conf_scores, count_dict = object_dto.execute(labels=labels, threshold=0.35, model_size="tiny", save_object=False)

# Filter for sandpipers and count them
count_sandpiper = count_dict[labels[0]]

# Determine the right side of the frame
left_threshold = count_sandpiper * 0.5
right_threshold = count_sandpiper * 1.5

# Calculate the number of birds facing right
right_bird_count = 0
for bird_label, count in count_dict.items():
    if count > 0 and (left_threshold <= float(bird_label) < right_threshold) or left_threshold >= count <= right_threshold:
        right_bird_count += 1
        break

final_result = (
    "B",
    right_bird_count,
)

final_result

