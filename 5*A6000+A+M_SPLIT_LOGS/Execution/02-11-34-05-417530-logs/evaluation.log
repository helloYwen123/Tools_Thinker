path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_115_image_1.jpg"

# Initialize the Object_Detector_Tool
tool = Object_Detector_Tool()

# Execute the tool and get the results
detected_objects, bird_counts = tool.execute(image=path_to_image, labels=["bird"], save_object=True)

# Convert the bird_counts dictionary to a list
bird_counts_list = list(bird_counts.values())

# Determine if the first bird counts
is_first_bird_count = bird_counts_list[0]

# Check if the first bird counts are greater than 0
final_result = "B" if is_first_bird_count == 1 else "F"

print(final_result)

