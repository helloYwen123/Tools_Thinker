import object_detector

def count_white_uniforms(image_path):
    # Call the function with the image path
    detected_objects, object_number = object_detector.execute(image_path=image_path, labels=['baseball'] + ['player'], labels_threshold=0.45, save_object=True, saved_image_path="detected_objects")
        
    # Get the number of detected players
    num_players = sum([int(detected_objects[label]['count'] == 1) for label in ["player"]])
    
    return num_players

