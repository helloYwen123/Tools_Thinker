Code: # Import necessary tool and image path
from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_7_image_1.jpg"

# Initialize the object detector tool
object_detector = Object_Detector_Tool()

# Execute the tool
detected_objects, object_number = object_detector.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Calculate the number of baseball players looking towards the camera
baseball_players = sum([x["count"] for label, x in detected_objects["baseball"].items() if x["boxes"]])
basketball_players = sum([x["count"] for label, x in detected_objects["basket"].items() if x["boxes"]])

final_result = baseball_players

print(f"The number of baseball players looking towards the camera is: {final_result}")

