Code: from object_detector import Object_Detector_Tool

# Define the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_78_image_1.jpg"

# Create the object detector tool instance
tool = Object_Detector_Tool()

# Execute the tool with labels ['tower', 'clock'], minimum object confidence score of 0.4, tiny model, and save the results
tool.execute(image=image_path, labels=["tower", "clock"], threshold=0.4, model_size="tiny", save_object=True, saved_image_path="detected_objects")

# Calculate the total number of trees in the image
total_object_count = len(tool.output_types[0][1]["boxes"])

# Find the first object matching the "tower" label in the detected objects dictionary
tower_objects = tool.output_types[0][1]["boxes"]["tower"]
tower_count = len(tower_objects)

# Determine the number of people climbing on the wall
climbing_people = total_object_count - tower_count

print(f"Number of people climbing on the wall: {climbing_people}")

