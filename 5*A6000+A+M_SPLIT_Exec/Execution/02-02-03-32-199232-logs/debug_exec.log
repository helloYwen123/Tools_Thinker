# Function to count the number of detected objects in a mirror reflection
def count_objects_in_reflection():
    # Call the tool to detect objects and get object labels and their bounding boxes
    object_labels, object_boxes, object_scores = Object_Detector_Tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_75_image_1.jpg", labels=["person"], model_size="tiny", save_object=False, saved_image_path="detected_objects")
    
    # Convert bounding box to a list of coordinates
    detected_objects = {obj: obj_boxes for obj, boxes in object_boxes.items()}
    
    # Count the numbers of objects in the image
    object_counts = {obj: len(detected_objects[obj]) for obj in detected_objects}
    
    return object_counts

