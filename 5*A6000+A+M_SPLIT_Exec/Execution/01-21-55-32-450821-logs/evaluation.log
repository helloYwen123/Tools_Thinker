Code: from object_detector import Object_Detector_Tool

object_detector_tool = Object_Detector_Tool()

image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_61_image_1.jpg" # Path to the image

# Load the image and detect objects using the tool
result = object_detector_tool.execute(image=image_path, labels=["motorcycle_sitting_people"])

motorcycle_boxes = result["bboxes_motorcycle_sitting_people"]
motorcycle_scores = result["scores_motorcycle_sitting_people"]
motorcycle_save_path = "motorcycle_sitting_people"

# Determine how many people are sitting near the motorcycle
num_people_sitting = 0
for box in motorcycle_boxes:
    # Get the location of the person
    person_box = box["box"]
    person_box = [(p["x"], p["y"], p["w"], p["h"]) for p in person_box]

    # Calculate the overlap between the person's bounding box and the motorcycle's bounding box
    overlap_x = max(0, min(person_box[2], motorcycle_boxes[0]["x"]))
    overlap_y = max(0, min(person_box[3], motorcycle_boxes[0]["y"]))
    overlap_w = max(0, motorcyle_boxes[0]["x"] - overlap_x + 1)
    overlap_h = max(0, motorcyle_boxes[0]["y"] - overlap_y + 1)

    # Compute the center of the overlapping area
    overlapping_center = [
        (overlap_x + overlap_w) / 2.0,
        (overlap_y + overlap_h) / 2.0
    ]
    if (motorcyle_boxes[0]["x"] < overlapping_center[0] < motorcycle_boxes[0]["x"] + motorcycle_boxes[0]["w"]) and \
       (motorcyle_boxes[0]["y"] < overlapping_center[1] < motorcycle_boxes[0]["y"] + motorcycle_boxes[0]["h"]) and \
       (motorcyle_boxes[0]["w"] > overlap_x + motorcycle_boxes[0]["w"]) and \
       (motorcyle_boxes[0]["h"] > overlap_y + motorcycle_boxes[0]["h"]):
        num_people_sitting += 1

print("The tool detected", motorcyle_boxes, "motorcycle_boxes.")
print("\nThe number of people sitting near the motorcycle is:", num_people_sitting)

