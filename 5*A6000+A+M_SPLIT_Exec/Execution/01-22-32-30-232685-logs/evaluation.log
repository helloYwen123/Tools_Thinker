Code: from object_detector import Object_Detector_Tool

# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_101_image_1.jpg"
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=["ground"], save_object=True, 
                                                              saved_image_path="detected_objects")

# Count the number of detection results and check if any red building
total_objects = len(detected_objects[1])
objects_info = detected_objects[0]
for label, boxes, _ in detected_objects[1]:
    object_count = sum(boxes['boxes'].any(axis=1) for boxes in boxes.values)
    if label == 'ground' and object_count == 1:
        final_result[object_count][0] += 1

total_detections = object_number + total_objects
if total_detections == 0:
    final_result[total_detections][0] -= 1
else:
    total_detections = max(0, total_detections)
    if total_detections == 0:
        final_result[total_detections][1] -= 1
    if final_result:
        final_result[total_detections][0] += 1
        for i in range(total_detections):
            final_result[i+1][1] += final_result[i][1]

# Convert detection results dictionary to markdown format
with open("/home/stud/wxie/BLINK_A4/101_list.md", "w") as f:
    f.write(" | Object ID                   | Total Detection \n|----------------------------|----------------\n| 1                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[0:10]) + "\n" + " " + "* * \n| 2                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[10:20]) + "\n" + " " + "* * \n| 3                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[20:30]) + "\n" + " " + "* * \n| 4                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[30:40]) + "\n" + " " + "* * \n| 5                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[40:50]) + "\n" + " " + "* * \n| 6                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[50:60]) + "\n" + " " + "* * \n| 7                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[60:70]) + "\n" + " " + "* * \n| 8                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[70:80]) + "\n" + " " + "* * \n| 9                                   | " + " ".join(str(object_count) for object_count in list(final_result.values())[80:90]) + "\n" + " " + "* * \n| 10  | " + " ".join(str(object_count) for object_count in list(final_result.values())[90:101]) + "\n" + " * * \n| total                     | " + " ".join(str(object_count) for object_count in list(final_result.values())[-1:]))

