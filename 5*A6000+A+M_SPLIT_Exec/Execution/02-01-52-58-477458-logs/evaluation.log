class Image_081114:

    def __init__(self):
        self.image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_115_image_1.jpg'
        
    def analyze_image(self):
        detector = Object_Detector_Tool(self.image_path)
        
        all_labels = detector.detect_labels()
        
        baseball_labels = []
        basket_labels = []
        
        for label in all_labels:
            if label == "baseball":
                baseball_labels.append(label)
            elif label == "basket":
                basket_labels.append(label)
        
        if len(baseball_labels) > 0:
            return {"count": len(baseball_labels)}
        elif len(basket_labels) > 0:
            return {"count": len(basket_labels)}
        else:
            return {"count": 0}



result = Image_081114().analyze_image()
for label, count in result.items():
    print(f"{label}: {count}")
        
final_result = {"count": 1, "bbox": {"count": 1, "bbox": {"bbox": [[0.42312942, 0.531587, 0.75429627, 0.68324347]], "confidence_scores": [], "saved_image_paths": []}}}
