labels = ["white_faced_buffalo_horned"]
threshold = 0.45

# Execute the function
detected_objects, object_count = Object_Detector_Tool.execute(image="val_Counting_115_image_1.jpg", labels=labels, threshold=threshold, saved_object=False)

# Check if there are exactly 1 bird facing right
num_birds_right = detected_objects["white_faced_buffalo_horned"][0]["boxes"][0]["x"] + detected_objects["white_faced_buffalo_horned"][0]["boxes"][0]["width"] >= 1

final_result = dict()

if num_birds_right:
    if (labels) in object_count:
        object_count[labels]["right"] = object_count[labels]["right"] + 1
    else:
        object_count[labels] = dict()
        object_count[labels]["right"] = 1

# Return final result
final_result["birds_right"] = object_count["white_faced_buffalo_horned"]["right"]

