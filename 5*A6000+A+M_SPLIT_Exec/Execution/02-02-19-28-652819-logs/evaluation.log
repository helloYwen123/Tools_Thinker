Code: from object_detector import Object_Detector_Tool

# Given image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_89_image_1.jpg"

# Detect labels
labels_to_detect = ["baseball", "basket"]

# Set threshold and model size
threshold = 0.45
model_size = "tiny"

# Execute the tool
object_detection_results = Object_Detector_Tool.execute(image_path, labels=labels_to_detect, threshold=threshold, model_size=model_size, save_object=True)

# Check if labels are detected
labels_found = False
for labels_box in object_detection_results['object_number']:
    label_count = labels_box['count']
    if label_count > 0:
        labels_found = True
        break

final_result = labels_found
print("Number of plates on the counter:", final_result)

