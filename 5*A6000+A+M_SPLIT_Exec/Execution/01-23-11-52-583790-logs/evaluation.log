Code: def detect_objects(image_path, labels=None, save_output=False, saved_image_path='detected_objects'):
    """
    Detect objects in an image using the Grounding DINO model.

    Args:
        image_path (str): The path to the image file.
        labels (list): A list of object labels to detect.
        save_output (bool): Whether to save the detected objects as images.
        saved_image_path (str): The path to save the detected object images (default: 'detected_objects').
    """
    
    from object_detector import Object_Detector_Tool
    tool = Object_Detector_Tool()
    
    object_results = tool.execute(
        image=image_path,
        labels=labels,
        save_output=save_output,
        saved_image_path=saved_image_path)
    
    label_counts = {label: len(objects) for label, objects in object_results}

    return label_counts

