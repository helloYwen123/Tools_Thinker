Code: from object_detector import Object_Detector_Tool

# Load the labels from the list
labels = ['mussels', 'lemon', 'fish', 'salmon', 'meat', 'cheese'] 

# Create the object detector
detect = Object_Detector_Tool()

# Load the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Art_541_image_1.jpg'

# Execute the object detection on the image
detections = detect.execute(image=image_path, labels=labels, threshold=0.45, model_size='tiny', save_object=True, saved_image_path="detections")

# Count the number of detections
detection_counts = len(detections)

# Determine the final answer
final_result = [str(count) for count in detection_counts]

final_result

