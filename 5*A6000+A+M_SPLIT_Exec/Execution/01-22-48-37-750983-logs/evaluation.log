Code: from ground_dino_toolkit import Object_Detector_Tool as detect

# Load the saved object metadata
detected_objects = detect.load_saved_object_metadata("detected_objects")

# Get the positions of all the kids in front of the bus
kids_positions = []

for label, detection_results in detected_objects.items():
    boxes = [box["x1"], box["y1"], box["x2"], box["y2"], label]  
    for boxes_per_label, detected_objects_per_label in detection_results.items():  
        for box in boxes_per_label["boxes"]:
            x1, y1, x2, y2 = boxes
            kids_positions.append([x1, y1, x2, y2, label])

# Select the top 3 kids
kid_1 = [kid[0] for kid in kids_positions if kid[3] == "first student"][0]
kid_2 = [kid[0] for kid in kids_positions if kid[3] == "first student"][1]
kid_3 = [kid[0] for kid in kids_positions if kid[3] == "first student"][2]

# The answer is the number of kids in front
final_result = kid_1 + kid_2 + kid_3

