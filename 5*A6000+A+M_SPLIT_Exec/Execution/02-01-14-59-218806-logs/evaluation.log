objects, object_count = object_detector_tool.execute(image=image_path, labels=["car"], save_object=True, saved_image_path="detected_objects", threshold=0.45)

# Get the count of cars
car_count = object_count["car"]
car_info = objects[1]["boxes"]

# Extract the coordinates of the car
car_left = car_info["bbox"][0][0]
car_top = car_info["bbox"][0][2]
car_right = car_info["bbox"][1][0]
car_bottom = car_info["bbox"][1][2]

# Calculate the coordinates of the car on the tracks
car_left_on_track = max(car_left, car_top)
car_right_on_track = min(car_right, car_bottom)
car_up_on_track = max(car_top, car_left)
car_down_on_track = min(car_bottom, car_right)

# Calculate the number of people driving the car
people_count = car_up_on_track - car_down_on_track

# Calculate the final result
final_result = {"people_count": people_count}

