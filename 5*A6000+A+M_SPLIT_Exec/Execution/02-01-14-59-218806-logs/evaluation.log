Code: def count_people_in_car(image_path, labels=['car'], threshold=0.45, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
    from object_detector import Object_Detector_Tool

    obj_detector = Object_Detector_Tool(object_labels=labels)
    obj_detector.run(image_path, labels=labels, model_size=model_size, threshold=threshold)
    detected_objects = obj_detector.output_results

    if save_object:
        try:
            obj_detector.save_object_detected(image_path=image_path, detected_objects=detected_objects)
            detected_objects, object_number = detected_objects
        except Exception as e:
            print(f"Error saving object detected: {e}")

    count_result = {}
    for label, results in detected_objects.items():
        count = len(results['boxes'])
        if label in ['car']:
            count_result[label] = count
    return count_result

final_result = count_people_in_car(image_path="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_99_image_1.jpg")
print("Final result:", final_result)

