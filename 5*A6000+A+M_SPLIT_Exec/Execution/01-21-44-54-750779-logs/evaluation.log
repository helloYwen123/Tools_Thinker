Code: from object_detector import Object_Detector_Tool

# Path to the image
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_81_image_1.jpg"

# Label to detect
label_to_detect = "red"

# Confidence threshold
confidence_threshold = 0.45

# Model size
model_size = "tiny"

# Save detected objects
save_detected_objects = True

# Save detected object image paths
saved_image_path = "detected_objects"

# Detect objects
detector_tool = Object_Detector_Tool()
result = detector_tool.execute(image=path_to_image, labels=[label_to_detect], save_object=save_detected_objects, saved_image_path=saved_image_path, model_size=model_size)

# Check if objects were detected
if not "error" in result:
    # Group results by label and count objects
    grouping_result = result[0]
    objects_count = grouping_result.get("total", 0)

    if label_to_detect.lower() in objects_count:
        # Get the objects
        objects = grouping_result.get("objects", [])
        if label_to_detect.lower() in objects:  # Check if the label was detected
            objects_count = objects_count + 1

        # Print the label and count
        print(f"{label_to_detect}:\nCount: {objects_count}")
else:
    print("Error detected while executing the tool.")

