Code: def count_red_shirt_players(image_path):
    # Load the image
    image = Object_Detector_Tool(image_path=image_path, labels=["red shirt"])

    # Get the total number of detected labels
    label_counts = image.output_types[1]['label_counts']

    # Count the number of red-shirted players
    red_squad_count = 0
    for label in label_counts:
        if label['label'] == 'red shirt':
            red_squad_count += label_counts[label['label']]

    return red_squad_count

final_result = count_red_shirt_players("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_81_image_1.jpg")
print("Total number of players wearing red shirts:", final_result)

