Code: from object_detector import Object_Detector_Tool

class AnswerGenerator:
    def detect_objects_and_count(self, image_path):
        detector_tool = Object_Detector_Tool()
        
        with open(image_path, 'rb') as image_file:
            image_data = image_file.read()
        
        label_dict = {}
        total_label_count = {}

        # Detect objects in the image
        detected_results = detector_tool.execute(image_data, labels=['wine', 'glass'], return_labels=True)

        total_labels = len(detected_results)
        label_dict = detected_results
        
        # Count the number of objects for each label
        for label in label_dict:
            label_count = label_dict[label]
            label_count['count'] = total_labels if len(label_count) > total_labels else 1
            total_label_count[label] = total_label_count.get(label, 0) + label_count['count']

        for label in total_label_count:
            total_label_count[label]['label'] = label
        
        final_result = {'labels': sorted(label_dict, key=lambda el: -total_label_count[el]['count'], reverse=True), 'count': total_labels}
        return final_result

# Example usage
if __name__ == "__main__":
    final_result = AnswerGenerator().detect_objects_and_count("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_53_image_1.jpg")
    
    if final_result:
        print(final_result)
    elif final_result['count']:
        print(f"The image contains {final_result['count']} objects of the {final_result['labels'][0]} label.")
    else:
        print("No objects found in the image.")

