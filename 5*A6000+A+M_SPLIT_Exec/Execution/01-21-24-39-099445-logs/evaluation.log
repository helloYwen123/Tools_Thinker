Code: from object_detector import Object_Detector_Tool

# paths to image file and labels (in the order detected by Object_Detector_Tool)
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_53_image_1.jpg"
labels = ["chair", "wine_glass"]


def check_labels(path):
    detections = Object_Detector_Tool.execute(image_path, labels=labels, threshold=0.45, save_object=True)
    labels_count = {}
    for label, details in detections.items():
        if label not in labels_count:
            labels_count[label] = 0
        labels_count[label] += details["total_count"]
    return labels_count


labels_count = check_labels(image_path)

final_result = {"labels": labels_count.keys(), "count": labels_count, "total_count": sum(labels_count.values())}

print(final_result)

