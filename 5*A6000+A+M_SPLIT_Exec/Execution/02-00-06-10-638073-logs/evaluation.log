Code: from object_detector_tool import Object_Detector_Tool as OTD

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_85_image_1.jpg"

# Function to detect and count 'baseball' and 'basket' in the image
def count_objects(image_path, labels, threshold=0.45, model_size="tiny", save_object=False):
    # Load the image
    image_data = OTD.open_image(image_path)

    # Detect objects using the Grounding DINO model
    detected_objects = OTD.detect_objects(image_data, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

    # Get the number of objects
    object_count = OTD.extract_object_count(detected_objects)

    # Return the number of objects
    return object_count

# Call the function to count objects
objects_count = count_objects(image_path, ["baseball", "basket"])

# Print the resulting count
final_result = f"There are {objects_count} baseballs and basketballs detected in the image."
print(final_result)

