Code: from object_detector import Object_Detector_Tool

# Image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_113_image_1.jpg"

# Threshold for detection
threshold = 0.45

# Size of the model
model_name = "base"

# Save the detected objects as images or not
save_object = False

# Demo command to detect 'baseball' and 'basket'
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=save_object, threshold=threshold, model_size=model_name)

# Extract information about the detected objects
all_objects = detected_objects['detected_objects']
all_objects_per_label = detected_objects['output_types'][1]

# Count the total number of 'baseball' and 'basket' detected objects
total_baseball_items = total_basketball_items = 0

# Iterate through each label and count the objects
for label, label_count in all_objects_per_label.items():
    if label == 'baseball':
        total_baseball_items += label_count['boxes'].shape[0] * label_count['confidence_scores'].shape[0]
    elif label == 'basket':
        total_basketball_items += label_count['boxes'].shape[0] * label_count['confidence_scores'].shape[0]

# Calculate the final result
total_result = total_baseball_items + total_basketball_items

final_result = (total_baseball_items, total_basketball_items, total_result)

