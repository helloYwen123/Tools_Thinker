Code: from object_detector import Object_Detector_Tool

def count_people_with_red_shirt(image_path):
    # Load the image
    detector = Object_Detector_Tool(image_path)

    # Detect people with solid red shirts
    results = detector.detect_people(
        labels=['baseball', 'basket'],
        threshold=0.45,
        model_size='tiny',
        save_object=True,
        saved_image_path='detected_objects'
    )

    # Count people with solid red shirts
    red_shirt_count = results['object_number']['baseball'] + results['object_number']['basket']
    return red_shirt_count

# Usage
final_result = count_people_with_red_shirt('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg')
print(final_result)

