Code: from object_detector import Object_Detector_Tool

# Load image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg"

# Create an Object_Detector_Tool instance
detector = Object_Detector_Tool(image_path=image_path, labels=["solid_red"])

# Initialize counters
total_count = 0
counts_by_label = {}

# Detect and count objects
for label in detector.labels:
    if label in "red".lower():
        counts_by_label[label] = detector.labels.count(label)
        total_count += counts_by_label[label]

print(f"Total people wearing solid red shirts: {total_count}")

