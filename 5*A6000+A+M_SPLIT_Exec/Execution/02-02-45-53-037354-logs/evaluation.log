Code: from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg"

# Detect objects
result = Object_Detector_Tool.execute(image_path, labels=["baseball", "basket"], save_object=True)

# Get total count of 'baseball' and 'basket' objects in the image
total_count_baseball = result["combined_output"][0]["box_counts"]["baseball"]
total_count_basket = result["combined_output"][0]["box_counts"]["basket"]

# Count people wearing solid red shirts
red_shirt_count = 0
red_people_count = 0

# Loop through people and count those wearing solid red shirts
for people in result["object_count"]:
    for people_label in people:
        if people_label["name"] == "red_shirt":
            red_shirt_count += 1
        elif people_label["name"] == "person":
            red_people_count += people_label["number"]

# Final result
total_count = total_count_baseball + total_count_basket
    
final_result = {"total_count_baseball": total_count_baseball, "total_count_basket": total_count_basket, "red_shirt_count": red_shirt_count, "red_people_count": red_people_count, "total_count": total_count}

