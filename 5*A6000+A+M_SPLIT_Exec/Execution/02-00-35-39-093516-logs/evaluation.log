def get_white_umbrellas():
    # Load image and labels
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_67_image_1.jpg"
    labels = ['baseball', 'basket']
    
    # Initialize detector
    object_detector = Object_Detector_Tool(image_path=image_path, labels=labels)
    
    # Detect objects
    results = object_detector.execute(confidence_threshold=0.45)
    
    # Count detected objects
    obj_counts = object_detector.output_types["object_number"]
    white_umbrellas = [obj for obj in results if obj["label"] == "baseball" and "white_umbrellas" in obj["boxes"]]
    
    return {"count": len(white_umbrellas), "count_type": "baseball white umbrella(s)"}, white_umbrellas

