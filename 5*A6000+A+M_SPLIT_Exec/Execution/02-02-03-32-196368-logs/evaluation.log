Code: from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_104_image_1.jpg"

# List of object labels to detect
labels = ["baseball", "basket"]

# Confidence threshold
threshold = 0.5

# Size of the model to use ("tiny" or "base", default: "tiny")
model_size = "tiny"

# Whether to save the detected objects as images (default: False)
save_object = True

# Path to the saved object images
saved_object_path = "detected_objects"

# Run the object detector
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

# Extract the labels
labels_to_find = ["baseball", "basket"]

# Count the occurrences of the labels
count = 0
for label in detected_objects:
    found = False
    for obj in label["boxes"]:
        if obj in labels_to_find:
            found = True
            break
    if found:
        count += 1

# Calculate the final result with the provided examples
final_result = {"A": count}

