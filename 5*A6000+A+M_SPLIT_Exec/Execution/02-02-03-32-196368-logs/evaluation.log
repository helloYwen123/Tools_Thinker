Code: from object_detector import Object_Detector_Tool

# Read the image path
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_104_image_1.jpg"

# Create the Object_Detector_Tool object
tool = Object_Detector_Tool()

# Call the method to detect objects in the image
results = tool.execute(image=path_to_image, labels=["baseball", "basket"], save_object=True, saved_image_path="Detected_ObjectImages")

# Convert the results to a dictionary
detected_objects = results["output_types"][0]

# Count the total number of boxes for detected objects
total_objects = 0
for label in results["output_types"][1]:
    total_objects += len(detected_objects["boxes"][label]["boxes"])

print("Number of boxes detected: " + str(total_objects))

