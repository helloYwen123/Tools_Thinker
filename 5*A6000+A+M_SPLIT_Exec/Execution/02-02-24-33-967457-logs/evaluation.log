Code: import cv2
from tool_module.object_detector import Object_Detector_Tool

def count_bottles(image_path):
    with Object_Detector_Tool('baseball', threshold=0.45, model_size='tiny') as tool:
        results = tool.execute(image_path=image_path, labels=["baseball", "basket"], save_object=True)
        total_container_count = results["object_number"].values().sum()

    return total_container_count

result = count_bottles('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_112_image_1.jpg')
final_result = result['object_number']
print(final_result)

