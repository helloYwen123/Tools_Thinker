Code: from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_112_image_1.jpg"

# Detection configuration
labels = ["baseball", "basket"]
bbox_threshold = 0.45
model_size = "tiny"

# Load the object detector model with given configuration
object_detector = Object_Detector_Tool(image_path, labels, bbox_threshold)
object_detector.load_model(model_size)

# Perform object detection on the image
detected_objects, detections_number = object_detector.execute()

# Retrieve the count for each detected object label
label_counts = object_detector.output_types[0][1]

# Filter detected objects by the "baseball" label
baseball_objects = [f"detected_objects[label_counts[label]]" for label, count in detections_number.items() if "baseball" in label]
basket_objects = [f"detected_objects[label_counts[label_1] if 'basket' in label else 'basket' for label_1 in label_counts][label_counts.keys()] 

# Display detected objects (baseball and basket)
print("Baseball objects detected:", baseball_objects)
print("Basket objects detected:", basket_objects)

