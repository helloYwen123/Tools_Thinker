Code: def count_black_toilets(input_path):
    # Load the ImageDINO Model
    from object_detector_tool.object_detector import Object_Detector_Tool
    tool = Object_Detector_Tool(input_path, labels=["toilet"], threshold=0.45, model_size="base", saved_object=True)
    result = tool.output_results
    result['data']['boxes'] = [box.width for box in result['data']['boxes'] if box.label == 'toilet']
    return len(result['data']['boxes'])

