from object_detector import Object_Detector_Tool

# Initialize the object detector tool
obj_detector = Object_Detector_Tool()

# Set the image_path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_2_image_1.jpg"

# Set the object labels
objects_labels = ["toilet"]

# Set the threshold for detection confidence
threshold = 0.45

try:
    # Execute the object detection
    detected_objects, object_number_dict = obj_detector.execute(image=image_path, labels=objects_labels, threshold=threshold, save_object=True, saved_image_path="detected_objects")

    # Check if any objects were detected
    if bool(detected_objects) is True:
        # Store the count in the variable final_result
        final_result = object_number_dict
        # Print the result
        print(f"Found {len(final_result)} black toilets.")
    else:
        # Print no toilets found
        print("No black toilets found.")
except FileNotFoundError:
    print("File not found.")
except Exception as e:
    print(f"An error occurred: {e}")
finally:
    # Clean up (deletion can be added to this path if appropriate)
    del obj_detector
