from object_detector import Object_Detector_Tool

def count_and_locate_interest_objects(image_path, labels, models='tiny', save_objects=True):
    labels_dict = {'baseball': [], 'basket': []}
    for label in labels:
        results = []
        for i in range(0, 1000):  # Assume 1000 images per label
            model = Object_Detector_Tool.models_to_dict.get(models, {}).get(f'tiny:{models}', {'model_size': models}).get('model_size', 'tiny')
            detector = Object_Detector_Tool(image_path, model, threshold=0.35, model_size=model, save_objects=save_objects, saved_image_path=f'detected_objects')
            results.extend(detector.execute(labels=[label]))

        all_results = sum([label_objects[label] for label in labels], [])
        labels_dict[label] = all_results

    return labels_dict

# Example usage
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9533_0.png"
labels = ["baseball", "basket"]
result = count_and_locate_interest_objects(image_path, labels)
print(result)
```

Note: This solution assumes a model called 'tiny' is used for each language. Adjust the model size if needed.
