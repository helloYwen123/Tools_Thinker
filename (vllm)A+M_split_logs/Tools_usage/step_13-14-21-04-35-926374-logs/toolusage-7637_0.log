import text_detector  # Import the text detector tool

def detect_letter(text="English is the one of the most used language", use_lang="en", detail=0):
    tamil_boxs = text_detector.text_detector.execute(text=text, languages=[use_lang, "ta"], detail=detail)
    if tamil_boxs:
        boxs = [f'[{b[1]}, {b[0]}, [{b[2]}, {b[3}])' for b in tamil_boxs]
        results = [[f'[{bbox[0]}, {bbox[1]}] {bbox[2]}' for bbox in boxs],
                   [f'{bbox[2]}, {bbox[3]}'] for bbox in boxs]
        return results
    else:
        return []

detect_letter(use_lang="en")
```

