To answer the question about the number of paintings in the scene, we can use the "Object_Detector_Tool" tool to detect the presence of paintings in the image. We can then look at the output of the tool and count the distinct object_ids for the detected paintings.

import object_detector

def estimate_number_of_paintings(image_path):
    tool_module_name = "Object_Detector_Tool"
    tool_class_name = "Object_Detector_Tool"
    tool_version = "1.0.0"

    image = image_path
    object_labels = ["Painting"]
    labels = object_labels

    confidence_threshold = 0.35
    model_size = "tiny"

    result = object_detector.execute(image=image, labels=labels, confidence_threshold=confidence_threshold, model_size=model_size)

    if result:
        detected_objects = result[0]
        print("Detected paintings:")
        for obj in detected_objects:
            print(f"- {obj['bbox']}: Score: {obj['score']}")

        total_paintings = len(detected_objects)
        return total_paintings
    else:
        return 0

# Test the tool with an example
