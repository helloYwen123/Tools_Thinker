```python
from Text_Detector_Tool import text_detector

# Path to the image file
image_path = "/path/to/image.png"

# Languages to detect, only English is detected here
languages = ['en']

# Level of detail is set to 0 for simpler output
detail = 0

# Execute the text detection
result = text_detector.execute(image=image_path, languages=languages, detail=detail)

# Print the detected text blocks
print(result)
```
