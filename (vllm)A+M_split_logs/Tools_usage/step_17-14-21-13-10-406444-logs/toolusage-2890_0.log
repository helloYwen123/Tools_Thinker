<?php
$final_result = "";
if ($result = Text_Detector_Tool::execute($_FILES["image"]["tmp_name"])) {
  $bbox = $result[count($result) - 1]["bbox"];
  $text = $result[count($result) - 1]["text"];
  $conf = $result[count($result) - 1]["score"];

  if ($bbox && $text && $conf > 0.5) {
    $text = str_replace(["'", '"'], ["\"", "\""], $text);
    $info = [
      "bbox" => $bbox,
      "text" => $text,
      "conf" => $conf
    ];

    if (file_exists("assets/" . md5($text) . ".png")) {
      array_push($info, "assets/" . md5($text) . ".png");
      $final_result = implode(", ", $info);
    } elseif (file_exists("assets/" . md5(str_replace(["!", "\"", "\'"], ["", "\"", "\""], $text)) . "_". strlen($text) . ".png")) {
      array_push($info, "assets/" . md5(str_replace(["!", "\"", "\'"], ["", "\"", "\""], $text)) . "_". strlen($text) . ".png");
      $final_result = implode(", ", $info);
    }
  }
}

if (file_exists("/tmp/temp_image.png")) {
  $final_result = implode(", ", (array) imagedetector::execute(
    ["image" => "/tmp/temp_image.png",
      "languages" => ["zh", "de"],
      "detail" => 1
    ]
  ));
}
?>

