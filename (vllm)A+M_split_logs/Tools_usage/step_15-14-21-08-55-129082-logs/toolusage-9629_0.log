from cmd_tool import Command
from obj_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool
from word_detector_tool import Word_Detector_Tool

class Question:
    def answer(self):
        pt = Command('question_answer')
        result = pt.execute(image='question_image_image.png', languages=['en'], detail=1)

        if result:
            image_results = result['image_results']

            for img_path, resp in image_results.items():
                result = ImageSearchAlgorithm(result)
                if result:
                    for res in result['bboxes']:
                        b = res['bbox']
                        confidence = res['score']
                        box = (b['bbox_x'], b['bbox_y'], b['bbox_x'] + b['bbox_w'], b['bbox_y'] + b['bbox_h'])

                        if conf > self.confidence and resp['text'].lower().startswith('baseball') or resp['text'].lower().startswith('base'):
                            photo_name = f'baseball_{box[2]}_{box[3]}_{box[4]}_{box[5]}_2.jpg'
                            photo = 'detected_objects/{photo.name}'.format(photo=pt)

                            msg = f"Found Baseball at Location: ({bbox[0]}, {bbox[1]}, {bbox[2]}, {bbox[3]}) with Confidence: {confidence}>{self.confidence} and your response: {result['text'].split('_')[1]}"
                            return f'{msg} - {photo}'
        

        return 'No text detected at this location.'

    def execute(self):
        label_detector = Text_Detector_Tool
        bbox_detector = Object_Detector_Tool
        lefter_detector = Letter_Detector_Tool

        return {'label_detector': label_detector.text_detector,
                'bbox_detector': bbox_detector.bbox_detector,
                'letter_detector': letter_detector.detect}

    def word_detector_tool(self):
        return {'word_detector': None}

if __name__ == "__main__":
    Q = Question()
    result = Q.response()
    print(result)
```

