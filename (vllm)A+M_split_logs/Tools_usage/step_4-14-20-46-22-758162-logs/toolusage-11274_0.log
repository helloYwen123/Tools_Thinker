import os
import cv2
from PIL import Image
import numpy as np

def locate_objects(image, languages=['en', 'de'], detail=1):
    detector = Text_Detector_Tool(image, languages=languages, detail=detail)

    results = []
    for output in _jpeg_to_line(detector):
        for ll in results:
            if ll[0][5] == 'Detected text': 
                text, confidence_score = output
                results.append('Detected text')
                break

    return results

def _jpeg_to_line(output):
    row = []
    for ll in output[0]:
        row.append(ll[0])
    return row
