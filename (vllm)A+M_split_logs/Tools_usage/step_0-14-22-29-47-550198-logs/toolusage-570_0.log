from object_detector import Object_Detector_Tool

def analyze_image(image_path, labels, threshold, model_size, save_object, saved_image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, model_size=model_size,_threshold=threshold, saved_image_path=saved_image_path).detected_objects

    total_count = {}
    for label in detected_objects:
        count = detected_objects.get(label)
        if count is not None:
            total_count[label] = count + 1
        else:
            total_count[label] = 1

    result = {
        "labels": [],
        "total_count": total_count
    }

    for label, count in total_count.items():
        object_result = {
            "bbox": [det['bbox'] for det in detected_objects.get(label)],
            "text": det['text'],
            "score": str(det['score'])
        }
        result["labels"].append(object_result)

    return result

def analyze_image_left_to_right(image_path, labels, threshold, model_size, save_object, saved_image_path):
    result = analyze_image(image_path, labels, threshold, model_size, save_object, saved_image_path)

    print(f"Total number of objects: {result['total_count']}")
    for label, obj in result["labels"]:
        if label == "baseball":
            print(f"Object {label} has been detected: {obj}")
        elif label == "basket":
            print(f"Object {label} has been detected: {obj}")

# Example usage
result = analyze_image('path/to/image.png', labels=['baseball', 'basket'], threshold=0.35, save_object=True, saved_image_path='detected_objects')

analyze_image_left_to_right(result['detected_objects']['baseball'], result['detected_objects']['basket'], thresh=0.35)
```

In this Python code, `analyze_image` takes in a path to an image, a list of labels to detect, a threshold, a size for the model, a save_object flag, and a saved_image_path as arguments. It first executes the object detection using the Object_Detector_Tool and then analyzes the result
