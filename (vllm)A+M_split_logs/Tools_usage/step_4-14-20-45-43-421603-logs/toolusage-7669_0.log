```python
from letter_detector import Letter_Detector_Tool as letter_tool

def analyze_image(path_to_image, language='simplified_chinese'):
    result = letter_tool.execute(image=path_to_image)  # This will detect letters in the image
    letter_results = []
    for letter_info in result:
        if 'letter' in letter_info and 'confidence' in letter_info:
            letter_results.append((letter_info['bbox'], letter_info['letter'], letter_info['confidence']))
    return letter_results if len(letter_results) > 0 else []

# Example usage:
final_result = analyze_image('/path/to/image.png', language='simplified_chinese')  # Replace with the image path
print(final_result)
```

Please remember to adjust the `language` argument to fit your specific needs, and replace the `path_to_image` with a valid image path.
