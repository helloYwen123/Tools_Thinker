def get_non Birmingham(mobi_text):
    detection = DetectObjects(image=mobi_text)
    words_items = detection.image[0].items()
    results = []
    for item in words_items:
        if item[0].startswith('baseball') or item[0].startswith('basket'):
            results += [item]
    return results

final_result = get_non Birmingham('baseball - and baseball -')
print(final_result)
