```python
import PIPELINE
import PIPELINE.object_detector as detector
import PIPELINE.text_detector as text_detector
import PIPELINE.letter_detector as letter_detector
from PIPELINE.result import results as res
from PIPELINE.util import expand_path

def get_results(image_path, output=True, outdir='./' , languages='en')
    if output:
        results = res.execute(image_path=image_path, languages=languages)
    else:
        results = None
    
    asset_path = expand_path(image_path)  # Expands paths to assets
    return results or dict((path, {'bbox': [[x0|y0}, [x1|y1], [x2|y2]]}) for path, entry in results.items() if entry['confidence_supported'] >= conf_threshold)
    
def text_detector(image, languages=['en', 'de']) -> list:
    for lang in languages:
        result = text_detector.Text_Detector_Tool.execute(image=image, languages=lang)
        signals = [[_, b'', s] for _, b, s in result]
        return signals
