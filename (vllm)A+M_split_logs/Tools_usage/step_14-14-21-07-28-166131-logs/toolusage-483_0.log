from selenium import webdriver

def detect_objects(image):
    # Assuming "sports_baseball" is the label to be detected
    obj_results = []
    label = [
        "sports_baseball"
    ]

    for label in label:
        result = Text_Detector_Tool.execute(image=image, languages=['en', 'de'], save_object=True)
        if result is not None:
            obj_results.append(result)
    return obj_results

def main():
    final_result = detect_objects(
        '../media/prod/images/train/001_integer_1D00/001_a.jpg'
    )
    
    print("Confidence score for detecting sports_baseball: {}".format(final_result[0]['objects'][0]['score']))
    
    # Provided example
    if 'image_ajpg' in final_result.keys():
        print("Confidence score for detecting sports_baseball in image A.jpg: {}".format(final_result['image_ajpg']['objects'][0]['score']))
```

