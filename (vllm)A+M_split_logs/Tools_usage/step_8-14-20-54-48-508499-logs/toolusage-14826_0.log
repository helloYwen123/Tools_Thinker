from object_detector import Object_Detector_Tool

def estimate_distances(image_path, object_labels, save_object=False, saved_image_path=None):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=object_labels, save_object=save_object, saved_image_path=saved_image_path)
    detections = [{"bbox": obj['bbox'], "score": obj['score']} for obj in detected_objects[0]]
    
    # Filter out unrelated labels
    relevant_labels = sorted([obj['saved_image_path'].split('/')[-1].split('.')[0] for obj in detections if obj['score'] >= 0.92], key=len)
    
    # Calculate distances between detected objects
    distance_matrix = []
    for obj1 in detections:
        for obj2 in detections:
            distance = obj1['bbox'][2] - obj2['bbox'][2]
            distance_matrix.append({
                'bbox1': obj1['bbox'],
                'bbox2': obj2['bbox'],
                'distance': distance if distance > 0 else distance * -1
            })
        distance_matrix.append({
            'bbox1': obj1['bbox'],
            'bbox2': obj2['bbox'],
            'distance': -distance
        })
    
    return distance_matrix
```
You can use this function by passing in the path to an image (or image and video for video images), and the object labels you want to detect. The function will return a list of dictionaries, where each dictionary contains the bounding box coordinates, the recognized text, and the confidence score of each detected object. You can then use these scores to identify the object that is closest to the room with the bed covered in bedsheet.
