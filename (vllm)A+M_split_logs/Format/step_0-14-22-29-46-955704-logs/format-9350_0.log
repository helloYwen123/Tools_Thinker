Create a function to execute the tool:
def analyze_images(image_path, label_list=None, threshold=0.35, model_type='tiny', save_object=False, saved_image_path="detected_objects"):
    # Execute the tool
    tool_output = Object_Detector_Tool.execute(image_path, labels=label_list, threshold=threshold, model_type=model_type, save_object=save_object, saved_image_path=saved_image_path)
    
    if tool_output is None:
        return None
    
    # Create a dictionary to store detected objects
    detected_objects = {}
    
    # Loop through the detected objects to create the dictionary
    for obj in tool_output[0]:
        detected_objects[obj['label']] = [{'bbox': obj['box'], 'score': obj['score']}, tool_output[1][obj['label']][0]['saved_image_path'] if save_object else None]
    
    # Loop through the detected objects to check the option
    final_result = ''
    for obj in tool_output[0]:
        if obj['label'] == 'B':
            final_result += f"{obj['bbox']} {obj['score']} "
    
    return final_result

