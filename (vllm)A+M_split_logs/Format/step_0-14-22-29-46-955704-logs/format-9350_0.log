```python
from object_detector import Object_Detector_Tool

def determine_positions(image_path, labels=None, threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
    # Load the model
    model = object_detector.Model(model_path=model_size)

    # Detect objects in the image
    result = object_detector.detect_objects(model=model, image_path=image_path, labels=labels)

    # Create a dictionary to store the positions of each object
    positions = {}

    # Add bounding boxes and their image paths to the positions dictionary
    for obj in result[1]:
        positions[obj["name"]] = [obj["box"][0], obj["box"][1] - obj["box"][0], obj["box"][2] - obj["box"][0], obj["box"][3] - obj["box"][0], obj["score"], obj["saved_image_path"]]

    # Return the positions information
    return positions

# Example usage
image_path = "/path/to/image.png"

final_result = determine_positions(image_path)
print("Final result:")
for obj, info in final_result.items():
    print(f"{obj}: {info}")
```

