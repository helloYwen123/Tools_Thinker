```python
import object_detector

# Initialize the object_detector class
detector = object_detector.Object_Detector_Tool()
# Set the image
image_path = 'path/to/image.png'
# Set the labels
labels = ['baseball', 'basket']
# Save the detected objects
detector.save_object = True
detector.saved_image_path = 'detected_objects'
# Get the object result
result = detector.execute(image_path=image_path, labels=labels)
detected_objects = result['detected_objects']
total_objects = result['total_objects']
# Print the result
print("Detected Objects:")
for label, obj in detected_objects.items():
    for i in range(len(obj['bbox'])):
        print(f'{label} -> {obj["bbox"][i]} ({detected_objects[label][i]:.2f})')
print("\nTotal Objects: ", total_objects)
```
