import Object_Detector_Tool

def count_dressers(image_path):
    # Seal protrusion in at the top is a dresser
    predicted_dressers = {
        "12" : 1, # Simard 2003 Dress R
        "9" : 1, # Nike dress
    }

    instrument = Object_Detector_Tool.Object_Detector_Tool(image_path,
                                                          labels=[],
                                                          save_object=False,
                                                          save_object=True,
                                                          threshold=-10,
                                                          model_size='base')

    dresser_count = 0
    for bounding_box, predicted in instrument.get_detection_results():
        if bounding_box[4] == 'baseball' and predicted['bbox'][2] < object_size[0] and predicted['bbox'][3] > object_size[3] - object_size[2]:
            dresser_count += 1
            if instrument.objects['9'].count() == 0 and bounding_box[4] == 'C'
                instrument.objects['9'].append(predicted)

    return dresser_count

# Test the function with provided image path
image_path = "path/to/image.png"
dressers = count_dressers(image_path)
print("Number of Dressers:", dressers)
```
