final_result = ""

# Configuration
input_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3985_0.png"
languages = ["en"]
output_detail = 1

# Operation
result = Text_Detector_Tool.execute(image=input_image_path, languages=languages, detail=output_detail)

# Analysis
if result:
    result_list = result[0]
    detected_letters = []
    for letter in result_list:
        bbox = letter["bbx"]
        letter = letter["text"]
        confidence_score = letter["score"]
        detected_letters.append([lb[0] for lb in zip(*bbox) if lb])
        detected_letters.append([lb[0] for lb in zip(*bbox) if confidence_score < 0.8])
        detected_letters.append([lb[0] for lb in letter])
        
    # Extract detected texts
    detected_texts = [result[1][i] for i in range(2 * len(result[1]))]
    detected_names = [result[1][i] for i in range(16)]
    
    # Generate final result
    final_result = {
        "detected_letters": detected_letters,
        "detected_texts": detected_texts,
        "detected_names": detected_names
    }

# Output
if final_result:
    result = {
        "detected_letters": final_result['detected_letters'],
        "detected_texts": final_result['detected_texts'],
        "detected_names": final_result['detected_names']
    }
    
print(f"Final Result: {result}")
