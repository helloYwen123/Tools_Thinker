# Functions to process OCR image results
def process_image_results(image_results):
    # Iterate over each image result and process its depth image and
    for img_path, result in image_results.items():
        img = cv2.imread(img_path)
        depth_map = result.get("depth_map")
        output_image = result.get("output_image_path")
        if output_image:
            cv2.imwrite(output_image, depth_map)
    return image_results

def process_video_results(video_results):
    # Iterate over each video result and process its depth cinematographic images and 
    for video_path, results in video_results.items():
        video_depth_map = results.get("video_depth_map")
        if video_depth_map is None:
            continue
        video_depth_map_path = results.get("output_video_path")
        if video_depth_map_path is None:
            continue
        np.savez(video_depth_map_path, depth_map=video_depth_map[0])

    return video_results

def main():
    # Example usage
    image_results = process_image_results(image_results)
    video_results = process_video_results(video_results)

if __name__ == "__main__":
    main()

