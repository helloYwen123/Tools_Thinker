from text_detector import Text_Detector_Tool

# Function to count baseball and basketball occurrences
def count_baseball_basketball(image_path=None):
    if image_path:
        input_img = image_path
    else:
        input_img = 'image_data.png'
        
    text_result = Text_Detector_Tool.execute(image=input_img)
    
    baseball_result, basketball_result = [], []
    for item in text_result:
        if 'baseball' in item['text']:
            baseball_result.append(item)
        elif 'basketball' in item['text']:
            basketball_result.append(item)
    
    total_count = {'baseball': len(basketball_result), 'basketball': len(basketball_result)}
    
    return total_count

# Example usage
count_baseball_basketball()
