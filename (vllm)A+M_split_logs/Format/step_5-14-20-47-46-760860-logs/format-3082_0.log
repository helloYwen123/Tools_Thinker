final_result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en', 'de'], detail=0)

if len(final_result) > 0:
  detected_objects = final_result[0][1:]
  detected_objects = [(bbox, word, score) for (bbox, word, score) in detected_objects if word.strip().lower() in ['baseball', 'basket']]
else:
  detected_objects = []

detected_letters = Pixel_Depth_Tool.execute(image='path/to/image.png', output=True, outdir='./vis_depth')

if len(detected_letters) > 0:
  matched_lines = [detected_letters[item.z] for item in sorted(detected_letters.items(), key=lambda x:len(x[0]))]
else:
  matched_lines = []

final_result = {
    'matched_lines': matched_lines,
    'detected_objects': detected_objects
}

