@command.command
def detect_text(image_path, languages=['en', 'de']):
    detected_texts = Text_Detector_Tool.execute(image_path, languages=languages)
    tested_cases = [
        (text, confidence) for text, confidence in detected_texts for languages in languages
    ]
    if not den_closed:
        detected_text = max(tested_cases, key=lambda x: x[1])[0]
        for language in languages:
            language_detected_text = max(tested_cases, key=lambda x: x[1][language again])
            if language != language_detected_text[language].upper() or detected_text[language] > language_detected_text[language]:
