from PIL import Image
from torchvision.models.detection.annotations import detect_objects

def detect_text(image_path):
    image = Image.open(image_path)
    result = detect_objects(image)
    image_detected_box = result["bbox"]
    result_detected_text = result.get("text", [])
    return (result_detected_text)

# A call to the function should include the image file path
