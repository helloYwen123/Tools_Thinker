import numpy as np
import os

def detect_label(image_path, language, details):
    img = np.array(image_path).astype("float32")
    if language == "simplified-chinese":
        return text_detector(np.array(img))
    elif language == "de":
        return text_detector(np.array(img), languages=["en", "de"])
    else:
        return {"box": [], "letter": False, "confidence": 0.}

def generate_pairs(result, final_result):
    for detected_result in result:
        possible_text = ""
        label = detected_result["label"]
        bbox = detected_result["bbox"]
        if label == "baseball" and bbox:
            depth_image_path = f"depth_{label}_bbox_inside_{bbox[2]}x_{bbox[3]}x_{bbox[4]}x_{bbox[5]}_{label}" # imagine adding the bbox里需要的附加信息到result副本中
            if "confidence" in detected_result and detected_result["confidence"] > 0.7:
                final_result.append({"box": bbox, "letter": True, "confidence": detected_result["confidence"], "depth_image_path": depth_image_path)}
        elif label == "basket" and bbox:
            depth_image_path = f"depth_{label}_bbox_outside_{bbox[2]}x_{bbox[3]}x_{bbox[4]}x_{bbox[5]}_{label}"
            if "confidence" in detected_result and detected_result["confidence"] > 0.7:
                final_result.append({"box": bbox, "letter": True, "confidence": detected_result["confidence"], "depth_image_path": depth_image_path})

result = detect_label(image="path/to/your/image.png", language="simplified-chinese", details="0.8")
generate_pairs(result, final_result)
