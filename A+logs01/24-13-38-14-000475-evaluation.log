def count_blue_balls(image):
    # Load image
    image = image

    # Detect objects
    detection = object_detection(image, labels=["baseball"], threshold=0.5, model_size="base", padding=20)

    # Retrieve bounding boxes of objects and save them in a list
    boxes = [bbox for bbox in detection["output"]["bbox"] if "baseball" in [bbox["class"] for bbox in detection["output"]["bbox"]] and "ball" in bbox["bbox"]]

    # Count blue balls
    blue_balls = len([bbox["bbox"] for bbox in boxes if "blue" in bbox["class"]])

    return blue_balls

