def find_people_in_area(image_path, label_list, threshold=0.5, model_size="tiny", padding=20):
    """Return the paths of people detected in an image based on label_list.

    Parameters:
    * image_path (str): The path to the image file.
    * label_list (list): A list of object labels to detect.
    * threshold: The confidence threshold for detection (default: 0.35).
    * model_size (str): The size of the model to use ('tiny' or 'base', default: 'tiny').
    * padding (int): The number of pixels to add as empty padding around detected objects (default: 20).

    Returns:
    List of detected object paths.
    """
    detection_results = tool.execute(image=image_path, labels=label_list, threshold=threshold, model_size=model_size, padding=padding)
    people_detected_paths = []
    for detection_result in detection_results:
        if detection_result["label"] in ["person"] and float(detection_result["confidence score"]) > threshold:
            people_detected_paths.append(f"/home/stud/wxie/BLINK_Dataset/Counting/counting_114_image_1_{float(detection_result['confidence score']):.2f}")
    return people_detected_paths

