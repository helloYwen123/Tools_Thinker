def count_people_in_red_shirts(image_path, *args):
    import imageobjct_detection as Idt
    
    image = Idt.load_image(image_path=image_path)
    labels = ["red shirt"]
    threshold = 0.35
    model_size = "tiny"
    padding = 20
    
    detection_results = Idt.detect_objects_ids(image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    people_count = 0
    for detected_objects in detection_results:
        if "person" in detected_objects['labels']:
            people_count += 1
    
    return people_count

