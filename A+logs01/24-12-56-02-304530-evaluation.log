def count_birds(image_path, labels=["birds"], threshold=0.35, model_size="tiny", padding=20):
    # Read the image
    image = image_path
    
    # Detect birds in the image
    detection = detect_objects(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    
    # Count the number of birds detected
    count = len(detection)
    
