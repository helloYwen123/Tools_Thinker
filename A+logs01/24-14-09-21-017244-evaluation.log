def count_words_on_chalkboard(image_path, labels, threshold, model_size):
    detection = []
    with open(image_path, 'r', encoding='utf-8') as file:
        content = file.read()
        for line in content.split('\n')[:-1]:
            if ' ' in line:
                words = line.split(' ')
                for word in words:
