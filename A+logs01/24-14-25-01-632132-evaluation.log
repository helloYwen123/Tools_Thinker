    # Convert the detected objects to their paths
    detected_paths = [os.path.splitext(filepath)[0] for filepath in execution["output_type"]]
    
    # Count the number of red buses
    red_buses_count = sum(os.path.basename(name).startswith('r') for name in detected_paths if "r" in name)
    
    return red_buses_count

