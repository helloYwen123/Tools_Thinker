def count_glasses(image_path, threshold=0.5, padding=15):
    try:
        import detection_tool
        detection_tool.execute(image=image_path, labels=["glasses"], threshold=threshold, model_size="base", padding=padding)
        glasses = detection_tool.output
        
        empty_glasses = 0
        for glass in glasses:
            if glass['label'] != 'glasses':
                continue
            confidence = glass['confidence score']
            empty_glasses += 1
        
        return empty_glasses

    except Exception as e:
        print(f"An error occurred while running the detection tool: {e}")
        return None

