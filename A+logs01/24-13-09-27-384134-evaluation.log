def count_sign_with_black_letters(image_path):
    """
    Counts the number of "STOP" signs in an image
    """
    # Load and preprocess the image
    image = Image.open(os.path.join(image_path))
    image = image.convert('L')  # Convert to greyscale
    image = image.resize((100, 100))  # Resize to 100x100 pixels
    image = image.split()

    # Extract the black letter segments in the "STOP" signs
    blackletter_segments = []
    for segment in image:
        if 'STOP' in segment:
            for chunk in segment.split():
                if chunk.startswith('STOP') and len(chunk) > 1:
                    blackletter_segments.append(chunk)

    # Count the number of "STOP" segments
    count = sum(1 for segment in blackletter_segments if 'STOP' in segment)

    return count

