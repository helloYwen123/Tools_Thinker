def count_red_cars(image_path):
    # Read image and convert to grayscale
    img = cv2.imread(image_path)
    img = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # detect red pixels and count them
    cnt = cv2.countNonZero(img)

