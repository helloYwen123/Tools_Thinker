def count_lake_building_heights(input_image, building_height=None):
    """
    Counts the number of tall buildings that are over 100 meters in height.
    
    :param input_image: A string with the path to the input image.
    :param building_height: The height of the building to be considered tall.
    :return: The number of tall buildings.
    """
    detected_objects = execution(input_image=input_image, labels=["building"], threshold=0.4, model_size="tiny")
    # Filter the detected objects to only those with a height parameter greater than 100
    tall_buildings = [obj for obj in detected_objects if float(obj['bbox'][2]) > 102]
    return len(tall_buildings)

