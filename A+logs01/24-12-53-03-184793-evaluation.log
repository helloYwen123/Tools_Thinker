def detect_white_lines(image_path):
    image = cv2.imread(image_path)
    model_path='model/model.pth'
    threshold=0.3

    # Load the Base model
    model = torch.jit.load(model_path)

    # Detect white lines using the Base model with the specified threshold and model size
    output = model(img=image, return_tensors='pt').last_hidden_state
    detections = output['logits'].softmax(-1)

    # Find the indexes of the top three detection with confidence above threshold
    indexes = detections[0, detections[0]['confidence'] > threshold, :].argsort(descending=True)[:3]

    # Get the indices of the top three detection with confidence above threshold
    x_indices = indexes[0]
    x_values = detections[0, (0,1), x_indices]
    y_indices = indexes[1]
    y_values = detections[0, (0,2), y_indices]
    z_indices = indexes[2]
    z_values = detections[0, (0,3), z_indices]

    # Get the location of the top three detection with confidence above threshold
    top_y = min(y_values[y_values==x_values.max()][:,1])
    top_x = x_values[y_values==top_y,:,-1]
    top_z = z_values[y_values==top_y][0,-1]

    # Return the indices of the top three detection with confidence above threshold
    return top_y, top_x, top_z

def count_white_lines(image_path):
    white_line_detections = detect_white_lines(image_path)
    num_white_lines = (white_line_detections[0]*2880)*(white_line_detections[1]*2400)*white_line_detections[2]
