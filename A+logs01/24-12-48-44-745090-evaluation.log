def count_pillows(image_path, labels=['baseball', 'basket'], threshold=0.35, model_size='tiny'):
    image = Image.open(image_path)
    labels = np.array(labels).astype(bool)
    detection_results = object_detector_tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size)

    pillow_count = 0
    for boxes in detection_results:
        for box in boxes:
            if box[4] == 1:  # 0 is white, 1 is pillow
                pillow_count += 1

    return pillow_count

