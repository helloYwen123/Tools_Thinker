def count_towels(image_path, labels, threshold, model_size, padding):
    detection = execute([image_path], labels=['blue towel'], threshold=threshold, model_size=model_size, padding=padding)
    blue_towels = {}
    for obj in detection:
        if obj['label'] in ['blue towel']:
            if 'bbox' in obj:
                x, y, w, h = obj['bbox']
                blue_towels[(x, y, x+w, y+h)] = 1
            elif 'box' in obj:
                x, y, x+w, y+h = obj['box']
                blue_towels[(x, y, x+w, y+h)] = 1
    return blue_towels

