def detect_objects(image_path, labels, threshold, model_size, padding):
    # Open image
    img = Image.open(image_path)
    
    # Make image grayscale
    img = Image.merge('L', img)
    
    # Convert to rgb
    img = Image.merge('RGB', img)

    # Detect baseball, basket object
    detected_objects = []
    
