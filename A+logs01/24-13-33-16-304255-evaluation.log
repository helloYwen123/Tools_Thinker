def count_i_in_words(image_path, labels, threshold, model_size, padding):
    # Load the image
    image = load_image(image_path)

    # Detect the words in the image
    detections = []
    for label in labels:
        detections.extend(image.detect_objects(label, threshold, model_size, padding))

    # Count the occurrences of "i"
    i_count = 0
    for detection in detections:
        words = [word.lower() for word in detection.annotation.split()]
        if "i" in words:
            i_count += 1

    return i_count

