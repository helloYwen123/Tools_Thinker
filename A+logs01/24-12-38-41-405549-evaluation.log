import numpy as np

def count_people(image_path, labels, threshold, model_size, padding):
    # Load the mask image corresponding to each label
    masks = []
    for label in labels:
        mask = object_detector_tool.execute(image_path, label, threshold, model_size, padding=padding)
        masks.append(mask)

    # Count the number of people for each label
    count = np.sum([len(np.nonzero(mask)[0]) for mask in masks])

    return count

# Example usage
