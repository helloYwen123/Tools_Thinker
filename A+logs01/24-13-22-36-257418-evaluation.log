def count_red_coat_people(image_path, labels=("baseball", "basket"), threshold=0.35, model_size="tiny", padding=20):
    try:
        # Load the image
        image = tool.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    except:
        return None

    # Load the bounding box coordinates of the objects
    bboxes = image['bbox']

    # Find the coordinates of the red coat in the bounding box
    red_coat_bboxes = [bbox for bbox in bboxes if 'baseball' in bbox and 'basket' not in bbox]

    # Calculate the number of red coat people
    red_coat_count = len(red_coat_bboxes)
    return red_coat_count

