def count_glasses_filled_with_water(image_path):
    """
    Count the number of glasses filled with water in an image.
    """
    import numpy as np
    
    # Load the image
    image = np.load(image_path)
    
    # Get the dimensions of the image
    image_size = image.shape
    
    # Check if the image is 3D or 4D, assuming it's a single image
    num_channels, _ = np.ndim(image)
    if num_channels == 3:
        num_channels = 1
    
    # Calculate the number of overlapping boxes (40% overlap)
    num_overlapping_boxes = int((0.4 * np.prod(image_size)) / (1024 * 0.4))
    box_dims = tuple(image_size)[:-1] * (1024 // np.prod(image_size) + 1)
    
    # Pre-process the image to detect glass edges
    boxes = []
    scores = []
    for iy in range(num_overlapping_boxes):
        for ix in range(num_overlapping_boxes):
            box = (iy * box_dims[0], ix * box_dims[1])
            if not any(box[0] in line for line in ['0', '1']):
                boxes.append(box)
            score = image[int(box[0]):int(box[0] + box[1]), int(box[1]):int(box[1] + box[2])].mean()
            scores.append(score)
    box_idx = scores.index(max(scores)) + num_overlapping_boxes
        
    # Filter out false positives at the edge of the box
    box_idx_mask = (box_idx > 10600) & (box_idx < len(scores) - 10600)
    selected_boxes = [boxes[idx] for idx in box_idx_mask]
    
    # Filter out boxes in dim dimx < 1024 and boxes with a score < 0.35
    selected_boxes = [box for box in selected_boxes if box[0] >= 10600 and box[2] >= 10600] 
    
    # Check if boxes are within the image and their y-y coordinates are within 40% of the height
    selected_boxes = [box for box in selected_boxes if (box[0][1] - box[2][1]) // box_size[1] < 0.4 and -(box[0][1] - box[2][1]) // box_size[1] < 0.4 and box[0][1] > -0.4 and box[1][1] < 0.4]
    
    # Check if the center of each box is in the first quadrant (0 to 400x400)
    for box in selected_boxes:
        box_ys = [(box[0][0] + box[1][0]) // box_size[0], (box[0][0] + box[1][0]) // box_size[0]]
        box_ys.append((box[0][0] + box[1][0]) // box_size[0] - 1)
        box_y = min(box_ys)
        if box_y > 300 and box_y + 300 < 1300:
            return 1  # No glass filled with water
    return 0  # At least one glass filled with water

