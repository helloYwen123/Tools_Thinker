def people_with_yellow_shirt(image_dataframe, padding=20):
    color_to_match = {"#FFA500": "white", "#FF69B4": "white"}#colors to match: #FFC000, #FF8C00, #00BFFF

    # Match the color of the shirt
    yellow_shirts = [person for person in image_dataframe if person["label"] == "person" and person["color"].startswith(color_to_match.get("yellow", "#FFFF00"))]
    
    # Filter for people based on their shirt color
    return yellow_shirts if yellow_shirts else False

