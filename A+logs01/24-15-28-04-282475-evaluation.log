def Detect_objects(images_path, labels, threshold, model_size, padding):
    for label in labels:
        execution = execute_tool(tool_name="Object_Detector_Tool", input_type={"image": images_path}, labels=[label], threshold=threshold, model_size=model_size, padding=padding)
        for object in execution:
            yield object

def Count_people_in_image(image_path, labels=['Baseball', 'Basket', 'Person'], threshold=0.35, model_size="tiny", padding=20):
    count = 0
    for image in Detect_objects(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding):
        if image['label'] in labels:
            count += 1
    return count

