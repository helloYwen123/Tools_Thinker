def detect_objects(image_path, labels, thresholds, model_size, padding):
    from object_detector_tool import detect_objects

    detection = detect_objects(image_path=image_path, labels=labels, thresholds=thresholds, model_size=model_size, padding=padding)

    if detection is None:
        return

    detected_objects = []

    for detection in detection:
        box = detection["box"]
        label = detection["label"]
        confidence_score = detection["confidence score"]

        predicted_objects = []

        if label == "baseball" or label == "basket":
            if box["left"]=95 and box["right"]=100 and box["top"]=150 and box["bottom"]=155:
                predicted_objects.append({"label": "baseball", "confidence score": confidence_score, "box": box})
            elif box["left"]=-5 and box["right"]=100 and box["top"]=240 and box["bottom"]=300:
                predicted_objects.append({"label": "basket", "confidence score": confidence_score, "box": box})

        elif label == "car" or label == "person":
            if box["left"]=-10 and box["right"]=10 and box["top"]=-20 and box["bottom"]=150:
                predicted_objects.append({"label": "car", "confidence score": confidence_score, "box": box})
            elif box["left"]=-50 and box["right"]=-35 and box["top"]=-5 and box["bottom"]=150:
                predicted_objects.append({"label": "person", "confidence score": confidence_score, "box": box})

        if predicted_objects:
            for item in predicted_objects:
                detected_objects.append({"label": item["label"], "confidence score": item["confidence score"]})

    return detected_objects

