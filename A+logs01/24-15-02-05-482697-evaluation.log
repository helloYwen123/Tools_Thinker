def boat_detection(image_path, labels, threshold=0.35, model_size='tiny', padding=20):
    """
    Detects objects in an image using Grounding DINO model and returns their paths.

    Parameters:
    image_path (str): Path of the image file.
    labels (list): List of object labels to detect.
    threshold (float): Confidence threshold for detection.
    model_size (str): The size of the model to use ("tiny" or "base").
    padding (int): The number of pixels to add as empty padding around detected objects.

    Returns:
    list: A list of detected objects dictionaries with ('label', 'confidence score', 'box', 'saved_image_path') keys.
    """
    detection_result = execution(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    detected_objects = detection_result['output_type']
    
    # Initialize the count of boats detected
    boat_count = 0
    
    for row in detected_objects:
        if "Boat" in row['label']:
            boat_count += 1
            
    return [f"Number of boats detected: {boat_count}"]

