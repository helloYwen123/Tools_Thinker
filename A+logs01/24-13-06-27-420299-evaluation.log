def count_objects(image_path, labels, threshold=None, model_size="tiny", padding=20):
    detections = execute(image_path, labels, threshold, model_size, padding)
    detected_objects = []
    for object in detections:
        if np.any(object['label'] == labels):
            object_name = object['label'] + '_' + str(object['confidence score'])
            detected_objects.append(object_name)
    return detected_objects

