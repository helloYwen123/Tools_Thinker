def count_red_cars(image_path):
    try:
        detection = object_detection_tool.execute(image=image_path,
                                                   labels=["red car"],
                                                   threshold=0.5,
                                                   model_size="base",
                                                   padding=20)
        red_car_detector = [item for item in detection["output_type"] if "red car" in item]
        return len(red_car_detector)
    except Exception as e:
        return 0

