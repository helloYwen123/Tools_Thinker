def count_yellow_cars(image_path: str) -> int:
    """Detect yellow cars in an image and return the count of detected yellow cars.

    Args:
        image_path: The path to the image file.

    Returns:
        The count of yellow cars in the image.
    """
    detection = detect_objects(image=image_path, labels=['car', 'yellow car'], threshold=0.5, model_size="base")
