def count_duplicated_sinking_boats(image_path, labels=None, threshold=0.35, model_size='tiny'):
    """Detect sinking boats in an image and count the number of unique sinking boats.

    Args:
        image_path (str): The path to the image file.
        labels (list, optional): A list of object labels to detect. Defaults to None.
        threshold (float, optional): The confidence threshold for detection (default: 0.35).
