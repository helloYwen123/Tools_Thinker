from PIL import Image
from groundin.models import Base

def count_tiles(image_path):
    # Load the image
    image = Image.open(image_path).convert('RGB')

    # Threshold the image and detect objects with Grounding DINO
    detection = Base(image=image).execute(threshold=0.35)

    # Get the label and confidence score for each detected object
    object_labels = [bbox['label'] for bbox in detection]

    # Count the number of objects above the sink
    num_objects_above_sink = len([obj for obj in object_labels if obj == "tile"])

    return num_objects_above_sink

