from object_detector_tool import Tool
import numpy as np


def detect_objects(image_path, labels, threshold, model_size="tiny", padding=0):
    tool = Tool(image_path, labels, threshold, model_size=model_size, padding=padding)
    generated_paths = tool.execute()
    if not isinstance(generated_paths, list):
        generated_paths = [generated_paths]
    return generated_paths


