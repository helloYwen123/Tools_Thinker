from object_detector_tool import tool

def count_skiers(image_path, labels, threshold, model_size, padding):
    # Load the model
    execution = {label: tool.execute(image=image_path, labels=labels) for label in labels}
    
    # Filter the detection results based on the threshold
    detections = next(filter(lambda x: x['confidence_score'] >= threshold, execution.items()), None)

    if not detections:
        return []  # No detections during the experiment

    # Select the topmost detection, considering the model size and padding
    top_detection = next((d for d in detections.items() if model_size == d['model_size'] and d['padding'] == 0), None)
    return top_detection['label']

