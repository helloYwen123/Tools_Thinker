def count_words(characters):
    """Count the number of words written in white chalk on the chalkboard."""
    # Convert the Chalkboard string to a list of characters
    characters = list(characters)

    # Initialize the count of words
    word_count = 0

    # Iterate through each character
    for i in range(len(characters)):
        # If the character is a space (ASCII 32)
        if characters[i] == ' ':
            # Count the number of spaces in the current window
            window = characters[i - 1:i+2]
            if all(characters[j] == ' ' for j in range(1, len(window)) and characters[j] == ' '):
                word_count += 1

    return word_count

