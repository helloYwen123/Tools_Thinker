class ImageAnalyzer:
    def analyze_image(self, image_path, labels=['birds']):

        # Load the image
        image = object_detection(image_path, labels)

        conf_scores = []
        bounding_boxes = []

        for label in labels:
            labels_details = image['output'][label]
            for row in labels_details:
                for item in row:
                    conf_scores.append(item['confidence'])
                    bounding_box = dict()
                    bounding_box['x1'] = item['x1'] - 10
                    bounding_box['y1'] = item['y1'] - 10
                    bounding_box['x2'] = item['x2'] + 10
                    bounding_box['y2'] = item['y2'] + 10
                    bounding_box['label'] = label

                    if label == 'birds':
                        bounding_boxes.append(bounding_box)

        # Filtering the bounding boxes based on confidence score
        filtered_boxes = []
        for box in bounding_boxes:
            if box['confidence'] >= 0.5:
                filtered_boxes.append(box)

        for label in labels:
            for box in filtered_boxes:
                if box['label'] == label:
                    print(f"{label} bird detected at coordinates: ({box['x1']}, {box['y1']}) to ({box['x2']}, {box['y2']}).")
                    break

        return filtered_boxes


