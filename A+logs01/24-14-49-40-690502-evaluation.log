from tools.object_detector.tool import Object_Detector_Tool

def count_people(image_path):
    # Load the object detector tool
    tool = Object_Detector_Tool()

    # Execute the tool to detect people
    execution = tool.execute(image=image_path, labels=["person"], threshold=0.5, model_size="base", padding=15)

    # Extract the detected people
    people = [det["label"] for det in execution if det["label"].startswith("person")]

    return people

