def count_purple_planes(input_image):
    """
    Count the number of purple planes in an input image.
    
    Parameters:
    input_image (str): The path to the image file.
    
    Returns:
    int: The count of purple planes in the image.
    """
    
    # Load the image and extract the plane detections
    detection = execute(image=input_image, labels=["purpleplane"])
    
    # Initialize the plane count
    plane_count = 0
    
    # Iterate over each detection
    for obj in detection:
        # Check if the object is a plane and if it is purple
        if obj["label"] == "purpleplane":
            plane_count += float(obj["confidence score"])  # Convert confidence score to decimal
            
    return plane_count

