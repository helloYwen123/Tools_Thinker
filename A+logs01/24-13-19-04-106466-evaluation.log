from PIL import Image

def detect_Yellow_Stars(image_path):
    try:
        img = Image.open(image_path)
        img_tonemapped = img.tonemapped
        stars = [s for s in img_tonemapped if s.getrange(260, 320, 240, 255) == (245, 5, 5, 255)]
        yellow_Stars = sum([1 for _ in stars if _.getrange(490, 540, 220, 240) == (255, 0, 0, 255) if _.getrange(0, 9, 42, 90) == (255, 255, 255, 255)])

        return yellow_Stars
    except Exception as e:
        print(f'Error: {e}')
        return None

