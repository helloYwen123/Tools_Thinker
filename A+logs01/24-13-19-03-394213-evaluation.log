def find_bananas(plates):
    """
    Detect the presence of bananas in the image.
    
    Parameters:
    plates (list of lists of objects): A list of sublists, where each sublist contains objects detected in an image.
        1. Each sublist starts with ('banana', 'confidence');
        2. Confidence values are for individual plates.
    """
    bananas = 0
    for i in range(len(plates)):
        for j in range(len(plates[i])):
            if plates[i][j] == 'banana':
                bananas += 1
    return bananas

