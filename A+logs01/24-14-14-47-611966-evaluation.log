    def calculate_weighted_count(self, objects: List[Tuple], counts: List[bool]) -> int:
        """Calculate the weighted count of the detected objects.

        Args:
            objects: list - A list of (label, confidence score) tuples.
            counts: list - A list of booleans.

        Returns:
            int - The total count of the detected objects.
        """
        return sum([object[1] * count for object, count in zip(objects, counts)])

