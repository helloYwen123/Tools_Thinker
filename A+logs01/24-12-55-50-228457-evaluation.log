def count_birds(image_path, bird_labels=["seagull"], threshold=0.35, model_size="tiny", padding=20):
    import Image
    from object_detector_tool import detection
    image = Image.open(image_path)

    # Detect birds using the model
    objects = detection(image=image, labels=bird_labels, threshold=threshold, model_size=model_size, padding=padding)
    
    # Count the number of birds
    bird_count = len([obj for obj in objects if obj["label"] in bird_labels])

    return bird_count

