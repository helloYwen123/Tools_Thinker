def count_wooden_beams(image_path: str) -> int:
    """
    Counts and returns the number of wooden beams on the top of a person in an image.

    Args:
        image_path (str): The path to the image file.

    Returns:
        int: The number of wooden beams on the top of the person.
    """
    object_detection = object_detector(image_path, labels=["wooden beam"], threshold=0.35, model_size="base", padding=20)
    wooden_beams = [bbox for obj in object_detection for bbox in obj["box"]]
    return len(wooden_beams)

