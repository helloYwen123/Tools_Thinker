# Function to create a histogram with 5 bins based on counts
def create_histogram(counts):
    count_distribution = {}
    bin_counts = [0] * 5
    bin_labels = ["Low", "Middle", "High", "Unknown"]

    for count in counts:
        bin = bin_labels[(count - 1) // 5] + "_" + str(count + 1 - (count - 1) % 5)
        bin_counts[int(bin)] += count
        if bin not in count_distribution:
            count_distribution[bin] = [0]
        count_distribution[bin][0] += count

    return count_distribution

