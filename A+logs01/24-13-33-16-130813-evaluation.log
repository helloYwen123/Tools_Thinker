def count_buses(image_path, model='tiny'):
    tool = 'Object_Detector_Tool'
    labels = ['double-decker', 'single-decker', 'low-floor']
    threshold = 0.35
    model_size = 'tiny'
    padding = 20

    try:
        execution = tool.execute(image=image_path, labels=labels, model_size=model, threshold=threshold, padding=padding)
        buses = [obj for obj in execution['output_type'] if 'double-decker' in obj['label']]
        if buses:
            return len(buses)
    except Exception as e:
        print(f"Error while executing tool: {e}")
        return None

