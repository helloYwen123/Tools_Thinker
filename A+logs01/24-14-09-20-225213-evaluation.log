def count_green_tiles(image_path, labels=None):
    # Load the image
    execution = tool.execute(image=image_path, labels=labels, threshold=0.5, model_size="tiny")
    labels = [label.lower() for label in execution[1]]
    green_tiles = []
    for label in labels:
        if "green" in label and "tile" not in label:
            green_tiles.append(label)
    return len(set(green_tiles))


