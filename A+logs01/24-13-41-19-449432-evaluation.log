def count_wheels(image_path):
    with Image.open(image_path) as im:
        pixels = im.load()
        left, right = im.size
        count = 0
        for x in range(right):
            b, g, r = pixels[x, 0]
            if r > 127 and b > 255 and g < 0:
                count += 1
        for y in range(left):
            b, g, r = pixels[0, y]
            if r > 127 and b > 255 and g < 0:
                count += 1
    return count

