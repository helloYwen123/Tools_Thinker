def detect_objects(image_path, labels, threshold=0.35, model_size="tiny", padding=20):
    detection_result = []
    for label in labels:
        objects = detection(image_path, labels=label, threshold=threshold, model_size=model_size, padding=padding)
        for obj_dict in objects:
            if obj_dict['label'] == label:
                detection_result.append(obj_dict)
    return detection_result

