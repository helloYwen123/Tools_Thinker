def count_yellow_stars(image_path):
    # Load the model and set the confidence threshold
    model = object_detection.Model('tiny', threshold=0.35)
    
    # Load the image
    image = object_detection.load_image_from_path(image_path)
    
    # Detect the yellow stars in the image
    results = model.detect_objects(image, labels=['yellow star'])
    
    # Count the number of yellow stars
    yellow_star_count = len([result for result in results if result['label'] == 'yellow star'])
    
