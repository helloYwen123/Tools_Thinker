def find_birds(image_path):
    imgaug = GroundingDINO()
    imgaug.augment_image(image_path)
    detections = imgaug.labels
    if not detections:
        return "No birds detected"
    else:
        count = 0
        for label in detections:
            if label == "bird":
                count += 1
        return f"{count} birds found"

