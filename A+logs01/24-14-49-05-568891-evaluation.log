class GroundingDINO:
    def __init__(self, labels=[], threshold=0.35, model_size="tiny", padding=20):
        self.labels = labels
        self.threshold = threshold
        self.model_size = model_size
        self.padding = padding

    def augment_image(self, image_path):
        import pytesseract
        
        # Tesseract OCR
        labels = pytesseract.image_to_string(image_path)
        self.labels.extend([l for l in labels.split(",")])
        
        # Get bounding boxes for base DINO model
        num_labels = len(set(' '.join(labels).split(',')))
        self.threshold *= num_labels
        boxes = []
        for i in range(len(self.model)):
            boxes.extend([[model[i].shape[0], model[i].shape[1], (0, 0), (model[i].shape[0], model[i].shape[1])]])
        if len(self.labels) <= 0:
            boxes = None

        # Get bounding box and confidence for the model
        image = torchvision.ops.transform_image(image_path, self.model, self.threshold, boxes=boxes)

        return image
