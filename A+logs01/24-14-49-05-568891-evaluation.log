from imgaug import Augmenters, augment

class GroundingDINO(Augmenters):
    def __init__(self):
        super().__init__()
        self.labels = []
        self.threshold = 0.35
        self.model_size = "tiny"
        self.padding = 20

    def augment_image(self, image_path):
        import pytesseract
        
        # Tesseract OCR
        labels = pytesseract.image_to_string(image_path)
        self.labels.extend([l for l in labels.split(",")])
        
        # Get bounding boxes for base DINO model
        import torchvision.transforms
        import torchvision.models_dinos

        model = torchvision.models_dinos.get_pose_765()
        # model = torchvision.models_dinos.get_bird_765()
        num_labels = len(set(' '.join(labels).split(',')))
        self.threshold *= num_labels
        boxes = []
        for i in range(len(model)):
            boxes.extend([[model[i].shape[0], model[i].shape[1], (0, 0), (model[i].shape[0], model[i].shape[1])]])
        if len(labels) <= 0:
            boxes = None

        # Get bounding box and confidence for the model
        image = torchvision.ops.transform_image(image_path, model, self.threshold, boxes=boxes)

        return image
