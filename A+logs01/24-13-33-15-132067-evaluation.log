def count_i_in_sign(image_path):
    """Detect objects and count 'i' in image, save as empty padding."""
    execution = object_detector_tool.execute(image_path="path/to/image.jpg", labels=["i"], threshold=0.35)
    bounding_boxes = [bbox for obj in execution[0] for bbox in obj['bbox']]
    coordinates = [[bbox[0], bbox[1], bbox[0] + bbox[2], bbox[1] + bbox[3]] for bbox in bounding_boxes]
    image = cv2.imread(image_path)
    for i in range(2):
        image = cv2.circle(image, tuple(coordinates[i]), 15, (0, 0, 255), -1)  # Add 15 pixels of empty padding
    cv2.imwrite(f"{image_path}.pad", image)
    i_in_image = image.count() - 1 # The image count minus the bounding box count
    return i_in_image

