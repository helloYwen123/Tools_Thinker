from __future__ import annotations

def count_blue_floats(image_path: str) -> int:
    """
    Detect blue floats in an image using the Grounding DINO model and save the detected objects with empty padding.
    """
    import object_detector_tool
    from PIL import Image

    # Load the image
    image = Image.open(image_path)

    # Detect blue floats
    detection_result = object_detector_tool.execute(
        image=image, labels=["blue float"]
    )
    detections = detection_result["output_type"][0]

    # Count the detections
    num_blue_floats = sum([d["confidence score"] > 0.5 for d in detections])

    return int(num_blue_floats)

