def count_people_in_image(image_path):
    # Load the image
    execution = tool.execute(image=image_path, labels=["person"])
    
    # Get the bounding boxes of people
    people_boxes = [box['bbox'] for box in execution[0]]
    
    # Count the people
    people_count = sum(len(box) for box in people_boxes)
    
