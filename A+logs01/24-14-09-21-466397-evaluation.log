def count_flower_pots(image_path):
    """
    Detects and counts flower pots in an image using the Object_Detector_Tool.
    Parameters:
    - image_path: str - The path to the image file.
    Returns:
    - float: The total number of flower pots detected in the image.
    """
    # Load the image and save the predicted flower pots as another file
    prediction_file = f"{image_path}.prediction.txt"
    with open(prediction_file, "w") as f:
        f.write(image_path)

    predictions = execute(image_path, labels=["flower pot"], threshold=0.35)
    flower_pots_count = sum(predictions["box"] for _, _, _, box in predictions)

    return flower_pots_count

def count_rose_buds(image_path):
    """
    Detects and counts flower buds in an image using the Object_Detector_Tool.
    Parameters:
    - image_path: str - The path to the image file.
    Returns:
    - float: The total number of flower buds detected in the image.
    """
    predictions = execute(image_path, labels=["flower bud"], threshold=0.35)
    flower_buds_count = sum(predictions["box"] for _, _, _, box in predictions) * 8  # Assuming that flower buds are 8 times taller than flower pots

    return flower_buds_count

def count_flower_pots_in_image(image_path):
    """
    Calculates the number of flower pots and flower buds in an image using the Object_Detector_Tool.
    Parameters:
    - image_path: str - The path to the image file.
    Returns:
    - float: The total number of flower pots and flower buds detected in the image.
    """
    flower_pots_count = count_flower_pots(image_path)
    flower_buds_count = count_rose_buds(image_path)
    
    total_count = flower_pots_count + flower_buds_count
    return total_count

