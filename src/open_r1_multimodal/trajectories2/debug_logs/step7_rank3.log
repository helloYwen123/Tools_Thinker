'<command>\nfrom object_detector_tool import *\n\ndef count_big_nuts(img_path):\n    # Load the image\n    img = Image.open(img_path)\n    \n    # Define the labels\n    labels = ["big nut"]\n    \n    # Set the confidence threshold\n    threshold = 0.3\n    \n    # Set the model size\n    model_size = "tiny"\n    \n    # Set the number of empty padding pixels\n    padding = 15\n    \n    # Detect the big nuts in the image\n    for label in labels:\n        detection = detection_detection(img, model_size=model_size, padding=padding, labels=[label])\n        boxes = detection["boxed areas"]\n        \n        # Count the big nuts\n        for box in boxes:\n            xmin, ymin, xmax, ymax = box\n            \n            # Check if the xmin and ymin coordinates are within the image boundary\n            xmin = max(0, xmin)\n            ymin = max(0, ymin)\n            xmax = min(img.width, xmax)\n            ymax = min(img.height, ymax)\n            \n            # Check if the xmin and ymin coordinates are valid\n            if xmin >= 0 and ymin >= 0 and xmin < img.width and ymin < img.height:\n                # Get the bounding box from the image\n                box = [xmin, ymin, xmax - xmin, ymax - ymin]\n                \n                # Check if the object has a high enough confidence score\n                conf_score = detection["scores"]\n                \n                # Check if the big nuts are present\n                if label == "big nut" and conf_score >= threshold:\n                    # Add the coordinates of the big nuts to the result list\n                    big_nuts.append((box, label))\n    \n    \n    return big_nuts\n\n# Load the image\nimg_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_6_image_1.jpg"\nbig_nuts = count_big_nuts(img_path)\n\n# Print the result\nfor big_nuts in big_nuts:\n    print(f"Big nuts in the green bowl: [{big_nuts[0]} ({big_nuts[1]}{big_nuts[2]}{big_nuts[3]})]")\n</command>'
