def analyze_image(image_path, labels=['baseball', 'basket'], threshold=0.35, model_size='tiny', padding=20):
    image = image_path
    data = []

    # Load the image and apply detection based on provided labels, threshold, and model size
    for person in Image.open(image).draw.annotate.detect_objects(image_path, labels, threshold, model_size):
        if person['label'] == 'baseball':
            baseball_object = Person(person=person['bbox'], saved_image=True, label='baseball')
            data.append(baseball_object)

    # Count the total number of baseball objects
    baseball_count = len(data)

    return baseball_count, data
