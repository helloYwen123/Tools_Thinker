# Access and process the detected objects
detected_objects = object_number
for label in detected_objects:
    if label == "toilet":
        count = detected_objects[label]
        for i in range(1, count + 1):
            print(f"Toilet {i}: {i - 1} toilets {i - 1} - {i} toilets {i}")

