detected_results = detector.execute()

for detected_result in detected_results:
    label = detected_result['label']
    bbox = detected_result['bbox']
    label_num = label_to_num.get(label, 0)  # Get label number if label is not recognized
    label_num = label_num if label_num != 0 else 1  # Return 1 because we want label count
    label_num += 0.1  # Add confidence score
    bbox += [label_num]  # Add confidence score to bbox
    if label_num not in bbox_dict:
        bbox_dict[label_num] = {  # Add if label_num is not in bbox_dict
