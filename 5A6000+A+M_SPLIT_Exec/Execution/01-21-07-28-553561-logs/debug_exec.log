# Load the images and count the number of consonants
def count_consonants(image_path):
    detector = Object_Detector_Tool()
    labels = ["a", "b", "c", "d", "e", "f", "g", "h", "j", "k", "l", "m", "n", "p", "q", "r", "s", "t", "v", "w", "x", "y", "z"]
    output = {}
    
    # Detect objects in the image
    objects, _ = detector.execute(image_path, labels, 0.45, "tiny", save_object=True, saved_image_path="result_images/")
    
    for obj, results in objects.items():
        count = 0
        for result in results:
            if result["class"] in labels and result["supervised_instance_count"] > 0:
                count += 1
        output[obj] = count
    
    return output

