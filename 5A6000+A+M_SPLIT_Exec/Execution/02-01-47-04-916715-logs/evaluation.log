Code: from object_detector import Object_Detector_Tool

def count_tvs(ground_truth_labels, saved_image_path, model_size='tiny'):
    total_tvs = 0

    # Initialize Object_Detector_Tool object
    object_detector = Object_Detector_Tool()

    # Check if 'model_size' is None (default value for tiny is 'tiny')
    if model_size == 'tiny':
        model_size = 'tiny'

    # Detect TVs on the wall
    if saved_image_path:
        detected_tvs = object_detector.execute(model_size=model_size, image="path/to/tv_image.jpg", labels=["tv"], saved_image_path=str(saved_image_path + "/" + "tv"))
    else:
        detected_tvs = object_detector.execute(model_size=model_size, image="path/to/tv_image.jpg", labels=["tv"])

    # Count TVs on the wall
    for row in detected_tvs['detected_objects']:
        if row['category_name'] == 'tv':
            total_tvs += 1

    return total_tvs

