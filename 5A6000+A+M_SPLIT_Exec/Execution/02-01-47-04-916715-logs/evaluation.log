Code: from object_detector import Object_Detector_Tool

# Load the image and set the detection parameters
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_3_image_1.jpg"
labels = ["baseball", "basket"]
save_object = True
threshold = 0.45
model_size = "tiny"
saved_image_path = "detected_objects"

# Detect the objects in the image
final_result = Object_Detector_Tool.execute(image_path=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

# Extract and count the detected objects
detect_results = final_result[0]
total_objects = {}, {}  # Initialize dictionaries to hold the detected objects and their counts

for label, result in detect_results.items():
    boxes = result["boxes"]
    names = result["names"]
    objects_count = len(boxes)

    # Count the number of detected objects
    total_objects[label] = objects_count

    # Add the bounding boxes to the list of detected objects
    for object_index, box in enumerate(boxes):
        # Add the object to the detected objects dictionary
        total_objects[label][object_index] = box



# Show the detected objects and their counts
print(total_objects)

# Show the final result
print("Detected objects with their counts:")
for label, count in total_objects.items():
    print(f"Label: {label}  Detected: {count}")

