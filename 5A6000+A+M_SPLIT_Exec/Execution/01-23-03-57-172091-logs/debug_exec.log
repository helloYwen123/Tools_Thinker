code:from object_detector import Object_Detector_Tool

def how_many_signs_with_black_letters(image_path):
    tool = Object_Detector_Tool()
    
    boxes = tool.execute(image_path, ["STOP"], save_object=True, saved_image_path="stop_signs")

    total_signs = boxes["stop_signs"][0]

    for sign in total_signs:
        for letter in sign["boxes"]:
            if letter["class_name"] == "STOP":
                black_letter = letter["class_name"][10:].strip()
                if black_letter == "STOP":
                    return 1

    return 0

# Example usage
