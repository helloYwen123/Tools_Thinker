# Step 1: Define the input
input_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_76_image_1.jpg"
labels = ["ski", "crowd"]
threshold = 0.4
number_labels = len(labels)

def get_object_number(image_path):
    # Load the image and detect objects using Grounding DINO
    detector = Object_Detector_Tool(image_path=image_path, labels=labels)
    label_detections = detector.detection_results()
    
    # Iterate over each label and count detections in each label
    for i in range(len(labels)):
        labels_count = {labels[i]: 0}
        for det in label_detections:
            labels_count[det[labels[i]-1]] += 1
        
        # The count of detections for each label is stored in the dictionary
        labels_count.update(label_detections)
    
    # Return the counts
    return labels_count

# Step 2: Calculate the total count
final_result = get_object_number(input_image_path)
