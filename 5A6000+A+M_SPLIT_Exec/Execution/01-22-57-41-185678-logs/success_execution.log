def count_motors(bus):
    # Initialize counters for each wheel
    front_left = 0
    front_right = 0
    back_left = 0
    back_right = 0

    # Check the first wheel
    if bus.wheels == 0:
        return None
    if bus.front_wheels == 0:
        return None
    if bus.front_left_wheel == 0:
        return None
    if bus.front_left_wheel.rotation < 360.0:
        front_left = bus.front_left_wheel.rotation
    if bus.front_left_wheel.rotation < 360.0:
        front_right = bus.front_left_wheel.rotation
    if bus.front_right_wheel == 0:
        return None
    if bus.front_right_wheel.rotation < 360.0:
        back_left = bus.front_right_wheel.position
    if bus.front_right_wheel == 0 or bus.front_right_wheel.rotation < 360.0:
        back_right = bus.front_right_wheel.rotation

    # Update counters based on number of motors detected on the bus
    if bus.front_left_wheel.rotation < 360.0 and bus.front_left_wheel.rotation < 360.0:
        front_left += 1
        front_right += 1
    if bus.front_left_wheel != 0 or bus.front_left_wheel.rotation < 360.0:
        back_left += 1
    if bus.front_right_wheel != 0 or bus.front_right_wheel.rotation < 360.0:
        back_right += 1

    return {
        "front_left": front_left,
        "front_right": front_right,
        "back_left": back_left,
        "back_right": back_right
    }
