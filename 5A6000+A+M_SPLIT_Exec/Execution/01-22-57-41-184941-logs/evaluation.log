Code: from object_detector import Object_Detector_Tool

# Read the image
def read_image(image_path):
    global image_path
    image = image_path
    return image

# Read the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_93_image_1.jpg"

# Detect objects
object_detector_tool = Object_Detector_Tool()
labels = ["baseball", "basket"]
object_detector_tool.labels = labels
confidence_threshold = 0.45
model_size = "tiny"
save_object = True

detected_objects, object_number = object_detector_tool.execute(image=image, labels=labels, save_object=save_object, threshold=confidence_threshold, model_size=model_size)

# Calculate the number of detected objects
num_objects = object_number["baseball"]
num_baskets = object_number["basket"]

# Calculate the percentage of detected objects
percentage_objects = (num_objects / image_path.split("/")[-1].split(".")[0].split("-")[-1].split("_")[-2]) * 100
percentage_bacteria = (num_baskets / image_path.split("/")[-1].split(".")[0].split("-")[-1].split("_")[-1].split("_")[-2]) * 100

# Final result variable
final_result = {
    "human_bacteria": percentage_objects if object_count == 0 else 0,
    "human_bacteria_percentage": percentage_bacteria if object_count == 0 else 0
}

# Print the result
print(f"Total number of detected objects: {num_objects}")
print(f"Percentage of detected objects: {percentage_objects}%")
print(f"Percentage of bacteria: {percentage_bacteria}%")

