from object_detector import Object_Detector_Tool

# Generate the Python code to answer the question
def count_bat_users(image_path):
    # Create an object detector tool instance
    tool = Object_Detector_Tool()

    # Use the object detector tool to detect the baseball bat
    detected_objects, object_number = tool.execute(image_path, ["baseball bat"], save_object=True)

    # Count the occurrences of the detected objects
    bat_count = object_number["baseball bat"]

    return bat_count
