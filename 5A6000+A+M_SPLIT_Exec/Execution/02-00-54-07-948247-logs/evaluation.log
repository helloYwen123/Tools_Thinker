Code: from object_detector import Object_Detector_Tool

# Read the path of the image file
path_to_image = "/home/stud/work/blue_sky_wxie/BLINK_Dataset/Counting/val/images/val_Counting_116_image_1.jpg"

# Create an instance of the Object_Detector_Tool tool
tool = Object_Detector_Tool()

# Execute the tool to detect interest-objects in the image
object_results = tool.execute(image=path_to_image, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Initialize a dictionary to store the results
results_dict = {}

# Extract the labels and their corresponding boxes, scores, and image paths from the results
for detected_objects in object_results["output"]:
    box = detected_objects["boxes"]
    score = detected_objects["confidence_scores"]
    
    # If the detected object is a baseball, add it to the dictionary with its bounding box and score
    if detected_objects["label"] == "baseball":
        results_dict["baseball"] = {"boxes": box, "result": score, "label": detected_objects["label"]}

# Get the number of tennis players based on the information stored in the dictionary
tennis_players = len(results_dict["baseball"])

final_result = tennis_players

