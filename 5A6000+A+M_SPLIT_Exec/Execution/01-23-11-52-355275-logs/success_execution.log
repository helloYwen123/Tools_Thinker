from object_detector import Object_Detector_Tool

def get_blue_collar_count(image_path):
    # Initialize the object detector tool
    object_detector_tool = Object_Detector_Tool()
    
    # Load the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_38_image_1.jpg"
    image = object_detector_tool.load_image(image_path)
    
    # Detect blue collars
    labels = ["baseball", "basket"]
    object_number = object_detector_tool.detect_objects(image, labels=labels, threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects")
    
    # Get the count of blue collars
    blue_collar_count = object_number[2]

    return blue_collar_count
