Code: from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_43_image_1.jpg"

# List of object labels to detect
labels = ["elephant"]

# Confidence threshold (default: 0.45)
threshold = 0.45

# Model size (default: 'tiny')
model_size = 'tiny'

# Save the detected object images if True
save_object = True

# Save the detected object images to 'detected_objects'
if save_object:
    detected_objects, object_number = Object_Detector_Tool.execute(image_path=image_path, labels=labels, save_object=True, saved_image_path="detected_objects")

# Print the detected objects
for obj_number, obj_info in detected_objects[0]['object_number'].items():
    print(f"Object {obj_number}: {obj_info}")
    
# Calculate the total count for each label
total_count = {}
for l in labels:
    total_count[l] = sum(detected_objects[0]['object_number'][l])

print("Total counted numbers:")
for l in total_count:
    print(f"Label {l}: {total_count[l]}")
    
# Counting the number of elephants with their trunks in the water
total_elephants = 0
for l in labels:
    if l == 'elephant':
        for i in range(len(detected_objects[0]['boxes'][l])):
            for j in range(len(detected_objects[0]['boxes'][l][i])):
                if detected_objects[0]['boxes'][l][i][j] < 0:
                    total_elephants += 0.8

total_count['elephant'] = total_elephants

print("Total counted elephants:")
for l in total_count:
    print(f"Label {l}: {total_count[l]}")

