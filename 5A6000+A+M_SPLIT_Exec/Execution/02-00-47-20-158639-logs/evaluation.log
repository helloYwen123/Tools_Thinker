Code: import os
import glob
import numpy as np
from object_detector import Object_Detector_Tool

path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images"
labels = ["banana", "croissant"]
threshold = 0.45
model_size = "tiny"
save_objects = True

def calculate_banana_count(image_path):
    detector = Object_Detector_Tool()
    cropped_image = detector.image_image(image_path)
    cropped_banana = cropped_image.find_objects(labels=[*labels], threshold=threshold)
    cropped_banana = [{"bbox": bbox, "label": label} for label, bbox in cropped_banana]
    cropped_banana = np.array(cropped_banana)

    return len(cropped_banana) if saved_objects else cropped_banana

final_result = calculate_banana_count(os.path.join(path, "*.png"))

print(final_result)

