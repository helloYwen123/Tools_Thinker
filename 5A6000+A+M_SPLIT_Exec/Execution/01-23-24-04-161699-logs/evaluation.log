Code: from object_detector import Object_Detector_Tool

input_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_71_image_1.jpg"
labels = ["baseball", "basket"]
threshold = 0.45
model_size = "mini"

# Use the object_detector package with the given input values
detected_objects, object_number = Object_Detector_Tool.execute(image=input_image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")

# Extract the image paths and detection results from detected_objects and object_number
for label in detected_objects:
    label_number = 0
    for result in detected_objects[label]:
        if result["image_path"] is not None:
            label_number += 1
            if "boxes" in result and "confidence_scores" in result:
                for box in result["boxes"]:
                    if "box" in box and ".jpg" in box["box"]:
                        final_result["baseball"] += 1
        else:
            final_result["basket"] += 1

# Print the total count of baseball and basket in the image
final_result

