def count_words_with_i(image_path):
    # Load the image and detect objects
    detection = detection_image(image_path, labels=['I', 'i'], threshold=0.3, model_size='tiny', padding=1)
    detected_objects = []

    for obj in detection:
        if obj['label'] == 'I' and obj['confidence']:
            detected_objects.append({'label': obj['label'], 'confidence': obj['confidence']})

    if not detected_objects:
        return []

    words_with_i = [obj['label'] for obj in detected_objects if obj['label'].endswith('i')]
    return words_with_i

