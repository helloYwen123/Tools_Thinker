def count_kids(image_path):
    image_file = os.path.basename(image_path)

    # Load the ground model and convert it to the Tiny version
    model = Object_Detector_Tool(model_size="tiny")
    execution = model.execute(image=image_path, labels=["baseball"], threshold=0.35)
