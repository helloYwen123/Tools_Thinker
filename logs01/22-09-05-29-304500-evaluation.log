    # Get the bounding box coordinates and confidence scores for the kids
    kids_box_coordinates_and_scores = []
    for detection in detections:
        if detection["label"] == "baseball":
            break
        kids_box_coordinates_and_scores.append({"bbox": detection["bbox"], "score": detection["confidence"]})

    # Check if any kids are present in the image
    kids_count = len(kids_box_coordinates_and_scores)

    final_result = kids_count
    return "count:", final_result
