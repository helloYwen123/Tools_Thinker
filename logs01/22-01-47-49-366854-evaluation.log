def count_red_bikes(image_path):
    image = Image.open(image_path)
    labels = ["red_bike"]
    threshold = 0.5
    model_size = "base"
    padding = 15
    detected_bikes = detection_objects(image, labels, threshold, model_size, padding)

    red_bike_count = 0
    for bike in detected_bikes:
        colors = bike["bbox"]
        for color in colors:
            if color["label"].lower() == "red":
                red_bike_count += 1

    return red_bike_count

