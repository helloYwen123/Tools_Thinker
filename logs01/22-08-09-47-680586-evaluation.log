def detect_objects(in_image_path, labels, threshold=0.35, model_size="tiny", padding=20):
    labels = [label.lower() for label in labels]
    detection = detection_objects(in_image_path, labels=labels, model_size=model_size)
    bounding_boxes = [bbox for b in detection for label, bbox in zip(b['label'], b['box']) if label in labels]
    bounding_boxes.sort(key=lambda x: x['bbox'][1])  # sort by bounding box Y2
    confidence_scores = [bbox['confidence score'] for bbox in bounding_boxes]
    bounding_boxes = [bbox for confidence_score, bbox in zip(confidence_scores, bounding_boxes) if confidence_score >= threshold]
    bounding_boxes = bounding_boxes[:padding]
    
    return [" ".join([label for label in bounding_boxes])]

