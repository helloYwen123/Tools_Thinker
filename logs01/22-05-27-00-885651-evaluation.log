def count_people_in_water(image_path):
    # Load the image and run object detection
    execution = object_detection_tool.execute(image=image_path, labels=["water"])

    if execution["output_type"][2] != "water":
        return 0

    # Find the bounding boxes of people in the water
    people = [obj_key for obj_key, obj_conf_score, obj_box, saved_image_path in execution["output_type"] if obj_key == "people"]

    people_count = sum([int(box[3]) for box in people if box[3] > 0])  # Sum the number of people in the water

    return people_count
