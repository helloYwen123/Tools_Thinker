def count_red_buildings(image_path):
    """
    Counts the number of red buildings in an image.

    :param image_path: str - The path to the image file.
    :return: int - The number of red buildings in the image.
    """
    dataset = Dataset.from_images(image_path)
    objects = []
    for obj in dataset.values:
        objects.append((obj['bbox'], obj['mask_mask'], obj['bbox'][0] + obj['bbox'][2]))

    # Find buildings with bounding box containing red color
    buildings = {obj[0] for obj in objects if 'red' in ' '.join(obj[1].split(' ')[-1])}
    return len(buildings)

