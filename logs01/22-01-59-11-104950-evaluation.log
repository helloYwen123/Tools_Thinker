def count_white_pillows(image_path):
    # Load the image using the Object_Detector_Tool
    detection_engine = Object_Detector_Tool()
    results = detection_engine.execute(image_path,
                                      labels=["pillow"],
                                      threshold=0.5,
                                      model_size="tiny")

    # Count the number of white pillows in the image
    white_pillows = 0
    pillow_masks = results['output_type'][1:]
    for mask in pillow_masks:
        if 'pillow' in mask:
            pillow_mask = mask['mask']
            pillow_width, pillow_height = pillow_mask.shape
            pillow_area = pillow_width * pillow_height
            if pillow_area > 0:
                white_pillows += 1
                break

    return white_pillows

