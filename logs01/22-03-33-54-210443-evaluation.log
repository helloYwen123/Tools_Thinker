def count_yellow_stars(pictureBox):
    # Load the image
    image = object_detector_tool.load_image(file_path=pictureBox)

    # Detect and crop the star images
    detected_objects = object_detector_tool.execute(labels=['yellow', 'star'], image=image)
    stars = [obj['box'] for obj in detected_objects['output_type'][0] if 'yellow' in obj['label'] and 'star' in obj['label']]

    return len(stars)

