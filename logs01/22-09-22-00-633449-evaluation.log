import os

def count_consonants_in_snowboard(image_path):
    image = os.path.basename(image_path)
    with open(image_path, 'r') as f:
        image_content = f.read()
    cleaned_image_content = image_content.replace('\n', '').replace('\r', '').replace(' ', '')
    char_count = {}
    for char in cleaned_image_content:
        if char.isalpha():
            char_lower = char.lower()
            if char_lower in 'abcdefghijklmnopqrstuvwxyz':
                if char_lower in char_count:
                    char_count[char_lower] += 1
                else:
                    char_count[char_lower] = 1
    letter_count = {char: count for char, count in char_count.items() if count >= 1}
    consonant_count = {}
    consonants = 'bcdfghjklmnpqrstvwxyz'
    for letter in letter_count:
        if letter in consonants:
            consonant_count[letter] = letter_count[letter]
    
    total_consonants = sum(consonant_count.values())
    
    return total_consonants

