def detect_people(image_path, labels=["person"], threshold=0.5, model_size="base", padding=20):
    # Load the object detector tool
    import tool_object_detector_tool as obj_det

    # Load the image
    image = obj_det.load_image(image_path)

    # Detect objects using the object detector tool
    print(f"Detecting people in {image_path}...")
    detection = obj_det.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Extract the detected objects from the results
    detected_objects = detection['output_type']

    # Filter the detected objects to only include those with predicted confidence scores greater than 0.5 for humans
    filtered_objects = [obj for obj in detected_objects if obj['label'] == "person" and obj['confidence score'] > 0.5]

    # Return the filtered objects
    return filtered_objects

