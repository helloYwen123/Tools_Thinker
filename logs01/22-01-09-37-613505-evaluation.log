from PIL import Image

def count_wooden_beams(image_path):
    # Load the image
    image = Image.open(image_path)
    
    # Convert the image to grayscale
    image_gray = image.convert('L')
    
    # Define the sizes of the bounding boxes for each log of wood
    boxes = [
        {"left": 600, "top": 600, "right": 700, "bottom": 700},
        {"left": 650, "top": 600, "right": 750, "bottom": 700},
        {"left": 700, "top": 600, "right": 800, "bottom": 700},
        {"left": 900, "top": 600, "right": 1000, "bottom": 700}
    ]
    
    # Iterate over the bounding boxes and count the number of wooden beams
    count = 0
    for box in boxes:
        left, top, right, bottom = box["left"], box["top"], box["right"], box["bottom"]
        for y in range(top - 30, bottom + 20):
            for x in range(left - 30, right + 20):
                if image_gray.crop((x, y, x + 1, y + 1)).count > 30:
                    count += 1
                    break
    
    return count

