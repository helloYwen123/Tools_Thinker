def execute(img, labels, threshold=0.35, model_size="tiny", padding=10):
    detection = {}
    model = Object_Detector_Tool()
    for obj in model.labels:
        execution = model.execute(image=img, labels=[obj], threshold=threshold, model_size=model_size, padding=padding)
