    model_size = "tiny"

    # Set the number of pixels to add as empty padding
    padding = 20

    # Detect the objects and save the detected objects with empty padding
    detection = detect_objects(image_path, labels, threshold, model_size, padding)

    # Filter the detection results to only consider toilet objects
    toilet_detections = [d for d in detection if d['label'] == "toilet"]

    # Count the number of toilet detection results
    toilet_count = len(toilet_detections)

    return toilet_count

