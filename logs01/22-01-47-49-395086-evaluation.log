def counting_bikes(counting_image_path):
    """
    This function counts the number of bikes in an image.
    """
    image = label_objects_and_save_image(
        counting_image_path,
        "bike",
        threshold=0.2,
        model_size="base",
        padding=10,
    )
    
    prediction, bounding_boxes, prediction_classes = find_objects_in_image(image)

    count = sum([bbox["bbox"][1] * bbox["bbox"][3] for bbox in bounding_boxes if prediction_classes[0][0] == "bike"])

    return count

