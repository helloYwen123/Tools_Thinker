def count_beams(path: str, model_size: str = "base", threshold: float = 0.5, padding: int = 20):
    image = Image.open(path)
    detector = Object_Detector_Tool()
    detection = detector.detect_objects(image, labels=["beam"], threshold=threshold, model_size=model_size, padding=padding)

    beams = []
    for obj in detection:
        if obj['label'] == "beam":
            beam = [obj['box'], obj['confidence'] * obj['box']]
            beams.append(beam)

    return beams

