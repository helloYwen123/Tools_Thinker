        # Calculate the width and height of the human body
        x1, y1, x2, y2 = box_human["bbox"]
        width = x2 - x1
        height = y2 - y1
        # Ensure that the human body covers a sufficient area
        if width > 10 and height > 10:
            # Calculate the score of the human
            score = (width * height) / (image.shape[1] * image.shape[0])
            # If the score is high, the human is counted
            if score > 0.75:
                people_number += 1

    return people_number

