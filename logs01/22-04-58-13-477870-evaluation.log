def count_red_letters(image_path="path/to/image.png", labels=["redletter"], threshold=0.4, model_size="base", padding=20):

    # Execute the command with the given parameters
    execution = execute(image=image_path, labels=labels, threshold=threshold,
                         model_size=model_size, padding=padding)

    # Find the bounding boxes with confidence score
    recognized_images = [image for image in execution[1] if image["confidence score"] >= threshold]

    if not recognized_images:
        return 0

    # Get the coordinates of boxes from the recognized image
    recognized_boxes = [image["box"] for image in recognized_images]
    
    # Count the number of boxes with a label of "redletter"
    count = sum(1 for bounding_box in recognized_boxes if "redletter" in bounding_box)

    return count

