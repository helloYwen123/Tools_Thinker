def count_stove_knobs(image_path):
    # Load the image
    image = object_detection(image_path=image_path)

    # Detecate the stove
    stove = []
    for object_info in image['output_type']:
        if 'label' in object_info and object_info['label'] == 'stove':
            stove.append(object_info)

    # Calculate the number of knobs
    number_of_knobs = len(stove)

    return number_of_knobs

