def get_bats(model, image):
    bat_boxes = [(bbox[0], bbox[1], bbox[0] + bbox[2], bbox[1] + bbox[3]) for _, _, bbox in model.predict(image)]
    for i, bat in enumerate(bat_boxes):
        if bat not in ["baseball", "basket"]:
            raise ValueError("Unexpected object in output")
    return [bat for bat, _, _ in bat_boxes]

def image_as_array(image_path):
    return np.array(Image.open(image_path))

def preprocess_image(image, model, threshold):
