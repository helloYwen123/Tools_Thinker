from object_detector_tool import execution

def calculate_number_of_elephants(image_path, labels, threshold, model_size, padding):

    detection_data = []

    for label in labels:
        if label == 'elephant':
            execution = execution(image=image_path, labels=[label],
                                  thresholds=[threshold, threshold * 2],
                                  model_size=model_size, padding=padding)
            detection_data.extend(execution)

    total = sum([len(detection) for detection in detection_data if 'elephant' in detection.keys()])
    return int(total)

