import cv2

def count_green_tiles(image_path):
    # Read the image
    image = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
    
    # Convert the image to binary (0s for white, 1s for green)
    binary_image = cv2.bitwise_and(image, image)
    
    # Count the number of 1s, corresponding to green tiles
    green_tiles = cv2.countNonZero(binary_image)
    
    return green_tiles

