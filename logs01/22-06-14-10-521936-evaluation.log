def count_people(image_path, labels):
    """
    Detect people in an image using Grounding DINO model
    
    Args:
    - image_path: str - The path to the image file.
    - labels: list - A list of object labels to detect. (e.g., ["car", "person", "truck"])
    - threshold: float - The confidence threshold for detection (default: 0.35)
    - model_size: str - The size of the model to use ('tiny' or 'base', default: 'tiny')
    - padding: int - The number of pixels to add as empty padding around detected objects (default: 20)
    
    Returns:
    - list - A list of detected people dictionaries with ('label';'confidence score';'box';'saved_image_path')keys and their corresponding values
    """
    
    # Load the Grounding DINO model
    from dino import DINOModel
    
    # Load the image and labels
    image = Image.open(image_path)
    labels = ["person"] if "person" in labels else ["car", "person"]
    
    # Detect people
    prediction = DINOModel.predict(image=image, labels=labels, threshold=0.5, model_size=model_size, padding=padding)
    
    # Get detected people
    people = []
    for label in prediction['labels']:
        confidence, box = prediction['det'], prediction['bbox']
        people.append({
            'label': label,
            'confidence score': confidence,
            'box': box[0]/(max(image.size)*2),
            'saved_image_path': label + '_' + str(box[0])
        })
    
    return people

