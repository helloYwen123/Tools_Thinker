def count_people_without_hats(image_path, labels=('baseball', 'basket'), threshold=0.35, model_size='tiny', padding=20):
    """
    Detect baseball, basket, person, and car in an image and count people without hats.
    """
    # Load the image and labels
    image = execute(image_path, labels=labels, threshold=threshold)[0]["image"]
    
    # Detect the objects
    for object_label, confidence_score, bounding_box, saved_image_path in execute(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding):
        if object_label == 'person':
            if confidence_score < threshold:
                break

    # Initialize the counter
    people_without_hats = 0

    # Check if the person is wearing a hat
    for object_label, confidence_score, bounding_box, saved_image_path in execute(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding):
        if object_label != 'baseball' and object_label != 'basket' and object_label != 'person':
            continue
        if bounding_box[3] < padding or bounding_box[2] < padding:
            continue
        hat_top_left = tuple([bounding_box[3] - padding, bounding_box[5] - padding])
        hat_bottom_right = tuple([bounding_box[3] + padding, bounding_box[5] + padding])
        
        if hat_top_left[1] < padding // 2 or hat_bottom_right[1] > padding * 2 + padding // 2:
            people_without_hats += 1

    return people_without_hats

