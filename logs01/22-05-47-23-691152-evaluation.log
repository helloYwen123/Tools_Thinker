def count_green_tiles(image_path):
    # Load the image
    img = Image.open(image_path)
    # Resize the image to a fixed size
    resized_img = img.resize((100, ) + img.size[1:])
    # Convert the image to gray-scale
    gray_img = np.array(resized_img)
    # Identify green tiles
    for channel in np.unique(gray_img):
        if channel > 127:
            # Count the green tiles
            return gray_img == channel.count(127)
    return False

