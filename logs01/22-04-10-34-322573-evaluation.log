def detect_buses(image):
    """
    Detects buses in an image using the Object_Detector_Tool tool.
    :param image: A path to the image file with the bus locations.
    :return: List of bus locations.
    """
    # Load the object detection model
    import dino_toolkit as dtk
    model = dtk.load_dino_toolkit()

    # Load the image
    import matplotlib.pyplot as plt
    import numpy as np
    fig = plt.figure(figsize=(6, 6))
    ax = fig.add_subplot(111)
    ax.imshow(image)
    ax.scatter(*np.where(model[0][1]))

    detections = model.find_objects(image)
    bounding_boxes = np.column_stack((detections[0], detections[1]).transpose())

    return bounding_boxes

