def count_ig_in_sign(sign_path):
    with open(sign_path, 'r') as file:
        sign_text = file.read().strip()

    total_words_with_i = 0
    for word in sign_text.split():
        if 'i' in word:
            total_words_with_i += 1
    
    return total_words_with_i

