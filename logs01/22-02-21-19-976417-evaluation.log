def count_people(image_path):
    # Load the object detector model
    try:
        # Load object detector model
        model = Object_Detector_Tool(image_path, labels=["car", "person"], threshold=0.5, model_size="base", padding=15)
        
        # Detect the objects
        detections = model.execute()
        
        # Get number of detected objects
        num_objects = int(len(detections[0][1]))
        
        return num_objects
    except Exception as e:
        return "Error: " + str(e)

