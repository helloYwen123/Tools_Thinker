def count_ellipses(path):
    img = Image.open(path)
    width, height = img.size
    img_array = np.array(img)
    height -= 1
    width += 1
    res = []
    for i in range(width):
        for j in range(height):
            if min([img_array[i - 1, j - 1], img_array[i - 1, j], img_array[i - 1, j + 1], img_array[i, j - 1]]) == 255:
                res.append(img_array[i, j])
    return res

