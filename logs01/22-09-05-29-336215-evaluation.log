    return detection_results

def count_students(bus_image_path):
    """
    Count the number of students in front of the school bus.
    :param bus_image_path: The path to the image containing the school bus.
    :return: An integer representing the number of students in front of the bus.
    """
    detected_students = detect_students(bus_image_path)
    return len([student for student in detected_students if student['label'] == "student"])

