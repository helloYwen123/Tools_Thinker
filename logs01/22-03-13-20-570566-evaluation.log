# Function to get labels and threshold for detection
def get_labels_and_threshold(image, labels, threshold):
    labels_d = dict()
    threshold_d = dict()
    
    # Load the image using the given path
    detected_objects = detection(image)
    
    # Loop through each object in the image
    for obj in detected_objects:
        labels_d[obj], threshold_d[obj] = obj_labels_extraction(image, obj['bbox'], detected_objects)
    
    return labels_d, threshold_d

# Function to extract object labels from the image
def obj_labels_extraction(image, obj, det_objects):
    label = None
    probability = None
    
    # Loop through each object in det_objects
    for obj in det_objects:
        # Check if the object's bbox covers the image
        if obj['bbox'][0] <= len(image) and obj['bbox'][1] <= len(image[0]):
            label = obj['label']
            probability = obj['confidence'] if obj['label'] in labels_d else None
            
            # Handle the detection if the object matches the threshold and the label
            if probability < threshold:
                label = None
                probability = None
                break
    return label, probability

