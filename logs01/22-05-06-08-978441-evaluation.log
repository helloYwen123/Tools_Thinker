def count_red_cars(image_path, color='red'):
    """
    Detect red cars in an image and return the count.

    :param image_path: Path to the image.
    :param color: The color to search for. This can be 'red' for a red filter,
                  'yellow' for a yellow color filter, or 'all' for all colors.
    :return: The count of red cars found.
    """
    detection_result = otw.execute(image_path=image_path, labels=['car'], threshold=0.5, model_size='tiny')
    car_boxes = [(bbox[0], bbox[1], bbox[2], bbox[3]) for _, _, bbox in detection_result]
    detected_cars = [bbox[0] for bbox in car_boxes if color == 'red']
    return len(detected_cars)

