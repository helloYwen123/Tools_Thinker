import numpy as np
from object_detector_tool import *

def count_flower_pots(images, labels=["flowers"], threshold=0.35, model_size="tiny", padding=20):
    """
    Count flower pots in the given images.
    :param images: List of image paths.
    :param labels: List of object labels to detect.
    :param threshold: Confidence threshold for detection (default: 0.35).
    :param model_size: Model size to use ('tiny' or 'base', default: 'tiny').
    :param padding: Number of pixels to add as empty padding around detected objects (default: 20).
    :return: List of flower pots detected in the given images.
    """
    results = []
    for image_path in images:
        detection = execute_detection_model(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        for obj in detection["output"]:
            if obj["label"] in set(labels):
                results.append({"label": obj["label"], "confidence score": obj["confidence"], "box": obj["bbox"]} if obj["label"].lower() not in set(["empty"]) else {"label": "empty", "bbox": ""})
    return results

# Example usage
