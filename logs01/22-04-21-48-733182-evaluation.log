def count_candlights(input_image_path, output_format='png', labels=['candle'], threshold=0.35, model_size='tiny', padding=20):
    # Load the image using the object detector tool
    image = Object_Detector_Tool.load_image(input_image_path)
    
    # Detect candles in the image
    detection = object_detector_tool.execute(image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Calculate the number of detected candles
    num_candles = sum([len(obj['bbox'][0]) for obj in detection if 'candle' in obj['label']])
    
    return num_candles

