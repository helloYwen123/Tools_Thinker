def count_tall_buildings_with_flat_tops(image_path):
    # Load the image
    image = Image.open(image_path)

    # Create a new image to store the bounding boxes
    bbox_image = Image.new("RGB", image.size, (255, 255, 255))

    # Iterate over the image to detect the height of buildings
    for y in range(image.height):
        for x in range(image.width):
            # Find features
            object_height = min((bbox_image.height - y - 2, image.height - y - 2))
            object_width = min((bbox_image.width - x - 2, image.width - x - 2))
            bounding_box = [(x, y, x + object_width, y + object_height)]
            text_font = "Lackawanna.ttf"
            text_color = (255, 0, 0)  # Black color code
            text_size = 20  # Size in pixels

            # Add bounding box
            if bounding_box in bounding_box:
                pass
            else:  
                # Draw bounding box
                new_bbox = []
                new_bbox.append((x, y))
                new_bbox.append((x + object_width, y + object_height))
                new_bbox.append((x + object_width, y + 2 * object_height))
                new_bbox.append((x, y + 2 * object_height))
                bbox_image.paste((x + object_width, y, x + object_width, y + 2 * object_height), bounding_box, outline="white")
                new_bbox.append((bbox_image.width - x - 2, bbox_image.height - y - 2))

                # Save the bounding box image
                new_bbox_path = bounding_box[0] + ".png"
                bbox_image.save(new_bbox_path)

    # Return the number of bounding boxes detected
    return len(image.getbbox("baseball"))

