import cv2

def count_sinking_boats(image_path):
    # Load the ground-dino model to detect sinking boats
    gdino_model = cv2.dino.initialize()
        
    # Detect sinking boats in the image
    detection = gdino_model.detect(image_path)

    # Count the number of sinking boats detected
    count = len(detection["label"])
    
    return count

