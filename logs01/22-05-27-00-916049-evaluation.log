    coordinates = image[:, 1][0]
    
    # Filter the detected objects to find those with a flat top
    # (a building with a rounded or slightly pointed roof, not a tall building's roof)
    flat_top_buildings = labels[coordinates == 9]
    
    # Count the number of such buildings
    num_flat_top_buildings = len(flat_top_buildings)
    
    return num_flat_top_buildings

