def detect_tall_buildings(image_path):
    """
    Detect tall buildings with a flat top in an image.
    """
    
    # Read the image file
    image = object_detector(image_path, labels=["tall building"], threshold=0.5, model_size="tiny", padding=20)
    
    # Extract the coordinates of the detected objects
