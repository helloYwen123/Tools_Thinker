def count_drive_wheels(image_path):
    import cv2
    from object_detector_tool import execution as tool_execution

    # Load the image
    image = cv2.imread(image_path)
    
    # Detect objects using the BASE model with default settings
    execution = tool_execution.execute(image=image_path, labels=["car", "person"], threshold=0.5, model_size="base", padding=15)

    # Extract the drive wheels
    drive_wheels = execution[0]["label"]

    # Count the number of drive wheels
    count = 0
    for wheel in drive_wheels:
        if wheel not in ["car", "person"]:
            count += 1

    return count

