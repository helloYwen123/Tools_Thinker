def count_signs(image_path):
    image = Image.open(image_path)
    
    objects = detect_objects(image, labels=["STOP"])

    if len(objects) == 0:
        return 0

    text_objects = [obj for obj in objects if obj['category'] == 'TEXT']
    
    stop_count = 0
    for obj in text_objects:
        if obj['text'] == 'STOP':
            stop_count += 1
    
    return stop_count

