    def baseball_detect(self, path):
        execution = self.model.execute(
            image=path, labels=["baseball", "basket"], threshold=0.35, model_size="tiny", padding=0)
        labels, confidence_scores, boxes, saved_image_names = self.determine_label_with_score(confidence_scores)
        return labels, confidence_scores

    def basket_detect(self, path):
        execution = self.dataset["basket"].execute(
            image=path)
        labels, confidence_scores, boxes, saved_image_names = self.determine_label_with_score(confidence_scores)
        return labels, confidence_scores

    def car_detect(self, path):
        execution = self.model.execute(
            image=path, labels=["car"], threshold=0.35, model_size="tiny", padding=0)
        labels, confidence_scores, boxes, saved_image_names = self.determine_label_with_score(confidence_scores)
        return labels, confidence_scores

    def person_detect(self, path):
        execution = self.dataset["person"].execute(
            image=path)
        labels, confidence_scores, boxes, saved_image_names = self.determine_label_with_score(confidence_scores)
        return labels, confidence_scores

    def Determine_label_with_score(self, confidence_scores):
        label, confidence_score = [], 0
        for label, score in confidence_scores: label.append(label)
        return label, confidence_score

    def execute(self, image, labels, threshold=0.35, model_size="tiny", padding=20):
        execution = grounding_dino(
            input=image,
            labels=labels,
            threshold=threshold,
            model_size=model_size,
            padding=padding
        )
        return execution.output['coordinates'][0]['x1']

