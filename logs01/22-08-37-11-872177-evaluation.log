def count_windows(img_path, labels=None, threshold=0.5, model_size='tiny', padding=20):
    # Load the model and labels
    if model_size == 'tiny':
        import ground_dino as gd
        gd.configure('tiny')
    elif model_size == 'base':
        import ground_dino as gd
        gd.configure('base')
    else:
        gd.configure('base')
        
    # Add empty padding to the image
    img = img_path
    img = gd.add_padding(img, padding=padding)
        
    # Detect the objects in the image
    detection = gd.detect(img, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        
    # Count the number of windows on the front and not the sides of the bus
    window_counts = 0
    count = 0
