def count_white_pillows(image_path, labels=None, threshold=0.35, model_size="tiny", padding=20):
    detection_results = []

    # Load object detection model
    model = load_model(f"weights/dino_{model_size}.weights.h5")  # Replace 'tiny' or 'base' with your model size

    try:
        # Load image
        image = image_path

        # Detect objects (if provided labels are not empty list)
        if labels is not None:
            detection_results.append(model.detect(image=image, labels=labels))

        # Calculate percentage of white objects detected
        total_objects = len(detection_results[-1]['labels'])
        white_objects = sum([[d['label'] == 'quilt' for d in detection_results[i]['boxes'] if d['label'] == 'quilt'] if d['label'] == 'quilt' else None for i in range(total_objects)]) / total_objects
        white_total = len(detection_results[-1]['labels']) - white_objects

        print(f"Total white objects: {total_objects}, White objects detected: {white_total}")

        final_result = f"Number of white pillows: {total_objects}"
        final_result += f" (White objects detected: {white_total})"

        return {'result': final_result}

    except Exception as e:
        print(f"Error occurred: {e}")
        final_result = "Error occurred"
        return {'result': final_result}

