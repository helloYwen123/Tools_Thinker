def count_black_suitcases(image_path, labels=None, threshold=None, model_size='tiny', padding=20):
    # Load the bounding box model
    model_info = execute(image=image_path, labels=labels)

    # Get bounding box confidence scores
    labels_info = execute(image=model_info[0]['image'], labels=model_info[0]['labels'], threshold=threshold, model_size=model_info[0]['model_size'])
    
    # Filter bounding boxes by category and confidence score
    black_suitcases = [bbox for _, conf, box, saved_image_path in labels_info['box'] if label in labels and conf > 0.8]
    
    # Add empty padding to suitcases
    black_suitcases.append({"bbox": [x + (y * 20) for y, x in [box] + [x + 20 for x in box]], "saved_image_path": saved_image_path})

    return black_suitcases

