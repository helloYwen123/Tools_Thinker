def count_white_lines(image_path, labels=None, threshold=0.35, model_size="tiny", padding=20):
    """
    Detect white lines on ground using Grounding DINO model.
    :param image_path: Path to the image file.
    :param labels: List of object labels to detect. If None, all labels in `images/labels/*.txt` file in the same folder as this image will be used.
    :param threshold: Confidence threshold for detection.
    :param model_size: Model type to use ('tiny' or 'base'). Default is 'tiny'.
    :param padding: Number of pixels to add as empty padding around detected objects.
    :return: A list of detected white lines in the ground, each entry with a label "white line" and its confidence score.
    """
    # Load the image
    image = Image.open(image_path)
    np_image = np.array(image)
    
    # Detect objects
    detection = detection_tool(np_image, labels, threshold, model_size, padding)
    
    # Filter white lines
    white_lines = [line.split(',')[0] for line in detection["output_type"][1] if "white line" in line and "confidence score" in line]
    
    return white_lines

def execution(image_path, labels=[], threshold=0.35, model_size="tiny", padding=20):
    """
    Execute the object detector tool with the specified parameters.
    :param image_path: Path to the image file.
    :param labels: List of object labels to detect. If None, all labels in `images/labels/*.txt` file in the same folder as this image will be used.
    :param threshold: Confidence threshold for detection.
    :param model_size: Model type to use ('tiny' or 'base'). Default is 'tiny'.
    :param padding: Number of pixels to add as empty padding around detected objects.
    :return: A list of detected objects' paths.
    """
    detection = detection_tool(image_path, labels, threshold, model_size, padding)
    return detection["output_type"][0]

