def detect_people(image_path, labels=["person"], threshold=0.5, model_size="bottom", padding=20):
    """Detect people in an image using the model_size specified. 
    Parameters
    ----------
    image_path : str
        The path to the image file.
    labels : list of str
        A list of labels to detect. Default is ["person"].
    threshold : float
        The confidence threshold for detection (default: 0.35).
    model_size : str
        The size of the model to use ("tiny", "base", "top", or "bottom") (default: "bottom").
    padding : int
        The number of pixels to add as empty padding around detected objects (default: 20).
    """
    image = Image.open(image_path)

    # Converting the image to gray-scale to reduce processing time
    gray = image.convert('L')

    # applying DINO model (object detection)
    detection = detect(gray, labels=labels, threshold=threshold, model_size=model_size)

    return detection

