def count_spectators(image_path: str, labels: List[str], threshold: float, model_size: str, padding: int) -> List[str]:
    predictions: List[str] = []
    detected_objects = ExecutionInfo(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    if not detected_objects:
        return []
    for detected_object in detected_objects:
        if detected_object['label'] == 'Spectators':
            predictions.append(detected_object['label'])
    return predictions

