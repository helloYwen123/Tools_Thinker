                    labels.append(label)
                    bbox_dict = {"label": label, "confidence score": confidence, "box": box, "saved_image_path": image}
                    images.append(bbox_dict)
    return images, labels

def bounding_box_detection(image, label):
    box = []
    # Detect objects using the object detector tool
    try:
        result = detection_object(image=image, labels=[label], labels_to_return="bbox")
        if result:
            box.append(result[0])
    except:
        pass
    return box

def box_around(image, label):
    # For demonstration purposes, we'll assume there's only one object for now
    box = []
    try:
        bounding_box = bounding_box_detection(image=image, label=label, labels_to_return="bbox")
        if bounding_box:
            box.append(bounding_box[0])
    except:
        pass
    return box

def load_model_path(path):
    # Load the trained model
    try:
        model = load_model(path)
    except:
        return None
    return model

def detect_object(image, labels, labels_to_return="bbox"):
    # Detect objects using the object detector tool
    try:
        result = detect_object(image=image, labels=labels, labels_to_return=labels_to_return)
        # If the object exists, return its bounding box, confidence score, and label
