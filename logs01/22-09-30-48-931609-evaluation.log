def image_bbox(image, labels, threshold=0.5, model_size="tiny", padding=20):
    images, labels = [], []
    try:
        detection = Image.open(image)
    except FileNotFoundError:
        detect_result = {"label": "Error", "confidence score": 0, "box": [], "saved_image_path": None}
        images.append("Error")
        labels.append(str(detect_result))
        return images, labels
    if model_size == "tiny":
        model_path = "path/to/model/tiny_best.h5"
        model = load_model_path(model_path)
    else:
        model_path = "path/to/model/base_best.h5"
        model = load_model_path(model_path)
    inference = model.predict(detection)
    _, threshold = min(filter(lambda x: x > 0, inference))
    for label, confidence in list(enumerate(inference[0])):
        if confidence > threshold:
            if label not in labels:
                detections = bounding_box_detection(detection, label)
                if detections is not None:
