from io import BytesIO
from PIL import Image

def count_green_tiles(image_path):
    with Image.open(BytesIO(open(image_path, "rb").read())) as img:
        gray_image = img.convert("L")
        rows = list(gray_image.split()[i] for i in range(len(gray_image)))
    green_tiles = sum(row.count(0) for row in rows)//2

    return green_tiles

