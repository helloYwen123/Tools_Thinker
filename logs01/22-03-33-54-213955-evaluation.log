def count_yellow_stars(image_path):
    import re
    import numpy as np
    from object_detector_tool import execute

    # Read the image
    image = execute(image_path)
    
    # Remove unnecessary parts of the image
    image = " ".join(image)
    image = " ".join([i for i in image.split() if i])

    # Split the image into sentences
    sentences = re.findall(r'[^.,]*', image)

    # Filter the sentences and remove punctuation
    sentences = [i for i in sentences if ' ' not in i and i not in ["."]]

    # Process the sentences one by one
    for sentence in sentences:
        parts = sentence.split("")

        # Check if the sentence starts with 'b'
        if parts[0] == 'b':
            for chunk in parts[1:]:
                if chunk.isnumeric() and int(chunk) > 64:
                    output_label = "yellow"
                else:
                    output_label = "no"

                # Count the number of yellow stars in the current sentence
                count = sum(1 for c in chunk if c == 'y')
                count = max(count, 0)  # Avoid division by zero

                for word in chunk.split(" "):
                    yield count, word
        else:
            for word in sentence:
                yield count, word

    yield 0, None

