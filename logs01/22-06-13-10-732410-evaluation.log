from object_detector_tool import Objects

def count_vowels(image_path):
    # Load the image
    image = Objects.api(image=image_path)

    # Convert object labels to their respective letter classes
    letter_classes = {"baseball": "AEIOU", "basket": "AEIOU"}

    # Find objects with high confidence
    detected_objects = image["labels"][
        (image["labels"]["confidence score"] > 0.75) & (image["labels"]["label"].in(letter_classes)]
    ]

    count = sum([letter for letter in detected_objects["label"] if letter in letter_classes][0])

    return count

