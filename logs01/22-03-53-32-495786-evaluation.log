def count_people_in_water(image_path, image_labels, threshold, model_size, padding):
    detection_tool = object_detector_tool()
    detection_tool.execute(image=image_path, labels=image_labels, threshold=threshold, model_size=model_size, padding=padding)
    bounding_boxes = [box for box in detection_tool.output][-1]
    coordinates = [(box[2], box[3]) for box in bounding_boxes]
    count = sum([float(coord[1]) < float(coord[2]) for coord in coordinates])
    return count

