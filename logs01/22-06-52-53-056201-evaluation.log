def count_elephants_with_trunks_in_water(image_path):
    # Read the input image and labels list
    input_image = Image.open(image_path)
    labels = 'elephant'

    # Detect elephants using the Grounding DINO model
    detection_results = object_detector.model_dino(input_image, labels, "tiny")

    # Get the bounding boxes of the detected elephants
    bounding_boxes = [d['bbox'] for d in detection_results["output_type"][0:10]]

    # Count the presence of trunks in the water
    count_trunks_in_water = sum([iou >= 0.35 for box in bounding_boxes if "trunk" in box[1] and "water" not in box[2]])

    return count_trunks_in_water

