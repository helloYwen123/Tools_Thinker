def detect_taller_buildings(image_path, labels, threshold, model_size, padding):
    import Object_Detector_Tool
    import numpy as np
    from PIL import Image

    # Load the image and convert it to PIL format
    image = Image.open(image_path)
    image = image.convert('RGB')

    # Normalize the pixel values from 0 to 255 to the range of the detection model
    image = np.array(image) / 255.0

    # Load the pre-trained model
    model = Object_Detector_Tool.load_model('custom_model.h5')
    model.load_weights('custom_model.h5')

    # Detect the objects in the image
    detection_results = []
    for label in labels:
        detection_objects = model.detect_objects_with_labels(image=image, 
                                                             labels=label, 
                                                             threshold=threshold, 
                                                             model_size=model_size, 
                                                             padding=padding)
        detection_results.append([f"{label}", detection_objects["confidence_score"], detection_objects["bbox"], 
                                 "custom_model.h5", [f"{label}", str(detection_objects["bbox"][0]), str(detection_objects["bbox"][1]), 
                                                      str(detection_objects["bbox"][2]), str(detection_objects["bbox"][3])]])
    
    # Return the detected objects dictionary
    return detection_results

