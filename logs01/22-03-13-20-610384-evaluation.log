def count_skiers(image_path, labels=("ski",), threshold=0.95, model_size="tiny", padding=0):
    # Load the image
    image_data = tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    if not image_data:
        return 0

    # Extract the detected objects bounding boxes and confidence scores
    if not image_data[0]:
        return 0

    # Calculate the number of objects which are "ski"
    num_skiers = sum((bbox[0] < 100 and bbox[2] > 250 for bbox in image_data[0]))

    return num_skiers

