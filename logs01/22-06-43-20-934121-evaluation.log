def count_player_blue_shirt_images(image_path, player_labels, threshold=0.35, model_size="tiny", padding=20):
    import Image
    image = Image.open(image_path)
    player_count = 0

    for player in player_labels:
        players = detected_objects(image, labels=[player])
        for player_image_stats in players:
            if player_image_stats['label'] == player:
                if 'confidence score' not in player_image_stats or player_image_stats['confidence score'] > threshold:
                    player_count += 1

    return player_count

def detection(image_path, labels=['baseball', 'basket'], threshold=0.5, model_size="base", padding=15):
    import DINO

    detection_output = DINO.load_config(model_name="dino_vit_h", pretrained=True, layers="tiny")
    detection_output.run(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    detected_objects = []
    for object in detection_output.results:
        if object.label in labels:
            detected_object = {'label': object.label, 'confidence score': object.confidence_score, 'box': [object.x1, object.y1, object.x2, object.y2], 'saved_image_path': object.saved_image_path}
            detected_objects.append(detected_object)

    return detected_objects

