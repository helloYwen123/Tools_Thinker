def detect_objects(image_path, labels, threshold=0.35, model_size='tiny', padding=20):
    image = Image.open(image_path)
    detection = detect(image.open(), labels=labels, threshold=threshold, model_name=model_size, padding=padding)
    detections = [obj for obj in detection]
    return detections

