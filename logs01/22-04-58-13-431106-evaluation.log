def count_red_letters(input_path, labels=['car', 'person', 'train'], threshold=0.5, model_size='base', padding=15):

    # Load the image and detect objects
    execution_output = execute_image(input_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    objects = pd.DataFrame(execution_output)
    objects = objects[objects['label'].isin(labels)].drop_duplicates()
    objects = objects[['label', 'confidence', 'bbox']]
    objects = objects[objects['confidence'] >= threshold].sort_values('confidence')

    # Count the number of red letters
    num_red_letters = len([obj for obj in objects.objects if 'red' in obj.label])

    return num_red_letters

