def objects_in_image(image_path, labels=None, threshold=None, model_size=None, padding=None):
    # Load the image
    image = Image.open(image_path)
    
    # Detect objects using the object_detector tool
    execution = torch.utils.data.load_dataset(image=image, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    if execution is not None:
        detected_objects = execution[0]
    else:
        detected_objects = []
    
    return detected_objects

def count_toilets(image_path):
    # Load the image
    image = Image.open(image_path)
    
    # Detect objects
    detected_object_result = objects_in_image(image_path, labels=["toilet"])
    if detected_object_result:
        detected_objects = detected_object_result[0]
    else:
        detected_objects = []
    
    # Count the toilets
    toilet_count = detected_objects.count("toilet")
    
    return toilet_count

