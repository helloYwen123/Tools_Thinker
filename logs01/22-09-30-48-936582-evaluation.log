def count_yellow_cars(image_path):
    # Load the image and extract bounding boxes
    img = execute(image_path=image_path, labels=["yellow car"], threshold=0.5, model_size="base")
    yellow_car_bboxes = [bbox for box in img["output"] for label in box["labels"] for bbox in label["bbox"]]
    
    # Convert list of bounding boxes to list of object dictionaries
    yellow_car_bboxes = [{'label': 'yellow car', 'confidence score': obj["label"], 'box': obj["bbox"], 'bbox': obj["bbox"]} for obj in yellow_car_bboxes]
    
    # Count the number of yellow cars in the image
    num_yellow_cars = len(yellow_car_bboxes)
    
    return num_yellow_cars
