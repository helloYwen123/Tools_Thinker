def count_boxes(image_path, labels, threshold, model_size, padding):
    try:
        detection_output = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
        detection_objects = detection_output.output_type
        num_boxes = 0
        for detection_box in detection_objects:
            if detection_box[0] in labels and detection_box[1] > threshold and detection_box[2][2] > float(0):
                num_boxes += 1
        return num_boxes
    except Exception as e:
        print(str(e))
        return 0

