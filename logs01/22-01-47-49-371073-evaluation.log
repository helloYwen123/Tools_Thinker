def count_red_bikes(image_path, labels=['motorcycle', 'person'], threshold=0.35):
    # Load the image
    execution = load_image(image_path=image_path)

    if execution['status'] == 'ok':
        # Detect objects in the image
        detected_objects = execute_detection(execution=execution, labels=labels, threshold=threshold)

        if detected_objects:
            # Calculate the number of red bikes
            count_red_bikes = sum([obj['label'] == 'motorcycle' for obj in detected_objects if obj['label'] in ['motorcycle', 'person'] and 'motorcycle' in obj['label']])
            return count_red_bikes
    else:
        print(f"Error occurred: {execution['error']}")
        return None

