def count_people(image_path, labels, threshold, model_size, padding):
    import Object_Detector_Tool
    from PIL import Image

    # Load the image and the associated annotations
    image = Image.open(image_path)
    image = image.convert('RGB')

    # Set the label to be counted
    labels_to_count = ["human"]

    try:
        # Detect the people in the image
        execution = Object_Detector_Tool.execute(image=image, labels=labels_to_count, threshold=threshold, model_size=model_size, padding=padding)

        # Get the bounding boxes and confidence scores
        bounding_boxes = []
        for obj in execution:
            bounding_box = (float(obj['bbox']['xmin']), float(obj['bbox']['ymin']), float(obj['bbox']['xmax']), float(obj['bbox']['ymax']))
            confidence = float(obj['bbox']['confidence'])
            bounding_boxes.append({'label': obj['categories'][0]['name'], 'confidence': confidence, 'bbox': bounding_box})

        # Count the number of people in the image
        num_people = 0
        for box in bounding_boxes:
            if box['label'] in ["human"]:
                num_people += 1

        return num_people

    except Exception as e:
        print(f"Error retrieving people: {str(e)}")
        return -1

