def count_yellow_stars(paths: List[str]) -> int:
    """
    Counts the number of yellow stars on a colorful bridge.
    """
    total_yellow_stars = 0
    for path in paths:
        for object_info in detection(image_file=path, labels=['stars', 'yellow'], threshold=0.9, model_size="base", padding=10).['output_type']:
            if object_info['label'] == 'yellow':
                total_yellow_stars += object_info['confidence_score']
    return total_yellow_stars

