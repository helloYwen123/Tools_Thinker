def count_unwearing_blue_hats(leader_dict):
    # This function takes leader_dict, which is a dictionary where the keys are the
    # leaders and the values are lists of (label, confidence score), and returns an integer
    # representing the number of leaders who are not wearing a blue hat.
    # The function first filters out leaders who have at least one hat on and then counts
    # the number of leaders without hats.

    count = 0
    for leader in leader_dict:
        for cap in leader:
            if cap['label'] == 'blue_hat':
                count += 1
    
    return count

