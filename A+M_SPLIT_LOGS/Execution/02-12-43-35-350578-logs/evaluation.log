# Load the image and convert it to a tensor for processing
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_77_image_1.jpg"
image = cv2.imread(image_path)
image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
image = np.array(image).reshape(1, 1, image.shape[1], image.shape[2])


# Detect the baseball and basketball in the image
labels = ["baseball", "basket"]
detected_objects = Object_Detector_Tool.execute(image=image,
                                                labels=labels,
                                                threshold=0.5,
                                                model_size='base',
                                                save_object=True,
                                                saved_image_path="detected_objects")
detected_objects = list(detected_objects[0]["detected_results"])

# Determine the number of people wearing a suit
suit_count = 0

for det in detected_objects:
    if "boxes" in det:
        person = det["person"]
        if person == "suit":
            suit_count += 1 

# Output the final result
final_result = str(suit_count)
if final_result == '2':
    print('Answer: (D)')
elif final_result == '0':
    print('Answer: (C)')
elif final_result == '1':
    print('Answer: (B)')
else:
    print('Answer: (A)')

