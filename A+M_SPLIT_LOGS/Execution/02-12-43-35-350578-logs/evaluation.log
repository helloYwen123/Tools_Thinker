# Detect objects
labels = ["baseball", "basket"]
confidence_threshold = 0.45
model_size = "tiny"

# Detect baseball object
detected_labels = object_detector.detect_objects(image, labels=labels, confidence_threshold=confidence_threshold, model_size=model_size, save_object=False)

# Detect basketball object in the same image
detected_labels_basket = object_detector.detect_objects(image, labels=["basket"], confidence_threshold=confidence_threshold, model_size=model_size, save_object=False)

# Create a dictionary for each detected object
detected_objects = defaultdict(lambda: defaultdict(list))

for label in detected_labels:
    category = label.split("_")[-1]
    for i, detected in enumerate(detected_labels_basket):
        if detected["label"] == label:
            detected_objects[label]["boxes"].append(detected["bbox"])
            detected_objects[label]["confidence_scores"].append(detected["confidence"])
            detected_labels_basket[i]["boxes"].append(detected["bbox"])
            detected_labels_basket[i]["confidence_scores"].append(detected["confidence"])

# Find the number of people wearing suit
num_people_wearing_suit = 0
for label, objects in detected_objects.items():
    if objects["label"] == "suit":
        num_people_wearing_suit += len(objects["boxes"])
