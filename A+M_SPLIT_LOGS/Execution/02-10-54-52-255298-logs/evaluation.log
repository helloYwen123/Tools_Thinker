Code: from object_detector import Object_Detector_Tool

final_result = None

# Convert file_to_image_path into a string
file_to_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_61_image_1.jpg"

# Create an instance of Object_Detector_Tool
tool = Object_Detector_Tool()

# Execute the tool: Detecting the license plate of the motorcycle in the image
detected_objects, object_number = tool.execute(image=file_to_image_path, labels=["motorcycle"], threshold=0.45, model_size="base", save_object=True, saved_image_path="detected_objects")

# Check if the tool returned any detected objects
if len(detected_objects) > 0:
    # Output the results
    print("Number of objects detected:", len(detected_objects))
else:
    print("No objects detected.")
finally:
    # Clean up, delete any detected images created during the process
    import os
    for f in os.listdir("detected_objects"):
        if f.endswith(".png"):
            os.remove(f)
    
    print("Cleaning up detected objects and image files.")
    tool.shutdown()

