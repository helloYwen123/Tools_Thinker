from detectron2 import DETECTRON_MODELS, model_registry

def run_inference(model_path, image_path, *args, **kwargs):
    model = model_registry.get_model(
        model_path=model_path, 
        model_id=None, 
        scale=128, 
        class_names=['baseball', 'basket'], 
        num_classes=2, 
        thresholds=[0.5], 
        model_name='detectors/largesize', 
        *args, 
        **kwargs)
    
    result_dict = model(image_or_path=image_path)
    detections = result_dict["detections"]
    for det in detections:
        labels = set(det.get("labels"))
        for label in labels:
            count = det.get("labels").get(label)
            if count:
                print(f"{label}: {count}")
