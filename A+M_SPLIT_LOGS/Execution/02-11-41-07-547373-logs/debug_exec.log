code:import cv2
from object_detector_tool import Object_Detector_Tool, Object_Detection, Color

def count_red_shirts(image_path):
    tool = Object_Detector_Tool()
    results = tool.execute(image=image_path, labels=["red"], threshold=0.45, model_size="tiny", save_object=True)
    
    red_shirt_count = 0
    for label in results["output"]:
        for box in label["boxes"]:
            if Color.box_color_in_list(box["Color"], "red"):
                red_shirt_count += 1
                
    return red_shirt_count

