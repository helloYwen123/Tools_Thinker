Code: from object_detector import Object_Detector_Tool

# Create the object detector tool
object_detector_tool = Object_Detector_Tool()

# Read image file
image_file_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_116_image_1.jpg"

# Set labels for detection
labels = ["baseball"]

# Threshold for confidence
threshold = 0.3

# Size of the model to use (default: 'tiny')
model_size = "tiny"

# Save object detection results
save_object = True
saved_image_path = "detected_objects"

# Detect and count players
detected_objects, object_number = object_detector_tool.execute(image=image_file_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Calculate count of players in the image
total_players = detected_objects["object_number"].values()

# Calculate and print the number of players playing in tennis
num_players_playing_tennis = total_players[0]

final_result = object_number[0]

print(f"The number of people playing in tennis is: {num_players_playing_tennis}")

