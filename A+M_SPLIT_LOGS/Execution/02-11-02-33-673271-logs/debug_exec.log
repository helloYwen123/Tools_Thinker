def find_people_without_hats(image_path):
    # Load the image
    image = Image.open(image_path)
    # Detect hats and people
    object_detector_tool = Object_Detector_Tool(image_path)
    detected_objects, object_number = object_detector_tool.execute(labels=["hat"], save_object=False, saved_image_path="detected_objects")

    # Count the number of detected people without hats
    people_without_hats = 0
    for label in object_number:
        if object_number[label]["boxes"] != []:
            for box in object_number[label]["boxes"]:
                if box.get("label") == "person":
                    continue
                elif box.get("label") == "cloth_hat":
                    continue
                else:
                    people_without_hats += 1

    return people_without_hats

