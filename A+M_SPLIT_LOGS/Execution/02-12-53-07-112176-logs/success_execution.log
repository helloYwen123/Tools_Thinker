from object_detector import Object_Detector_Tool

# Load the image
label_list = ['basin']
object_detector_tool = Object_Detector_Tool()
label_counts = object_detector_tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_48_image_1.jpg", labels=label_list, save_object=True, saved_image_path="detected_objects", threshold=0.45, model_size="tiny")

# Find the number of toilets with lids
lids_with_toilets = 0
for label in label_counts:
    if label['label'] == "toilet" and int(label['boxes'][0]) >= 14:
        lids_with_toilets += 1
        print(f"{label['label']} (with lids): {label_counts[label['label']]['boxes'][0]}")

# Final result
final_result = "No specific toilets detected with lids."
if lids_with_toilets > 0:
    final_result = f"{lids_with_toilets} toilets have lids."

final_result
