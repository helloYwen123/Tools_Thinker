code:from object_detector import Object_Detector_Tool
import imageIO

def count_toilets(image_path):
    result = {}
    # Load the image as a NumPy array
    image = imageIO.imread(image_path)
    
    # Apply the object classifier
    classifier = Object_Detector_Tool(
        labels=['baseball', 'basket', 'toilet'],
        save_object=True,
        saved_image_path='toilets'
    )
    result = classifier(image)
    
    return result
    
