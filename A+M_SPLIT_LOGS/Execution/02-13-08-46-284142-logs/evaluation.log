save_object = True

# Execute demo command with the given paths
detected_objects, object_number = object_detector_tool.execute(image=image_path, labels=labels, save_object=save_object)

# Count and determine flower pot sizes using object_number
flower_pot_counts = {}
for i, num in object_number.items():
    if num > 0:
        for label in labels:
            if label in ["baseball", "basket"]:
                pass
            elif label == "flower_pot":
                final_result = f"{flower_pot_counts.get(label, 0) + num}"  # Calculate flower pot count
                final_result += " (1)"  # Add a placeholder for other flower pots
                flower_pot_counts[label] = final_result
            else:  # Assume "mug", "cup", "plate", etc.
                final_result = f"{flower_pot_counts.get(label, 0) + num}"  # Calculate flower pot count
                final_result += " (1)"  # Add a placeholder for other flower pots
                flower_pot_counts[label] = final_result

