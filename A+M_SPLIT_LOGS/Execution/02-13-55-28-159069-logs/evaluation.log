#Detect dogs in the image
detected_objects, obj_num = detector.execute(image_path=path_to_image, labels=labels_to_detect, threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects")

#Print the detected objects and their counts
for label, obj_result in sorted(detected_objects.items()):
    print(f"{label}:")
    for obj in obj_result['objects']:
