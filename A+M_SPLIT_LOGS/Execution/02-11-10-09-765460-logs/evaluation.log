Code: from object_detector import Object_Detector_Tool

# Function to count the wine bottles
def count_bottles(image_path):
    # Load the image
    tool = Object_Detector_Tool()
    tool.execute(image_path="path/to/round_table.jpg", labels=["wine"], save_object=True, saved_image_path="detected_objects")
    
    # Initialize counters for wine and beer
    wine_count = 0
    beer_count = 0
    
    # Loop through detected objects and count wine and beer bottles
    for label, boxes, conf_scores in tool.labels_result:
        boxes_wine = [box for box in boxes if "wine" in box["group"]]
        if boxes_wine:
            wine_count += len(boxes_wine)
        boxes_beer = [box for box in boxes if "beer" in box["group"]]
        if boxes_beer:
            beer_count += len(boxes_beer)
    
    return wine_count, beer_count

# Example usage:
final_result = count_bottles("/path/to/round_table.jpg")
print("Wine bottles:", final_result[0], "Beer bottles:", final_result[1])

# Calculate the number of bottles on the round table
number_of_bottles = final_result[0] + final_result[1]

print("There are", number_of_bottles, "bottles on the round table.")

