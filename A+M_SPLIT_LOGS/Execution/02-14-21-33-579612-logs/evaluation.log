class ImageAnalyzer(object):
    def analyze_image(self, image_path):
        tool_name = "Object_Detector_Tool"
        tools = {"object_detector": object_detector,
                 "Image_Analyzer_Tool": self}
     
        tool = tools.get(tool_name, None)
        if tool is not None:
            if isinstance(image_path, str):
                res = tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")
                final_result = self.get_tools(tool_name, res).get("detected_objects")
            else:
                raise TypeError("Image path should be a string.")
        elif tool_name == "Object_Detector_Tool":
            final_result = self.detect_and_save_images(image_path)
        else:
            return False

    def detect_and_save_images(self, image_path):
        labels = ["baseball", "basket"]
        tool = object_detector.Object_Detector_Tool()
        res = tool.execute(image=image_path, labels=labels, save_object=True)
        detections = res[0]  # only check the first object detection result
        if detections is None:
            return None

        class_name = detections["class_name"]
        box = detections["bbox"]
        save_path = f"detected_objects/{class_name}_detected_{image_path.split('/')[-1]}"
        detection_box = "bbox"
        box_dict = {
            "class_name": class_name,
            "bbox": box
        }
        box_dict["bbox"] = [{"x": int(x), "y": int(y), "w": int(w), "h": int(h)} for x, y, w, h in box]
        box_dict["bbox"].append({"x": int(x), "y": int(y), "w": int(w), "h": int(h)}  # append object on the image
        return final_result + (box_dict, )

    def get_tools(self, tool_name, res):
        if tool_name != "Object_Detector_Tool":
            final_result = None
        else:
            return res
        return final_result

