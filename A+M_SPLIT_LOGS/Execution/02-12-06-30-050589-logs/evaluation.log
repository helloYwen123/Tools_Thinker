width, height = image.size
# Normalize the image
transform = transforms.Compose([transforms.Resize([int(0.5 * height), int(0.5 * width)]),
                                 transforms.ToTensor(), 
                                 transforms.Normalize([0.485 * 255, 0.456 * 255, 0.406 * 255],
                                                      [0.229 * 255, 0.226 * 255, 0.226 * 255])])
image = transform(image)
# Convert the RGB image to a grayscale image
image = np.array(image)/255
# Detect objects in the image (in this case, it will be 'basball' and 'basket')
