    def execute(self, image_path: str, labels: list, save_object: bool = False, saved_image_path: str = ""):
        try:
            import MODULE.object_detection.detectron as object_detector
            predictions = object_detector.getObjects(image_path, labels, threshold=0.45, model_size="base", save_object=save_object)
        except Exception as e:
            return "Error: Could not detect objects in the image," str(e)

        result = {
            label: [
                ["boxes", "confidence", "boxes.png", "confidence.png", str(label)]
                for labels_ in predictions for label in labels_
            ]
        }
        if saved_image_path:
            for label in labels_:
                for img, score, img_name, score_name in predictions:
                    box_path = os.path.join(saved_image_path, f"{label}_bbox.json")
                    save_json(box_path, predictions, img, f"{label}_bbox.json")
                    box_file_opened = os.path.isfile(box_path)
                    if box_file_opened:
                        print(f"Object {label} detected. Box saved as '{box_path}'")
                    else:
                        print(f"Could not find object label {label} in this image.")
        return (result, labels.count(label) for label in labels)

