# Path to the image file
image_file_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_76_image_1.jpg"

# Initialize the object_detector
object_detector = Object_Detector_Tool(image_file_path)

# Initialize a dictionary to store the detected objects and their counts
detected_objects = {}

# Detect objects in the image
for label in object_detector.labels:
    result = object_detector.execute(labels=f"[{label}]")
    if result['detected_objects']:
        total_count = result['detected_objects'][0][label]['count']
        
        # Save the detected object images
        if 'saved_object' in object_detector.args:
            saved_image_path = object_detector.args['saved_object']
            if saved_image_path:
                object_detector.args['save_object'] = True
                for obj in result['detected_objects']:
                    img_path = obj['image_path']
                    saved_image_path = os.path.splitext(img_path)[0] + "_detected_" + label + "_" + str(total_count) + ".jpg"  # Add 'number of detected' for each detected object
                    object_detector.args['saved_image_path'] = saved_image_path
                    object_detector.args['boxes'] = obj['boxes']
                    object_detector.args['confidence_scores'] = obj['confidence_scores']
            
                # Store the detected object label grouping and count in the 'detected_objects' dictionary
                detected_objects[label] = result['detected_objects'][0]
                for obj in result['detected_objects']:
                    detected_objects[label]['count'] += obj['count']

# Check if there's only one object detected
if len(detected_objects) == 1:
    final_result = "C"
else:
    final_result = "D"

detected_objects

