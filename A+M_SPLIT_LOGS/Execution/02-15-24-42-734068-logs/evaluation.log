Code: from object_detector import Object_Detector_Tool

# Function to count blue collars in the photo
def count_blue_collars(image_path):
    detected_objects = Object_Detector_Tool.execute(image_path=image_path, labels=['blue collar'], save_object=True, saved_image_path="detected_objects")
    blue_collars_count = {}
    for label, item in detected_objects.items():
        for _, box, score in item['boxes']:
            if label == 'blue collar':
                blue_collars_count[label] = score
    return blue_collars_count

# Assuming the image path is provided in the variable 'image_path'
blue_collars_count = count_blue_collars(image_path='/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_38_image_1.jpg')
final_result = blue_collars_count['blue collar']
print(final_result)

