Code: def get_count_of_people_with_hat(image_path, *args, **kwargs):
    # Create an Object_Detector_Tool instance with the provided parameters
    obj_detector_tool = Object_Detector_Tool(image_path=image_path,
                                            labels=["hat", "no_habit"],
                                            model_size="tiny",
                                            save_object=True,
                                            *args,
                                            **kwargs)
    
    # Call the tool with the 'hat' label to get the total count of 'hat'
    count = obj_detector_tool.execute(labels=["hat"], threshold=0.45, model_size="tiny", save_object=True, *args, **kwargs)
    
    # Get the total count from the output of the tool
    total_count = count["object_number"]["baseball"]
    
    return total_count

