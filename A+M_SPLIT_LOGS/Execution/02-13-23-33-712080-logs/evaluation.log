Code: from object_detector import Object_Detector_Tool

# Function to count the number of red bikes
def count_red_bikes(image_path):
    # Initialize the object detector tool
    detector_tool = Object_Detector_Tool(image_path)
    
    # Use the tool to detect the red bikes
    detected_objects = detector_tool.execute(labels=["red_bike"], save_object=True, thresholds=[0.45, 0.45, 0.45])
    
    # Count the number of "red_bike" detected objects in the image
    red_bike_count = len(detected_objects['detect_result']['baseball']['boxes'])
    
    return red_bike_count

final_result = count_red_bikes("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_110_image_1.jpg")
print("Number of red bikes:", final_result)

