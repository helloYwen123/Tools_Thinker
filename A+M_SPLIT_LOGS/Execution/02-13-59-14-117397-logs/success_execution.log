    result = Obj_DetectTool.execute(image=path_to_image, labels=["bus"], save_object=True)
    object_data["detected_objects"] = result
except Exception as e:
    print(f"An error occurred: {e}")

# Check if the image contains 'bus' as a detected object
if object_data["detected_objects"] and "bus" in object_data["detected_objects"][0]["label"]:
    if "boxes" in object_data["detected_objects"][0]["count"]:
        object_count = sum(map(len, [box for box in obj["count"] for obj in object_data["detected_objects"] if obj.get("label") == "bus"]))
else:
    object_count = 0

