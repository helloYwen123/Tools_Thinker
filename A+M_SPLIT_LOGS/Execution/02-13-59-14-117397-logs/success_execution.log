    if "bus" in object_data["detected_objects"][0]["label"]:
        final_result = "1"
    elif object_data["detected_objects"][0]["count"]["boxes"]:
        final_result = "3"
    else:
        final_result = "0"
else:
    final_result = "A"

print(f"Final result: {final_result}")
