Code: from object_detector import Object_Detector_Tool

# Function to count the objects
def count_objects(image_path, labels=['baseball', 'basket']):
    object_detector = Object_Detector_Tool()
    box_results, score_results, image_paths = object_detector.execute(image_path, labels=labels, save_object=False)
    
    # Initialize variables for total count of each object
    total_counts = {'baseball': 0, 'basket': 0}
    
    # Calculate the total count
    for label in total_counts:
        total_counts[label] = box_results[label].sum().sum()
    
    return total_counts

# Given image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_1_image_1.jpg"

# Using the tool to count the baseball and basketballs
total_baseball_count = count_objects(image_path, ['baseball'])
total_basket_count = count_objects(image_path, ['basket'])
total_counts = {'baseball': total_baseball_count, 'basket': total_basket_count}
total_counts

