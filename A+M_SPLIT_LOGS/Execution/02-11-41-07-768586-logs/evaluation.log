Code: from object_detector import Object_Detector_Tool

# Read image
detector_tool = Object_Detector_Tool()

# Image file path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_19_image_1.jpg"

# Get detected objects from image
objects, object_number = detector_tool.execute(image=image_path, labels=["urine", "gas"], save_object=True, saved_image_path="detected_objects")

# Count objects
number_of_green_tiles = 0
for obj in objects["urine"]:
   for tile in obj["boxes"]:
      if tile["x"] > 25 and tile["y"] > 0 and tile["x"] < tile["width"] and tile["y"] < tile["height"]:
         number_of_green_tiles += 1;

# Check final result
final_result = "D"
if number_of_green_tiles == 3:
   final_result = "C"

print("Final Result:", final_result)

