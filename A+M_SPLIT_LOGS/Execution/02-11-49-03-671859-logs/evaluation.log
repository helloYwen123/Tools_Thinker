Code: from object_detector import Object_Detector_Tool

label_names = ["baseball", "basket",
              "flag", "hat", "shirt", "pants", "socks"]
num_labels = len(label_names)

labels = ["flag", "hat", "shirt", "pants", "socks"]

threshold = 0.45
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Object Detection
object_detector_tool = Object_Detector_Tool()
detected_objects, object_number = (
    object_detector_tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_118_image_1.jpg", labels=labels, save_object=save_object, saved_image_path=saved_image_path, threshold=threshold))

# Process detected objects
total_counts = {}
for label in detected_objects:
    labels_per_image = total_counts.get(label, 0)
    total_counts[label] = int(labels_per_image + 1)

output = []
i = 0
prev_class = detected_objects[i][label_names[0]]
for detected_object in detected_objects:
    class_name = detected_object[label_names[0]]
    if class_name != prev_class:
        output.append({"name": f"{class_name}", "total_count": total_counts[class_name]})
        prev_class = class_name
    output.append({"name": detected_object[label_names[i]]["name"], "total_count": detected_object[label_names[i]]["confidence_scores"][-1]})

final_result = max(output, key=lambda x: x["total_count"])

