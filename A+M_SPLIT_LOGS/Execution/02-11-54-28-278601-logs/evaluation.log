Code: import os
# Load the object detector model with the provided parameters
from object_detector import Object_Detector_Tool

# Define the path to the image file and the corresponding labels list
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_44_image_1.jpg"
labels = ['baseball', 'basket']

# Create an instance of the Object_Detector_Tool class
tool = Object_Detector_Tool()

# Execute the tool with the labels and threshold to detect objects
tool.execute_image(image_path=image_path, labels=labels, threshold=0.45, save_object=True)

# Print the counts of each detected label
for label, label_count in tool.output_types['object_number']:
    print(f'{label}: {label_count}")

# Determine the most frequent label detected
most_frequent_label = max(tool.output_types, key=tool.output_types.get)
final_result = most_frequent_label
print(f"The most frequent object in the image is: {most_frequent_label} (count: {tool.output_types.get(most_frequent_label, 0)})")

# Save the detected objects if requested
if tool['save_object']:
    if 'detected_objects' in tool.output_types:
        detected_objects = tool['detected_objects']
        # Print each detected object along with its paths
        for desc, objects in detected_objects.items():
            print(f'Label found: {desc} - Number of objects: {len(objects)}')

