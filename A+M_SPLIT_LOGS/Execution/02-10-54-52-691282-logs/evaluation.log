Code: def count_sunglasses(glasses_image_path):
    # Initialize counting variables
    sunglasses_count = 0

    # Use the Object_Detector_Tool tool to detect sunglasses
    detector = Object_Detector_Tool()
    labels = ["sunglasses"]
    threshold = 0.5
    model_size = "tiny"

    # Execute the tool
    tool_output = detector.execute(image=glasses_image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True)

    # Count the number of detections
    sunglasses_count = len(tool_output['object_detection_results']['box_lists'][0]['saved_image_paths']) * 2  # Each bounding box detection is count as 2 if it is a sunglasses

    # Print the result
    print(f"Number of sunglasses detected: {sunglasses_count}")
