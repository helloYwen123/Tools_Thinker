Code: from object_detector import Object_Detector_Tool

# Define the image path and other parameters for detecting tennis rackets
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_92_image_1.jpg"

# Create an instance of the Object_Detector_Tool class with the given parameters
detector_tool = Object_Detector_Tool(image_path, labels=["tennis_racket", "tennis_racket"] if any(['tennis_racket' in image_path for image_path in ImagePaths]) else None, save_object=True, saved_image_path="detected_objects")

# Initialize a variable to count the number of people holding tennis rackets
num_tennis_rackets_carried = 0

# Iterate over the detection results and increment the count
for detected_object in detector_tool.output:
    if detected_object['label'] == "tennis_racket":
        num_tennis_rackets_carried += detected_object['count']

# Print the number of people carrying tennis rackets
final_result = min(1, int(num_tennis_rackets_carried))
print(final_result)

