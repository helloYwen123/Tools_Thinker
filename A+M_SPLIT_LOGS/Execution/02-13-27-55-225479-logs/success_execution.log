from object_detector import Object_Detector_Tool

# Load the image
object_detector_tool = Object_Detector_Tool()
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_92_image_1.jpg"
labels = ["baseball", "basket"]
threshold = 0.45
model_size = "base"

# Run the tool
object_detection_results = object_detector_tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=0)

# Check if the tool detected any tennis rackets
if "baseball" in object_detection_results:
    num_balls = object_detection_results["baseball"]["count"]
    if "basket" in object_detection_results:
        num_baskets = object_detection_results["basket"]["count"]
        total_count = num_balls + num_baskets
else:
    total_count = 0

final_result = total_count
