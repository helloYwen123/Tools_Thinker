warnings.filterwarnings('ignore')  # Ignore the standard library warnings

def find_knob_stove(image_path):
    try:
        od = Object_Detector_Tool()
        image = cv2.imread(image_path)
        detected_objects, obj_num = od.execute(image=image, labels=['knobs'], save_object=True, saved_image_path="detected_objects")
        boxes = detected_objects['detected_labels'].get('boxes')
        knobs = boxes[np.argwhere(detected_objects['detected_labels']['confidence_scores'] == 1.0)]
        return len(knobs)
    except Exception as e:
        print("An error occurred while processing the image:", e)
        return None

