    for object in objects.get("boxes", []):
        if label == "Plane" and objects.get("confidences", [], target=0.9)[0] > 0.95:
            print(f"Found a purple {label} plane near {image_names[0]}")
            purple_planes_found += 1

# Final result
final_result = "A" if purple_planes_found >= 2 else "None"
print(final_result)

