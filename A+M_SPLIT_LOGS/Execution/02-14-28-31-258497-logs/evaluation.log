Code: from object_detector import Object_Detector_Tool

# Load image file
with Image.open("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_77_image_1.jpeg") as image:
    # Detect objects using the object_detector tool
    detected_objects, object_number = Object_Detector_Tool.execute(image=image, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Count the objects
total_objects = sum(object_number.values())

# Determine how many people are wearing suit
people_wearing_suit = total_objects - {label: detected_objects[label].get('boxes') for label in ["baseball", "basket"]}.get("baseball", 0) - {label: detected_objects[label].get('boxes') for label in ["baseball", "basket"]}.get("basket", 0) - {label: detected_objects[label].get('confidence_scores', None) for label in ["baseball", "basket"]} + {label: detected_objects[label].get('boxes') for label in ["baseball", "basket"]}["baseball"] - {label: detected_objects[label].get('boxes') for label in ["baseball", "basket"]}["basket"]

# Determine how many people are not wearing suit
total_non_suit = 2 - {label: detected_objects[label].get('boxes') for label in ["baseball", "basket"]}["baseball"] - {label: detected_objects[label].get('boxes') for label in ["baseball", "basket"]}["basket"]

final_result = (total_objects, people_wearing_suit)

