Code: from object_detector import Object_Detector_Tool

image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg"
labels = ["elephant"]
threshold = 0.45
model_size = "tiny"
save_object = True

final_result = Object_Detector_Tool.execute(image_path, labels, threshold, model_size, save_object)

def count_objects(results, labels):
    result_count = {}
    for label in labels:
        result_count[label] = len(results[label])
    return result_count

all_labels = {**final_result['output_types'][0]['grouped_detection_results']['labels'], **final_result['output_types'][0]['labels']}
all_objects = {**final_result['output_types'][0]['grouped_detection_results']['boxes']}

elephant_count = count_objects(all_labels, ['elephant'])
print(elephant_count)  # expected: {'elephant': 3}

result = final_result['output_types'][1]

for label, count in result.items():
    print(f"{label}: {count}")
    if label == 'elephant':
        print("There are:", elephant_count)
        break
else:
    print("All detected objects present.")

