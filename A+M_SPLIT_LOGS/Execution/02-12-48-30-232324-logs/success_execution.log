from object_detector import Object_Detector_Tool

final_result = "D"
detector_tool = Object_Detector_Tool()
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg"
labels = ["elephant"]

try:
    results = detector_tool.execute(image_path, labels, thresholds=[0.45], save_objects=True)
except Exception as e:
    print(f"Error occurred: {e}.")
else:
    detected_objects = results['object_number']
    if detected_objects == 3:
        final_result = "A"
    elif detected_objects == 2:
        final_result = "B"
    elif detected_objects == 1:
        final_result = "C"
    elif detected_objects == 0:
        final_result = "E"  # Detection failed
    else:
        print("Unexpected outcome")
