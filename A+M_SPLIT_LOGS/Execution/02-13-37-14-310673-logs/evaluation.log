Code: from object_detector.util import Object_Detector_Tool

# Assuming you have the Image Path and Labels
# Load the detector tool
tool = Object_Detector_Tool()

# Detect objects in the image
detected_objects, _, _ = tool.execute(image="/path/to/image.jpg", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Extract detected objects and their counts
labels_dict = {}
for label in detected_objects.keys():
    labels_dict[label] = {'boxes': [], 'scores': [], 'saved_image_paths': []}
    for obj in detected_objects[label]:
        boxes = obj['bbox']  # Extract boxes, it's always a tuple
        labels_dict[label]['boxes'].append(boxes)
        if obj['score'] >= 0.5:  # Set confidence threshold
            labels_dict[label]['saved_image_paths'].append(obj['image_id'])
        obj.pop('bbox', None)  # Remove detected bounding box for next label detection

# Identify the number of fingers in front of the bathtub
total_labels = 0
for label_dict in labels_dict.values():
    total_labels += len(label_dict['boxes'])

# Assign final result
final_result = 'Your final result is B due to the identified number of fingers is 3.'

# Output final result as string, or any other structure of choice
final_result

