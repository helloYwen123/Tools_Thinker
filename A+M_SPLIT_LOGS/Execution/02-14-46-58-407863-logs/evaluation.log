Code: def count_empty_blue_seats(auto_image_path):
    """
    Count empty blue seat in an Auto Image

    Parameters:
    auto_image_path (str): Path to the auto image

    Returns:
    int: Number of empty blue seats

    """
    object_detection_tool = object_detector.Object_Detector_Tool()
    object_detection_tool.execute(image=auto_image_path, labels=["Blue"), save_object=True, saved_image_path="result")

    detected_object_results = object_detection_tool.output_types[0][0]["count"]
    empty_blue_seats = detected_object_results.get("Blue", 0)
    return empty_blue_seats

final_result = count_empty_blue_seats("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_80_image_1.jpg")
print(f"Number of empty blue seats: {final_result}")

