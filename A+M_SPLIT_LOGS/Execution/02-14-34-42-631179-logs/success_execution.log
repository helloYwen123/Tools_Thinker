from object_detector import Object_Detector_Tool

def main():
    path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_50_image_1.jpg"
    labels = ["blue_towel"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True
    saved_image_path = "detected_objects"

    final_result = Object_Detector_Tool.execute(
        image=path_to_image,
        labels=labels,
        save_object=save_object,
        saved_image_path=saved_image_path,
        threshold=threshold,
        model_size=model_size,
    )

    if final_result["object_number"] == 2:
        print("Correct result: There are 2 blue towels in the picture.")
    else:
        print("Wrong result: The number of blue towels is not correct.")

if __name__ == "__main__":
    main()
