code:from object_detector import Object_Detector_Tool

# Function to count the number of detected objects in an image
def object_count(image_path, labels, save_object=False, threshold=0.45, model_size="tiny", saved_image_path="detected_objects"):
    # Initialize object_detector_tool with the provided parameters
    object_detector_tool = Object_Detector_Tool(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

    # Detect objects in the image
    print(f"Detecting objects in {image_path} with labels: {labels}")
    detected_objects, object_number = object_detector_tool.execute()

    return detected_objects, object_number

