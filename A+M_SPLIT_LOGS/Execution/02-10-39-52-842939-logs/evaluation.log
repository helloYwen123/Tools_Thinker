from object_detector import Object_Detector_Tool

# Define a function to run the object detector tool with the image path as an argument
def run_object_detector(tool_module_name, tool_class_name, image_path, labels, threshold, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
    # Initialize the object detector tool with arguments passed as parameters
    tool = getattr(Object_Detector_Tool, tool_class_name)(**{tool_module_name: image_path, tool_class_name: tool_module_name, 'labels': labels.__contains__(category) or ('None' in labels), 'threshold': threshold, 'model_size': model_size, 'save_object': save_object, 'saved_image_path': saved_image_path})
    
    # Call the tool to detect objects
    results = tool.execute()
    
    # Loop over the detected objects and count the number of toilets with lids
    toilet_count = sum(result['boxes']['lid'] for result in results if 'lid' in result)
    
    # Return the count of toilets with lids
    return toilet_count

# Given image paths
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_48_image_1.jpg"

# List of labels (in this case, just 'toilet')
labels = ['toilet']

# Run object detector tool
toilet_count = run_object_detector('Object_Detector_Tool', 'Object_Detector_Tool', image_path, labels, threshold=0.45)

# Analyze the results
final_result = labels[0] if toilet_count > 0 else None

# Decide the final result, e.g., if toilet_count > 0, choose (C) 3; otherwise, choose (A) 4
if toilet_count:
    final_result = 3
else:
    final_result = 4

# Output the final result
print(final_result)

