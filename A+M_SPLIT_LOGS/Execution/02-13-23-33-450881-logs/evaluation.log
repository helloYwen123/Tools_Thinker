def get_vowel_count(img_path):
    label_scores = {}  # Initialize a dictionary to store the score of each label.
    detected_box = {}  # Initialize a dictionary to store the coordinates of detected objects.

    # Load the image
    image = Image.open(img_path)

    # Detect the objects in the image
    object_detector = Object_Detector_Tool(image=image, labels=["vowel"], model_size="tiny")
    label_scores = object_detector.execute()

    # Find the labels with the highest score
    max_score_labels = sorted(label_scores.items(), key=lambda x: x[1], reverse=True)[:5]

    # Sum up the scores of the top 5 labels
    highest_score_label = max_score_labels[0][0]
    for label in max_score_labels[1:]:
        label_scores = {}
        label_scores = object_detector.execute(label=label, labels=["vowel"], model_size="tiny")
        max_score_labels.append([label[0], sum(label_scores)])

    # Calculate the total count of the detected vowels
    total_vowel_count = sum(highest_score_label['score'] for label in highest_score_labels for _, score in label['scores'])

    return total_vowel_count

