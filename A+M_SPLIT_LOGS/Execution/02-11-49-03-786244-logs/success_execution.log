from object_detector import Object_Detector_Tool

class SandwichObject_Detector_Tool:
    def execute(self, image_path, labels=None, save_object=False, saved_image_path=""):
        # Load the image
        image = Image.open(image_path)

        # Check if a labels parameter is given
        if labels is not None:
            # Detect the labels in the image
            labels_result = self.object_detector(image, labels=labels, save_objects=save_object)
            predicted_sandwiches = labels_result['object_number']['1']

        else:
            # Detect the sandwich labels in the image
            sandwich_labels = ['butter_bun_sandwich', 'tuna_sandwich', 'sausage_sandwich', 'chicken_sandwich']
            predicted_sandwiches = self.object_detector(image, labels=sandwich_labels)

        # Output the total count of sandwich plates
        print(f"The number of sandwich plates holding sandwiches is: {predicted_sandwiches}")

def object_detector(image, labels=None, save_objects=False, saved_image_path=""):
    # Define the labels to detect and their confidence threshold
    labels = ["baseball", "basket"]

    # Initialize the object detector tool
    tool = Object_Detector_Tool(labels=labels, confidence_threshold=0.45, model_size="tiny", save_objects=save_objects)

    # Detect the labels in the image
    boxes = tool.execute(image=image)

    # Count the detected sandwiches
    sandwich_count = tool.number_of_objects_by_label(boxes)

    # Output the total count of sandwich plates
    print(f"The number of sandwich plates is: {sandwich_count}")

