# Function to check if the number of sandwiches is among the given options
def count_sandwiches():
    # Image path
    image_path = "/home/student/BLINK_Dataset/Counting/val/images/val_Counting_60_image_1.jpg"

    # Create a tool instance
    detector = Object_Detector_Tool()

    # Execute the tool on the image
    (results, number_of_sandwiches) = detector.execute(image_path, labels=["Sandwich"], save_object=True, saved_image_path="detect_result")

    # Process the results
    sandwich_counts = {}
    total_sandwiches = 0

    # Iterate over the object group result
    for label, group in results['object_number'].items():
        # Count the number of sandwiches within the group
        count = 0
        for sandwich in group['boxes']:
            if label == "Sandwich":
                count += 1
                break  # Only count the first sandwich per group

        sandwich_counts[label] = count
        total_sandwiches += count

    # Calculate and return the count of sandwiches
    return total_sandwiches

# Call the function to count sandwiches
total_sandwiches = count_sandwiches()

print(f"The image contains a total of {total_sandwiches} sandwiches.")

