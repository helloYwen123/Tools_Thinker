Code: from object_detector import Object_Detector_Tool

# Load the model
tool = Object_Detector_Tool()

# Define the detection parameters
labels = "baseball, basket"
threshold = 0.45
model_size = "tiny"
save_object = False
saved_image_path = "detected_objects"

# Detect the objects
detected_objects, object_number = tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_94_image_1.jpg", labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Print the detected objects and their count
for detected_objects in detected_objects.values():
    label = detected_objects["label"]
    box = [detected_objects["bbox"][0], detected_objects["bbox"][1], detected_objects["bbox"][3], detected_objects["bbox"][2]]
    confidence_score = detected_objects["score"]
    if "baseball" in label:
        print(f"Detected {label} with bounding box: [{box[0]}, {box[1]}, {box[2]}, {box[3]}].")
    if "basket" in label:
        print(f"Detected {label} with bounding box: [{box[0]}, {box[1]}, {box[2]}, {box[3]}].")
    else:
        print(f"Detected unknown object {label}")
    print(f"Confidence score: {confidence_score:.2f}")

# Check if a white motorcycle is detected
threshold = 0.25
for label in ["baseball", "basket"] + ["other"] + ["motorcycle"]:
    if detected_objects[label]["score"] < threshold:
        print(f"Found unknown object {label}.")
        break

