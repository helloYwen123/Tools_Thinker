from object_detector import object_detector

# Step 1: Load the image and labels
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_42_image_1.jpg"  # Replace with the actual image path
labels = ["baseball", "basket"]  # Replace with actual labels

# Step 2: Detect objects using the object_detector tool
results = object_detector.image(image=image_path, labels=labels, threshold=0.45, model_size="tiny")
count_results = results[3]

# Step 3: Count the flower pots with flowers
flower_pots = [pots for label, pots in results[0].values() if label == "baseball" and any(c for c in label if c == "basketball")]
flower_pot_count = sum(1 for _ in flower_pots)

final_result = ("D", flower_pot_count, count_results)

