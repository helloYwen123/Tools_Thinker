from object_detector import Object_Detector_Tool

def count_people_in_water(image_file):
    # Load the image
    detector_tool = Object_Detector_Tool(image_file)
    detections = detector_tool.execute()

    # Count the number of people in the water
    num_people_in_water = detections["total_count_in_water"] or 0

    return num_people_in_water
