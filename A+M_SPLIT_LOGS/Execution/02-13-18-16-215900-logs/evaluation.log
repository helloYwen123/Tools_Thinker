Code: from object_detector import Object_Detector_Tool

def count_cows(image_path):
    object_detector_tool = Object_Detector_Tool()
    result = object_detector_tool.execute(image_path, labels=["cow"],
                                          save_object=False, saved_image_path="")
    result_obj = result["output_types"][0][1]
    cow_count = len(result_obj["boxes"])
    return cow_count

cow_count = count_cows('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_63_image_1.jpg')
final_result = 'None'
if cow_count:
    final_result = 'D'
else:
    final_result = 'A'

print(f"Number of cows on the train: {final_result}")

