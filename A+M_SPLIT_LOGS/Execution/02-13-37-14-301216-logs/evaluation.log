Code: from object_detector import Object_Detector_Tool

# Initialize the object detector
detector_tool = Object_Detector_Tool()

# Read the image
with open("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_65_image_1.jpg", "rb") as image_file:
    img_data = image_file.read()

# Detect the red letters in the image
labels = ["baseball", "basketball"]
result = detector_tool.execute(image=img_data, labels=labels, save_object=True, saved_image_path="detected_objects")

# Count the red letters
# Assuming 'baseball' and 'basketball' are the labels to count with a given threshold
category_count = detector_tool.output_types["output_types"][1]["category_count"]

# Assign the final result
final_result = category_count.get("baseball", 0) + category_count.get("basketball", 0)

