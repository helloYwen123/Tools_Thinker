Code: from object_detector import Object_Detector_Tool

# Initialize the object detector
object_detector = Object_Detector_Tool()

# Load the image
with open('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_105_image_1.jpg', 'rb') as image_file:
    image = image_file.read()
    labels = ["baseball", "basket"]
    threshold = 0.2
    model_size = "tiny"
    save_object = True
    saved_image_path = "detected_objects"

    detected_objects, object_number = object_detector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    if object_number == 3:
        final_result = "D"
    elif object_number == 2:
        final_result = "C"
    elif object_number == 1:
        final_result = "B"
    elif object_number == 0:
        final_result = "A"
    else:
        final_result = "E"

