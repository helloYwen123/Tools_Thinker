Code: from object_detector import Object_Detector_Tool

# Load image
with open("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_10_image_1.jpg", "rb") as image_file:
    image = image_file.read()

# Create object detector
obj_det = Object_Detector_Tool(image=image, labels=["clock"], threshold=0.50, model_size="tiny")

# Extract object number
obj_det.execute(save_object = True)

# Get object number
obj_number = obj_det["detected_objects"]["objects"]["objects"]["objects"]

# Count object number in each category
count = {obj["label"]: 0 for obj in obj_number}

for _obj in obj_number:
    count[_obj["label"]] += 1

# Select final result
final_result = max(count, key=count.get)

print(final_result)

