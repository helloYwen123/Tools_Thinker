Code: def object_detector(image):
    # Use the Object_Detector_Tool to detect objects in the image
    detector = Object_Detector_Tool()
    results = detector.execute(image=image)
    detections = results["object_detection_result"]
    
    # Use the Object_Detector_Tool to detect the presence of a tall building with a flat top
    building_detector = Object_Detector_Tool()
    building_results = building_detector.execute(detections=detections, labels=["tower"], save_object=True, model_size="base", save_object=True, saved_image_path="detected_objects")
    tower_labels = results["labels"]
    tower_detected = [label for label in tower_labels if label == "tower"]
    
    # Count the occurrences of the tower_labels in the image
    total_count = len(tower_detected)
    
    return total_count

