    object_result = Object_Detector_Tool.execute(image=image_path, labels=['baseball'], save_object=True, model_size=model_size)
    labels = object_result["output"].keys()

    # Count the label occurrence
    for label in labels:
        total_count = object_result["output"][label]["count"]
        if total_count > 0:
            output[label] = {"boxes": ([], 0), "confidence_scores": [(0, 0.0), (0, 0.0)]}

    return {"labels": labels, "output": output}
