Code: from object_detector import Object_Detector_Tool

# Function to count people wearing solid red shirts
def count_red_shirts(image_path):
    tool = Object_Detector_Tool(image_path)
    labels_to_check = ["solid red", "solid red"]
    labels = tool.labels_to_num_labels(labels_to_check).numpy()
    counts = tool.execute(labels, save_object=False)
    red_shirt_count = counts[1].groupby("label").sum()
    return red_shirt_count.iloc[0][0]

final_result = count_red_shirts("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Cool_Girls_with_book_2.jpg")
print(final_result)

