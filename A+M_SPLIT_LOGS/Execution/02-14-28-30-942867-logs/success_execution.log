def count_num_people(image_path, labels, threshold=0.45, model_size="tiny"):

    # Generate an object detection tool
    obj_detector_tool = Object_Detector_Tool(image_path=image_path,
                                            labels=labels,
                                             threshold=threshold,
                                             model_size=model_size,
                                             save_object=True, 
                                            saved_image_path="detected_objects")

    # Execute the tool
    detected_objects, object_number = obj_detector_tool.execute()

    # Print the detected objects
    for object in detected_objects:
        print(object['labels'], ":", str(object_number['baseball']) + " people, " + str(object_number['basket']) + " people")

    # Make a final decision based on the code output
    final_result = "C"
    return final_result
