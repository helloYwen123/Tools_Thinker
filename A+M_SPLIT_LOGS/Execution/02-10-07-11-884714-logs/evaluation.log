Code: import numpy as np
from object_detector import Object_Detector_Tool

# Load image (replace 'path_to_image' with the actual image path)
image = r'/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_67_image_1.jpg'

# Create object labels
labels = ["white_umbrella"]
threshold = 0.5

# Call the tool and get the results
detections, object_count = Object_Detector_Tool.execute(image=image, labels=labels, save_object=True, threshold=threshold)

# Print the results
print(f"Detections: {detections}")
final_result = max(detections, key=lambda x: len(x['boxes']))['name']
print(f"Object: {final_result}\nObject count: {object_count}")

