Code: from object_detector import Object_Detector_Tool

# Initialize the Object_Detector_Tool
o_tools = Object_Detector_Tool()

# Load the image using the method provided
def load_image(name):
    return name

# Function to detect and save detected objects
def detected_objects(image_path, labels, threshold, model_size, save_object):
    # Load the image
    o_tools.load_image(image_path)
    
    # Detect the objects
    results = o_tools.detect_object_with_labels(image_path, labels, threshold, model_size)

    # Check if the 'save_object' is True
    if save_object:
        # Save the detected objects
        return results[0]  # return box, score, saved image paths in the dictionary

# Call the detected_objects function with the path of your image
detected_objects_result = detected_objects("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_58_image_1.jpg", ["train"], 0.45, "tiny", True)

# Print out the result
final_result = detected_objects_result[0]
for label, result in detected_objects_result[1].items():
    print(f"{label}: {result}")

