Code: from object_detector import Object_Detector_Tool

# Load the tool
object_detector_tool = Object_Detector_Tool()

# Set the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_45_image_1.jpg"

# Set other parameters (e.g., labels, threshold, model size)
labels = ["baseball", "basket"]
threshold = 0.45
model_size = "tiny"
save_object = True

# Detect objects
detection_results = object_detector_tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

# Check the detected objects to see how many motors are driving near the bus
# The 'boxes' key contains the bounding box coordinates for each object
motor_count = sum([len(objects['boxes']) for objects in detection_results.values()])

motor_count

