Code: from object_detector import Object_Detector_Tool

# Load the image
object_detector_tool = Object_Detector_Tool()

# Load the image
object_detector_tool.load_image("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_100_image_1.jpg")

# Detect objects
detected_labels, object_number = object_detector_tool.execute()

# Get the confidence scores of detected objects
confidences = [detected_labels[label]['confidence_scores'] for label in detected_labels.keys()]

# Determine the maximum confidence score
max_confidence = max(confidences)

# Assuming we want to find the object with the highest confidence score
highest_confidence_object = max(detected_labels, key=lambda label: detected_labels[label]['confidence_scores'])

# Check for the white refrigerator (for simplicity, this is what we're looking for)
if highest_confidence_object == 'Refrigerator':
    kitchen_elements = {'kitchenaid stove': 1, 'Refrigerator': 1}
else:
    kitchen_elements = {}

final_result = max(kitchen_elements, key=kitchen_elements.get)  # The highest count in the kitchen_elements maps to the kitchen_elements and thus, the highest count in the image.

final_result

