tool_module_name = "object_detector"

# Function to execute the object detection tool
def execute_tool(tool_class, tool_module_name, image_path, labels, threshold=0.45, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
    # Create a new Tool instance
    tool = tool_class("path_to_tool_model_file", model_size=model_size, threshold=threshold)
    
    # Execute the object detection tool
    tool.execute(image=image_path, labels=labels)

    # Initialize counters for black toilets and total toilets
    black_count = 0
    total_count = 0
    
    # Analyze the detected objects in the image
    results = tool.execute(image=image_path, labels=["baseball", "basket", "toilet"], save_object=True, saved_image_path=saved_image_path)
    
    # Identify black toilets and their counts
    for label in results.get('object_number'):
        name = label.get('name')
        boxes = label.get('boxes')
        scores = label.get('confidence_scores')
        image_paths = label.get('saved_image_paths')
        
        # Count black toilets
        if name == "toilet":
            black_count += 1
            for i in range(len(image_paths)):
                if image_paths[i].endswith(".jpg"):
                    total_count += 1
                    continue
                else:
                    black_count += 1
                    total_count += 1
    
    # Output the result
    if black_count == 0:
        final_result = "D"  # Count (A)
    else:
        final_result = str(black_count)
    # Print the final result
    print(f"Final result: {(black_count)}")

