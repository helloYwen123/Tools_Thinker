Code: from toolobject_detector_tool import Object_Detector_Tool

# Function to check the number of bananas on the plate
def count_bananas(image_path):
    # Read the image file
    with open(image_path, 'rb') as f:
        image_data = f.read()

    # Detect objects using the object_detector tool
    detector = Object_Detector_Tool()
    results = detector.execute(image=image_data, labels=["banana"], model_size="base", save_object=True, saved_image_path="detected_objects")
    
    # Get the count of bananas in the image
    banana_count = results['object_number']['baseball']['boxes'].count('banana')[0]
    
    return banana_count

# Function to check the total number of croissants
def total_croissants(image_path):
    # Read the image file
    with open(image_path, 'rb') as f:
        image_data = f.read()

    # Detect objects using the object_detector tool
    detector = Object_Detector_Tool()
    results = detector.execute(image=image_data, labels=["croissant"], model_size="base", save_object=True, saved_image_path="detected_objects")
    
    # Get the total number of croissants in the image
    total_croissant_count = results['object_number']['croissant']['boxes'].count('croissant')[0]
    
    return total_croissant_count

# Check the number of bananas on the plate
bananas_count = count_bananas("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_23_image_1.jpg")

# Check the total number of croissants
total_croissants_count = total_croissants("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_23_image_1.jpg")

