Code: from object_detector import Object_Detector_Tool

# Load object detector tool
object_detector_tool = Object_Detector_Tool()

# Read the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_23_image_1.jpg'
detected_objects = object_detector_tool.execute(image=image_path, labels=['banana'], save_object=True, saved_image_path="detected_objects")

# Determine the number of bananas on the plate
num_bananas = 0
for i in range(len(detected_objects)):
    if detected_objects[i]["label"] == "banana":
        num_bananas += detected_objects[i]["count"]
print(f"Number of bananas on the plate: {num_bananas} bananas")
final_result = "A"

if num_bananas < 4:
    final_result = "C"
if num_bananas > 6:
    final_result = "D"
if num_bananas == 4:
    final_result = "B"
if num_bananas < 3:
    final_result = "E"
else:
    final_result = "A"

