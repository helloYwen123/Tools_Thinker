Code: from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_7_image_1.jpg"

# Create an Object_Detector_Tool object
tool = Object_Detector_Tool()
labels = ["baseball", "basket"]

# Initialize the detection result dictionary
detection_result = {'labels': {'boxes': {}, 'confidence_scores': {},
                                'saved_image_paths': {}}}

# Execute the detection
detected_objects, object_number = tool.execute(image=image_path, labels=labels, save_object=True)

# Function to convert confidence scores to percentages
def convert_to_percentage(scores):
    confidence_percentage = 100  # Start percentage at 100 by default
    scores = torch.tensor(scores)
    return (scores * 100 / scores.max()).tolist()

# Convert confidence scores to percentages
confidence_scores = convert_to_percentage(detected_objects["boxes"]["confidence_scores"]["scores"])

# Assign detected objects to the dictionary
detection_result = {k: {v: v_list[0] for v_list in detected_objects[k]["boxes"].values()} for k in object_number}

# Loop through the detected objects to retrieve and save images
for label in labels:
    if label in detected_objects:
        saved_image_paths = detected_objects[label]["boxes"].get("saved_image_paths", {})
        for image_path in saved_image_paths:
            detected_object = detected_objects[label]["boxes"]["saved_image_paths"][image_path]
            image_caption = f"Detected {label} at {detected_object} coordinates:"
            tool.save_object(image=image_path, caption=image_caption)

final_result = detection_result

