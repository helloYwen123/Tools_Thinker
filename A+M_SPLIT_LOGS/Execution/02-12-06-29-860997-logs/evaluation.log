Code: from object_detector import Object_Detector_Tool

def count_toilets_in_toilette_area():
    # Load the image
    detector_tool = Object_Detector_Tool()
    
    # Execute the ground detection and save the results
    detected_objects, object_number = detector_tool.execute(image="path/to/image.jpg", labels:["toilet"], save_object=False, saved_image_path="detected_objects")
    
    # Count the number of toilets
    toilet_count = sum(object_number.get(label, 0) for label in ["toilet"])
    
    return toilet_count

final_result = count_toilets_in_toilette_area()
