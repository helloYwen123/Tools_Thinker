saved_image_path = "detected_objects"

result = detector_tool.execute(image=image_path, labels=labels_to_find, save_object=save_object, threshold=threshold, model_size=model_size, saved_image_path=saved_image_path)
final_result = result["output_types"][0]["boxes"]
count_dict = result["output_types"][0]["labels"]


def calculate_green_tiles():
    green_tiles = 0
    for tile in final_result:
        if tile["classification"] == "Green Tile":
            green_tiles += 1
    return green_tiles
    
green_tiles = calculate_green_tiles()
print(f"Count of green tiles: {green_tiles}")

