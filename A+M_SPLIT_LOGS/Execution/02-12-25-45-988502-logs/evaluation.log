Code: import object_detector

def get_red_buses(image_path):
    """
    Detects red buses and returns their counts.
    """
    # Load the image
    image = object_detector.load_image(image_path)
    
    # Detect red buses
    red_buses = object_detector.detect_image(image, labels=list("baseball","basket"), save_object=True, model_size="tiny")
    
    # Count red buses
    red_bus_count = len(red_buses['baseball']['boxes'])
    
    return red_bus_count

# Path of the image with detected buses
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_21_image_1.jpg"
red_bus_count = get_red_buses(image_path)
filtered_results = {result['label']: result['number'] for label, results in red_bus_count.items() if 'baseball' in label and 'basket' in label}
