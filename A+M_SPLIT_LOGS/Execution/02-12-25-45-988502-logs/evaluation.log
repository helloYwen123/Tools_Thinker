Code: # Import the Object_Detector_Tool tool from its module
from object_detector import Object_Detector_Tool

# Provide the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Bus/Bus.png"

# Configure the detection parameters
labels = ["bas", "b"]

# Set the confidence threshold
confidence_threshold = 0.5

# Determine the optimal model size
max_model_size = "base"

predictions = Object_Detector_Tool.execute(image_path, labels, confidence_threshold=confidence_threshold, model_size=max_model_size)

# Loop through the results and count the red buses
red_bus_count = {
    "bas": 0
}

for prediction in predictions:

    # Check if it's a red bus
    if prediction["label"] == "bas":
        red_bus_count["bas"] += 1

# Determine the final result
final_result = "B" if red_bus_count["bas"] == 1 else "N"

print(f"Number of red buses: {final_result}")

