from object_detector import Object_Detector_Tool

def count_water_glasses(image_path, threshold=0.45):
    detected_labels = ["glass"]
    output_dict = {}
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=detected_labels, save_object=True, threshold=threshold)
    total_counts = output_dict["detected_object_labels"]

    for label in total_counts:
        count = total_counts[label]
        if "glass" in label:
            output_dict[label] = count

    if "water" in output_dict:
        count_water_glasses = output_dict["water"]
    else:
        count_water_glasses = 0

    for label in total_counts:
        if "glass" in label:
            output_dict[label]["boxes"][0][4] = count_water_glasses / (count_water_glasses + 1) * 100

    return output_dict
