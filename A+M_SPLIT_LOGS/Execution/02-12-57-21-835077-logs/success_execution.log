from object_detector import Object_Detector_Tool

def count_people_without_hats(image_path):
    object_detector = Object_Detector_Tool(image_path, labels=["hat", "bow Tie"], threshold=0.45)
    labels_count = object_detector.execute()
    for label, count in labels_count.items():
        if "bow Tie" not in label:
            if "hat" in label:
                count -= 1
    return count

