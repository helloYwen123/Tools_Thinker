# Make sure the image is open
if image_path:
    # Detect the objects in the image
    tool = Object_Detector_Tool()
    tool.execute(image=image_path, labels=["basin", "sink", "towel"], save_object=True, saved_image_path=None)

    # Check if the detected objects are 'basin', 'sink', 'towel'
    detected_objects = tool.output_types
    if "basin" in detected_objects:
        final_result += 1
    elif "sink" in detected_objects:
        final_result += 1
    elif "towel" in detected_objects:
        final_result += 1

    # Print the number of detected objects
    print(final_result)
else:
    print("Image is not open.")

# Final result
