Code: from object_detector import Object_Detector_Tool

def count_not_blue_hats(image_path):
    classifier = Object_Detector_Tool(model_size='tiny')
    results = classifier.execute(image_path=image_path)
    
    blue_hats = [(result['boxes'], result['confidence_scores']) for result in results if 'baseball' in result['labels']]
    not_blue_hats = [(result['boxes'], result['confidence_scores']) for result in blue_hats if result['labels'] != 'baseball']

    count = sum([1 for _, conf in not_blue_hats if conf != 0])
    return count

final_result = count_not_blue_hats("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_118_image_1.jpg")
print(final_result)

