object_labels = ["skier", "chair", "skis"]
scores_threshold = 0.7

# Detect objects
results = object_detector_tool.execute(image_path, labels=object_labels, save_object=True, threshold=scores_threshold, model_size="tiny")

# Find empty blue seats
empty_blue_seats = 0

for detector_results in results.values():
    for found_objects in detector_results["grouped_results"]:
        for box in found_objects["boxes"]:
            if box["found"] and box["label"] == "chair":
                empty_blue_seats += 1
                
# Final result
final_result = empty_blue_seats

