def detect_people_with_sides(caption):
    from collections import defaultdict
    people_result = defaultdict(int)
    
    person_label = "man"
    
    # Assuming there's only one person in the image
    for i in range(1, 2):  # Considering only the tennis player and the crowd
        if caption[i] == person_label:
            people_result[i] += 1
            
    # Return the total count
    return people_result[0]

