Code: from object_detector import Object_Detector_Tool

final_result = 0

def count_objects(image_path, labels, threshold=0.45, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
    detector = Object_Detector_Tool(image_path)
    labels_objects = detector.detect_labels(labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    object_count = {label: 0 for label in labels_objects}
    for detected_labels in labels_objects:
        for label in detected_labels['labels']:
            object_count[label] += detected_labels['count']
    return object_count

# Sample usage
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_59_image_1.jpg"
detected_labels = ["baseball", "basket"]
labels_labels = detected_labels
threshold = 0.45
model_size = 'tiny'
save_object = True
saved_image_path = "detected_objects"

final_result = count_objects(image_path, labels_labels, labels_labels, threshold, model_size, save_object, saved_image_path)
print("Number of people wearing white hats:", final_result)

