# Count the number of instances of each label
label_to_count = {}
category_count = {}
for obj in detected_objects:
    label = obj['bbox']['category'] # Assuming 'category' is a field in object data, it is an object instance's label in the dataset
    if label not in label_to_count:
        label_to_count[label] = 1
    elif label in label_to_count:
        label_to_count[label] += 1

for label in label_to_count:
    category_count[label] = label_to_count[label]

final_result = "B")

