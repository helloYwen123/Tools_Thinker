from object_detector import Object_Detector_Tool

# Load the image
tool = Object_Detector_Tool()
tool.execute(image="path/to/image.jpg", labels=["lamplight"], save_object=True, saved_image_path="lamplight_detections")
lamp_light_df = tool.output_types[0]

# Check if the lamplight is on
if "lamps" in lamp_light_df:
    num_lamplight = lamp_light_df["lamps"]["boxes"]["coordinates"][0]["bottom_right"][1]

    # Check if the lamplight is to the right of the television
    if num_lamplight >= 3 and num_lamplight <= 5:
        final_result = "B"
    elif num_lamplight >= 1 and num_lamplight <= 3:
        final_result = "C"
else:
    final_result = "Nothing detected for lamplight."

final_result
