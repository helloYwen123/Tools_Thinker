import object_detector

def find_skiers():
    with open('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_40_image_1.jpg', 'rb') as img:
        image_data = img.read()
        # Load image_data and labels into object_detector.detect_image() function
        labels = ["baseball", "basket"]
        detected_objects, object_number = object_detector.detect_image(image_data, image_labels=labels)
        # Retrieve detected objects
        detected_objects = detected_objects['results']
        # Filter detected objects for skiers
        skiers = [detected_object for detected_object in detected_objects if detected_object['label'] == 'skier']
        # Count skiers
        skiers_count = len(skiers)
        final_result = skiers_count
    return final_result
