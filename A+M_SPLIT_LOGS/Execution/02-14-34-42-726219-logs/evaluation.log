from object_detector import Object_Detector_Tool

# Create a blank dictionary to store the counts of words
word_counts = {}

# Get the image path as a string
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_108_image_1.jpg"

# Initialize the Object_Detector_Tool with appropriate arguments
tool = Object_Detector_Tool(image=image_path)

# Detect objects in the image and update the counts
word_counts = tool.execute(labels=["brick oven pizza", "shrimp", "Rafa", "the", "Boulevard", "shrimp", "The", "Boudelier", "the", "boulevard"], threshold=0.45)

# Retrieve only the number of words by keying the label and counting the total occurrences
final_result = word_counts[min(word_counts)]

