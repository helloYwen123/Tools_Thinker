Code: from object_detector import Object_Detector_Tool

def count_skiers(image_path, labels=["skier"], threshold=0.45, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    result = object_detector_tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    # Analyze the detected objects
    skier_boxes = result.get('object_number', {}).get('skier', [])
    number_of_skiers = len(skier_boxes) 

    if number_of_skiers == 1:
        return "B"
    elif number_of_skiers == 0:
        return "A"
    else:
        return f"{number_of_skiers}"

final_result = count_skiers("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_44_image_1.jpg")
print(final_result)

