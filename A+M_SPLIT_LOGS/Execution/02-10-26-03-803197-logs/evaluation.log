Code: from object_detector import Object_Detector_Tool

# Load the object detector model
model = Object_Detector_Tool()

# Define the path to the image file and the object labels
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_1_image_1.jpg'
objects_to_detect = ["baseball", "basket"]

# Initialize the object detection parameters
labels = objects_to_detect
threshold = 0.45
model_size = 'tiny'
save_detected_objects = True

# Detect objects in the image
detected_objects, object_number = model.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_detected_objects=save_detected_objects)

# Extract the detected objects and their counts from the output dictionary
label_to_object = detected_objects[0]
image_path_to_objects = detected_objects[1]
object_count_dict = label_to_object[0]['count'] 

# Count the number of blue floats in the image
if 'basket' in image_path_to_objects:
    blue_floats = detected_objects[2]
    blue_float_count = len([obj for obj in blue_floats["boxes"] if obj['color'] == 'Blue'])
    final_result = blue_float_count
else:
    final_result = 0

# Print the result
print(f"Number of blue floats: {final_result}")

