Code: from object_detector import Object_Detector_Tool

class Tool:
    def __init__(self, tool_module, object_detector_tool):
        self.tool_module = tool_module
        self.class_to_object_detector = self.tool_module.tools_object_detector
        self.tool_class_name = f"Object_Detector_Tool"
        self.tool_description = (
            "A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding."
        )
        self.tool_version = "1.0.0"
        self.input_types = {"image": "str - The path to the image file.", "labels": "list - A list of object labels to detect.", "threshold": "float - The confidence threshold for detection (default: 0.45).", "model_size": "str - The size of the model to use ('tiny' or 'base', default: 'tiny').", "save_object": "bool - Whether to save the detected objects as images (default: False).", "saved_image_path": "str - The path to save the detected object images (default: 'detected_objects')."}
        self.output_types = {
            "detected_objects": "tuple - A tuple containing two elements: (1) a dictionary mapping each detected label to its grouped detection results, where each value is a dictionary with keys 'boxes', 'confidence_scores', and 'saved_image_paths'; (2) a dictionary mapping each label to its total count in the image.",
            "object_number": "list - A list of object labels with the number of each label in the image.",
        }

    def extract_labels(self, image_path):
        object_detector_tool = self.class_to_object_detector(tool_module=self.tool_module, object_detector_tool=self.object_detector_tool, tool_class_name=self.tool_tool_class_name)
        detected_results = object_detector_tool.execute(image='path/to/image.png', labels=self.labels, save_object=True, saved_image_path='detected_objects')
        return detected_results, object_detector_tool.class_to_object_labels

