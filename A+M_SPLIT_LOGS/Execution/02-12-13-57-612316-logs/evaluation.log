Code: def find_baseball_players_image_path(file_path: str) -> Optional[dict]:
     """
     Detects and returns the path to a baseball player in the image.

     Parameters:
     file_path (str): The path to the image.

     Returns:
     Optional[dict]: A dictionary with the detected baseball player's bounding box and score. If multiple players or no player is detected, returns None.
     """
 
 fig, ax = plt.subplots()
 
 labels = ["baseball", "basket"]
 detection_results = Object_Detector_Tool.execute(image=file_path, labels=labels, save_object=True)
 
 detections = detection_results["detected_objects"]
 detected_labels = detection_results["output_types"][1]
 
 if any(detected_labels.keys()):
     detected_object = detected_labels[labels[0]]
     for (boxes, label, score, saved_image_path) in detections:
         if detected_object[0] == labels[0]:
             return {"label": labels[0], "bbox": boxes, "confidence_score": score, "image_path": saved_image_path}
 
 return None

