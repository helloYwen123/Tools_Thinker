from object_detector import Object_Detector_Tool

# Function to detect and count the number of objects of interest (e.g., baseball and basket)
def count_interesting_objects(image_path):
    # Initialize the object detection tool
    detector_tool = Object_Detector_Tool(
        image_path, 
        labels=["baseball", "basket"], 
        save_object=True
    )
    
    # Get the results
    detected_objects = detector_tool.execute()
    
    # Return the count of detected objects
    return detected_objects["object_number"]
