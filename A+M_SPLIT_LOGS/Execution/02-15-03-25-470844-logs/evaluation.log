Code: from object_detector import Object_Detector_Tool

# Initialize the object detector tool
tool = Object_Detector_Tool()

# Set the image path and detection labels
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_47_image_1.jpg"
labels = ["baseball"]

# Detect the objects
detect_result = tool.execute(image_path, labels=labels)
object_detection = detect_result[1]

# Analyze the total count
total_object_count = detect_result[0]

# Determine the result
final_result = f"{total_object_count} people are reading books."

# Calculate the probability of people reading books
probability = (total_object_count > 2) * 100 / total_object_count

# Print the result and the probability
print(final_result)
print(f"Probability: {probability:.2f}%")

