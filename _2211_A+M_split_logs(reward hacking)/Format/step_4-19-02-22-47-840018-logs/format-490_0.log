from object_detector import Object_Detector_Tool

tools = [
    {"tool_class_name": "Object_Detector_Tool", "command": "detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')", "user_metadata": {"languages": ["en"]}, "demo_command": "detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png')"}
]

if tools:
    detected_objects = tools[0]["detected_objects"]
    
    if detected_objects:
        text_blocks = []
        for obj in detected_objects:
            text_blocks.extend(obj["box"])
    
        for language_key, translations in tools[0]["user_metadata"].items():
            for translation in translations:
                for text in text_blocks:
                    if translation[0] == language_key and translation[1] == text:
                        score = translation[2]
                        break

        text_blocks = [t for t in text_blocks if t not in detected_objects]

        if text_blocks:
            print("Text found:")
            for text_block in text_blocks:
                print(f"({text_block[0]}, {{\"text\", {text_block[1]}}}) with a confidence score of {score}")
        else:
            print("No text found.")
    else:
        print("No detected objects.")
else:
    print("No text detected.")
