from object_detector import Object_Detector_Tool

# Define a function that takes a list of labels and an image path
def count_paintings(labels, image_path):
    # Use the Object Detector Tool to count paintings
    detected_objects = Object_Detector_Tool.execute(
        image=f"image_path.jpg",
        labels=labels,
        save_object=True,
        saved_image_path="detected_objects"
    )
    
    # Initialize a dictionary to store the detections
    painting_count_dict = {}
    
    # Loop through each detected painting
    for label in detected_objects["baseball"]:
        # Detect bounding boxes for each painting
        for box in label["boxes"]:
            if box[2] >= 100 and box[3] >= 100 and box[3] <= 200 and box[4] >= 100:
                painting_count_dict[label["name"]] = painting_count_dict.get(label["name"], 0) + 1
    
    # Return the total count of paintings
    return len(painting_count_dict)

final_result = count_paintings(['painting'], "/nfs/data8/liao/wxie/SAT/SAT_images_train/490_0.png")
print(final_result)  # Output: 1
```
