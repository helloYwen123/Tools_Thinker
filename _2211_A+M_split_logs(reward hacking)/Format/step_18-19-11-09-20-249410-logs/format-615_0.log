from tools.object_detector import Object_Detector_Tool

def visualize_objects(image, labels, languages=['en', 'de']):
    objects = []
    
    # Detect objects using EasyOCR
    for label in labels:
        result = Object_Detector_Tool.execute(image=image, languages=languages, detail=0)
        for det in result['detected_objects']:
            objects.append([[det['box'], det['recognized_text'], det['score']]])
    
    return objects

# Generate the final result with 2 armchairs as seen in the image
final_result = visualize_objects(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/615_0.png", labels=["baseball", "basket"], languages=["en", "de"])
print(final_result)
