import json

def count_entry_dirties(image_path, languages=['en', 'de']):
    # Open the image file and process the text
    image_label = json.loads(open(image_path, 'rb').read())
    image_details = open(image_path, 'rb').read()
    
    # Determine the language settings for the text detection tool
    language_results = text_detector(text=image_details, languages=languages)
    
    if not language_results:
        print("Text detection failed: ", language_results)
        exit()
    
    # Filter the text for the detected English words
    english_words = [word['detected_text'] for word in language_results if word['detected_text'].endswith('en')]
    
    # Return the list of english words
    return english_words

def doorcount():
    # Access the door image path from the input
    door_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/100_30.png"

    # Run text detection to obtain the detected text
    detected_text = text_detector(image=door_image_path, languages=['en', 'de'])
    
    if not detected_text:
        return 0

    entry_count = len(detected_text)
    
    return entry_count

final_result = [doorcount()]
