```python
from object_detector import execute as object_detector_tool
from text_detector import execute as text_detector_tool

def detect_objects(image_path, language_codes, detail=0):
    language_codes = [code for code in language_codes if code in ['en', 'de']]

    for language in language_codes:
        result = text_detector_tool.execute(image=image_path, languages=[language], detail=detail)
        if result:
            detected_objects = []
            detected_text_blocks = []
            for row, row_result in enumerate(result.iter_rows()):
                for result_object in row_result:
                    if result_object['bbox']:
                        objects_with_confidence = [result_object for result_object in result.iter_objects() if result_object['bbox']]
                        detected_objects.append(
                            [{'bbox': result_object['bbox'], 'text': result_object['label'], 'confidence': result_object['score']} for result_object in objects_with_confidence]
                        detected_text_blocks.append([{"bbox": result_object['bbox'], "text": result_object['label'], "confidence': result_object['score']} for result_object in objects_with_confidence])

            print(f"Detected objects: {[detected_objects]}")
            print(f"Detected text blocks: {detected_text_blocks}")

    return detected_objects, detected_text_blocks
