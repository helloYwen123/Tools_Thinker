from tool_module_name import Object_Detector_Tool
from tool_module_name import Text_Detector_Tool

final_result = []
output_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/3767_0.png'
label_list = ['baseball', 'basket', 'chair', 'dual_lamp']

# Detection
for label in label_list:
    result = Object_Detector_Tool.execute(image=output_path, labels=label, thresholds=[0.35, 0.85], model_size='tiny',
                                           save_object=True, saved_image_path="detected_objects")
    final_result.append({"label": label, "detected_objects": result})

# Counting
object_number = Object_Detector_Tool.object_number(label_list)
print(f"Detected labels: {final_result}")
print(f"Total objects detected: {object_number}")
