# Python program to demonstrate the usage of the object_detector tool
import object_detector

# Example image provided in the question
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5006_0.png"

# The tool settings include the labels ('baseball', 'basket', 'other'), threshold (0.35),  and save_object (True) are predefined.
# The labels and save_object parameters are not provided in this example, so they will default to 'baseball' and False respectively.
labels = ['baseball', 'basket']
save_object = False

# Set the model size to 'tiny' for finer details and object counting.
model_size = 'tiny'

# The save_object parameter is set to True, and the filename is added as a keyword parameter.
result = object_detector.object_detector.execute(image=image_path, labels=labels, threshold=0.35, save_object=True, saved_image_path='detected_objects')

if result:
    # Check if text is detected. In this case the text is detected as 'baseball'.
    text_results = result[1]
    for text_result in text_results:
        if text_result['text'] == 'baseball':
            detected_objects = text_result[1]
            object_number = text_result[0]

            print(f"The image contains {object_number} '{text_result[1]}' objects, including detected bounding boxes and confidence scores.")
else:
    print("Text detection failed.")

print(f"Total objects detected: {sum(text_results)}")
