from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

label_list = ["baseball", "basket"]
detect_label_in_image = True
saved_object_path = "detected_objects"

# Attempt to detect objects in the image
total_objects_count = 0
objects_count_per_label = {}

for label in label_list:
  detected_results = Object_Detector_Tool.execute(image="path_to_image.png", labels=[label], save_object=detect_label_in_image, saved_image_path="--".join([saved_object_path, f"detected_objects_{label}_"]) if label in objects_count_per_label else f"detected_objects_{label}_")

  if detected_results:
    detected_objects_count = len(detected_results)
    objects_count_per_label[label] = detected_objects_count

    # Extract bounding boxes in the first label detected
    x0, y0, x1, y1 = ([det[0][0] for det in detected_results]) if detected_results else (x0, y0, x1, y1) if any(detected_results) else None

    if x0 is not None and y0 is not None:
      object_detections = [
        [x0, y0, x1, y1],
        *[((x0, y0), (int(x2), int(y2))) if x2 < 0 else (x0, y0), (int(x2), int(y2))] for (x0, y0), (
          x1, y1
        ) in zip(x0, y0, x1, y1)]
      detections = object_detections if saved_object_path else object_detections if x0 is None else object_detections if y0 is None else [(x0, y0, x1, y1)]
   
      # Generate a final dictionary describing each detected label
      final_result = {
        f"detected_objects_{label}": detections.tolist(), 
        "object_number": detected_objects_count
      }
        
      print(final_result)
      total_objects_count += detected_objects_count

# Print total objects and count by label
print({
  "total_objects": total_objects_count,
  **objects_count_per_label
})
