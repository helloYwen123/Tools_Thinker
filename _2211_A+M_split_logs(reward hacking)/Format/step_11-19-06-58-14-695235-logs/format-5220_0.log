    object_data = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    if object_data["object_number"] > 0:
        detected_objects = {label: list(object_data[label]) for label in labels}
        object_number = object_data["object_number"]
        return detected_objects, object_number
    else:
        return {}, object_number

