<command>from_object_detector_tool import Object_Detector_Tool

def count_number_of_doors(image_path):
    try:
        object_detector_tool = Object_Detector_Tool(
            input_type={'image': image_path, 'labels': ['Doorway'], 'threshold': 0.35, 'model_size': 'tiny', 'save_object': True, 'saved_image_path': 'detected_objects'})
        
        detected_objects = object_detector_tool.execute()
        
        door_count = len([obj for obj in detected_objects if 'Doorway' in obj['label']]);
        door_count
    except Exception as e:
        return -1
    else:
        return door_count

# Example usage:
door_count = count_number_of_doors('/nfs/data8/liao/wxie/SAT/SAT_images_train/3248_0.png')
print(f"The number of doorways in the scene is: {door_count}")
