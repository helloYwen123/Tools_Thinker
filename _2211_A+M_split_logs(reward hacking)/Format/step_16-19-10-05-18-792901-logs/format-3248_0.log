import text_detector_tool

def translate_text_to_words(image_path, languages=['en', 'de']):
    try:
        text_detector_tool = text_detector_tool.Text_Detector_Tool(
            input_type={'image': image_path, 'languages': languages, 'detail': 1})
        detected_text_blocks = text_detector_tool.execute()
        
        for detected_text_block in detected_text_blocks:
            text_box = (detected_text_block[0][0], detected_text_block[0][1], detected_text_block[0][2], detected_text_block[0][3])
            text = detected_text_block[2]
            
            if languages[0] == 'en' and language_similarity(english_to_meeting_time(text), english_to_meeting_time('German_text')):
                print(f"Found text: {text}")
            else:
                print(f"Text translation in {languages[1]} failed.")
    except Exception as e:
        print(f"Error with text detection: {e}")
    else:
        return True
