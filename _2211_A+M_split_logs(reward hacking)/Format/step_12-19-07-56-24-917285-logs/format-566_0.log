from Object_Detector_Tool import Object_Detector_Tool

def count_garbage_blocks(image_path, show=False, save_to='./detected_objects'):
    tool = Object_Detector_Tool(
        image=image_path,
        labels=['garbage'],
        threshold=0.35,
        save_object=True,
        saved_image_path='detected_objects'
    )
    if not show:
        saved_objects_path = tool.execute()
    else:
        saved_objects_path = ''
    
    return saved_objects_path

def get_number_of_garbage_objects(image_path, languages=['en', 'de']):
    tool = Text_Detector_Tool(
        languages=languages,
        detail=1
    )

    languages = [0] + list(range(2, 255))  # Adding an empty label for the garbage
    detected_objects = tool.execute(image=image_path, languages=languages)

    return len(detected_objects), languages

