<command>from object_detector import Object_Detector_Tool, text_detector


def count_objects(image_path, labels, threshold, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    try:
        detected_objects = Object_Detector_Tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

        # Extracting number of objects for each label
        object_number = {label: detected_objects[label].count() for label in detected_objects}

        return detected_objects, object_number

    except Exception as e:
        print(f"Error occurred: {e}")
        return [], {}

