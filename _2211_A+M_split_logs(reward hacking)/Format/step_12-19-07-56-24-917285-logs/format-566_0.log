from object_detector import Object_Detector_Tool

# Initialize object detector
object_detector = Object_Detector_Tool()

# Image path
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/566_0.png'

# Check if Text_Detector_Tool is available
if 'text_detector' in tools:
    print("Text Detection is not available. Returning text-based answer.")
else:
    print("Text Detection is not available.")
else:
    print("Importing required tools from: object_detector")

    # Input list of languages
    languages = ['en', 'de']

    # Set the level of detail (0 for simpler output, 1 for detailed output)
    detail = 1

    # Detect the objects in the image
    result = object_detector.execute(image=image_path, languages=languages, detail=detail)

    if result:
        detected_objects = {}

        for label in result['detected_objects']:
            for detection in result['detected_objects'][label]:
                # Detect the bounding box, label, and confidence score of the object
                x1, y1, x2, y2 = detection['box'][0]
                label_ = detection['text'][0]
                confidence = detection['score']

                # Add the bounding box and confidence score to detected_objects
                if label not in detected_objects:
                    detected_objects[label] = []
                detected_objects[label].append({
                    'box': (x1, y1, x2, y2),
                    'score': confidence
                })

                # Check if the object should be saved
                if 'save_object' in result['detected_objects'][label]:
                    detected_items = {'box': detection['box'],
                                     'score': confidence,
                                     'saved_image_path': result['detected_objects'][label]['saved_image_path']}
                    object_detector.save_objects(detected_items, f'detected_objects')

        print(f"Number of detected objects: {len(detected_objects)}")

    else:
        print("Not enough attempts to reach the requested image")
