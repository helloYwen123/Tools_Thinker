from object_detector import Object_Detector_Tool

object_detector_tool = Object_Detector_Tool()

# Running the tool with a file path as argument
image_path = "/path/to/image.png"
labels = ["baseball", "basket"]
confidence_threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

result = object_detector_tool.execute(image=image_path, labels=labels, confidence_threshold=confidence_threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

print(f"Number of detected objects: {result['object_number']}")

# Extracting detected objects
detected_objects = []
for label, data in result['detected_objects'].items():
    detected_objects.append({"label": label, "bbox": data['bbox'], "score": data['score']})

print(f"Detected objects with their bounding box, score, and location:")
for item in detected_objects:
    print(item['label'], item['bbox'], item['score'], item['box'])

print(f"Number of detected objects: {len(detected_objects)}")
```
