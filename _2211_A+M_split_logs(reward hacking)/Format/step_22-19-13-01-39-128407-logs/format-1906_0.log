from object_detector import Object_Detector_Tool

final_result = {
    "fridges": 0
}

def detect_fridges(door_type):
    # Replace '/nfs/data8/liao/wxie/SAT/SAT_images_train/1906_0.png' with the actual path to the image
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1906_0.png"
    
    if door_type == "kitchen":
        # Use object_detector to detect fridges
        fridges_detected = Object_Detector_Tool.execute(image=image_path, labels=['fridges'], threshold=0.5, model_size="base", save_object=True, saved_image_path="detected Fridges")
    else:
        fridges_detected = False
        
    final_result["fridges"] += fridges_detected
    return fridges_detected

# Check the output
print(detect_fridges("kitchen"))
print(detect_fridges("hallway"))
print(detect_fridges("garage"))
