from object_detector import Object_Detector_Tool

def count_and_locate_objects(image, labels, save_object=True, saved_image_path="detected_objects"):
    result = Object_Detector_Tool.execute(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path).detected_objects

    if result:
        # Initialize a dictionary to count the number of detected objects for each label
        label_counts = {'count_0': 0, 'count_1': 0, 'count_2': 0, 'count_3': 0}

        # Count the number of objects for each label
        for label in labels:
            count = result.get(label, 0)
            label_counts[label] += count

        return label_counts
    else:
        return None

# Example usage
label_counts = count_and_locate_objects(image_path="path/to/image.png", labels=["baseball", "basket"])
final_result = {"label_counts": label_counts}
print(final_result)
