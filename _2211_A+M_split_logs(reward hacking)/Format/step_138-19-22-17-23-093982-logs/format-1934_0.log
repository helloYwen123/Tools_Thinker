<command>from object_detector import Object_Detector_Tool, Text_Detector_Tool

# Step 1: Execute the Object_Detector_Tool tool
final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Step 2: Extract the detection details and object number
if 'detected_objects' in final_result:
    detected_objects = final_result['detected_objects']
    object_number = {key: value[1] for key, value in detected_objects.items()}
    object_number_str = json.dumps(object_number)

    # Step 3: Execute the Text_Detector_Tool tool
    text_result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en', 'de'], detail=0)
    text_detected = text_result[0]

    final_result = {
        'final_result': final_result,
        'object_detection_text': text_detected,
        'object_number': object_number_str
    }

    final_result = json.dumps(final_result)

return final_result
