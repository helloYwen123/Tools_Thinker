from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold=0.35, model_size='tiny', save_object=False):
    detector_tool = Object_Detector_Tool()
    results = detector_tool.execute(image_path, labels=labels, threshold=threshold)
    if save_object:
        saved_image_path = 'detected_objects'
        for label, detection in results.items():
            detection_path = f"{saved_image_path}/{label.replace(' ', '_')}_{pathlib.Path('/'.join(pathlib.Path(image_path).parts)).name.split('_')[::-1]}_{timestamp.now()}.png"
            cropped_detection = results[label]['box'] | results[label]['score'] > threshold
            cropped_detection.save(detection_path)
    return results

def count_objects(image_path):
    detector_tool = Object_Detector_Tool()
    detect_result = detector_tool.execute(image=image_path, save_object=False)
    return {label: len(detect_result) for label, result in detect_result.items() if not isinstance(result, list) or result and result[0][0] and result[0][0] not in [None, '', []]}
