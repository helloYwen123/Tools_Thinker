from object_detector import Object_Detector_Tool
import_name: Object_Detector_Tool
final_result = Object_Detector_Tool.execute(image='/nfs/data8/liao/wxie/SAT/SAT_images_train/7276_0.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

print(final_result)

detected_objects = final_result['detected_objects']
object_number = final_result['object_number']

if not detected_objects:
    print('No objects detected')

print(f'Total detected objects: {len(detected_objects)}')

if detected_objects:
    for obj in detected_objects:
        print(f'Object: {obj[0]}, confidence score: {obj[4]}, label: {obj[1]}')
        
    text = ', '.join(obj[1] for obj in detected_objects)
    print(f'Text detected: {text}')

total_labels, count = detected_objects.items()
for label, count in total_labels:
    print(f'{label}: {count} detected objects')

if 'basket' in object_number:
    print(f'Total number of baskets: {object_number["basket"]}')
if 'baseball' in object_number:
    print(f'Total number of baseballs: {object_number["baseball"]}')

