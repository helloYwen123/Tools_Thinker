from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path_to_image', labels=['chair', 'couch'], save_object=True, saved_image_path='detected_objects')

print("Detected objects:", final_result)

total_objects = {
  "chair": 0,
  "couch": 0,
  "desk": 0,
  "table": 0,
  "shelf": 0,
  "bookcase": 0,
}

for _, obj_dict in final_result:
  if 'chair' in obj_dict['label']:
    total_objects['chair'] += 1
  if 'couch' in obj_dict['label']:
    total_objects['couch'] += 1
  if 'desk' in obj_dict['label']:
    total_objects['desk'] += 1
  if 'table' in obj_dict['label']:
    total_objects['table'] += 1
  if 'shelf' in obj_dict['label']:
    total_objects['shelf'] += 1
  if 'bookcase' in obj_dict['label']:
    total_objects['bookcase'] += 1

print("Total number of detected objects: ", total_objects)
