```python
from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3721_0.png"

# Labels to detect
labels = ["baseball", "basket"]

# Confidence threshold (default: 0.35)
threshold = 0.35

# Model size: tiny or base (default: "tiny")
model_size = "tiny"

# Save detected objects to a file if specified (default: False)
save_object = False

# Path to save the detected object images (default: "detected_objects")
saved_image_path = "detected_objects"

# Call the tool
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Generate the final result
final_result = f"""The number of detected objects is {object_number.get('basket', '0')} and {object_number.get('baseball', '0')}.
Detected objects include:
1. Basketball with coordinates (x0, y0), (x1, y1), (x2, y2), (x3, y3) and confidence score: {detected_objects[0]['score']}.  
   
2. Baseball with coordinates (x0, y0), (x1, y1), (x2, y2), (x3, y3) and confidence score: {detected_objects[1]['score']}. 
"""

print(final_result)
