from object_detector import Object_Detector_Tool
object_detector_tool = Object_Detector_Tool()

# 读取图像
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12809_0.png"

# 设置对象检测参数
labels = [ "baseball", "basket" ]
saved_object = True
threshold = 0.35
model_size = "tiny"

results = object_detector_tool.execute(image=image_path, labels=labels, threshold=threshold, save_object=saved_object, model_size=model_size)

# 输出检测结果
print(f"Total number of detected objects: {len(results[0])}")

# 输出每个对象检测结果
for i, result in enumerate(results[0]):
    print(f"Label: {result[0]}, Score: {result[1]}, Box: ({result[2]}, {result[3]}, ({result[4]}, {result[5]}), Confidence: {result[1]}")

# 保存每个检测结果
if saved_object:
    for label, (x0, y0, x1, y1) in results[0]:
        filename = f"detected_objects/{label}.png"
        if saved_object:
            image = image_path
        else:
            image = result[2]
        object_detector_tool.save_object(image, result, filename)
        print(f"Image saved to {filename}")
