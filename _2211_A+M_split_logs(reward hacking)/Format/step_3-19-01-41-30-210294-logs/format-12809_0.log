from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool
# Get the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12809_0.png"

result_obj = Object_Detector_Tool.execute(image=image_path)
detected_objects = result_obj['detected_objects']
object_number = result_obj['object_number']

detected_blocks = []
for detected_objects_item in detected_objects:
    text_blocks = Text_Detector_Tool.execute(image_path, detected_objects_item["labels"][0])
    for text_block in text_blocks:
        detected_blocks.append(text_block)

# Check if the text was detected
if detected_blocks:
    print("Detected blocks found:")
    for item in detected_blocks:
        print(f"[-] {item[2]}, {detected_objects_item['labels'][0]}")
else:
    print("No text blocks found.")
    print("Text detection failed after retries.")

# Print the object number for reference
for key in object_number:
    print(key, ":", object_number[key])
