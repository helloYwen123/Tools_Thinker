from object_detector import Object_Detector_Tool

class Room:
    def __init__(self, image_path, labels=["CounterTops"], save_object=True):
        self.labels = labels
        self.save_object = save_object
        self.image = image_path

    def detect_counter_tops(self):
        labels = self.labels
        
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=self.save_object)
        counter_tops = [det['baseball'] for det in detected_objects['baseball']]
        total_counter_tops = len(counter_tops)
        
        return counter_tops, total_counter_tops

class RoomImages:
    def __init__(self, image_path):
        self.image_path = image_path

    def get_counter_tops_for_image(self):
        det_counter_tops_images = [Detected_counter_tops(i.image_path)
                                   for i in self.items]
        return det_counter_tops_images

# Example usage
