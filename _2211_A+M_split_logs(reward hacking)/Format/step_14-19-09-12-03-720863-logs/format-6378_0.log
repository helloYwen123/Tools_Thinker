from object_detector import Object_Detector_Tool

def count_counter_tops():
    tool_instance = Object_Detector_Tool()
    counter_tops = tool_instance.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/6378_0.png", labels=["counter_top"])
    top_counts = {item['bbox'][0]: len(item['bbox']) for item in counter_tops}
    return top_counts

# Calculate the number of counter tops visible in the scene
visible_counter_tops = count_counter_tops()  # Example output
