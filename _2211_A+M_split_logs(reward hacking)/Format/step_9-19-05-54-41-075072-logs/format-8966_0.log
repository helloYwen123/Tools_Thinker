from object_detector import Object_Detector_Tool

def count_dining_tables(input_image):
    detected_objects = []
    object_number = {}

    for label in ['DiningTable']:
        result = Object_Detector_Tool.execute(image=input_image, labels=[label], save_object=True, saved_image_path='detected_objects')

        if result:
            if isinstance(result[0], int):
                if result[0] == 0:
                    return []
                else:
                    return [result[0]]
            detected_objects.extend(result[1])

            object_number[label] = len(result[1])

    return detected_objects, object_number

final_result = count_dining_tables('/nfs/data8/liao/wxie/SAT/SAT_images_train/8966_0.png')
