import image_object_detector as object_detector
import text_detector as text_detector

# Sample image path
sample_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8966_0.png"

# Detect text in image, using language English and German
result = object_detector.execute(image=sample_image_path, languages=["en", "de"], detail=1)
text_blocks = result[0]

# Check if text is detected
if text_blocks:
    detected_blocks = []
    for block in text_blocks:
        detected_blocks.extend(
            text_detector.execute(image=sample_image_path, languages=["de"], detail=0).get()["detected_text"]
        )
    detected_blocks = [block for block in detected_blocks if "." in block]
    print(detected_blocks)

# Print results
if text_blocks:
    for block in text_blocks:
        print(block)
else:
    print("No detected text.")
```

This Python program uses the `object_detector` and `text_detector` tools to count and locate texts in an image. It runs the image under analysis, extracts the detected texts in both English and German languages, and checks if any texts are detected. The program then prints the detected texts for validation.

Remember to run this program with the actual path to your image.
