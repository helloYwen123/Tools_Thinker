<command>:python
def count_dining_tables(image_path, save_object=True, languages=['en', 'de']):
    """
    Counts the number of dining tables in an image.
    
    :param image_path: String - The path of the image file to be analyzed, in JPEG format.
    :param save_object: Boolean - Whether to save the detected objects as images. Defaults to True.
    :param languages: List of strings - The language codes for the OCR model, including English and German.
    
    :return: Tuple - A tuple containing two elements:
              (1) a dictionary mapping each detected label to a list of detection entries,
              (2) a dictionary mapping each label to the total number of objects found in the image.
              If the text detection fails after retries, returns an empty list and an empty dictionary.
    """
    if image_path[-4:] != '.jpg':
        image_path += '.jpg'
    
    detector_tool = Text_Detector_Tool()
    
    result = detector_tool.execute(image_path, languages=languages, detail=1)
    
    if result == []:
        return {}, {}
    
    # Extract detection data
    dining_tables = []
    for block in result:
        if block[0][2] == "table":
            for x0, y0, x1, y1 in block[0]:
                if 'table' in block[1]:
                    dining_tables.append((x0, y0, x1, y1))
    
    # Extract label count
    label_count = {}
    for block in result:
        if block[0][2] == "table":
            for x0, y0, x1, y1 in block[0]:
                if 'table' in block[1]:
                    label_count[block[0][2]] += 1
    
    # Save detected objects
    if save_object:
        saved_image_path = f"detected_objects/{image_path}")
        for i in dining_tables:
            if not i[0][2] in ["baseball", "basket"]:
                with open(saved_image_path, 'a') as saved_image:
                    saved_image.write(f"{i[0][0]}{i[0][1]}{i[0][2]}{i[0][3]}\n")
        
    return {'dining_tables': dining_tables, 'total_tables': len(label_count)}, label_count

# Example usage
image_path = './8966_0.png
