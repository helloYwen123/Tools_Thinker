from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def detect_windows(image_path, languages, details=False):
    """Detect windows in an image file."""
    # Check if all languages are specified
    languages = set(languages) - set(['all'])

    if languages:
        raise ValueError("All languages must be specified for detection.")

    img = Image.open(image_path)

    # Process image using Object_Detector_Tool
    det_out = Object_Detector_Tool.execute(img=image, languages=languages, details=details)

    windows = []
    for label, score, detections in det_out:
        if label == 'window':
            windows.append({
                'box': detections[::2],
                'score': score,
                'label': label
            })
    return windows

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/10357_0.png"

windows = detect_windows(image_path=image_path, languages=['all'], details=True)
for window in windows:
    print(window)
