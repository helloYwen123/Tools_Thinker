from Object_Detector_Tool import *  # Import necessary tool to detect objects

def find_windows(source_image_path):
    window_labels = ['window']  # List of possible window labels

    image = load_image(filename=source_image_path)

    for label in window_labels:
        result = get_objects(image, tool_name="Object_Detector_Tool", labels=[label], save_object=True, saved_image_path="detected_objects")

    for detection_entry in result['detected_objects']:
        if detection_entry['saved_image_path'] == 'detected_objects/window.png':
            return label

window_result = find_windows('/nfs/data8/liao/wxie/SAT/SAT_images_train/10357_0.png')

final_result = {'window': None}
if window_result is not None:
    final_result['window'] = window_result['detected_objects'][0]['box']

print(final_result)
