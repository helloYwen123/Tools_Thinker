def recognize_objects(image_path):
    try:
        # Load and display the image to be detected
        image = cv2.imread(image_path)
        
        # Detect objects using the text_detector tool
        result = Text_Detector_Tool.execute(image, languages=['en', 'de'])
        
        # Check if text detection was successful
        if result:
            # Convert the detected text to a list
            detected_texts = [d for d in result if d[2] > 0.5]
            
            # Calculate the number of detected words
            num_detected_words = len(detected_texts)
            
            # Print the detection results
            print(f"Detected objects and their counts:")
            for detected_text in detected_texts:
                box = detected_text[1][1]
                print("[", end=" ")
                for coord in box:
                    print(str(coord[0]) + "," + str(coord[1]) + "], ", end="")
                print("]")
                print(f"Detected text: '{detected_text[0]}' - Score: {detected_text[2]:.2f}")
        
            print(f"Total detections: {num_detected_words}")
            
            return result
        else:
            print("Text detection was unsuccessful with retries.")
    except Exception as e:
        print(f"Error: {e}")
       
    return 0

# Test the function with the provided image
if __name__ == "__main__":
    image_path = "/home/user/13729_0.png"
    result = recognize_objects(image_path)
    
    # Assuming you want to save the detected objects as images
    if result != 0:
        image_path = "detected_objects"
        cv2.imwrite(image_path + ".jpg", result[0])
        
        # Optionally, calculate the number of detection entities and print it out
        num_objects = len(result[0])
        print("Number of detection entities:", num_objects)
