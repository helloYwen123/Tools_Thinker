import torch
from object_detector import Object_Detector_Tool, Text_Detector_Tool

# Load the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8498_0.png"

# Load the input labels as a list of objects to find
labels_to_detect = ["baseball", "basket"]

# Create the Object_Detector_Tool instance
object_detector_tool = Object_Detector_Tool()

# Call the function to detect objects with the specified labels
object_results = object_detector_tool.execute(image_path, labels=labels_to_detect)

# Check if the object detection was successful
if not object_results:
  print("Object detection failed.")
else:
  # Extract the objects detection results and their corresponding text blocks if available
  extracted_results = []
  for det_label in object_results:
    box = det_label["box"]
    text_blocks = []
    for tblk in det_label["tblocks"]:
      tblk_info = tblk[0][1]
      text = tblk_info["c"]
      text_blocks.append({"bbox": tblk_info["bbox"], "text": text, "confidence_score": det_label["score"]})
    extracted_results.append([box, text_blocks])

  final_result = {
    "counted_labels": {
      *labels_to_detect: extracted_results
    }
  }

  print(final_result)
