def get_dressers_in_scene():
    # Load the scene and retrieve the dresser coordinates
    path_to_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11184_0.png"
    detector_tool = Object_Detector_Tool(tool_module_name="object_detector", tool_class_name="Object_Detector_Tool", tool_description="Detects objects in an image using the Grounding DINO model and saves individual object images with empty padding.", tool_version="1.0.0", input_types={
      "image": path_to_image, "labels": [], "threshold": 0.35, "model_size": "tiny", "save_object": True, "saved_image_path": "detected_objects"}, export_types={
      "detected_objects", "image_number": {}, "object_number": {}})
    labeled_detection = detector_tool.execute()

    # Access the dresser coordinates from the bounding boxes
    dresser_coordinates = []
    for det_dict in labeled_detection["detected_objects"]:
        dresser_coordinates.append({
            "label": "Dresser",
            "bbox": [int(det_dict["bbox"][0]), int(det_dict["bbox"][1]), int(det_dict["bbox"][2]), int(det_dict["bbox"][3])],
        })

    return dresser_coordinates

