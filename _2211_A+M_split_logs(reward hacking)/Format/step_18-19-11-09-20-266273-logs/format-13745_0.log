<command>
from object_detector import Object_Detector_Tool

# Function to detect objects in the image and save detected objects
def detect_objects_and_save_objects(image_path, labels, save_object=False, saved_image_path="detected_objects"):    
    # Create object detection model using Grounding DINO
    object_detector = Object_Detector_Tool()

    # Detect objects for a list of labels
    detected_objects, object_number = object_detector.execute(image_path=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    # Print the detected objects and object number
    final_result = f"Detected objects: {detected_objects}, Object number: {object_number}"

    return final_result
</command>
Reward: 0.5

