from object_detector import Object_Detector_Tool
# Load pre-trained model from the provided tool metadata.json file
# Uncomment and modify 'tool_version', 'input_types', 'output_types', 'tool_description', and 'user_metadata' as necessary
tool_version = "1.0.0"
tool_input_types = {"image": "str", "labels": "list", "threshold": "float", "model_size": "str", "save_object": "bool", "saved_image_path": "str"}
tool_output_types = {"tuple": "detected_objects : {\n{'baseball': [{'box': (34, 50, 200, y2), 'score': 0.92, 'saved_image_path': 'detected_objects/image_baseball_1.png'}], \n'basket': [{'box': (220, 100, 400, 350), 'score': 0.85, 'saved_image_path': 'detected_objects/image_basket_1.png'}]}\nobject_number : {'baseball': 1, 'basket': 2}\n\n}"}
tool_user_metadata = {
  "frequently_used_language": "English",
  "potential_usage": "The tool can be used for identifying different objects in images, including their bounding boxes, confidence scores, and details."
}

# Use the object_detector tool from the available tools tool_metadata.json file
tool = Object_Detector_Tool()
# Instantiate the tool with the provided metadata and input/output options.
tool = tool(
    **tool_input_types,
    **tool_user_metadata,
    tool_version=tool_version,
).execute(
    image="path/to/image.png",
    labels=["baseball", "basket"],
    save_object=True,
    saved_image_path="detected_objects",
    threshold=0.35,
    model_size="tiny",
)

# Get the detected objects as a dictionary of labels and detection results.
detected_objects = tool["detected_objects"]

# Get the object number for each detected label.
object_number = tool_output_types["object_number"]

print(detected_objects)
print(object_number)
