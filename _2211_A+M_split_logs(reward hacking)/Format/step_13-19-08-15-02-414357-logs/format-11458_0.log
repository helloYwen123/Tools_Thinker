from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Step 1: Detect objects (baseball and basketball)
detected_objects = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basketball'], save_object=True, saved_image_path='detected_objects')

# Step 2: Text detection
result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en', 'de'], detail=0)
text_blocks = result[0]

# Step 3: Combine object and text detection
final_result = {}
object_count = {}
for label in detected_objects[0]:
    if label in object_count:
        object_count[label] += 1
    else:
        object_count[label] = 1
    text_blocks = [block for block in text_blocks if block[0][0] == label]

# Step 4: Determine text blocks from objects
for label, blocks in object_count.items():
    text_blocks = [block for block in blocks if block[3].startswith(label)]

final_result['object_count'] = object_count
final_result['text_blocks'] = text_blocks

final_result
