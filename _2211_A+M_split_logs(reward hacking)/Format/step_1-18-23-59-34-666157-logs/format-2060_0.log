from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Define the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2060_0.png"

# Define the labels to determine
labels = ["baseball", "basket"]

# Set the image threshold to 0.35 and save the Detection results
obj_results, obj_count = Object_Detector_Tool.execute(image=image_path,
                                                        labels=labels,
                                                        save_object=True)

# Set the language to the first one detected
# Set the level of detail to 0 for simplicity
result = Text_Detector_Tool.execute(image=image_path,
                                     languages=["en", "de"],
                                     detail=0)

# Convert the detection to a dictionary
detected_obj_dict = {'baseball': {'box': [x[0] for x in obj_results[0]['box']], 'score': obj_results[0]['score'], 'saved_image_path': obj_results[0]['saved_image_path']}}

# Check if there are objects detected
if detected_obj_dict:
    print("Total detected objects:", obj_count)
    print(f"Objects: {detected_obj_dict}")
else:
    print("No objects detected.")

final_result = f"Total detected objects:", obj_count
print(final_result)
