from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/551_0.png"

# Labels to detect
labels_to_detect = ["baseball", "basket"]

# Default threshold and model size
threshold = 0.35
model_size = "tiny"

# Save object images as separate files
save_object = False
saved_image_path = "detected_objects"

# Check whether the image contains text
has_text = True
if has_text:
    # Detect text in the image
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels_to_detect, save_object=save_object, saved_image_path=saved_image_path)

    # Extract the text detected in the image
    detected_text = [block["text"] for block in detected_objects if "text" in block and block["text"]]

    # Calculate the total count of detected objects in the image
    object_count = sum([len(block["box"]) for block in detected_objects])

    # Construct the final answer
    final_answer = {
        "objects_not_detected": [],
        "objects_detected": [],
        "object_count": [],
        "text_detected": detected_text,
        "total_detected_objects": []
    }

    # Calculate the number of text detected objects
    if "baseball" in detected_text and "basket" in detected_text:
        object_count = len(detected_text)
    elif "baseball" in detected_text or "basket" in detected_text:
        object_count = 1
    else:
        object_count = 0

    # Add the objects detected in the image
    if save_object:
        for block in detected_objects:
            if "text" in block and block["text"] in object_count:
                final_answer["objects_detected"].append(block)
    final_answer["total_detected_objects"].append({"objects_not_detected": object_count, "objects_detected": detected_objects, "object_count": object_count})

    # Calculate and return the final result
    final_result = {
        "error": False,
        "answer": final_answer
    }
else:
    final_result = {
        "error": True,
        "answer": None
    }

final_result
