from object_detector import Object_Detector_Tool

def analyze_image(commands, file_path=None):
    object_number = {}
    output = []
    
    if 'labels' in commands and 'save_object' not in commands:
        labels = commands.get('labels')
        save_object = commands.get('save_object')

        detector_tool = Object_Detector_Tool()
        try:
            detected_objects = detector_tool.execute(
                file_path=file_path,
                labels=labels,
                save_object=save_object
            )
        except Exception as e:
            print(f"Error occurred: {e}")
            return "Error:", str(e)

        output.append(detected_objects)

    if 'object_number' in commands:
        output.append(commands.get('object_number'))

    return output

def count_and_locate_objects(commands, detection_path='.'):
    language_codes = ['zh', 'de']
    if not detection_path:
        detection_path = 'detected_objects'

    object_detection_result = analyze_image(commands, file_path=detection_path)
    object_number = {"baseball": 1, "basket": 2}

    results = []
    for i in range(len(object_detection_result)):
        result = object_detection_result[i]
        if (result[3] == 1):
            results.append(('baseball', result[1]))
        if (result[3] == 2):
            results.append(('basket', result[1]))

    return results

# Command to execute the analysis
commands = {
    "command": "detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')"
}

with Object_Detector_Tool() as detector_tool:
