```python
import object_detector

def count_objects_in_image(image_path):
    try:
        results = object_detector.execute(image_path, labels=['baseball', 'basket', 'couch'], save_object=False)
        detected_objects = results['detected_objects']
        object_number = results['object_number']
        return detected_objects, object_number
    except Exception as e:
        print(f"Error: {e}")
        return None, None

def count_couch(image_path):
    detected_objects, _ = count_objects_in_image(image_path)
    if detected_objects:
        for detected_object in detected_objects:
            if detected_object['label'] == 'couch':
                # If a couch is detected, count it
                return detected_object['num_objects']
    return 0

results = count_couch("/nfs/data8/liao/wxie/SAT/SAT_images_train/6918_0.png")
if results:
    print(f"Couch count in {results['image_path']} is {results['num_objects']}")
else:
    print("Could not detect a couch in the given image.")
```

Note: This code is a demonstration tool and uses the example given to test the functionality of detecting objects. In production, it's recommended to preprocess the image data before feeding it to the tool for accurate results.
