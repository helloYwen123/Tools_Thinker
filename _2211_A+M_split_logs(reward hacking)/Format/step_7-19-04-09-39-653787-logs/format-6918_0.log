from object_detector import Object_Detector_Tool

# Check if there are any detected objects in the scene. This command is being run inside the object_detector tool.
detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['bed'], save_object=True, saved_image_path='detected_objects')

# Print the detected objects and their number
if detected_objects:
    print(f"Detected objects in the scene: {detected_objects}")
    print(f"Number of detected bed beds: {object_number}")
else:
    print("No detected objects present.")

# Check if there are any bed-like objects in the scene
if not detected_objects:
    print(f"Bed NOT present in the scene (detected_objects: {detected_objects}")
else:
    print(f"Bed(s) NOT present in the scene (detected_objects: {detected_objects}")

# If bed-like objects are detected, the following script may be helpful
if not detected_objects:
    print("No bed-like objects detected.")
else:
    print("Bed-like objects detected!") 
