from object_detector import Object_Detector_Tool

def count_beds():
    img_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6918_0.png"
    labels = ['bed']  # Add more labels if needed
    threshold = 0.35  # High threshold to optimize time
    model_size = 'tiny'

    try:
        detector = Object_Detector_Tool()
        detected_objects = detector.execute(image=img_path, labels=labels, threshold=threshold, model_size=model_size)
        num_objects = len(detected_objects)

        bed_detected = []
        for bed in detected_objects:
            if bed['label'] == 'bed':  # Filter detected 'bed' objects
                bed_detected.append(bed)

            bed_confidence = bed.get('confidence', 0)  # Optionally get confidence score from detected bed object

        final_result = {
            'total_beds': {
                'count': num_objects,
                'labels': detected_objects
            },
            'detected_beds': bed_detected
        }

        if final_result['total_beds']['count'] > 0:
            print(f"Total beds detected: {final_result['total_beds']['count']}")

        if final_result['total_beds']['count'] > 0:
            print("Detected beds in the room\n")
            for bed in detected_objects:
                print(f"Beds: {'-'.join([f'label: {bed['label']},' ' if 'label' in bed else '')}. Confidence: {bed['confidence']:.2f}")

    except Exception as e:
        print(f"Error executing detection: {e}")

    return final_result

if __name__ == '__main__':
    count_beds()
