    print("All labels not present in the detected objects.")
else:
    print(f"Detected objects:")
    if not detections[0]['object_number']:
        print("Number not provided")
    else:
        print(f"{len(labels)} '{'' if len(detections[0]['object_number']) == 1 else ''}label{'s'} ")
        for label, number in object_numbers.items():
            print(f"{label} {number}")
    print(f"Object detection threshold: {detections[0]['threshold']}")
