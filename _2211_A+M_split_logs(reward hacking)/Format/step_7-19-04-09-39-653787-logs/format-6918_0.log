from object_detector import Object_Detector_Tool

def count_beds_in_room():
    """
    Counts the number of beds in the image.

    Returns:
    int: Number of beds in the room.
    """
    tool_parameters = {
        "labels": ["bed", "bed_frame"],
        "threshold": 0.35,
        "model_size": "tiny",
        "saved_image_path": "count_beds"
    }
    
    detected_beds = []
    for bed in tool_parameters.get("labels"):
        try:
            boxes = Object_Detector_Tool.execute(image="room.png", label=bed, **tool_parameters).get("detected_objects")[0]
        except Exception as e:
            print(e)
            continue
    
        if boxes:
            detected_beds.append(box_to_dict(boxes))
    
    return len(detected_beds)

def box_to_dict(box, threshold=0.35):
    x1, y1, x2, y2 = box
    if x1 > box_count.get(boxes[boxes.index(boxes[0])][0][0], 0):
        boxes.remove(boxes[boxes.index(boxes[0])][0])
    box_count[boxes[0][0][0]] = len(boxes)
    return {
        "box": (round(x1), round(y1), round(x2), round(y2)),
        "score": box_count[boxes[0][0][0]],
        "saved_image_path": f"count_beds/image_{box_count[boxes[0][0][0]-1]}.png"
    }

beds = count_beds_in_room()
print(beds)
