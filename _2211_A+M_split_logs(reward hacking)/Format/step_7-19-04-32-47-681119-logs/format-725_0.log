def count_tops(image_path, save_result=True, save_to="/detected_objects", languages=[['en'], ['de']]):
    try:
        # Load the image and apply the algorithm to detect the object
        detection_results = Object_Detector_Tool.execute(image=image_path, languages=languages, save_object=True, saved_image_path="detected_objects")
        
        if len(detection_results["detected_objects"]) > 0:
            # Analyze the detected objects to count the counter top
            counter_tops = 0
            # Get the bounding box coordinates of the counter top
            for result in detection_results["detected_objects"]:
                if "baseball" in result["boxes"] or "basket" in result["boxes"]:
                    counter_tops += 1
            
            # Count each detected counter top within that room number
            counts_dict = {}
            for i, bbox in enumerate(detection_results["detected_objects"]):
                if "baseball" in result["boxes"]:
                    count_label = 1
                elif "basket" in result["boxes"]:
                    count_label = 2
                else:
                    count_label = None
                
                if count_label in counts_dict:
                    counts_dict[count_label] += 1
                else:
                    counts_dict[count_label] = 1
            
                    # Display the output to the user
            print(f"Number of counter tops found: {len(counts_dict)} in this room")
