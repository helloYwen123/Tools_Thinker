from enum import Enum

class Text_Detection_Type(Enum):
    DEFAULT = "DEFAULT"
    DETAILED = "DETAILED"

class Text_Detector_Tool:

    def execute(self, image_path: str, languages: list, detail: int) -> "list":
        """
        Detects text in an image using easyOCR.
        
        Args:
            image_path (str): The path to the image file.
            languages (list): A list of language codes for the OCR model.
            detail (int): The level of detail in the output. Set to 0 for simpler output, 1 for detailed output.
        
        Returns:
            list: A list of detected text blocks. Each block contains the bounding box coordinates, the recognized text, and the confidence score (float). e.g. [[[[x0, y0], [x1, y1], [x2, y2], [x3, y3]], "Detected text", score], ...].
            If text detection fails after retries, returns an empty list.
        
        """
        # Detect text in the specified image
        detected_text = []
        for language in languages:
            result = self.text_detector(image=image_path, languages=[language], detail=max(0, detail))
            detected_text.append(result)

        return detected_text

