<command>
from Object_Detector_Tool import Object_Detector_Tool

def count_safes(image_path):
    # Load the image
    image = load_image(image_path)

    # Detect objects
    labels = ["baseball"]
    detector_tool = Object_Detector_Tool()
    detections = detector_tool.execute(image=image, labels=labels)

    # Count detections
    num_balls = 0
    for det in detections:
        if "baseball" in det["labels"]:
            num_balls += 1

    return num_balls

# Define the path to image using the input
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4250_0.png"

# Count the number of safes
num_safes = count_safes(image_path)

final_result = {
    "num_safes": num_safes
}

print(final_result)
</command>
