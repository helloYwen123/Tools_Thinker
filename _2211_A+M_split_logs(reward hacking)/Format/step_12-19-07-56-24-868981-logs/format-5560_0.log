<command>import object_detector as OD
import text_detector as TD

# Path of the image
image_path = /nfs/data8/liao/wxie/SAT/SAT_images_train/5560_0.png

# Language codes
languages = ['en', 'de']

# Detail level
detail_level = 0

# Execute the text detection code
result = TD.execute(image=image_path, languages=languages, detail_level=detail_level)

# Check if the detection was successful
if len(result) != 0:
  # Print detected text
  for block in result:
    if block[1].find('basket') != -1:
      print(f"Detected text: {block[1]}, Confidence: {block[2]}")
else:
  print("Text detection failed.")

# Execute the object detection code
detected_objects = OD.execute(image_path, language_codes=languages, threshold=0.35)

# Print detected objects
if len(detected_objects) != 0:
  # Print object number
  detected_object_count = {detected_item[0]: detected_item[1] for detected_item in detected_objects}
  
  print(f"Number of objects: {len(detected_object_count)}")
else:
  print("Object detection failed.")
</command>
