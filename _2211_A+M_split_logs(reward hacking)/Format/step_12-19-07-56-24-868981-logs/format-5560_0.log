<command>import object_detector_tool as OD
final_result = {
    "labels": {},
    "count": {}
}
text_details = OD.execute(image="path/to/image.png", languages=["en"], detail=1)
if text_details:
    for detection in [det for detection in text_details if detection[2]]:
        final_result["labels"][detection[1]] = {
            "count": len(detection[0]),
            "images": [f"detected_object_{detection[1]}.png" for _ in range(len(detection[0]))]
        }
else:
    final_result["labels"] = []
final_result["count"]["total"] = len(final_result["labels"])
final_result["count"] = sorted(final_result["count"].items(), key=lambda x: x[1]["count"], reverse=True)
</command>
