<command>
from object_detector import Object_Detector_Tool

# Define the image path and options
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5560_0.png'
label_options = ["baseball", "basket"]

# Configure the object_detector with the specified options
object_detector = Object_Detector_Tool(image_path, labels=label_options, save_object=True)
object_detector.execute()
result = object_detector.detected_objects
detected_objects_dict = {};
for obj in result[0]:
  detected_objects_dict[obj[1]['saved_image_path']] = obj[1]['score']
# Find the number of detected objects
number_of_objects = sum(result[0].values())
print(f"Total number of distinct objects detected: {number_of_objects}")
</command>
