import numpy as np
from object_detector.object_detector import Object_Detector_Tool
from text_detector.text_detector import Text_Detector_Tool

def estimate_fridges(image_path):
    object_detector = Object_Detector_Tool()
    text_detector = Text_Detector_Tool()

    with open(image_path, 'r') as image_file:
        try:
            # Load image and predict
            image = np.array(image_file.read())
            object_labels = object_detector.predict(image=image)

            # Predict text (if needed)
            text_labels = text_detector.predict(image)
            
            # Combine results and count objects
            results = []
            for obj in object_labels:
                detections = object_detector.execute(image=image, labels=[obj['name']])
                if 'box' in detections:
                    results.append([{'box': d['box'], 'score': d['score'], 'label': d['name'], 'saved_image_path': f'detected_objects/{obj["name"]}_{d["bbox_idx"]}.png' if obj['bbox_idx'] < len(detections['bbox']) else None} for d in detections['bbox']]
            results = object_labels + results
            total_objects = len(results)
            text_objects = []

            for text_result in text_labels:
                box = ['[x0, y0]', '[x1, y1]', '0.0', '0.0']
                box = ' '.join(box).replace('(', '').replace(')', '').replace(',', '').replace('[', '').replace(']', '').replace('0.0', '').split()
                box.append(float(box[-1]))
                text_objects.append({'bounding_box': box[:4], 'text': text_result, 'score': text_result})

            total_objects += len(text_objects)

            return {'results': results, 'total_objects': total_objects, 'fridges_found': object_labels, 'fridges_count': total_objects - 4 if text_detector.demo_mode else total_objects}
        except Exception as e:
            print(f"Error: {e}")
            return {'results': [], 'total_objects': 0, 'fridges_found': None, 'fridges_count': None}

    print("No fridge found.")
    return {'results': [], 'total_objects': 0, 'fridges_found': None, 'fridges_count': None}
