import import_name

class ImageDetector:
    def __init__(self, image_path):
        self.image_path = image_path
        self.objects = None
        self.num_rotations = 0

    def execute(self, labels, languages, detail=0):
        for i, language in enumerate(languages):
            for label in labels:
                if label in self.objects:
                    continue
                response = self.object_detector.get_objects(self.image_path, label, language, detail)
                self.objects[label] = response['detected']
                self.objects[label].append({'box': response['box'], 'score': response['score'], 'detected_image_path': response['detected_image_path']})

    def object_detector(self, **kwargs):
        return Object_Detector_Tool.execute(**kwargs)

    def count_objects(self, language):
