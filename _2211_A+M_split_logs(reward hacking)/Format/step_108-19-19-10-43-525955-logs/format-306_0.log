# Sample image path provided in question
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/306_0.png"

# Example usage of Object_Detector_Tool to count and locate objects in the image
from object_detector import Object_Detector_Tool

# Detecting objects in the image
final_result = Object_Detector_Tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

print(final_result)

# Display the result
if final_result:
    detected_objects = final_result[0]
    print("Detected objects in the image:")
    if detected_objects:
        for label, results in detected_objects.items():
            for result in results:
                print("------------------------------------")
                print(f"Label: {label}")
                print(f"Score: {result['score']}")
                print("------------------------------------")
            print(f"Total number of objects: {result['object_number']}")
            print("------------------------------------")
        print("Detected object images are saved in the 'detected_objects' directory.")
    else:
        print("No objects detected in the image.")
else:
    print("Could not detect objects in the provided image.")
