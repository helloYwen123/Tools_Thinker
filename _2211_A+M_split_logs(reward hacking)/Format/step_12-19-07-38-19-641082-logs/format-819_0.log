from Object_Detector_Tool import Object_Detector_Tool as ObjectDetector

final_result = {
  "number_of_dining_tables": 1
}

def count_dining_tables( detected_objects, object_number, detected_tables):
  dining_tables = 0
  for i, object in enumerate(detected_objects):
    table_detected = any(label['label'] == 'table' for label in object['labels'])
    bounding_box = object['bboxes'][0]
    dining_table_detected = table_detected and bounding_box['top'] > 100 and bounding_box['left'] > 100

    if dining_table_detected:
      dining_tables += (object_number[i] != 0)

  final_result['number_of_dining_tables'] = dining_tables

  return final_result

# Import the necessary modules
ObjectDetector()
