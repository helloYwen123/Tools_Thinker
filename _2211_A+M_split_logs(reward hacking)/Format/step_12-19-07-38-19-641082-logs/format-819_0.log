from object_detector import Object_Detector_Tool

def count_objects(images_path):
    with open(images_path, 'r') as image_file:
        # Load image using OpenCV
        image = cv2.imread(image_file.name)

        # Convert image to grayscale
        gray_image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

        # Perform image analysis using object_detector_tool
        results = Object_Detector_Tool.execute(image=image, labels=[\'baseball\', \'basket\'], save_object=True)

        # Get number of objects in image
        object_count = len(results[\'object_number\'])

        return [results, object_count]
