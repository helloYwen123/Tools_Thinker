# Import the necessary tool
from object_detector import Object_Detector_Tool

# Set the path to the image file
path_to_image = /nfs/data8/liao/wxie/SAT/SAT_images_train/1492_0.png

# Specify the confidence threshold for detection and save the detected objects as images
object_detector = Object_Detector_Tool()
save_object = True
saved_image_path = 'detected_objects'

# Call the tool with the image file, language code for OCR, and the detail level
result = object_detector.execute(image=path_to_image, languages=['en', 'de'], detail=1)

# Extract the text blocks from the result and calculate their numbers
text_blocks = result['obj_result']['detected_objects']
total_text_blocks = len(text_blocks)
total_objects_num = 0
for block in text_blocks:
    if block['score'] > 0.35:  # Confidence threshold
        total_objects_num += 1

# Convert the objects to a string and determine the number of objects
objects_info = []
total_objects = 0
for item in text_blocks:
    for block in item['detected_objects']:
        if block['score'] > 0.35:
            objects_info.append((block['bbox'], block['caption'], block['score']))
            total_objects_num += 1
            total_objects += 1

# Combine the information about the detected labels
total_result_info = [("total_objects", total_objects), ("detected_labels", objects_info)]
final_result = {f"{key}": value for key, value in total_result_info}

print("Final result:", final_result)
finally:
    # Print the total number of objects found
    print("Total number of objects:", total_objects_num)
    if "detected_objects" in saved_image_path:
        # Save the detected objects to images
        print("Detected objects have been saved")
