from text_detector import Text_Detector_Tool

def count_paintings(image_path, languages=['en', 'de'], detail=0):

    result = Text_Detector_Tool.execute(
        image=image_path,
        languages=languages,
        detail=detail
    )

    painting_count = 0
    for text_block in result:
        text = text_block[2]
        if "painting" in text:
            painting_count += 1

    return {'painting_count': painting_count}

