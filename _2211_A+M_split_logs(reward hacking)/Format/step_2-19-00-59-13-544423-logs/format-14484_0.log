from Text_Detector_Tool import Text_Detector_Tool

# Use a random dataset to mimic the scene we are detecting in
dataset_path = "/path/to/dataset"

im = "/path/to/image.png"

# Demo
languages = ['en', 'de']
result = Text_Detector_Tool.execute(image=im, languages=languages, detail=0)

# Iterate over the text block results
text_blocks = []
for block in result:
    text_blocks.append([block[0]], block[1], block[2])

# Extract the required text
required_text = None
if 'text' in result[0]:
    required_text = result[0]['text'][0]
else:
    required_text = "No text detected."

# Output the results
print(f"Detected texts:\n{required_text}{'.'*(len(required_text)-1)}")

# For visualizing the text block
print(f"Detected texts block coordinates:\n{f'{', ' '.join(map(str, i[0]))}%' * len(text_blocks)}')
for i in text_blocks:
    print(f"{' '.join(map(str, i[0]))} {''.join(map(str, i[1]))} {'.'.join(map(str, i[2]))}")

