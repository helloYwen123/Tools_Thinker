<command>from object_detector import Object_Detector_Tool

# Get the image path and language codes
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5020_0.png"
languages = ["en", "de"]

# Call the object_detector tool
result = Object_Detector_Tool.execute(image=image_path, languages=languages)

# Extract the text Detection results
text_results = []
for label, detections in result["predicted_labels"].items():
    for det in detections:
        if det["score"] >= 0.45:
            text_results.append([[[det["bbox"][0], det["bbox"][1]], [det["bbox"][2], det["bbox"][3]], [det["bbox"][4], det["bbox"][5]], [det["bbox"][6], det["bbox"][7]]], det["box"], det["score"])

# Calculate the number of detected objects
object_number = {}
text_results = sorted(text_results, key=lambda x: len(x[0]))
for obj in text_results:
    if obj[0] in object_number:
        object_number[obj[0]] += 1
    else:
        object_number[obj[0]] = 1

# Print the results
if len(text_results) > 0:
    print("Detected objects:")
    for obj in text_results:
        print("\n".join([f"[{x[0]}] - detected text: {x[1]}, confidence: {x[2]}"])
        print(f"Saving to detections.json")
        with open("/nfs/data8/liao/wxie/SAT/SAT_images_train/5020_0_detections.json", "a") as file:
            file.write(f"{' '.join(x[3])}\n")
else:
    print("No text detected.")
    object_number = [{"label": "Non-detection", "count": 0}]

