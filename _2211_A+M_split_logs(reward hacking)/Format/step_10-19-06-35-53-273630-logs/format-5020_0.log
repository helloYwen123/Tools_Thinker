from object_detector import Object_Detector_Tool

def count_pillows():
    # Retrieve the image from the provided path
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5020_0.png"

    # Execute the object_detector tool with the specified path
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, save_object=True, languages=['en', 'es', 'fr'])

    # Check if text detection failed any time
    failed = False
    for label, detections in detected_objects.items():
        failed = not all(d['saved_image_path'] or d.get('box') for d in detections)

    if not failed:
        return len(detected_objects['baseball']) + len(detected_objects['basket'])

    return "Failed to count pillows because text detection failed."

# The program will run and then return the response within the final_result variable

final_result = count_pillows()
print("Number of pillows:", final_result)
