    if result['score'] > 0.5:
        detection_dict[result['label']].append({'box': result['box'], 'x': result['bbox'], 'y': result['bbox'], 'z': result['bbox']})

final_result = {"object_number": {}, "total_obj": 0}
for label, detected_obj in detection_dict.items():
    if len(detected_obj) == 1:
        final_result["total_obj"] += 1
        final_result["object_number"][label] = len(detected_obj)

# Add detection results to detection_dict
