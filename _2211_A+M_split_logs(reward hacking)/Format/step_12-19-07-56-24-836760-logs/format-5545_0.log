from object_detector import Object_Detector_Tool

def count_objects(image_path, labels, save_object, saved_image_path):
    try:
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path= saved_image_path)
        detected_objects_list = []
        object_count = {}
        for label, detection in detected_objects['detected_objects']:
            if label in labels:
                detected_objects_list.append(detection)
                if label not in object_count:
                    object_count[label] = 1
                else:
                    object_count[label] += 1
        detected_objects_list.sort(key=lambda x: x['score'])
        return {"detected_objects": detected_objects_list, "object_count": object_count}
    except Exception as e:
        print(f"Error while counting objects: {str(e)}")
        return None

final_result = count_objects('/nfs/data8/liao/wxie/SAT/SAT_images_train/5545_0.png', ['baseball', 'basket', 'table'], save_object=True, saved_image_path='detected_objects')
final_result
