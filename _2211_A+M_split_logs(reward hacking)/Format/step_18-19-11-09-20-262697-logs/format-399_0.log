<command>import open3d as o3d

def count_dining_tables(image_path, languages=['en', 'de'], detail=0):
    o3d_image = o3d.io.read_image(image_path)
    
    try:
        result = []
        for lang in languages:
            o3d_model, labels = o3d_model.predict_ocr(o3d_image, lang, detail=detail)
            for label in labels:
                if label['label'] == 'Dining Table':
                    box = (label['bbox'][0], label['bbox'][1], label['bbox'][2], label['bbox'][3])
                    confidence = label['score']
                    result.append([box, label['label'], confidence])

        # count the number of dining tables
        dining_tables = sum(1 for _, label, _ in result)
        return {"total": dining_tables}, {"dining_tables": dining_tables}

    except Exception as e:
        # if something goes wrong with the text detection, return an empty list
        return {}, {"dining_tables": 0}
</command>
