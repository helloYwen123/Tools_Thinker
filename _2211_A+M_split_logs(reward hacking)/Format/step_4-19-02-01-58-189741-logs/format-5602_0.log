```python
from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold=0.35, model_size="tiny"):
    """
    Detects objects in the image.
    
    :param image_path: str - The path to the image file.
    :param labels: list - A list of object labels to detect.
    :param threshold: float - The confidence threshold for detection (default: 0.35).
    :param model_size: str - The size of the model to use ('tiny' or 'base', default: 'tiny').
    :param save_object: bool - Whether to save the detected objects as images (default: False).
    :param saved_image_path: str - The path to save the detected object images (default: 'detected_objects').
    :return: A tuple containing two elements: (1) a dictionary mapping each detected label to a list of detection entries, e.g. {'baseball': [{'box': (x1, y1, x2, y2), 'score': 0.95, 'saved_image_path': 'path/to/saved/image.png'}]}, (2) a dictionary mapping each label to the number of detected objects in the image.
    """
    
    try:
        detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path=saved_image_path)
        return detected_objects, object_number
    except Exception as e:
        return [], []

