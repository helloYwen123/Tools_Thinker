from object_detector import Object_Detector_Tool

def count_objects(detected_objects):
    object_labels = [obj['label'] for obj in detected_objects]
    object_count = len(object_labels)
    return object_count

final_result = Object_Detector_Tool.execute(image='<path_to_image>', labels=['Baseball', 'Basket'], save_object=True, saved_image_path='detected_objects')
