from Object_Detector_Tool import Object_Detector_Tool

label_list = ["baseball", "basket"]
object_number = {}

# Load the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12470_0.png"
image = Image.open(image_path)
object_detector = Object_Detector_Tool()
result = object_detector.detect(image, labels=label_list, save_object=True)

if result:
    # Extract bounding boxes and labels
    bounding_boxes = [((bbox[0], bbox[1]), (bbox[2], bbox[3]), (bbox[4], bbox[5]),) for bbox in result
                      if label in result.keys()]
    detected_labels = {item['label'] for item in bounding_boxes}

    # Calculate total count
    total_objects = set(result.keys()).pop()

    # Save detections
    for det in result:
        object_object = {
            "box": det["box"],
            "score": float(result[det].get("score", 0.0)),
            "saved_image_path": f"detected_objects/{det['label']}.png"
        }
        object_number[det] = total_objects
        bounding_box_list.append([det['box'], det['label'], det['score']])
# else:
