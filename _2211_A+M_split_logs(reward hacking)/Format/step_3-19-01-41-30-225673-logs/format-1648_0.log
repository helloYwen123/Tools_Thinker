import object_detector

def count_paintings(image_path):
    """
    Counts the total number of paintings in the image.
    """
    result = object_detector.execute(image_path, languages=['en'])
    painting_count = 0
    for box, detection in result:
        if "Art" in detection["text"]:
            painting_count += 1
    return painting_count

