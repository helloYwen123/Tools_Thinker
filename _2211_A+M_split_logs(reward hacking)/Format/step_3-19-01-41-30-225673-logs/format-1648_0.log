import object_detector

# Path of the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1648_0.png"

# Detection of objects (e.g., basketballs and baseballs)
result = object_detector.Object_Detector_Tool.execute(image=image_path, labels=["basketball", "baseball"], save_object=True, saved_image_path="detected_objects")

# Additional text detection using EasyOCR
result_text = object_detector.Text_Detector_Tool.execute(image=image_path, languages=["en", "de"], detail=0)

# Extracting detected text blocks from the text detection result
detected_blocks = [block for line in result_text for [bbox, txt, txt_details] in line if bool(txt) and bool(txt_details)]

# Combining multiple detection results for better analysis
all_results = result + [result_text]

# Total count for each detected language
all_results_count = {key: len(value) for (key, value) in dict.fromkeys(all_results).items()}

final_result = {"detected_objects": detected_blocks, "object_number": all_results_count}
print(final_result)
