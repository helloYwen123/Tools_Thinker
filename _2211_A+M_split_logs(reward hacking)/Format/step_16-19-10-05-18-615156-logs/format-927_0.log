from Object_Detector_Tool import Object_Detector_Tool

# Image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/927_0.png"

# Detection parameters
labels = ['baseball', 'basket']
threshold = 0.5
model_size = 'tiny'
save_object = True

# Start object detection
detected_objects, object_number = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

# Save detected objects as images
if save_object:
    if not saved_image_path:
        return {'detected_objects': {}, 'object_number': object_number}
    path_to_save = saved_image_path
else:
    import os
    if not os.path.exists('detected_objects'):
        os.makedirs('detected_objects')
    path_to_save = 'detected_objects/image_{name}.png'.format(name=os.path.basename(image_path))

    # Save each detected object
    for label, (box, score, saved_image_path) in detected_objects.items():
        if saved_image_path:
            img = LabelDetection.to_image(box=box, score=score)
            img.save(saved_image_path)
        else:
            img = LabelDetection.to_image(box=box)
            img.save(path_to_save)

return {**detected_objects, **object_number}
