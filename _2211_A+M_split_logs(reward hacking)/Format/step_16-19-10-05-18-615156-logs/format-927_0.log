from object_detector import Object_Detector_Tool

def count_dressers(image_path=None, labels=None, threshold=0.35, model_size=None, save_object=True):
    if image_path is None or not os.path.isfile(image_path):
        raise ValueError("Image path is required for text detection.")

    result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object).get("detected_objects", [])
    object_count = {label: (len(result) if not isinstance(result, list) else count) for label, result in result.items()}

    return object_count

final_result = count_dressers(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/927_0.png")
final_result
