<command>
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_doors():
    # Execute the object detection tool with the labels 'door' and use it to find doors
    result = Object_Detector_Tool.execute(image='path_to_door_image.png', labels=['door'], save_object=True)
    doors_count = 0
    for x, y, x2, y2 in result[1][0]['bbox']:
        if 'door' in [box['label'] for box in result[1]]:
            doors_count += 1
    
    return doors_count

def count_windows():
    # Execute the text detection tool with the language code 'fr' and use it to find windows
    result = Text_Detector_Tool.execute(image='path_to_window_image.png', languages=['fr'], detail=1)
    windows_count = 0
    for box in result:
        for lang in box['langs']:
            if 'Windows' in lang['text']:
                windows_count += 1
    
    return windows_count

def count_total_doors_and_windows():
    total = count_doors()
    windows = count_windows()
    total_doors_and_windows = total + windows
    return total_doors_and_windows

final_result = {"doors": count_doors(), "windows": count_windows(), "total": count_total_doors_and_windows()}
print(final_result)
</command>
