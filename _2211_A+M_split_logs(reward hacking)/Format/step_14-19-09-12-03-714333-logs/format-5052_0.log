from tool_object_detector_tool import Object_Detector_Tool  # import the object_detector tool

def count_dectect_objects_and_languages(image, languages, detail):
    # Call the object detector tool with the image and languages
    result = Object_Detector_Tool.execute(
        image=image, languages=languages, detail=detail, model_size="tiny"
    )

    # Extract text coordinates and confidence scores
    text_coordinates = []
    for detected_objects in result:
        for obj in detected_objects['objects']:
            text_coordinates.append(obj['bounding_box'])

    # Count the number of detected objects
    object_count = len(detected_objects['object_count'])

    # Extract text from the object bounding boxes if language detection is enabled
    text_blocks = []
    for obj in text_coordinates:
        if obj:
            obj_text = "Detected text"
            obj_score = detected_objects['object_count']
        else:
            obj_text = obj
            obj_score = detected_objects['object_count']

        text_blocks.append ([[obj['x0'], obj['y0'], obj['x1'], obj['y1']], obj_text, obj_score])

    return text_blocks, object_count
