from object_detector.object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold, model_name, save_object=True, saved_image_path="detected_objects"):
    try:
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
        object_number = len(labels)  # Assuming all objects are detected
    except Exception as e:
        print(f"Error occurred: {e}")
        return

    object_number_output = {}
    for key, value in detected_objects.items():
        object_number_output[key] = len(value)

    return detected_objects, object_number_output
