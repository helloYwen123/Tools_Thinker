from object_detector import Object_Detector_Tool

def count_dining_tables(detected_objects):
    total_objects = len(detected_objects)
    diningtables = 0

    for obj in detected_objects:
        # Assuming 'diningtables' is the label of dining tables
        if obj.get_label() == 'diningtables':
            diningtables += obj.get_score()

    return diningtables

