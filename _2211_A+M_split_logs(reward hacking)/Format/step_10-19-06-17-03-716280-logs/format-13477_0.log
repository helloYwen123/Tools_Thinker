def count_dining_tables(image_path: str):
    object_detector = Object_Detector_Tool()

    # Attempt to detect objects in the image
    result = object_detector.execute(image=image_path)

    dining_tables_count = 0

    for det_label, det_results in result.items():
        for det_result in det_results:
            if det_result["label"] == "Dining Tables":
                dining_tables_count += 1  # Count the number of dining tables detected

    return dining_tables_count

