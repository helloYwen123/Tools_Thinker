from object_detector import Object_Detector_Tool

def count_dining_tables(image_path, save_object=False, saved_image_name='detected_objects', lang='en', detail=1):
    return Count_Dining_Tables.execute(image_path, lang=lang, detail=detail)

def generate_dining_table_images(objects, language='en', detail=1):
    dining_table_objects = []

    for object in objects:
        name = object['label']
        box = object['box']
        score = object['score']

        dining_table_index = find_dining_table_index(name, objects)

        if len(dining_table_objects) < 2:
            dining_table_objects = [{}]
        else:
            if dining_table_objects[tuple(dining_table_index).index(0)]['score'] < score:
                dining_table_objects[tuple(dining_table_index).index(0)]['box'] = box
                dining_table_objects[tuple(dining_table_index).index(0)]['score'] = score

        if len(dining_table_objects) == 2:
            dining_table_objects = [{}]

        if dining_table_objects[tuple(dining_table_index).index(0)]['score'] > 0.5:
            dining_table_index = tuple(dining_table_index)
        else:
            dining_table_index = 0

        if save_object:
            img = Object_Detector_Tool.execute(image_path, label=name, labels=[1], threshold=0.35, saved_image_path=saved_image_name)[[1]]
            Object_Detector_Tool.save_image(img['path'], save_object=save_object, saved_image_path=saved_image_name)

        if dining_table_index == len(dining_table_objects) - 1:
            dining_table_index = 0

        if dining_table_index != 0:
            dining_table_objects[dining_table_index]['box'].append(box)

    return dining_table_objects

