def count_doors(image_path):
    """
    Counts the total number of doors in the given image path using the object_detection tool.
    :param image_path: The path to the image file.
    :return: The total number of doors detected in the image.
    """
    from object_detector import Object_Detector_Tool

    detector = Object_Detector_Tool(image=image_path, labels=['door'])
    detected_objects = detector.execute()

    object_counts = {}
    for label in detected_objects['baseball']:
        if label['image_path']:
            object_counts[label['image_path']] = label['count']

    doors_detected = 0
    for image_path, count in object_counts.items():
        if 'door' in image_path and Image.open(image_path).size[1] < count:
            doors_detected = count

    return doors_detected

final_result = count_doors('/nfs/data8/liao/wxie/SAT/SAT_images_train/4820_0.png')
print(f"Total doors detected: {final_result}")
</command>
