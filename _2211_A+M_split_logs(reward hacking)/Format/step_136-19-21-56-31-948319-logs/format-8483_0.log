<command>from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Define the question
question = "How many ShelvingUnits are visible in the scene?"

# Retrieve the path of the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8483_0.png"

# Run the object detector
final_result = Object_Detector_Tool.execute(image=image_path, labels=["ShelvingUnit"], threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects")

if final_result:
    ShelvingUnits = final_result["detected_objects"]
    number_of_shelving_units = len(ShelvingUnits)

    # Retrieve the path of the image
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8483_0.png"

    # Run the text detector
    final_result = Text_Detector_Tool.execute(image=image_path, languages=["en", "de"], detail=0)

    if final_result:
        detected_text = final_result["result"]
        text_detected = "Detected text: " + " ".join(detected_text)
        
        # Print the results
        print("Number of ShelvingUnits:", number_of_shelving_units)
        print("Detected text:", text_detected)
else:
    print("Text detection failed.")
</command>
