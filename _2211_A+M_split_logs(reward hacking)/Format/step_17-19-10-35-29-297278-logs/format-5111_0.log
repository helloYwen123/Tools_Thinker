from object_detector import Object_Detector_Tool

class Text_Detector_Tool:
  def execute(self, image, languages=["en", "de"], detail=0):
    result = []
    if languages:
      for language in languages:
        result += self.text_detector(image, languages=language, detail=detail)
    else:
      result = self.text_detector(image)
    return result

text_detector_options = {"languages": ["en", "de"], "detail": 1}

