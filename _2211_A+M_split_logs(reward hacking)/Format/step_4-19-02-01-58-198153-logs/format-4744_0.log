from object_detector import Object_Detector_Tool

class Image_Simulator:

    def __init__(self):
        self.object_to_save = False
        self.path_to_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4744_0.png"
        self.labels_to_check = ["baseball", "basket"]
        self.threshold_for_detection = 0.35
        self.model_size = "tiny"

    def simulate_detection(self):
        object_detector_tool = Object_Detector_Tool()
        try:
            labels_to_check = self.labels_to_check
            detected_objects, object_number = object_detector_tool.execute(image=self.path_to_image, labels=labels_to_check, save_object=self.object_to_save, saved_image_path="detected_objects")
            if not self.object_to_save:
                object_detector_tool.save_object("detected_objects")
        except Exception as e:
            print(f"Error detected: {e}")
        return detected_objects

    def detect_text(self):
        detection_tool = Text_Detector_Tool()
        try:
            texts_detected = detection_tool.execute(image=f'/nfs/data8/liao/wxie/SAT/SAT_images_train/4744_0.png', languages=['en', 'de'])
            if texts_detected:
                detected_text_blocks = [(box[0], box[1], box[2], box[3]), text] for box, text in texts_detected for boxes, text in zip(box, text) if boxes[0] >= 0 and boxes[2] >= 0
                return detected_text_blocks
        except Exception as e:
            print(f"Error detected: {e}")
        return False

def simulate_scene():
    scene_model = Image_Simulator()
    detected_objects = scene_model.simulate_detection()
    detected_objects = detected_objects if detected_objects else []
    
    sim_detected_text_blocks = scene_model.detect_text() if scene_model.detect_text() else False

    print("\n", "Detected Bats:", detected_objects)
    if sim_detected_text_blocks:
        print("\n", "Detected Text Blocks:", sim_detected_text_blocks)

simulate_scene()
