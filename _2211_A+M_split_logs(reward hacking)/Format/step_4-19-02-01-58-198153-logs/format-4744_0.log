import object_detector_tool as odt

# Demographic parameters are set to demo here
language = ['en', 'de']
detect_threshold = 0.40  # Threshold to detect text
detect_language = 'en'

def detect_objects(image_path, **kwargs):
    label_output = {}
    saved_objects = ''
    object_number = {}

    # Load the object detection model
    model = odt.load_model('Object_Detector_Tool')

    # Initialize the object detector
    object_detector = odt.Object_Detector_Tool()

    labels = [kwargs.get('labels') or []]

    # Try to detect objects with the provided labels
    try:
        detection_result = object_detector.execute(image=image_path, labels=labels, **kwargs)
    except Exception as e:
        raise ValueError(f"Error occurred while detecting objects: {e}")

    # Save detected objects to a saved object file
    if kwargs.get('save_object', True):
        object_detector.save_object(image_path, saved_objects, detection_result)
    
    # Initialize a dictionary to keep track of detected objects
    detected_objects = {}

    # Iterate over the detections and save data to the detected_objects dictionary
    n_objects = 0
    for label in labels:
        box, score, saved_image_path = detection_result[label]
        n_objects += 1
        detected_objects[label] = {
            'box': [int(x) for x in box.split(';')],  # Convert list to float
            'score': score,
            'saved_image_path': saved_image_path if saved_image_path else None
        }

    # For simplicity, we assume only one label was detected
    model['baseball'] = detected_objects

    for label, det_conf in model.items():
        print(f"Label: {label}, Total Objects: {n_objects}, Confident Objects: {'Yes' if det_conf['score'] > 0.3 else 'No'}")

    return model, n_objects
