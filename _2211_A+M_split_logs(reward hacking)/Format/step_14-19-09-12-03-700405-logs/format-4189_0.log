<command>
from Object_Detector_Tool import Object_Detector_Tool

def get_doorways(image_path):
    # Execute the image detection
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path)

    # Extract the number of doorways based on the detected objects
    doorway_count = {class_name: count for (class_name, count) in detected_objects.items()
                     if "basement door" in class_name and "doorway" in class_name or "bathroom" in class_name}

    return doorway_count

# Sample usage:
final_result = get_doorways("/nfs/data8/liao/wxie/SAT/SAT_images_train/4189_0.png")
print(final_result)
</command>
