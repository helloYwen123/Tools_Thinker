import object_detector

def count_beds(image_path, labels, thresh, save_object=False, saved_image_path=None):
    detector = object_detector.Object_Detector_Tool()
    results = detector.execute(image_path, labels=labels, threshold=thresh, save_object=save_object, saved_image_path= saved_image_path)

    bed_count = {}
    for obj_label, detected_objs in results['detected_objects']:
        for obj_data in detected_objs:
            if obj_label == 'bed':
                bed_count[obj_label] = 1

    return bed_count

