from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Generate a dictionary with all possible floor labels to detect
label_pairs = {
    'beds': [1, 2, 3, 4, 5  # 1 = bed, 2 = furniture, 3 = sofa, 4 = cupboard, 5 = dresser
             ],
    'basements': [0],
    'tables': [6]
}

model_size = 'tiny'
save_image_path = 'detected_objects'

# Call the object detection tool for beds
label_list = Object_Detector_Tool.execute(image='path/to/image.png', labels=label_pairs['beds'], saved_image_path=save_image_path, model_size=model_size, save_object=True)

# Call the text detector to count beds
for label in label_pairs['beds']:
    count = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en'], detail=1)

# Print the result
final_result = {
    'label_count': count,
    'bed_label_count': 0
}
for d in count:
    final_result['bed_label_count'] += label_list[d]['label']

print(final_result)
