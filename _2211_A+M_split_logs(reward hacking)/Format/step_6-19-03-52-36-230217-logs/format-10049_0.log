from object_detector import Object_Detector_Tool

class Text_Detector_Tool:
    def __init__(self, tool_module_name: str = "object_detector", tool_class_name: str = "Text_Detector_Tool", tool_description: str = "A tool that detects text in an image using EasyOCR":
        self.tool_module_name = tool_module_name
        self.tool_class_name = tool_class_name
        self.tool_description = tool_description
        self.model_version = tool_module_name + "_" + tool_class_name 

    def execute(self, data: dict, model_size: str = "tiny"):        
        result_dir = data.get("saved_image_path", "detected_objects")
        results = self._handle_data(data, model_size)
        
        return {
            "object_number": {
                label: len(results)
            } 
        }
        
    def _handle_data(self, data: dict, model_size: str):
        language_codes = ["en", "ja"]
        languages = data["languages"]

        language_support = self._check_language_support(languages, language_codes)
        result_dir = data["saved_image_path"]

        if not language_support:
            raise Exception("The languages for text detection do not support the languages in the environment.")

        image_path = data["image"]
        image_content = self._read_image_to_bytes(image_path)

        text_result = self._find_text(image_content, self.tool_module_name, self.tool_class_name)

        if not text_result:
            return []

        if language_codes:
            output_language = self._check_language_choice(language_codes, languages, result_dir)

            return text_result[self._get_language_code(output_language)]

        return text_result[self._get_language_code(languages[0])]
    
    def _read_image_to_bytes(self, path):
        with open(path, 'rb') as f:
            return f.read()

    @staticmethod
    def _check_language_support(languages, language_codes):
        for language in languages:
            language_support = False
            for language_code in language_codes:
                if language_code.lower() == language.lower().lower():
                    language_support = True
                    break
                if language_code not in language_codes:
                    return False
            if not language_support:
                return False
        return True
    
