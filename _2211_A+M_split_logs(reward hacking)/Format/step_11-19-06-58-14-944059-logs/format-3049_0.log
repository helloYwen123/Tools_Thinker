from object_detector import Object_Detector_Tool

# Sample image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3049_0.png"

# Sample labels
labels = ["baseball", "basket"]

# Threshold for detection
threshold = 0.35

# Model size
model_size = "tiny"

# Whether to save detected objects
save_object = True

# Saves the detected objects as images
saved_object_path = '/detected_objects'

# Run object detection
result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_object_path, threshold=threshold, model_size=model_size)

# Extract object number
object_number = {}

for label, detections in result.items():
    count = len(detections)
    object_number[label] = count

final_result = {"detected_objects": result, "object_number": object_number}
del final_result["detected_objects"]
