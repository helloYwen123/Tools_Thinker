from object_detector import Object_Detector_Tool

def num_shelf_units(image_path):
    tool_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/3049_0.png'  # Specify or retrieve the required image path for demonstration purposes
    labels = ['Shelf Unit']
    # Load object detector tool
    tool = Object_Detector_Tool()
    # Execution
    detected_objects, object_count = tool.execute(image=image_path, labels=labels)
    
    # Output
    if detected_objects:
        # Check if "Shelf Unit" is in detected objects
        for obj in detected_objects:
            if obj['label'] == 'Shelf Unit':
                shelf_units = obj['label']
                shelf_units_count = len(detected_objects)  # The count of specific objects
                shelf_units_count_str = "{0}".format(shelf_units_count)
                # Output the number of shelf units detected
                shelf_units_output = {'Shelf Unit': shelf_units_count, 'total_objects': shelf_units_count}
