def count_fridges(path):
    if not os.path.exists(path):
        return 0

    refrigerator_img = cv2.imread(path)

    refrigerator_c = cv2.cvtColor(fridge_img, cv2.COLOR_BGR2GRAY)

    thresh, fridge = cv2.threshold(fridge_c, 0.15, 255, cv2.THRESH_BINARY)

    refrigerator_mask = cv2.bitwise_not(fridge)

    _, contours, _ = cv2.findContours(fridge_mask, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

    fridge_count = 0

    for contour in contours:
        if cv2.arcLength(contour, True) >= 100:
            x, y, w, h = cv2.boundingRect(contour)
            x -= 50
            y -= 50
            x += 50
            y += 50
            area = w * h
            if area < 1000:
                continue

            mask = np.zeros(cape)
            cv2.drawContours(mask, [contour], -1, 255, (255, 255, 255))
            cape2 = np.array(Image.open(path))
            cape2_c = np.array(cape2.load())

            cape_c = cape2_c[..., :3]

            cape = cape2_c >= cape2_c.min()

            cape = cv2.bitwise_and(cape, cape, mask=mask)
            cape = 1 - cape
            cape_c = cape_c * cape

            f = cv2.warpAffine(cape2, contour.reshape((1, 3)), (cape.shape[1], cape.shape[0]))
            f = (f * cape2_c).astype(cape2_c.dtype)

            f, f2 = image2array(f, (color_range * 255).astype('uint8').copy())

            fridge = f2

    fridges = fridges[fridge > 0.8]
    fridge_count = len(fridges)
    return fridge_count

