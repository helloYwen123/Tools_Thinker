<command>from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def analyze_bedroom(image_path):
    # Use the object_detector tool to detect objects in the image, including the bed
    tool_details = {"image": image_path, "labels": ["bed"], "threshold": 0.35, "model_size": "tiny", "save_object": True, "saved_image_path": "detected_objects"}
    
    detected_objects, object_number = Object_Detector_Tool.execute(**tool_details)

    # Use the text_detector tool to detect text in the image, focusing on the bed
    command = "result = Text_Detector_Tool.execute(image='{}', languages='en', detail=1)"
    result = eval(command.format(image_path))

    # Iterate through detected objects to count occurrences of 'bed' and sort by confidence score
    text_analysis = {}
    for block in detected_objects:
        text_block = block["recognized_text"].lower()  # Convert recognized text to lowercase
        text_block_length = len(text_block)
        if "bed" in text_block:
            if text_block_length in text_analysis:
                text_analysis[text_block_length].append(block["bbox"] + " [" + str(block["score"]) + "]")
            else:
                text_analysis[text_block_length] = [block["bbox"] + " [" + str(block["score"]) + "]"]

    # Collect the most confident detections
    most_confident_detection = ""
    most_confident_detection_height = 0
    confidences = sorted(text_analysis.items(), key=lambda x: -x[1][0][3])
    for height, texts in confidences:
        if height > most_confident_detection_height:
            most_confident_detection_height = height
            most_confident_detection = texts[0]

        else:
            if not most_confident_detection:
                most_confident_detection = texts[0]

    # Determine the number of beds in the image
    num_beds = len(most_confident_detection)
    return most_confident_detection, text_analysis, num_beds

