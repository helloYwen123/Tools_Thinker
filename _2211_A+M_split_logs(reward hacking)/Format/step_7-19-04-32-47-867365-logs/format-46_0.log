from object_detector import Object_Detector_Tool

def count_bamboo_bats(input_image_path, labels=['baseball', 'basket', 'broom'], save_object=False, saved_image_path="detected_objects"):
    final_result = {}

    object_detector_tool = Object_Detector_Tool(input_image_path=input_image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    for output_dict in object_detector_tool.execute():  # Assuming output_dict contains data for 'baseball', 'basket', and 'broom'
        if 'baseball' in output_dict["labels"]:
            if 'box' in output_dict["labels"]:
                ball_length = output_dict["labels"]["baseball"]["boxes"][0][1] - output_dict["labels"]["baseball"]["boxes"][0][0]
                bat_length = output_dict["labels"]["basketball"]["boxes"][0][1] - output_dict["labels"]["basketball"]["boxes"][0][0]

                if ball_length > bat_length:
                    final_result["baseball"] += 1
                else:
                    final_result["basketball"] += 1

    # Convert the result to a dictionary and return with the object number
    return final_result, len(final_result), labels

input_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/46_0.png" # Path to the input image
