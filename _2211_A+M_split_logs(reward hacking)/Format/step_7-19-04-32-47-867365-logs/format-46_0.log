def count_baseball_bats(image_path):
    object_name = "BaseballBat"
    # Load the object detector model with fine-tuned weights
    detector = Detector(model='tiny')

    # Load the image and detect baseball bats
    labels, count = detector.execute(image_path, object_name, False, "tiny")

    # Initialize an empty list to store the detected baseball bats
    baseball_bats = []

    # Iterate over each detection result and check if the object is a baseball bat
    for result in labels.object_results(object_name):
        if result.category == "baseballbat":
            x, y = result.bounding_box
            width, height = result.width, result.height
            baseball_bats.append({
                'bbox': (x, y, x + width, y + height),
                'score': result.confidence
            })

    # If no baseball bats were detected, return -1
    if not baseball_bats:
        return -1

    # Convert the baseball bats list to a dictionary of dictionaries
    baseball_bats_dict = {
        'baseball': (len(baseball_bats), baseball_bats),
        'basketball': (0, [])
    }

    # Return the list of detected baseball bats, their bounding box coordinates, and their confidence scores
    return baseball_bats_dict['baseball'] if baseball_bats else []

