<code>
from object_detector import Object_Detector_Tool

final_result = "1"

# Set the image path and labels
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11350_0.png"
labels = ["baseball", "basket"]

# Create an object detector tool instance
detector = Object_Detector_Tool(image=image_path, labels=labels)

# Execute the tool
result = detector.execute()

# Parse the result
total_objects = {}
for label in result:
    objects = label['data']
    for object_info in objects:
        if "box" in object_info:
            # Find bounding box coordinates
            box_info = object_info["box"]
            x1, y1, x2, y2 = box_info
            total_objects[label["name"]] = label["id"]
            break

# Define the dictionary of results
detected_objects = {
    "baseball": [(int(x1), int(y1), int(x2), int(y2)) for x1, y1, x2, y2 in detected_objects[label["name"]]],
    "basket": [(int(x1), int(y1), int(x2), int(y2)) for x1, y1, x2, y2 in detected_objects[label["name"]]]
}

total_objects_result = {
    **total_objects,
    **len(detected_objects)
}

# Check number of DiningTables
if total_objects_result["basket"] <= 0 or total_objects_result["baseball"] <= 0:
    final_result = "0"

print(final_result)
</code>
