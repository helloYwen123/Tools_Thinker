from object_detector import Object_Detector_Tool

def count_house_plants(image_path, labels=None, threshold=0.35, model_size='tiny'):
    objects = Object_Detector_Tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size)
    house_plants = []

    if 'baseball' in objects['baseball'] or 'basket' in objects['basket']:
        house_plants.append(objects['baseball'][0]['score'])
        house_plants.append(objects['basket'][0]['score'])
    else:
        return []

    return house_plants

result = count_house_plants('/nfs/data8/liao/wxie/SAT/SAT_images_train/397_0.png')  # replace with actual image path
print(result)
