from object_detector import Object_Detector_Tool

def detect_houses_plants(image_path):
    """
    Detects the houseplants in the image.
    :param image_path: str - The path to the image file.
    :return: dict - A dictionary mapping each plant label to a list of detection results and a dictionary with the total count for each detected label.
    """
    tool_instance = Object_Detector_Tool()

    tool_instance.execute(image=image_path, labels=['house plant'], save_object=True)

    return tool_instance

