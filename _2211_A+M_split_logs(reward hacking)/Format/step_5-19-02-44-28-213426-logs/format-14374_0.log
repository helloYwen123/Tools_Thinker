from object_detector import Object_Detector_Tool

# Define the image path and the labels to detect
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/14374_0.png"
labels = ["baseball", "basket"]

# Execute the detection tool
result = Object_Detector_Tool.execute(image_path=image_path, labels=labels, save_object=True, saved_image_path="detected_objects")

# Print the result
detected_objects = result['detected_objects']

# Calculate the number of objects for each detected label
object_number = result['object_number']

# Generate the final answer as a string
final_result = {
    "doors": 0
}

# If there are doors detected, increment the count for doors
if "baseball" in detected_objects:
  final_result["doors"] = 1
else:
  final_result["doors"] = 0

# Output the final answer
if final_result:
  print(f"Number of doors: {final_result['doors']}")
else:
  print("No doors detected.")
