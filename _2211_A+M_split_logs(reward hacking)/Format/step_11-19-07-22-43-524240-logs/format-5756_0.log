from object_detector import object_detector

def count_dressers(image_path, labels, threshold=0.35, model_size='tiny', save_image=False, saved_image_path=''):
    try:
        detected_objects = object_detector.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_image, saved_image_path=saved_image_path)

        # Check if there are any detected objects
        if detected_objects:
            object_count = {'baseball': 0, 'basket': 0}
            for object_entry in detected_objects:
                for label in object_entry['labels']:
                    if label in labels:
                        object_count[label.lower()] += 1

            return object_count
        else:
            return {'baseball': 0, 'basket': 0}
    except Exception as e:
        return {'baseball': 0, 'basket': 0, 'error': str(e)}

# Path to the image in the SAT_Dungeon_images_train/5756_0.png folder
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5756_0.png'

# Detect text in the image, including coordinates and confidence scores using multiple languages (English and German)
result = object_detector.execute(image=image_path, languages=['en', 'de'])

# Convert the detection results to the expected output format
objects_count = {'baseball': 0, 'basket': 0}
for object_entry in result:
    object_type = object_entry['boxes'][0][0].lower()
    object_count[object_type] += 1

print(f"Count of objects found in the image: {object_count}")
</command>
