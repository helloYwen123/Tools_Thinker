from object_detector import Object_Detector_Tool

def count_coffee_tables(image_path):
    # Assuming the object detector tool is installed and configured properly with the path to the saved detected images.
    result = Object_Detector_Tool.execute(image=image_path, labels=['DiningTable'], save_object=True, saved_image_path="detected_objects")
    coffee_tables = result["detected_objects"]

    return len(coffee_tables)

final_result = count_coffee_tables('/nfs/data8/liao/wxie/SAT/SAT_images_train/7383_0.png')
print("Number of dining tables in the image:", int(final_result["object_number"]["DiningTable"]))
