command = """
detected_objects, object_number = Object_Detector_Tool.execute(image=path_to_image, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
"""

exec(command)  # Run the command and get the output

if detected_objects:
    object_labels = [det['label'] for det in detected_objects]
    object_numbers = [det['object_number'] for det in detected_objects]
    for label, number in zip(object_labels, object_numbers):
        result = {
            'label': label,
            'number': number,
            'description': 'Number of {} detected in the image: {}'.format(label, number)
        }

        if save_object:
            # Save the object detection result
            result_path = os.path.join('detected_objects', f'{label}_detected_objects_{number}.png')
            os.makedirs(os.path.dirname(result_path), exist_ok=True)
            result['image_path'] = result_path
            img = Image.open(result_path)
            img.save(result_path)
        final_result.append(result)
else:
