from object_detector import Object_Detector_Tool

# Load image and specify required parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/7383_0.png"
labels = ["baseball", "basket"]
save_object = True
saved_image_path = "detected_objects"

try:
    # Detect objects
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    # Print object number
    final_result = {"object_number": object_number, "result": detected_objects}

    if detected_objects:
        final_result["result"] = final_result["result"][0]

    print("Detected objects in the image:")
    for label, box_points in detected_objects.items():
        print(f"{label}: [{', '.join(map(lambda p: f'[{p[0]} {p[1]}]}', box_points)}]")

    print("Object number:", object_number)
except Exception as e:
    print("Error:", e)


