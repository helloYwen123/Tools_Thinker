from text_detector import Text_Detector_Tool

def calculate_num_objects(image_path, languages=['en', 'de']):
    detected_objects = []
    detail = 0
    for language in languages:
        results = Text_Detector_Tool.execute(image=image_path, languages=[language], detail=detail)
        if len(results) > 0:
            detections = results[0][0]
            object_labels = [det[2] for det in detections]
            for label in object_labels:
                detected_objects.append((label, len(detections[label]), 1))
    return detected_objects

final_result = calculate_num_objects(image_path="1381_0.png")

if len(final_result) > 0:
    print("There are", final_result[0][1], "objects visible in ", final_result[0][0])
else:
    print("No objects detected")


