from object_detector import Object_Detector_Tool

final_result = {}

image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/12239_0.png'

labels = ['chair']

model_size = 'tiny'
threshold = 0.35
save_object = True
saved_image_path = 'detected_objects'

try:
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size, save_object=save_object)
    final_result['detected_objects'] = detected_objects
    final_result['object_number'] = object_number

except Exception as e:
    final_result['detected_objects'] = []
    final_result['object_number'] = 0

print("The number of chairs visible in the scene is:", object_number)
print("The total number of chairs visible with captions is:", object_number)

if 'detected_objects' in final_result:
    for detected_object in final_result['detected_objects']:
        detected_object = {**(detected_object), 'object_number': len(detected_object['labels']),
                           'label_number': len(detected_object['labels'])}
        final_result['detected_objects'].append(detected_object)

print("Detected chairs:")
for detected_object in final_result['detected_objects']:
    print(detected_object)

print("Number of chairs detected:", object_number)
print("Number of chairs detected with captions:", object_number)
