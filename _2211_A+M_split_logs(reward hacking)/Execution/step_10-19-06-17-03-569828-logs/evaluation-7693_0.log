from object_detector import Object_Detector_Tool

def count_drawers(image):
    drawer_detector_tool = Object_Detector_Tool(image=image, labels=['drawer'], save_object=True)
    drawer_output = drawer_detector_tool.execute()
    drawer_number = len(drawer_output["baseball"]) + len(drawer_output["basket"])
    return drawer_number

