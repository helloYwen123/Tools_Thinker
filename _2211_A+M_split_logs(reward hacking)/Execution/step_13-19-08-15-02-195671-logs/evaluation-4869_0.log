from pytesseract importocr

def text_detector(image_path, languages=['en', 'fr'], detail=0):
    try:
        returnocr_result = pytesseract.image_to_string(image_path,Languages=languages,config="--config path/to/detector/file.ini--psm 2 --oem 3 --psm 21--psm 30 --tessedit_char_whitelist=0123456789 -o raw --oem opt --result_type parse --psm 8", detail=detail)
        return returnocr_result
    except Exception as e:
        return "Error: {0}".format(str(e))

detected_objects_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4869_%04d.png" % random.randint(1, 1000)
saved_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4869_%04d_saved_image.png" % random.randint(1, 1000)

label_objects = text_detector(detected_objects_path, languages=['ja'])
object_detector_objects = []

for label in label_objects:
    for object in label_objects[label]:
        object_detector_objects.append({
            "box": [x[0] + int(x[2]), y[0] + int(x[3]), x[1] + int(x[2]), y[1] + int(x[3])],
            "score": object["score"],
            "saved_image_path": "" if labels == label else "detected_objects/fallback.png"
