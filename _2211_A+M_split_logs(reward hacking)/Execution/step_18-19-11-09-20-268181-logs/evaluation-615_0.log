from object_detector import Object_Detector_Tool

def find_objects(image_path):
    try:
        detector = Object_Detector_Tool()
        results = detector.execute(image_path, labels=['baseball', 'basket'], save_object=False)
        confidence_scores = []
        for label, entry in results.items():
            confidence = entry[4] if entry else 0.0  # Assuming no scores for certain labels are retrieved correctly
            confidence_scores.append(confidence)
        total_count = sum(confidence_scores)
        detected_objects = {
            'baseball': [i for i, _ in enumerate(confidence_scores[:-1]) if confidence_scores[i - 1] >= confidence_scores[i] * 0.8],
            'basket': [i for i, _ in enumerate(confidence_scores[:-1]) if confidence_scores[i - 1] >= confidence_scores[i] * 0.8]
        }
        return total_count, detected_objects
    except Exception as e:
        return 0, {}

final_result = find_objects('/nfs/data8/liao/wxie/SAT/SAT_images_train/615_0.png')
