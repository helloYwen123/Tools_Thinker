import object_detector

def count_armchairs(image_path):
    try:
        detected_labels, object_number = object_detector.execute(image=image_path, labels=['armchair'])
        if detected_labels and 'armchair' in detected_labels:
            total_objects = len(detected_labels)
            return {"armchair": total_objects}
        else:
            return {}
    except Exception as e:
        return {"result": f"Failed to detect armchairs due to {e}"}

