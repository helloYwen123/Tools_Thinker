from Object_Detector_Tool import Object_Detector_Tool

final_result = {}
labels = ["baseball", "basket"]

# Try to detect baseball and basket
try:
    detected_text = Object_Detector_Tool.execute(image='path/to/image.png', languages=labels, detail=0)
    if detected_text:
        detected_objects = []
        for txt_block in detected_text:
            # Assuming the model returns the object bounding box and score.
            # Get the object coordinates and save the image if save_object is True.
            detected_objects.append({"bbox": txt_block[0][0], "bbox1": txt_block[0][0], "bbox2": txt_block[0][0], "score": txt_block[2]})

        final_result['baseball'] = len(detected_objects)
        final_result['basket'] = len(detected_objects)

        # Output the results
        final_result = {
            'baseball': detected_objects,
            'basket': detected_objects
        }
    else:
        print('Text detection failed.')
except Exception as e:
    print(f"Error: {e}")

print(final_result)


