import os
import numpy as np
from torchvision.io import read_image

def count_objects(target_image, object_labels):
    image_path = os.path.abspath(target_image)
    image = read_image(torch.utils.data.DataLoader(np.array([image_path], dtype=np.uint8), 
                                                   batch_size=1, num_workers=0, 
                                                   pin_memory=False, worker_init_fn=None))[0]
    boxes, labels, scores = object_detector(image=image, labels=object_labels, 
                                            threshold=0.35, model_size="tiny", save_object=False)
    object_count = {'baseball': 0, 'basket': 0}

    for label, box in sorted(((l, b) for (l, box) in boxes.items() if l in labels), reverse=True):
        if label == 'baseball':
            object_count['baseball'] += 1
        elif label == 'basket':
            object_count['basket'] += 1

    return object_count

final_result = count_objects('/nfs/data8/liao/wxie/SAT/SAT_images_train/8017_0.png', ['baseball', 'basket'])
print(final_result)


