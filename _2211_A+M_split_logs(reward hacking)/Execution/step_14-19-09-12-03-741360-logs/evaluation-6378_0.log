final_result = {}  # Initialize a dictionary to store the objects
detected_objects = Object_Detector_Tool.execute(image='path/to_image.png', labels=['counter_top', 'counter_table'], save_object=True, saved_image_path='detected_objects')
if detected_objects:
    final_result['counter_tables'] = len(detected_objects['counter_table'])  # Replace 'counter_table' and 'counter_top' with actual class names
else:
    final_result['counter_tables'] = 0

for object in detected_objects.items():
    if 'counter_table' in object[0]:
        final_result['counter_tables'] += object[0][1]['counter_table']['count']

return final_result


