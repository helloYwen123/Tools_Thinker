from object_detector.object_detector import Object_Detector_Tool

def answer_question():
    image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/13880_0.png'  # Replace with your image path

    label_to_count = ["baseball", "basket"]

    detection_results = Object_Detector_Tool.execute(image=image_path, labels=label_to_count, save_object=False)

    detected_objects = detection_results["detected_objects"]
    
    total_objects = detection_results["object_number"]

    if total_objects:
        print(f"Detection Results for {label_to_count}:")
        for label, detection in detected_objects.items():
            box = detection["box"]
            score = detection["score"]
            if 'saved_image_path' in detection:
                saved_image_path = detection["saved_image_path"]
            print(f"{label}: [{box}, {box[2]-box[0]+1}, {box[3]-box[1]+1}], {score}, {saved_image_path}")
    else:
        print("Error: Could not detect text")

    print(f"Total Objects: {total_objects}")
    
if __name__ == "__main__":
    answer_question()


