from object_detector import Object_Detector_Tool

def count_television_in_scene(image_path):
    # Load the image
    image = Image.open(image_path)

    # Detect the television in the image
    detected_objects = Object_Detector_Tool.execute(image=image, labels=["television"], save_object=False)
    television_count = len(detected_objects["television"])
    
    return television_count

final_result = count_television_in_scene("/nfs/data8/liao/wxie/SAT/SAT_images_train/961_0.png")
print("Number of televisions in the scene:", final_result)


