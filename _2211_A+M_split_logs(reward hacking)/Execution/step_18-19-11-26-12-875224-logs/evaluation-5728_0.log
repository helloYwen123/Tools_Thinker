from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels=['baseball', 'basket'], save_object=False, saved_image_path="detected_objects"):
    detected_objects = {}

    for label in labels:
        result = {}
        try:
            detections = Object_Detector_Tool.execute(image=image_path, labels=[label], save_object=save_object, saved_image_path=saved_image_path)
            for detection in detections:
                x1, y1, x2, y2 = detection['box']
                if save_object:
                    object_path = os.path.join('/nfs/data8/liao/images', 'detected_objects', f'{label}_{detection["score"]}.png')
                    object = Image.open(object_path)
                    object = object.crop((x1, y1, x2, y2))
                    object.save(object_path)
                result[label] = {'box': (x1, y1, x2, y2), 'score': detection['score']}
            detected_objects[label] = result
        except Exception as e:
            print(f"Error while attempting to detect {label}: {e}")
            return {}

    return detected_objects

final_result = detect_objects(image_path='/nfs/data8/liao/wxie/SAT/SAT_images_train/5728_0.png', labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects")

print(f"Detected objects: {final_result}")


