from object_detector import Object_Detector_Tool

# Define the labels, thresholds, and model sizes
labels = ['chair']
threshold = 0.15
model_size = 'tiny'

# Load the image
path_to_image = '/nfs/data8/liao/wxie/SAT/SAT_images_train/3613_0.png'

# Function to detect objects and retrieve the number of chair objects
def get_chairs_number(image_path):
    detected_objects = []
    try:
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True)['detected_objects']
        chairs = sum(1 for obj in detected_objects if 'chair' in obj['labels'])
        return chairs
    except Exception as e:
        print(f"Error: {e}")
        return 0

print(f"Number of chairs detected: {get_chairs_number(path_to_image)}")


