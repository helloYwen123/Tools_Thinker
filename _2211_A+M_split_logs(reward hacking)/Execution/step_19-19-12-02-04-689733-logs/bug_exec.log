from object_detector import Object_Detector_Tool

def count_objects(image_path, labels, save_to_dir, detail=0):
    # Load the image and detect objects
    tool = Object_Detector_Tool()
    
    objects = tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path=labels[0])

    # Verify objects were detected
    if not bool(objects):
        result = {
            'error': f"Object detection failed: {image_path}",
            'details': []
        }
        return result

    # Get only the top 5 detected objects
    top_5_objects = objects[:5]
    
    objects_dict = {}
    object_counts = {}
    for det_obj in top_5_objects:
        label, box, score = det_obj
        object_counts.setdefault(label, 0)
        object_counts[label] += 1
        objects_dict[label] = det_obj
        
    # Write the results to the specified path
    details = []
    
    for obj in objects_dict.values():
        boxx, boxed = obj['box'].values()
        if len(boxx) == 4:
            boxx = list(map(list, zip(*boxed)))
            box, y = boxx
            boxed = {'box': box, 'y': y}
            for i in range(len(boxx[0])):
                if obj['saved_image_path']:
                    details.append([boxed, obj['score'], label, save_to_dir] + obj['saved_image_path'])
            if labels:
                if labels[0] == label:
                    details.append([boxed], None)
    
    if labels:
        result = {
            'total_objects': len(objects_dict),
            'labels': sorted(set(labels)),
            'detected_objects': sorted(set([labels[i[1]] for i in details]) if len(details) > 0 else []),
            'labels_count': object_counts,
            'total_detection_time': len(details),
            'detected_object_time': sum(len(x) for x in details) if len(details) > 0 else -1
        }
    else:
        result = None
    
    return result

# Example usage
