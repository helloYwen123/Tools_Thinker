import object_detector as objdet

# Initialize the object_detector tool
objdet_tool = objdet.Object_Detector_Tool()

# Set the image path
img_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5207_0.png'

# Optionally set the labels as ['baseball', 'basket'] (1)
labels = [objdet.LABEL_BASEBALL, objdet.LABEL_BASKET]
labels.extend([objdet.LABEL_baseball, objdet.LABEL_basket])

# Calculate the confidence threshold
objdet_tool.set_configuration('confidence_threshold', 0.35)

# Specify the model size
model_size = objdet.Tool.ModelSize.SMALL_TINY

# Specify whether to save the detected objects as images
save_object = True

# Execute the detection
result = objdet_tool.execute(image=img_path, labels=labels, model_size=model_size, save_object=save_object, threshold=objdet.Tool.Confidence_threshold)

# Save the detections to a file if save_object is True
if save_object:
    objdet.Tool.save_detected_objects(result, '/nfs/data8/liao/wxie/SAT/SAT_images_train/5207_detections')


