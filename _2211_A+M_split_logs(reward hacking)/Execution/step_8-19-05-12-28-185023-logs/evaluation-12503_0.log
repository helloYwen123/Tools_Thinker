from text_detector import Text_Detector_Tool

def count_tv_stands(image_path):
    detected_texts = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])
    if detected_texts:
        text_blocks = []
        for text_block in detected_texts[0]:
            if text_block[3]:
                text_blocks.append({'bbox': text_block[0], 'text': text_block[1], 'score': text_block[2]})
        if text_blocks:
            total_count = sum(len(text_block['bbox']) for text_block in text_blocks)
            return {"tv_stand_count": total_count}
    return None

result = count_tv_stands('/nfs/data8/liao/wxie/SAT/SAT_images_train/12503_0.png')
if result:
    print(f"Count of TV stands: {result}")
else:
    print("No text detected in the image.")


