from_language = "Simplified Chinese"
from_number_of_retries = "10"

def text_search(image_path, languages=[from_language, "en"], detail=0):
    text_results = []
    for language in languages:
        text_results.extend(text_search_with_dino(image_path, language))
    text_results.sort(key=lambda result: result[2], reverse=True)
    return text_results

def text_search_with_dino(image_path, language):
    language_code = language.split(" ")[0]
    if detailed_search and language_code not in languages_to_search:
        print(f"Search language '{language}' is not supported. Using the main search without detailed processing.")
        languages_to_search.extend([language_code])
    return text_search_with_dino_with_retry(image_path, languages_to_search, language_code)


