from tool_object_detector import Object_Detector_Tool

class ImageTextDetector(object):
    def __init__(self):
        self.object_detector_tool = Object_Detector_Tool()

    def detect_text(self, image_path, languages=(['en', 'de']), detail=0):
        result = []
        for language in languages:
            try:
                result += self.object_detector_tool.execute(image=image_path, languages=[language])
            except Exception as e:
                print(f"Error detecting text: {e}")
        if detail == 1:
            result = [[(bbox, token) for bbox, token in detected_result] for detected_result in result]
        return result

result = ImageTextDetector().detect_text("path/to/image.png", languages=['en', 'de'], detail=1)
print(result)


