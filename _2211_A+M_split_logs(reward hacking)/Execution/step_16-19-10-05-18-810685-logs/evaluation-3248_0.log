from object_detector import Object_Detector_Tool

# Read the image file path from the question
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3248_0.png"

# Load the image file and set the threshold and model size
image = Image.open(image_path)
image.load()
im = np.array(image)

# Create the object detection tool instance
object_detector = Object_Detector_Tool(image=image, labels=['baseball', 'basket'], threshold=0.35, model_size='tiny')

# Detect text in the image using multiple languages
result = object_detector.execute()

# Extract the information needed from the detection results
total_baseball = result[0][0][0][1]
total_basket = result[0][0][1][1]

# Convert the result to expected format and calculate the final count
final_result = {}
for label in result[0][0]:
    count = result[0][0][1]
    final_result[label] = count

final_result['total_baseball'] = total_baseball
for l in result:
    final_result[l] = total_baseball

for l in result:
    if 'baseball' in l:
        # Process the detected baseball item and calculate the final count
        final_result['baseball'] = result[l][0][1]

# Check if there were any retries
if 'detected_objects' in result:
    final_result['total_basket'] = len(result['detected_objects'])

# Convert dictionary to string format
final_result = {k: str(v) for k, v in final_result.items()}

# Print the result
