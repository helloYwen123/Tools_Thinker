from object_detector import Object_Detector_Tool

def answer_question(image_path, *labels, **kwargs):
    final_result = "?"
    detected_object_list = []
    object_count = {}

    try:
        # Execute the tool and get the results
        result = Object_Detector_Tool.execute(image_path, labels, **kwargs)
    except Exception as e:
        return "Error: " + str(e)

    for _, label in result["detected_objects"]:
        detected_object_list.extend(label['saved_image_path'].split("/")[-1].split("_"))
        object_count[' '.join(label['saved_image_path'].split("/")[-1].split("_"))] = object_count.get(' '.join(label['saved_image_path'].split("/")[-1].split("_")).lstrip().split("detected_objects_")[1], 0) + 1

        # Detect and count text in each detected object
    possible_text = []
    for det in detected_object_list:
        det = det.split("_")
        for lan in labels:
            text_result = Text_Detector_Tool.execute(image=det, languages=[lan])
            if text_result:
                possible_text.append(text_result[-1])
                
    return final_result

final_result = answer_question("/home/username/SAT_images_train/11335_0.png", ["baseball"], save_object=True, saved_image_path="detected_objects")
