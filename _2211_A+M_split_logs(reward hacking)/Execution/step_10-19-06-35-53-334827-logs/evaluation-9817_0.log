from object_detector import Object_Detector_Tool

# Specify the path to the image file and labels to detect
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9817_0.png"
labels_to_detect = ["baseball", "basket"]

# Make sure the Image path is a non-null string
if image_path:
    # Create an instance of the Object_Detector_Tool class and execute the code
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels_to_detect, save_object=True, saved_image_path="detected_objects")

    # Retrieve the number of detected objects
    num_objects = object_number["baseball"] + object_number["basket"]

    final_result = {
      "Result": detected_objects,
      "Object Number": num_objects,
      "Final Label": labels_to_detect[0],
      "Final Object Number": object_number
    }

    # Print the extracted data
    final_result_output = [f"Number of detected objects: {i}" for i in object_number.values()]
    print("\n".join(final_result_output))
    print(f"Detected Objects: {final_result['Result']}")
    print(f"Number of baseball: {final_result['Result'][i]['box'][0] = f'{final_result['Result'][-1']['box'][0]}'}")
    print(f"Number of basketball: {final_result['Result'][i]['box'][2] = f'{final_result['Result'][-1]['box'][2]}'}")
else:
