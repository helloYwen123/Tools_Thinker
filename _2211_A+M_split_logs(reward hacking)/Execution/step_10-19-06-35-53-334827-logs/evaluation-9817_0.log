from object_detector import Object_Detector_Tool, text_detector

total_objects = 0

def count_objects(image_path, labels=['baseball', 'basket'], languages=['en', 'de']):
    detector_tool = Object_Detector_Tool(image=image_path, languages=languages)
    object_labels, object_number = detector_tool.execute(labels=labels, threshold=0.35, model_size='base', save_object=False)

    detected_objects = {obj['label']: list(obj['detected_box']) for obj in object_labels}
    total_objects += object_number['baseball'] + object_number['basket']

    results = []
    for label, detection_box in detected_objects.items():
        detected_objects[label] = []
        for detection in detection_box:
            box = tuple(detection['bbox'])
            name = detection['label']
            score = detection['score']
            results.append([box, name, score])

    results = sorted(results, key=lambda x: x[2], reverse=True)
    for result in results[:10]:
        print(f"Detected {result[1]} with coordinates: {result[0]} and confidence score: {result[2]}")

result = count_objects('9817_0.png', [labels=['baseball', 'basket']])
