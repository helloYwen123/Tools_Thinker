  image=input_path,
  languages=["en", "de"],
  detail=1
)

# Extract the information we need
detected_text_blocks = []
for result in result:
  if result["score"] > 0.5:  # Adjust confidence threshold as per requirement
    detected_text_blocks.append(result["box"])
