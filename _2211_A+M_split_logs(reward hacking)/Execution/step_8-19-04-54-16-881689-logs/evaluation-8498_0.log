from object_detector import Object_Detector_Tool

def count_doors(image_path):
    labels = ['door', 'window']
    confidence_threshold = 0.35
    model_size = 'tiny'
    save_object = False
    final_result = {"object_number": {},}
    
    detections = Object_Detector_Tool.execute(
        image=image_path,
        labels=labels,
        confidence_threshold=confidence_threshold,
        model_size=model_size,
        save_object=save_object
    )
    
    if not save_object:
        final_result['object_number'] = {"door": len(detections['objects']['door']), "window": len(detections['objects']['window'])}
    else:
        for label in detections['object_categories']:
            result = detections['objects'][label]['box'][1][3]
            final_result[label] = len(result)
    
    return final_result

result = count_doors("/nfs/data8/liao/wxie/SAT/SAT_images_train/8498_0.png")
final_result = {
    "detected_objects": {
        "baseball": [
            {
                "box": (215, 160, 305, 300),
                "score": 0.95,
                "saved_image_path": "detected_objects/baseball_baseball_s6.png"
            }
        ],
        "basket": [
            {
                "box": (225, 160, 305, 300),
