    for detection in final_result['detected_objects']:
        if detection['label'] == label:
            print(f"{label}:")
            print("- Object detected: {0}".format(detection['label']))
            print("- Box coordinates: [{0}, {1}].".format(*detection['box']))
            print("- Confident score: {0}% accuracy.".format(int(100 * detection['score']) if 'score' in detection and 'score' in detection else 0))
