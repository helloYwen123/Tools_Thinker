from object_detector import Object_Detector_Tool

def find_fridge():
    final_result = []
    # Assume 'image' is in the file directory and 'labels' is a list containing 'fridge' and 'no_fridge'
    labels_detected = Object_Detector_Tool.execute(image='path/to/image.png', model_size='tiny', labels=['fridge'], threshold=0.35, save_object=True)
    labels_possible = labels_detected['fridge'].items()

    for label detected in labels_possible:
        if label[0] == 'fridge':
            final_result.append({'box': detected[1]['box'], 'score': detected[1]['score']})
            final_result.append({'box': detected[2]['box'], 'score': detected[2]['score']})
            break

    image_to_save_path = 'detected_fridge_images.jpg'
    image_fridge = Image.open(image_to_save_path)
    fridges_detected = len(final_result)
    for detected in final_result:
        ImageDraw.rectangle(image_fridge, (detected['box'][0], detected['box'][1], detected['box'][2], detected['box'][3]), (0, 0, 0))
    image_fridge.save(image_to_save_path)

    return fridges_detected

fridges = find_fridge()
print("Number of fridges detected:", fridges)

# Test the tool with demo example
import_text_detector = Text_Detector_Tool()
import_text_detector.execute(image='path/to/image.png', languages=['en'])
fridges = find_fridge()
print(f"The number of fridges detected with both tools is: {fridges}")


