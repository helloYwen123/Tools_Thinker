from tools.object_detector import Object_Detector_Tool

def count_objects(save_object=False):
    result = Object_Detector_Tool.execute(
        image=r\'path/to/image.png\', labels=[\"chair\", \"table\"], 
        save_object=save_object)
    
    if not result:
        return []

    detected_objects = []
    for det in result['detected_objects']:
        bounding_box, score = det["box"], det["score"]
        object_name = det['saved_image_path'].split('.')[3][:-4].replace("_", "").upper()
        if object_name not in detected_objects:
            detected_objects.append({object_name: [{'box': bounding_box, 'score': score}]})
    
    if save_object:
        save_path = r\'detected_objects\'
        return detected_objects
    
    return detected_objects

# Example usage:
# detected_objects = count_objects()
# print(detected_objects)

final_result = count_objects()
print(final_result)


