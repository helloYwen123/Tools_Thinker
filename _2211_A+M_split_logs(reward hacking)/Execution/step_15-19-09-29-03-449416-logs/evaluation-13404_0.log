from object_detector.object_detector import Object_Detector_Tool

# Input path
input_path = "image.png"

# Labels to detect
labels = ["baseball", "basket"]

# Threshold confidence score
threshold = 0.35

# Model size
model_size = "tiny"

# Output save path
output_path = "detected_objects"

# Create an object detector tool instance
tool_instance = Object_Detector_Tool()

# Execute object detection
detected_objects, objects_count = tool_instance.execute(image=input_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path=output_path)

# Example output for demonstration purposes
final_result = detected_objects
print("Detected labels:", final_result["baseball"])
print("Detected objects:", objects_count)


