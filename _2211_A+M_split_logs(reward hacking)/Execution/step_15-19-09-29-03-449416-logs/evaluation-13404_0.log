from object_detector import Object_Detector_Tool

def count_chairs(image_path, labels, threshold=0.35, model_size='tiny', save_object=True):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, model_size=model_size)
    
    if detected_objects:
        object_number = {label: len(detected_objects[label][0][0]) for label in labels}
        return detected_objects, object_number
    else:
        return [], {}


