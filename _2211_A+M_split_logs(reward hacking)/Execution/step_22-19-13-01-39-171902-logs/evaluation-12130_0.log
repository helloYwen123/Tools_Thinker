        for detection in detections:
            print(f"Detected {label} ({detection['score']:.2f}) with bounding box at (x0={detection['box'][0]}, y0={detection['box'][1]}, x1={detection['box'][2]}, y1={detection['box'][3]}, x2={detection['box'][4]}, y2={detection['box'][5]}).")
    else:
        print(f"No {label} detected.")

for label, count in total_objects.items():
    print(f"{label}: {count}")
