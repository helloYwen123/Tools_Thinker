from tool_object_detector import Object_Detector_Tool
from tool_text_detector import Text_Detector_Tool

# Define the image file path
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/12130_0.png'

# Detect objects in the image using the Object Detection Tool
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Initialize lists to store detected text blocks and text
text_blocks = []
text_confidences = []

# Process the detected objects
for label in detected_objects.keys():
    for result in detected_objects[label]:
        # Extract bounding box coordinates
        x0, y0 = result['b'], result['h']
        x1, y1 = x0 + result['w'], y0 + result['h']
        x2, y2 = x1 + result['w'], y1 + result['h']
        x3, y3 = x2 + result['w'], y2 + result['h']
        
        # Process detected text
        text_blocks += [[(x0, y0), (x1, y1), (x2, y2), (x3, y3), f'\'\nDetected text: "{result["content"]}"\n', detected_objects[label][0]['score']]]
        
        # Append text confidence scores
        text_confidences += [(result['score'] if f'score' in result else 0.0, label) for result in detected_objects[label]]
        
        # Print the detected objects and text blocks
        print(f"Detected objects for {label}: {detected_objects[label]}")
        print(f"Detected text blocks: {text_blocks}")
        print(f"Text confidence scores (label): {text_confidences}")

# Print the final detected objects and text blocks
for detected_object in detected_objects.values():
    print(f"Detected objects for {detected_object}: {detected_object}")
    print(f"Text confidence scores for {detected_object}: {text_confidences[detected_object]}")


