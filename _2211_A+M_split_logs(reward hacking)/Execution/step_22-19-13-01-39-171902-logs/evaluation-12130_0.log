import OpenCV as ocv

from tool_module_name.Object_Detector_Tool import Object_Detector_Tool as od_tool
from tool_module_name.Text_Detector_Tool import Text_Detector_Tool as td_tool

def answer_to_question():
    img = open('path/to/image.png').read()
    # Using the tool to detect objects based on the image
    results = od_tool.execute(image=img, labels=['baseball', 'basket'], save_object=True)
    total_objects = {label: len(results) for label in results[0].keys()}

    return results, total_objects

results, total_objects = answer_to_question()
