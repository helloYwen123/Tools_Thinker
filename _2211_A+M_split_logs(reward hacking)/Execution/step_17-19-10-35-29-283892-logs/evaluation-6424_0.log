from object_detector import Object_Detector_Tool

final_result = {"total_paintings": 0}
paintings_found = False

# Assuming the image path is provided as 'image_path'
for path in [
    # Paths mentioned in the question (adjust according to the input)
    "/nfs/data8/liao/wxie/SAT/SAT_images_train/6424_0.png"
]:
    # Assuming image exists (the path is valid)
    if os.path.exists(path) and "painting" in path:
        paint_detector = Object_Detector_Tool(image=path, languages=["en"], detail=False)
        detections = paint_detector.execute()
        for detection in detections:
            if "painting" in detection["box"]:
                painting_found = True
                if detection["score"] > 0.35:
                    final_result["total_paintings"] += 1

        if painting_found:
            if save_object:
                # Save detected objects to a file
                save_path = os.path.join("/path/to/save","painting_1.png")
                save_result = paint_detector.execute(image=path, languages=["en"], detail=False, save_object=True, saved_image_path=save_path)
                painting_object_num = int(save_result["object_number"]["painting"])
                final_result["total_paintings"] += painting_object_num

print(final_result)


