from object_detector import Object_Detector_Tool

# Initialize the object detector tool
object_detector = Object_Detector_Tool()

# Create an input dictionary with the paths of the images containing the 412_0.png file, empty labels, 0.35 confidence threshold, and 'tiny' model size
input_dict = {
    "image": "/nfs/data8/liao/wxie/SAT/SAT_images_train/412_0.png",
    "labels":"baseball, basketball",
    "threshold":0.35,
    "model_size":"tiny"
}

# Execute the function
result = object_detector.execute(**input_dict)

# Access the 'detected_objects' and 'object_number' variables
detected_objects = result['detected_objects']
object_number = result['object_number']

# Extract the relevant information and assign it to the 'final_result' variable
# Note: The format of the final_result variable is not included in the given JSON, but it will be updated with the actual final_result value
final_result = {"detected_objects" : detected_objects, "object_number" : object_number}


