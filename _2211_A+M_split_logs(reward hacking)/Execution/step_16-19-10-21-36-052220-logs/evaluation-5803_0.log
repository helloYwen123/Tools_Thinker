from object_detector import Object_Detector_Tool

def calculate_desks():
    image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5803_0.png"
    labels = ["desk"]
    threshold = 0.35
    model_size = "tiny"
    save_object = True
    saved_image_path = "detected_objects"
    
    detector = Object_Detector_Tool(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    detected_objects, object_number = detector.execute()
    
    final_result = {}
    
    for label, detection_results in detected_objects.items():
        desks = len(detection_results)
        final_result[label] = desks
    
    return final_result

result = calculate_desks()
print(result)


