from text_detector import Text_Detector_Tool

def count_bench_counting(image_path, languages=['en', 'de'], details=0):
    detector = Text_Detector_Tool()
    detection_info = detector.execute(image=image_path, languages=languages, detail=details)
    # Assuming 'bench' is the key to count
    bench_count = round(detection_info[0][0][1][1] * 1.0, 2)
    return (bench_count, bench_count)

