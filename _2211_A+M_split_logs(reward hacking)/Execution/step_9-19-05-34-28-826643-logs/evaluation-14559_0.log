from_object_detector_tool import Object_Detector_Tool

def get_fridges(ceiling_image):
  """
  Uses the Object_Detector_Tool tool to detect and return fridges in the ceiling image.

  Args:
    ceiling_image (str): The path to the ceiling image for fridges detection.

  Returns:
    A list of fridges' bounding box ([x, y, x2, y2]) coordinates.
  """
  # Execute the tool to detect fridges on the ceiling.
  result = Object_Detector_Tool.execute(image=ceiling_image, labels=['fridge'])

  # Convert the result to a list of dictionary entries.
  result = result[0]
  detected_objects = result['detected_objects']
  detected_count = len(detected_objects)

  # Initialize the list to hold the fridges' bounding box information.
  fridges_bbox_list = []

  # Loop through each detected object and add its bounding box.
  for detected_object in detected_objects:
    bbox_list = [detected_object[2], detected_object[3], detected_object[4], detected_object[5]]
    fridges_bbox_list.append(bbox_list)

  return fridges_bbox_list, detected_count

