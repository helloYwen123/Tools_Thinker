from object_detector import Object_Detector_Tool as odt

def number_of_beds(image_path):
    result = odt.execute(image=image_path, labels=["bed"], threshold=0.8, save_object=True)
    object_count = {}
    for bed in result:
        if "bed" in bed["boxes"]:
            object_count[bed["text"]] = bed["boxes"]["bed"]
    return object_count

def count_beds(image_path):
    beds = number_of_beds(image_path)
    total_beds = 0
    for beds_per_label in beds.values():
        total_beds += len(beds_per_label)
    return {"total_beds": total_beds}

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13462_0.png"
bed_count = count_beds(image_path)
print(f"The scene has {bed_count['total_beds']}" if bed_count is not None else "No beds visible.")


