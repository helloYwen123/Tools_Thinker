from object_detector import Object_Detector_Tool

def count_paintings(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/1920_0.png"):
    detected_objects = Object_Detector_Tool.execute(image_path=image_path, labels=["painting"], save_object=False, saved_image_path="detected_objects")

    painting_count = {"painting": 0}
    for object in detected_objects["baseball"]:
        if object["label"] == "painting":
            painting_count["painting"] += 1

    return painting_count

paintings = count_paintings("/nfs/data8/liao/wxie/SAT/SAT_images_train/1920_0.png")
final_result = f"There are no paintings in the scene. Counted paintings: {paintings['painting']}\n"
