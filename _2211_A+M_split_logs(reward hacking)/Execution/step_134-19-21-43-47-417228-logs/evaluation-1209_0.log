from object_detector import Object_Detector_Tool
final_result = "1"

# Assume the image file is "image.jpg" and is in the dataset folder with its corresponding label "baseball"
detected_objects, object_number = Object_Detector_Tool.execute(image="image.jpg", labels=["baseball"], save_object=True)

if detected_objects:
  for label, data in detected_objects.items():
    if data["label"] == "baseball":
      if len([obj for obj in data["bbox"] if obj[1] <= 50 and obj[3] >= 100]):
        final_result += " (1)"

else:
  print("No detected baseball in the image.")

print(final_result)


