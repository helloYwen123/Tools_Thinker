from tool_object_detector import Object_Detector_Tool

# Set image path
image_path = '../SAT_images_train/6346_0.png'

# Set language code list
languages = ['en', 'de']

# Set detail level (optional)
detail_level = 0

# Initialize object detector tool
tool_object_detector = Object_Detector_Tool()
result = tool_object_detector.execute(image=image_path, languages=languages, detail=detail_level)

detected_objects = result[0]
num_objects = result[1]

# Print detected objects
for obj in detected_objects:
    print(f'Detected Object: {obj[0]}')
    print(f'Confidence: {obj[4]}')

# Print total number of detected objects
print(f'Total Number of Objects: {num_objects}')


