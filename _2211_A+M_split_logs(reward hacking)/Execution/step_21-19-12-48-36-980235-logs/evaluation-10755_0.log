from object_detector import Object_Detector_Tool

final_result = {}

# Demonstrate using 'baseball' and 'basket'
detected_objects, object_number = Object_Detector_Tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/10755_0.png", labels=['baseball', 'basket'], save_object=True)

# Check the output
for label, objects in detected_objects.items():
    for obj in objects['baseball']:
        final_result[label] = final_result.get(label, []) + [obj]

# Calculate the total count
total_objects = 0
for label in final_result:
    if final_result[label]:
        total_objects = len(final_result[label])

final_result['total_objects'] = total_objects

# Check the output again
for label, objects in detected_objects.items():
    for obj in objects['basket']:
        final_result[label] = final_result.get(label, []) + [obj]

    if objects.get('total', 0):
        total_objects = objects['total']

final_result['total_objects'] = total_objects

print(final_result)


