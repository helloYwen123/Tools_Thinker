from object_detector import Object_Detector_Tool, Text_Detector_Tool

final_result = ""

# Get detected objects
final_result += "1. Number of CounterTops: 1\n"

# Text detection
result = Text_Detector_Tool.execute(image='path/to_image.png', languages=['en', 'de'])

if result:
  detected_objects = []
  language_codes = ["en", "de"]

  for lang in language_codes:
    detected_objects.extend([f"1. {lang}: {det['image'][1]}" for det in result if lang in det['text']) 

  final_result += "2. Count of Detected Text Blocks: " + ", ".join([f"1. {lang} [{len(det['text'])}]" for lang, det in zip(language_codes, result)])

print(final_result)


