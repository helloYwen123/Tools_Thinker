  output = ot.execute(image='5220_0.png', labels=labels, save_object=save_object)

  # Initialize the final_result variable with an empty dictionary to store the results 
  final_result = {}

  # Check if a chair is detected
  if any(output:
    # Loop through the detected chairs and calculate the number
    for chair in output["chair"]:
      # Calculate the total number of detected chairs
      total_chairs = int(output["chair"][0]["object_number"]))

      # Add the chair detection number to the final_result dictionary
      final_result["chair"] = total_chairs

      print(f"A chair was detected. The number of chairs is {total_chairs}")
