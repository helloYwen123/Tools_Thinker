from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='/path/to/image.png', labels=['painting'], threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects')

if isinstance(final_result, str):
    print(final_result)
else:
    detected_objects = final_result['detected_objects']
    object_number = final_result['object_number']

    print(f"Painting detected in the image.")
    for label, detection in detected_objects.items():
        boxes = detection['box']
        scores = detection['score']
        if isinstance(label, list) and isinstance(boxes, list) and isinstance(scores, list):
            print(f"  - {label}: {' '.join([f"'{box}'" for box in boxes])} with score {np.sum(scores) * 100:.2f}%")
