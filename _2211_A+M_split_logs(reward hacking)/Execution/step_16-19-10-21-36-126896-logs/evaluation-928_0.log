if len(image) >= 6 and image[0:3] == "/nfs":
    try:
        labels = image[4:]
        save_object = True

        if save_object:
            final_result['detected_objects'] = Object_Detector_Tool().execute(image=image, labels=labels, save_object=True, saved_image_path='detected_objects')
            for label in final_result['detected_objects']:
                final_result['count'] += 1
                final_result['label'].append(label['box'])

    except Exception as e:
        final_result['count'] = 0
        final_result['label'].append(e)

