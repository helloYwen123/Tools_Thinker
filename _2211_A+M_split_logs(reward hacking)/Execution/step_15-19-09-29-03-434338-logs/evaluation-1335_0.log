from object_detector import Object_Detector_Tool

def detect_windows(image_path):
    try:
        output = Object_Detector_Tool.execute(image="path/to/image.png", labels=["Windows"], save_object=True)
        total_windows = len(output[0]['objects']) if output else 0
        
        detected_windows = {"Count": total_windows}
        for i, obj in enumerate(output[0]['objects']):
            detected_windows["Count"][obj["description"]] = obj["count"]
            
        return detected_windows
    except Exception as e:
        return {"Count": 0, "Error": str(e)}

final_result = detect_windows("/nfs/data8/liao/wxie/SAT/SAT_images_train/1335_0.png")
print(final_result)


