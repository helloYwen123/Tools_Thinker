def object_count(image_path, save_object=False, label='basket'):
    from Object_Detector_Tool import Object_Detector_Tool
    import_name: 'Object_Detector_Tool', 'Text_Detector_TOOL'
    input_types = {
        'image': image_path,
        'labels': label,
        'threshold': 0.35,
        'model_size': 'tiny',
        'save_object': save_object,
        'saved_image_path': 'detected_objects'
    }
    output_types = {
        'detected_objects': {
            'baseball': [{'box': (34, 50, 200, 220), 'score': 0.92, 'saved_image_path': 'detected_objects/image_baseball_1.png'}], 'basket': [{'box': (220, 100, 400, 350), 'score': 0.85, 'saved_image_path': 'detected_objects/image_basket_1.png'}]
        },
        'object_number': {
            'basket': 2,
            'baseball': 1
        }
    }
    result = Object_Detector_Tool.execute(image=image_path, labels=label, save_object=save_object, saved_image_path='detected_objects/empty.png')
    if result['detected_objects']:
        detected_objects = result['detected_objects'][label]
        
        if 'basket' in detected_objects:
            detected_objects['basket'] = len(detected_objects)
        else:
            detected_objects['baseball'] = len(detected_objects)
        return output_types['detected_objects']
    else:
        return output_types['object_number']


