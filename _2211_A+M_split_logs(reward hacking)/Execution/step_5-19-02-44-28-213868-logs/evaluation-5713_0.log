from object_detector import Object_Detector_Tool

model_size = 'base'
threshold = 0.35
save_object = False
saved_image_path = "detected_objects"

# Assuming image_path is defined and contains the file path
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5713_0.png'

# Execute the object detection
result = Object_Detector_Tool.execute(image_path=image_path,
                                      labels=['basball', 'basket'],
                                      save_object=save_object,
                                      saved_image_path=saved_image_path,
                                      model_size=model_size,
                                      threshold=threshold)

# Extract detected results
detected_objects = result[0]
object_numbers = result[1]

final_result = {
    'dresses': 1
} if detected_objects and object_numbers else None

if final_result is not None:
    final_result = {
        **detected_objects,
        'total_objects': len(detected_objects) + len(object_numbers),
        'total_labels': 1 + object_numbers,
    }

print(final_result)


