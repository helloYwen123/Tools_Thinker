from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

final_result = "4"

# Import the object detector tool
obj_detector_tool = Object_Detector_Tool()

# Ensure we have the necessary labels
labels = ["chess"]

# Set the confidence threshold
confidence_threshold = 0.35

# Set the save object flag
save_object = True

# Set the path to save the detected objects as images
saved_image_path = "detected_objects"

# Detect objects in the scene
detected_objects, object_number = obj_detector_tool.execute(image="image.png", labels=labels, confidence_threshold=confidence_threshold, save_object=save_object, saved_image_path=saved_image_path)

# Output the results
for object in detected_objects:
    final_result += " " + str(object_number) + ". " + f"Detected object: {object[0]}" + "\n"

# Print the final result
print(final_result)


