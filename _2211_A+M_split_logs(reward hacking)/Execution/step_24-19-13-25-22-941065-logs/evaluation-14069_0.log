from object_detector import Object_Detector_Tool

final_result = {}
num_doors = 0

# Detect objects in the scene
detected_objects = Object_Detector_Tool.execute(image='path/to/image.png', labels=['door'], save_object=True, saved_image_path='detected_objects')

for label, boxes in detected_objects.items():
    if label == 'door':
        num_doors += len(boxes)

final_result['num_doors'] = num_doors
final_result['num_objects'] = num_doors + len(detected_objects['baseball']) + len(detected_objects['basket'])

print(f"Number of doors: {final_result['num_doors']}")
print(f"Number of objects in the scene: {final_result['num_objects']}")


