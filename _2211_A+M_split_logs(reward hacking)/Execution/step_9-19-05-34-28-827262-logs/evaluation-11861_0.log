from object_detector import Object_Detector_Tool

def count_objects(image_path, labels=["baseball", "basket"], save_object=False, saved_image_path="detected_objects"):
    if save_object:
        det_objects = Object_Detector_Tool.execute(image_path=image_path, labels=labels, save_object=True, saved_image_path= saved_image_path)
    else:
        det_objects = Object_Detector_Tool.execute(image_path=image_path, labels=labels, threshold=0.35)

    total_count = {}
    detected_objects = det_objects[0]
    for obj_key, obj_list in detected_objects.items():
        count = 0
        for obj_dict in obj_list:
            if obj_dict.get("score", -1) - 0.05 < 0:
                continue
            key = f"{obj_key}: {len(obj_dict)}"
            total_count[key] = 1 + total_count.get(key, 0)
            count += 1
        total_count[f"{obj_key}-count"] = count

    return {"detected_objects": detected_objects, "total_count": total_count}

# provided image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11861_0.png"

# execute the object detector tool
result = count_objects(image_path=image_path, labels=["baseball", "basket"], language_codes=["en", "de"], detail=0)
print(result)


