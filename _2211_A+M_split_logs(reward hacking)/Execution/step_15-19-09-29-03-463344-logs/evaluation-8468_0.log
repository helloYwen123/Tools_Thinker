def count_fridges(image_path, languages='ch_sim', detail=1):
    try:
        detection_output = Text_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
        fidge_details = []
        for text_block in detection_output:
            text = text_block[2]
            if "fridge" in text:
                total_fridge = text_block[-1][1]
                fidge_details.append({"text": text, "total_fridge": total_fridge})
        return fidge_details
    except Exception as e:
        return [{"text": "Error", "total_fridge": 0}]

final_result = count_fridges('/nfs/data8/liao/wxie/SAT/SAT_images_train/8468_0.png')
printFINAL_RESULT = [final_result[0]] + [(e["text"], e["total_fridge"]) for e in final_result[1]]
