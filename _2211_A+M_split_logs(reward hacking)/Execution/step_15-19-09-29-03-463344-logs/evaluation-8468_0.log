from object_detector import Object_Detector_Tool

class Kitchen:
    def __init__(self, image_path):
        self.image = Image.open(image_path)
        self.object_labels = ["fryer", "fridge"]
        self.laptop_labels = []
        self.threshold = 0.35
        self.save_object = False
        self.object_number = {}
        self.detected_objects = {}

    def execute(self, image_path, labels, save_object=True, saved_image_path="detected_objects"):
        """Dectects objects in a particular object labels, saves detected objects as images, and returns their counts."""
        tool = Object_Detector_Tool()
        result = tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size="tiny")
        for obj, detected_results in result["detected_objects"].items():
            try:
                object_count = self.object_number.get(obj, 0) + detected_results["object_number"]
                self.object_number[obj] = object_count
            except ValueError:
                self.laptop_labels.append(obj)
        return result


# Sample Use
kitchen = Kitchen('/nfs/data8/liao/wxie/SAT/SAT_images_train/8468_0.png')
detected_results = kitchen.execute(image_path='/nfs/data8/liao/wxie/SAT/SAT_images_train/8468_0.png', labels=['fryer', 'fridge'], save_object=True)
print(detected_results)
print(kitchen.object_number)

finally:
    tool.disconnect()


