    labels = ['bed', 'drawer']
    save_object = True
    saved_image_path = 'detected_objects'

    objects = Object_Detector_Tool.execute(image_path, labels=labels, threshold=0.7, save_object=save_object, saved_image_path=saved_image_path)

    if objects and objects[0][1]:  # Check if any detected objects were found
        bed_count = len([object.name for object in objects[-1].values() if object.label == 'bed'])
        return f"1 bed visible in the room."
    else:
        return f"0 beds visible in the room."

