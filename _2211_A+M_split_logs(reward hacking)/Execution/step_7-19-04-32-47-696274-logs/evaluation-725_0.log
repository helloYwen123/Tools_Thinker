from object_detector import Object_Detector_Tool

def calculate_counter_top():
    detected_objects = Object_Detector_Tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/725_0.png", labels=["CounterTop"], save_object=True, saved_image_path="detected_objects")

    counter_top_detected = 0

