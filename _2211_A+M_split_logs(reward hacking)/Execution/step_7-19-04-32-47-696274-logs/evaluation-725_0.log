from object_detector import Object_Detector_Tool

demofile = '/nfs/data8/liao/wxie/SAT/SAT_images_train/725_0.png'
object_labels = ['baseball', 'basket']
object_threshold = 0.35

# Detect all interest-objects and save them to images
detected_objects, object_number = Object_Detector_Tool.execute(image=demofile, labels=object_labels, saved_image_path='detected_objects')

# Extract the number of each detected object and sorted it by object_name
total_objects = object_number['baseball'] + object_number['basket']
total_object_names = set(detected_objects[0]['Object_Name'])

object_count = {}
for obj in total_object_names:
    objects = []
    for det in detected_objects[0]['Object_Ids']:
        if det['Object_Name'] == obj:
            objects.append(det['Object_Name'])
    object_count[obj] = len(objects)
print("Total number of detected objects: ", total_objects)
print("Detected objects and number of detections: ")
for obj in total_object_names:
    if objects := object_count.get(obj):
        print(f"Object name: {obj.upper()[:3].center(5)} {objects}, Number of detections: {objects}")


