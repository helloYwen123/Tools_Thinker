from object_detector import Object_Detector_Tool

def count_doorways(image_path="image.png"):
    # Initialize the tool
    tool = Object_Detector_Tool()

    # Detect doorways in the image
    doorways = tool.execute(image=image_path, labels=['door', 'doorway'], save_object=False)

    # Return the count of doorways detected
    return len(doorways)

