from object_detector import Object_Detector_Tool

def count_objects(image_path, labels, save_object=False, saved_image_path="detected_objects"):
    model_size = "tiny"
    languages = ["en", "de"]
    try:
        detector = Object_Detector_Tool(image=image_path, languages=languages, save_object=save_object, saved_image_path=saved_image_path)
        detections = detector.execute()
        if "baseball" in detections and "basket" in detections:
            number_of_basball = len(detections["baseball"])
            number_of_basket = len(detections["basket"])
            return {
                "detections": {
                    "total": round(len(detections["baseball"]) + len(detections["basket"])),
                    "baseball": number_of_basball,
                    "basket": number_of_basket
                }
            }
        return None
    except:
        print("Text detection failed.")
        return None

if __name__ == "__main__":
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13959_0.png"
    labels = ["baseball", "basket"]
    detected_objects = count_objects(image_path=image_path, labels=labels)
    if detected_objects:
        print("Detected objects:")
        print(detected_objects)
    else:
        print("No objects detected.")


