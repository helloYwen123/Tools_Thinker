from object_detector import Object_Detector_Tool, Text_Detector_Tool

def count_shelving_units(image_path):
    # Parse command line arguments
    labels_input = [label.strip() for label in input().split(",")]
    labels = [int(label.split("_")[0]) for label in labels_input]
    
    # Detect objects
    detector_tool = Object_Detector_Tool()
    detected_objects = detector_tool.execute(image_path=image_path, labels=labels, threshold=0.35, model_size="tiny")
    
    # Count objects
    object_detection_count = {label: 0 for label in set(detected_objects['objects']).intersection(set(detected_objects['labels'])).union((1, 2)),}
    for det in detected_objects['objects']:
        object_detection_count[det['id']] += 1
    
    # Convert object detection count to dictionary
    object_detection_count['total'] = len(object_detection_count)
    
    # Count shelves in a realistic way, considering the number of entities on each shelf
    shelves_value = 0
    
    for entity_name in set(detected_objects['labels']):
        total_boxes = len(detected_objects['objects'][entity_name])
        total_values = len(detected_objects['objects'][entity_name]['detected'])

        # Calculate shelf value
        shelves_value += (total_value - total_boxes * 2) * detected_objects['objects'][entity_name]['scorer'] / total_boxes
    shelves_value *= len(detected_objects['labels']) / 2
        
    return shelves_value, len(detected_objects['labels'])
