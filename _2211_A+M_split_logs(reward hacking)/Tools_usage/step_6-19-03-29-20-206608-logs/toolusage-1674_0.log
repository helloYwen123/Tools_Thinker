from object_detector import Object_Detector_Tool

def count_objects_in_image(image_path, labels=[], language='en', detail=1):
    object_detector_tool = Object_Detector_Tool(image_path, labels=labels, language=language, detail=detail)
    detected_objects = object_detector_tool.execute()
    
    if detected_objects:
        object_number = {label: len(detected_objects[0]) for label, detected_objects_list in detected_objects.items()}
        return (detected_objects, len(detected_objects))
    else: 
        return ([])  # No detected objects found. Try Retry on other images.

# Call the function with the given path and language
result = count_objects_in_image(image_path, labels=['baseball', 'basket'], language='en', detail=0)
detected_objects, object_number = result

if not detected_objects:
    print("Could not find any baseballs or balls in the image.")
else:
    for label in detected_objects:
        print(f"Found {Object_Detector_Tool.get_object_number(label)} objects of label '{label}'.")
        if 'basket' in label:
            print("Basket found:", {label: Object_Detector_Tool.detect_key_points(detected_objects, label)}]

    print(f"Total number of objects detected: {sum(object_number.values())}")
```
This script uses the `Object_Detector_Tool` module to detect objects in the provided image file with the specified languages. It will return the number of objects of each label found in the detected objects, or an empty list if no objects are detected. Then it will print the total number of objects detected and their coordinates, if any.
