from object_detector import Object_Detector_Tool

def count_tv_stands(image_path):
    tool = Object_Detector_Tool()
    tool.image = image_path
    labels = ["tv_stand", "dining_courty", "bed", "chair"]
    tool.labels = labels
    threshold = 0.35
    model_size = "tiny"
    
    if tool.execute(save_object=True, saved_image_path="tv_stands")["detected_objects"]:
        total_tv_stands = len(tool.execute(save_object=True, saved_image_path="tv_stands"))["object_number"]["tv_stand"]
        total_dining_courty = len(tool.execute(save_object=True, saved_image_path="dining_courty"))["object_number"]["dining_courty"]
        total_bed = len(tool.execute(save_object=True, saved_image_path="bed"))["object_number"]["bed"]
        total_chair = len(tool.execute(save_object=True, saved_image_path="chair"))["object_number"]["chair"]
        return {"tv_stands": total_tv_stands, "dining_courty": total_dining_courty, "bed": total_bed, "chair": total_chair}
    else:
        return {"tv_stands": 0, "dining_courty": 0, "bed": 0, "chair": 0}

