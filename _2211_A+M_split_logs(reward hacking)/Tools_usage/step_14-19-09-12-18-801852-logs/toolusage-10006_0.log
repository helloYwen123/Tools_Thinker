from object_detector import Object_Detector_Tool

class RoomObjectDetector:
    def countObjects(self, object_list):
        """
        Counts and returns the number of detected objects in the given list.
        :param object_list: List of detected objects (strings or tuples).
        :return: int - The total number of objects detected in the image.
        """
        object_count = {}
        for obj_data in object_list:
            obj_type, box, score = obj_data
            if obj_type in object_count:
                object_count[obj_type] += 1
            else:
                object_count[obj_type] = 1
        return len(object_count)

    def detectTVStands(self, image_path, labels, save_object=True):
        """
        Detect TV Stands in an image using the provided labels and save data.
        :param image_path: str - The path to the image file.
        :param labels: list of strings - The labels to detect in the image.
        :param save_object: bool - Whether to save the detected objects as images.
        """
        objects = self.detect_object(image_path, labels, save_object)
        if objects:
            top_left, bottom_right, total_objects_count = objects[0]
            first_obj, last_obj = objects[1], objects[2]
            return (total_objects_count, objects, first_obj, last_obj)

    def detect_object(self, image_path, languages, detail=0):
        """
        Detects objects in the image.
        :param image_path: str - The path to the image file.
        :param languages: List of language codes to be used for OCR.
        :param detail: int - The level of detail of OCR output (0 or 1).
        """
        return self.text_detector.execute(image=image_path, languages=languages, detail=detail)

