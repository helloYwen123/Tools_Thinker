from object_detector import Object_Detector_Tool

def calculate_objects(image_path: str, labels: List[str], save_object: bool, saved_image_path: Optional[str] = None) -> Optional[dict]:
    detected_objects, object_count = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    if not detected_objects:
        return None
    
    object_info = {label: [] for label in detected_objects.keys()}
    
    for detected_label, details in detected_objects.items():
        for detection in details:
            if save_object:
                det_confidence = detection.get('score')
                saved_path = f'detected_objects/{det_label}_{det_confidence}_{saved_image_path}.jpg'
                saved_image = Image.open(saved_path).convert('RGBA')
                cropped_image = Image.new('RGB', (detection['box'][2] - detection['box'][0] + 1, detection['box'][3] - detection['box'][1] + 1), (0, 0, 0, 0))
                cropped_image.paste(saved_image, detection['box'])
                cropped_image.save(saved_path)
            object_info[det_label].append({'box': detection['box'], 'score': det_confidence, 'saved_image_path': saved_image_path})
    
    if object_count == 0:
        detected_objects = None
    
    return (object_info, object_count)

