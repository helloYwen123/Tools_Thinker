for key in detected_objects:
    if key not in object_number:
        total += 1
result = [[[detected_objects[key][0][0], detected_objects[key][0][1], detected_objects[key][0][2], detected_objects[key][0][3]],
           key, total]]
for key in object_number:
    detected_obj = object_detector_tool.execute(image_path="detected_objects", labels=[key],
