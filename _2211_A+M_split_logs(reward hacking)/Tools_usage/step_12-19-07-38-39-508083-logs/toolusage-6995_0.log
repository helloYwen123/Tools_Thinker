from object_detector import Object_Detector_Tool

def count_paintings():
    # Provided image path
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6995_0.png"

    # Possible labels, including "painting" in your case
    labels = ["painting"]

    # Confidence threshold
    threshold = 0.35

    # Size of the model to use ('tiny' or 'base')
    model_size = "tiny"

    # Path to save the detected objects images
    saved_image_path = "detected_objects"

    # Try-count and save with specified details
    retry = 1
    saved_objects = []

    for _ in range(retry):
        try:
            object_dict = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path=saved_image_path)
            for label in object_dict:
                if label.get('saved_image_path') is not None:
                    saved_objects.append(object_dict[label.get('saved_image_path')])

            break
        except Exception as e:
            print(f"Error occurred with label {label.get('label_num')}: {e}")

    if len(saved_objects) >= 2:
        print(f"Total paintings found: {len(saved_objects)}")
    else:
        print("No paintings found.")

