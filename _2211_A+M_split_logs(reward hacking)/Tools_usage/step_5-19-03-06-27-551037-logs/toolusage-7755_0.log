from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_paintings_in_image(image_path):
    # Load the image using OpenCV
    import cv2
    image = cv2.imread(image_path)

    # Perform object detection
    detected_objects = Object_Detector_Tool.execute(image=image, labels=["painting"], threshold=0.35)

    # Count the detected paintings
    painting_count = sum((obj.get("saved_image_path") is not None and obj.get("label") == "painting") for obj in detected_objects['baseball'])

    return painting_count

def analyze_text(image_path, languages=["en"]) -> list:
    # Load the image using OpenCV
    import cv2
    image = cv2.imread(image_path)

    # Perform text detection using EasyOCR
    text_result = Text_Detector_Tool.execute(image=image)
    text_blocks = text_result[0]

    for block in text_blocks:
        if block["translated_text"] and block["language_code"] in languages:
            yield block

def extract_text(image_path):
    # Load the image using OpenCV
    import cv2
    image = cv2.imread(image_path)

    for blocks in analyze_text(image_path, languages=["en", "de"]):
        for block in blocks:
            yield block

# Example usage
image_path = "path_to_image.png"

painting_count = count_paintings_in_image(image_path)
print(f"Number of paintings: {painting_count}")
```
