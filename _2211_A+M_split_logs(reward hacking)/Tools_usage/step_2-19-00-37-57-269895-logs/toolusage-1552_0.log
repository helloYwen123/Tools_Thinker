import os
from io import BytesIO
from PIL import Image
from easyocr import Reader

def count_objects_in_image(image_path, languages=['en', 'de'], detail=1):
    result = []
    try:
        image = Image.open(BytesIO(os.read(image_path, os.fstat(image_path).st_size)))
    except TypeError:
        return []

    text_data = []
    for lang in languages:
        for _ in range(3):
            try:
                text_data_str = read_text(image, lang, detail)
                texts = text_data_str.splitlines()
                for text in texts:
                    result.append([text, os.path.join(languages.index(lang), language), float(text_data_str.split('"')[1]+str(text)[0:3])])
                break
            except Exception as e:
                if 'TimeoutSlews' in str(e):
                    continue
                raise e

    return result

def read_text(image_path, language, detail=0):
    reader = Reader()
    for result in reader.read(image_path, language=language, lines=1):
        if len(result) == 0:
            break
        if len(result) > detail:
            word, confidence = result
            if confidence >= 0.5:
                return (word, image_path)
    return []

def count_objects(image_path, languages=['en', 'de'], detail=1):
    objects = count_objects_in_image(image_path, languages, detail)
    return objects

