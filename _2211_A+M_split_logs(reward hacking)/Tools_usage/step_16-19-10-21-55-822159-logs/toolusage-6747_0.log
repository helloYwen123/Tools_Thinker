from tool_object_detector import Object_Detector_Tool

final_result = {
    "Count of Doorways": 0
}

def detect_door_path(image_path):
    import_image = Image.open(image_path)
    object_detector = Object_Detector_Tool()
    object_result = object_detector.execute(image=import_image, labels=["Door"], save_object=True)
    for object_detection in object_result['detected_objects']:
        if object_detection['box'][0] < 1 and object_detection['box'][1] < 1 and object_detection['box'][2] > 100 and object_detection['box'][3] > 100:
            final_result["Count of Doorways"] += 1
            return True
    return False

if detect_door_path('path/to/image.png'):
    final_result['Count of Doorways'] = 1
else:
    final_result['Count of Doorways'] = 0


final_result

