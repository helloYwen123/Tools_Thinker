from tool_object_detector_tool import Object_Detector_Tool

def count_doorways():
    detected_images = Object_Detector_Tool.execute(image='6747_0.png', labels=['door', 'window'])

    door_count = {}
    window_count = 0

    for label, bounding_boxes in detected_images['object_number'].items():
        if label == 'door':
            door_count[label] = len(bounding_boxes)

    return door_count

final_result = count_doorways()
