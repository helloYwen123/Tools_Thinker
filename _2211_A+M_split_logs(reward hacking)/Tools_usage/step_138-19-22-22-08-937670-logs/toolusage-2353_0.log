from object_detector.Object_Detector_Tool import Object_Detector_Tool

final_result = "1"

with open("/nfs/data8/liao/wxie/SAT/SAT_images_train/2353_0.png", "r") as image_file:
    content = image_file.read()

    detector = Object_Detector_Tool()
    results = detector.labels(content, save_object=True)

    if results.success:
        if results.labels[0].get('baseball'):
            final_result = "1"
        elif results.labels[0].get('basket') or results.labels[-2].get('basket') or results.labels[-1].get('baseball'):
            final_result = "2"
    else:
        print("Text detection failed.")

