def calculate_dressers(image_path):
    # Load the image and perform object detection
    image = Image.open(image_path)
    results = Object_Detector_Tool.execute(image=image_path)

    # Count the number of dressers
    dresser_count = 0
    for result in results["detected_objects"]:
        if result["label"] == "baseball" and result["score"] >= 0.5:
            dresser_count += 1
            if "saved_image_path" in result and "baseball" not in dresser_count:
                dresser_count += 1
                path = result["saved_image_path"]
                return f"The image contains another {dresser_count} dresser."

            elif "basket" not in dresser_count:
                dresser_count += 1
                return f"The image contains another {dresser_count} dresser."

    return f"No dresser detected in the image."

# Example usage
