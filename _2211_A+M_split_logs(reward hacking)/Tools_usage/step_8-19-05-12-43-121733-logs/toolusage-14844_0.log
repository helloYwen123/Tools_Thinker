from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels=[['baseball'], ['basket']], save_object=True, saved_image_path="detected_objects"):
    try:
        object_dct = Object_Detector_Tool(image_path, labels, threshold=0.35, model_size="tiny", save_object=save_object, saved_image_path=saved_image_path)
        final_result = object_dct.output_types[0]
        detected_objects = final_result["detected_objects"]
        for i in range(len(detected_objects)):
            detected_objects[i]["saved_image_path"] = saved_image_path + "/detected_objects_" + str(i) + ".png"
        return final_result
    except Exception as e:
        print("Error:", str(e))
        return None

# Example usage
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/14844_0.png"
result = detect_objects(image_path)
print("Detected objects:", result)
```
