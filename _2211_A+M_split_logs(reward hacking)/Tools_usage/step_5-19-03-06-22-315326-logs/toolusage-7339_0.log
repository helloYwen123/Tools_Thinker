def generate_text_area(image_file_path, languages=["en", "de"]):
    # This function takes the image file path and a list of language codes
    # and returns a list of detected text blocks with their bounding box coordinates, confidence score (float), and recognized text.
    result = []
    # Load image using OpenCV
    cap = cv2.VideoCapture(image_file_path)
    # Calculate frame rate (1 fps) by dividing frame rate (10 fps) by 100
    fps = cap.get(cv2.CAP_PROP_FPS)
    # Initialize OpenCV and font
    cv2.InitOpenCVLogging()
    cv2.InitOpenCVD()
    font = cv2.FONT_HERSHEY_SIMPLEX
    # Use EasyOCR
    easyocr = image_detection.EasyOCR()
    # Extract text lines
    text_lines = easyocr.splitTexts(image_path=image_file_path)
    # Detect text in text lines
    for text_line in text_lines:
        detected_text_lines = easyocr.detect(text_line)
        for text_line_i in detected_text_lines:
            bounding_boxes = easyocr.text_to_boxes(text_line_i)
            # Calculate bounding box and box area
            box = bounding_boxes[0][0][::-1]
            area = sum(box[0][1] * box[0][2])
            # Print bounding box and box area
            print(f"Bounding box: {bbox_to_boxes(box, 0.35)}")
            print(f"Bounding box area: {area}")
            # Detect text
            text = str(easyocr.find_text(text_line_i))[:text_line_i.index('.')]
            if text != "":
                # Return detected text blocks with their bounding box coordinates, confidence score (float), and recognized text
                detected_text_line_i = [[box, text, 0.95], [f"Detected text", text, 0.95]]
                result.append(detected_text_line_i)
    # Release OpenCV
    cap.release()
    return result

