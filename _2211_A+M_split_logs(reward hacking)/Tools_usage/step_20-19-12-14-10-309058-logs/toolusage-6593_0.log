from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], threshold=0.35, model_size='base', save_object=False)

if final_result[0][1] == 1:
    object_dict = OrderedDict({
        'baseball': ({}), 'basket': ({}),
    })
    for labels, result in sorted(final_result[0][0].items(), key=lambda t: t['box']):
        if labels in object_dict and 'baseball' in labels:
            i = 1
        else:
            i = 0
        if 'basket' in labels:
            if 'baseball' in labels:
                i += 1
        else:
            object_dict[labels][0][i] = {'box': result[2], 'score': result[1], 'saved_image_path': None}
    print(object_dict)
else:
    print("No objects detected in the image.")

