from object_detector import Object_Detector_Tool

final_result = {
    "count": 2,
    "detected_items": {}
}

try:
    image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6593_0.png"
    labels = ["baseball", "basket"]
    save_object = True
    saved_image_path = "detected_objects"
    
    detector_tool = Object_Detector_Tool(image=image, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    
    object_results = detector_tool.execute()
    
    for label, result in object_results.items():
        found = False
        for item in result["detected_objects"]:
            if item["label"] == label:
                found = True
                break
            
        if found:
            detected_items = {"baseball": len(result["detected_objects"]), "basket": len(result["detected_objects"]), "total": result["detected_objects"].count()}
            final_result["count"] = detected_items["total"]
            final_result["detected_items"] = detected_items
        else:
            final_result["detected_items"] = {}
except Exception as e:
    print(f"Error occurred {e}")
finally:
    return final_result

============================== END ==============================


