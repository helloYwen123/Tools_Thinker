python
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_beds(image_path):
    print("Detecting beds...")
    detector = Object_Detector_Tool(tool_version='1.0.0', input_types={'image': image_path, 'labels': ['baseball', 'basket', 'bed'], 'save_object': True, 'threshold': 0.35})
    detected_objects = detector.execute()

    print(f"Total detected beds: {len(detected_objects)}")

    print("Counting beds...")
    bed_count = 0
    for obj in detected_objects:
        obj_name = obj['object_name']
        if obj_name == 'baseball':
            bed_count += 1
        elif obj_name == 'basket':
            bed_count += 2

    print(f"Total beds: {bed_count}")

if __name__ == '__main__':
    print("Please provide the path to the image file to count beds.")
    image_path = input("File: ")
    if image_path:
        count_beds(image_path)
    else:
        print("No file provided to count beds.")

