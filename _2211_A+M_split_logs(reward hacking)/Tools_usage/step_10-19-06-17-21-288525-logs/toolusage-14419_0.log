from object_detector import Object_Detector_Tool

# Load the image file path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/14419_0.png"

# Define object labels to detect
labels = ['baseball', 'basket']

# Set the confidence threshold for detection
confidence_threshold = 0.35

# Set the model size to 'small'
model_size = 'small'

# Set whether to save the detected objects as images
save_image = False

# Set the directory to save the detected object images
saved_image_directory = "detected_objects"

# Create an instance of the object_detector tool
detect_object_tool = Object_Detector_Tool(image_path=image_path, labels=labels, save_image=save_image, saved_image_path=saved_image_directory)

# Detect objects
object_annotations = detect_object_tool.execute(labels=labels, threshold=confidence_threshold, model_size=model_size)

# Check if detection failed after retries
if object_annotations is None:
    print("Text detection failed after retries.")
else:
    # Extract detected objects information
    detected_objects_info = []
    for label, detections in object_annotations.items():
        detected_objects_info.extend(detections)

    # Extract object number
    object_number = len(detected_objects_info)

    # Create a dictionary to store object information
    object_info_dict = {}

    # Store the detected objects in a list
    detected_objects = []
    detected_objects_info = detected_objects_info[0].get('detected_objects')

    for detected_object in detected_objects_info[0].get('detected_objects'):
        detected_objects.append(detected_object.get('bbox'))

    # Loop through the detected objects
    for i, detected_object in enumerate(detected_objects):
        obj_name = detected_object['bbox'][0][0].split(',')[-1]  # Extract the object name
        obj_info = object_info_dict.get(obj_name, [])
        obj_info.append(detected_object)
        object_info_dict[obj_name] = obj_info

    # Print detected objects information
    print("Object Names:", object_info_dict.keys())
    print("Detected Objects:", object_info_dict.values())
    print("Object Number:", object_number)

