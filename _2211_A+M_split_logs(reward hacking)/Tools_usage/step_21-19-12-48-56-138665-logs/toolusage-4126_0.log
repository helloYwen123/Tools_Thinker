from Object_Detector_Tool import Object_Detector_Tool

# Define threshold for object detection
threshold = 0.5

# Define model size
model_size = "tiny"

# Execute object detection
detected_objects = Object_Detector_Tool.execute(
    image="/nfs/data8/liao/wxie/SAT/SAT_images_train/4126_0.png",
    labels=["baseball", "basket"],
    save_object=True,
    saved_image_path="detected_objects",
    threshold=threshold,
    model_size=model_size
)

final_result = {"total_objects": len(detected_objects)}
for label, detection in detected_objects.items():
    object_number = len(detection)
    final_result[label] = object_number

print(final_result)

