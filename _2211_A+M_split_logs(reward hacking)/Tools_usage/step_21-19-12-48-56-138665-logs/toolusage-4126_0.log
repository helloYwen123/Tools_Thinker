from object_detector import Object_Detector_Tool

final_result = {}
final_result['total_dressers'] = 0

# Path given in question
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4126_0.png"

# Try to load the image
try:
    loaded_image = Image.open(image_path)
except Exception as e:
    print(f"Failed to load image: {e}")
    return None

# Detect objects
object_results = Object_Detector_Tool.execute(image=loaded_image.image, labels=[], threshold=0.25)

if object_results:
    # Check if there are multiple dresser objects
    if len(object_results[0]['object_list']) == 0:
        final_result['total_dressers'] = 0
    else:
        # Print total dresser count
        final_result['total_dressers'] = len(object_results[0]['object_list'])

if final_result['total_dressers'] == 0:
    final_result['no_dressers_found'] = True
else:
    final_result['total_dressers'] = len(object_results[0]['object_list'])

# Output final result
print(final_result)

