from object_detector import Object_Detector_Tool

# Define the command to execute the tool
command = "Object_Detector_Tool.execute(image='path/to/image.png', labels=['tv_stand'], save_object=True, saved_image_path='detected_objects')"

# Run the command
result = Object_Detector_Tool.execute(command=command)

# Extract the information from the output
if 'detected_objects' in result:
    detected_objects = result['detected_objects']
    total_objects = result['object_number']
else:
    detected_objects = []
    total_objects = {}

# Determine the number of TVStands
if detected_objects and 'tv_stand' in detected_objects[0] and result['detected_objects'][0]['label'] == 'tv_stand':
    total_tv_stands = detected_objects[0]['label'][0]
else:
    total_tv_stands = 0

final_result = {'total_tv_stands': total_tv_stands}
final_result.update(result)

print(final_result)

