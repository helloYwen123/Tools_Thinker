from object_detector import Object_Detector_Tool

result = Object_Detector_Tool.execute(image='/nfs/data8/liao/wxie/SAT/SAT_images_train/12667_0.png', languages=['en', 'de'], detail=1)
detected_objects, object_number = result

if detected_objects:
    total_baseball = detected_objects['baseball'][0]['box'][2][2] - detected_objects['baseball'][0]['box'][0][0]
    total_basket = detected_objects['basket'][0]['box'][2][2] - detected_objects['basket'][0]['box'][0][0]

    final_result = {"total_baseball": total_baseball, "total_basket": total_basket}
    final_result = {k: {"baseball": len(detected_objects['baseball']), "basket": len(detected_objects['basket'])} for k in object_number.keys()}

    final_result = {"total_baseball": int(total_baseball), "total_basket": int(total_basket), "total_objects": int(detected_objects[0]['box'][2][2])} if final_result else {}
else:
    final_result = {}

