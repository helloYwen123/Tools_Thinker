import object_detector

def count_doorways_in_room(input_image_path, labels, save_image_path=True):
    detected_objects = object_detector.execute(image=input_image_path, labels=labels)
    doorways_count = {}
    for label in detected_objects.keys():
        if label == 'garage_door':
            doorways_count[label] = detected_objects[label][0]['boxed'].count(1)
    final_result = {'1': doorways_count}
    saved_image_path = save_image_path if save_image_path else f'detected_objects/{label}.png'
    if save_image_path:
        object_detector.save_object(image=f'detected_objects/{label}.png', detected_object=final_result)
    return final_result

# Example usage
input_image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/1615_0.png'
labels = ['baseball', 'basket']
count_doorways = count_doorways_in_room(input_image_path, labels)
print(count_doorways)
