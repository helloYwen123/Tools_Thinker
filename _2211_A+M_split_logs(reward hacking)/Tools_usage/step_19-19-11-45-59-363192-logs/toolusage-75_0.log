def count_dining_tables(image_path):
    try:
        object_detection_command = "detected_objects, object_number = Object_Detector_Tool.execute(image={image_path}, labels=['Dining Table'], save_object=True, saved_image_path='dining_tables')".format(image_path=image_path)
        object_detection_output = eval(object_detection_command)
        dining_tables = object_detection_output["detected_objects"]
