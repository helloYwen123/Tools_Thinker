import subprocess

def detect_objects(image_path, labels=['baseball', 'basket'], threshold=0.35, save_object=True, saved_image_path='detected_objects'):
    """
    Detects 'baseball' and 'basket' in the image.
    Returns a tuple: (1) a dict mapping each label to a list of detection results (each with box, score, and optionally saved image path);
     (2) a dict with the total count for each detected label.
    """
    command = "detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, save_object=save_object, saved_image_path=saved_image_path)"
    try:
        subprocess.run(command, shell=True)
        results = subprocess.check_output(command, shell=True).decode().strip().splitlines()
        detected_objects = dict()
        object_number = {}
        for line in results:
            if 'baseball' in line:
                obj_type, box, score = line.split(' ')
                detected_objects[obj_type] = [{'box': box.split(' '), 'score': float(score)}, 'baseball']
            elif 'basket' in line:
                obj_type, box, score = line.split(' ')
                detected_objects[obj_type] = [{'box': box.split(' '), 'score': float(score)}, 'basket']
            object_number[obj_type] = detected_objects[obj_type][1][0]
        return detected_objects, object_number
    except Exception as e:
        print(f"Detecting objects failed: {e}")
        return None, None

# Example usage
detected_objects, object_number = detect_objects('/nfs/data8/liao/wxie/SAT/SAT_images_train/1750_0.png')
print(detected_objects)
print(object_number)
```
