from object_detector import Object_Detector_Tool

def count_objects_in_image(image_path, labels=None):
    """
    Counts and locates objects in an image using object detection.
    
    Parameters:
    - image_path: str - The path to the image file.
    - labels: list - A list of object labels to detect (default: ['baseball', 'basket']).
    
    Returns:
    - detected_objects: dict - A dict mapping each label to a list of detection results (each with box, score, and optionally saved image path).
    - object_number: dict - A dict with the total count for each detected label.
    """
    # Detect objects in the image.
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels)
    
    # Calculate object count.
    object_number = {
        label: detected_objects.get('baseball', 0) + detected_objects.get('basket', 0)
        for label in labels
    }
    box_result = []
    
    for detection_entry in detected_objects.get('bbox_results'):
        # Add box information to the result list.
        if 'score' in detection_entry:
            score = detection_entry['score']
            if score > 0.3:
                box_result.append((int(detection_entry['bbox'][0]), int(detection_entry['bbox'][1]), int(detection_entry['bbox'][2]), int(detection_entry['bbox'][3])))
                # Save box information for each label.
                object_number[detection_entry['label']] += 1
    
    if object_number and len(image_path.split('/')) < 2:
        saved_objects = Object_Detector_Tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True)
        # Write boxes as images.
        for label in object_number:
            if saved_objects:
                # Copy box information.
                result_box = saved_objects.get('bbox_results', []).copy()
                # Write bbox to file.
                for result in result_box:
                    result_box[0] = '{},{}'.format(*result_box[0])
                result_path = image_path.replace('.png', f'_{label}_box.png')
                with open(result_path, 'w') as f:
                    f.write('\n'.join(result_box))
    
    detected_objects, object_number
```

Note: This script assumes the existence of a module named "object_detector", with the needed classes and functions. It also assumes the script being run
