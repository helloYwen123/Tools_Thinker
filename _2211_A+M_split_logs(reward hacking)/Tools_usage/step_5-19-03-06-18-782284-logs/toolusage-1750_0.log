from object_detector import Object_Detector_Tool

def calculate_boxes(image_path="1750_0.png"):
    object_detector_tool = Object_Detector_Tool()
    labels = ["box", "ball"]
    object_detector_tool.tool_class_name = "Object_Detector_Tool"
    object_detector_tool.input_types = {"image": image_path, "labels": labels}
    object_detector_tool.save_object = True
    object_detector_tool.saved_image_path = "detected_objects/boxes"
    object_detector_tool.max_retries = 10 # Set maximum retries
    object_detector_tool.threshold = 0.35 # Set threshold for detection

    
    try:
        detected_objects = object_detector_tool.execute(image_path=image_path, labels=labels)
        object_count = len(detected_objects["baseball"])
        print(f"Number of boxes detected: {object_count}")
        return detected_objects
    except Exception as e:
        print("Error during text detection:", e)
        return {}

