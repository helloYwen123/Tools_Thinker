from object_detector import Object_Detector_Tool

def count_fridges(image_path):
    # Load the image
    result = Object_Detector_Tool.execute(image=image_path, labels=['fridge'], threshold=0.35, model_size="tiny")
    if result:
        final_result = {"fridge": 0}
        for label, details in result["fridge"].items():
            box = details["box"]
            score = details["score"]
            filename = f"fridge_{label}.png"
            if score > 0.35:
                final_result[label] = [box, 1, filename]
        return final_result
    else:
        return {}

result = count_fridges("/nfs/data8/liao/wxie/SAT/SAT_images_train/12685_0.png")
print(result)
```
