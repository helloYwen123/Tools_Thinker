from object_detector import Object_Detector_Tool, text_detector

final_result = ""
if "12394_0.png" in question:
   image_path = f"/nfs/data8/liao/wxie/SAT/SAT_images_train/12394_0.png"
   total_objects = 69
   detected_objects = {"baseball": [], "basket": []}
else:
   final_result = "No doorway visible in the scene!"

result = text_detector.execute(image=image_path, languages=["en", "de"], detail=1)

if total_objects == result:
   final_result = "Yes, 69 doors are visible in the scene."
else:
   final_result = "No, 69 doors are not visible in the scene."

if detected_objects != {"baseball": [], "basket": []}:
   final_result += f"Additionally, there are {len(detected_objects)} baseballs and {len(detected_objects)} baskets."

print(final_result)

