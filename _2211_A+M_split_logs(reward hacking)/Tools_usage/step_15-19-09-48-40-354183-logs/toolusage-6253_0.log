import numpy as np
import matplotlib.pyplot as plt
import matplotlib.image as mpimg
from PIL import Image

# 1. Load an image
image_file = '/nfs/data8/liao/wxie/SAT/SAT_images_train/6253_0.png'
image = mpimg.imread(image_file)

# 2. Detect the objects in the image
objects = Object_Detector_Tool.detect(image, None, 0.35, 'tiny')

final_result = []

for obj in objects:
    for o in obj:
        if o['score'] > 0.35:
            # Get the coordinates of the detection box
            box = o['bbox']
            
            # Get the label of the detected object
            label = o['label']
            
            # Convert the pixel coordinates to real coordinates (e.g., the coordinates of the object are not accurate and need to be corrected)
            x0 = int(box[0])
            y0 = int(box[1])
            x1 = int(box[2])
            y1 = int(box[3])
            
            # Print the detected object and its coordinates
            final_result.append({'bbox': (x0, y0), 'score': o['score'].__float__(), 'label': label, 'file': image_file})

# 3. Save the detected objects as images
for file_path in final_result:
    obj_file = file_path['label']
    
    # Get all the pixels in the bounding box
    pixels = np.array([row[0][x0:x1, y0:y1] for row in object_file[1]])

    # Calculate the size of the object (e.g., width and height)
    W = pixels.shape[1]
    H = pixels.shape[0]

    # Normalize the pixels
    pixnorm = ((pixels-128) / 128.0).astype(int)
    pixnorm = pixnorm.reshape(W, H, 1)

    # Convert the pixels to a format that can be read by the ImageMagick software
    pixformat = pixnorm * 255

    # Save the pixel grid as an image
    newfilename = file_path['label'] + '.png'
    im = Image.fromarray(pixformat)
    im.save(newfilename)

# 4. Show the image with the detected objects
plt.imshow(image)
plt.show()

