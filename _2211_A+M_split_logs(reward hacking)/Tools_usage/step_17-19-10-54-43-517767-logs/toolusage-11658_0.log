# Initialize the tool class
obj_detector_tool = Object_Detector_Tool()

# Define parameters for detection and save path
labels = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Execute the object detection tool with labels
result = obj_detector_tool.execute(image="path_to_image.png", labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

if result["save_object"]:
  # Save detected objects to file
  img_path = "path_to_save_object.png"
  obj_detector_tool.save_object(result)
  
  # Output the count of objects detected
  print(f"Total detected objects: {result['object_number']}")
  
  # Output the detected objects and count
  detected_objects = result["detected_objects"]
