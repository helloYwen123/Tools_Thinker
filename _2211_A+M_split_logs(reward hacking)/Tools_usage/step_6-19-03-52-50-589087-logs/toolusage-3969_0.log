import glob
import numpy as np
import cv2

def extract_objects(filename, languages=['en', 'de'], detail=0):
    # Convert path to absolute
    import_module = 'object_detector'
    import_name = 'Object_Detector_Tool'
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/" + filename

    # Load image
    results = import_module().execute(image=image_path, languages=languages, detail=detail)

    # Create list of objects
    objects = []

    # Process detections
    for output in results['detected_objects']:
        detected_object = {'label': output['label'], 'coordinates': output['coordinates'], 'score': output['score'].item(), 'image_path': output['saved_image_path'] if results['save_object'] else None}
        objects.append([detected_object])

    # Process languages
    for object in objects:
        object_language = None
        for language_code in languages:
            try:
                output = object['label']
                for item in output.split():
                    language_code += '.' if language_code == '' else ' ' + language_code
                    for lang in languages:
                        if language_code == '.' + lang and lang.lower() == lang:
                            object_language = lang
                            break
                    else:
                        object_language = ''
            except:
                object_language = ''

            if object_language != '':
                break

        object['language'] = object_language

    # Return detected objects
    return objects

