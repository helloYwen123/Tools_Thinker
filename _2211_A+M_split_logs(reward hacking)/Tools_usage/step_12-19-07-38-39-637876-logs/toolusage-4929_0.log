from tool_module import Object_Detector_Tool, Text_Detector_Tool

# Create an instance of the Object_Detector_Tool class
detector = Object_Detector_Tool()

# Define the path to the image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4929_0.png"

# Set the language codes and detailed output level
languages = ["eng", "de"]
detail = 1

# Execute the detection
result = detector.execute(image=image_path, languages=languages, detail=detail)

# Extract detected text blocks
detected_text_blocks = result["detected_objects"]
not_found = result["object_number"]

# Process the detected text blocks according to the required text
processed_blocks = []

for block in detected_text_blocks:
    # Extract the coordinates, recognize text, and calculate the confidence score
    x0, y0, x1, y1 = block[0]
    recognized_text = block[1]
    score = block[3]

    # Print the recognized text with confidence score
    print(f"Recognized text: {recognized_text} ({score:.2f})")
    processed_blocks.append({"x0": x0, "y0": y0, "x1": x1, "y1": y1, "recognized_text": recognized_text, "score": score})

# Check the count of missed text
if not_found:
    print(f"Detected {not_found} blocks, but no unrecognized text was found.")
else:
    print(f"Detected {sum(processed_blocks)} blocks.")

# Close the detector objects
detector.close()
text_detector = Text_Detector_Tool()

