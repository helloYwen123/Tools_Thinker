from object_detector import Object_Detector_Tool

# Initialize the object detector tool
tool = Object_Detector_Tool()

# Function to analyze text in the scene
def analyze_text(image_path, languages=['en', 'de'], detail=0):
    # Run the text detection algorithm
    result = tool.execute(image=image_path, languages=languages, detail=detail)
    
    if result:
        # Initialize a list to store detected text blocks
        detected_blocks = []
        
        # Iterate over each detected text block
        for i, block in enumerate(result):
            # Extract the coordinates and recognized text from the block
            box = [block[0][i][0].item(), block[0][i][1].item(), block[0][i][2].item(), block[0][i][3].item()]
            text = block[1]
            
            # Append the detected text block to the list
            detected_blocks.append([box, text, block[2]])
        
        # Convert the detected block list into a JSON list and return it
        return detected_blocks
    else:
        return []
    
# Path of the scene image
