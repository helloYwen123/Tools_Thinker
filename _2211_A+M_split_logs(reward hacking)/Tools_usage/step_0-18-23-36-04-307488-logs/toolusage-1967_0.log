from torch.utils.data import Dataset
import numpy as np
import torch
from torchvision import transforms
import os
from PIL import Image
import json
import random

# Define a simple dataset class that will be used to load object detection results
class Dataset(Dataset):
    def __init__(self, result_dir, text_result_dir, object_type="basketball"):
        self.result_dir = result_dir
        self.object_type = object_type

        # Load detected objects as a list of dictionaries
        self.detected_objects_file = os.path.join(self.result_dir, f"{self.object_type}.txt")
        with open(self.detected_objects_file, "r") as file:
            self.detected_objects = np.array(json.load(file))["baseball"].tolist()

        # Load text results from an auxiliary file for this object type
        self.text_for_object = os.path.join(text_result_dir, f"{self.object_type}.json")
        with open(self.text_for_object, "r") as file:
            self.text_for_object = json.load(file)

        self.object_types = [object_type]
        self.object_categories = [self.object_type, "baseball"]

    def __len__(self):
        return len(self.detected_objects)

    def __getitem__(self, idx):
        return self.detected_objects[idx]

# Define the custom DataLoader
class DataLoader(Dataset):
    def __init__(self, result_dir, text_result_dir, object_type="basketball", batch_size=8):
        super().__init__(result_dir, text_result_dir, object_type)
        self.batch_size = batch_size

    def __len__(self):
        return (len(self.detected_objects) + self.batch_size - 1) // self.batch_size

    def __getitem__(self, idx):
        batch_size = self.batch_size
        batch_idx = idx // batch_size
        batch_selected = idx % batch_size

        index = batch_idx * batch_size + batch_selected
        obj_class = self.object_types[index % len(self.object_types)]
        data = torch.tensor(self.image)
        label = torch.tensor(np.array(self.text_for_object[self.object_types[index % len(self.object_types)]]["bbox"], dtype=np.int32))

        return {"input": data, "label": label}

