def count_desk_lamps(image_path):
    detector = object_detector.Object_Detector_Tool()
    labels_list = [f"desk_lamp_{i}" for i in range(1, 5)]
    
    total_count = defaultdict(int)

    for label in labels_list:
        results = detector.execute(image_path, labels=[label, "lamp"], save_object=True, saved_image_path="detected_objects")
        for result in results['detected_objects']:
            box, score = result['box'], result['score']
            total_count[label] += 1
            
    return total_count

