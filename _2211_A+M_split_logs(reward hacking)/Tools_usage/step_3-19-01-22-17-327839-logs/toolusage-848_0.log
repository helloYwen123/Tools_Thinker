```python
from object_detector import Object_Detector_Tool

tool_name = "Object_Detector_Tool"
input_values = {
  "image": "/nfs/data8/liao/wxie/SAT/SAT_images_train/848_0.png",
  "labels": ["DeskLamp", "Table"],  # Change to ['Chair', 'Table', 'Desk', 'Lamp', 'Chair', 'Bed']
  "threshold": 0.35,
  "model_size": "tiny",
  "save_object": True,
  "saved_image_path": "detected_objects"
}
result = Object_Detector_Tool.execute(**input_values)
detected_objects = result['detected_objects']
total_objects = total_num_objects = detected_objects['baseball'] + detected_objects['basket']
detected_objects_string = ', '.join([
    f"{' '.join([f"[{box[0]} to {box[2]}]", f"{len(text)}"])}"
    for box, text, score in detected_objects.values()
]).replace("\\", "\\\\").replace("[", "").replace("]", "")
detected_objects_string = f"Detected objects: {detected_objects_string}\nDetected object count in image: {total_num_objects}"

result_str = f"Object_Detector_Tool executed successfully.\nDetected objects are as follows: {detected_objects_string}"

final_result = {
  "detected_objects": detected_objects,
  "object_number": total_num_objects,
  "text": detected_objects_string,
  "result": result_str
}

print(final_result)
