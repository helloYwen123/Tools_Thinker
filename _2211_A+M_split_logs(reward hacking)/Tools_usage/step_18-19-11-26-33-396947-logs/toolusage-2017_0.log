from object_detector import Object_Detector_Tool

# Specify the image path and other settings
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2017_0.png"
labels = ['baseball', 'basket']
threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Call the object_detector tool and display the results
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, model_size=model_size,
                                                                 saved_image_path=saved_image_path, threshold=threshold)

final_result = {
  "detected_objects": detected_objects,
  "object_number": object_number
}

