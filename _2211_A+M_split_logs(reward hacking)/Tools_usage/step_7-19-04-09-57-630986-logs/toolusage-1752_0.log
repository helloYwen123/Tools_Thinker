from object_detector import Object_Detector_Tool

# Generate the Python program
def main():
    # Parameters for detection
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1752_0.png"  # Path to the image file
    labels = ["baseball", "basket"]  # List of object labels to detect
    save_objects = False
    saved_image_path = "detected_objects"
    
    # Execute the object detector tool
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_objects, saved_image_path=saved_image_path)
    
    # Generate a JSON string for data output
    output_json = {
        "detected_objects": detected_objects,
        "object_number": object_number
    }
    
    # Print the result
    print(f"Found {len(detected_objects)} detected objects in the image.")
    json_string = json.dumps(output_json, sort_keys=True, indent=2)  # Format as JSON for display
    print(json_string)

if __name__ == "__main__":
    main()

