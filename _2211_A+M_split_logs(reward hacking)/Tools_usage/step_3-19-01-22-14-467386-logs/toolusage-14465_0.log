from object_detector import Object_Detector_Tool, label_to_text

# Function to count the number of dresser in the image
def calculate_dressers(image_path):
    object_count = []
    # Open the image
    image = Image.open(image_path)
    # Convert the image to gray scale
    gray = image.convert('L')
    # Set the background to zero
    image = image.convert('1')
    # Calculate the number of dressers
    d = Object_Detector_Tool.execute(image=image, labels=['Dresser'], save_object=True, saved_image_path="dressers")
    total_number = 0
    # Define a list to store the number of dressers for each language
    dresser_count = []
    for language_code in ['en', 'ja']:
        text = label_to_text(image=image, text_type='dressing', language_code=language_code)
        try:
            dresser_count.append(len(text))
        except:
            dresser_count.append(0)
    total_number = sum(dresser_count)
    return total_number

# Determine the number of dressers in the given image
dressers_number = calculate_dressers("/nfs/data8/liao/wxie/SAT/SAT_images_train/14465_0.png")
print(f"The number of dressers in the image is {dressers_number}.")
