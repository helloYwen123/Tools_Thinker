from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def detect_tables(image_path, languages=['en', 'de']):
    # Example: Assume the first image file is named 'baseball.png' and it's located in the same directory as the Python script.
    image_file = '/nfs/data8/liao/wxie/SAT/SAT_images_train/11001_0.png'

    detector_tools = Object_Detector_Tool()
    languages = ['en', 'de']  # Detect in English and German

    result = detector_tools.execute(image=image_file, languages=languages)

    for text_result in result['text']:
        text_blocks = []
        for text_block in text_result['results']:
            x0, y0, x1, y1 = text_block['bounding_box']
            text = text_block['recognized_phrase']
            confidence_score = text_block['confidence_score']
            text_blocks.append([x0, y0, x1, y1, text, confidence_score])

        # Extract text information
        table_text_blocks = []
        for table_blocks in text_blocks:
            table_text = ''
            for table_block in table_blocks:
                x0, y0, x1, y1, text, confidence_score = table_block
                table_text = table_text + ' ' + text
            table_text = table_text.strip()  # Remove any leading or trailing spaces
            table_text_blocks.append([x0, y0, x1, y1, table_text, confidence_score])

        return table_text_blocks

text_blocks = detect_tables(image_path, languages=['en', 'de'])
print('Detected Tables with Text:')
for text_blocks in text_blocks:
    print('---')
    for text_block in text_blocks:
        x0, y0, x1, y1, text, confidence_score = text_block
        print(f'Box:{x0}, {y0} til {x1}, {y1}')
        print(f'Text:{text}')
        print('Confidence Score:', confidence_score)

