    item_numbers = {box['name']: 3 for box in detected_objects['baseball']}
    detected_objects.sort(key=lambda x: x['score'], reverse=True)

    detected_objects_with_number = {
        item_numbers[item]: f'{item}, score: {item["score"]} - Total: {sum(item["score"] > 0.5 for item in detected_objects)}'
        for item in detected_objects
    }
    detected_objects_with_number = [(item_numbers[item], item['name'], item['score']) for item in detected_objects_with_number]
