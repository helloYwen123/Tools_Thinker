from object_detector import Object_Detector_Tool

def text_detection(image_path, languages=["en", "de"], detail=0):
    detector = Object_Detector_Tool()
    try:
        result = detector.execute(image=image_path, languages=languages, detail=detail)
    except Exception as e:
        print(f"Failed to execute object detection: {e}")
        return []
    
    detected_blocks = []
    for each_block in result:
        if each_block[2] > 0.35 and 'baseball' or 'basket':
            detected_blocks.append(([(each_block[0][0], each_block[0][1]), (each_block[0][2], each_block[0][3]), (each_block[0][3], each_block[0][4]), (each_block[0][4], each_block[0][5])], each_block[1], each_block[2])
        
    return detected_blocks

# Example usage
import_name = 'Object_Detector_Tool'
import_path = f'./_tools/{import_name}.py'
final_result = text_detection(image_path="path/to/image.png", languages=["en", "de"])
```

