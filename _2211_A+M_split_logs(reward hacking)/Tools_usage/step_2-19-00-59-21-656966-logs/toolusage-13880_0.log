from object_detector import * 

# path to the image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13880_0.png"

# labels to detect (e.g., 'baseball', 'basket')
labels = [ 'baseball', 'basket' ]

# confidence threshold
conf_threshold = 0.35

# model size
model_size = 'tiny'

# save object images as files
save_object = False
saved_image_path = "detected_objects"

# execute detection and get object details
object_details = Object_Detector_Tool.execute(image=image_path, labels=labels, conf_threshold=conf_threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# determine the number of detected objects
number_of_objects = len(object_details) if save_object else 0

# return the detected objects
detected_objects = []
total_objects_count = {}
total_objects_count['baseball'] = len(object_details['baseball'])

if save_object:
    # if saving detected objects:
    for obj_details in object_details.values():
        # if not empty array
        if obj_details:
            # check bounding box size
            if len(obj_details[0][0]) == 4:
                box_size = True
            else:
                box_size = False
            # crop object and draw bounding box
            if box_size:
                detected_objects.append(['detected objects'] + object_details)
                detected_objects[0][len(detected_objects[0]) - 1][1] = object_details
                detected_objects[0][len(detected_objects[0]) - 1][2] = detected_objects[0][len(detected_objects[0]) - 1][2] + object_details[0][2]
                detected_objects[0][len(detected_objects[0]) - 1][3] = detected_objects[0][len(detected_objects[0]) - 1][3] + object_details[0][3]
            else:
                detected_objects.append(['detected objects'] + object_details)

# return the object details and the number of objects detected
