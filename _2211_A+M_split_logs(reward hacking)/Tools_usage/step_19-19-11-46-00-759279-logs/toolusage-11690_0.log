from object_detector import Object_Detector_Tool

def count_chairs(image_path):
    object_detector = Object_Detector_Tool(image_path, labels=["chair"], model_size="tiny")
    chair_detection = object_detector.execute()
    chair_results = chair_detection["detected_objects"]["chair"]
    chair_count = len([det["score"] > 0.35 for det in chair_results])
    
    if chair_count == 0:
        return None, None
    
    chair_results = chair_detection["detected_objects"]
    chair_num = len(chair_results["baseball"]) + chair_results["basket"]
    
    return chair_count, chair_num

