from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

def detect_object_in_image(image_path, label_to_filter):
    # Open the image file
    image = Image.open(image_path)
    image.close()

    # Load the model
    detection_tool = Object_Detector_Tool()

    # Convert the image from RGB to Grayscale and resize
    image = Image.open(image_path)
    image = image.convert('L')
    width, height = image.size
    image = image.resize((500, 500))

    # Detect and return the results
    labels_to_test = label_to_filter
    results = detection_tool.execute(image_path=image_path, labels=labels_to_test, save_object=True)
    
    return results

def detect_character_in_image(image_path, languages=["en", "de"], detail=0):
    # Open the image file
    image = Image.open(image_path)
    image.close()
    
    # Load the model
    text_detector_tool = Text_Detector_Tool()

    # Detect the text in the image
    results = text_detector_tool.execute(image_path=image_path, languages=languages, detail=detail)
    
    return results
    
def count_objects_detections(detection_results):
    # Find the total number of detection results for all detected labels
    number_of_labels = [result['label'] for result in detection_results]
    
    return {label: len(result['labels']) for label, result in detection_results.items()}

