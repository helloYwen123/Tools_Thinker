from object_detector import object_detector
from text_detector import text_detector

def count_dining_tables(image_path: str, languages: list, detail: int) -> dict:
    """
    Counts and locates dining tables in an image.

    Parameters:
    - image_path (str): The path to the image file.
    - languages (list): A list of language codes for the OCR model.
    - detail (int): The level of detail in the output. Set to 0 for simpler output, 1 for detailed output.

    Returns:
    - dict: A dictionary containing the number of dining tables detected in the image. {'a': 0, ...}
    """
    if not languages or not detail > 0:
        return {}

    result = object_detector(image=image_path, languages=languages, detail=detail)
    table_bounding_boxes = [box for object in result['objects'] for box in object['box'] if 'baseball' in object['name']]

    # Filter dining tables based on 'baseball' in object names
    dining_tables = [name for table_box in table_bounding_boxes for item in table_box for name in item['text'] if 'baseball' in name]

    return {'numbers': len(dining_tables), 'boxes': dining_tables}

# Provided data point
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/7784_0.png'
languages = ['en', 'de']
detail = 0

result = count_dining_tables(image_path, languages=languages, detail=detail)
print(result)  # Outputs approximately {'numbers': 0, 'boxes': []}
```
