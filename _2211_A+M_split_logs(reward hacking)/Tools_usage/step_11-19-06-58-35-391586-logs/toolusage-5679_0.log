from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels=['baseball', 'basket'], save_object=False, saved_image_path="detected_objects"):
    object_detector_tool = Object_Detector_Tool()
    try:
        labels = labels if labels else ['baseball', 'basket']
        detected_objects = object_detector_tool.execute(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

        return detected_objects
    except Exception as e:
        return None

def count_objects(image_path, label='baseball', languages=['en', 'de'], detail=0):
    text_detector_tool = Text_Detector_Tool()
    attempt = 3
    while attempt:
        result = text_detector_tool.execute(image_path, languages=languages, detail=detail)

        if result:
            return result
        else:
            attempt -= 1

    return None

final_result = {'objects count': count_objects(image_path)}
if final_result:
    if 'labels' in final_result and 'baseball' in final_result['labels']:
        final_result['baseball'] = len(final_result['labels'])
    if 'basket' in final_result['labels']:
        final_result['basket'] = len(final_result['labels'])
else:
    final_result = None

if final_result:
    print("Final Results:", final_result)
else:
    print("No detected objects found.")

