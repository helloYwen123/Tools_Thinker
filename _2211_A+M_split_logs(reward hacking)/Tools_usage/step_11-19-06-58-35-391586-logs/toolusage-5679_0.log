from object_detector import Object_Detector_Tool

def count_pillows(image_path, labels):
    with open(image_path, 'rb') as img_file:
        pillow = Image.open(img_file)
        images = Object_Detector_Tool.execute(image=image_path, labels=labels)
        pillow.save("/tmp/pillow.jpg")
        pillow.save("/tmp/pillow2.jpg")
        for image_path in ["/tmp/pillow.jpg", "/tmp/pillow2.jpg"]:
            pillow = Image.open(image_path).convert('P')
            objects = Text_Detector_Tool.execute(image=image_path, languages=['English'])
            objects = [{"box": box, "text": text, "conf_score": score} for text, box, score in objects]
            final_result = {"numbers": 0, "counted_objects": {}} 
            for i, item in enumerate(objects):
                if item["text"] == "pillow": 
                    if not images[labels.index(item["text"])]:
                        final_result["numbers"] += 1 
                    else:
                        i += 1
                        continue
                    if images[labels.index(item["text"])]: 
                        objects[i].update({"counted_objects": "pillow"})
                        final_result["counted_objects"]["pillow"] += 1
            return {
                **final_result,
                "image_path": image_path
            }

