from tool_object_detector import Object_Detector_Tool

def count_chairs_in_image(image_path):
    tool_options = {
        'image': image_path,
        'labels': ['chair'],
        'model_size': 'tiny'
    }
    try:
        result = Object_Detector_Tool(**tool_options).execute()
        chair_count = len(result['chair'])
        return (chair_count,)
    except Exception as e:
        return None

# Image path
image_path = 'path/to/image.png'

# Call the count_chairs_in_image function
chair_count = count_chairs_in_image(image_path)
final_result = {'chairs': chair_count, 'total_objects': 100} if chair_count else {'chairs': '', 'total_objects': 0}
final_result['chairs'], chair_count

