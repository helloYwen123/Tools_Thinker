from tool_object_detector_tool import Object_Detector_Tool
from tool_text_detector_tool import Text_Detector_Tool

# Image path
image_path = "/path/to/image.png"
# Language codes for the OCR model
languages = ["en", "de"]

# Level of detail (0 for simpler output, 1 for detailed output)
detail = 1

# Python program
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=["baseball", "basket"], languages=languages, detail=detail, save_object=True, saved_image_path="detected_objects")

# Text detection output
result = Text_Detector_Tool.execute(image=image_path, languages=languages)

result_output = [(box_list, text, confidence) for box_list, text, confidence in result]
text_result = [[[[x0, y0], [x1, y1], [x2, y2], [x3, y3]],
               "Detected text",
               score] for box_list, text, score in result_result]
result = detected_objects + text_result

final_result = {"detected_objects": detected_objects, "object_number": object_number}
final_result.update(result)
print(final_result)

