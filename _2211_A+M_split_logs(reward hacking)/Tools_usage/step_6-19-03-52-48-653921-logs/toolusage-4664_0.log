from object_detector import Object_Detector_Tool

def count_chairs(image_path, labels=['chair'], threshold=0.35, model_size="tiny", save_object=False):
    detected_objects, object_number = Object_Detector_Tool.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

    if detected_objects and object_number:
        chair_results = [detected_objects[label] for label in object_number.keys()]
    else:
        chair_results = []

    chair_results += [[detected_objects[label], label, detected_objects[label][3]] for label in object_number.keys() if label.startswith("chair") or label.startswith("kitchen") or label.startswith("chair2")]
        # Check if the chair number exceeds 1000
        if len(chair_results) > 1000 and chair_results[0][0] == chair_results[1]:
            chair_results.pop(1)
            chair_results.remove(chair_results[0])

    return chair_results

# Example usage:
chair_results = count_chairs("/nfs/data8/liao/wxie/SAT/SAT_images_train/4664_0.png", labels=["chair2"])
chair_results
