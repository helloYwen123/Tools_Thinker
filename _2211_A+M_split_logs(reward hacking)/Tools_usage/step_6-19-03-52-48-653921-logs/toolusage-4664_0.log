from image_object_detector import Object_Detector_Tool

def detect_objects(image, labels, save_object):
    label_output = {}
    object_output = {}

    for label in labels:
        (bbox, score, saved_image_path) = Object_Detector_Tool.detect_object(image, label, False, 1, "base", save_object)

        if len(bbox) > 0:
            label_output[label] = bbox
            object_output[label] = len(label_output) + 1

    return label_output, object_output

