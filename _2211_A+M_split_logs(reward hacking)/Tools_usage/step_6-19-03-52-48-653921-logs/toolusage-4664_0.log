import pyopenexif as pe

# Load the image
with open('/nfs/data8/liao/wxie/SAT/SAT_images_train/4664_0.png', 'rb') as image_file:
    image_data = image_file.read()

# Perform text detection
result = pe.extract_text(image=image_data)

# Extract detected text
text_blocks = []
for text_block in result:
    detected_text = text_block[0][2]
    text_blocks.append({'bounding_box': text_block[0][0], 'recognized_text': detected_text, 'confidence_score': text_block[1]})

# Check if any text was detected
if len(text_blocks) > 0:
    detected_text_count = {block['recognized_text']: len(text_blocks) for block in text_blocks}
else:
    detected_text_count = {}
   
# Define final result
final_result = {" chairs": [0]}
if text_blocks:
    final_result[" chairs"] = detected_text_count
    
print(final_result)

