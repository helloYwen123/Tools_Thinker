class Command:
    def execute(self, image_path, languages=['en'], detail=0):
        model = "tiny"
        output_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/detected_objects/"
        
        object_results = {}
        text_result = {}
        
        if languages != []:
            detected_objects = Object_Detector_Tool.execute(image_path, languages=languages, detail=detail)
            if detected_objects:
                for det_box, det_label, det_score in detected_objects["detected_objects"]:
                    object_results[det_label] = det_results
                
                detected_objects["labels_count"] = len(detected_objects["labels"])
            
                if "baseball" in object_results:
                    box = [det_box[0], det_box[1], det_box[2], det_box[3]]
                    object_results["baseball"] = [[box, det_score, "baseball", det_box[4]]]
                    print(f"Found baseball at: {det_box}")
                elif "basket" in object_results:
                    box = [det_box[0], det_box[1], det_box[2], det_box[3]]
                    object_results["basket"] = [[box, det_score, "basket", det_box[4]]]
                    print(f"Found basketball at: {det_box}")
                else:
                    print("No baseball or basketball found")
            else:
                print("Text detection failed.")
                
        if "text_results" in detected_objects:
            text_results = Object_Detector_Tool.execute(image_path, languages=languages, detail=detail)
            if text_results:
                for text_box, text_content, text_score in text_results:
                    text_result[text_content] = text_score
                    print(f"Found text at: {text_box}, confidence: {text_score}")
            else:
                print("Text detection failed.")
        else:
            print("Text detection failed.")
        
        return object_results, text_result

