from text_detector_tool import TextDetectorTool
from object_detector_tool import ObjectDetectorTool

class SceneAnalyzer:
    def analyze_scene(self, image_path, save_object=False):
        detection_result = TextDetectorTool.execute(image_path, [['baseball']], 0.05, 'tiny', save_object)
        detected_objects = defaultdict(list)

        for item in detection_result:
            for label, obj in item[1].items():
                if label == "baseball" and obj['score'] > 0.25:
                    box = *[bbox for bbox in obj['bbox'] if bbox[0] > 0 and bbox[1] > 0]
                    detected_objects[label].append(box)

        if not saved_objects:
            saved_objects = {}

        for label, boxes in detected_objects.items():
            # Calculate the count of detections for each baseball
            baseball_count = len(boxes)
            save_objects[label] = {"count": baseball_count}

        return saved_objects, detection_result
