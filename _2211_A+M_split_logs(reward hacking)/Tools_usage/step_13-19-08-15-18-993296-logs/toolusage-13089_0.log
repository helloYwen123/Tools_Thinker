def analyze_image(image_path, labels=['baseball', 'basket'], languages=['en', 'de'], detail=0):
    # Load the image and English and German language models
    image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/13089_0.png'  # Change this path as needed
    image = object_detector(image_path, labels=labels, languages=languages, detail=detail)
    image_text = text_detector(image_path, languages=languages, detail=detail)
    # Analyze the text or other information
    detected_objects = []
    for label in labels:
        for block in image_text:
            if block[3] == label and block[4] >= 0.95:
                detected_objects.append((label, block))
    return detected_objects

