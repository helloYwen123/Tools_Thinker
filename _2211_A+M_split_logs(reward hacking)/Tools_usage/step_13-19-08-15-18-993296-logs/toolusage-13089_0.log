from tool_module_names import object_detector

def count_objects(image_path, labels, threshold, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    tool_kwargs = {
        'image': image_path,
        'labels': labels,
        'threshold': threshold,
        'model_size': model_size,
        'save_object': save_object,
        'saved_image_path': saved_image_path
    }
    
    result = object_detector.execute(**tool_kwargs)
    if result:
        if save_object:
            for labels_label in result:
                bounding_box, label_name, confidence = result[labels_label]
                bounding_box = bounding_box.tolist()
                label_name = label_name.replace('.txt', '')
                detection_image_path = f'../detected_objects/image_{label_name}_{confidence:0.1f}.png'
                object_detector.save_image_to_file(**bounding_box, **detection_image_path)
        return result
    else:
        return None

