from object_detector import Object_Detector_Tool

# Function to run the object detection tool
def detect_objects(image_path, labels, thresholds, model_size):
    return Object_Detector_Tool.execute(image=image_path,
                                       labels=labels,
                                       thresholds=thresholds,
                                       model_size=model_size)

# Function to count the number of detected objects
def detect_object_count(image_path, languages):
    return Object_Detector_Tool.execute(image=image_path,
                                       languages=languages)

# Given image path, labels for baseball and basketball, and confidence threshold
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13912_0.png"
labels = ["baseball", "basket"]
thresholds = 0.35
model_size = "tiny"
desired_languages = ["en", "de"]

# Detect baseball and basketball
detected_baseball = detect_objects(image_path, labels, thresholds, model_size)
detected_basketball = detect_objects(image_path, labels, thresholds, model_size)

# Count detected baseball and basketball
baseball_count = detect_object_count(image_path, desired_languages)
basketball_count = detect_object_count(image_path, desired_languages)

# Final result
final_result = {
    "baseball_count": baseball_count,
    "basketball_count": basketball_count
}

# Print the results
print(final_result)

