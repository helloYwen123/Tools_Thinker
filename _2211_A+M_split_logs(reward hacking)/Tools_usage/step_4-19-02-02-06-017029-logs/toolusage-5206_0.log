def get_chest_chair_count(image_path):
    model = "tiny"
    threshold = 0.35
    save_object = True
    saved_image_path = "detected_objects"

    tool = Object_Detector_Tool()
    tool.execute(image=image_path, labels=["chest", "chair"], save_object=save_object, saved_image_path=saved_image_path)
    
    detected_objects = tool.output_types["detected_objects"]
    detected_count = tool.output_types["object_number"]["chest"]
    detected_chairs = tool.output_types["detected_objects"]["chair"]
    detected_chairs_count = len(detected_chairs)
    
    return detected_chairs_count

