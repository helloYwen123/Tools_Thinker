from tool_object_detector import Object_Detector_Tool
from tool_text_detection import Text_Detector_Tool

# Path to the image
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/8379_0.png'

# Demographic data
languages = ['en', 'de']
detail = 0  # Level of detail

# Execute object detection
object_detector = Object_Detector_Tool()
detected_objects_result = object_detector.execute(image_path, languages=languages, detail=detail)
object_labels = detected_objects_result[0]

# Execute text detection
text_detector = Text_Detector_Tool()
text_result = text_detector.execute(image_path, languages=languages)
text_detected_results = text_result

# Combine and display results
combined_result = {}
for label in object_labels:
    for text in text_detected_results:
        if label[0] == text[0][0]:
            combined_result[label[0]] = label[1:]
            combined_result[label] = 0  # Exclude already checked text detection result

if text_result:
    text_detected_results = text_result
    for text in text_detected_results:
        if text[0][0] in object_labels:
            combined_result[text[0][0]] = text[1:]



final_result = {'total_objects': len(combined_result)}
if len(combined_result) > 0:
    total_objects = len(combined_result)
    for label in object_labels:
        count = combined_result[label].count(True)
        final_result[label] = count + total_objects

print(f"Total objects in the scene: {total_objects}")
print(f"Total detected objects: {min(final_result.values())}")
final_result

