import numpy as np
import cv2
from object_detector import Object_Detector_Tool

# Load the image
def load_image(image_path):
    image = cv2.imread(image_path)
    return image

def detect_objects(image_path, labels, detect_threshold=0.35):
    result = []

    # Load the image
    image = load_image(image_path)

    # Detect objects using the object detector tool
    detector_tool = Object_Detector_Tool()
    detected_objects_tool, _ = detector_tool.execute(image=image,
                                                   labels=labels,
                                                   save_object=False,
                                                   thresholds=[detect_threshold])
    
    for detected_object in detected_objects_tool['baseball']['baseball']:
        detected_object['score'] = detected_object_tool['scores'][detected_object_tool['labels'] == detected_object['labels']][detected_object['labels'] == detected_object['labels']]['score']
        detected_object['boxes'] = [[x, y, w, h] for w, h in detected_object['boxes']]  
        result.append(detected_object)

    return result

result = detect_objects('/nfs/data8/liao/wxie/SAT/SAT_images_train/7708_0.png', ['baseball', 'basket'])

print(result)
