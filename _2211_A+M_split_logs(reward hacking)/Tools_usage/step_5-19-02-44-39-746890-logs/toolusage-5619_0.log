from object_detector import Object_Detector_Tool  # import the Object_Detector_Tool tool from the available_tools module

def count_books(image_path):
    # Call the Object_Detector_Tool tool to detect 'book'
    tool_result = Object_Detector_Tool.execute(image_path=image_path, labels=['book'], save_object=True)
    book_boxes = tool_result[0]['box']  # convert object_results['book'] to a list of bounding boxes

    # Count the number of books detected
    book_count = len(book_boxes)

    return book_count

final_result = count_books("/nfs/data8/liao/wxie/SAT/SAT_images_train/5619_0.png")

if final_result == 2:
    print("There are 2 books in the image.")
elif final_result > 2:
    print("There are more than 2 books in the image.")
else:
    print("No books are detected in the image.")

