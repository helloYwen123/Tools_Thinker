from object_detector import Object_Detector_Tool

def count_books_image(image_path):
    # Load the ground-truth bounding boxes
    image = Image.open(image_path)
    gt_boxes = np.load("/nfs/data8/liao/wxie/SAT/SAT_images_train/5619_0.png")
    
    # Initialize a list to store the detected objects
    detected_objects = []
    
    # Initialize a dictionary to count the detected numbers
    object_count = {}

    # Execute object detection
    try:
        detected_objects = Object_Detector_Tool.execute(image=image, labels=["book"], thresholds=[0.5], save_objects=True, model_size="base")
        object_count = Object_Detector_Tool.object_number
    
    except Exception as e:
        print(f"Error: {e}")
        return None
    
    # Return the dictionary of detected objects
    return {"detected_objects": detected_objects, "object_count": object_count}

