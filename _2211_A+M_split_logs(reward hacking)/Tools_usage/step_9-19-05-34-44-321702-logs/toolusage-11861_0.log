from object_detector import Object_Detector_Tool

# Path to the image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11861_0.png"

# Flags for the tool
labels = ['baseball', 'basket']
threshold = 0.35
save_object = True
saved_image_path = "detected_objects"

# Call the tool with the image path and other flags
result = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, threshold=threshold, model_size="tiny")

final_result = []
object_number = {}

for label in labels:
    for detection in result:
        if detection['label'] == label:
            detected_object = detection
            break

for detected_object in detected_object:
    if detected_object['label'] == 'baseball':
        item = {'box': (detected_object['box'][0], detected_object['box'][1], detected_object['box'][2], detected_object['box'][3])}
        final_result.append(item)
        object_number[label] = detected_object['score']

    elif detected_object['label'] == 'basket':
        item = {'box': (detected_object['box'][0], detected_object['box'][1], detected_object['box'][2], detected_object['box'][3])}
        final_result.append(item)
        object_number[label] = detected_object['score']

for label, score in object_number.items():
    if score >= threshold:
        object_count[item][label] += 1

final_result.extend([x for x in object_count.values()])
print(final_result)  

