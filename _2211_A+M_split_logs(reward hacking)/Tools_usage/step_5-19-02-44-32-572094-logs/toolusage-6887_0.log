from object_detector import Object_Detector_Tool

def count_couter_top(image_path):
    detector = Object_Detector_Tool()
    result = detector.execute(image=image_path, labels=['counter'],
                              save_object=False,)
    total_counter = 0
    for label in result[0]:
        if label['score'] > 0.35:
            counter_boxes = label.get('bbox', [0, 0])
            if counter_boxes:
                total_counter += len(counter_boxes)
    return [f'{image_path} has {total_counter} counter top detected', total_counter]

