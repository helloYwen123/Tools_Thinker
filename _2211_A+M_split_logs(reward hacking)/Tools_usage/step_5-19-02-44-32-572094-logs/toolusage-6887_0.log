import commands

def run_detection(image_path, language, detail):
    result = commands.run(f"Text_Detector_Tool.execute(image='{image_path}', languages=[language], detail={detail})")
    return result

def count_text_blocks(image_path, languages=['en', 'de'], detail=1):
    result = commands.run(f"Text_Detector_Tool.execute(image='{image_path}', languages={languages}, detail={detail})")
    text_blocks = []
    for text_block in result.split('\n\n'):
        text_blocks.append((text_block.split()[0].split(' ')[0], *[f'{block}\n' for block in text_block.split('\n')]))
    return text_blocks

def get_count(text_blocks, label, language, detail):
    text_blocks = count_text_blocks(label, languages=[language], detail=detail)
    count = sum([len(block) for _, block in text_blocks if label in block])
    return count

languages = ['en', 'ja']
count = get_count(text_blocks, 'Counter', languages, 1)
final_result = {"count": count}
print(final_result)
