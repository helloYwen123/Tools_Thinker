Code: from tkinter import filedialog

def count_toilets():
    # Open the image file dialog box to get the path of the image
    image_path = filedialog.askopenfilename()
    
    if image_path:
        # Load the image
        img = Image.open(image_path)
        
        # Define labels and model parameters
        labels = ['toilet', 'sink', 'shower']  # labels for toilet, sink, and shower
        model_size = 'tiny'
        threshold = 0.35
        
        # Initialize counters
        toilet_count = sink_count = shower_count = 0
        
        # Iterate over each object in the image
        for rectangle in img.find_annotated_object('.'):
            # Get the label and bounding box coordinates
            label = rectangle['bbox'][0]
            box = rectangle['bbox'][:4]
            
            if label == 'toilet':
                toilet_count += 1
            elif label == 'sink':
                sink_count += 1
            elif label == 'shower':
                shower_count += 1
                
        # Convert the counts to a JSON string and display the result
        result = f"Number of toilets: {toilet_count}\nNumber of sinks: {sink_count}\nNumber of showers: {shower_count}"
        return result
    else:
        return "No image path provided."
    
# Execute the code
final_result = count_toilets()
print(final_result)

