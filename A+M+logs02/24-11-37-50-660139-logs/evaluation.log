Code: from object_detector_tool import tool as ottool

def count_gloves_on_woman(image_path, labels=["gloves"], threshold=0.3, model_size="tiny", padding=20):
    """Determine the number of gloves on a woman while snowboarding"""
    
    # Load the image
    image = ottool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)

    # Access relevant bounding boxes
    gloves = [box for box in image[0]["boxes"] if box["label"] == "gloves"]
    
    # Count gloves
    num_gloves = len(gloves) if gloves else 0

    return num_gloves

print(count_gloves_on_woman("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_66_image_1_large.png"))

