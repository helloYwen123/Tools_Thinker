from os.path import isfile, join

def count_blue_floats(file_path):
    """Detects blue floats in an image and returns the count."""
    image_path = file_path + ".jpg"
    img = Image.open(image_path)
    label_list = []

    for (i, box) in enumerate(img.getbbox('cloth')):
        for float in img.getbbox('float'):
            if float in ("blue", "green"):
                label_list.append({"label": "float", "confidence score": float, "box": box})

    # Apply threshold for a better balance between true positives and false positives
    if len(label_list) >= 200:
        label_list.sort(key=lambda x: x['confidence score'], reverse=True)
        return max(label_list, key=lambda x: x['confidence score'] if x['confidence score'] > 0.3 else None).get('box', None)
    else:
        return 0

