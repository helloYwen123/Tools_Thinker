Code: from object_detector_tool import tool

def find_blue_floats(image_path):
    try:
        labels = ["blue float"]
        threshold = 0.5
        model_size = "base"
        padding = 15
        detection_results = tool.execute(image_path, labels, threshold, model_size, padding)
        for detection_result in detection_results:
            for label in detection_result["labels"]:
                if label == "blue float":
                    return True
        return False
    except Exception as e:
        print(f"Error occurred: {e}")
        return False

