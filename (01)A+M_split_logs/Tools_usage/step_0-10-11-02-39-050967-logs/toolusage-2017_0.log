def calculate_television_number(image_path, languages=['en', 'de']):
    results = Object_Detector_Tool.execute(
        image=image_path,
        languages=languages,
        detail=1
    )
    
    if results:
        letter_results = letter_detector.execute(image=image_path)

        if 'letter_results' in results:
            # Find text that starts with 'Television'
            for result in results['text_results']:
                if 'detected text' in result and 'Television' in result['detected_text']:
