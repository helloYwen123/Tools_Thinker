from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool
from text_detector import Text_Detector_Tool
from pixel_level_depth_estimator import Pixel_Depth_Tool

# Use the Pixel_Depth_Tool to estimate depth and detect beds
results = Pixel_Depth_Tool.execute(outdir='vis_depth')

# Extract bed counts from the depth images
depth_image_paths = results['image_results'].keys()
bed_counts = defaultdict(int)
for depth_image in depth_image_paths:
    bed_counts[depth_image.split('/')[-1]['assets'][-1].split('.')[0].split('-')[0]] += 1

# Determine the number of beds
total_beds = sum(bed_counts.values())
total_beds
