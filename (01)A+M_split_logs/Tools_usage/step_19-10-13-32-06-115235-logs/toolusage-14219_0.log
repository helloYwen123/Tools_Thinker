final_result = None

# Use the Pixel_Depth_Tool tool to estimate pixel-level depth from the image
image_results = Pixel_Depth_Tool.execute(image_path='/nfs/data8/liao/wxie/SAT/SAT_images_test/5819_0.png', outdir='./vis_depth')

if image_results:
    # Extract the detected object labels
    labels = image_results.get('image_results', {})
    object_labels = labels.get('/nfs/data8/liao/wxie/SAT/SAT_images_test/5819_0.png', {}).get('object_labels', [])
    object_labels = [object_label['label'] for object_label in object_labels]

    if object_labels:
        # The first object label is always 'baseball', and the last object label is always 'basket'. Therefore, there are at least 2 and at most 4 boxes.
        if len(object_labels) >= 1:
            # Count the number of boxes for the first object label
            first_object_box_count = labels.get('/nfs/data8/liao/wxie/SAT/SAT_images_test/5819_0.png', {}).get('image_results', {}).get('detect_object_first_box_count', 0)
        else:
            first_object_box_count = 0

        if len(object_labels) <= 3:
            # For 'baseball' and 'basket', there are always 1 and 2 boxes respectively
            total_boxes = [first_object_box_count, (len(object_labels) - 2) * 2]
        else:
            # More than 3 objects, or 1 object, so default to max(0, len(object_labels) - 2)
            total_boxes = max(0, len(object_labels) - 2)
    else:
        total_boxes = 0

    # Output the final result with the counted number of boxes
    print(f"Number of boxes in the scene: {total_boxes}")
else:
    print("No image was provided for analyzing.")
