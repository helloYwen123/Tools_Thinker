from command_toolbox import Object_Detector_Tool, Text_Detector_Tool

# Initialize the tool objects
detector = Object_Detector_Tool()
text_detector = Text_Detector_Tool(languages=['en', 'de'])

final_result = ""
detected_objects = []
object_number = {}
results = []

# Detect objects and text
detected_objects = detector.execute(image='image.png', labels=['baseball', 'basket'], save_object=False, saved_image_path='detected_objects')
detected_objects, object_number = text_detector.execute(image='image.png', languages=['en', 'de'])

# Convert the detected objects and text result into desired format
for detected_object in detected_objects:
  detected_object[0] += [detected_object[1], detected_object[2], object_number[detected_object[1]]]  # Add total frame counter
    
for language in text_detector.results:
  text_object = str(text_detector.results[language])
  results.append([detected_object, language, int(text_object[1].split('.')[2])+1] + text_object.split('.')[0].split('_') + [detected_object[2]])

results = sorted(results, key=lambda x: x[2])

# Analyze the results and final_result
for i in range(len(results)):
  if 'basket.' in results[i][1]:
    if 'a' in results[i][1]:
      final_result = 'yes'
    elif 'b' in results[i][1]:
      final_result = 'yes'

print(final_result)

