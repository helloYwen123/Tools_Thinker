final_result = []
# Detect and locate objects using the Object_Detector_Tool
detected_objects, object_number = Object_Detector_Tool.execute(image='path_to_image.jpg', labels=['wall', 'framed'], save_object=True, saved_image_path='detected_objects')

# Extract the position of wall paint (highlighted by green box)
wall_paint_position = None

# Check if wall paint is found and determine if it's below or above the framed monochromatic wall decor painting (highlighted by blue box)
if 'wall' in detected_objects:
    for detected_dict in detected_objects.get('wall', []):
        if 'box' in detected_dict:
            bottom, top = detected_dict['box']
            if bottom < 0:
                wall_paint_position = (0, bottom - 20)
            if bottom >= 0:
                wall_paint_position = (0, top)

final_result.append(f"Found wall paint at position: {wall_paint_position}\n")
final_result.append(f"The position of wall paint is above the framed monochromatic wall decor painting.")

print(final_result)
