from pixel_level_depth_estimator import Pixel_Depth_Tool

import numpy as np

def main():
    pixel_tool = Pixel_Depth_Tool()

    image_paths = [
        "path/to/image1.png", 
        "path/to/image2.png", 
        "path/to/video1.mp4", 
        "path/to/video2.mp4"
    ]

    results = pixel_tool.execute(image_paths=image_paths, output=True, outdir="./vis_depth")

    for image_path, result in results.items():
        print(f"Image Path: {image_path}\n")
        for depth_result in result.get("depth_map"):
            print(f"  Depth Map at: {depth_result.get('bbox')}")
            print(f"  Depth Estimated: {depth_result.get('depth')}")
            print(f"  Output Depth Image Path: {depth_result.get('output_image_path')}\n")

if __name__ == "__main__":
    main()
```

