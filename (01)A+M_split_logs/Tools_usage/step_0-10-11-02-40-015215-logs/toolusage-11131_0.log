import object_detector
from letter_detector import Letter_Detector_Tool

def get_abstract_artwork_location(image_path):
    abstract_artwork = letter_detector.execute(image_path=image_path)[0]
    art_location = abstract_artwork[1]
    
    if isinstance(art_location, list):
        art_location = [x[0] for x in art_location]
    
    return art_location

