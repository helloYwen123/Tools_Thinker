from object_detector import Object_Detector_Tool

class HousePlants:
    def __init__(self):
        self.houseplants = {}

    def detect(self, image_path):
        detected_results = Object_Detector_Tool.execute(image=image_path, labels=["HousePlant"], threshold=0.2, model_size="tiny", save_object=True, saved_image_path="detected_objects/houseplants")
        for results in detected_results:
            bbox = results[0]
            score = results[1]
            name = results[2]
            self.houseplants[name] = {"bbox": bbox, "score": score, "label": name}

    def count_houseplants(self, image_path):
        result = self.detect(image_path)
        return len(result)

    def get_houseplants(self):
        return self.houseplants

h = HousePlants()
h.detect("path/to/image.png")
print(h.get_houseplants().count_houseplants("HousePlant"))
