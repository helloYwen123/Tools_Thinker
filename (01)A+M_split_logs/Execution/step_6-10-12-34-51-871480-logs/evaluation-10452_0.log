def run(image_path, **kwargs) -> dict:
    # Initialize tool with object detection parameters
    detector_tool = Object_Detector_Tool(
        image=image_path, labels=self.labels, **kwargs
    )
    if detector_tool.objects_detected:
        return {
            'detected_object_image': detector_tool.footprint,
            'detected_objects': detector_tool.obj_results,
            **detector_tool.results
        }
    else:
        print(f'No object detected. Failed to run.')
        return {}

# Run run() functionality
result = run(image_path=image_path, **kwargs)
print(result)
```

