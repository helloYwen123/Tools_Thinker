def count_windows(image, languages=['en']):
    """
    Detects text in the image using multiple languages.
    """
    detector = Letter_Detector_Tool()
    detections = detector.execute(image=image)

    # Count windows
    total_count = len(detections['assets/image1.txt'])
    for i in range(total_count):
        window_count = len(detections['assets/image1.txt'][i])

    return window_count

final_result = count_windows('/path/to/image.png', languages=['en'])
print("The number of visible windows in the scene is:", final_result)


