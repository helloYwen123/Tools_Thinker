from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool

# Import the needed tool modules
object_detection_tool_module_name = "object_detector"
text_detection_tool_module_name = "text_detector"
letter_detection_tool_module_name = "letter_detector"

# Specify the tool classes
object_detection_tool_class_name = "Object_Detector_Tool"
text_detection_tool_class_name = "Text_Detector_Tool"
letter_detection_tool_class_name = "Letter_Detector_Tool"

# Define the input and output filepaths, language codes, and output parameters
input_file_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/7614_0.png"
input_language_codes = ["en"]
text_language_codes = ["en", "de"]

# Initialize the object detector tool
object_detection_tool = Object_Detector_Tool(
    tool_module_name=object_detection_tool_module_name,
    tool_class_name=object_detection_tool_class_name,
    tool_description="Detects objects in an image using Grounding DINO with empty padding.",
    tool_version="1.0.0",
    input_types={"image": input_file_path, "labels": "baseball, basket", "threshold": 0.35, "model_size": "tiny", "save_object": True, "saved_image_path": "detected_objects"},
    output_types="detected_objects, object_number = {}".format(object_detection_tool_class_name)
)

# Initialize the text detector tool
text_detection_tool = Text_Detector_Tool(
    tool_module_name=object_detection_tool_module_name,
    tool_class_name=object_detection_tool_class_name,
    tool_description="Detects text in an image using EasyOCR with detail parameter 1.",
    tool_version="1.0.0",
    input_types={"image": input_file_path, "languages": input_language_codes, "detail": 1},
    output_types=["detected_text_blocks", "total_objects_counter"] = ["detected_text_blocks", "total_objects_counter"]
)

# Initialize the letter detector tool
letter_detection_tool = Letter_Detector_Tool(
    tool_module_name=object_detection_tool_module_name,
    tool_class_name=object_detection_tool_class_name,
    tool_description="Detect specific letters in an image.",
    tool_version="1.0.0",
    input_types={"image": input_file_path},
    output_types={"detected_text_blocks": [], "total_objects_counter": 0} = []
)

# Detect the objects in the image
detected_objects = object_detection_tool.execute({"image": input_file_path, "labels": "baseball, basket", "threshold": 0.35, "model_size": "tiny", "save_object": True, "saved_image_path": "detected_objects"})

# Initialize the text detection tool with the first detected text block
