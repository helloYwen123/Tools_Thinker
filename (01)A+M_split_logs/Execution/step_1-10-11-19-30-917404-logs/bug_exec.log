# Extract the bounding box coordinates
bbox_coords = detected_text_blocks[0][0]["bbox"]

# Filter the detected objects based on their bounding box coordinates
filtered_objects = [det for _det in detected_objects["detected_text_blocks"] for bbox in _det["bbox"] if bbox[0][0] > bbox_coords[0] - 50 and bbox[0][1] > bbox_coords[1] - 0 and bbox[2][0] < bbox_coords[2] + 50 and bbox[2][1] < bbox_coords[1] + 0]

# Extract the text associated with the filtered objects
detected_text = text_detection_tool.load_results(filtered_objects)

# Filter the text associated with the objects and extract the bounding boxes
