if detected_objects and results:
    detections = [detected_objects] + [[*bbox, *text, *score] for (bbox, text, score) in results]
    distance_results = {}
    for bbox in detections:
        for letter, score in bbox[2]:
            if letter not in distance_results:
                distance_results[letter] = [bbox, score]
            else:
                distance_results[letter][0].append(bbox)
                distance_results[letter].append(score)
    total_detections = [[*bbox, *letter, *distance_results.get(letter, [])] for (bbox, letter, distance_results) in detections]

    if bottom_bright_wood_2d_box:
