final_result = 0

def count_doors(image_path):
    result = {
        "image_path": image_path,
        "found_objects": {}
    }

    # Detect objects in the image
    objects = Text_Detector_Tool.execute(image=image_path.strip(),
                                   languages=['eng'])

    if objects is not None:
        # Loop through each detected object
        for obj in objects["objects"]:
            object_label = obj.get("label", "")
            image_path = result["image_path"]
            x1, y1, x2, y2 = obj.get("bbox", "")

            # Check if the object is a door
            if object_label in ["door"]:
                found_obj = {
                    "name": object_label,
                    "bbox": [x1, y1, x2, y2],
                    "score": 1.0
                }

                if image_path not in result["found_objects"]:
                    result["found_objects"][image_path] = found_obj
                else:
                    if found_obj["bbox"] < result["found_objects"][image_path]["bbox"]:
                        result["found_objects"][image_path] = found_obj

def main():
    # Call the function
    count_doors("path/to/image.png")

if __name__ == "__main__":
    final_result = count_doors("path/to/image.png")

if final_result == 0:
    print("No doorways visible.")
else:
    print("There are", final_result, "doorways visible.")

