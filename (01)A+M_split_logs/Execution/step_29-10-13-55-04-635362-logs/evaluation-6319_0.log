if __name__ == "__main__":
    # Import necessary imports

    # Initialize the class instances
    detector_tool = Object_Detector_Tool()
    text_tool = Text_Detector_Tool()
    letter_tool = Letter_Detector_Tool()
    depth_tool = Pixel_Depth_Tool()

    # Get object detection result
    detected_objects = detector_tool.execute(image='path/to/deep_image.png', labels=['light brown wooden dresser with 10 drawers'], save_object=True, saved_image_path='detected_objects')

    # Get text detection result
    results = text_tool.execute(image='path/to/text_image.png', languages=["en", "de"], detail=1)

    # Get letter detection result
    letters = letter_tool.execute(image='path/to/letter_image.png')

    # Process letter detection result
    letter_results = []
    for letter in letters:
        filename = letter['output_image_path']
        letter_image = results.get(filename, {}).get('output_image_path')
        letter_images = results.get(filename, {}).get('video_depth_map', [])
        letter_results.append({'bbox': letter['bbox'], 'image': filename, 'depth_map': letter['depth_map'], 'letter': letter['letter'], 'depth': letter['depth']})

    # Iterate over letter_results
    final_result = 'artistic colourful white paper drawing scenario (highlighted by a green box)'
    for result in letter_results:
        if result['letter'] == 'artistic colourful white paper drawing scenario':
            final_result = 'artistic colourful white paper drawing scenario (highlighted by a green box)'
            print('The final result is:', final_result)
            break

    print('final_result:', final_result)


