# Import necessary classes
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool
from letter_detector import Letter_Detector_Tool
from pixel_depth_estimator import Pixel_Depth_Tool

# Define variables
final_result = ""

# Execute image analysis and extract data
detected_objects = {
  'baseball': [],
  'basket': []
}
object_counts = {
  'baseball': 0,
  'basket': 0
}

# Detect objects using the object_detector
detected_objects = Object_Detector_Tool.execute(image='image.jpg', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Detect text using the text_detector
results = Text_Detector_Tool.execute(image='image.jpg', languages=['en', 'de'])

if results:
  detected_text = results[0][1]
  text_confidence = results[0][2]
else:
  detected_text = "No text detected"
  text_confidence = 0

# Detect certain letters using the letter_detector
letters = Letter_Detector_Tool.execute(image='image.jpg')
letter_count = len(letters)

final_result += 'The scene contains ' + str(detected_objects['baseball'][0]['bbox'][0][0] - detected_objects['baseball'][0]['bbox'][2][0] + ' doors.'
final_result += ' (' + str(detected_objects['basket'][0]['bbox'][0][0] - detected_objects['basket'][0]['bbox'][2][0] + ')'  if letter_count == 0 else ' ' + 'A ' + str(letter_count) + ' doors.')
final_result += ' and a total of ' + str(detected_text) + ' detected letters. Both baseball and basket are detected. ' if letter_count == 0 else 'Basket was not detected.'  + 'The correct count was expected to be ' + str(object_counts['basket'][0]) + ' as indicated by the legend.' if letter_count == 0 else 'Basket was ' + str(letter_count) + ' detected. Overall accuracy is: ' + str(object_counts['basket'][0]) / int(letter_count) * 100
final_result += f'meaning {object_counts["baseball"]} more likely than an average baseball or basket. Both bases are close to, yet not entirely within the basket.'
final_result += f'Note: {detected_text} detected by {letter_count} detected letters'

# Print the final result
print(final_result)

