def text_detection(image_path, languages, details):
    text_results = []
    
    for language in languages:
        detection_results = Text_Detector_Tool.execute(image_path=image_path, languages=[language], detail=details)
        for detection_result in detection_results:
            if detection_result[1] != '' or detection_result[2] != '':
                text_results.append([[[int(detection_result[4]), int(detection_result[7]), int(detection_result[8]), int(detection_result[11])], detection_result[1], detection_result[2]]])
    
    return text_results
    
