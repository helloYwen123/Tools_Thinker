final_result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en', 'de'])[0][0][0]  # Detect English and German text

if final_result:
    
    detected_languages = final_result[1][1]
    languages_used = [result[1][1] for result in final_result]

    for language in languages_used:
        for det_lang in detected_languages:
            if det_lang == language:
                detected_languages.remove(det_lang)
else:
    detected_languages = False

if detected_languages:
    print("detected_languages:", detected_languages)
    print("languages_used:", languages_used)
else:
    print("No detected languages found.")

