```python
import object_detector

def relative_positions():
    image_path = 'image_directory'/6137_0.png
    labels = ['Window', 'Brown Square Dresser']
    threshold = 0.35
    model_size = 'tiny'
    
    detected_objects = object_detector.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size)
    object_number = object_detector.object_number(image_path=image_path)
    
    print("Detected Objects:")
    for label, detections in detected_objects.items():
        if label == 'Window':
            bxs = [d['box'] for d in detections if d['score'] > 0.35]
            print(f'{label}: Bx: {bxs}, Score: {d['score']}')
    
    print(f"Total Objects: {object_number['window']}")

relative_positions()
```

