# Calculate the approximate distance from brown wooden dresser with three drawers (highlighted by a blue box) to Television (highlighted by a red box) based on pixel-level depth estimation
depth_estimation_results = Pixel_Depth_Tool.execute(output=True, video_path=['assets/video1.mp4'])

depth = np.zeros(256, 256)
for _, depth_img in depth_estimation_results.items():
    depth = depth | (depth_img == 0)

# The depth map is likely to be more accurate than the bounding box coordinates
# Estimate the distance from the brown wooden dresser with three drawers to the Television based on the depth map
brown_distance = np.sum(depth, axis=(2, 1))  # Only one dimension needed for distances
television_distance = max(brown_distance)  # Choose the larger distance estimate

final_result = "above" if television_distance < brown_distance else "below"  # Choose the position based on the relative distances to the dresser and the TV

