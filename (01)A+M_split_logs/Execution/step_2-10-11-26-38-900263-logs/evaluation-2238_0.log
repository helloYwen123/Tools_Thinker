import Image
import numpy as np

def get_bbox_and_score(image_path, languages, detail=0):
    detected_objects = []
    for language in languages:
        results = Text_Detector_Tool.execute(image=image_path, languages=[language])
        box_details = results[0][0][::, language].squeeze()
        for lang_data in box_details:
            lang_results = Letter_Detector_Tool.execute(image_lang=lang_data[1])
            detected_objects.append([box Details=lang_data[3], *lang_results])
        font_size = lang_data[2] + 20  
        image = Image.open(image_path).convert("RGB")
        image = (image.convert("L") * 0.018) + (lang_results[0][1] - font_size) 
        new_width = min(lang_results[0][1] // (lang_results[2]) + 10, image.size[0])    
        new_height = min(lang_results[0][2] // (lang_results[2]) + 10, image.size[1])    
        
        new_img = image.crop(((10,10),(lang_results[0][1] - font_size,new_height),(lang_results[0][2] - font_size,new_height)))
        new_img = ImageTk.PhotoImage(new_img.resize((new_width, new_height)))
        font_size = min(10, font_size)
        new_img = Image.blend(new_img, new_img.resize((font_size, font_size)), 0.6)
        
        new_img.save('output_image.png', 'PNG', 'L')
        font = ImageFont.truetype("arial.ttf", font_size)
        new_img = ImageDraw.Draw(image).text(((new_width / 2 - font.size[0] / 2), (height / 2 - font.size[1] / 2)), f"Here comes the {language} word!", font=font)
        detected_objects.append([box Details=lang_results[0], *lang_data[3], *new_img.getsize(), new_img, [f"{lang_results[0][1]} {lang_results[0][2]}"]])
    return detected_objects

def answer_question(image_path, x, y, x2, y2):
    final_result = []
    for res in detected_objects:
        if res[0][0][0][1] < x2 and res[0][0][1] > x and res[0][0][2] < y2 and res[0][0][3] > y:
            final_result.append("below")
            continue
        elif res[0][0][1] > x and res[0][0][3] > y and res[0][0][2] < y2 and res[0][0][0] < x2:
            final_result.append("above")
            continue
    return final_result[0]

