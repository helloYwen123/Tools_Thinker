from tools.text_detector import Text_Detector_Tool

# Read the image file
image_path = 'path/to/image.png'

# Detect text in the image with multiple languages
result = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])

# Extract the detected text blocks from the result
detected_text_blocks = []
for block in result:
    if block[1] == 'Detected text':
        detected_text_blocks.append(block)

# Calculate the total number of detected text blocks
number_of_detected_blocks = len(detected_text_blocks)

# Generate a JSON object using the Python object to list
json_output = {
    "detected_blocks": detected_text_blocks,
    "number_of_detected_blocks": number_of_detected_blocks
}

# Convert the Python object to a JSON object
final_result = JSON.dumps(json_output)

print(final_result)

