from object_detector import Object_Detector_Tool

# Set up the detection parameters
output_format = "detected_objects"
threshold = 0.25
model_size = "tiny"

# Define the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/521_0.png"

# Initialize the object detection tool
object_detector = Object_Detector_Tool()

# Execute the object detection
result, object_number = object_detector.execute(image=image_path, labels=["baseball", "basket"], threshold=threshold, model_size=model_size, save_object=False)

# Export detected objects and detect_objects
exported_result = object_detector.export_object(result, object_number)

# Finalize the analysis
final_result = {
    "total_objects_detected": len(result),
    "objects_detected": exported_result
}

# Display the final result
