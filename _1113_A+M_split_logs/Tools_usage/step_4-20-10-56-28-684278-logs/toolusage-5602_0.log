# Import the object detection tool
from Object_Detector_Tool import object_detector

# The image file path provided in the question
image_file_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5602_0.png"

# Input labels to detect. In the given example, only the 'baseball' and 'basket' labels are mentioned
labels_to_detect = ["baseball", "basket"]

# Define the confidence threshold for detection
threshold = 0.35

# Define the model size
model_size = 'tiny'

# Initialize the object detector
object_detector_results = object_detector(image_path=image_file_path, labels=labels_to_detect, threshold=threshold, model_size=model_size)

# Collect the result
original_results = object_detector_results['objects']

# Check if the 'baseball' label exists in the original result and print its count
if 'baseball' in original_results['objects']:
    count = len(original_results['objects'][0])
    print(f"The number of detected baseballs in the image is {count}.")
else:
    print("No baseballs detected in the image.")

# Get the final answer
final_result = f"The number of baseballs detected in the image is {count}."
print(final_result)
