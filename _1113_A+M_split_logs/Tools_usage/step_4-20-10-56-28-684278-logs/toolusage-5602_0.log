# Import required tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Define question parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5602_0.png"
label = "baseball, basket"

# Execute object detection tool
object_result = Object_Detector_Tool.execute(image_path, [label], save_object=True, saved_image_path="detected_objects")

# Execute text detection tool
text_result = Text_Detector_Tool.execute(image_path, languages=["en", "de"])

# Extract object labels
object_labels = [obj_label["box"] for obj_label in object_result["detected_objects"]]

# Process text detection
text_result = text_result["result"]
text_labels = [text_labels[i].text for i in text_result["index"]]

# Count objects
object_count = len(object_labels)
text_count = len(text_labels)

# Calculate final result
final_result = {"objects": object_count, "texts": text_count}
if object_count != 0:
    final_result["detected_objects"] = object_result["detected_objects"]

if text_count != 0:
    final_result["text_blocks"] = text_result["result"]

final_result
