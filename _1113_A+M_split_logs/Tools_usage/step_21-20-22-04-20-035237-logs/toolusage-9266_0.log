def count_chairs(image_path):
    # Load the image and convert it to a tensor
    img = cv2.imread(image_path)
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    # Apply the ground detection model
    predictions, labels = detect_model(img)

    # Initialize the number of chairs
    chair_count = 0

    # Loop through the detected objects
    for obj in predictions["boxes"]:
        # Check if the object is a chair
        if obj[1] == 2:
            chair_count += 1

    return chair_count

# Function to execute the text detection tool
def detect_text(image_path, languages, detail):
    result = []
    for language_code in languages:
        try:
            # Convert the path to an image
            img = cv2.imread(image_path)
            # Apply the detection model
            result.extend(text_detector(img, language_code, detail))

        except Exception as e:
            print(f"Failed to detect text in image: {image_path}", e)

    return result

