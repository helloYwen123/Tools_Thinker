from Object_Detector_Tool import Object_Detector_Tool as OD

def recognize_counter_tops(image_path, save_object=True):
    result = OD.execute(image=image_path, labels=['CounterTops'], save_object=save_object)

    counter_tops_count = {}
    for label, entries in result.items():
        counter_tops_count[label] = len(entries)

    return counter_tops_count

final_result = recognize_counter_tops("/nfs/data8/liao/wxie/SAT/SAT_images_train/13089_0.png")
print(f"Number of CounterTops: {final_result['CounterTops']}")
