from object_detector import Object_Detector_Tool

# Call object detector tool with the image path and labels
result = Object_Detector_Tool.execute(image='/path/to/image.png', labels=['counter', 'Table', 'Sink'], save_object=True) 

# Check if objects were detected
if len(result['counter']) >= 1 and len(result['Table']) >= 1 and len(result['Sink']) >= 1:
    objects_detected = result['counter'][0]['box'][0]  # First object's bounding box
    counter_number = len(result['counter']) + 1  # Counting the counter
    sink_number = len(result['Sink']) + 1  # Counting the sink

    final_result = {"counters": {"baseball": {"number_detected": counter_number}, "table": {"number_detected": sink_number}}, 
                    "total_objects": {"baseball": 1, "table": 0, "sink": 0}}
else:
    final_result = None

print(final_result)

