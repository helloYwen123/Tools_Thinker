from object_detector import Object_Detector_Tool

# The image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11380_0.png"

# Labels to detect
labels = ["baseball", "basket"]

# Confidence threshold for detection
threshold = 0.35

# Type of model
model_size = "tiny"

# Save detected objects
save_object = False

# Save object images
saved_image_path = "detected_objects"

#Execute the tool
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
final_result = {"detected_objects": detected_objects, "object_number": object_number}

