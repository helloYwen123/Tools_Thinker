from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['door'], save_object=True, saved_image_path='detected_objects')

if isinstance(final_result, tuple):
    detected_objects = final_result[0]
    object_numbers = final_result[1]

    if object_numbers:
        door_count = object_numbers['door'][0]
    else:
        door_count = 0

    print(f'Number of doorways: {door_count}')
else:
    print("The tool could not be executed.")

