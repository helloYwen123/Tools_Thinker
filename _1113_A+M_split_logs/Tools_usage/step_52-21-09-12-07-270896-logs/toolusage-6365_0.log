from object_detector import Object_Detector_Tool

# Set the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6365_0.png"

# Define the language filter (in this case, English and German are considered)
languages = ["en"] + ["de"]

# Set the level of detail to 1
detail = 1

# Execute the TextDetectorTool to detect text in the image
result = Object_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)

# Check if text detection failed
if result:
    detected_objects, object_number = result

    # Extract the detected objects and calculate the object count
    object_count = {}
    for label in detected_objects:
        if label["box"][0] < 0 or label["box"][1] < 0 or label["box"][2] > image_path.shape[1] or label["box"][3] > image_path.shape[1]:
            print(f"Error: Object {label['box'][0]} {label['box'][1]} {label['box'][2]} {label['box'][3]} out of image bounds")
            continue
        if label["box"][0] < 0 or label["box"][1] < 0 or label["box"][2] > image_path.shape[1] or label["box"][3] > image_path.shape[1]:
            print(f"Error: Object {label['box'][0]} {label['box'][1]} {label['box'][2]} {label['box'][3]} out of image bounds")
            continue
        object_count[label["box"]] = object_count.get(label["box"], 0) + 1

    # Output the results
    final_result = {"detected_objects": detected_objects, "object_number": object_number, "total_object_count": object_count}
else:
    print("No detected objects found in the image.")

