# The paths of the images
image_path1 = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3003_0.png"
image_path2 = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3004_0.png"

# Detect the text in the first image
result_1 = Object_Detector_Tool.execute(image=image_path1, languages=["en", "de"])['detected_objects'][0]['object_number']
final_result = len(result_1)
if result_1:
  print(f"The total number of detected objects in the first image is {final_result}.")
else:
  print("Failed to detect any additional objects in the first image after retries.")

# The path of the second image
image_path1 = image_path2

