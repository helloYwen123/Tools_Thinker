def count_paintings(image_path):
    from object_detector import Object_Detector_Tool

    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=['painting'], threshold=0.35)

    if 'basketball' in detected_objects[0][1] or 'baseball' in detected_objects[0][1]:
        print("No, there are no paintings visible in the scene.")
        print("The basketball found may indicate an error in object detection or the scene may not contain paintings.")
