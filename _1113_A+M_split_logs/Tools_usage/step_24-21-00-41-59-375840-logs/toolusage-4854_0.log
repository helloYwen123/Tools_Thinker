from object_detector import Object_Detector_Tool

# Set the input path and other parameters
input_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4854_0.png"
labels = ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

# Execute the object_detection script
output = Object_Detector_Tool.execute(image=input_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Define the result class and its attributes
class ObjectResult:
    def __init__(self, object_name, labels_results):
        self.label_name = object_name
        self.labels_results = labels_results

# Create the result object and calculate the count of the object
object_result = ObjectResult('baseball', output[0]['baseball'])
count = 0
for label in output:
    count += label['labels_results']

# Generate the final result
result = {
    "labels": labels,
    "count": count
}
result["detected_objects"] = {}
for label in output:
    for obj_result in label["labels_results"]:
        object_result.label_name = label['label_name']
        break
    result["detected_objects"][label['label_name']] = [obj_result]
final_result = result

