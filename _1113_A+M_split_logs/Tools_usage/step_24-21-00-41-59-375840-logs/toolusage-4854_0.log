from object_detector import Object_Detector_Tool

final_result = {"count": 1, "categories": {"baseball": 1, "basket": 2}}


def count_dining_tables(image_path):
    """
    Counts the number of dining tables in the image path.
    :param image_path: Path to the image file.
    :return: The number of dining tables in the image.
    """
    try:
        detect_obj = Object_Detector_Tool(image_path)
        dining_tables = sum(1 for entry in detect_obj['detected_objects']['baseball'] if entry['score'] > 0.9)
    except Exception as e:
        print(f"Error while counting dining tables: {e}")
        dining_tables = 0

    return dining_tables

final_result = {"count": count_dining_tables("/nfs/data8/liao/wxie/SAT/SAT_images_train/4854_0.png"), "categories": {"baseball": 1, "basket": 2}}
print("Number of DiningTables within the specified image:", final_result['count'])
final_result.update({"count": 0, "categories": {}})
print("Number of DiningTables outside the specified image:", final_result['count'])

