from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image=r'/nfs/data8/liao/wxie/SAT/SAT_images_train/11490_0.png', labels=['chair'], threshold=0.35, model_size='small', save_object=True, saved_image_path='detected_objects')
