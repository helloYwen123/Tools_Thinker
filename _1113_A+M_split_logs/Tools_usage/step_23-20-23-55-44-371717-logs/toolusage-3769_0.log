from object_detector import Object_Detector_Tool

saved_image_path = "/path/to/save/image.png"  

input_image = "/path/to/image.png"

labels = ["baseball", "basket"]

threshold = 0.35

object_numbers = {}

detected_objects = Object_Detector_Tool.execute(image=input_image, labels=labels, save_object=True, saved_image_path=saved_image_path, threshold=threshold)

final_result = [{"label": "baseball", "num_objects": detected_objects["baseball"]}]

for detected_object in detected_objects:
    label = detected_object["label"]
    obj_box = detected_object["box"]
    label_details = detected_object["label"].split(', ')

    if label not in object_numbers:
        object_numbers[label] = {"num_objects": 0}

    object_numbers[label]["num_objects"] += 1

    if obj_box[3] < saved_image_path or obj_box[4] > saved_image_path:
        object_numbers[label]["num_objects"] -= 1

final_result = [final_result]
for label, details in object_numbers.items():
    final_result.append({"label": label, **details})

print("Object Numbers")
for label in object_numbers:
    print(f"{label}: {object_numbers[label]['num_objects']}")
print("\nFinal Recognized Labels")
print(final_result)

