from Object_Detector_Tool import Object_Detector_Tool

def detect_objects(image_path, labels, threshold, model_size='tiny', save_object=False):
    if labels is None:
        labels = ['baseball', 'basket']
    else:
        labels = list(set(labels).difference(['baseball', 'basket']))
    
    if model_size == 'tiny':
        detector = Object_Detector_Tool()
        det = detector.execute(image=image_path, labels=labels, threshold=threshold)
        object_list = []
        object_count = {}
        
        # Detecting objects
        for label in labels:
            object_list.append(det['labels'][0]['box'])
            object_count[label] = det['labels'][0]['score']
            
        # Counting objects
        count = 0
        for label, score in object_count.items():
