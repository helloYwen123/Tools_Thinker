from object_detector import Object_Detector_Tool

# Call the Object_Detector_Tool with the given image, labels, threshold, model size, and save_object option
final_result = Object_Detector_Tool.execute(image="path/to/image.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

print("Detected Objects and Count:")
print("- {}: {}".format(final_result["object_number"]["baseball"], final_result["object_number"]["basket"]))
print("- Objects Detected: {}".format(len(final_result.get("detected_objects", []))))

