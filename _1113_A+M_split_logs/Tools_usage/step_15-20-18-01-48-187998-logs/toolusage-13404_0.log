from object_detector import Object_Detector_Tool

def count_chairs(image_path, chair_labels=['chair']):
    object_detector_tool = Object_Detector_Tool()
    detected_objects = object_detector_tool.execute(image_path, chair_labels)

    if 'baseball' in detected_objects and 'basket' in detected_objects:
        chair_count = detected_objects['basket'].count(getattr(detected_objects['basket'][0], 'box'))
        chairs_count = len(detected_objects) - chair_count
        return chairs_count, chair_count

    return 0

final_result = count_chairs('path_to_your_image.png')
print('Total numbers of chairs in the scene: ', final_result[1], ' with ', final_result[0], '椅子.')
