from Object_Detector_Tool import Object_Detector_Tool, saved_object_path

class Sofa:
    def __init__(self):
        self.number = 0

    def count_sofas(self):
        if self.number <= 2:
            print("There are 2 Soffas in the scene.")
        elif self.number > 2:
            print(f"There are {self.number} Soffas in the scene.")

    def get_number_sofas(self):
        return self.number

def main():
    sofa = Sofa()

    # Detect any sofas in the image
    results = Object_Detector_Tool.execute(image="/path/to/image.png", save_object=True, label=["sofa"])

    for det in results[0][:"baseball",0,0].result:
        for reco in det[12:180, 40, 0].result:
            sofa.number +=1
            print(f"A sofa with coordinates [{recov[0]}-{recov[1]}] [{recov[2]}-{recov[3]}] is a sofa in the image.")

    # Print the number of sofas
    sofa.count_sofas()

if __name__ == "__main__":
    main()
