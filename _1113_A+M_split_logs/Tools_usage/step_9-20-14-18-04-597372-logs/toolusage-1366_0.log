import object_detector as od

def detect_objects(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    labels_map = {}
    total_objects = {}

    # Detect objects
    result = od.Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    total_objects["objects_detected"] = result.object_number

    # Detect objects (example: detect basketball)
    for label, block in result.detectable_objects:
        object_info = {'object': label, 'score': result.objects_score[label]['scores']['class_1']]
        if label in labels_map:
            if block[0][0] > labels_map[label][0]:
                labels_map[label] = block[0][0]
                # Save detected object image
                if save_object:
                    save_image_path = f"{saved_image_path}/{label}_detected_{result.objects_score[label]['scores']['bbox'][0]}-{result.objects_score[label]['scores']['bbox'][1]}" 
                    od.Text_Detector_Tool.execute(image="path/to/image.png", languages=['en', 'de'], detail=0, path=save_image_path)
        else:
            labels_map[label] = block[0][0]
            object_info['name'] = label

        total_objects[label] = len(block[0:][0])

    return total_objects, labels_map

total_objects, labels_map = detect_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/1366_0.png", ["baseball", "basket"], save_object=True, saved_image_path="detected_objects/")
final_result = object_detection.generate_output(final_result, total_objects=total_objects, detected_label=label)
