from object_detector import Object_Detector_Tool

# Execute the Object Detector Tool with the provided parameters
result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

object_labels = {}
total_basket = 0
total_baseball = 0

for det in result:
    detected_label = det["label"]
    box = det["box"]
    score = det["score"]
    saved_image_path = str(det["saved_image_path"])

    if detected_label == 'baseball':
        total_baseball += 1
    else:
        total_baseball += len(det["label"])  # Count every label

    if detected_label == 'basket':
        total_basket += 1
    else:
        total_basket += len(det["label"][:-1])

    object_label = None
    if detected_label.lower() in ('baseball', 'basket', 'tennis'):
        object_label = detected_label

    object_labels[object_label] = [(box[0], box[1], box[2], box[3]), score]

print("Total Baseballs: ", total_baseball)
print("Total Baskets: ", total_basket)

for label, obj in object_labels.items():
    for item in obj:
        print("Object: ", label)
        print("Bounding Box: ", int(item[0]), ", ", int(item[1]), ", ", int(item[2]), ", ", int(item[3]))

