from object_detector import Object_Detector_Tool as ODTC

# Define command path for image and labels
command = 'detected_objects, object_number = ODTC.execute(image="path/to/image.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")'

# Execute the command
result = ODTC.execute(command, languages=['en', 'de'])

# Process the results
def process_results(result):
    if result and result['detected_objects']:
        object_labels = [obj['saved_image_path'].split('/')[-1].split('.')[0] for obj in result['detected_objects']]
        final_result = {
            'count': result['object_number'].get('baseball', 0) + result['object_number'].get('basket', 0),
            'objects': object_labels
        }
        detection_entries = [{'box': box['box'], 'score': score} for box, score in result['detected_objects']]
        image_path = f'delected_objects/{final_result["count"]}.png'
        ODTC.save_object(detection_entries, saved_image_path=image_path)

# Call the function to process the results
process_results(result)

