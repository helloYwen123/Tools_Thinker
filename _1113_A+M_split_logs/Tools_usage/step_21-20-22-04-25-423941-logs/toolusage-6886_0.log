from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Set the image path and labels
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6886_0.png"
labels = ["baseball", "basket"]

# Run the tool with the desired parameters
result_object = Object_Detector_Tool.execute(image=image_path, labels=labels)
result_text = Text_Detector_Tool.execute(image=image_path, languages=["en", "de"])
if result_text:
    detected_objects = result_text[0][0]  # Extract the block with bounding box and text from the list
    detected_text = result_text[0][1]  # Extract the text
    text_confidence = result_text[0][5]  # Extract the confidence score

    final_result = {"objects": [],
                     "text_score": 0.}
    if detected_objects:
        final_result["objects"].append({"bbox": detected_objects[0]["box"],
                                         "text": detected_objects[0]["text"],
                                         "score": detected_objects[0]["score"]})

    if text_confidence > 0.5:
        final_result["text_score"] = text_confidence
        final_result["text"] = detected_text
final_result = {f"objects": [final_result]}

