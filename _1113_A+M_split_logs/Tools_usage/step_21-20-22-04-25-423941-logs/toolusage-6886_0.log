# Function to run object detection and return the number of paintings
def count_paintings(image_path, languages=None, detail=None):
    detections = Object_Detector_Tool.execute(image_path, languages, detail)
    painting_count = sum(1 for label, detection in detections if "baseball" in label and "basketball" in label)
