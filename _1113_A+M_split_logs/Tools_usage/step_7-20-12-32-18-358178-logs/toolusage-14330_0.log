    if label == vases_label and detected_objects_result[label][-1]["score"] > 0.35:
        for detection_entry in detected_objects_result[label]:
            box = (detection_entry["box"]["x0"], detection_entry["box"]["y0"], detection_entry["box"]["x1"], detection_entry["box"]["y1"])
            confidence_score = detection_entry["score"]
            saved_image_path = "detected_objects/image_" + label + "_" + str(detection_entry["scores"]) + ".png"
            final_result["vases"] += 1
            detected_objects_result[label].append({"box": box, "score": confidence_score, "saved_image_path": saved_image_path})

text_object_result = []

for language_codes, detection_results in text_detector_result.items():
    text_blocks_result = []
    for detection_entry in detection_results:
        box = (detection_entry["box"]["x0"], detection_entry["box"]["y0"], detection_entry["box"]["x1"], detection_entry["box"]["y1"])
        text = detection_entry["suggested_text"]
        confidence_score = detection_entry["confidence"] * 100
