object_number = {}

# Load the image file
with open("/nfs/data8/liao/wxie/SAT/SAT_images_train/14330_0.png", "rb") as f:
    input_image = f.read()  

# Detect objects 'baseball' and 'basket'
result = Object_Detector_Tool.execute(image=input_image, labels=['baseball', 'basket'], saved_object=True)
detected_objects, object_number = result

# Extract coordinates and confidence scores for "basket"
basket_coordinates = [(int(x), int(y)) for x, y in zip(*detected_objects[0]['box'])]
basket_confidence = detected_objects[0]['score']

# Extract coordinates and confidence scores for "baseball"
baseball_coordinates = [(int(x), int(y)) for x, y in zip(*detected_objects[1]['box'])]
