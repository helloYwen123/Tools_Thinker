from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def detect_paintings(image_path, language_codes, detail=0):
    return {"detected_objects": [],
            "object_number": {}}

try:
    result = Object_Detector_Tool.execute(image=image_path, languages=language_codes, detail=detail)
    if not result:
        return {"detected_objects": [],
                "object_number": {}}

    if "baseball" in result["detected_objects"]:
        detected_objects = result["detected_objects"]["baseball"]
        object_number = {"baseball": len(detected_objects["box"])}
    else:
        detected_objects = result["detected_objects"]["basket"]
        object_number = {"basket": len(detected_objects["box"])}
    
    output = [detected_objects]
    if isinstance(detected_objects, dict):
        obj_names = list(detected_objects.keys())
        num_objs = obj_names.count("baseball")
        output.append({"obj_names": obj_names, "object_number": {"baseball": num_objs}})
        output.append({"obj_names": ["baseball"] + obj_names, "object_number": {"basket": num_objs}})
    return {"detected_objects": output, "object_number": object_number}
except Exception as e:
    return {"detected_objects": [], "object_number": {}}


if __name__ == "__main__":
    pass
