```python
from object_detector import Object_Detector_Tool

def count_dressers(image_path, labels, save_objects=False, saved_image_path=""):
    # Initialize the detection object
    object_detector_tool = Object_Detector_Tool()
    
    # Execute object detection
    detected_objects, object_number = object_detector_tool.execute(image_path, labels, save_objects, saved_image_path)
    
    # Calculate the total count for dressers
    dresser_count = [len([x for x in detected_objects['baseball'] if x['saved_image_path'] == path_to_dresser_image]) for path_to_dresser_image in detected_objects['baseball']]
    
    return {'dresses': dresser_count}

# Example usage
if len(sys.argv) == 2:
    image_path = sys.argv[1]
    labels = ["baseball", "basket"]
        
    print(f"Total count of dressers: {count_dressers(image_path, labels)}")
else:
    print("Please provide a path to the image file.")
```
