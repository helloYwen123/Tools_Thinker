from object_detector import Object_Detector_Tool

result = Object_Detector_Tool.execute(image='path/to/3d_room.png',
                                      labels=['dresser', 'table'],
                                      save_object=False,
                                      threshold=0.8,
                                      model_size='base')

final_result = {
    "dresses": []
}

for det in result:
    if "basketball" in det:
        final_result['dresses'].append({1: det})

for det in result:
    if "basketball" not in det:
        final_result['dresses'].append({1: det})

if 'baseball' in final_result:
    final_result['baseball']['score'] = final_result['baseball'].pop("score", None)
    final_result['basketball']['score'] = final_result['basketball'].pop("score", None)

final_result['object_number'] = len(final_result['dresses'])
print("final_result:", final_result)
```
