```python
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Load the image from the given path
image_path = '/path/to/image.png'  # Replace with the actual image path
image = Image.open(image_path)

# Initialize the object_detector tool with the image
tool = Object_Detector_Tool()
tool.execute(image=image, labels=['baseball', 'basket'])

# Get the detected objects
detected_objects = tool['detected_objects']

# Get the number of detected objects
object_number = tool['object_number']

# Initialize the text_detector tool with the language(s) and the desired level of detail
tool_languages = ['', 'en', 'de']  # Replace with the actual languages if needed
language = tool_languages[0]  # Change to desired language
level = tool_languages.index(language)

# Initialize the text_detector tool
tool_texts = Text_Detector_Tool()

# Use the text_detector tool with the language and level of detail
result = tool_texts.execute(image=image, languages=tool_languages, level=level)  # Replace with desired language and level of detail

# Check if text detection was successful
if not result['result']:
    detected_objects = []
else:
    detected_objects = []
    detected_objects_text = []
    for block in result['result']:
        detected_objects.append(block[1])
        detected_objects_text.append(block[0][1])

# Set the final result based on the obtained entities.
final_result = {'detection_tool': tool, 'total_detections': object_number, 'detected_objects': detected_objects, 'detected_objects_text': detected_objects_text}

# Output the results
print("Number of detected objects: ", object_number)
print("Detected objects: ")
for i, obj in enumerate(detected_objects):
    print(f"Detection for label {i}: [{' '.join(map(str, obj))}]")
```
