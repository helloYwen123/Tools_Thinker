from object_detector import Object_Detector_Tool

# Parameters for the tool
image_path = "path/to/image.png"
labels = ['baseball', 'basket']
threshold = 0.35
model_size = 'tiny'
save_object = True
saved_image_path = "detected_objects"

# Execute the tool
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
final_result = f"Total detected objects: {len(detected_objects['baseball']) + len(detected_objects['basket'])}\nTotal detected labels: {len(detected_objects)}"
print(f"Object Detection Result: {final_result}")

