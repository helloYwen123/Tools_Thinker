from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_windows(img_path, languages=['en', 'de'], detail=1):
    detected_objects = []
    object_number = {}
    if "png" not in img_path:
        return detected_objects, object_number

    try:
        objects = Object_Detector_Tool.execute(image=img_path, labels=languages, threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects")
        for detected_obj in objects[0]:
            for l in detected_obj[1]:
                object_number.get(l, 0) += 1
            detected_objects.append([detected_obj[1], detected_obj[3], saved_object(img_path, detected_obj[3])]
    except Exception as e:
        return [], []

    final_result = []
    txt_detected = []
    for det_obj in detected_objects:
        if 'box', 'score' in det_obj[1]:
            for l in languages:
                try:
                    boxes = det_obj[1][l]['box']
                    boxes.insert(len(boxes), [detected_obj[1][l]['bbox'][0], detobj[1][l]['bbox'][1], detobj[1][l]['bbox'][2], detected_obj[1][l]['bbox'][3]])
                    txt_detected.append([detected_obj[0], det_obj[0] + " detected")
                except:
                    pass
            final_result.append([boxes, det_obj[0] + " detected", det_obj[1][len(languages)]])

    final_result = final_result[1:]
    txt_detected = txt_detected[1:]
    txt_detected = [l.split(" ")[0] for l in txt_detected]

    return final_result, {detected_obj[0]: object_number[detected_obj[0]] for detected_obj in objects}
detected_windows, object_number = count_windows("/nfs/data8/liao/wxie/SAT/SAT_images_train/1335_0.png")
