from object_detector import Object_Detector_Tool

# Path to the image file
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/1272_0.png'

# Model size
model_size = 'base'

# Labels to detect
labels = ['baseball', 'basket']

# Confidence threshold
threshold = 0.35

# Output save path
output_save_path = 'detected_objects'

# Run the tool
result = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path=output_save_path)

# Extract object detections
object_detections = result[1]

object_number = result[0]

final_result = f"The scene contains {object_number} {labels}."

is_output_format_helpless = isinstance(object_detections[0][2], int) and all(not isinstance(entry[2], dict) for entry in object_detections[1:])

if is_output_format_helpless:
    print("The output list was not in the expected format.")
else:
    print(f"The detected objects are: {'  '.join([d[1] for d in object_detections[0]])}")

if labels and 'baseball' in labels:
    try:
        # Extract the image paths for each detected object
        image_path_baseball = [d['saved_image_path'] for d in object_detections[0] if d['label'] == 'baseball']
        image_path_basket = [d['saved_image_path'] for d in object_detections[0] if d['label'] == 'basket']

        print("\nDetected baseball and basketball images")

        # Display each image with its detected bounding box and score
        for i, image in enumerate(image_path_baseball):
            plt.figure()
            plt.imshow(im.read())
            cv2.rectangle(im, tuple(image[0]), tuple(image[1]), (0, 0, 255), 2)
            plt.title(f'Baseball Image {i+1} Label: {image[i][1]}')
            plt.xlabel(image[i][1])
            plt.show()

    except KeyError:
        print("No detected baseball pixel detected.")

