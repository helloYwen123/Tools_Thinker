result = Object_Detector_Tool.execute(image=image_path, languages=languages)

if result:
    number_of_objects_per_language = {}
    for i, detected_objects in enumerate(result):
        if i == 0:  # For the first result in the list of detected objects
            objects_detected = detected_objects
        else:
            number_of_objects = sum(1 for detected in detected_objects if detected)
            number_of_objects_per_language[i + 1] = number_of_objects

    if number_of_objects_per_language:
        total_objects = 0
        for languages, language_results in number_of_objects_per_language.items():
            total_objects += sum(1 for detected in detected_objects if detected in languages)

        final_result = {"total_objects": total_objects}
        if not number_of_objects_per_language:
            final_result = {"total_objects": 0}
        else:
            final_result.update(number_of_objects_per_language)
else:
    final_result = {"error_message": "Text detection failed after retries."}

# Convert the result to a dictionary
result_dict = {
    "objects": objects_detected,
    "languages_detected": languages,
    "number_of_objects_per_language": number_of_objects_per_language,
    "total_objects": total_objects,
    **final_result
}

