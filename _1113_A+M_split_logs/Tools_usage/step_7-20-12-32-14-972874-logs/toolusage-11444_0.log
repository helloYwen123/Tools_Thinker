        basket_box = result[2]['basket'][0]
        basket_score = result[2]['basket'][1]
        basket_image_path = 'detected_objects/image_basket_1.png'
    else:
        basket_score = 0

    # Count the total number of baseball and basket objects detected
    if baseball_score > 0 and basket_score > 0:
        total_score = baseball_score + basket_score
    else:
        total_score = 0

    return (
        (
            {
                "label": "Baseball",
                "bbox": baseball_box,
                "score": baseball_score,
                "image_path": baseball_image_path,
            },
            total_score
        ),
        {
