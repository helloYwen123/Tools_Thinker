import numpy as np

def detect_objects(image_path):
    # Define the path to save detected objects to
    saved_object_path = 'detected_objects'

    # Load the image and detect objects
    result = Object_Detector_Tool.execute(image=image_path, labels=list('baseball, basket'), save_object=False)

    # Set a confidence threshold
    conf_threshold = 0.35

    if 'baseball' in result[0]:
        baseball_box = result[1]['baseball'][0]
        baseball_score = result[1]['baseball'][1]
        baseball_image_path = 'detected_objects/image_baseball_1.png'
    else:
        baseball_score = 0

