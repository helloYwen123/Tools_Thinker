from object_detector import Object_Detector_Tool

def count_and_locate_interest_objects(image_path, labels, save_object=True, saved_image_path="detected_objects"):
    result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    if not result:
        print("No text detected or failed after retries.")
        return []
    detected_objects = {}
    total_objects = {}
    for label in labels:
        if label in total_objects:
            total_objects[label] += result[label]
        else:
            total_objects[label] = result[label]
    total_objects_list = sorted(total_objects.items(), key=lambda x: x[1], reverse=True)
    for label, object_count in total_objects_list:
        detected_objects[label] = {"box": [], "score": object_count, "label": label, "saved_image_path": None}
        if object_count > 0:
            for i in range(0, 5):  # 5 attempts
                try:
                    detected_objects[label]["boxed_image_paths"] = []
                    detected_objects[label]["bbox"] = label + "_bbox_" + str(i)
                    box_detection = Object_Detector_Tool.execute(
                        image=image_path,
                        text="text",
                        language=total_objects[label]["text_language"],
                        model_size="base"
                    )
                    if len(box_detection):
                        detected_objects[label]["boxed_image_paths"] = [box_detection[0]["box"] for box_detection in box_detection]
                        break
                    else:
                        detected_objects[label]["bbox"] = None
                except Exception as e:
                    print(str(e), end=" ")
                    if i == 4:
                        detected_objects[label]["bbox"] = None
                        break
                    continue
                break
            detected_objects[label]["bbox"] = ["100, 150", "100, 250", "200, 200", "200, 250", "100, 50"]
            detected_objects[label]["bbox"].append("120, 250")
            detected_objects[label]["bbox"].append("120, 250")
    return detected_objects

