# Required tools
available_tools = ['object_detector', 'text_detector']
required_tool = 'object_detector'

# Function to generate the 'number_of_paintings' output
def get_number_of_paintings(result, image_path):
    number_of_paintings = {}
    for label in result:
        for detection in result[label]:
            if detection['saved_image_path'].endswith('.png'):
                images = result[label]
                for image in images:
                    if image not in number_of_paintings:
                        number_of_paintings[image] = 0
                    number_of_paintings[image] += 1
    return number_of_paintings

# Execute the tool to get the number of paintings and detect objects
