from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['door'], save_object=True, saved_image_path='detected_objects')
detected_objects = final_result[0]
object_number = final_result[1]

if detected_objects:
    detected_objects = [{'box': detected_objects[i]['bounding_box'], 'score': detected_objects[i]['score'], 'saved_image_path': detected_objects[i]['saved_image_path']} for i in range(len(detected_objects))]
else:
    detected_objects = []

for i, bbox in enumerate(detected_objects):
    print(f"Detected object at bounding box: {bbox}, score: {detected_objects[i]['score']}")
    print(f"Saved image path: {detected_objects[i]['saved_image_path']}")
else:
    print("No detected objects found.")

result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en'])
text_boxes = result[0]
for box in text_boxes:
    print(f"Detected text at bounding box: {box['bounding_box']}, confidence: {box['confidence']}")

