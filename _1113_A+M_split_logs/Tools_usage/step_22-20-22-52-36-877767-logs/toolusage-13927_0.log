from object_detector import Object_Detector_Tool

def count_shelving_units(image_path):
    # Use the object_detector to detect "baseball" and "basket"
    tool_args = {
        "labels": ["baseball", "basket"],
        "threshold": 0.35,
        "model_size": "tiny",
        "save_object": False,
    }
    detected_objects = Object_Detector_Tool.execute(image=image_path, **tool_args)
    
    # Initialize total number of objects detected in the image
    total_objects_count = {'baseball': 0, 'basket': 0}
    
    # Process each detected object
    for label, results in detected_objects['baseball']:

        # Calculate total number of objects in the image
        total_objects_count['baseball'] += len(results)

        # Process each detected object
        for result in results:
            # Exclude baseball from count
            if "baseball" not in result['label']:
                total_objects_count["basket"] += result['score']

    # Filter only "baseball" objects to exclude basket objects
    baseball_count = total_objects_count['baseball']

    # Process image using text_detector
    result = Tool.execute(image=image_path, languages=['en', 'de'], detail=1)

    # Filter text according to the required text
    text_blocks = [[[x[0, 0], x[0, -1], x[1, -1], x[1, 0]], f'Found {number}', y] for x in result for (number, y, box_info) in x['boxes']]
    clean_text_blocks = [x for x in text_blocks if x[0][1] == len(x[3]) and x[0][2] == x[0][3] and x[0][4] == x[0][5]]
    result_text = "\n".join(f'Found {number}' for _, _, number in clean_text_blocks)

    final_result = f"Shelving units: {len(clean_text_blocks)}"

    return {"objects": baseball_count, "result": result_text}, final_result

