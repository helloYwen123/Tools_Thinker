from object_detector import Object_Detector_Tool

class ImageAnalyzer:

    @staticmethod
    def analyze_image(image_path, labels, save_object=True, saved_image_path="detected_objects"):
        detector_tool = Object_Detector_Tool()
        obj_list = detector_tool.execute(image_path, labels, save_object, saved_image_path)
        detected_objects, object_number = obj_list
        return {'detected_objects': detected_objects, 'object_number': object_number}

    def analyze_image2(image_path, languages=['en', 'de']):
        detection_tool = Text_Detector_Tool()
        result = detection_tool.execute(image_path, languages=languages)
        return result

# Sample usage of the ImageAnalyzer class
analyzed_objects = ImageAnalyzer.analyze_image("/nfs/data8/liao/wxie/SAT/SAT_images_train/13477_0.png", ["baseball"], "detect_objects.txt")
analyzed_image, detected_objects = ImageAnalyzer.analyze_image2("/nfs/data8/liao/wxie/SAT/SAT_images_train/13477_0.png", ["en", "de"])

# Check the results
