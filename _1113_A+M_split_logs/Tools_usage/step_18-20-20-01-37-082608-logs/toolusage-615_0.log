from object_detector import Object_Detector_Tool

# Path to the image file
image_path = '/path/to/image.png'

# Language codes to detect
languages = ['en', 'de']

# Number of retries for text detection
text_detection_retries = 5

# Save the detected objects as images if save_object=True
save_objects = True

# Arguments for the Object_Detector_Tool
arguments = {
    "image": image_path,
    "labels": ["baseball", "basket"],
    "save_object": save_objects
}

# Execute the Object_Detector_Tool
detected_objects, object_number = Object_Detector_Tool.execute(**arguments, languages=languages, detail=text_detection_retries)

# Extract and count text blocks with confidence scores
text_blocks = detected_objects[1]
text_blocks = [[block[0], block[1], block[3], block[4]] for block in text_blocks if block[5] > 0.5]  # Filter text blocks with confidence score above 0.5

# Final result
final_result = f'detected objects: {detected_objects}, with object number: {object_number}\n'
final_result += '\n'.join([f'{block[1]}: {block[2]} (score: {block[5] if 'baseball' in detected_objects[1] else ''})' for block in text_blocks if block[3]]) + '\n'
print(final_result)
