def count_paintings_in_image(image_path):
    # Load image and detect bounding boxes
    input_image = Image.open(image_path)
    detector_tool = Object_Detector_Tool(input_image, labels=['Painting'], save_object=True)
    detections = detector_tool.output
    
    painting_count = 0
    for detection in detections['Painting']:
        # Check if the bounding box is within the image size
        x1, y1, x2, y2 = detection['bbox']
        if x2 - x1 > 50 and y2 - y1 > 50:
            painting_count += 1
    
    return painting_count

# Path of the image containing Paintings
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/6515_0.png'

# Count the number of Painting in the image
paintings_count = count_paintings_in_image(image_path)
final_result = paintings_count

