from object_detector import Object_Detector_Tool

def detect_dining_tables(image_path, labels=['DiningTable'], threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects'):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
    object_number = {}

    for label in detected_objects['object_number']:
        object_number[label] = detected_objects['object_number'][label]

    total_dining_tables = sum([v for v in detected_objects['object_number'].values()])
    
    return {
        'total_dining_tables': total_dining_tables,
        'dining_tables': object_number
    }

# Example usage
