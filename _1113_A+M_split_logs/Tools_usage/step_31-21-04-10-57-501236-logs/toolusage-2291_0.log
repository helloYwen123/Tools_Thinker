from Object_Detector_Tool import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['门', '画'], save_object=True, saved_image_path='detected_objects')

if 'num_boxes' in final_result[0].keys():
    doorways = []
    # Loop through each labeled box
    for detected_objects in final_result[0]['Baseball'].data:
        # Check if the detected_object contains a "门" label
        if '门' in detected_objects['name']:
            doorways.append(detected_objects['bbox'])
        # Check if the detected_object contains a "画" label
        elif '画' in detected_objects['name']:
            doorways.append(detected_objects['bbox'])
    num_doorways = len(doorways)

    if not num_doorways:
        print("No doorways found in the image.")
    elif num_doorways == 3:
        print(f"There are 3 doorways in the image.")
    elif num_doorways == 4:
        print(f"There are 4 doorways in the image.")
    else:
        print(f"There are {num_doorways} doorways in the image.")
else:
    print("No objects detected in the image.")

