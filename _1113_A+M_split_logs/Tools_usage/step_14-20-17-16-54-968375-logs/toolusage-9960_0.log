from Object_Detector_Tool import Object_Detector_Tool

# Create an Object_Detector_Tool object
detector_tool = Object_Detector_Tool()

# Set the image path and define which labels to detect (basketball and basket)
image_path = 'path/to/image.png'
labels = ['basketball']
labels.append('basket')

# Set the confidence threshold to 0.35 for each label
confidence_threshold = 0.35

# Define whether to save the detected objects as images
save_object = True

# Set the size of the model used (default: 'tiny')
model_size = 'tiny'

# Execute the detection
(detected_objects, object_number) = detector_tool.execute(image=image_path, labels=labels, confidence_threshold=confidence_threshold, model_size=model_size, save_object=save_object, saved_image_path='detected_objects')

# Print the detected objects and object number
print("Detected objects:")
for label in labels:
    for item in detected_objects['baseball']:
        print(item)

print()
print("Object number:")
for label in object_number:
    print(label, ':', object_number[label])

final_result = ''
if detected_objects:
