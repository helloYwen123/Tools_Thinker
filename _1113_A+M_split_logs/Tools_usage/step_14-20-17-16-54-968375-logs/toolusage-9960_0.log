from Object_Detector_Tool import Object_Detector_Tool

def count_and_locate_objects(image_path):
    try:
        object_detector = Object_Detector_Tool()
        object_labels = object_detector.detect(image_path=image_path, languages=['zh', 'en'], detail=1)
        counted_objects = {}
        for label, detected_objects in object_labels.items():
            counted_objects[label] = sum(1 for obj in detected_objects if obj['score'] > 0.05)
        return counted_objects
    except Exception as e:
        print(f"Error occurred while counting objects: {type(e).__name__}")
        return {}

def find_objects_in_image(image_path):
    try:
        result = Text_Detector_Tool.execute(image=image_path, languages=['zh', 'en'], detail=0)
        return result
    except Exception as e:
        print(f"Error occurred while detecting text: {type(e).__name__}")
        return []

