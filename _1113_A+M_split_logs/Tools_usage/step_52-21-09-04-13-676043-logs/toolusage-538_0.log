def count_chairs(image_path):
    with open(image_path, "rb") as f:
        result = Object_Detector_Tool.execute(image=image_path, labels=['chair'], save_object=True, saved_image_path='image_chairs')  
        chair_count = len(result['image_chairs'])  
    return chair_count

