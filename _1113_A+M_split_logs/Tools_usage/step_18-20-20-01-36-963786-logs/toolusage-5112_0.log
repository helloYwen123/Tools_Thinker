from tool_object_detector_tool import Object_Detector_Tool
from tool_text_detector_tool import Text_Detector_Tool

# Define the image file and the labels for detection
image_file = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5112_0.png'
labels = ['baseball', 'basket']

# Execute the detection based on the object types
detected_objects, object_number = Object_Detector_Tool.execute(image=image_file, labels=labels)

# Define the text detection parameters
_languages = ['en', 'de']
level_of_detail = 0

# Execute the text detection
result = Text_Detector_Tool.execute(image=image_file, languages=_languages, detail=level_of_detail)

# Get the found texts and their coordinates
found_texts = [item[0] for item in result if len(item) > 0]

# Convert the texts into the desired format for the result variable
final_result = detected_objects if type(detected_objects) == dict else {}

# Add the found text coordinates and text to the final result
final_result['found_text_coordinates'] = found_texts

# Write the final result to a file
with open('detected_objects.txt', 'w') as f:
    f.write(str(final_result))

