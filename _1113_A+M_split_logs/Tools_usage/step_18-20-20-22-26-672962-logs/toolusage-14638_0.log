from Object_Detector_Tool import Object_Detector_Tool

def count_chairs(image_path=None, labels=None, threshold=0.35):
    tool = Object_Detector_Tool()
    if image_path:
        detected_objects = tool.execute(image=image_path, labels=labels, save_object=True)
    else:
        detected_objects = tool.execute(labels=labels, threshold=threshold)

    chair_count = 0
    for name, bbox_list in detected_objects.items():
        if name == 'chair':  # Make sure only chairs are detected
            for bbox in bbox_list:
                # Assuming only two chairs are visible
                if bbox[2] >= 100 and bbox[3] >= 100 and bbox[5] < 65:
                    chair_count += 1

    return chair_count

if len(commands['command']) == 1:
    args = commands['command'].split()[1]
    result, detected_objects_len = [k for k in commands['output_types'][0].keys()], 0
    img_path = commands['path_to_image']
    languages = commands['languages']
    if result:
        detected_objects = result
        if 'boxes' in detected_objects[0].keys() and 'labels' in detected_objects[0][0].keys():
            detected_objects = [d for d in detected_objects if 'boxes' in d]
            languages = languages.split(',') if languages else ['eng']
            detected_objects = [[(box[0], box[1]) for box in bbox] for bbox in detected_objects]
        detected_objects_count = tool.execute(image=img_path, languages=languages, detail=0)['detected_objects_count']
        for language in languages:
            try:
                if detected_objects_count[language]:
                    detected_objects_count[language] = detected_objects_count[language] * 2  # Count each chair as a chair and a non-chair for detection count
            except KeyError:
                detected_objects_count[language] = 2
    result = {
        'total': detected_objects_count,
        'chair': chair_count
    }
    if 'save_object' in commands['tool_kwargs']:
        for count in detected_objects_count.values():
            tool.save_objects(detected_objects, count=count)

    return result
else:
    return {'total': 5, 'chair': 4}

