def detect_objects(image_path, labels, languages="en", detail=0):
    if not languages or len(languages) == 0:
        languages = []
    if not languages:
        languages = ['en']
    if languages is None:
        languages = ['en']

    detector = Object_Detector_Tool()
    detector.input_types['image'] = image_path
    detector.input_types['labels'] = labels
    detector.input_types['languages'] = languages
    detector.input_types['detail'] = detail

    detected_objects, object_number = detector.execute()
    
    return tuple([[label, detected_object] for label, detected_object in sorted(detected_objects.items(), key= lambda x: x[1].get('score', 0))])

