  tool_api = Object_Detector_Tool
else:
  tool_api = Text_Detector_Tool

# Image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/8017_0.png"

# Get labels of 'baseball' and 'basket'
labels = ['baseball', 'basket']

# Initialize object count dictionary
object_count = {}

# Detect and count 'baseball' and 'basket'
for label in labels:
    result = tool_api.execute(image=image_path, labels=labels, save_object=True, saved_image_path='detected_objects')
    object_count[label] = result['object_number'][label]

