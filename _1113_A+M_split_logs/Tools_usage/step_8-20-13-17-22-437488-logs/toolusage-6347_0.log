    print(f"Error initialization: {str(e)}")

def count_sports_bats(image, languages):
    if image[0].find('/') == -1:
        return []
    
    object_labels = ["baseball", "basketball"]
    
    result = []
    
    for label in object_labels:
        tool_instance = Object_Detector_Tool(image, languages=languages, threshold=0.5, model_size="base")
        data = tool_instance.execute()
        
        for detection in data["detected_objects"]:
            object_labels.remove(label);
            if detection["score"] > threshold:
                box = [int(x) for x in detection["box"]]
                result.append(
                    [
                        [[x] + [y] + [x2] + [y2],
                         label,
                         int(detection["score"])],
                        label
                    ]
                )
    return {"object_labels": object_labels, "result": result, "languages": languages, "languages_total": 5, "count": len(result) or 0}
except Exception as e:
    print(f"Error counting sports_bats: {str(e)}")
    final_result = "No sports objects found."
finally:
    return final_result
```

