from object_detector import Object_Detector_Tool

# Initialize the tool
detector = Object_Detector_Tool()

# Define the image path and labels to detect
path_to_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/153_0.png"
labels_to_detect = ["baseball", "basket"]

# Execute the tool
result = detector.execute(image_path=path_to_image, labels=labels_to_detect, save_object=True)

# Extract the object detection result data
total_detected_objects = result['object_number']
detected_objects = result['detected_objects']

final_result = {
  "total_detected_objects": total_detected_objects,
  "detected_objects": detected_objects
}

