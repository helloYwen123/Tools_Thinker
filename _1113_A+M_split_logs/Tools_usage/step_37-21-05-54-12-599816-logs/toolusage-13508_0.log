def count_paintings(image_path, languages=['en'], detail=1):
    from object_detector import Object_Detector_Tool

    try:
        result = Object_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
        painting_count = len(result['baseball'])
        return {'paintings_count': painting_count, 'painting_results': result}
    except Exception as e:
        return {'paintings_count': 0, 'painting_results': {'error': f'Error: {e}'}, 'painting_count': painting_count - 1}

final_result = count_paintings('/path/to/image.jpg', lingo=['en'], detail=0)
print(final_result)

