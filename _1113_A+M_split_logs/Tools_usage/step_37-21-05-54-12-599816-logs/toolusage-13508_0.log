from object_detector import Object_Detector_Tool

# Define the question parameters
question = {
  "image_path": "/nfs/data8/liao/wxie/SAT/SAT_images_train/13508_0.png",
  "labels": ["baseball", "basket"],
  "threshold": 0.35,
  "model_size": "tiny",
  "save_object": True,
  "saved_image_path": "detected_objects"
}

# Execute the object detector tool
detected_objects, object_number = Object_Detector_Tool.execute(image_path=question['image_path'], labels=question['labels'], threshold=question['threshold'], model_size=question['model_size'], save_object=question['save_object'], saved_image_path=question['saved_image_path'])

# Calculate the number of detected objects
total_objects = object_number['baseball'] + object_number['basket']

# Determine the number of different objects
different_objects = 0
for label in object_number:
    different_objects += len(set(object_number[label]))

final_result = {
  "answer": "The number of Paintings visible in the scene is {}.".format(total_objects),
  "objects": {
    "different_objects": different_objects
  }
}

