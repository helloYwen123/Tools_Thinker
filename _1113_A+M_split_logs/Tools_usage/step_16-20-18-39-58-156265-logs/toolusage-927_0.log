```python
# Import necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Given path to image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/927_0.png"

# Detect texts in the image
detected_objects = []
text_detected = []

# Retry detection if necessary by using text detection tool
for retries in range(3):
    try:
        text_detected = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])
    except Exception as e:
        print(f"Error in text detection: {e}")
        continue

    # Detect text using Easy OCR
    for tdetected in detected_objects:
        text_detected_for_each_language = []
        for language_code in tdetected['labels']:
            result = Text_Detector_Tool.execute(image=image_path, languages=[language_code])
            if result:
                text_detected_for_each_language.extend(result)

        if not text_detected_for_each_language:
            break

        detected_objects.append({
            'labels': tdetected['labels'],
            'detected_objects': text_detected_for_each_language
        })

        if retry < 3:
            for detected_object in detected_objects:
                for text in detected_object['detected_objects']:
                    det_text_block = []
                    det_text_block.append(text['bbox'])
                    det_text_block.extend(text['text'])
                    text_detected.append(det_text_block)

            if retry == 2:
                break

        else:
            detected_objects.clear()
            break

# Check if text was detected
if text_detected:
    final_result = f"Total detected text: {len(text_detected)}"
else:
    final_result = "No detected text"
