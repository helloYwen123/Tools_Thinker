def generate_fridges(image_path):
    class Detector:
        def detect(self):
            fridges = []
            for label in self.labels:
                for detected_object in self.detected_objects:
                    if detected_object['label'] == label:
                        box = detected_object['box']
                        x = box[0]
                        y = box[1]
                        fridges.append((x, y))
                        print(f"For label '{label}', box at {(x, y)}")
return fridges

def calculate_fridges(image_path):
    fridges = []
    for fridges in image_path.split(","):
        for r in fridges.split(","):
            box = r
            x = box[0]
            y = box[1]
            box = (x, y)
            fridges.append(box)
    return fridges

if __name__ == "__main__":
