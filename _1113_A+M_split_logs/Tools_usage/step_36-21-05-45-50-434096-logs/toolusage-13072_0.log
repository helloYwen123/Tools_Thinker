from object_detector import Object_Detector_Tool

final_result = {}

# Detect baseball and basket in the image.
result = Object_Detector_Tool.execute(image="path/to/image.png", labels=["baseball", "basket"], save_object=True)
detected_bball = result.get("baseball")
detected_basket = result.get("basket")

if detected_bball:
    final_result["baseball"] = detected_bball
    final_result["number of baseballs"] = len(detected_bball)
if detected_basket:
    final_result["basket"] = detected_basket
    final_result["number of baskets"] = len(detected_basket)

============================== END ==============================


