from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

class ImageCounter:

    def __init__(self, tool_module_name, tool_class_name):
        self.tool_module_name = tool_module_name
        self.tool_class_name = tool_class_name

    def execute(self, image_path, labels=None, save_object=False, saved_image_path="detected_objects"):
        object_detector = Object_Detector_Tool()
        text_detector = Text_Detector_Tool()

        object_result = object_detector.execute(image_path, labels=labels)
        object_results = object_result['detected_objects']

        text_results = []

        for text_result in object_result['object_number']:
            language_codes = text_result.keys()
            detected_language = min([language for language in language_codes if language not in text_result.keys()])

            text_result = text_detector.execute(image_path, languages=[detected_language])
            text_results.extend(text_result['result'])
            confidence_scores = text_result['predicted_probability'][:]
            confidence_scores.sort(key=lambda x: x[1], reverse=True)

        final_result = []
        for result in object_results + text_results:
            final_result.append(result)

        if save_object:
            if object_result:
                object_result = object_result['detected_objects']
                for box in object_result:
                    box['image'] = saved_image_path
            if text_results:
                for text_result in text_results:
                    text_result['image'] = saved_image_path
            for box in object_result:
                if box.get('image') == saved_image_path:
                    img = box['image']
                    for text_result in text_results:
                        if text_result.get('image') == img:
                            box['confidence'] = text_result.get('predicted_probability')[0][1]

        return final_result

final_result = ImageCounter().execute(image_path='path/to/image.png',
                                        labels=['baseball', 'basket'],
                                        save_object=True, save_object_path="detected_objects")

# Example of output
for result in final_result:
    print(f"Box coordinates: ({result[0][0]}, {result[0][1]})")
    print(f"Recognized text: {result[1]}")
    print(f"Confidence score: {result[2]}")
    print("")
```
