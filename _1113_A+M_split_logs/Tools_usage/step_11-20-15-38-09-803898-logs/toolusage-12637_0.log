import object_detector

# Import object_detector_module class
class Object_Detector_Tool(object_detector.Object_Detector_Tool):
    # Example code to execute the tool
    def execute(self, image, labels=None, threshold=False, model_size='tiny', save_object=False, saved_image_path=None):
        # Extract object detections
        result = object_detector.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

        # Extract total counts
        object_labels = list(result.keys())
        object_counts = {object_label: 0 for object_label in object_labels}
        for label in labels:
            object_counts[label.split()[0]] += 1
        object_counts = list(object_counts.items())
        object_counts.sort(reverse=True, key=lambda x: x[1])

        # Return results
        return object_counts

