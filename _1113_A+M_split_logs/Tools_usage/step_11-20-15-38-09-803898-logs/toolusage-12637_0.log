from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_TOOL import Text_Detector_TOOL

obj_count = 0
text_count = []

def detect_objects_on_image(image_path):
    tool = Object_Detector_TOOL()
    labels = ["baseball", "basket"]
    model_size = "tiny"
    
    detected_objects = tool.execute(image=image_path, labels=labels, model_size=model_size, save_object=True, saved_image_path="detected_objects")
    return detected_objects

def detect_text_in_image(image_path, languages=[["zh", "en"], ["de"]]):
    tool = Text_Detector_TOOL()
    text_blocks = tool.execute(image=image_path, languages=languages, detail=0)

    for text_block in text_blocks:
        for detected_text_block in text_block:
            text_count.append([detected_text_block[0][1], detected_text_block[1]])

    return text_count

