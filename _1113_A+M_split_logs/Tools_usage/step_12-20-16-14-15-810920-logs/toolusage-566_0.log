label_count = result['object_number']

if label_count == 0:
  detected_objects = []
  final_result = f"{'1' if save_objects else '0'}"

elif save_objects:
  count, saved_im = max(detected_objects, key=lambda i: i[-2])
  count = count * 5  # Assuming the first detected object has the highest score
  for i in detected_objects:
    if i[-3]:
      if i[-2] > count:
        count = i[-2]
        saved_im_path = i[-3]['saved_image_path'] if i[-3]['saved_image_path'] else i[-1].replace('.jpg', '.png')

