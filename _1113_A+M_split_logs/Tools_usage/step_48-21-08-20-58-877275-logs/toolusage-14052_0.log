from object_detector import Object_Detector_Tool

# Set the options for detection
detected_objects, object_number = Object_Detector_Tool.execute(image='image.png', labels=['baseball', 'basket'], save_object=True)

final_result = {
  "number_of_doors": 1
}

if detected_objects:
  for obj_result in detected_objects["baseball"]:
    final_result["baseball"] = obj_result["number_of_objects"]
  for obj_result in detected_objects["basket"]:
    final_result["basket"] = obj_result["number_of_objects"]
else:
  final_result["baseball"] = 0
  final_result["basket"] = 0

print(final_result)

============================== END ==============================

