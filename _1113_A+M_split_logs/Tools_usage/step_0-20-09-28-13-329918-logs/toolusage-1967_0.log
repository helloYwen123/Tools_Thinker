final_result = []

from object_detector import Object_Detector_Tool

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1967_0.png"
labels = ["box", "box", "box"]
threshold = 0.35
model_size = "small"

try:
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")
except Exception as e:
    print(e)

if detected_objects:
    # Extract the object labels
    labels_dict = {}
    object_num_dict = {}

    for detection_entry in detected_objects[1]:
        label = detection_entry["labels"][0]
        num_objects = detection_entry["object_num"]
        labels_dict[label] = detection_entry["box"]
        object_num_dict[label] = num_objects

    final_result.append({"detected_objects": {"baseball": labels_dict, "basket": labels_dict}, "object_num": object_num_dict})
else:
    final_result.append({"no_boxes": []})

print(final_result)

if final_result != []:

    for obj_labels, box in final_result[0]["detected_objects"].items():
        num_boxes = final_result[0]["object_num"][obj_labels]
        print(f"Found {num_boxes} objects with {obj_labels} label in the image.")
else:
    final_result += [0, 0]  # Initialize object count to 0 if no boxes are found

# Extract the object labels
results = []
for detection_entry in detected_objects[1]:
    label = detection_entry["labels"][0]
    score = detection_entry["score"]
    box = detection_entry["box"]

    results.append({"label": label, "bbox": [box[0], box[1], box[2], box[3]], "score": score})

print("\n".join(f"{res['label']}: {res['bbox']}, score score: {res['score']}" for res in results))

# Calculate object count
object_count = sum([len(res["bbox"]) for res in results])

print(f"There are {object_count} boxes in total from all the detected objects.")
