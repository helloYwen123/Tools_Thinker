from object_detector import Object_Detector_Tool

# Define the question parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/14749_0.png"
labels = ["ball"]
threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Initialize the object detection tool
tool = Object_Detector_Tool(image_path, labels, threshold, model_size, save_object, saved_image_path)

# Detect the objects and retrieve the object number for each
detected_objects, object_number = tool.execute()

# Extract the necessary details from the object detection results
if object_number:
    object_details = {label: [bbox, score] for label, bbox, score in detected_objects.values()}
    object_labels = sorted(object_details.keys())
else:
    object_details = {}
    object_labels = []

# Print the detected objects and object numbers
final_result = f"Detected objects:\n{object_details}\nObject number: {object_number}"

