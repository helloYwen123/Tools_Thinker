from object_detector import Object_Detector_Tool

def count_objects(image_path, labels, threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects"):
    # Convert from str to list for labels
    labels_list = labels.split(", ")

    # Create the object detector
    object_detector = Object_Detector_Tool(image_path=image_path, labels=labels_list, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    # Count the number of objects
    total_number_of_objects = object_detector.object_number

    # Loop through each label and number of objects
    for label in object_detector.detected_objects:
        if label.get("label") not in labels_list:
            total_number_of_objects += label.get("number_of_objects")

    return total_number_of_objects

final_result = count_objects(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/14749_0.png", labels=["baseball", "basket"], saved_image_path="detected_objects")
print(f"Total number of objects detected from the image: {final_result}")

