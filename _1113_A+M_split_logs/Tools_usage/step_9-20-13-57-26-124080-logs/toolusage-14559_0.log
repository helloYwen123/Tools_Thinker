```python
from object_detector import Object_Detector_Tool

def count_fridges(image_path):
    try:
        objects = Object_Detector_Tool.execute(image_path, labels=["Fridge"], save_object=True)
        object_count = {}
        for obj in objects:
            if 'Fridge' in obj["labels"]:
                if obj["labels"][0] not in object_count.keys():
                    object_count[obj["labels"][0]] = 1
                else:
                    object_count[obj["labels"][0]] += 1
        return object_count
    except:
        return 0

final_result = count_fridges("/path/to/your/image.png")
print("Fridge count:", final_result)
