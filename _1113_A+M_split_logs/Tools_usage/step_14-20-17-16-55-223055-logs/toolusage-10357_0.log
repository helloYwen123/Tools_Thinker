import Object_Detector_Tool

saved_image_path = "detected_objects"

def count_objects(image_path, detected_objects):
    object_number = len(detected_objects['baseball']) + len(detected_objects['basket'])
    object_number = detected_objects['basket'] if 'basket' in detected_objects.keys() else detected_objects['baseball']

    return object_number

# Load detected objects
detected_objects = Object_Detector_Tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path=saved_image_path)
image_number = count_objects(image_path, detected_objects)

print(f"Number of objects detected: {image_number}")
print(f"Total objects in image: {len(detected_objects)}")

