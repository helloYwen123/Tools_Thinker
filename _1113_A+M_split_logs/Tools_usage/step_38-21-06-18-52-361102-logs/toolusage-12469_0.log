from object_detector import Object_Detector_Tool

# The path to the image file
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/12469_0.png'

# The labels to detect (baseball, basket)
labels = ['baseball', 'basket']

# The confidence threshold for detection
threshold = 0.35

# The size of the model to use
model_size = 'tiny'

# Whether to save the detected objects as images (True by default, False for testing)
save_object = True

# The path to save the detected object images
saved_image_path = 'detected_objects'

# Detect and count books
result = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Define a dictionary of book titles and their corresponding book counts
book_counts = { 'book1': 1, 'book2': 2, 'book3': 3, 'book4': 4 }

# Initialize the final result variable
final_result = []

# Loop over the detected objects and count books
for book, bounding_box in result['detected_objects']:
    if book in book_counts:
        # Increment the book count for this book
        book_counts[book] += 1
        # Format the detection text in a human-readable way
        detection_text = "Detected Text: " + book

        # Check if the detection bounding box overlaps with the text
