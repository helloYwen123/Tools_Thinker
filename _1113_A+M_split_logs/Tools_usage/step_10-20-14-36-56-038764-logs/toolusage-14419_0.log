from object_detector import Object_Detector_Tool

def count_windows(filepath):
    image = filepath
    label = "glass"
    threshold = 0.35
    mode = "tiny"
    result = Object_Detector_Tool.execute(image=image, labels=[label], save_object=False, saved_image_path="detected_windows")
    try:
        window = result[0].get("baseball", 0)
        return len([x for x in window if "window" in x['label']]), 0
    except:
        return 0, 0

final_result = count_windows("/nfs/data8/liao/wxie/SAT/SAT_images_train/14419_0.png")
print("There are", final_result[0] / 2, "windows in and", final_result[1], "times")

