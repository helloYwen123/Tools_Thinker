from Object_Detector_Tool import Object_Detector_Tool

# Set the path to the image
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/2428_0.png'

# Set languages to English and German for text detection
languages = ['en', 'de']

# Set the level of detail to 1 for more detailed output
level_of_detail = 1

# Create the detection tool instance
obj_detector = Object_Detector_Tool()

# Perform object detection
result = obj_detector.execute( \
    image_path, languages, level_of_detail)

# Extract total detected objects for each language
total_objects = {result[0][0][1]: 0 for result in result}
final_result = [result[0][1] for result in result if result[0][0][1] in total_objects]

