from object_detector import Object_Detector_Tool

# Execute the tool with image 'path/to/image.png'
detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Extract object number
d = {k: detected_objects[k][1] for k in object_number}

final_result = f"Visible DiningTables: {d['baseball']} and {d['basket']}"

