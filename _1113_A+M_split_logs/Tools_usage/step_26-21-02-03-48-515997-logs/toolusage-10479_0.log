from Object_Detector_Tool import Object_Detector_Tool

# Generate a program to answer the question based on the tools available
def count_beds(image_path):
    output_object = Object_Detector_Tool.execute(image=image_path, save_object=True)
    beds_detected = []
    
    for label, detail in output_object:
        for block in detail:
            if block[0][1] == 1 and block[3] == 1:
                beds_detected.append(label)
    
    return beds_detected

final_result = count_beds("/nfs/data8/liao/wxie/SAT/SAT_images_train/10479_0.png")
print("Beds detected:", final_result)

