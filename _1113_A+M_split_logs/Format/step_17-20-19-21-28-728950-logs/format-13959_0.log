from object_detector import Object_Detector_Tool

def count_desklamperes():
    # Path to the image
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13959_0.png"
    
    # Detection options
    labels = [ "desk", "desk_lamp", "table"]
    threshold = 0.35
    model_size = "tiny"
    save_object = True
    
    # Detect objects
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

    # Count the occurrence of each detected object
    object_number = {}
    for label, detection_list in detected_objects.items():
        total_count = len(detection_list)
        object_number[label] = total_count if "total" not in object_number else min(object_number["total"], total_count)
    
    return detected_objects, object_number
