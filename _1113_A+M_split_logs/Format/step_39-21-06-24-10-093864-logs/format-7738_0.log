from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path_to_image.png', labels=['baseball', 'basket'],
                                            save_object=True, saved_image_path='detected_objects')

object_number = final_result['object_number']
print(f"Number of HousePlants: {object_number['baseball']}")

result = final_result['detected_objects']

for detected_objects in result:
    for obj in detected_objects:
        if obj['label'] == 'baseball':
            print(f"{obj['label']} detected: {obj['score']}")

