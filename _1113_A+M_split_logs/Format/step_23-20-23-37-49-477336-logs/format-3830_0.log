from object_detector import Object_Detector_Tool

# Test path before optimization
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/3830_0.png'

# Detect 'baseball' and 'basket'
total_count = 0
labels = ['baseball', 'basket']
detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels)

final_result = []
for label, detection_entries in detected_objects.items():
    detected_objects_labels_count = {label: 0}
    for entry in detection_entries:
        detected_objects_labels_count[label] += entry['count']
    final_result.append({
        'labels': label,
        'count': detected_objects_labels_count[label]
    })

total_count = max([detected_objects_labels_count[label] for label in labels])  # Return the total count of detected objects

print(f"{'Total count for detected objects':^13}")
print(f"{'Total count':^13}{'Total count for detected objects':^13}")
print("%2s %5d %2s %5d" % ("", detected_objects_labels_count))
print(f"{", ".join([f'{label}: {value}' if value > 0 else 'None' for label, value in detected_objects_labels_count.items()])}: {total_count}")
