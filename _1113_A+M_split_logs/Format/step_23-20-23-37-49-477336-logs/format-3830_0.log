# Save detected objects
save_object = True

# Save detected objects as images
if save_object:
    saved_image_path = "detected_objects"

# Execute detection
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

final_result = f"{object_number['baseball']}\n{object_number['basket']}"


