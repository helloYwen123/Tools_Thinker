from Object_Detector_Tool import Object_Detector_Tool

# Path of the image
path_to_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/879_0.png"

# List of text languages to be considered for OCR
languages = ['en', 'de']

# Set the level of detail (1 for detailed output)
detail = 1

# Initialize result dictionary with empty lists for texts
result = {}

# Iterate through the languages to detect text
for lang in languages:
    # Tryesseract OCR tool with 1 level of detail
    result[lang] = Object_Detector_Tool.execute(image=path_to_image, languages=[lang], detail=detail)
    
    # If text detection fails, return an empty list (in case of failure)
    if result[lang] is None:
        result[lang] = []

# Convert the resulting dictionaries to lists and add to the final result
for language, texts in result.items():
    final_result[language] = texts

# Check if 'save_object' was set to True
if final_result:
    for language, texts in final_result.items():
        if final_result[language][0][2] != None and 'saved_image_path' in final_result[language][0][4]:
            final_result[language] = final_result[language][0][4]['saved_image_path'] + '/saved_text_' + str(final_result[language]).replace('[', '').replace(']', '').strip()

# Check if 'save_object' was set to True
if "save_object" in final_result[1]:
    del final_result[1]["save_object"]

if "detected_objects" in final_result:
    final_result = final_result["detected_objects"]
else:
    final_result = {}

# Print the final result
final_result
