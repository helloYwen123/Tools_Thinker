from object_detector import Object_Detector_Tool

# Read image path from the environment variable
input_image = os.getenv('PATH_TO_IMAGE')

# Set language codes for OCR
languages = ['en', 'zh']

# Set the level of detail for OCR
detail = 1

result = Object_Detector_Tool.execute(image=input_image, languages=languages, detail=detail)

# Extract detected object dictionary from the result
detect_objects = result["detected_objects"]

# Determine the number of detected objects
object_number = dict_to_number(detect_objects)

final_result = {
    "count": object_number.get('baseball', 0),
    "label_distribution": {key: count for key, count in result["labels"].items()}
}

def dict_to_number(results):
    result_dict = {}
    for value in results.values():
        if value:
            result_dict[value["saved_image_path"]] = value["count"]
    return result_dict

result = dict_to_number(detect_objects)

final_result["count"] = result["total_objects"]
final_result["label_distribution"] = result["label_count"]
