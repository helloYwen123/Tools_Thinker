```python
import object_detector

# Initialize the Object_Detector_Tool
object_detector_tool = object_detector.Object_Detector_Tool()

# Set the image and labels
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/"
labels = ["dining_table"]

# Set the threshold and model size
threshold = 0.35
model_size = "tiny"

# Set the image to detect and detect dining tables
image = image_path / next(iter(filter(lambda x: x.endswith(".png"), os.listdir(image_path))))

# Detect dining tables in the image
result = object_detector_tool.execute(image=image, labels=labels, save_object=True, saved_image_path="dining_tables")

# Get the number of dining tables detected
total_dining_tables = len(result[0]["baseball"]) + len(result[0]["basket"])

# Convert the bounding box coordinates to integer coordinates
bbox_coordinates = [[int(x) for x in i["bbox"] for i in result]]


# Check for missing objects detected
if len(bbox_coordinates) > 0:
    final_result = {"dining_tables": total_dining_tables, "bbox_coordinates": bbox_coordinates}
else:
    final_result = {"dining_tables": 0, "bbox_coordinates": None}
```
