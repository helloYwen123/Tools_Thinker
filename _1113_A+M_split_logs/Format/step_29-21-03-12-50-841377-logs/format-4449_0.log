from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='<PATH_TO_IMAGE>', save_object=False, saved_image_path='')
if not final_result:
    print("Text detection failed after retries.")
else:
    detected_objects = final_result[0]
    total_objects = len(detected_objects)
    detected_objects = [{'label': l, 'box': (p[0], p[1], p[2], p[3]), 'score': s} for l, p, s in detected_objects]
    print(f"Detected objects:\n {json.dumps(detected_objects, indent=4)} ")
