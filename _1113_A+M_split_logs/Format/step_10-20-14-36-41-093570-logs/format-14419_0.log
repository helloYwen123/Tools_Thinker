from object_detector import Object_Detector_Tool

def count_windows():
    return Object_Detector_Tool.execute(image="path/to_image.png", save_object=True)

def find_text_in_image():
    return Text_Detector_Tool.execute(image="path/to_image.png", languages=["en", "de"])

if __name__ == "__main__":
    windows = count_windows()
    text = find_text_in_image()

    if windows and text:
        window_count = len(text)
        detected_objects_for_text = [{{[x[0][0], y[0][0]], [x[0][1], y[0][1]]}, word, text[0]["score"]} for x in windows[0]["bbox"] for y in text for word in text if text[0]["score"] >= window_count]
        print(f"Number of windows detected: {window_count}")
        print(f"Detected images for each window: {detected_objects_for_text}")
    else:
        print("No windows detected.")
    elif text:
        print(f"Number of text segments found: {len(text)}")
        print(f"Detected text: {text}")
    else:
        print("No text or windows detected.")
