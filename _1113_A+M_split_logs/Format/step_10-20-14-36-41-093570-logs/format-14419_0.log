from .object_detector import Object_Detector_Tool

import numpy as np

def detect_windows_image(image_path, labels=None, threshold=0.35, model_name='tiny', save_object=False, saved_image_path='detected_objects'):
    from .text_detector import Text_Detector_Tool

    detected_objects = {}
    object_number = {}

    # Detecting objects using Object_Detector_Tool
    object_labels = object_labels or ['window', 'wall', 'floor']
    labels = [i for i in labels if i in object_labels]

    if not labels:
        return None

    # Generate list of object detection boxes and save corresponding object images
    detected_objects['window'] = []
    object_number['window'] = 0

    # Detect Windows
    # Call the detection tool to identify windows
    tool = Object_Detector_Tool(image=image_path, labels=labels, threshold=threshold, save_object=save_object, saved_image_path='detected_objects')
    tool.execute()  # Execute the tool
    if tool.output_types == "tuple":
        detected_objects = tool.output_types(detected_objects=tool.generate_result())
    else:
        return None

    # Detecting text using Text_Detector_Tool
    if labels and tool.output_types == "list":
        tool = Text_Detector_Tool(image=image_path, languages=["en", "de"])
        tool.execute()
        detected_objects = tool.generate_result()
        object_number = tool.object_number

    if saved_object:
        # Save detected objects to a directory
        detected_objects.save_object("path/to/save", "detected_objects")

    return detected_objects, object_number
