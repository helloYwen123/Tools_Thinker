```python
# Import necessary modules for this task
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

class ImageAnalysis:
    def __init__(self):
        self.object_detector = Object_Detector_Tool()  # Initialize the object detector tool
        self.text_detector = Text_Detector_Tool()  # Initialize the text detector tool

    def analyze_image(self, image_path, labels=("baseball", "basket"), save_object=False, saved_image_path="detected_objects"):
        # Analyze the image with the object detector tool
        detected_objects = self.object_detector.execute(image=image_path, labels=labels, save_object=True, saved_image_path=saved_image_path)

        # Analyze the image with the text detector tool
        result = self.text_detector.execute(image=image_path, languages=["en", "de"], detail=1)

        # Combine detected objects and text detection results into a single result
        final_result = []
        for detected_object in detected_objects:
            for text_result in result:
                if detected_object["box"] == text_result["box"]:
                    detected_object["text"] += " " + text_result["text"]

        return detected_objects + result

# Create an instance of the ImageAnalysis class
analysis_tool = ImageAnalysis()

# Call the analyze_image function with the image path, labels, and desired settings
final_result = analysis_tool.analyze_image(image_path, labels=("baseball", "basket"), save_object=True)

# Print the extracted objects and relevant text detection data
for object in final_result:
    print(object)
