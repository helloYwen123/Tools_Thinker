from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(
    image='path/to/image.png', 
    labels=['floorlamp'], 
    save_object=True, 
    saved_image_path='detected_objects'
)

def process_result(data):
    labels = data.get('labels', [])
    floorlamps = [entry for entry in labels if entry['location']['x'] == 0 and entry['location']['y'] == 0]

    object_number = {'floorlamp': len(floorlamps)}
    return object_number

process_result(final_result)
