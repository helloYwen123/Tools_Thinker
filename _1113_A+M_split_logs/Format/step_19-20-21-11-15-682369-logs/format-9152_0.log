import Object_Detector_Tool
import Text_Detector_Tool

# Sample image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/473.wav.wav"

# Detect text blocks in the image with multiple languages
result = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])

# Check if text was detected
if result:
    # Loop through each detected text block
    for block in result:
        # Extract bounding box coordinates, recognized text, and confidence score
        box = block[1][0]
        text = block[0][1]
        confidence = block[1][2]
        
        # Save detected text as an image if requested
        if save_object:
            det_path = f"{saved_image_path}/text_{confidence:.2f}.png"
            # Assuming 'detected_objects' is the directory where the saved images are saved, set det_path accordingly
            Image.fromarray(block[0]).save(det_path)
            
        print(f"Detected text at: ({box[0]}, {box[1]}, {box[2]}, {box[3]}), **Confidence: {confidence:.2f}**")
else:
    print("Text detection failed.")
