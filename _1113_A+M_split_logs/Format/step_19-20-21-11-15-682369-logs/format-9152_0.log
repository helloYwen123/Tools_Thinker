# Load the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9152_0.png"
detector_tool = Object_Detector_Tool()
result = detector_tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path="detected_objects")

# Count the number of baseballs and baskets in the image
object_number = 0  # Initial count, will be updated in the next part
for label in result[0]:
    for detection_entry in label:
        if detection_entry["score"] > 0.35:
            object_number += 1
            if "baseball" in detection_entry["score"] or "basket" in detection_entry["score"]:
                print(f"{result[0][0]:.5} : {result[0][1]:.5}\n")

final_result = object_number
