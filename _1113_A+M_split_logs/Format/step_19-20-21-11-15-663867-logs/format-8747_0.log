from object_detector import Object_Detector_Tool

def count_shelvingUnits():
    with open('/nfs/data8/liao/wxie/SAT/SAT_images_train/8747_0.png', 'rb') as image_file:
        image = image_file.read()

    labels = ["shelvingunit"]
    threshold = 0.35
    model_size = "tiny"
    
    detected_objects = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=False)
    
    # Count shelves units
    shelves_units_count = len(detected_objects["shelvingunit"])
    
    return shelves_units_count

final_result = count_shelvingUnits()
