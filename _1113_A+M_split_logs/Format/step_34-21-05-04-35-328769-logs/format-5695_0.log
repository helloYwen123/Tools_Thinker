<command>
from object_detector import Object_Detector_Tool

# Initialize the Object_Detector_Tool
detect_tool = Object_Detector_Tool()

# Define the image path and the languages to be detected
image_path = 'path/to/image.png'
languages = ['en', 'de']

# Detect text in the image
result = detect_tool.execute(image_path=image_path, languages=languages)

# Extract the detected text blocks (excluding the default name "Object_Detector" for each label)
detected_text_blocks = result[0]

final_result = []
for block in detected_text_blocks:
    detected_text = block[1]
    confidence = block[3]
    final_result.append([detected_text, confidence])

# Find the number of detected SideTables
side_tables = result[1]
side_tables_details = side_tables['basketball'][0]

number_of_side_tables = side_tables_details.get('basket', 0)
final_result.append(['Number of SideTables:', number_of_side_tables])

# Display the result and the number of detected SideTables
for (label, detected_objects) in detected_text_blocks:
    print(f"Detected {label}: {len(detected_objects)}")

if 'basket' in final_result[1]:
    print("Detected Basketball: ", final_result[1]['basket'])
    print("Number of Basketball: ", final_result[1]['basket'][0])
    
if number_of_side_tables > 0:
    print("Detected SideTable: ", final_result[1]['basket'][0])
    print("Number of SideTable: ", number_of_side_tables)
</command>
