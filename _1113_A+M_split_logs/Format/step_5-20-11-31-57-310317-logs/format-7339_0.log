```python
from tool_module import Object_Detector_Tool, Text_Detector_Tool

image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/7339_0.png'
languages = ['en', 'de']
detail_level = 1

object_result = Object_Detector_Tool.execute(image=image_path, languages=languages)
object_result_with_scores = []

for result in object_result:
    text_detected = []
    for text in result[1]:
        text_detected.append(text)
    object_result_with_scores.append([result[0], text_detected])

final_result = object_result_with_scores

if bool(final_result[0]) and bool(final_result[2]):
    if len(final_result[1]) > 0:
        print('Detected baseball:{}'.format(final_result[0][0][0]))
        print('Detected baseball's scores:{}'.format(final_result[0][0][2]))
        print('Detected baseball's detailed text results:{}'.format(final_result[1]))
        print('Detected baskets:{}'.format(final_result[0][2]))
  
    text_recognized = []
    for text in final_result[2]:
        text_recognized.append(text)
    print('Detected text:{}'.format(text_recognized))

    confidence_score = []
    for scores in final_result[2]:
        for score in scores:
            confidence_score.append(score[2])
    print('Text detection confidence scores:{}'.format(confidence_score))

    
else:
    text_detected = []
    text_recognized = []
    text_info = []
    text_info_score = []
    
    for result in final_result:
        for text in result[0]:
            text_detected.append(text[0])
        for text in result[2]:
            text_recognized.append(text[0])
            
        text_info.append((result[0], result[2], result[1]))
        text_info_score.append([result[1], result[2], result[0][0][3]])

    print('Detected text:{}'.format(text_recognized))
    
    print('Text detection scores detected:{}'.format(text_info_score))
    
    print('Text detection scores detected information:{}'.format(text_info))
```

