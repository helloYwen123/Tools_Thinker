<command>
from object_detector import Object_Detector_Tool


# Initialize the object detector tool
detector_tool = Object_Detector_Tool()

# Load image
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4078_0.png'
image = detector_tool.image_to_list_of_bb(image_path)
labels = ['baseball', 'basket']

# Set the threshold
detector_tool.set_threshold(0.35)

# Set mode and size
detector_tool.mode = 'tiny'
detector_tool.model_size = 'tiny'

# Set to save objects
detector_tool.save_object = True
detector_tool.saved_image_path = '/nfs/data8/liao/wxie/SAT/detected_objects'

# Detect objects
detector_tool.execute(image=image, labels=labels)

# Get the number of detected objects
number_of_objects = len(labels)
final_result = {'Object_Detector_Tool': {'labels': labels, 'number': number_of_objects}, 'text_detector': ['baseball', 'basket']}
</command>
