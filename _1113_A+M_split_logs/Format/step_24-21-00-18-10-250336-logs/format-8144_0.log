    pass

def count_baskets(image_path):
    # Load the image and get the labels
    baskets = Object_Detector_Tool.execute(image_path=image_path, labels=['basket'])['basket']
    basket_count = 0
    for basket in baskets:
        basket_box = basket[0]
        width, height = basket_box[2] - basket_box[0], basket_box[3] - basket_box[1]
        basket_count += int((width * height) / 2.0)

    return basket_count

