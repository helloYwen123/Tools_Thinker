from object_detector import Object_Detector_Tool

def count_beds(image_path):
    # Load the image and get the labels
    detections = Object_Detector_Tool.execute(image_path=image_path, labels=['bed'], save_object=False)

    # Check if a bed was detected
    bed_count = 0
    if 'bed' in detections:
        bed = detections['bed']
        bed_box = bed[0]
        width, height = bed_box[2] - bed_box[0], bed_box[3] - bed_box[1]
        bed_count = int((width * height) / 2.0)

    return bed_count

def count_baseball(image_path):
