from object_detector import Object_Detector_Tool

# Set the input image path and label
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13570_0.png"
labels = ['baseball', 'basket']
save_object = True

# Execute the object detection command
result = Object_Detector_Tool.execute(image_path, labels, save_object)

# Extract the number of detected objects from the first label
number_of_objects = result[0]["baseball"][0]["score"]

final_result = {
  "objects": result,
  "count": round(number_of_objects, 0)
}

print(final_result)
