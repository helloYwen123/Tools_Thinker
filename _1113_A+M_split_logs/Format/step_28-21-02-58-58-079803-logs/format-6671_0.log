from object_detector import Object_Detector_Tool

# Function to execute the object detection
def execute_detection(image_path, labels, save_object, saved_image_path):
    try:
        result = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
        return result
    except Exception as e:
        print(f"Error executing object detection: {e}")
        return []

# Example usage
result = execute_detection(image_path='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
detected_objects = result[0]
object_number = result[1]

final_result = {"detected_object": detected_objects, "total_objects": object_number}

print(final_result)
