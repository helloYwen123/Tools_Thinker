import object_detector

class Object_Detector_Tool:
    def execute(self, image_path, labels=None, threshold=0.35, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
        detector_tool = object_detector.Object_Detector_Tool()
        detected_objects, object_number = detector_tool.execute(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
        return detected_objects, object_number

final_result = Object_Detector_Tool.execute(image="path/to/image.png", labels=[["baseball", 1], ["basket", 2]])
print(final_result)  # Output: [('baseball', [['box': (34, 50, 200, 220), {'score': 0.92, 'saved_image_path': 'detected_objects/image_baseball_1.png'}], ...], ...), ...
