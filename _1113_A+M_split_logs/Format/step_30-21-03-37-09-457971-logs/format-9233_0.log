from Object_Detector_Tool import Object_Detector_Tool

def number_of_paintings(image_path):
    try:
        print("Detecting paintings...")
        results = Object_Detector_Tool.execute(image_path, labels=['painting'], threshold=0.35, save_object=True, saved_image_path="detected_objects")
        painted_objects = results["detect_results"]
        
        detected_paintings = [item for item in painted_objects if item["class"] == "painting"]
        number_of_paintings = len(detected_paintings)
        return number_of_paintings
    except Exception as e:
        return "Error: " + str(e)

final_result = number_of_paintings("/nfs/data8/liao/wxie/SAT/SAT_images_train/9233_0.png")
print("The number of paintings detected is:", final_result)
