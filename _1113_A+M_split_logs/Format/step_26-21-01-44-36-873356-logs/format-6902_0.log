from object_detector import Object_Detector_Tool

final_result = {}
labels_to_check = ['baseball', 'basket']
for label in labels_to_check:
    try:
        objects = Object_Detector_Tool.execute(image='path/to/image.png', labels=[label], save_object=True, saved_image_path='detected_objects')
    except Exception as e:
        print(f"An error occurred while detecting {label}: {e}")
        continue
    detected_objects = objects['detected_objects']
    
    score_count = {obj['score']:{}, 'number': 0}
    for _, obj in detected_objects.items():
        score_count[obj['score']][obj['number']] = 1 + score_count.get(obj['score'], 0)  
        obj_number = score_count.get(label)
        if obj_number is not None:
            obj_number += 1
        score_count[label] = score_count.get(label, 0) + obj_number
        final_result[label] = score_count
    
    if objects['object_number'] is not None:
        final_result[label] = objects['object_number']
    
print(final_result)
