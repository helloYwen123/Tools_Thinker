from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_doors(image_path):
    """ Counts and displays the number of doors in the image. """
    with open(image_path, 'r') as file:
        content = file.read()
    
    doors = 0
    for line in content.split('\n'):
        if line.startswith("/"):
            door_index = int(line[1:3])
            if door_index == 10:
                doors += 1
        if doors == 1:
            break

    return doors

def find_doors(file_path):
    """ Determines the number of doors from the detected objects in the image. """
    detector_tool = Object_Detector_Tool()
    result = detector_tool.execute(image=file_path, labels=['door'], save_object=False, saved_image_path='')

    detected_objects = result['detected_objects']
    for obj in detected_objects:
        for o in obj:
            box = o['box']
            if box[1] == 200 and box[3] == 200:
                doors_count = detector_tool.box_to_doors(detected_objects, o['bbox'], 'door', o['id'])
                if doors_count:
                    return doors_count

def count_objects(file_path):
    """ Counts the number of objects in the image. """
    detector_tool = Object_Detector_Tool()
    result = detector_tool.execute(image=file_path, labels=['baseball', 'basket'], save_object=False, saved_image_path='')
    objects = result['detected_objects']

    return len(objects)

def find_objects(file_path, languages=['en', 'de']):
    """ Determines the number of objects from text recognition in the image. """
    detector_tool = Text_Detector_Tool()
    return detector_tool.execute(image=file_path, languages=languages, detail=1)

