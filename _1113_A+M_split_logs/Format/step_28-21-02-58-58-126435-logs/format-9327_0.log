final_result = Object_Detector_Tool.execute(image='path/to/image.png', SAVE_OBJECT='True')

if isinstance(final_result, dict):
    detected_objects = final_result.get('detected_objects') if 'detected_objects' in final_result else []
    total_objects = len(detected_objects)
    
    if saved_object:
        saved_image_path = final_result.get('saved_image_path')
        for label, detection in detected_objects:
            new_detection = {
                'box': detection['box'],
                'box_conf': detection['box_score'],
                'label': label
            }
            for block in detection.get('blocks', []):
                block_box = [tuple(block['box'])]
                block_label = detected_objects[0][label].get('label')
                block_conf = detected_objects[0][label].get('confidence', 0.65)
                block_box_conf = block_box[0][0] / final_result.get('object_number').get(label, 0)
                block_box_conf = detected_objects[0][label].get('score', 0.99) / block_box_conf
                
                new_detection['blocks'] = [det('box', [x[0] + block_box[0], y[0] + block_box[1]],
                                            box_conf = None) for x in block['bbox'] for y in block['bbox']]
                new_detection['blocks_conf'] = [det('bbox', [x[0] + block_box[0], y[0] + block_box[1]],
                                                    box_conf = None) for x in block['bbox'] for y in block['bbox']]
                save_to_directory = final_result.get('saved_image_path')

