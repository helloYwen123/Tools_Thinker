from object_detector import Object_Detector_Tool

tools_params = {
    "image": "/nfs/data8/liao/wxie/SAT/SAT_images_train/6747_0.png",
    "labels": ["baseball"],
    "threshold": 0.35,
    "model_size": "tiny",
    "save_object": True,
    "saved_image_path": "detected_objects"
}

def count_doors():
    # Detect doorway
    objects = Object_Detector_Tool.execute(image=tools_params["image"], labels=["door"], save_object=True, saved_image_path="")
    object_results = objects["object_results"]
    
    # Count door ways
    door_count = any([x["label"] == "door" for x in object_results])
    
    return door_count, 0, 0, 0

