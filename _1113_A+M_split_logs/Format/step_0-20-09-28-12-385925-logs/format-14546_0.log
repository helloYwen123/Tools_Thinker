```python
from object_detector import Object_Detector_Tool

class Text_Detector_Tool:
    def execute(self, image='path/to/image.png', languages=['en', 'de']):
        result = []
        for language in languages:
            if language == 'en':
                text_blocks = []
                for i in range(3):
                    _, _, _, text_block = self.predict_image(image)
                    text_blocks.append(text_block)
                result.append(text_blocks)

        for language in languages:
            if language != 'en':
                text_blocks = []
                for i in range(3):
                    _, _, _, text_block = self.predict_image(image, languages=[language])
                    text_blocks.append(text_block)
                result.append(text_blocks)

        return result

detected_objects, object_number = Object_Detector_Tool.execute(image='C:/Users/user/Desktop/test3.jpg', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
