void detected_objects (const std::string & image_path, const std::vector<std::string> & labels, bool save_objects, const std::string & saved_image_path = "")
{
  std::vector<std::map<std::string, int>> objects;

  for (const auto & label : labels) {
    for (const auto & entry : detector.execute(&image_path, {label}, save_objects, saved_image_path)) {
      objects.push_back({label, entry});

      if (!label.empty()) {
        final_result.insert({label.substr(0, 1), 0});
      }
    }
  }

  for (const auto & object : objects) {
    final_result.insert({object.first, object.second.size()});
  }
}

