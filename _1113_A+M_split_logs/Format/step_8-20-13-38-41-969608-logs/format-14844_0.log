from object_detector import Object_Detector_Tool, Text_Detector_Tool

def count_dressers():
    # Assume 'dresses' is the path to the image file
    images = [f"{dresses}_image_{i.png}", "dresses" for i in range(20, 200, 20)]
    labels = ["dres"]

    generated_images = Object_Detector_Tool.execute(image=dresses, labels=labels, save_object=True, saved_image_path="detected_objects")
    final_result = []
    object_number = {}
    for i in range(len(generated_images["detected_objects"])):
        for label in generated_images["detected_objects"]:
            if label not in object_number:
                object_number[label] = 1
            else:
                object_number[label] += 1

    detected_objects = [
        {
            "box": detected_boxes["box"],
            "score": detected_boxes["score"],
            "saved_image_path": detected_boxes["saved_image_path"],
        }
        for detected_boxes in generated_images["detected_objects"]
    ]

    for label in object_number:
        detected_objects.append((label, object_number[label], label))

    detected_objects = [{"baseball": detected_objects}] if len(detected_objects) > 1 else detected_objects

    for i in range(1, len(detected_objects)):
        if detected_objects[i - 1]["box"][-1] != detected_objects[i]["box"][-1]:
            detected_objects[i]["box"].append(detected_objects[i][0]["box"][-1])

    for i in range(len(detected_objects) - 1, -1, -1):
        if detected_objects[i]["box"][1] == detected_objects[i + 1]["box"][1]:
            detected_objects.pop(i)
            break

    for i in range(len(detected_objects)):
        detected_objects[i]["box"].append(detected_objects[i+1]["box"][0])

    final_result = [{"baseball": detected_objects}] if len(detected_objects) > 0 else [{"baseball": []}] if len(detected_objects) == 0 else [{"baseball": []}]
    return final_result

final_result = count_dressers()
print(final_result)
