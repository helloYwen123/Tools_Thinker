def count_objects(image_path, labels, threshold=0.35, model_size='tiny', save_object=False, saved_image_path="detected_objects"):  # Initialize the function with the predefined arguments
    # Define labels
    labels = {'Laptop': '', 'Table': '', 'Car': '', 'Chair': '', 'Bed': [], 'Painting': '', 'Basket': '', 'Baseball': '', 'Basketball': ''}  # Initialize dictionary for labels and objects

    # Load image
    image = Image.open(image_path).convert('RGB')  # Load the image and convert it to RGB format

    # Detect objects
    labels = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    # Convert dictionary to tuple for visualization
