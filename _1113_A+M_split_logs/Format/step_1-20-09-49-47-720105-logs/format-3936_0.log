    count = 0
    for detected_object in detected_objects:
        if detected_objects[0]['saved_image_path'] in detected_object['saved_image_path']:
            count += 1
    object_number[label] = count

final_result.append({'detected_objects': detected_objects, 'object_number': object_number})

final_result
