from object_detector import Object_Detector_Tool as OIDT

def detect_objects(image_path, labels, threshold, model_size, save_object):
    label_detected_objects = OIDT.execute(image_path=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size, save_object=True).split("\n")
    return label_detected_objects

def count_objects(image_path):
    label_detected_objects = {}
    for detected_objects in label_detected_objects:
        label, *box = detected_objects.split(',')
        id = box[0]
        score = detected_objects[-1]
        
        if id not in label_detected_objects:
            label_detected_objects[id] = []
        
        label_detected_objects[id].append({'box': [int(x) for x in box], 'score': score})
    return label_detected_objects

def get_objects(image_path, languages, detail=0):
    label_detected_objects = counter_counter(image_path, languages)
    return [label detected objects for label detected objects in label_detected_objects]

finally_result = get_objects('/nfs/data8/liao/wxie/SAT/SAT_images_train/1617_0.png', ['baseball', 'basket'], detail)
