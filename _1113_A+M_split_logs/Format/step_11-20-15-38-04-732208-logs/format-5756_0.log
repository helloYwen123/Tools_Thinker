from object_detector import Object_Detector_Tool

# Read images
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/5756_0.png'
labels = ['bed', 'trash']
threshold = 0.30  # 0.35 is the default
model_size = 'tiny'

# Create a detection tool instance
detector = Object_Detector_Tool()

# Detect objects
detected_objects, object_number = detector.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")

final_result = ""
final_result += str(detected_objects)
final_result += "\n"
final_result += str(object_number)
final_result = final_result.replace("'", "")
print(f"Selected objects: {final_result}")
