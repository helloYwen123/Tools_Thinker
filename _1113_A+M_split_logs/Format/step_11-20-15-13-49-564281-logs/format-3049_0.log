    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3049_0_img_{}.png".format(file_name)  # Example filename
    for det in detected_objects:
        dest_path = f"/nfs/data8/liao/wxie/SAT/SAT_images_train/{det['labels'][0]}img_{}.png"
        dest_path_2 = "/nfs/data8/liao/wxie/SAT/SAT_images_train/{det['labels'][0]}/img_{}.png"
