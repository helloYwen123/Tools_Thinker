import Object_Detector_Tool

class Image_Text_Recognition_Tool:
    def text_detection(self, image_path, languages, detail):
        # Initialize detection results and dictionary for object number
        detection_results = []
        object_number = {}

        # Attempt text detection and handling retries
        for language in languages:
            try:
                result = Object_Detector_Tool.text_detector.execute(image=image_path, languages=[language], detail=detail)
                detection_results.append(result)
            except Exception as e:
                print(f"Error detected: {e}")
                print(f"Retrying with English and German text detection...")
                result = Object_Detector_Tool.text_detector.execute(image=image_path, languages=['en', 'de'], detail=detail)

        if details == 1:
            for i in range(len(detection_results)):
                detection_results[i] = self.get_text_details(detection_results[i])
        else:
            for i in range(len(detection_results)):
                detection_results.append(detection_results[i])
        
        return detection_results

    def get_text_details(self, result):
        text = result[0]  # Assuming the first element in the tuple is the detected text
        bounding_box = result[2]  # Assuming the second element is the bounding box tuple
        confidence = result[4]  # Assuming the fourth element is the confidence score
        return [[bounding_box, text, confidence]]

    def execute(self, image_path, labels, save_object=True, saved_image_path="detected_objects"):
        results = Object_Detector_Tool.object_detector.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

        detection_results = []
        total_objects = {}

        # Assuming each label corresponds to a type or category
        for i, label in enumerate(labels):
            detected_objects = results[i]
            objects_count = {}
            for objects in detected_objects:
                objects_count[objects["label"]] = objects_count.get(label, 0) + 1

            for keys, value in objects_count.items():
                total_objects[keys] = total_objects.get(keys, 0) + value

            for obj in detected_objects:
                if obj["label"] in labels:
                    detection_results.append(obj)

        return detection_results, total_objects

