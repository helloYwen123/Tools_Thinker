from object_detector import Object_Detector_Tool

def get_objects_with_count(image, labels, image_path="13729_0.png", save_objects=True):
    # Load image
    label_image = Image.fromarray(image)

    # Detect objects
    result = []
    for label in labels:
        # Set threshold for confidence
        try:
            threshold = float(label[4])
        except IndexError:
            threshold = 0.35
        # Detect object
        try:
            result.append(Object_Detector_Tool.execute(image_path, labels=[label], threshold=threshold, save_object=save_objects))
            print(f"detected \"{label}\" with confidence > {threshold}")
        except Exception as e:
            print(f"Failed to detect {label} label: {e}")
    return result

# Define image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13729_0.png"

# Define labels
labels = ["baseball", "basket"]

# Detection
objects = get_objects_with_count(image=image_path, labels=labels)

# Calculate object count
object_count = {label: len(objects) for label, objects in objects}

final_result = {"labels": object_count, "objects": objects.tolist()}

# Print detected objects as JSON
json_objects = {obj : {"bbox": obj[3], "score": round(obj[2][3]*100, 2), "label": obj[1], "filename": obj[2]} for obj in objects}

final_result["result"] = json_objects

final_result
