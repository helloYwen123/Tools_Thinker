--- Completion 4 ---
<command>
from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', save_object=True, saved_image_path='detected_objects')

result = {}
for line in final_result[1]:
    if line['saved_image_path'] is not None:
        result[line['labels'][0]] = line

object_number = {}

for labels, objects in result.items():
    object_number[labels] = len(objects)

print("Detected chairs:", result)
print("Number of chairs:", object_number)

print("Final result:")
print(result)
</command>
