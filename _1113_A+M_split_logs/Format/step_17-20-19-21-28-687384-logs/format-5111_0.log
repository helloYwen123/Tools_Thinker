from object_detector import Object_Detector_Tool, save_objects

# Path to the input image
Image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5111_0.png"

# Load the input image into the object detector
detector = Object_Detector_Tool()
detect_result = detector.execute(image=Image_path, labels=['baseball', 'basket'], save_objects=True)

# Initialize variables to store the count of chairs and detected objects
chair_count = 0
detected_objects = []

# Iterate through the detected objects
for item in detect_result:
    if item['names'] == 'chair':
        chair_count += 1
        object_count = len(detected_objects)
        detected_objects.append(item)

# Calculate the total number of detected chairs
total_chair_count = chair_count + object_count

# Determine the count of chairs visible in the scene
visible_chairs = chair_count

# Output the count of detected chairs and visible chairs
final_result = f"{visible_chairs} chairs visible in the scene." if visible_chairs > 0 else "No chairs detected."

# Save detected objects (empty padding if not required)
save_objects(detected_objects)

# Output the detailed results
output = {
    'count': chair_count + object_number,
    'detected_chairs': detected_objects,
    'chairs_count': chair_count
}
generated_code = f"{'Detected chairs count after processing':= 10, 0}\n{final_result == 10, 0}\ndetected_objects: {output}"
