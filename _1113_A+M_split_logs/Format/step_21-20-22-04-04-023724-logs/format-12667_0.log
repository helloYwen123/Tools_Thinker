from object_detector import Object_Detector_Tool

# The path to the image file.
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12667_0.png"

# Define the labels for the tool (the tool can handle any other relevant object labels).
labels = ["baseball", "basket"]

# Set the confidence threshold to 0.35.
threshold = 0.35

# Set the model size to 'tiny'.
model_size = "tiny"

# Set the 'save_object' parameter to True.
save_object = True

# Set the saved_image_path parameter to 'detected_objects'.
saved_image_path = "detected_objects"

# Execute the tool and get an event with objects detected in the image.
event = Object_Detector_Tool.execute(image=image_path,
                                     labels=labels,
                                     save_object=save_object,
                                     threshold=threshold,
                                     model_size=model_size,
                                     saved_image_path=saved_image_path)

# Print an example of data returned by the tool.
print(event)

final_result = event

print(f"The tool detected {final_result['object_number']} object(s).")
print(f"Labels: {final_result['labels']}.")
print(f"Box Coordinates: {final_result['box']}.")
print(f"Confidence score: {final_result['score']}.")

