<command>
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_tv_stands(image_path):
    # Detect TV stands in the image
    result = Object_Detector_Tool.execute(image_path=image_path)
    if len(result) == 0:
        return 0

    detected_tv_stands = []
    for category in result[0].values():
        for detection in category:
            if 'baseball' in detection['labels'] and 'basketball' not in detection['labels']:
                detected_tv_stands.append(detection)
    
    total_tv_stands = len(detected_tv_stands)
    return total_tv_stands

final_result = count_tv_stands("/nfs/data8/liao/wxie/SAT/SAT_images_train/12667_0.png")
print("Number of TV stands: ", final_result)
</command>
