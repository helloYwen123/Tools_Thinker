<command>
from object_detector import Object_Detector_Tool

final_result = {}
tools = [
    {
        "input_type": "image",
        "output_type": "list",
        "output_example": "detected_objects : {"'baseball': [{'box': (34, 50, 200, 220), 'score': 0.92, 'saved_image_path': 'detected_objects/image_baseball_1.png'}, {'box': (220, 100, 400, 350), 'score': 0.85, 'saved_image_path': 'detected_objects/image_basket_1.png'}, ...]}, object_number : {'baseball': 1, 'basket': 2}"
    }
]

final_result["detected_objects"] = []
for tool in tools:
    detected_objects, object_number = Object_Detector_Tool.execute(image="path/to/image.png", labels=["baseball", "basket"], save_object=True)
    final_result["detected_objects"].extend(detected_objects)
    final_result["object_number"]["baseball"] += 1
    final_result["object_number"]["basket"] += 2

final_result
</command>
