<command>
from object_detector import Object_Detector_Tool

# Load the object detector model
model_path = "/path/to/model.tiny"  # Change this path according to your model
object_detection_tool = Object_Detector_Tool(model_path=model_path)

# List of objects to detect, including 'baseball' and 'basket'
labels = ['baseball', 'basket']

# The confidence threshold for detection
threshold = 0.35

result_list = object_detection_tool.execute(labels=labels, threshold=threshold, save_object=False)

for label in result_list:
    if label['label'] == 'baseball':
        count = len(result_list[label['label']])
    elif label['label'] == 'basket':
        count = len(result_list[label['label']])
    else:
        count = 0

final_result = {'count': count}

print(f"Final result: {final_result}")
</command>
