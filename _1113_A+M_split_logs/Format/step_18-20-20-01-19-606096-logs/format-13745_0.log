from object_detector import Object_Detector_Tool

def count_dining_tables(image_path):
    """Detect dining tables in an image and count them."""
    detected_objects = Object_Detector_Tool.execute(
        image=image_path,
        save_object=True,
        labels=["dining table"]
    )
    
    object_count = {}
    for label in detected_objects.keys():
        if label == "dining table":
            objects = detected_objects[label]
            table_count = len(objects)
            object_count[label] = table_count
    
    dining_table_count = {
        label: len(detected_objects)
        if label == "dining table"
        else detected_objects["dining table"]
    }
    
    return {
        "dining_table_count": object_count,
        "total_objects": dining_table_count
    }

final_result = count_dining_tables("/nfs/data8/liao/wxie/SAT/SAT_images_train/13745_0.png")
print(final_result)
