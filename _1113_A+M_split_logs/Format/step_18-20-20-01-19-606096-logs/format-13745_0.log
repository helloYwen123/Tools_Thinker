# Import necessary tools
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Define variables
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/13745_0.png'  # Path to the image file
labels = ['chair', 'bed', 'table']  # List of object labels to detect
confidence_threshold = 0.35  # Confidence threshold for detection
model_size = 'tiny'  # Size of the model to use ('tiny' or 'base', default: 'tiny')
save_object = False  # Whether to save the detected objects as images (default: False)
saved_image_path = 'detected_objects'  # Path to save the detected object images (default: 'detected_objects')

# Execute the object detector
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, confidence_threshold=confidence_threshold)

# Execute the text detector
result = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])

# Check if text detection is successful after retries
if result:
    detected_text_blocks = result[0]
    print("Detected text:", detected_text_blocks)
else:
    print("Text detection failed after retries.")

final_result = {
    "dining_tables": len(detected_objects)
}

final_result["text_blocks"] = result
