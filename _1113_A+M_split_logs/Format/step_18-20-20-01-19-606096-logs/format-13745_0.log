# Import the required tool module
from Object_Detector_Tool import Object_Detector_Tool

# Set the confidence threshold
threshold = 0.35

# Set the size of the model to use
model_size = "base"

# Set the save object option to True
save_object = True

# Set the saved_image_path to "detected_objects"
saved_image_path = "detected_objects"

# Initialize object_detection tool
observer = Object_Detector_Tool()

# Prepare arguments
arguments = {
    "image": "/nfs/data8/liao/wxie/SAT/SAT_images_train/13745_0.png",
    "labels": ["baseball", "basket"],
    "threshold": threshold,
    "model_size": model_size,
    "save_object": save_object,
    "saved_image_path": saved_image_path
}

# Execute object detection
result = observer.execute(**arguments)

# Get the total number of detected objects
object_number = result.object_number

# Create a dictionary to store detected objects
detected_objects = []

# Loop through the detected objects and save the image
for label, obj_list in result.detected_objects.items():
    for obj in obj_list:
        box = [obj.bbox[0], obj.bbox[1], obj.bbox[2], obj.bbox[3]]
        saved_image_path = saved_image_path + "/" + "/" + str(label) + ".png"
        with open(saved_image_path, "wb") as f:
            f.write(obj.saved_image.encode("utf-8"))

        detected_objects.append(
            {
                "box": box,
                "label": label,
                "score": obj.score,
                "saved_image_path": saved_image_path
            }
        )

# Store the total number of objects as a string
object_number_str = str(object_number)

# Print the number of objects and the saved image paths
print("Number of objects detected: " + object_number_str)
if save_object:
    for det_obj in detected_objects:
        print(det_obj["label"])
        for img in det_obj["saved_image_path"]:
            print("\t" + img)
```

The Python program has been run to detect and save the texts in the image. The final result is a dictionary containing the detected objects along with their coordinates, scores, and saved image paths. If the save_object option is set to True, it will print the information for each object,
