from Image import Image

def calculate_shelvingunits(image_path, language="en"):
    result = Text_Detector_Tool.execute(image_path, languages=[language])
    for detected_items in result:
        for item in detected_items:
            if item[2] == "ShelvingUnit" and "ShelvingUnit" not in item[0]:
                return 1
    return 0

