from object_detector import Object_Detector_Tool
import_name: 'Object_Detector_Tool', 'text_detector'

def count_televisions(image_path):
    detected_objects = Object_Detector_Tool.execute(image=image_path, labels=['tv'], save_object=False, saved_image_path='')
    television_count = {}
    for label, results in detected_objects.items():
        television_count[label] = len(results)
    return television_count

def detect_text(image_path, languages=['en', 'de']):
    result = text_detector.execute(image=image_path, languages=languages, detail=0)
    detected_text = []
    for text_block in result:
        detected_text.append({
            'bounding_box': text_block[1],
            'text': text_block[2].utf8,
            'confidence': text_block[3]
        })
    return detected_text

image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4929_0.png'
television_count = count_televisions(image_path)
text_detected_image = '/nfs/data8/liao/wxie/SAT/SAT_images_train/4929_1.png'
text_blocks = detect_text(text_detected_image, ['en', 'de'])
final_result = {}
for label in television_count:
    final_result[label] = television_count[label]
for text_block in text_blocks:
    final_result['text'] = text_block['text']
final_result['object_count'] = len(final_result)

print(final_result)
```
