from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_dining_tables(image_path):
    tool = Object_Detector_Tool
    label = 'DiningTable'
    save_object = True  # True
    saved_image_path = 'detected_objects'
    
    detected_objects = tool.execute(image_path=image_path,
                                    labels=[label],
                                    save_object=save_object,
                                    saved_image_path=saved_image_path)
    
    if detected_objects:
        # Create a dictionary to count the total number of detected objects for each label in the image.
        object_totals = {}
        for detected_objects_dict in detected_objects[1]:
            if detected_objects_dict['label'] in object_totals:
                object_totals[detected_objects_dict['label']] += 1
            else:
                object_totals[detected_objects_dict['label']] = 1

        # Count the total number of objects for each label. If the save_object parameter is True, then a list of detected objects is created using the object detection tool.
        num_detected_objects = sum(label in detected_objects[1][1].keys() for detected_objects_dict in detected_objects[1] if save_object and detected_objects_dict['label'] in object_totals)
        return '0', Object_Detector_Tool.number_of_objects
    else:
        return '0', 0

if __name__ == "__main__":
    # Path to the scene image
    image_path = "/path/to/image.jpg"
    num_detected_objects, number_of_objects = count_dining_tables(image_path)
    final_result = f"{'Total of DiningTables in the image': 'blanks'}, No. of DiningTables {'Detected in': 'blanks'}"
    print(final_result)

    if number_of_objects > 0:
        print(f"Detected {number_of_objects} dining tables in the scene.")
        print(count_dining_tables(image_path))
    elif not number_of_objects:
        print(f"{'No dining tables to detect': 'blanks'})
