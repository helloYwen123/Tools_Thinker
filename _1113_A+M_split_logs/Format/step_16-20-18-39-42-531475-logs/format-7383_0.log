import text_detector

def text_detection(image, languages, detail):
    result = []
    for language in languages:
        if detail == 0:
            output = text_detector.execute(image=image, languages=[language])
        else:
            output = text_detector.execute(image=image, languages=[language], detail=detail)

        result.extend(output)

    if not result:
        return None

    final_result = []
    for item in result:
        final_result.append(item[0])

    return final_result

