--- Completion 4 ---
<command>
from object_detector import Object_Detector_Tool

# Create an instance of the tool with input parameters
detector = Object_Detector_Tool()

# Set labels to detect
labels = ['baseball', 'basket']

# Set the confidence threshold to 0.35
detector.conf_threshold = 0.35

# Set model size to 'tiny'
detector.model_size = 'tiny'

# Set to save the detected objects
detector.save_object = True
detector.saved_image_path = 'detected_objects'

# Call the tool with the input image and detect labels
result = detector.execute(image='path/to/some_image.png', labels=labels)

# Extract the number of detected objects for each label
object_counts = {label: result[1].get(label) for label in result[1].keys()}

final_result = {
    'count': len(result[0]),
    'counts': {
        label: {count: count for count, count in object_counts.items() if label in result[1][count]}
    }
}

final_result
</command>
Reward: 1.0

