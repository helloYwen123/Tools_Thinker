from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

# Assume the image path is 'path/to/image.png'
result = Object_Detector_Tool.execute(image='path/to/image.png', languages=['en', 'de'])
# Assuming 'detected_objects' is a variable and it has the output from the tool
final_result = {"detected_objects": [{}], "object_number": {}}
for detected_objects in result["detected_objects"]:
    object_name = detected_objects["label"]
    objects_detected = detected_objects["detected_object"]
    if not objects_detected:
        objects_detected = {}
    total_objects = len(objects_detected)
    
    for detected_result in objects_detected["result"]:
        label = detected_result["label"]
        box = detected_result["bbox"]
        confidence = detected_result["score"]
        saved_image_path = objects_detected.get(label, {}).get("saved_image_path", "")
        final_result["detected_objects"][label]["bbox"].append([box[0], box[1], box[2], box[3]])
        final_result["detected_objects"][label]["score"].append(confidence)
        final_result["object_number"][label] = len(objects_detected)
        final_result["object_number"]["baseball"] = len(set([box[0], box[1]]) | set([box[2], box[3]]))
        final_result["object_number"]["basket"] = len(set([box[0], box[1]]) & set([box[2], box[3]]))

    final_result["detected_objects"][label]["bbox"].append([0, 0, max(box[2], box[3]) - min(box[0], box[1]))])
    final_result["detected_objects"][label]["bbox"][1].append(max(box[1], 0))
    final_result["detected_objects"][label]["score"].append(confidence)

    if saved_image_path:
        final_result["detected_objects"][label]["saved_image_path"].append(saved_image_path)
        
final_result
