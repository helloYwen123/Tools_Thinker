<command>
from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_objects(image_path):
    object_detector = Object_Detector_Tool()
    object_detectorTool = object_detector.main(image_path, labels=['baseball', 'basket'], save_object=True)

    text_detector = Text_Detector_Tool()
    text_detectorTool = text_detector.main(image_path, languages=['en'], detail=0)

    object_list = object_detectorTool.results
    text_list = []

    for obj in object_list:
        for l in text_list:
            if l[0][2] == obj[0][2]:
                obj[2][2] = l[2][2]
                obj[1][1] += 1
                break

    score_list = [obj[3] for obj in object_list]
    max_score = max(score_list)
    max_index = score_list.index(max_score)

    final_result = {"object_number": len(object_list)}
    final_result["object_list"] = [{"box": object_list[i][1], "score": score_list[i], "label": object_list[i][2]} for i in range(max_index)]
    final_result["text_list"] = [{"box": text_list[i][1], "text": text_list[i][2], "confidence": (max_score), "confidence_score": score_list[i]} for i in range(max_index)]
    final_result["confidence_score_list"] = [score_list[i] for i in range(max_index)]
    return final_result

# Sample usage
final_result = count_objects('path/to/image.png')
print(final_result)
</command>
