<command>
import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/789_0.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

if isinstance(final_result, dict):
    detected_objects_list = final_result["detected_objects"]
    object_number = final_result["object_number"]

    detected_objects = []
    for detected_object in detected_objects_list:
        detected_object["found"] = final_result["total"]  # Check if the object was found
        detected_objects.append(detected_object)

final_result_list = {
    "detected_objects": detected_objects,
    "object_number": object_number,
}

print(final_result_list)
