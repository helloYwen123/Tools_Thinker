from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['chair'], save_object=True)
chair_detection_count = final_result['object_number']

# Check if 'chair' is detected in the image
if 'chair' in final_result:
    # If True, count how many chairs are detected
    chair_detection_count += 1
    chair_detection_count_total = chair_detection_count
else:
    chair_detection_count_total = 0
chair_detection_count_list = [(f'.[{chair_detection_count}] ch,' if chair_detection_count == chair_detection_count_total else 'no.')] * len(final_result['object_number']) + [[''] * len(final_result['object_number'])]
chair_detection_list = zip(final_result['object_number'], chair_detection_count_list)
chair_detection_output = '\n'.join([f'[{x:x}] {y[0]} [{y[1]}]' for (y, x) in chair_detection_list])

# Example output for 'chair' detection:
print(f'there are {chair_detection_count_total} chairs detected in the image.')
print(f'the chair detection list is {chair_detection_list}')
print(f'detected chair information: \'{chair_detection_output}\'\n')

(final_result['detected_objects'], chair_detection_count_list)
</command>

