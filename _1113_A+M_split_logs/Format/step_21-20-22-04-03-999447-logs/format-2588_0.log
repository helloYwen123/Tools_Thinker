from object_detector import Object_Detector_Tool

# Load the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2588_0.png"

# Call the function to detect objects
result = Object_Detector_Tool.execute(image=image_path)

# Get the detected objects
detected_objects = result["detected_objects"]
object_numbers = result["object_number"]

# Check if objects are detected
if bool(detected_objects):
  # Filter out results with empty box
  detected_objects_filtered = [
    obj for obj in detected_objects if obj["box"] != []
  ]
  
  for detected_object in detected_objects_filtered:
    # Print details
    print(f"Detected object: {detected_object['score']}, {detected_object['box']}")

else:
  # Print that no objects were detected
  print("No objects detected.")

# Print the final result
final_result = {
  "detected_objects": detected_objects,
  "object_number": object_numbers
}

print("Final result:")
print({"detected_objects": final_result["detected_objects"], "object_number": final_result["object_number"]})
