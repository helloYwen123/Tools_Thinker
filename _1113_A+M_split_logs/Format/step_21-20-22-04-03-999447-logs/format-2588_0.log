from object_detector import Object_Detector_Tool

def calculate_chairs(image_path):
    tool_kwargs = {
        "image": image_path,
        "labels": ["chair"],
        "threshold": 0.35,
        "model_size": "tiny",
        "save_object": True,
        "saved_image_path": "detected_objects"
    }
    detected_objects = Object_Detector_Tool.execute(**tool_kwargs)
    chair_count = len(detected_objects["chair"])
    return chair_count

