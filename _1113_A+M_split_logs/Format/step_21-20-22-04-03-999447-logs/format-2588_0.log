<command>
from object_detector import Object_Detector_Tool

# Sample image path for demonstration
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2588_0.png"

# Sample labels to detect
labels = ['baseball', 'basket']

# Confidence threshold for detection (default: 0.35)
confidence_threshold = 0.35

# Save_object flag (default: False)
save_object = True

# Set the desired model size (tiny or base, default: tiny)
model_size = "tiny"

# Optionally, specify the "saved_image_path" directory where object results will be saved
saved_image_path = "detected_objects"

try:
    # Detect objects using the Object_Detector_Tool
    data = Object_Detector_Tool.execute(image=image_path, labels=labels, confidence_threshold=confidence_threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    object_results = data[0]
    object_number = data[1]
except ValueError as e:
    print(e)

# Process the detected objects
for result in object_results:
    if result['score'] > 0.3:
        detected_objects = result[0];
        if len(detected_objects['baseball']) > 0 or len(detected_objects['basket']) > 0:
            final_result = f"The total number of detected objects is {len(detected_objects)}."
        else:
            final_result = f"Text detection failed for all objects. Consider retrying."
    # Output final result
    print(final_result)
