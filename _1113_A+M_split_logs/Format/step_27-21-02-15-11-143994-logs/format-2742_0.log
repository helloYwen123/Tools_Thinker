--- Completion 5 ---
<command>
from object_detector import Object_Detector_Tool

# Read the image
with open('path/to/image.png', 'rb') as image_file:
    image = image_file.read()

# Detect objects
output = Object_Detector_Tool.execute(image=image, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

detected_objects = output[0]
object_number = output[1]

# Print detected objects and object number
for label in detected_objects.keys():
    detected_objects[label] = detected_objects[label][0]

final_result = f"There are {len(detected_objects)} objects detected in the scene: "
for label, detection in detected_objects.items():
    final_result += f"* {label}: "
    if detection[2] != None:
        final_result += f"* Confidence score for {label}: {detection[2]},"
final_result += "* Total number of detected objects: {object_number}\n\n"

print(final_result)
</command>
Reward: 1.0

