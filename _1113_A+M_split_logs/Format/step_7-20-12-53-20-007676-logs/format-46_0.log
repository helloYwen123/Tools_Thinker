```python
import json

def count_baseball_bats(detc_objects, object_number):
    if not detec_objects:
        return 0, object_number  # Return 0 if baseball_bats is not found
    if len(detc_objects) != 2:
        return 0, object_number  # Return 0 if less than 2 baseball bats are found

    num_baseball_bats = 0
    bat_boxes = []
    for bat in detec_objects['baseball']:
        bat_boxes.append(x for x in bat['bx'] if (x.startswith('b'), x != ''))
    for bat in bat_boxes:
        for bat_object in detec_objects['baseball']:
            if bat_object['bx'] == bat:
                num_baseball_bats += 1
                break

    return num_baseball_bats, object_number

if not (detec_objects and 'baseball' in detec_objects) or not ('basket' in detec_objects):
    return 0, 0

final_result = count_baseball_bats(detc_objects, detec_objects)

if not detec_objects:
    return final_result

if final_result[1]:
    return [f"Found {final_result[0]} baseball bats in the image."], final_result[1]
else:
    return final_result
```
