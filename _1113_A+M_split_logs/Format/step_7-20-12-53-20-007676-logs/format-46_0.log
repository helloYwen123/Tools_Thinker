from object_detector import Object_Detector_Tool

# Define a function to count the number of baseball bats
def count_baseball_bats(image_path):
    tools = Object_Detector_Tool.get_tool_classes()
    detector_tool = tools['Object_Detector_Tool']
    detector_tool.load_model(trained_model_path='path/to/indian/the/indian/the/model.h5', device_ids=[0, 1])
    labels = ["BaseballBats"]
    threshold = 0.05
    with detector_tool:
        output_dict = detector_tool.execute(image_path, labels=labels, save_object=False, threshold=threshold)
        baseball_bats_confidence_results = output_dict['baseball'][0]
        baseball_bats_to_count = sum((v['score'] >= 0.05) for v in baseball_bats_confidence_results)
    return baseball_bats_to_count

# Get sample image paths
sample_image_paths = [
    "/nf/data8/Liao/wxie/SAT/SAT_images_train/46_0.png",
    "/nf/data8/Liao/wxie/SAT/SAT_images_train/3_0.png",
    "/nf/data8/Liao/wxie/SAT/SAT_images_train/4_0.png",
    "/nf/data8/Liao/wxie/SAT/SAT_images_train/5_0.png"
]

# Count baseball bats in each sample image
sample_image_counts = [count_baseball_bats(image_path) for image_path in sample_image_paths]
print("Sample image counts:")
sample_image_counts

# Generate a question based on the output
question = f"Based on the counts of baseball bats ({sample_image_counts[1]}, {sample_image_counts[3]}, {sample_image_counts[5]}), how many baseball bats should be expected in a room like the one in the image where these image paths are located?"


# Determine the correct answer
# Since the image paths are not provided, we cannot determine the expected number of baseball bats.
final_result = "The number of expected baseball bats in a room like the one in the image paths is based on the counts provided."

# Print the final answer
print(f"The number of expected baseball bats in a room like the one in the image_paths shown above is {final_result}.")
