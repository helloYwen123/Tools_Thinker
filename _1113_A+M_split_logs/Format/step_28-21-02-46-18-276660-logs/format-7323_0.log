<command>
from object_detector import Object_Detector_Tool

final_result = {}

# Check if there are any HousePlants in the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/7323_0.png"
result = Object_Detector_Tool.execute(image=image_path, labels=["plants", "houseplant"], saved_object=True)

if "plants" in result:
    plants = result["plants"]
    house_plants = total_plants = 0

    for plant in plants:
        if plant["label"].lower() in ["houseplant", "house plant", "houseplant plant", "house plant"]:
            house_plants += 1
        else:
            total_plants += 1

    final_result.update({"house plent": str(house_plants), "total plent": str(total_plants)})

# Check if there are any HousePlants in the image
if final_result.get("house plent"):
    final_result = {**final_result}
else:
    final_result = {}

print(final_result)
</command>
