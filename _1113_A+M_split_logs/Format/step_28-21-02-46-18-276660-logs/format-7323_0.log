from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to_image.png', labels=['House Plant'], save_object=True, saved_image_path='detected_objects')

if isinstance(final_result, tuple):
    detected_objects = final_result[0]
    object_number = final_result[1]

    print(f"Found {len(detected_objects)} HousePlants in the image.")
    for obj in detected_objects:
        print(f"{obj['saved_image_path']} Contains an object with score: {obj['score']}")
else:
    print("No HousePlants detected.")

if object_number > 0:
    print(f"Total detected objects count: {obj_number}")
</command>
