from Object_Detector_Tool import Object_Detector_Tool as ODT

def count_and_locations_on_image(image_path, languages=['en', 'ja'], detail=0):
    # This function counts the number of Desks on the image.
    # The input images are saved in the current directory, and each desk is returned as a list of bounding boxes and scores.
    # The details specify the level of detail for the text detection in each image,
    # which can be set to 0 for a simpler output or 1 for a more detailed one.
    try:
        os.makedirs(image.replace(image_path, ""), exist_ok=True)  # Create directories for saved objects
        detected_object_list = ODT.execute(image=image_path, languages=languages, detail=detail)
        object_numbers = {}

        for label in set([obj['label'] for obj in detected_object_list]):
            if label == 'Desk':
                number_found = object_numbers.get(label, 0)
                object_numbers[label] = number_found+1

                image_path = image.replace(image_path, f"detected_objects/{label}/")
                detected_objects_list = [
                  [obj['bbox'], obj['text'], detection['score'] for obj in obj['detection']])
                detected_objects = ' '.join([obj['text'] for obj in detected_objects_list])

                # Check if there are more than one objects of the same type for the 'Desk' label
                if number_found > 1:
                    object_numbers[label] = number_found+1
                    image_path = image.replace("/detected_objects/Desk/", f"detected_objects/Desk_{number_found}/")
                    detected_objects_list = [
                      [obj['bbox'], obj['text'], detection['score'] for obj in obj['detection']])
                    detected_objects = ' '.join([obj['text'] for obj in detected_objects_list])

                # Save the detected objects to separate directories for each label
                if detected_object_list and 'saved_object' in detected_object_list[0]:
                    detected_object = detected_object_list[0]['saved_object']
                    save_path = f"detected_objects/{label}/"
                    path = f"{save_path}{label}/"
                    if path not in object_numbers.keys():  # Check if this label doesn't exist in object_numbers
                        object_numbers[label] = 1  # Create a directory for this label if it doesn't exist
                    else:
                        object_numbers[label] += 1
                   
