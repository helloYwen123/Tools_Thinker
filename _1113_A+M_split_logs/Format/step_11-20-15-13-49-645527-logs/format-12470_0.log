from tool_object_detector_tool import Object_Detector_Tool
from tool_text_detection_tool import Text_Detector_Tool

# Initialize the tool class
detector_tool = Object_Detector_Tool()

# Set the image path and required parameters
image_path = 'path_to_image.png'
labels = ['table', 'desk']
threshold = 0.25
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

# Execute the tool
result = detector_tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_name=model_size)

if result and result[0]:
    detected_objects = []
    total_objects = None

    for i, obj_label in enumerate(result):
        detected_objects.append({
            'label': obj_label[1]['label'],
            'objects': obj_label[0],
            'count': obj_label[2],
            'result': obj_label[1],
        })

        if total_objects is None:
            total_objects = obj_label[0]
        else:
            total_objects = total_objects + obj_label[0]

    result_str = ','.join([f'{t[1]}: {t[0]} ({t[2]})' for t in result])
    total_objects_str = f'Общее количество обнаруженных объектов: {total_objects}'

    final_result = {
        'detected_objects': detected_objects,
        'total_objects': total_objects,
        'result': result_str,
        'total_objects_str': total_objects_str
    }

    # Test detection by showing the images of detected objects
    for obj in detected_objects:
        img_name = f'detected_objects/{obj["label"]}_{obj["result"]}.png'
        obj['result'] = obj["result"].split("\n")[:3]
        obj['result'] = ' '.join(obj['result'])
        obj['result'] = obj['result'].replace("\n", " ").replace(" ", "_") + " "
        print(f"Detected {obj['label']} ({obj['result']})")

    return final_result
else:
    return "Text detection failed after retries."
