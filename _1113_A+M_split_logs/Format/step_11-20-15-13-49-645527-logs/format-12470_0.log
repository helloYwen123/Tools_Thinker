from object_detector import Object_Detector_Tool

def count_objects_in_scene(filepath):
    detector = Object_Detector_Tool()
    object_labels = detector.execute(image=filepath, labels=['desk', 'bed'], threshold=0.35, model_size='tiny', save_object=False, saved_image_path=os.path.splitext(filepath)[0])

    result = {}
    for label in object_labels["baseball"]:
        if "box" in label:
            result["baseball"] = 1
        elif "basket" in label:
            result["basket"] = 2

    return result

