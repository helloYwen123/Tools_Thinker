import object_detector as od 

class ImageProcessor:
    def detect_objects(self, image_path, labels, threshold, model_size, save_object=True, saved_image_path="detected_objects"):
        """
        DETECTION OBJECTS IN AN IMAGE
        """
        labels = labels if isinstance(labels, list) else [labels]
        
        detection_results = od.object_detector.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
        
        object_count = {}
        
        for label in labels:
            for detection_result in detection_results:
                if detection_result["label"] == label:
                    object_count[label] = detection_result["label"]
                    box = detection_result["box"]
                    score = detection_result["score"]
