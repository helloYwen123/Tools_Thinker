from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

result = {}
final_result = {}

# Demanding text detection in the image
text_result = Text_Detector_Tool.execute(image=image_path, languages=['en', 'de'])
for line in text_result:
    languages = {"en": True, "de": True}
    if line:
        result['detected text'] = [' '.join(line[0])]
        confidence = line[1]
        final_result['detected text'] = {language: score for language, score in zip(languages, confidence)}
    
result = {} if not result else result

if result and 'detected_text' in result['detected_text']:
    label_index = None
    for label, boxes in result['detected_text'].items():
        for box in boxes:
            if box['score'] > 0.35:
                final_result[label_index] = dict(box=box['box'], score=box['score'])
                label_index = label.index(label)

if 'detected_objects' in detected_objects:
    boxes = {}
    for object in detected_objects['detected_objects']:
        boxes[object['label']] = object['box']
    del boxes

    for label, box in boxes.items():
        final_result[label] = dict(box=box, count=len(detected_objects['detected_objects']) - final_result[label])
