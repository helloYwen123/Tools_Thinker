from object_detector import Object_Detector_Tool

result = Object_Detector_Tool.execute(
  image='image_path.png',  # Path to the image file to be analyzed
  labels=['baseball', 'basket'],  # Labels to detect in the image
  threshold=0.3,  # Confidence threshold for object detection
  model_size='tiny'
)

detected_object_results = result["detected_objects"]

baseball_objects = [obj for obj in detected_object_results["baseball"] if obj["score"] > 0.95]
basket_objects = [obj for obj in detected_object_results["basket"] if obj["score"] > 0.95]

# Calculate the total number of baseball and basketball objects
total_baseball_objects = len(baseball_objects)
total_basket_objects = len(basket_objects)

final_result = {"number_of_baseball_objects": total_baseball_objects, "number_of_basket_objects": total_basket_objects}
