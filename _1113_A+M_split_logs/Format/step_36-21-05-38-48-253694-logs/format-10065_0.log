<command>
from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(
    image='path_to_image.png',
    labels=['baseball', 'basket'],
    save_object=True
)

print(f"Number of Chairs detected: {final_result['object_number']['baseball']}")
print("Detected Chairs:")
for chair in final_result['detected_objects']:
    for box in chair['box']:
        print(f"Chair coordinates: {box['x1'], box['y1'], box['x2'], box['y2']}")
    print("")
</command>
