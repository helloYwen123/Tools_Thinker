--- Completion 5 ---
<command>
from object_detector import Object_Detector_Tool
final_result = {}
result = Object_Detector_Tool.execute(image='path_to_image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
for i, item in enumerate(result['detected_objects']):
    if item['box']:
        final_result[i] = {'baseball': 0, 'basket': 0}
        final_result[i]['baseball'] += i + 1
        final_result[i]['basket'] += len(item['box'])
    else:
        final_result[i] = {'baseball': 0, 'basket': 0}
final_result['baseball'] = list(final_result['baseball'].values())
final_result['basket'] = list(final_result['basket'].values())
print(final_result)
</command>
