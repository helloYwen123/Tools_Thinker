from object_detector import Object_Detector_Tool

def count_chairs():
    # Define the image path
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/880_0.png"

    # Call the object detector tool with the image path
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=['chair'], save_object=True, saved_image_path="detected_objects")

    # Extract chair coordinates
    chair_x_coordinates = [int(detected_objects[i]['box'][0]) for i in detected_objects if 'chair' in detected_objects[i]['labels']][0]
    chair_y_coordinates = [int(detected_objects[i]['box'][1]) for i in detected_objects if 'chair' in detected_objects[i]['labels']][0]

    # Count chairs
    chairs_count = detected_objects['chair'].numel()

    return chairs_count

