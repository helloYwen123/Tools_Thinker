from objdet import Object_Detector_Tool

final_result = {"chairs": []}

def check_for_chairs(image_path):
    detected_objects = Object_Detector_Tool.execute(image_path, labels=["chair"], threshold=0.4)
    chair_objects = detected_objects['baseball']
    
    if chair_objects:
        for chair_object in chair_objects:
            chair_object['saved_image_path'] = image_path + '/' + chair_object['saved_image_path'][chair_object['saved_image_path'].rindex('/'):]
            chair_objects[chair_object['object_name']] = chair_object
    
    return chair_objects

chair_objects = check_for_chairs('path/to/image.png')
chair_count = chair_objects['chair']
chair_objects = chair_objects['baseball']
chair_objects['count'] = chair_count['count']
chair_count['count'] = chair_objects.get('count', 0) + 1

if chair_objects:
    chairs = chair_objects['count']
else:
    chairs = 0

final_result['chairs'] = chairs

print("Number of chairs found:", chairs)
print()
final_result
