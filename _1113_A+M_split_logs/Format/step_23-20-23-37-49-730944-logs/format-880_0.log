def count_chairs(image_path):
    try:
        detector = Object_Detector_Tool()
        labels = ["chair"]
        labels.append("table")

        # Execute the tool and create a dictionary of detected objects
        detected_objects_result = detector.execute(image_path=image_path, labels=labels)

        # Initialize counters for total detected objects and chair objects
        total_objects = 0
        chair_objects = 0

        for item in detected_objects_result["objects"]:
            if item["label"] == "chair":
                chair_objects += 1
            elif item["label"] == "baseball" or item["label"] == "basket":
                # Add chairs detected by baseball or basket objects
                chair_objects += 1

        return chair_objects, total_objects
    except Exception as e:
        print(f"Error occurred: {e}")
        return 0, 0

image_path = "/path/to/880_0.png"
chair_objects_count, total_objects_count = count_chairs(image_path)
final_result = {"chair_objects_count": chair_objects_count, "total_objects_count": total_objects_count}
print("Count Chairs:", final_result)
