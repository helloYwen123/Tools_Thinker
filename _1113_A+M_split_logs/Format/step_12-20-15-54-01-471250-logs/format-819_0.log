```python
import object_detector
import text_detector

def detect_items(image_path):
    tool_name = 'Object_Detector_Tool'
    data_type = 'json'
    model_size = 'tiny'
    save_object = True

    command_example = f"detected_objects, object_number = Object_Detector_Tool.execute(image='{image_path}', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')"
    result = object_detector.execute(command=command_example, data_type=data_type, model_size=model_size, model_name='dino', predictable=False, use_gpu=False, save_object=save_object)

    if result:
        detected_items = result['detected_objects']
    else:
        detected_items = []

    return detected_items

def detect_text(image_path, languages=['en', 'de']):
    tool_name = 'text_detector'
    data_type = 'json'
    language_list = languages
    level_of_detail = 1

    command_example = f"text_detector.execute(image='{image_path}', languages={language_list}, detail={level_of_detail})"
    result = text_detector.execute(command=command_example, data_type=data_type, language_list=language_list, level_of_detail=level_of_detail)

    if result:
        detected_text_blocks = result['result']
    else:
        detected_text_blocks = []

    return detected_text_blocks
