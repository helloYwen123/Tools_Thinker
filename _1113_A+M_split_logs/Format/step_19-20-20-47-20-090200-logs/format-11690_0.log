from object_detector import ObjectDetectorTool

class Image:
    def __init__(self, image_path, labels, threshold, model_size="tiny", save_object=True, saved_image_path="detected_objects"):
        self.image_path = image_path
        self.labels = labels
        self.threshold = threshold
        self.model_size = model_size
        self.save_object = save_object
        self.saved_image_path = saved_image_path

    def execute(self):
        object_detector_tool = ObjectDetectorTool()
        detected_objects = object_detector_tool.execute(image=self.image_path, labels=self.labels, threshold=self.threshold, save_object=self.save_object, saved_image_path=self.saved_image_path)

        if not detected_objects["saved_object"]:
            return {}

        detected_objects["object_number"] = len(deprecated_objects["object_number"])
        return detected_objects

