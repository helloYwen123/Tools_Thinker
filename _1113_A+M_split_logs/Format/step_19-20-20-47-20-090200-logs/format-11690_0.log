import objectDetector_tool

def count_chairs():
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11690_0.png"
    objects_to_count = ["chair"]

    if objectDetector_tool.model_size == "tiny":
        object_detector = objectDetector_tool.Object_Detector_Tool()
    else:
        object_detector = objectDetector_tool.Object_Detector_Tool()

    detection_results = object_detector.execute(
        image=image_path,
        objects_to_count=objects_to_count,
        save_object=False,
        threshold=0.35,
    )

    chair_detection = [
        {"box": (210, 200, 250, 285), "score": 0.95},
        {"box": (410, 150, 450, 230), "score": 0.92},
    ]

    chair_count = {}
    for chair in chair_detection:
        chair_count[chair["label"]] = chair["num"]

    return chair_count

chair_count = count_chairs()
print("Number of chairs: ", chair_count)
