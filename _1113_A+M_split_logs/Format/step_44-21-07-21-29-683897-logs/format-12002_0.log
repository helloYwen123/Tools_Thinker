--- Completion 3 ---
<command>
from Object_Detector_Tool import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(
    image='path/to_image.png',
    labels=['电视'],
    save_object=True,
    saved_image_path='detected_objects'
)

print("Number of TVs found:", len(final_result["object_number"]))
print("Detected TV with label '电视':")
for i, info in enumerate(final_result["object_number"].values(), start=1):
    print(f"{i}. {info['name']} ({info['score']:.2f})")
</command>
