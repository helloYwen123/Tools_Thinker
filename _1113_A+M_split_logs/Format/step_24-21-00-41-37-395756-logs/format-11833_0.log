from object_detector import Object_Detector_Tool

def detect_paintings(image_path):
    # Detect the painting and count
    painting_result = Object_Detector_Tool.execute(image=image_path, save_object=True)
    
    # Define languages or regions of interest for more focused detection
    language_eng = "en"
    language_de = "de"
    regions_of_interest = ["baseball", "basket"]
    
    # Execute English- and German-based detection
    painting_result_en = Text_Detector_Tool.execute(
        image=image_path, 
        languages=[language_eng], 
        detail=0
    )
    painting_result = []
    
    for block in painting_result_en:
        if block[2] not in regions_of_interest:
            painting_result.append(block)
    
    # Calculate object number and object counts for various language cases
    object_number = {}
    object_number_en = {label: detect_count(painting_result_en) for label in regions_of_interest}
    object_number_de = {label: detect_count(painting_result_en) for label in regions_of_interest}
    
    return {
        "objects": [
            {
                "object_type": label,
                "object_count": object_number_en[label] if language_eng in painting_result else object_number_de[label]
            }
            for label in regions_of_interest
        ],
        "total_object_count": {label: count if language_eng in painting_result else 0 for label in regions_of_interest}
    }

def count_paintings(painting_result, languages):
    object_counts = {}
    for painting in painting_result:
        if languages:
            language = languages[0] if languages else "en"
            for label in languages:
                object_counts[label] += len([bbox for bbox in painting if bbox[2] == label])
        else:
            object_counts["all"] += len([bbox for bbox in painting if bbox[2] == "all"])
    
    return {label: count if language_lang in object_counts else 0 for label, count in object_counts.items()}

