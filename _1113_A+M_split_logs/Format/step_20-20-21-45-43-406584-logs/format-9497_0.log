from object_detector import Object_Detector_Tool

def count_paintings(*paths):
    detected_objects = []
    object_count = {}
    for path in paths:
        image = Image.open(path)
        for label, coordinates in object_detector(image, save_object=True).items():
            total_count = len(detected_objects) + 1
            message = f"Found {total_count} painting(s) with bounding box: ({coordinates[0]}, {coordinates[1]}, {coordinates[2]}, {coordinates[3]})"
            print(message)
            detected_objects.append(coordinates)
            object_count[label] = len(detected_objects)
    return object_count

