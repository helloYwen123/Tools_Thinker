def count_paintings(image_path):
    """
    Counts the number of paintings in an image based on the Grounding DINO model.
    """
    from object_detector import Object_Detector_Tool

    detected_images = []
    
    model_size = "tiny"
    save_object = True
    
    if save_object:
        detected_images.append('detected_objects')
    
    try:
        object_detector = Object_Detector_Tool(image_path=image_path, labels=["painting"], thresholds=[0.35])
        object_detector.execute()
        if saved_object:
            detected_images.append('detected_objects')
            os.makedirs('detected_objects', exist_ok=True)
            for detected_image in detected_images[0]:
                image_name = detected_image['saved_image_path']
                with open(image_name, 'w') as f:
                    f.write(object_detector[0][0]['image'])
    except Exception as e:
        print(f"An error occurred: {e}")
    
    if len(detected_images) == 2:
        object_number = 2
    elif len(detected_images) == 3:
        object_number = 3
    else:
        object_number = int(detected_images[0])
    
    return object_number, len(detected_images)
