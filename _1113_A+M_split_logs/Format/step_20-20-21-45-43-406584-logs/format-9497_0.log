from object_detector import Object_Detector_Tool

def detect_paintings(image_path, languages, detail=None, retry_times=5, timeout=0.1):
    try:
        tool = Object_Detector_Tool(image_path, languages, detail, retry_times, timeout)
        if tool.success:
            detections = tool.detected_objects
            painting_count = tool.object_number
            return {"paintings_count": painting_count}
        else:
            return None
    except Exception as e:
        print(f"Error occurred: {e}")
        return None

