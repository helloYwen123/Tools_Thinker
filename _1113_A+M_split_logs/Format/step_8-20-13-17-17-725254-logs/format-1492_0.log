from object_detector import Object_Detector_Tool, Text_Detector_Tool

# Define the path of the image file
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/1492_0.png'

# Use the Object_Detector_Tool to detect all objects in the image
with Object_Detector_Tool() as detector:
    try:
        detected_objects = detector.execute(image_path=image_path, labels=['CoffeeMachine'])
        object_number = len(detected_objects)
    except Exception as e:
        print(e)
        object_number = 0

# Use the Text_Detector_Tool to detect text in the image
with Text_Detector_Tool() as detector:
    try:
        detected_texts = detector.execute(image_path=image_path, languages=['en'])
    except Exception as e:
        print(e)
        detected_texts = []

if detected_objects and detected_texts:
    final_result = {
        'image_path': image_path,
        'detected_objects': {
            'objects': detected_objects,
            'labels': [detected_objects[label].keys() for label in detected_objects]
        },
        'detected_texts': {
            'words': detected_texts['Detected text'],
            'confidence_scores': detector.confidences
        },
        'object_number': object_number
    }
elif detected_objects:
    final_result = {'image_path': image_path, 'detected_objects': detected_objects}
else:
    final_result = {'image_path': image_path, 'detected_texts': detected_texts}

print("%s - %d" % (final_result['image_path'], final_result['object_number']))
