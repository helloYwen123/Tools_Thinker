from Object_Detector_Tool import Object_Detector_Tool, saved_image_path
import Image

def find_coffee_machines(image, labels, save_objects, threshold, model_size, languages):
  # Load the object detector model
  object_detector_tool = Object_Detector_Tool()

  # Check if the input image is valid
  if not image:
    raise ValueError("Invalid image path")

  # Check if the language code is in the supported languages
  if not languages or any(l not in ['en', 'de'] for l in languages):
    raise ValueError("Unsupported language")

  # Detect objects in the image
  results = object_detector_tool.execute(image=image, labels=labels, save_objects=save_objects,
                                         threshold=threshold, model_size=model_size, languages=languages)

  # Return the list of detected objects
  return results

