<command>
from object_detector import Object_Detector_Tool, saved_image_path

def find_floor_lamps(image_path, languages=['en', 'de']):
    try:
        result = Object_Detector_Tool.execute(image_path, languages=languages, detail=1)

        # Check if the first detected object is a Floor Lamp
        if 'FLOOR LAMP' in result:
            # If detected, count the number of floor lamps and return their bounding boxes
            object_count = len([obj for obj in result[0] if obj['label'] == 'FLOOR LAMP'])
            object_boxes = [[obj['box'], obj['score']] for obj in result[0] if obj['label'] == 'FLOOR LAMP']

            final_result = {
                'total_floor_lamps': object_count,
                'floor_lamps_boxes': object_boxes
            }

            return final_result
    except Exception as e:
        raise TypeError(f"Failed to find floor lamps: {e}")

    return None

# Sample image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9819_0.png"

# Call the function
first_result = find_floor_lamps(image_path)

if first_result:
    print("Found:")
    for obj in first_result[0]:
        print(f" {' '.join(obj['label'].split(' ')[:100])}")
else:
    print("No floor lamps found.")

try:
    # Check if the model can detect object labels
    detected_objects, object_number = detected_objects = Object_Detector_Tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects")
except Exception as e:
    print(f"Error in object detection: {e}")
except AttributeError as e2:
    print(f"An attribute error occurred: {e2}")
except Exception as e:
    print(f"An unexpected error occurred: {e}")
finally:
    print(object_number)
</command>
