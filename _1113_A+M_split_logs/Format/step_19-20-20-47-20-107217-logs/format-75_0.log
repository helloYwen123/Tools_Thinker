from object_detector import Object_Detector_Tool

# Parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/75_0.png"
labels_to_detect = ["baseball", "basket"]
threshold = 0.35
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Execute object detection
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels_to_detect, save_object=True, saved_image_path=saved_image_path, threshold=threshold, model_size=model_size, languages=["en", "de"].)

# Fetch detected objects and their count
object_pairs = []

for obj in detected_objects["baseball"]:
    box = obj["box"]
    score = obj["score"]

    for obj_pair in detected_objects["basket"]:
        box_pair = obj_pair["box"]
        score_pair = obj_pair["score"]

        if box == box_pair:
            pair = [obj["box"], obj_pair["box"], obj["score"], obj_pair["score"]]
            object_pairs.append(pair)

# Retrieve total object count
object_number_total = object_number["baseball"] + object_number["basket"]

# Create and return final result
final_result = f"Total object count: {object_number_total}"

# Display the results
for pair in object_pairs:
    # Extract bounding boxes and labels
    boxes = [pair[0], pair[1], pair[2], pair[3]]
    
    # Construct object detail string
    object_strings = " ".join(f"({bx[0]}, {bx[1]}, {bx[2]}, {bx[3]})" for bx in boxes)
    
    # Log the detected objects
    print(f"Detected objects: {object_strings}")
    
# Display the final result
print(f"Final result: {final_result}")
