def count_dining_tables(image_path: str) -> int:
    with open(image_path, 'r') as image_file:
        text_objects = text_detector.execute(image=image_file, languages=['en', 'de'])
    dining_tables = [det for det in text_objects if 'Dining Table' in det[0][2]]
    object_number = {}
    for det in dining_tables:
        object_number[det[1]] = object_number.get(det[1], 0) + 1
    return len(dining_tables)

final_result = count_dining_tables("/nfs/data8/liao/wxie/SAT/SAT_images_train/75_0.png")
print("Dining tables found:", final_result)
