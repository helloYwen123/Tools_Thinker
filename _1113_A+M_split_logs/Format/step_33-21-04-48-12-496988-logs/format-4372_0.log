from object_detector import Object_Detector_Tool, Text_Detector_Tool

final_result = {}

result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
labels = result[0].keys()
object_number = result[1]

for label in labels:
    if label == 'baseball':
        detected_boxes = [bbox for bbox in result[0]['baseball'] if label == 'baseball'][0]
        print(detected_boxes)

        score = result[0][label]['score']
        if score > 0.5:
            print('Baseball')
        else:
            print('No ball found')

        detected_obj = result[0][label]['saved_image_path']
        if 'image_baseball_1.png' in detected_obj:
            final_result[label] = 'Image of baseball'
        elif 'image_basket_1.png' in detected_obj:
            final_result[label] = 'Image of basket'
        else:
            final_result[label] = 0

        if save_object:
            print('Detected objects saved successfully.')
    elif label == 'basket':
        detected_boxes = [bbox for bbox in result[0]['basket'] if label == 'basket'][0]
        print(detected_boxes)

        score = result[0][label]['score']
        if score > 0.5:
            print('Basket')
        else:
            print('No ball found')

        detected_obj = result[0][label]['saved_image_path']
        if 'image_baseball_1.png' in detected_obj:
            final_result[label] = 'Image of basketball'
        elif 'image_basket_1.png' in detected_obj:
            final_result[label] = 'Basket'
        else:
            final_result[label] = 0

        if save_object:
            print('Basket detected.')
    else:
        print('Unknown label detected. ignored.')
