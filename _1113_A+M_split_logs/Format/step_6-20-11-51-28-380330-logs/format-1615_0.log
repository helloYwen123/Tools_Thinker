import Object_Detector_Tool
import Text_Detector_Tool

def calculate_objects_and_count(image_path, detected_labels, languages=['en', 'de'], detail=0):
    results = {}
    detected_objects = []
    number_of_objects = {}

    for detected_label in detected_labels:
        result = Text_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
        if result:
            for row in result:
                if row[3] > 0.1:
                    box = [row[0], row[1], row[2], row[3]]
                    results[detected_label] = [box, result[3]]
                    detected_objects.append(box)
                    number_of_objects[detected_label] = len(result)

    if not detected_objects:
        return detected_objects, number_of_objects

    result = []
    for detected_label, (box, confidence_score) in results.items():
        if confidence_score > 0.5 and len(box) > 2:
            result.append((detected_label, box))

    if result:
        detected_objects = [obj[0] for obj in result if obj[1]]
        number_of_objects = {detected_label: len(result) for detected_label, (box, _) in results.items() if box and box[0] % 1 == 0}
    return detected_objects, number_of_objects

