def detect_objects(image_path, labels):
    labels = labels.split(", ")
    detected_objects = {}
    object_number = {}
    result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path="detected_objects")
    for obj in result[0][1]:
        labeled_object = {}
        if labels[0] in obj[0]:
            detected_objects[labels[0]] = []
            object_number[labels[0]] = 1
        else:
            detected_objects[labels[0]] = detected_objects[labels[0]] + [obj[0]]
            object_number[labels[0]] += 1
        labeled_object["box"] = obj[0]
        labeled_object["score"] = obj[2] * 0.99
        if obj[3] != None:
            marked_name = f"{obj[3]}_{labels[0]}"
            labeled_object["saved_image_path"] = f"detected_objects/{marked_name}.png"
            labeled_object["confidence"] = obj[3]
        detected_objects = detected_objects | labeled_object
    return (detected_objects, object_number)

