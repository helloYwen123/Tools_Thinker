```python
from object_detector import Object_Detector_Tool
final_result = ""
detected_objects = {}
object_number = {}

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/7862_0.png"

labels = ["baseball", "basket"]

try:
    result = Object_Detector_Tool.execute(image=image_path, labels=labels)  # Detecting objects
    if result[0][0] is not None:
        detected_objects = result[0]
        object_number = result[1]
except ValueError as e:
    print(e)

if detected_objects:
    # Create a dictionary that maps each label to a list of detection results.
    mapped_labels = {k: [[*bbox, *[f"Detected {k}", score]] for bbox, score, label in result[0][0][0]] for k, label in labels}

    # Print the detected objects and their count.
    for label, detected_objects in mapped_labels.items():
        print(f"{label}:")
        for det in detected_objects:
            print(f"{det[1]}, score: {det[2]}")
        
    print(f"Object number: {len(detected_objects)}")
else:
    print("No objects detected.")
