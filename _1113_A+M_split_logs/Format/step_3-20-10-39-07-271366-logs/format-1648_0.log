# Python script for counting and locating text in an image
from text_detector import Text_Detector_Tool

def count_and_locate_text(image_path, languages=['en', 'de'], detail=1):
    try:
        text_data = Text_Detector_Tool.execute(image=image_path, languages=languages, detail=detail)
        if text_data:
            detected_text_blocks = []
            for block in text_data:
                if block:
                    detected_text_blocks.append(block)
            return detected_text_blocks
        else:
            return []
    except Exception as e:
        print(e)
        return []

def visualize_image(image_path, detected_text_blocks):
    if detected_text_blocks:
        for block in detected_text_blocks:
            print(f"Detected text block coordinates: X: {block[0][1]}, Y: {block[0][0]}, Width: {block[2][2]}.")

def answer_question():
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1648_0.png"  # Replace with actual image path
    languages = ["en", "de"]  # Replace with actual languages
    detail = 0  # Replace with desired level of detail

    # Detect text
    detected_text_blocks = count_and_locate_text(image_path, languages=languages, detail=detail)

    # Visualize detected text blocks
    visualize_image(image_path, detected_text_blocks)

final_result = answer_question()
print(final_result)
```

Remember to replace the `image_path` with the actual image path, and modify the `languages` and `detail` variables to your preferences. The answer is 1
