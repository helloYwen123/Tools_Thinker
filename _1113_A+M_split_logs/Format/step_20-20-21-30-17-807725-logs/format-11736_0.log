from object_detector import Object_Detector_Tool

def count_sofas_and_objects(image_path):
    tool_kwargs = {
        "image": image_path,
        "labels": ["sofa", "chair"],
        "save_object": False,
        "threshold": 0.35
    }
    detected_objects = Object_Detector_Tool.execute(**tool_kwargs)
    
    sofa_count = 0
    for sofa_label in detected_objects["baseball"]:
        sofa_count += detected_objects["baseball"][0]["box"][0][2] * detected_objects["baseball"][0]["box"][1][0]
    object_number = {
        "baseball": sofa_count,
        "chair": 1
    }

    return object_number

final_result = count_sofas_and_objects("/nfs/data8/liao/wxie/SAT/SAT_images_train/11736_0.png")
print(final_result)
</command>
