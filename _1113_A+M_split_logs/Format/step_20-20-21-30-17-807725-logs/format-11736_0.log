from object_detector import Object_Detector_Tool

# Input options
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11736_0.png"
label = ["baseball", "basket"]
save_object = False
saved_image_path = "detected_objects"

# Execute the object detection tool
result = Object_Detector_Tool.execute(image=image_path, labels=label, save_object=save_object, saved_image_path=saved_image_path)

# Iterate through the detected objects
for obj_info in result["detected_objects"]:
    detected_obj = obj_info[0]
    detected_count = detected_obj[1]
    detected_text = detected_obj[4]
    confidence_score = obj_info[3]
    
    print(f"Detected {detected_text} with CoF: {confidence_score}")

    # Check if text detection is successful
    if confidence_score >= 0.95:
        print(f"Confidence score: {confidence_score}, Detected Text: {detected_text}")

    # Check if text is not empty
    if len(detected_text) > 0:
        print(detected_text)
        text_blocks = detected_obj[0]
        text_details = detected_obj[2]
        for block in text_blocks:
            print(f"Text Block: {block[0]}, Text: {block[1]}, Confidence Score: {block[2]}")
    else:
        print("No detected text found.")
```

The Python program is generated by using the `Object_Detector_Tool.execute` function to execute the object detection tool and then iterating through the results, extracting the detected objects and their details. The confidence score for each detected object and the text within the bounding box is displayed.
