            ball_info += ''.join(ball_info)
        if baseball_info:
            baseball_info += ''.join(baseball_info)
        ball_info = ball_info + ' ' + baseball_info

    if ball_info:
        final_result = {'paintings': ball_info, 'total_paintings': len(detected_ball_info)}

    return final_result

