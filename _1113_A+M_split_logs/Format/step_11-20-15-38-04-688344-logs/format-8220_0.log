        ball_info = ['Detected ball', f'Box: ({detected_ball["bbox"][0]}, {detected_ball["bbox"][1]}, {detected_ball["bbox"][2]}, {detected_ball["bbox"][3])}\nScore: {detected_ball["score"]:.2f}']
        ball_info += [f'\nDetected text: {detected_ball["text"].lower()}' if detected_ball["text"] else None for detected_ball in detected_objects['baseball']]

    elif 'baseball' in detected_objects and detected_ball is None:
        baseball_info = ['Detected ball', f'Box: ({detected_ball["bbox"][0]}, {detected_ball["bbox"][1]}, {detected_ball["bbox"][2]}, {detected_ball["bbox"][3])"\nScore: {detected_ball["score"]:.2f}']
