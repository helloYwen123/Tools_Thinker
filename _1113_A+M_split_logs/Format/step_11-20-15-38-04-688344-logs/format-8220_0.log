from Text_Detector_Tool import Text_Detector_Tool

def text_detector(image, languages, detail):
    result = []
    for language in languages:
        text_results = Text_Detector_Tool.execute(image=image, languages=[language])
        for row in text_results:
            if detail is None or row[1] > detail:
                result.append(row)
    return result

