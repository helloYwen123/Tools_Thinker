from object_detector import Object_Detector_Tool

# Get the path to the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2942_0.png"

# Create a new Object_Detector_Tool instance
tool = Object_Detector_Tool()

# Set the language to detect text in
languages = ["en", "fr"]  # You can add more languages if needed

# Call the detect method to detect text in the image
result = tool.execute(image=image_path, languages=languages)

# Check if text detection failed after retries
if not result:
    # If text detection failed, print the error
    print(f"No text detected in the image.")
else:
    # If text detection succeeded, print the detected text blocks
    print(result)

# Extract the detected text blocks and confidence scores
detected_blocks = result[0]
confidence_scores = [det[2] for det in detected_blocks]

# Sort the detected blocks by their confidence scores in descending order
sorted_blocks = sorted(detected_blocks, key=lambda x: x[2], reverse=True)

# Print the first and last detected blocks
print("First detected block:")
print(sorted_blocks[0])

# Print the last detected block
print("Last detected block:")
print(sorted_blocks[-1])
