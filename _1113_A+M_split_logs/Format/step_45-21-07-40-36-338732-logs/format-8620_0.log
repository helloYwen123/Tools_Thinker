<command>
from Object_Detector_Tool import Object_Detector_Tool

# Initialize the Object_Detector_Tool with the specified parameters
detected_objects = Object_Detector_Tool.execute(image="path/to/image.png", labels=["chair"], save_object=True, saved_image_path="detected_objects")

final_result = {"chair": 0}
for label in detected_objects:
    if label["box"][0] >= 0 and label["box"][1] >= 0 and label["box"][2] < 0.3:
        final_result[label["box"][0]] += label["score"]
final_result["chair"] = int(final_result["chair"])

if final_result["chair"] >= 2:
  print("There are", final_result["chair"], "chairs in the scene.")
else:
  print("There are", final_result["chair"], "chairs visible in the scene.")
</command>
