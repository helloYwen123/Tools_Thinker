from object_detector import Object_Detector_Tool

# Input data
input_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6424_0.png"

# Generate the output string
def generate_output(object_number, languages):
    output = ["", ""]
    if object_number == 5:
        output[0] = [f"5".ljust(5), f"Total: 5\ntext blocks identified"]
    else:
        output[0] = [f"{object_number}".ljust(5), f"Total: {object_number}\ntext blocks identified"]
    for language in languages:
        if language not in object_number:
            output[1] = [f"[{language}]: No identified text for {language}"]
        else:
            result = Text_Detector_Tool.execute(image=object_number[language].image_path, languages=languages)
            if result[0] == []:
                output[1].append(f"Text block {language}: No text detected.")
            else:
                output[1].append([f"Detected {language}", f"{result[0][0][1]}"])  
    return output

object_number, languages = text_detector.execute(image=input_image_path, languages=['en', 'de'])
final_result = generate_output(object_number, languages)

for language in final_result[1]:
    print(language)
        if language == "":
            pass
        else:
            print("No detected text for:", language)

        print(final_result[0][0][1])  # Extract the English text
