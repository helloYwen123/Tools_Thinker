from object_detector import Object_Detector_Tool

def count_paintings(object_labels, image_path, threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects"):

    detected_objects = []

    # Detect objects
    result = Object_Detector_Tool.execute(image=image_path, labels=object_labels, threshold=threshold, model_size=model_size, save_object=True, saved_image_path=saved_image_path)
    detected_objects = result[1]

    # Check for paintings
    paintings_count = dict()
    for detection in detected_objects:
        filename = f"{object_labels[0]}_painting_{int(detection['box'][cv2 cv2]}_{int(detection['score'])}.png"
        if filename in image_path + f'/{filename}':
            paintings_count[object_labels] = detection['score']

    if paintings_count:
        final_result = f"{paintings_count}"
    else:
        final_result = "No paintings found"

    return deteced_objects, final_result

# Example usage
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6424_0.png"
object_labels = ["basket", "baseball"]

deteced_objects, final_result = count_paintings(object_labels, image_path)

# Output example
print(final_result)
