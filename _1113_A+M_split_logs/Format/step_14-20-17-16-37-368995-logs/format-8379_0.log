```python
from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

import os

def count_image_paintings(image_path):
    painting_count = {}
    painting_details = {}
    # Load the image
    image = Image.open(image_path)

    # Convert the image to RGB for better processing
    image = image.convert("RGB")

    # Detect paintings
    paintings = Object_Detector_Tool.execute(image=image, labels=["painting"], save_object=True, saved_image_path='detected_paintings')
    for painting in paintings:
        detected_id = painting[0]["id"]
        if detected_id in painting_count:
            painting_count[detected_id] += 1
        else:
            painting_count[detected_id] = 1
            painting_details[detected_id] = {'count': 1, 'label': "painting"}

    # Detect text
    languages = ["en", "de"]
    text_details = []
    for language in languages:
        text_details = Text_Detector_Tool.execute(image=image, languages=[language], detail=0)      
        for text in text_details: 
            detected_id, confidence, text = text
            if detected_id in painting_details:
                painting_details[detected_id]['count'] += int(confidence)
            else:
                painting_details[detected_id] = {'count': int(confidence), 'label': language}

    return painting_count, painting_details
