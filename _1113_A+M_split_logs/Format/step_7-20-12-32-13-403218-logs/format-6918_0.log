from tool_detections import Object_Detector_Tool, Text_Detector_Tool

def count_beds_in_scene():
    # Path to the scene image
    image_path = "/path/to/beds_image.png"
    
    try:
        # Execute object detection with default parameters
        beds = Object_Detector_Tool.execute(image=image_path, labels=["bed"],
                                           save_object=True, saved_image_path="$saved_objects")
        
        beds_count = len(beds)
        if beds_count == 4:
            return 4
        elif beds_count == 2:
            return 2
        elif beds_count == 0:
            return 0
        else:
            return 1
    except Exception as e:
        print(f"Error occurred: {e}")
        return 1

final_result = count_beds_in_scene()
print("Number of beds:", final_result)
