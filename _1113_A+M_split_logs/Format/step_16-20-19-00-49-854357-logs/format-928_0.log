from Object_Detector_Tool import Object_Detector_Tool

def count_paintings():
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/928_0.png"
    labels = ["painting"]
    threshold = 0.35
    model_size = "tiny"
    save_object = True

    result = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)
    if "Painting" in result:
        object_number = result["Painting"]["number"]
        for i in range(object_number):
            detected_objects = result["Painting"]["detected_objects"][i]["box"]
            image_path = result["Painting"]["detected_objects"][i]["saved_image_path"]
            painting = {
                "label": "painting",
                "bbox": detected_objects,
                "image_path": image_path,
                "score": result["Painting"]["score"],
            }
            yield painting

        objects = result["Painting"]["detected_objects"][-1]
        number_image = objects["saved_image_path"]
        image_size = objects["bbox"]
        
        width, height = image_size[:2]
        height_percentage = (int(height * 100) / width)
        if str("de") in result["Painting"]["languages"]:
            det_label = "watercolor"
            det_bbox = (objects["bbox"][0], objects["bbox"][1], objects["bbox"][2] + objects["bbox"][3], objects["bbox"][1] + objects["bbox"][2])

        else:
            det_label = "painting"
            det_bbox = (objects["bbox"][0], objects["bbox"][1], objects["bbox"][2], objects["bbox"][3])

        painting = {
            "label": det_label,
            "bbox": det_bbox,
            "image_path": number_image,
            "score": int(result["Painting"]["score"]),
        }
        yield painting
    else:
        print("No painting found.")
        painting = {
            "label": "wall",
            "bbox": ["0", "0", "100", "100"],
            "image_path": "path/to/image.png",
            "score": 0.4,
        }
        yield painting

