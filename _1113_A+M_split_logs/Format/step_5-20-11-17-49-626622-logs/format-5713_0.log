            # Convert this pixel to an open source image library format.
            mask[y,x] = mask[y,x] | image[y,x].depth
            
    # Count the number of non-zero pixels
    count_non_zero = np.count_nonzero(mask)
    
    # If the number of non-zero pixels is less than or equal to the
    # given threshold, the object is detected.
    if count_non_zero < 10:
        return 0
    
