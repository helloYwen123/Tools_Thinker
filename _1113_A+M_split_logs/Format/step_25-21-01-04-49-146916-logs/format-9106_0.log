from object_detector import Object_Detector_Tool

def count_counter_ops(image_path, labels='all', threshold=0.35, save_object=False, saved_image_path="detected_objects"):
    # Load the image
    image = Image.open(image_path)

    # Detect objects
    object_list = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, save_object=save_object, saved_image_path=saved_image_path)

    # Count objects
    object_number = {'baseball': 0, 'basket': 0}

    for label, results in object_list.items():
        object_number[label] += len(results)

    return object_number, object_list

# Load the image
image_path = "/path/to/image.png"

# Count counter_ops
object_number, object_list = count_counter_ops(image_path)

# Output the results
print("Counter-Operators count:")
for label, count in object_number.items():
    print(f"{label}: {count}")

print("Result:")
for result in object_list:
    print(result)
