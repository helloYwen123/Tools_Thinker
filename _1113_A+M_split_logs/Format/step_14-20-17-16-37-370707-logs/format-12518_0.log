from object_detector import Object_Detector_Tool

def count_windows(image_path, labels, save_object):
    window_count = {'baseball': 0, 'basket': 0}
    with open(image_path, 'rb') as image_file:
        with open('/nfs/data8/liao/wxie/SAT/SAT_images_train/12518_0.txt', 'a') as txt_file:
            for window in Image.open(image_path):
                window_bbox = window.getbbox()
                if window_bbox and ('baseball' in labels or 'basket' in labels):
                    window_count['baseball'] += 1
                    window_bbox = box_to_bb(window_bbox)
                    txt_line = f"baseball('{window_bbox}', {window_count['baseball']}, {window_bbox[:-1]})"
                    txt_file.write(f"baseball('{window_bbox}', {window_count['baseball']}, {window_bbox[:-1]}){'\n'}")
                    window_count = {'baseball': 0, 'basket': 0}
    txt_file.close()
    return window_count, window_count['baseball'], window_count['basket']

def box_to_bb(box):
    x, y, w, h = box
    return [x, y - h // 2, x + w // 2, y + h // 2]

window_count, count_baseball, count_basket = count_windows('/nfs/data8/liao/wxie/SAT/SAT_images_train/12518_0.png', labels=['baseball', 'basket'], save_object=True)
final_result = (f"'baseball': {count_baseball}', 'basket': {count_basket}')"
print(final_result)
