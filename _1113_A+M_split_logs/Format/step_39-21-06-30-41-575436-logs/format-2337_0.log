from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['Vase', 'Plants'], save_object=True, saved_image_path='detected_objects')

if type(final_result) == dict:
    total_vases = final_result['total_objects']['Vase']
    total_plants = final_result['total_objects']['Plants']
    print(f"Total Vases: {total_vases}")
    print(f"Total Plants: {total_plants}")
else:
    print("Vases were not detected")
