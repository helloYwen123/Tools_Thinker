from object_detector import Object_Detector_Tool

def count_paintings(image_path):
    # Call the "Object_Detector_Tool" with necessary inputs.
    detected_objects_result = Object_Detector_Tool.execute(
        image=image_path,
        save_object=True,
        saved_image_path='detected_objects'
    )
    # Check if any paintings are detected.
    if 'baseball' in detected_objects_result:
        baseball_detected = detected_objects_result['baseball']
        number_of_baseball = len(baseball_detected)
    else:
        number_of_baseball = 0
    if 'basket' in detected_objects_result:
        basket_detected = detected_objects_result['basket']
        number_of_basket = len(basket_detected)
    else:
        number_of_basket = 0
    # Create a list to collect paintings and non-paintings.
    detected_paintings = [object['saved_image_path'] for object in detected_objects_result['baseball']
        if object['bbox'][1] == 110 and object['bbox'][3] == 180 and 'baseball' in object['bbox']]
    # Check if a painting exists for each detected basket.
    painting_count = 0
    for object in basket_detected:
        if 'basket' in object and object['bbox'][3] == 180 and object['bbox'][1] == 300 and 'basket' in object['bbox']:
            painting_count += 1
    final_result = {
        'paintings': detected_paintings,
        'number_non_paintings': 671 - len(detected_paintings),
        'number_paintings': number_of_baseball + number_of_basket - painting_count,
        'number_non_paintings': len(basket_detected) - painting_count
    }
    return final_result

image_url = '10862_0.png'
paintings_count = count_paintings(image_url)
print("Number of paintings detected:", paintings_count)
print("Total number of images included: 671") if paintings_count > 0 else print("No paintings detected.")
print("Count of non-paintings images included in the main gallery:", 671 - paintings_count) if paintings_count > 0 else print("No non-paintings images included in the main gallery.")
</code>
