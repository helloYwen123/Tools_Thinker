<command>
from object_detector import Object_Detector_Tool

# Set the confidence threshold
object_detector_tool = Object_Detector_Tool()

# Get the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4961_0.png"

# Execute the object detection (max retries are 5)
result = object_detector_tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Get the detected objects count
detected_objects = result[0]

# Get the total detected objects count
total_detection_count = result[1]

final_result = f"A total of {total_detection_count} detection objects were detected in the image."

# Check if additional text detection was performed
if "Detected text" in detected_objects[0]:
    print("Additional text detection detected:")
    for block in detected_objects:
        print(f"Detected text: {block[2]}, Confidence score: {block[3]}")
else:
    print("No additional text detection performed.")

finally:
    # Clean up the object model if the save_object option is set to False
    if not object_detector_tool.save_object:
        del object_detector_tool
</command>

