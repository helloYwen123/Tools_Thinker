from object_detector import Object_Detector_Tool

# Initialize the object detector tool with the necessary inputs
detector_tool = Object_Detector_Tool(
  input_types={
    "image": "/nfs/data8/liao/wxie/SAT/SAT_images_train/4961_0.png",
    "labels": ["baseball", "basket"],
    "threshold": 0.35,
    "model_size": "tiny",
    "save_object": True,
    "saved_image_path": "detected_objects"
  },
  output_types={
    "detected_objects": {"object_number": 2},
    "object_number": {"baseball": 1, "basket": 2}
  }
)

# Execute the object detection tool with the model detected using ``object_detector``
objects = detector_tool.execute()

final_result = (
  f"The model detected {objects['detected_objects']['baseball']} baseball in the image."
  f"It also found {objects['detected_objects']['basket']} basketball in the scene."
)

print(final_result)
