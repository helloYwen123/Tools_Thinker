<command>
from object_detector import Object_Detector_Tool

def count_objects(image_path, labels=None, threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects'):
    detected_objects = Object_Detector_Tool.execute(image_path, labels, threshold, 'tiny', save_object, saved_image_path)
    object_number = {}

    if detected_objects:
        for object_data in detected_objects['baseball']:
            object_number.update({"baseball": object_data['number']})

        for object_data in detected_objects['basket']:
            object_number.update({"basket": object_data['number']})

    return detected_objects, object_number

# Convert the question to a variable format
question = f"Count the number of Doorways in the scene."

# Call the function with the question and variable contents.
result = count_objects(image_path, question)
final_result = {"count of Doorways": len(result['baseball'])}
print(final_result)
</command>
