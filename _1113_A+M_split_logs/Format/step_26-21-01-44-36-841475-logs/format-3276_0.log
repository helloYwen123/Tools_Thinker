from Object_Detector_Tool import Object_Detector_Tool


def count_paintings():
    tool = Object_Detector_Tool
    image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3276_0.png"
    labels = ['painting']
    threshold = 0.35
    model_size = "tiny"

    detected_objects, object_count = tool.execute(image, labels=labels, save_object=True, threshold=threshold, saved_image_path='detected_objects')

    if detected_objects:
        for detected_object in detected_objects['baseball']:
            print(f'Baseball detected: {detected_object["score"]}')

        for detected_object in detected_objects['basket']:
            print(f'Basket detected: {detected_object["score"]}')

        number_paintings = len(detected_objects['painting'])
        detected_paintings = [{'score': detected_object['score'], 'text': detected_object['text']} for detected_object in detected_objects['painting']]

        detection_count = object_count['painting']
