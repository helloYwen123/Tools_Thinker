  labels_to_check = ['baseball', 'basket']
  total_labels = 0
  for _label_to_check in labels_to_check:
    detected_objects = Object_Detector_Tool.execute(image=image, labels=[_label_to_check], save_object=True, saved_image_path=None)
    detected_objects = [obj for obj in detected_objects if obj['labels'][0] == _label_to_check]
    if detected_objects:
      total_labels += 1
  final_result = ({'baseball': total_labels, 'basket': 0}, {'basket': 0, 'baseball': total_labels})
else:
  final_result = ('', {})

