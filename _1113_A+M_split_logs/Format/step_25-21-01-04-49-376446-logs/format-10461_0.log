from object_detector import Object_Detector_Tool

final_result = {}
labels_to_search = ['side_table']
object_number_for_search = {}
threshold = 0.35
model_size = 'tiny'

label_results = ['side_table']

# Call the tool to search for objects with desired labels
result = Object_Detector_Tool.execute(image="path_to_image.png", labels=label_results, threshold=threshold, model_size=model_size, save_object=False, saved_image_path="detected_objects")

for detected_object in result:
    label = detected_object[0]
    if label in label_results:
        if 'box' in detected_object:
            x1, y1, x2, y2 = detected_object['box']
            score = detected_object['score']
            saved_image_path = detected_object.get('saved_image_path', None)
            # Check if a save was set
            if saved_image_path:
                saved_image_path = saved_image_path.replace('.png', '')
                # Import the image
                from_module = import_name
                import_name = 'import_module_name'
                module_object = eval(f"{import_name}.ImageObject(path_to_saved_image, threshold={threshold}, saved_image_path=saved_image_path)")
                # Create a dictionary with the relevant information
                if from_module == Object_Detector_Tool:
                    detected_object[0].append({'image': f'<module>.save_image({x1}, {y1}, {x2}, {y2})', 'label': label})
                elif from_module == Text_Detector_Tool:
                    detected_object[0].append({"text": detected_object[0][0]['content'], 'confidence': detected_object[0][0]['score'],
                                                'language': 'en'})
        object_number_for_search[label] = object_number_for_search.get(label, 0) + 1
        # Save detected objects as images if 'save_object' is True

final_result['object_number'] = object_number_for_search
final_result['detected_objects'] = result

# Print the results
print(final_result)

# Final results
if saved_image_path:
    print(f'Image with {label} detected: {saved_image_path}')

if 'detected_objects' in result:
    print(f'Number of objects for {label}: {result["detected_objects"][0]}')
