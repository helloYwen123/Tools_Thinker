from tool_module.object_detector import Object_Detector_Tool

# Set the path to the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/10461_0.png"

# Set the labels for DetectBaseball and DetectBasketball
labels = ["DetectBaseball", "DetectBasketball"]

Object_Detector_Tool.register_tool("object_detector", "Object_Detector_Tool")

# Run the object detector
detected_objects, object_numbers = Object_Detector_Tool.execute(image=image_path, labels=labels, languages=["en", "de"], detail=0)

# Convert the detected objects to a JSON format
json_output = {
    "object_numbers": object_numbers,
    "object_count": len(detected_objects)
}

# Extract DetectBaseball and DetectBasketball from the object list
detect_labels = []
for i in object_numbers:
    if "DetectBaseball" in i or "DetectBasketball" in i:
        detect_labels.append(i.split(" ")[3])

json_output["detect_labels"] = detect_labels

final_result = json_output
</command>
