from object_detector import Object_Detector_Tool

# Create the object detector tool
od = Object_Detector_Tool()

# Execute the tool with sample parameters
detected_objects, object_count = od.execute(
    image="path/to/dining_table.jpg",
    labels=["Table", "Sofa"],
    save_object=True
)

final_result = {
    "objects_detected": {
        "Table": len(detected_objects["baseball"]),
        "Sofa": len(detected_objects["basket"]),
    },
    "total_objects_dectected": max(len(detected_objects["baseball"]), len(detected_objects["basket"]))
}
print(final_result)


