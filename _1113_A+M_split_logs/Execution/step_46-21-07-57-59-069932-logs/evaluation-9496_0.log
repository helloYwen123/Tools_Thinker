def count_paintings(image_path):
    with open(image_path, 'rb') as f:
        result = Object_Detector_Tool.execute(image=image_path, labels=['painting'], threshold=0.35, model_size='tiny', save_object=True, saved_image_path='detected_objects')
        painting_count = len(result['image_baseball'])
        return painting_count

final_result = count_paintings('/path/to/first_image.png')
print("Number of paintings: ", final_result)


