from object_detector_tool import Object_Detector_Tool
from text_detector_tool import Text_Detector_Tool

# Get the image path
image_path = '/path/to/image.png'

# Get the desired language
languages = ['en', 'de']

# Set the detection detail
detail = 1

# Call the object detector tool
detected_objects = Object_Detector_Tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')

# Call the text detector tool
result = Text_Detector_Tool.execute(image=image_path, languages=languages, detail="0")

final_result = {
    'detected_objects': detected_objects if detected_objects else [],
    'object_number': {k: len(result) for k, v in detected_objects.items()}
}

if result and 'boxes' in result[0]:
    final_result['detected_objects']['boxes'] = [box[0] for box in result[0]['boxes'] if box[4] > detail]
    final_result['detected_objects']['texts'] = [box[2] for _, box in result[0]['boxes'] if box[4] > detail]

# Add the detected text and object numbers to the final result
for obj_id, count in final_result['object_number'].items():
    for i, element in enumerate(detected_objects):
        if element['label'] == obj_id:
            final_result['detected_objects']['boxes'].append([x for x in element['boxes'] if x[2] > detail][i])
            final_result['detected_objects']['texts'].append(element['label'])

print(final_result)


