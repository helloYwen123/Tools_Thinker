import tools_tool

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9357_0.png"
languages = ["en", "de"]
detail_level = 1

result = tools_tool.text_detector.execute(image=image_path, languages=languages, detail=detail_level)

print("Detected Text Blocks:")
for detected_text_block in result:
    text = detected_text_block[1][1][0]
    confidence_score = detected_text_block[1][2]
    print(f"[[{detected_text_block[1][1][0]], '{text}', {confidence_score}])")

final_result = result if result else []
print("Final Result:")
for detected_text in final_result:
    print(detected_text)


