from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

def count_fridges(image_path, languages=['en', 'fr'], detail=1):
    # Load the model
    model = Object_Detector_Tool(model_size="base")

    # Detect objects by image or labels
    results = model.execute(image_path, languages=languages, detail=detail)

    # Count the number of fridges detected in the image
    total_objects = len(results)

    return {"fridges": total_objects, "image_info": {"width": model.image.width, "height": model.image.height, "object_count": len(results)}} 

print(count_fridges("/nfs/data8/liao/wxie/SAT/SAT_images_train/8468_0.png"))


