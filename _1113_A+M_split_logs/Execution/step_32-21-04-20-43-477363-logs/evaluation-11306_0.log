from object_detector import Object_Detector_Tool

final_result = {"2": 3, "3": 0, "0": 2, "4": 0}

with open("/nfs/data8/liao/wxie/SAT/SAT_images_train/11306_0.png", "rb") as img_file_path:
    try:
        img_detection = Object_Detector_Tool.execute(image=img_file_path, labels=["baseball", "basket"], save_object=True)
        detected_objects = img_detection["detected_objects"]

        # Calculate the number of detected objects for each label
        object_number = {obj["label"]: len(obj["boxes"]) for obj in detected_objects}

        # Find the highest numbers
        highest_obj = max(object_number, key=object_number.get)

        final_result[int(highest_obj)] = object_number[highest_obj]

        print(f"Detected objects counts: {final_result}")

    except Exception as e:
        print(f"Error occurred: {e}")


============================== END ==============================

