from object_detector import Object_Detector_Tool

def countWindows():
    # Load and resize the image
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/6083_0.png"
    image = Image.open(image_path)
    image = image.resize((640, 640))

    # Detect windows
    result = Object_Detector_Tool.execute(image=image)
    windows = result[0]
    
    # Calculate the number of windows
    if windows:
        window_count = len(windows)
    else:
        window_count = 0

    return window_count

# Check if there are any windows and return the result
final_result = countWindows()
print(f"There are {final_result} window(s)")


