from object_detector import Object_Detector_Tool

# Function to count objects in the scene
def count_objects(image_path, object_labels):
    # Load the object_detector tool
    otd = Object_Detector_Tool()

    # Execute the tool with the image and object_labels
    output = otd.execute(image=image_path, labels=object_labels)

    # Get the total count of detected objects
    total_count = len(output)

    return total_count, output

# Example image path (replace with actual image path in system)
image_path = 'path/to/image.png'

# Specify object labels
object_labels = ['baseball', 'basket']

# Count the total number of objects and their labels
total_count, detected_objects = count_objects(image_path, object_labels)

print(f"Total number of objects: {total_count}")
print("Labelled objects and total count:")
for label, detections in detected_objects.items():
    print(f"{' '.join([label for _ in range(total_count)])}: {detections}")


