from Object_Detector_Tool import Object_Detector_Tool

# Parameters passed to the Object_Detector_Tool
parameters = {
  'image': '/path/to/image.png',  # The path to the image file
  'labels': ['chair'],  # A list of object labels to detect
  'threshold': 0.35,  # The confidence threshold for detection
  'model_size': 'tiny',  # The size of the model to use ('tiny' or 'base')
  'save_object': False,  # Whether to save the detected objects as images
  'saved_image_path': 'detected_objects'  # The path to save the detected object images
}

final_result = Object_Detector_Tool.execute(**parameters)

print("Number of chairs detected: ", final_result['object_number']['chair'])
print("Chairs detected in the image: ", final_result['detected_objects'])


