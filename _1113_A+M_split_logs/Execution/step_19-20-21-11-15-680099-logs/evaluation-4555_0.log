from object_detector import Object_Detector_Tool

def num_arm_chairs(image_path):
    try:
        # Load the image and detect objects
        objects = Object_Detector_Tool.execute(image=image_path, save_object=True, saved_image_path="obj_objects")

        # Count the number of armchairs
        arm_chairs = {"armchair" : 0}
        for label in objects['baseball']:
            if label["score"] > 0.4:
                x1, y1, x2, y2 = label["bbox"]
                x0, y0 = x1, y1
                x3, y3 = x2, y2
                arm_chairs[label["name"]] += 1

        return len(arm_chairs["armchair"])
    except Exception as e:
        print(f"Error occurred: {e}")
        return 0

def detect_objects_in_image(image, language="en"):
    try:
        # Load the image and detect text
        text_results = Text_Detector_Tool.execute(image=image, languages=[language])
        return text_results
    except Exception as e:
        return []

def main():
    image_path = "4555_0.png"
    num_arm_chairs(image_path)

    objects = Object_Detector_Tool.execute(image_path, save_object=True, saved_image_path="obj_objects")

    # Detect and count chairs
    chair_number = num_arm_chairs("armchair")

    print(f"Number of armchairs detected: {chair_number}")

if __name__ == "__main__":
    main()


