from object_detector import Object_Detector_Tool

# Parameters
save_object = True
saved_image_path = 'detected_objects'
threshold = 0.35 # default confidence threshold
model_size = 'base'

# Create an Object_Detector_Tool object
detector = Object_Detector_Tool(tool_version='1.0.0')

# Detect objects
detected_objects, object_number = detector.execute(image='path/to/image.png', labels=['baseball', 'basket'], save_object=save_object, threshold=threshold, model_size=model_size)
print(f"Total detected objects in the image: {detected_objects} with {object_number.keys()} labels."

for label, detection_results in detected_objects.items():
    print(f"{label}:")
    for result in detection_results:
        print(f"- {result['score'].round(2)}: [{result['bbox'][0]}, {result['bbox'][1]}, {result['bbox'][2]}, {result['bbox'][3]}]")


