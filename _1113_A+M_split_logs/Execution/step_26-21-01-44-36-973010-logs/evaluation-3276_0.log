from object_detector import Object_Detector_Tool

final_result = None

# Running the function with the provided image path
result = Object_Detector_Tool.execute(
    image='path/to/image.png',
    labels=['baseball', 'basket'],
    save_object=True,
    saved_image_path='detected_objects'
)

if result:
    detected_objects = result[0]
    object_number = result[1]

    # Print detected objects and object number
    print(f"No Paintings detected in the scene")
else:
    print("No Paintings detected in the scene")

# Assigning the final result to the final_result variable
final_result = {
    'paintings': final_result,
    'message': 'No Paintings detected in the scene'
}



