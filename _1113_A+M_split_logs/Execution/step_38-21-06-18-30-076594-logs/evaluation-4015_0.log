from object_detector import Object_Detector_Tool

# Sample paths to the image and labels for text detection
image_path = "/path/to/image.png"
labels = ["baseball", "basket"]

# Create a object_detector instance
detector = Object_Detector_Tool()

# Execute the text detection
result = detector.execute(image_path=image_path, labels=labels)

# Get the text result
text_results = result.output_types[1]
final_result = [output for output in text_results if output[1]]

print(final_result)


