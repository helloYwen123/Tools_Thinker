from object_detector import Object_Detector_Tool

def count_chairs():
    final_result = []
    image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13654_0.png"
    labels = ["chair"]
    threshold = 0.1
    model_size = "base"
    save_object = True

    detected_objects = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, model_size=model_size,
                                      threshold=threshold)
    chairs = set([d['bbox'] for d in detected_objects['chair']])

    for count, name in zip(detected_objects['object_number']['chair'].values(), chairs):
        if count > 0:
            final_result.append({
                "label": "{id} chair", 
                "confidence": "{:.2f}".format(count * threshold), 
                "image_path": detected_objects['image_id']
            })

    return final_result

count_chairs()


