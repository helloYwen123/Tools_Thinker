def detect_objects_and_count(image_path="path/to/image.png", language="en", threshold=0.35, save_object=True, saved_image_path="detected_objects"):
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=["baseball", "basket"], save_object=save_object, saved_image_path=saved_image_path, threshold=threshold)
    
    if not detected_objects:
        return {'count': 0, 'labels': []}
    
    labels = {label['box'][1]: int(label['box'][3]) for label in detected_objects['baseball'] + detected_objects['basket']}
    count = {label['box'][1]: 0 for label in detected_objects['baseball'] + detected_objects['basket']}
    
    for label in detected_objects['basket']:
        count[label['box'][1]] += 1
    
    for label in detected_objects['baseball']:
        count[label['box'][1]] += 1
        
