from object_detector import Object_Detector_Tool

# Initialize the Object_Detector_Tool with the given parameters
tool = Object_Detector_Tool(tool_mod_name="object_detector", tool_class_name="Object_Detector_Tool", tool_description="Detects objects in an image using the Grounding DINO model and saves individual object images with empty padding.", tool_version="1.0.0")

# Execute the tool with the given parameters
tools_result = tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/11184_0.png", labels=[], threshold=0.35, model_size="tiny", save_object=False, saved_image_path="detected_objects")

# Extract the results from the tool output
detected_objects = tools_result[0]
object_number = tools_result[1]

final_result = {
    "objects": [{"label": i[0], "count": 1, "detected_objects": i[1]} for i in detected_objects]
}

if detected_objects:
    final_result["detected_objects"] = tools_result[1]
else:
