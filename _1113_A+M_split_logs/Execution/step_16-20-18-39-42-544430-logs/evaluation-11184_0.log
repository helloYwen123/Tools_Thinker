from Object_Detector_Tool import Object_Detector_Tool
from Text_Detector_Tool import Text_Detector_Tool

def count_dressers(image_path):
    detected_objects = []
    
    # Detect dressers in the image
    tool = Object_Detector_Tool()
    result = tool.execute(image_path, label_list=['dressing_table'], save_object=True)
    
    if result[0]["box"][0][0] == None:
        return 0
    
    # Process the detected objects
    for box in result[0]["box"]:
        detected_objects.append({"label": "dressing_table", "score": result[0]["score"]})
    
    return len(detected_objects)

# Initialize parameters
save_path = "/user_data/dressed/11184_0_dressing_table.png"
dressing_table_image = "/user_data/sampled_images/11184_0_dressing_table_sample.png"

# Count and save dresser images
total_dressers = count_dressers(image_path=dressing_table_image)
if total_dressers > 0:
    with open(save_path, "w") as file:
        file.write("dressing_table" + "\n")
        for object in detected_objects:
            if object["label"] == "dressing_table":
                file.write("dressing_table: " + object["score"] + "\n")
            else:
                file.write("\n" + object["label"] + ": " + object["score"] + "\n")
    
finally:
    return total_dressers


