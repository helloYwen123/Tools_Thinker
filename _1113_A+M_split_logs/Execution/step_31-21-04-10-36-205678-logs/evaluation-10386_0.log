import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', labels=['Desks'], save_object=True, saved_image_path='detected_objects')

# Display the detected objects in the image
for idx, det in enumerate(final_result, 1):
    print(f"Object {idx}")
    for obj in det['baseball']:
        print(f"  {obj['box']} ({obj['score']})")
    for obj in det['basket']:
        print(f"  {[obj['box']} ({obj['score'])}]")

# Check if the detection was successful
if 'detected_objects' in final_result:
    objects = final_result['detected_objects']
    
    total_table = len(objects) - len(objects['baseball']) - len(objects['basket'])
    print(f"Total desks in the image: {total_table}")
else:
    print("Text detection failed.")


