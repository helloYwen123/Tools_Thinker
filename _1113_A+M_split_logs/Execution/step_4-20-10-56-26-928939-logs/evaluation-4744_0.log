def find_objects(image_path):
    detections = {"baseball": [], "basket": []}

    try:
        model_size = "tiny"
        save_object = True
        saved_image_path = "detected_objects"

        if model_size == "big":
            model_size = "base"
        else:
            model_size += "big"

        tool_result = []
        for label in detections:
            if label in model_size:
                tool_result = object_detector.execute(image=image_path.format(label=label), labels[label].split(), save_object=True, saved_image_path=save_image_path, threshold=0.35, model_size=model_size)
                break

        if len(tool_result) > 0:
            for item in tool_result:
                for label in item:
                    detections[label].append({"box": [item[label]["box"][0], item[label]["box"][1], item[label]["box"][2], item[label]["box"][3]], "score": item[label]["score"], "saved_image_path": item[label]["saved_image_path"].split()})

    except Exception as e:
        print(f"An error occurred while processing the image: {e}")
        return []

    return detections

