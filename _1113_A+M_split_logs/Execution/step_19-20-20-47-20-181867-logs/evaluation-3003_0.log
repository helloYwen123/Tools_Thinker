from object_detector import Object_Detector_Tool

# Set the input parameters
input_image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/3003_0.png"
labels = ["soap", "toilet"]
threshold = 0.35
model_size = "tiny"
save_object = False
saved_image_path = "detected_objects"

# Execute the object detection function
result = Object_Detector_Tool.execute(image=input_image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Extract objects and count
total_objects = [len(result[labels[0]["label"]])]

final_result = {
    "objects_found": result,
    "object_count": {labels[0]["label"]  : total_objects},
}

# Print the results
print("Detected Objects:")
for object_label in labels:
    print(f"{object_label}: {result[object_label]}")

print(f"Object count: {total_objects}")


