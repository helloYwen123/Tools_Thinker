from object_detector import Object_Detector_Tool
import_name: "Object_Detector_Tool"

def get_shelvingunits_count(image_path):
    detected_objects_result = Object_Detector_Tool.execute(image_path)
    object_count = {}
    for detected_result in detected_objects_result[0]:
        if "baseball" in detected_result[1]:
            total_baseball = detected_objects_result[1]["baseball"]
            object_count["baseball"] = total_baseball + object_count.get("baseball", 0)
        elif "basket" in detected_result[1]:
            total_basket = detected_objects_result[1]["basket"]
            object_count["basket"] = total_basket + object_count.get("basket", 0)
    return object_count

