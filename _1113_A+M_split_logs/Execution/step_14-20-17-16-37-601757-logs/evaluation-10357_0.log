import os
import numpy as np
from matplotlib import pyplot as plt
from object_detector import Object_Detector_Tool, Text_Detector_Tool

# Define the paths of the detected objects
detect_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/10357_0.png'

# Load the image
image_path = detect_path
image = plt.imread(detect_path)

# Create the dictionary to store the detected objects
objects_dict = {}

# Load the languages for text detection
lang_codes = ['en', 'de']

# Attempt to detect objects
result = Text_Detector_Tool.execute(image=image, languages=lang_codes)

# Get the first detected object
found = result[0:1][0][0]

# Check if text detection failed and retry
retry_count = 0
while not found:
    result = Text_Detector_Tool.execute(image=image, languages=lang_codes, retry_count=retry_count)
    found = result[0:1][0][0]
    retry_count += 1

# Process the found objects
if found:
    objects_list = found[0][0]
    objects_list.sort(key=lambda x: x[3])

    for obj in objects_list:
        if obj[4] > 0.35:  # Change threshold for object detection
            saved_object_path = os.path.join('detected_objects', obj[1].replace('_', ' '))  # Change file name
            image = image[obj[2]:obj[3], obj[4]:obj[5]]
            plt.figure()
            plt.imshow(image)
            plt.show()

            file_path = saved_object_path
            text = obj[1]
            if text not in objects_dict:
                objects_dict[text] = [len(obj) - 1]
            else:
                objects_dict[text].append(len(obj) - 1)

result = object_number = {}
for text, objects in objects_dict.items():
    result[text] = len(objects)
    object_number[text] = len(objects_dict)

print(result)
print(object_number)
