def count_side_tables(image_path):
    try:
        result = Text_Detector_Tool.execute(image=image_path, languages=['en'])
        detected_text_blocks = result[0]
        num_tables = 0
        for text_block in detected_text_blocks:
            if text_block[1].lower() == "side table":
                num_tables += 1
        return num_tables
    except Exception as e:
        print(f"Error occurred while counting side tables:\n{e}")
        return None

# Example usage
