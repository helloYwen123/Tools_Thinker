from object_detector import Object_Detector_Tool
from text_detector import Text_Detector_Tool

final_result = Object_Detector_Tool.execute(image='4680_0.png', labels=['chair', 'table'], save_object=True, saved_image_path='detected_objects')
object_detection_results = final_result[1]
detected_objects = [{'label': label['label'], 'bbox': label['bbox'], 'score': label['score'], 'saved_image_path': label['saved_image_path']} for label in object_detection_results]

detected_text_blocks = Text_Detector_Tool.execute(image=final_result[0], languages=['en'])[1]
text_blocks = []
for text_block in detected_text_blocks:
    if text_block[2] > 0.5:
        text_blocks.append({'bbox': text_block[0], 'text': text_block[1], 'confidence_score': text_block[2]})

final_result = {
  'objects_detected'  : detected_objects,
  'text_objects'    : text_blocks,
  'total_count'     : len(detected_objects),
  'total_text_count' : len(text_blocks)
}
print(final_result)


