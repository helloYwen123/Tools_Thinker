def count_beds(image_path, save_object=True, saved_image_path="detected_objects"):
    # Load the image and the detection models
    detection = Object_Detector_Tool(image_path)
    text_detection = Text_Detector_Tool(image_path)

    # Detect beds
    beds = detection.execute(image_path, ["bed"])

    # Count beds detected in the image
    bed_count = len(beds)

    # If save_object is True:
    if save_object:
        # Detect all images
        image_list = detection.images()

        # Save detected objects to a folder
        ImageIO.mimsave(saved_image_path, bed_list)

    return {"bed_count": bed_count}

# Call the function
result = count_beds(image_path="path/to/image.png")
print(result)


