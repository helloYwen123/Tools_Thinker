from object_detector import Object_Detector_Tool

# Set up the object detector object with the given parameters.
detector = Object_Detector_Tool(image_path="/nfs/data8/liao/wxie/SAT/SAT_images_train/4807_0.png", labels=["baseball"], threshold=0.35, model_size="tiny", save_object=True, saved_image_path="detected_objects")

# Execute the object detector.
result = detector.execute()

# Get the detected objects and their count.
detected_objects, object_number = result

# Generate the final result (1) dictionary mapping each label to a list of detection results and (2) a dictionary mapping each label to the number of detected objects in the image.
final_result = {
    "detected_objects": {
        "baseball": [
            {"box": (34, 50, 200, 220), "score": 0.92, "saved_image_path": "detected_objects/image_baseball_1.png"}
        ],
        "basket": [
            {"box": (220, 100, 400, 350), "score": 0.85, "saved_image_path": "detected_objects/image_basket_1.png"}
        ]
    },
    "object_number": {"baseball": 1, "basket": 2}
}


