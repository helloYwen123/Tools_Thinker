from object_detector import Object_Detector_Tool

object_number = {
  "baseball": 0,
  "basket": 0
}

final_result = Object_Detector_Tool.execute(image='path/to/desired_image.png', labels=['baseball', 'basket'], save_object=True, saved_image_path='detected_objects')
for object in final_result['object_number']:
  for result in final_result['detected_objects']:
    if result['name'] == object:
      object_number['baseball'] += 1
      object_number['basket'] += 2

final_result


