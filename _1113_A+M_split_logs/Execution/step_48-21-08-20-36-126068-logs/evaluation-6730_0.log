from object_detector import Object_Detector_Tool, Text_Detector_Tool

final_result = Object_Detector_Tool.execute(image='path/to/image.png', save_object=True, languages=['en', 'de'])
result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en'])

if final_result is not None and 'baseball' in final_result:
    count = {'baseball': 0 if 'basket' in result else 1}
elif final_result is not None and 'basket' in final_result:
    count = {'baseball': 0, 'basket': 1}
else:
    count = {'baseball': 0, 'basket': 0}

final_result = {'detected_objects': result, 'object_number': count}

print(final_result)


