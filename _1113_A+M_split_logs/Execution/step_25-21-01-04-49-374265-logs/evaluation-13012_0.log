            print(f'Object: {obj["label"]}, Box: [{obj["box"][0], obj["box"][1]}, {obj["box"][2], obj["box"][3]}], Color: {obj["board_color"]}, Score: {obj["score"]}, Image Path: {obj["saved_image_path"]}')
else:
