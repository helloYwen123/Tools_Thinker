from tools.object_detector import Object_Detector_Tool

image_path = "path/to/image.png"
labels = ["baseball", "basket"]
confidence_threshold = 0.35
model_size = "tiny"
save_object = True

result = Object_Detector_Tool.execute(image_path, labels, confidence_threshold, model_size, save_object, saved_image_path=image_path)
final_result = []

# Detect objects and calculate object number
if "baseball" in result[0]:
    object_number_baseball = len(result[0]["baseball"])

if "basket" in result[0]:
    object_number_basket = len(result[0]["basket"])

if "baseball" in labels:
    for det_result in result[0]:
        if det_result["box"] and det_result["box"][2] > 0:
            object_name = det_result["label"]
            box = det_result["box"]
            score = det_result["score"]
            object_detection_dict = {"object_name": object_name, "bbox": box, "score": score}

            if save_object:
                saved_image_path = f"detected_objects/image_{object_name}.png"
                Object_Detector_Tool.save_object(object_detection_dict, saved_image_path)

            final_result.append(object_detection_dict)

