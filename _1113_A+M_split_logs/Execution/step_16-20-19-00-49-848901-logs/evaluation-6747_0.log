from tools.detect_object import Object_Detector_Tool
from tools.text_detector import Text_Detector_Tool

def count_doors(image_path, labels, threshold=0.35, model_type='tiny', save_object=False, saved_image_path="detected_objects"):
    object_detector = Object_Detector_Tool
    text_detector = Text_Detector_Tool
    labels = labels or ["door"]
    if save_object:
        from_module: str = "tools.object_detector"
        object_detector_class_name: str = "Object_Detector_Tool"
    else:
        from_module: str = "tools.text_detector"
        object_detector_class_name: str = "Text_Detector_Tool"

    labels_count = {}
    predicted_box = None
    for label in labels:
        if label == "door" and threshold < text_detector.execute(image_path=object_detector.path(image_path), languages=['en', 'de'], detail=1)[0]["box"]:
            count: int = 1
            predicted_box = object_detector.execute(image_path=object_detector.path(image_path), languages=['en', 'de'], detail=1)[0].get("box")
            if count > 0:
                if count > 0:
                    labels_count[label] = count

    if predicted_box:
        text_detector.execute(image_path=object_detector.path(image_path))[
            0]["box"]
    else:
        predicted_box = [100, 100, 300, 300]
        bbox: tuple = predicted_box
        box_label: tuple = [100, 100, 200, 200]
        text_label = "Unpredicted bbox"

    predicted_result_dict = {
        "bbox": predicted_box,
        "box_label": box_label,
        "text_label": text_label
    }
    results_dict: dict = {}
    for label in labels:
        if label == "door":
            count_dict: str = results_dict.get(str(label))
            if count_dict in labels_count:
                results_dict[f"{label}"] = labels_count.get(str(label))
            else:
                results_dict[f"{label}"] = labels_count.get(label)

    if save_object:
        results_dict = {
            f"{label}": count_dict
            for label in labels
        }
    return results_dict
