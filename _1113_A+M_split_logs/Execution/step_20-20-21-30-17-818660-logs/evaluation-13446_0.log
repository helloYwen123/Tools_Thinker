from object_detector import Object_Detector_Tool, Text_Detector_Tool

def count_doors(image_path):
    """
    Counts the number of doorways visible in an image.
    """
    doorways = 0
    object_detector = Object_Detector_Tool(image_path, labels=['doorway'])
    detected_objects = object_detector.execute()
    
    for detected_object in detected_objects:
        if 'box' in detected_object[0]:
            xmin = int(detected_object[0]['box'][0])
            xmax = int(detected_object[0]['box'][2])
            ymin = int(detected_object[0]['box'][1])
            ymax = int(detected_object[0]['box'][3])
            if (xmin == xmax or xmax == 0) \
               and (xmin == ymax or ymax == 0) \
               and (ymin == ymax or ymin == 0) and (ymin == 0):
                doorways += 1

    return doorways

def detect_and_count_text(image_path, languages=['en', 'de']):
    """
    Detects text in an image using the Text_Detector_Tool tool.
    """
    text_detector = Text_Detector_Tool(image_path, languages=languages)
    text_output = text_detector.execute()
    
    text_result = []
    for text_object in text_output:
        for object in text_object:
            if 'bbox' in object:
                x = int(object['bbox'][0][0])
                y = int(object['bbox'][0][1])
                width = int(object['bbox'][2][0] - object['bbox'][0][0])
                height = int(object['bbox'][2][1] - object['bbox'][0][1])
                text_result.append([x, y, width, height, 'Detected text', object['score']])
                
    return text_result

def find_number_of_doors(image_path):
    doorways = count_doors(image_path)
    return doorways

detected_objects, object_number = Object_Detector_Tool.execute(image='path/to/image.png', save_object=True, saved_image_path='detected_objects')

# Check correctness with provided image_path
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/13446_0.png'
doors_count = find_number_of_doors(image_path)
final_result = detected_objects, object_number, doors_count


