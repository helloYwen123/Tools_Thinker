from object_detector import Object_Detector_Tool

# Assuming the path of the image file is provided
file_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/0.png"

# Initialize detection object with given configurations
detector = Object_Detector_Tool(image=file_path)

# Initialize variables for the counts of detected objects
baseball_detected = {}
basket_detected = {}

# Detect objects and store them as detected objects list and count list
for detected_objects in detector['detected_objects']:
    baseball_detected[detected_objects['label']] = detected_objects.get('bbox', None)
    basketball_detected[len(detected_objects) - 1] = detected_objects.get('bbox', None)

# Example of retrieving text blocks and their confidence scores
result = Text_Detector_Tool.execute(image='path/to/text_en_de.png',
                                 languages=['en', 'de'])

# Final result of count detected objects
final_result = [baseball_detected, basketball_detected]

print(final_result)


