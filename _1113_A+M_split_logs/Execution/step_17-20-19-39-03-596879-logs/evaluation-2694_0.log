import objects_detector_tool
import text_detector_tool

def calculate_objects_count(image_path):
    labels = ['baseball', 'basket']
    object_count = {}
    retry = 0
    while retry <= 3:
        try:
            result = objects_detector_tool.execute(image_path, labels=[f'baseball', 'basket'], threshold=0.35, save_object=False, saved_image_path="detected_objects")
            return result
            break
        except Exception as e:
            retry += 1
            pass
    return object_count

