# Set the input parameters
image_path = "/path/to/imge.jpg"  # Replace with the actual image path
labels = ['Baseball', 'Basket', 'Table', 'Chair', 'Desk', 'TV']
threshold = 0.35
model_size = 'tiny'
save_object = True

