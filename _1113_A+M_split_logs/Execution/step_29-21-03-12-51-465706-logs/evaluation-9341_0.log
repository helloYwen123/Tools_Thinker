from object_detector import Object_Detector_Tool

# Set up the image path
image_path = '/path/to/image.png'

# Specify object labels to detect
object_labels = ['baseball', 'basket']

# Set confidence threshold
confidence_threshold = 0.35

# Set model size
model_size = 'tiny'

# Set whether to save the detected objects
save_objects = True

# Run the object detector tool
detected_objects = Object_Detector_Tool.execute(image=image_path, labels=object_labels, confidence_threshold=confidence_threshold, model_size=model_size, save_objects=save_objects)

# Get the total number of detected objects
object_number = {obj_label: detected_objects.get(obj_label, {}).get('number') for obj_label in object_labels}

final_result = {
  'number_of_dressers': 0
}
final_result.update(detected_objects)

if detected_objects:
  for label, objects in detected_objects.items():
    final_result[label] = {label: {}}  # Initialize new dictionary for each detected label
    for obj in objects:
      box = obj.get('box')
      score = obj.get('score')
      final_result[label][box] = score

for label, info in final_result.items():
  final_result[label]['number_of_dressers'] = object_number.get(label, 0)
else:
  final_result['number_of_dressers'] = 0

print("Final result:", final_result)


============================== END ==============================

