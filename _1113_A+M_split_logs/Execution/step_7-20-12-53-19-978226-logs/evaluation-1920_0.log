from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/1920_0.png"

# List of interest objects to be detected
interest_objects = ['baseball', 'basket']

# Lower case for the first language
lower_language = "en"

detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=interest_objects, threshold=0.35, model_size='tiny', save_object=True, saved_image_path="detected_objects")

if detected_objects and object_number:
    # Filter results to only include English text
    relevant_objects = [(obj['box'], obj['score'], obj['saved_image_path']) for obj in detected_objects if obj['score'] > 0.95]

    if relevant_objects:
        final_result = []
        for obj in relevant_objects:
            item = {"box": obj[0],
                    "text": obj[1],
                    "confidence": obj[2]}
            final_result.append(item)

        print("Detected objects:")
        for obj in final_result:
            print(f"Box: {obj['box']}, Text: {obj['text']}, Confidence: {obj['confidence']}")

        print("Object numbers:")
        print(obj_number)
    else:
        print("No objects detected.")
else:
    print("Text detection failed after retries.")
