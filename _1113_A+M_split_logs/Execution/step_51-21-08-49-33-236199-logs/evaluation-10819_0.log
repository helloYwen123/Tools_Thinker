from tool object_detector import Object_Detector_Tool, save_object

class Room:
    def check_objects(self, image_path, labels, threshold=0.5, save_object=True, saved_image_path='detected_objects'):
        detected_objects = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, save_object=save_object, saved_image_path=saved_image_path)
        object_number = {}
        
        for label in detected_objects.keys():
            if label in labels:
                object_number[label] = len(detected_objects[label])
        
        return detected_objects, object_number


