from object_detector import Object_Detector_Tool

# Parameters
input_image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/14053_0.png'
object_labels = ['baseball', 'basket']
confidence_threshold = 0.35
model_size = 'tiny'
save_object = True
saved_image_path = 'detected_objects'

# Call the tool
result = Object_Detector_Tool.execute(input_image_path=input_image_path,
                                     labels=object_labels,
                                     confidence_threshold=confidence_threshold,
                                     model_size=model_size,
                                     save_object=save_object,
                                     saved_image_path=saved_image_path)

# Extract object results and object count
final_result = {'detected_objects': result, 'object_number': len(result['baseball']) + len(result['basket'])}
print(final_result)


