from object_detector import Object_Detector_Tool

# Initialize the object detector tool with required arguments
detector_tool = Object_Detector_Tool()

# Get the image file and labels
image_path = "path/to/image.png"
object_labels = ["baseball", "basket"]

# Calculate the confidence level for detection
confidence_threshold = 0.35

# Initialize the results dictionary
results = {}

# Detect the objects and create new entries in the results dictionary
for label in object_labels:
    detected_objects = detector_tool.execute(image=image_path, labels=[label], save_object=True, 
                                              threshold=confidence_threshold)
    results[label] = detected_objects

# Count the objects
total_objects = len(results.values())

final_result = {"objects_in_image": total_objects, "total_object_labels": object_labels, "detected_objects": results}

