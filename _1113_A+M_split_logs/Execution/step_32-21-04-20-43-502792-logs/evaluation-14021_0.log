from object_detector import Object_Detector_Tool

# Define the query
query = "How many Doorways are visible in the scene?"

# Find the image path and filename in the query for demonstration
image_path = f"/nfs/data8/liao/wxie/SAT/SAT_images_train/{query.split('.')[0]}_{query.split('.')[1]}_0.png"
image_file = "/nfs/data8/liao/wxie/SAT/SAT_images_train/" + f"{query.split('.')[0]}_{query.split('.')[1]}_0.png"

# Initialize the Object_Detector_Tool instance
detector = Object_Detector_Tool()

# Detect objects based on the image path and filename
result = detector.execute(image=image_file, labels=['Doorway'], threshold = 0.5, model_size="tiny")

# Extract objects and their counts
objects = result["detected_objects"]
object_counts = {label: len(objects) for label, objects in result.items()}

# Calculate the total number of objects
total_objects = sum(object_counts.values())

# Determine the number of Doorways based on object counts
num_doorways = [label for label, count in object_counts.items() if count == 1]["baseball"]

final_result = {"Doorways": num_doorways}


