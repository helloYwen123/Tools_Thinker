        box = block[1]
        text = block[3]
        score = block[5]  # Confidence score for text

        # Append to final_result list
        final_result.append([[box, text, score]])

    # Output for object detection
    object_number = len(detected_objects[0])
    final_result.append(["Number of objects detected: ", object_number])

except Exception as e:
    final_result.append(
        ["Error:", str(e)]
    )  



