from object_detector import Object_Detector_Tool

def count_windows(image_path, languages=['en'], detail=0):
    try:
        model_size = "tiny"
        detector = Object_Detector_Tool(image_path=image_path, languages=languages, model_size=model_size, detail=detail)
        for label in detector.labels:
            if label == "window":
                total_windows = detector.labels[label]["total"]
                for window in detector.labels[label]["windows"]:
                    x1 = window["bbox"]["x1"]
                    y1 = window["bbox"]["y1"]
                    x2 = window["bbox"]["x2"]
                    y2 = window["bbox"]["y2"]
                    print(f"Window detected: ({x1}, {y1}, {x2}, {y2})")
                    window_count = len(detector.labels[label]["windows"])
                    print(f"{label} detected in the image with {window_count} windows.")
                return True
    except Exception as e:
        print(f"Error: {e}")
        return False

image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/12518_0.png"
window_count = count_windows(image_path, languages=['en'])
print(f"Window detected: {window_count} windows")


