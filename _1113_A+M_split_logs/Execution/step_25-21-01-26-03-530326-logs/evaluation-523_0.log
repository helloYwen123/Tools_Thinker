from object_detector import Object_Detector_Tool

# Execute the tool to detect objects in the scene
result = Object_Detector_Tool.execute(image="/path/to/scene/image.png", labels=["baseball", "basket"], save_object=True)

detected_objects = result[0]
object_number = result[1]

# Print detected objects and their number
print("Detected Objects:")
for label, detection in detected_objects.items():
    print(f"  {label}: ({' '.join(map(str, detection['box'])), ' '}, {label}, {detection['score']})")
print(f"Object Number: {object_number}")
