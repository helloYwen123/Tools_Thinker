from object_detector import Object_Detector_Tool

# Parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/523_0.png"
labels = ["baseball", "basket"]
save_object = False
saved_image_path = "detected_objects"

# Call the tool to detect the objects
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

# Check object number
if len(object_number) == 2:
    print(f"There are 2 paintings visible in the scene.")
elif len(object_number) == 0:
    print(f"0 paintings are visible in the scene.")
else:
    print(f"The number of paintings visible in the scene is {sum(object_number.values())}.")
    for label in object_number:
        print(f"{label}: {sum(object_number[label].values())} painting(s)")


