from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/path/to/image.png"

# Language for text detection
languages = ["en", "de"]

# Detecting labels ('baseball', 'basket') with multi-language text detection
result = Object_Detector_Tool.execute(image=image_path, languages=languages)

# Print the detected objects
for item in result["detected_objects"]:
    print(f"({' '.join(item['name'].split('_'))} ('{'.join(map(str, item['x0'].split('_')[-3:]))})")

text_result = Text_Detector_Tool.execute(image=image_path, languages=languages, detail=1)

# Number of detected objects in each language
object_number = {language: len([box['bbox'] for label in text_result for box in label['result']]) for language, label in zip(languages, item['result'])}

final_result = {
    "number_of_labels": len(result["detected_objects"]),
    "number_of_languages": len(result["detected_objects"]),
    "number_of_objects_per_language": len(set(object_number.values()))
}


