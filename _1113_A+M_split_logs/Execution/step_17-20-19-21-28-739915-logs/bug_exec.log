from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold=0.35, use_save_output=False, save_path='detected_objects'):
    result = {
        'detected_objects': {},
        'object_number': {}
    }
    
    # Detect objects using Grounding DINO model
    det_model = 'tiny'
    if 'base' in labels:
        det_model = 'base'
    
    object_list = []
    for label in labels:
        output = Object_Detector_Tool.execute(image=image_path, labels=labels, model_size=det_model, save_object=use_save_output, saved_image_path=save_path)
        object_list.extend(output.get('detected_objects', []))
    
    # Count object number for each label
    for label in labels:
        if label in result['detected_objects']:
            result['object_number'][label] += 1
        else:
            result['object_number'][label] = 1
    
    # Check if object count exceeds threshold
    for label, count in result['object_number'].items():
        if count > threshold:
            return True
    
    return False

# Example usage
if __name__ == '__main__':
    detection_result = detect_objects('path/to/image.png', ['/basketball', '/basket'])
    print(detection_result)


