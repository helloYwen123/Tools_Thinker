from text_detector import Text_Detector_Tool

# Sample image path
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/8874_0.png'

# Detect text in the image
result = Text_Detector_Tool.execute(image=image_path)

# Convert the result to a dictionary of detected text blocks
detected_texts = result['result']




final_result = {
    "friogles": 2
}

if detected_texts:
    for detected_text in detected_texts:
        final_result["friogles"] += detected_text[1]
else:
    final_result["friogles"] = 0


print("Number of Fridge(s) found:", final_result["friogles"])


