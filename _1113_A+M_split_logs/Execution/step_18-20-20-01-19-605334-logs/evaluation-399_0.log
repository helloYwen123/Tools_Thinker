from Object_Detector_Tool import Object_Detector_Tool

# Load the scene image and set the confidence threshold
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/399_0.png"
detect_conf_threshold = 0.35
detect_size = "tiny"

# Detect the objects in the scene
final_result = Object_Detector_Tool.execute(image=image_path, labels=("baseball", "basket"), save_object=True, saved_image_path="detected_objects")

# Check if objects were detected
if final_result is not None:
    detected_objects = final_result[1]
    object_number = final_result[0]

    # Display the detected objects
    for detected_object in detected_objects:
        detected_object["score"] = max(detected_object["score"])  # Average scores
        detected_object["score"] = f"{round(detected_object['score'], 2)}"

# Print the result
print("Number of detected objects:", object_number)
print("Objects detected: [")
for detected_object in detected_objects:
    print(", ".join(f"({x}, {y}, {x1, y1}, {x1, y1})" for x, y, x1, y1 in detected_object["box"]), "]", "score =", detected_object["score"])
print("]") 


