from text_detector import Text_Detector_Tool

final_result = ""
num_of_stools = 0

image_path = "/path/to/image.png"
languages = ["English", "Deutsche"]

# Execute text detection
result = Text_Detector_Tool.execute(image=image_path, languages=languages)

# Process text boxes
for detected_box_list in result:
    for detected_box in detected_box_list:
        x0, y0, x1, y1, x2, y2 = detected_box
        if "basket" in detected_box or "basket" in detected_box_list[0].get("scores", []):
            num_of_stools += 1
            detected_box_list[0].update({"image_path": f"detected_objectsBasket_1.png", "count": 1})

# Print and display if applicable
if num_of_stools > 0:
    print(f"The room has {num_of_stools} stools visible.")
else:
    print(f"The room does not have any stools visible.")

# Display the number of detected objects
if final_result:
    print(f"Number of detected objects: {len(final_result)}")
else:
    print("No detected objects found.")


