import Object_Detector_Tool

def count_tv_stands(image_path):
    try:
        labels = ['baseball', 'basket']
        return Object_Detector_Tool.execute(image_path, labels=labels, save_object=False, image=None)    
    except Exception as e:
        return {"error": f"Error occurred: {str(e)}"}

def get_tv_stands(image_path):
    """
    Count the number of TV Stands visible in the scene.
    """
    tv_stand_image = "/nfs/data8/liao/wxie/SAT/SAT_images_train/9867_1.png"
    tv_stands_count = 0

    for i in range(2):
        tv_stand_image = f"{tv_stand_image}.png";

        tv_stands_count += count_tv_stands(f"/nfs/data8/liao/wxie/SAT/SAT_images_train/9867_{i+1}.png")[0]

    return tv_stands_count

tv_stands_result = get_tv_stands("/nfs/data8/liao/wxie/SAT/SAT_images_train/9867_1.png")

