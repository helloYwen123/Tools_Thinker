from object_detector import Object_Detector_Tool

final_result = ""
detected_objects = {}

# Example: Image with no text
image = 'example_image.png'
result = Object_Detector_Tool.execute(image, languages=['en'])[0] if 'en' in result else []
if result:
    detected_objects = {}
    for obj in result[1]:
        detected_objects[object["label"]] = [obj[3], obj["score"], obj["saved_image_path"]]
else:
    # Detect text fail, return empty object dictionary
    detected_objects = {}

print("Output: ", detected_objects)
print("Number of detected objects: ", len(detected_objects))
if saved_objects_directory:
    for label in detected_objects:
        saved_object_path = f"{saved_objects_directory}/detected_objects/{label}.png"
        saved_objects_directory = saved_objects_directory or os.path.expanduser("~/.local/share/gcog")
        os.makedirs(os.path.dirname(saved_object_path), exist_ok=True)
        saved_objects[
            f"{label}_image_{object_number[label]}_png"
        ] = {"bbox": f"{obj['bbox'][0]} {obj['bbox'][1]} {obj['bbox'][3]} {obj['bbox'][2]}", "score": obj["score"]} for label, object in detected_objects.items() if f"{label}_image" in glob.glob(f"{saved_objects_directory}/detected_objects/*")
finally:
    return final_result


