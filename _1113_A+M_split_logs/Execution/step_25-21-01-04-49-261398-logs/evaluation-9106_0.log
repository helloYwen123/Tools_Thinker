from object_detector import Object_Detector_Tool

# Create the Object_Detector_Tool tool instance
tool = Object_Detector_Tool()

# Paths of the images
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/9106_0.png'

# Execute the tool to detect text in the image
result = tool.execute(image=image_path, languages=['en', 'de'])

# Extract text blocks and calculate the count
text_blocks = result[0]
text_blocks_count = {}
for block in text_blocks:
    lang_index = block[2][0].split('-')[0]
    language = tool.get_name(language_index=lang_index)
    text = ''.join(block[3].split(' '))
    if lang_index in tool.lang_dict:
        text_blocks[lang_index].append((text, tool.confidences[lang_index]))

count_dict = {}
for languages, texts in text_blocks_count.items():
    count_dict[languages] = sum(1 for texts in texts.values())

# Replace text with its first occurrence in the count_dict for easier calculation
text_blocks = [[[text, score] for score in result[0][1] if score and score in count_dict] for text in result[0][2]]

# Display the results
final_result = {}
final_result['count_dict'] = count_dict
final_result['text_blocks'] = text_blocks

print(final_result)


