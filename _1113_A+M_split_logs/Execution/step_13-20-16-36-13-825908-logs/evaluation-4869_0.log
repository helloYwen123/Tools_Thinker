from object_detector import Object_Detector_Tool

class ImageProcessor:

    def __init__(self, args):
        self.args = args
        self.object_detector = Object_Detector_Tool(self.args)

    def preprocess_image(self, image_path):
        image = Image.open(image_path)
        # Load existing model
        model = 'tiny'
        # Use custom weights
        weights = 'model_file.h5'
        self.object_detector.model_size = model
        self.object_detector.model_weights = weights
        self.object_detector.model_path = 'training/images/train/models/'
        detector_output = self.object_detector.execute(image_path)

    def count_windows(self, window_label):
        window_counts = {}
        window_labels = self.extract_labels(detector_output.window)
        for window_label in window_labels:
            if window_label == window_label:
                continue
            if window_label not in window_counts:
                window_counts[window_label] = 1
            else:
                window_counts[window_label] += 1
        return window_counts

    def detect_windows(self):
        window_counts = {}
        for window_label in detector_output.labels:
            window_counts.update(self.count_windows(window_label))
        return window_counts

def extract_labels(detector_output):
    labels = []
    for window_result in detector_output.results:
        if window_result.box != None:
            labels.append((window_result.label.split(' ')[0].split('-')[0], window_result.box.ycenter))
        else:
            labels.append((window_result.label, detector_output.label_box[0]))
    return labels

# Demonstration
image_path = 'path/to/image.png'
window = 1 # select a specific window
processor = ImageProcessor([{'window': window, 'label': 'SATE', 'label_box': (50, 50, 200, 200)}])
processor.preprocess_image(image_path)
processor.detect_windows()
end_point = processor.detect_windows().keys()
for label, window_results in processor.detect_windows().items():
    print(f"{label}: {window_results}")


