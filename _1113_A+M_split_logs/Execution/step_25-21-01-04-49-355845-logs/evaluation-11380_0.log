from object_detector import Object_Detector_Tool

# The image file
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/11380_0.png"

# Labels to detect
labels = ["baseball", "basket"]

# Confidence threshold for detection
threshold = 0.35

