from object_detector import Object_Detector_Tool

def count_paintings(image_path, labels=["picture"], save_object=False, saved_image_path="detected_objects"):
    try:
        detected_objects = Object_Detector_Tool.execute(image_path=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)
        # Calculate the count of paintings
        painting_count = len([obj for obj in detected_objects["baseball"] + detected_objects["basket"]])
        return f"{'0' if not painting_count else painting_count}", len(labels)
    except Exception as e:
        return "0:", len(labels)

final_result = count_paintings("/path/to/bathroom_scene.jpeg", labels=["picture"])
print(final_result)

