from object_detector import Object_Detector_Tool

# Set the path to the image and detection labels
image_path = '/nfs/data8/liao/wxie/SAT/SAT_images_train/14844_0.png'
labels = ['baseball', 'basket']

# Initialize the object detector
tool = Object_Detector_Tool()

# Execute the detection
result = tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path='detected_objects')

# Print the detected objects and their number count
final_result = ""
for label, detection_list in result["detected_objects"].items():
    if not detection_list:
        final_result += f"No {label} detected.\n"
    else:
        detected_objects = []
        for detection in detection_list:
            detected_objects.append({
                "box": [detection["box"][0], detection["box"][1], detection["box"][2], detection["box"][3]],
                "score": detection["score"],
                "saved_image_path": detection["saved_image_path"].split('/')[-1].replace('.png', '')
            })
        final_result += f"{label}: {len(detected_objects)} detected objects.\n"

final_result += f"Object number count: {len(result['object_number'])}"

print(final_result)


