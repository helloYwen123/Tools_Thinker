from object_detector import Object_Detector_Tool

def calculate_number_of_doorways(image_path, languages=['en', 'de'], detail=0):
    try:
        # Load the image
        image = Image.open(image_path)
        
        # Detect the doors
        results = object_detection(image=image, languages=languages, detail=detail)
        
        # Count the doorways
        total_doorways = len([result[0] for result in results if result[1] == 'baseball'])
        
        return total_doorways
    except Exception as e:
        print(f"Error occurred while detecting doorways: {e}")
        return None

