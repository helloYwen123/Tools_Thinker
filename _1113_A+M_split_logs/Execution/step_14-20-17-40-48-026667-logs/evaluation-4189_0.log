from Object_Detector_Tool import Object_Detector_Tool
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/4189_0.png"

# Initialize the detection tool
tool = Object_Detector_Tool()

# Detect objects in the image
result = tool.execute(image=image_path, labels=[], languages=['eng', 'de'])

# Convert the result to a Python dict
result_dict = {"detected_objects": result}

# Extract object number
total_objects = {}
object_labels = [item for sublist in result_dict["detected_objects"] for item in sublist]
object_labels.sort()

for label in object_labels:
    object_num = total_objects.get(label, 0)
    total_objects[label] = object_num + 1
    result_dict["object_number"][label] = object_num + 1

final_result = {"label_number": result_dict, "object_number": total_objects}


