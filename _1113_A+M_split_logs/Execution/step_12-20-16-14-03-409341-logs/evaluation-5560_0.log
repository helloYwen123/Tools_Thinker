from object_detector import Object_Detector_Tool

# The image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/5560_0.png"

# Detect base-ball and bask in the image
detected_objects, object_details = Object_Detector_Tool.execute(image=image_path, labels=['baseball', 'basket'], save_object=True, saved_image_path="detected_objects")

# Calculate the number of detected objects
total_objects = len(detected_objects)

# Check if text detection is successful
if detected_objects:
    # Extract text information and calculate confidence scores
    for detected_object in detected_objects:
        detected_object.pop("saved_image_path")
        detected_object["score"] = detected_object["score"][0]
else:
    total_objects = 0

# Print the results
final_result = f"Number of detected objects: {total_objects}\nDetected objects:\n{detected_objects}"


