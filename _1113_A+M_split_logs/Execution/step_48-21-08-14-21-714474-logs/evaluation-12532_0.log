Code: 

from object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(
    image="/path/to/image.png",
    labels=["baseball", "basket"],
    save_object=True,
    saved_image_path="detected_objects"
)

print("Detected objects:")
for obj_label in final_result["object_number"]:
    objects = final_result["detected_objects"][obj_label]
    print(f"{obj_label}:")
    for obj_result in objects:
        print(f"  {obj_result} (score: {obj_result['score']} in image: {obj_result['saved_image_path']})"
)

print("\tNumber of objects detected per class: ")
for obj_label in final_result["object_number"]:
    print(f"{obj_label}: {final_result['object_number'][obj_label]}")


============================== END ==============================

