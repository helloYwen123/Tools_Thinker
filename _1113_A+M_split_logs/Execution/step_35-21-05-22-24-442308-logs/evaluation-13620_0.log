from tool.object_detector import Object_Detector_Tool

final_result = Object_Detector_Tool.execute(image="/nfs/data8/liao/wxie/SAT/SAT_images_train/13620_0.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

print(f"The total number of objects detected is {final_result['object_number']['basket']} and {final_result['object_number']['baseball']}.")

if not "baseball" in final_result:
    print("No baseball was detected.")
else:
    print(f"The baseball's bounding box is at x1={final_result['object_number']['baseball']['bbox'][0]}, y1={final_result['object_number']['baseball']['bbox'][1]}, x2={final_result['object_number']['baseball']['bbox'][2]}, y2={final_result['object_number']['baseball']['bbox'][3]}.")

if not "basket" in final_result:
    print("No basket was detected.")
else:
    print(f"The basket's bounding box is at x1={final_result['object_number']['basket']['bbox'][0]}, y1={final_result['object_number']['basket']['bbox'][1]}, x2={final_result['object_number']['basket']['bbox'][2]}, y2={final_result['object_number']['basket']['bbox'][3]}.")

print(final_result["detect_objects"], final_result["object_number"])


