from object_detector import Object_Detector_Tool

def count_objects(image_path='image.png'):
    try:
        object_results = Object_Detector_Tool.execute(image_path, ["basket", "baseball"], True)
        total_objects = len(object_results.keys())
        return {"total_objects": total_objects, "objects": object_results}
    except Exception as e:
        print(f"Error occurred: {e}")
        return {}

final_result = count_objects()

final_result.update({"count": 0})
if "total_objects" in final_result:
    final_result.update({"count": len(final_result["objects"])})

print(final_result)

