from object_detector import Object_Detector_Tool, saved_image_path

def find_floor_lamps(image_path, languages=['en', 'de']):
    try:
        result = Object_Detector_Tool.execute(image_path, languages=languages, detail=1)

        # Check if the first detected object is a Floor Lamp
        if 'FLOOR LAMP' in result:
            # If detected, count the number of floor lamps and return their bounding boxes
            object_count = len([obj for obj in result[0] if obj['label'] == 'FLOOR LAMP'])
            object_boxes = [[obj['box'], obj['score']] for obj in result[0] if obj['label'] == 'FLOOR LAMP']

            final_result = {
                'total_floor_lamps': object_count,
                'floor_lamps_boxes': object_boxes
