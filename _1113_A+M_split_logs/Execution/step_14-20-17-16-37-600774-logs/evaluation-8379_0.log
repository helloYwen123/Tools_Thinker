from object_detector import Object_Detector_Tool, Text_Detector_Tool

def count_paintings(image_path=None, language_code='en', detail=0):
    if language_code:
        languages = f"[{language_code}]"
    else:
        languages = ["en"] + ["de"] if 'en' not in languages else "English (Global), German (Global), Japanese (Global)"

    tool = Object_Detector_Tool() if isinstance(image_path, str) else Text_Detector_Tool()

if __name__ == "__main__":
    image_path = /nfs/data8/liao/wxie/SAT/SAT_images_train/8379_0.png
    language_code = "en"
    result = tool.execute(image=image_path, languages=languages, detail=detail)

    if result:
        detected_objects = result["detected_objects"]
        object_number = ", ".join(f"{dlabel}: {len(detected_objects)}" for dlabel, detected_objects in detected_objects.items())
        print(f"You detected {len(detected_objects)} '{', '".join(detected_objects.keys())}''s text in the image.")

        if language_code:
            for text_blocks in result["text_blocks"]:
                text = text_blocks[1]
                print(f"You detected '{text}' with a confidence score of {text_blocks[2]}")
        else:
            print("No detected text in the image.")
    else:
        print("No text detected in the image.")


