# Define function to execute object detector tool
def execute_tool(image_path, label_list, save_object=True, saved_image_path="detected_objects"):
    detected_objects = [""]
    object_number = {"baseball": 0, "basket": 0}
    for label in label_list:
        det = Object_Detector_Tool(image=image_path, labels=label_list, save_object=save_object, saved_image_path=saved_image_path)
        print(det)
        if label not in detected_objects:
            detected_objects.append(label)
        else:
            for det in detected_objects:
                if det['box'] == det['box'] and det['box'][label - 1][0] == detected_objects[-1]['box'][label - 1][0] and det['score'] == detected_objects[-1]['score']:
                    detected_objects[-1]['count'] += 1
    detected_objects = {"baseball": detected_objects, "basket": detected_objects}
    object_number = {"baseball": detected_objects["baseball"][0]["count"], "basket": detected_objects["basket"][0]["count"]}

    return detected_objects, object_number

# Execute tool with question text
