def count_chairs_on_table():
    # Import object_detection tool
    from object_detector import Object_Detector_Tool

    # Set up object detection parameters
    image_path = 'path_to_image.png'
    labels = ['chair']
    save_object = True
    saved_image_path = 'detected_objects'

    # Create instance of Object_Detector_Tool class
    od_tool = Object_Detector_Tool(image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

    # Detect chairs in the image
    result = od_tool.execute()
    
    # Extract chair coordinates and count the number of chairs in real world
    chair_count = 0
    chair_bbox = []
    for detection_results in result['detected_objects']:
        for d in detection_results:
            x1, y1, x2, y2 = d['bbox']
            chair_bbox.append([x1, y1, x2, y2])
        
    # Count the total number of chairs in the scene
    chair_count = len(chair_bbox)

    return chair_count

# Call count_chairs_on_table function and get the final result
chair_count = count_chairs_on_table()

print(f"The number of chairs visible in the scene is: {chair_count}")


