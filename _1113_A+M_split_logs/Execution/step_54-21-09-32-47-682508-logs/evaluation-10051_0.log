from ObjectsDetecktor_Tool import Object_Detector_Tool

# Create an Object_Detector_Tool instance
odt = Object_Detector_Tool()

# Specify the image to inspect
image_path = "/path/to/image.jpg"

# Set the confidence threshold
odt.conf_threshold = 0.35

# Set the model size
odt.model_size = "tiny"

# Set whether to save detected objects
save_objects = True

# Specify the location where the saved objects should be saved
saved_image_path = "/path/to/save/save/object/image/1.png"

# Execute the Text_Detector_Tool tool
result = odt.execute(image=image_path, labels=["baseball", "basket"], save_object=save_objects, saved_image_path=saved_image_path)

# Analyze the result
label_detection = result["detected_objects"]
number_of_objects = result["object_number"]

# Assign the final answer
final_result = {"label_detection": label_detection, "number_of_objects": number_of_objects}

final_result


