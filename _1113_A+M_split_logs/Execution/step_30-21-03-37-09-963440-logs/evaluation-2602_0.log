from object_detector import Object_Detector_Tool

# Define paths
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/2602_0.png"
labels = ['baseball', 'basket']
confidence_threshold = 0.35
model_size = 'tiny'

# Use the tool to detect objects
result = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path="detected_objects")

if result['object_number']['baseball'] == 1:
    baseball_count = result['object_number']['baseball']
    basket_count = result['object_number']['basket']
elif result['object_number']['baseball'] == 0:
    baseball_count = result['object_number']['baseball']
else:
    print("No detection for baseball or basket")
    baseball_count = 0
    basket_count = 0

final_result = {'baseball': [baseball_count], 'basket': [basket_count]}


============================== END ==============================

