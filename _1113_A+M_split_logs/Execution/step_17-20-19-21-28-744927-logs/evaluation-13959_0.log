from object_detector import Object_Detector_Tool

# Get the image path
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13959_0.png"

# Construct the tool object with the appropriate parameters
tool = Object_Detector_Tool(
    tool_module_name="object_detector",
    tool_class_name="Object_Detector_Tool",
    tool_description="A tool that detects objects in an image using the Grounding DINO model and saves individual object images with empty padding.",
    tool_version="1.0.0",
    tool_input_types={
        "image": "str - The path to the image file.",
        "labels": "list - A list of object labels to detect.",
        "threshold": "float - The confidence threshold for detection (default: 0.35).",
        "model_size": "str - The size of the model to use ('tiny' or 'base', default: 'tiny').",
        "save_object": "bool - Whether to save the detected objects as images (default: False).",
        "saved_image_path": "str - The path to save the detected object images (default: 'detected_objects')."
    },
    tool_output_types={
        "detected_objects": "tuple - A tuple containing two elements: (1) a dictionary mapping each detected label to a list of detection entries, e.g. {'baseball': [{'box': (x1, y1, x2, y2), 'score': 0.95, 'saved_image_path': 'path/to/saved/image.png'}]}, (2) a dictionary mapping each label to the number of detected objects in the image. e.g. {'baseball': 2, 'basket': 1}",
        "object_number": "str - A string mapping each label to the number of detected objects in the image. e.g. {'baseball': 2, 'basket': 2}"
    },
    tool_client_version="1.0.0"
)

# Execute the tool
result = tool.execute(image=image_path, labels=["baseball"], save_object=True, saved_image_path="detected_objects")

# Extract result data
detected_objects = result["detected_objects"]
object_number = result["object_number"]

final_result = f"Number of detected objects: {object_number}"


