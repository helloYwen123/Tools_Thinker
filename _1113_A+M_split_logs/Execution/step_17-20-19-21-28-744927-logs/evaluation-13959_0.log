from object_detector import Object_Detector_Tool

# Define input parameters
image_path = "/nfs/data8/liao/wxie/SAT/SAT_images_train/13959_0.png"
labels = ['baseball', 'basket']
confidence_threshold = 0.35
model_size = "tiny"
save_object = False

# Run the Object Detector Tool
detected_objects = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object)

object_number = {}
for label in detected_objects['objects']:
    object_number[label['object_name']] = len(detected_objects['objects'][label['object_name']])

# Final result
final_result = "There are " + str(detected_objects.pop()) + " DeskLamps visible in the scene."

# Return final result
final_result


