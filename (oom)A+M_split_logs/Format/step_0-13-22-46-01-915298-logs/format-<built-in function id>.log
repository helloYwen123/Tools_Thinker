# Using the Letter_Detector_Tool tool to detect letters in the image
result = Letter_Detector_Tool.execute(image='image_path')

final_result = {}
for image, results in result.items():
    detected_letters = []
    for bbox, letter, score in results:
        checked_letter = False
        for detected_letter in detected_letters:
            detected_letter_bbox = detected_letter[0]
            detected_letter_bbox_2 = detected_letter[1:]
            detected_letter_bbox_2 = (bbox[0], bbox[1] + detected_letter_bbox_2[2], bbox[0] + detected_letter_bbox_2[3], bbox[1] + detected_letter_bbox_2[4])
            if (bbox[0], bbox[1]) in detected_letter_bbox or bbox[0] + detected_letter_bbox_2[2] == detected_letter_bbox[0] and bbox[1] + detected_letter_bbox_2[4] == detected_letter_bbox[1]:
                checked_letter = True
                break
        if not checked_letter:
            detected_letters.append(((bbox[0], bbox[1]), bbox[2]-bbox[0], bbox[3]-bbox[1]))
    final_result[image] = {
        "bbox": detected_letters
    } if detected_letters else {
        "bbox": []
    }

# Print the final result
print(final_result)
