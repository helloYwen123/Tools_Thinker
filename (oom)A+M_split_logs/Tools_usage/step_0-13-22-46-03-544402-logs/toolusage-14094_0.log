# Import necessary tool classes
from object_detector import Object_Detector_Tool, Text_Detector_Tool
from letter_detector import Letter_Detector_Tool
# Execute the text detection with two language codes
result = Text_Detector_Tool.execute(image='path/to/image.png', languages=['en', 'de'])
results = result[0]
# Extract hats detected in the image, including coordinates and confidence score
for result in results:
  if result[2][1] < 0.95:
    bounding_box, text, score = result
    print(f'Detected hat at bounding box: [{bounding_box}], text: "{text}", score: {score:0.3f}')

# Execute the letter detection
result = Letter_Detector_Tool.execute(image='path/to/image.png')
detected_letters = result[0]

# Filter letters to be translated based on their recognized text and confidence score
for letter_detection in detected_letters:
  if 'a' in letter_detection[2]:
    # Assuming 'a' in these coordinates corresponds to 'A''
    translated_text = 'A '
  elif 'c' in letter_detection[2]:
    # Assuming 'c' in these coordinates corresponds to 'C''
    translated_text = 'C '
  else:
    continue
  print(f'Detected letter at coordinates: [{letter_detection[0].tolist()}], recognized text: "${translated_text}", confidence score: {letter_detection[2][1]:0.3f})')
