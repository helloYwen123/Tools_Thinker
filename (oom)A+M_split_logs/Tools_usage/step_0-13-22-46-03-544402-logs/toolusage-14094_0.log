text_out = []
lett_out = []

# Detect objects
obj_out["B"], obj_out["C"] = Object_Detector_Tool.execute(image="path_to_image.png", labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Detect fonts
tex_out = Text_Detector_Tool.execute(image="path_to_font", languages=["en", "de"], detail=2)

# Detect letters
lett_out = Letter_Detector_Tool.execute(image="path_to_image.png")

# Output results
obj_out, text_out, lett_out = [obj_out, tex_out, lett_out]

# Print results
commands = [
    f"detected_objects : {obj_out}, "
    f"object_number : {text_out}, "
    f"letter_count : {lett_out}"",
]
