'<command>\ndef count_people_white_uniform(image_path, model_name="tiny", padding=20):\n    detection_result = tool.execute(image=image_path, labels=["baseball", "basket"], threshold=0.35, model_size=model_name, padding=padding)\n    # Get all detected objects and their bounding boxes\n    detected_objects = [obj for obj in detection_result if obj["label"] in ["baseball", "basket"]]\n    \n    # Count total people wearing white uniform and check if any other person is wearing a white uniform\n    total_people = len(detected_objects)\n    white_uniformed_people = sum(1 for person in detected_objects if person["color"] == "white")\n    \n    return total_people, white_uniformed_people\n</command>'
