'<command>\nfrom object_detector_tool import object_detection\n\ndef count_people(eat_table):\n    # Load object model using default parameters\n    model = object_detection.Model("base")\n\n    for i in range(len(eat_table)):\n        for label in eat_table[i]["labels"]:\n\n            # Detect person with confidence > 0.3\n            for person in eat_table[i]["boxes"]:\n                if model.detect(person, 0.35)[0]["labels"] == label and model.detect(person, 0.5)[0]["confidence"] > 0.3:\n\n                    # Extract the coordinates of the person\n                    x1, y1, x2, y2 = model.detect(person, 0.5)[0]["bbox"]\n                    x1 = int(x1)\n                    y1 = int(y1)\n                    x2 = int(x2)\n                    y2 = int(y2)\n\n                    # Calculate the area of the person box\n                    area_person = (x1 - x2) * (y1 - y2)\n\n                    # Find persons that overlap with the eat table area\n                    for person in eat_table[i]["boxes"]:\n                        if person["bbox"] == (x1, y1, x2, y2):\n                            area_rectangle = (x1 - x2) * (y1 - y2)\n                            overlap = area_rectangle - area_person\n                            if overlap > 0:\n                                print(f"Person overlapping with Eat Table ({overlap} mm2)")\n                                break\n\n    return True\n\n# Test\neat_table = [\n    {"labels ([Baseball], [Basket])",\n     "boxes ([basket], [baseball])"}]\ncount_people(eat_table)\n</command>'
