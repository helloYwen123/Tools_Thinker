Code: from object_detector.tool import Object_Detector_Tool

# function to count the number of people wearing suit from the image
def count_people_with_suit(image_path, labels):
    with open(image_path, 'rb') as img:
        img = img.read()
        tool = Object_Detector_Tool()
        detection = tool.execute(image=img, labels=labels, threshold=0.35, model_size='tiny', padding=20)
        if detection is not None:
            num_people_with_suit = len([x for x in detection if x['label'] == 'suit'])
            return num_people_with_suit

