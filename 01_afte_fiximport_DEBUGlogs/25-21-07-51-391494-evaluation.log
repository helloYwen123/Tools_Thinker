def count_yellow_stars(image_path):
    """Detect yellow stars in an image using object detection."""
    detector = Object_Detector_Tool()
    results = detector.execute(image_path=image_path,
            labels=["yellow star"],
            threshold=0.15,
            model_size="base",
            padding=20)

    yellow_stars = [entry for entry in results if entry['label'] == "yellow star"]
    return len(yellow_stars)

def answer(image, stars):
    """Answer related to the number of yellow stars."""
