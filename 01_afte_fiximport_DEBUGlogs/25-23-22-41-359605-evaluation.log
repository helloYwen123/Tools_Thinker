Code: from object_detector.tool import Object_Detector_Tool

def count_bottles(image_path):
    '''Detect bottles in an image using a specified model and save empty padding around detected objects, return their paths.'''
    detector_tool = Object_Detector_Tool()
    detection_results = detector_tool.execute(image=image_path, labels=["bottle"], threshold=0.5, model_size="base", padding=20)  # set labels and threshold to detect "bottle", use base model with 20 empty padding
    
    all_bottles = []
    for result in detection_results:
        label, confidence, box, saved_image_path = result
        if label == "bottle":
            all_bottles.append({"label": label, "confidence": float(confidence), "box": box, "saved_image_path": saved_image_path})

    return all_bottles

def count_bottles_in_table(image_path):
    '''Detect bottles in a table of images and return the number of bottles.'''
    detection_results = count_bottles(image_path=image_path)
    count = len([s.get("label", None) for s in detection_results if s["label"].startswith("bottle")])
    
    return count

final_result = count_bottles_in_table("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_112_image_1.jpg")
