def how_many_people_wearing_glasses(image_path, labels=['face'], threshold=None, model_size='tiny', padding=20):
    """Detect faces in an image using the ground-based DINO model.
    
    Args:
        image_path: The path to the image file.
        labels: A list of labels to detect ('face', 'glasses').
        threshold: The confidence threshold for detection (default: 0.35).
        model_size: The size of the model to use ('tiny' or 'base', default: 'tiny').
        padding: The number of pixels to add as empty padding around detected objects (default: 20).
        
    Returns:
        A list of detected objects dictionaries with ('label';'confidence score';'box';'saved_image_path') keys and their corresponding values.
    """
    detector = Object_Detector_Tool()
    execution = detector.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    detections = execution.output_type[0]

    faces = [d for d in detections if d['label'] in labels]
    face_detections = [(f, d['confidence score']) for f, d in zip(faces, detections)]
    
    # Filter faces based on the confidence score
    face_detections = [d for d in face_detections if d[1] > threshold]
    
    return face_detections

