def count_wooden_beams(image_path, labels, threshold, model_size, padding):
    # Use the object_detector package to detect wooden beams in the image
    detection = Object_Detector_Tool.execute(image_path=image_path, labels=labels, threshold=threshold,
                                           model_size=model_size, padding=padding)

    # Count the number of wooden beams detected
    num_beams = len([obj for obj in detection if "base" in obj['labels']])

