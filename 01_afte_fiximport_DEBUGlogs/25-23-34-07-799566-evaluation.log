Code: def count_big_nuts(positive_answer):
    """
    Count the number of nuts larger than 1 cm in a given bowl.
    
    Parameters:
    positive_answer (str): The answer to the question in the format: "4 nuts larger than 1 cm".
    
    Returns:
    int: The number of nuts larger than 1 cm in the bowl.
    """
    # Check if the answer contains a specific format
    if "larger than 1 cm" in positive_answer.lower():
        # Split the answer into an array of strings where each element represents a nut
        nut_array = positive_answer.split(" larger than 1 cm ")
        total_nuts = len(nut_array)
        # Count the number of nuts larger than 1 cm
        count = sum(1 for nut in nut_array if nut > "cm")
        return count
    else:
        return 0

