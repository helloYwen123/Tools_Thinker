Code: from object_detector.tool import Object_Detector_Tool

def count_green_tiles(image):
    # Read the image
    detection = Object_Detector_Tool.execute(image=image)

    # Identify green tiles
    green_tiles = []
    for object in detection["output_type"]:
        if "label" in object and object["label"] == "green_tile":
            green_tiles.append(object)

    # Calculate number of green tiles
    green_tile_count = len(green_tiles)
    return green_tile_count

