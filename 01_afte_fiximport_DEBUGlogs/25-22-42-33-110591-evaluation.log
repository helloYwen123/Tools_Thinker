Code: from object_detector.tool import Object_Detector_Tool

def count_people_with_green_jacket(image_path, labels, threshold=0.35, model_size='tiny', padding=20):
    object_detector = Object_Detector_Tool()
    objects = object_detector.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    number_of_people = 0
    for obj_dict in objects:
        # Assuming the objects detected are people based on their names and bounding boxes
        if obj_dict.get('label', '') == 'person':
            number_of_people += 1
    return number_of_people

