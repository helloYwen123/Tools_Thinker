def count_bikes(folder_path):
    # Initialize object_detector
    detector = Object_Detector_Tool()

    # Define object labels & threshold
    object_labels = ["bikes"]
    threshold = 0.5

    # Set model size and detection box padding
    model_size = 'tiny'
    box_padding = 20

    # Load image
    loaded_image_path = folder_path
    # Use the object detector tool to detect objects in the image
    result = detector.execute(image=loaded_image_path, labels=object_labels, threshold=threshold, model_size=model_size, box_padding=box_padding)
    # Get bounding boxes for detected objects and count 'bikes'
    bike_bounding_boxes = result[2]
    num_bikes = len(bike_bounding_boxes)

    return num_bikes

