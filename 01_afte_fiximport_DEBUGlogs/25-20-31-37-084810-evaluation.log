def count_people(image_path, labels=['people'], threshold=0.35, model_size="tiny", padding=20):
    detection_tool = Object_Detector_Tool(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)
    detections = detection_tool.output_type
    people_count = 0
    for person in detections:
