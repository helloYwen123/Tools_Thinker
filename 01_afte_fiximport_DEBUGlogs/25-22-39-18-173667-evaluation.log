Code: from object_detector.tool import Object_Detector_Tool

def count_colored_tiles(image_path):
    # Load the image
    execution = Object_Detector_Tool.execute(image=image_path, labels=["tile"], threshold=0.35, model_size="tiny", padding=0)

    if execution:
        # Extract the bounding boxes corresponding to each tile
        boxes = [object['bbox'] for object in execution[0]]
        
        # Count the number of colored tiles
        colored_tiles = [tile['label'] == 'tile' for tile in boxes]
        colored_tiles_count = sum(colored_tiles)

        return colored_tiles_count
    else:
        return 0

