Code: from object_detector.tool import Object_Detector_Tool

def count_fingers():
    # Define the input file paths
    input_file_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_18_image_1.jpg"
    labels = ["basilike", "counting", "hiding", "tubeglass"]
    threshold = 0.35
    model_size = "base"
    padding = 20

    # Create the detection object
    detector = Object_Detector_Tool(input_file_path, labels, threshold, model_size, padding)

    # Detect basilike and tubeglass
    results = [[label, confidence_score, (x1, y1, x2, y2)] for label, confidence_score, (x1, y1, x2, y2) in detector.output]
    
    # Check for tubeglass and count fingers
    tubeglass_bbox = [result[2] for result in results if result[0] == "tubeglass"]
    if tubeglass_bbox:
        for bbox in tubeglass_bbox:
            width, height = bbox
            x1, y1, x2, y2 = bbox
            detected_finger = False
            # Check if the tubeglass is at the fingertips and calculate the number of fingers
            for finger in [x1 + width / 2, y1 + height / 2, x2 + width / 2, y2 + height / 2]:
                if finger != x1 + width / 2 and finger != y1 + height / 2 and finger != x2 + width / 2 and finger != y2 + height / 2:
                    detected_finger = True
            if detected_finger:
                finger_count = 1
            else:
                finger_count = 0
            # Return the count of fingers detected
            return finger_count

final_result = count_fingers()
print(final_result)
