def calculate_parking_meter_count(image_path):
    """
    Detect parking meters in an image and count them.
    """
    # Initialize the Image object with its path
    detection_tool = ObjectsDetectorTool(image_path, labels=["parking meter"], threshold=0, model_size="tiny")
    
    # Detect objects and get the paths of detected objects
    objects = detection_tool.execute()
    
    # Count parking meters in the detected objects
    parking_meter_count = len(set([obj["label"] for obj in objects if obj["label"] != "unrecorded"]))
    
    return parking_meter_count

