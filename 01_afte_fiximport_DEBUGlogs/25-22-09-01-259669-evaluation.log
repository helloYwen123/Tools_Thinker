def count_trains_stopped(image_path):
    """
    Detects trains in an image and counts how many trains are stopped.
    :param image_path: Path to the image file.
    :return: Number of trains stopped at the station.
    """
    # Create an object detection tool instance
    detection_tool = Object_Detect_tool(image_path=image_path, labels=["train"], threshold=0.35, model_size="tiny")

    # Detect trains and count them
    detections = detection_tool.execute()
    train_count = len([diction for diction in detections if diction['label'] == "train"])

    return train_count

