def count_facial_features(image: str) -> int:
    face_count = 0
    detection_results = Object_Detector_Tool.execute(image=image, labels=['face'], threshold=0.35, model_size='tiny', padding=20)
    for detection in detection_results:
        face_count += len(detection['bbox'])
    
    return face_count

