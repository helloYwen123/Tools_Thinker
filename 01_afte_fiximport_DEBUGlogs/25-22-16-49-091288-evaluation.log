Code: from object_detector.tool import Object_Detector_Tool

def count_person_with_cap(images_path):
    detector_tool = Object_Detector_Tool()
    bounding_boxes = []
    for image_path in images_path:
        execution = detector_tool.execute(image=image_path, labels=["person"], threshold=0.5, model_size="tiny", padding=20)
        labels, confidence_scores, boxes, _ = execution
        for lab in labels:
            temp_list = [lab[0], confidence_scores[labels.index(lab[0])], boxes[labels.index(lab[0])]]
            bounding_boxes.append(temp_list)
    count = 0
    for _ in bounding_boxes:
        if "cap" in _[2]:
            count += 1
    return count

