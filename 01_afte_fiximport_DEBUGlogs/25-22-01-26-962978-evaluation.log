def count_people_in_water(image_path, labels=['person'], threshold=0.5, model_size="tiny", padding=20):
    demo_command = "execution = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, padding=padding)"
    detection = next(object_detector.run(demo_command).output_type)
    number_of_people = 0
    for label in labels:
        for obj in detection:
            if obj["label"] == label and "person" in obj["label"]:
                if float(obj["confidence score"]) >= threshold:
