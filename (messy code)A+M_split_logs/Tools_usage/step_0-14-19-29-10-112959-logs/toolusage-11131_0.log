from object_detector import Object_Detector_Tool
from letter_detector import Letter_Detector_Tool
import_text_analysis = True  # 是否使用文字分析工具

def analyze_image(image_path):
    detected_objects = []
    if import_text_analysis:
        text_results = import_text_analysis.execute(image=image_path, languages=['en', 'de'])
        for text_result in text_results:
            detected_objects.append((image_path, text_result[1], text_result[2]))
    
    if import_letter_detection:
        letter_results = letter_detector.execute(image_path=image_path)
        for letter_result in letter_results:
            detected_objects.append((letter_result[1], letter_result[2]))
    
    return detected_objects

