def calculate_closer_window(windows, window_masks):
    count_windows_blue = 0
    count_windows_red = 0

    for window in windows:
        for window_mask in window_masks.values():
            if window_mask == "Window (highlighted by a blue box)" or window_mask == "Window (highlighted by a red box)":
                count_windows_blue += 1

    for window in windows:
        for window_mask in window_masks.values():
            if window_mask == "Window (highlighted by a blue box)" or window_mask == "Window (highlighted by a red box)":
                count_windows_red += 1

    if count_windows_blue == count_windows_red:
        final_result = "Window (highlighted by a blue box)"
    else:
        final_result = "Window (highlighted by a red box)"

    return final_result

