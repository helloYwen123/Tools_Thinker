Code: from object_detector import Object_Detector_Tool

final_result = 0

def count_unseen_people():
    # Load the image
    detector_tool = Object_Detector_Tool()
    input_dir = "path_to_image_directory"
    label_dict = {'baseball': 0, 'basket': 1}  # Convert labels to integers
    save_object = True
    saved_image_path = "detected_objects"

    # Detect objects
    image = detector_tool.get_object_image(input_dir, labels=['baseball', 'basket'], save_object=save_object, saved_image_path= saved_image_path)
    
    # Get the total count of the detected objects
    count = len(detector_tool.execute(image=image, labels=['baseball', 'basket'], save_object=save_object, saved_image_path= saved_image_path))

    # Calculate how many people aren't wearing a blue hat
    unblue_hats = len([person for person in detector_tool.execute_image(image, labels=['baseball'], save_object=save_object, saved_image_path= saved_image_path) if not person['label'] in label_dict]) - count

    return unblue_hats

final_result = count_unseen_people()
print("Number of people not wearing a blue hat:", final_result)

