    flower_pots_count = 0
    for i in result["total_count"]:
        num_result = result["boxes"][i]["num"]
        if num_result:
            flower_pots_count += num_result

    for i in flower_pots:
        if i in result["total_count"]:
            final_result.append({"name": i, "num_result": result["boxes"][i]["num"]})

    return final_result

