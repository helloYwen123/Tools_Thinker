class Image_Object_Detector_Tool:
    def __init__(self, image_path):
        self.detector = Object_Detector_Tool(image_path, labels=["Baseball"], save_object=True, saved_image_path="detect_object_results")

    def detect_objects(self):
        # Execute the detection tool
        detected_objects, object_number = self.detector.execute()
        # Extract object counts from the detected_objects dictionary
        object_count = {label: detected_objects[label].total_count for label in detected_objects}
        return object_count

