Code: from object_detector import Object_Detector_Tool

# Function to extract information about the image
def extract_image_info(image_path):
    # Call the object_detection function from the tool module
    object_detection_result = Object_Detector_Tool.execute(image=image_path, labels=["Bottle", "Glass"], save_object=True, saved_image_path="detected_objects")

    # Convert the result to a dictionary
    detection_result = object_detection_result[1]

    return detection_result, 0

# Function to calculate the total number of detections and empty detections
def calculate_detections(image_path, empty_detections):
    # Call the object_detection function from the tool module
    detection_result = Object_Detector_Tool.execute(image=image_path, labels=["Bottle", "Glass"], save_object=True, saved_image_path="detected_objects")

    # Convert the result to a list
    detection_result = detection_result[0]

    # Initialize a counter for empty detections
    empty_count = 0

    # Iterate through the detected objects
    for detection in detection_result:
        # Check if the object is empty
        if detection["boxes"] != []:
            # Increment the empty count
            empty_count += 1

    # Return the empty count
    return empty_count

