image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_103_image_1.jpg"

# Function to check if a person is wearing a yellow jacket
def is_wearing_yellow_jacket(person):
    if person['name'] == 'person' and person['color'] == 'yellow':
        return True
    return False

# Run the detection tool
tool = Object_Detector_Tool(
    image=image_path,
    labels=["person"],
    threshold=0.5,
    model_size="base",
    save_object=True,
    saved_image_path="result检测"
)

# Check detections
detections = tool.execute()

# Get the total number of detection for each label
total_detections = {det['name']: det['detections'][0]['total_count'] for det in detections}

# Filter detected objects by label
objects_to_check = filter(lambda x: x[0] == 'person' and x[1].get('name') == 'person' and x[1].get('color') == 'yellow', total_detections.keys())
person_counts = {det['name']: det['total_count'] for det in detections if det['name'] in objects_to_check}

# Determine if the number of detected yellow jackets fits the count
if sum(person_counts.values()) == 1:
    final_result = 1
else:
    final_result = 0

final_result

