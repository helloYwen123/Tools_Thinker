code:from object_detector_tool import Object_Detector_Tool

def detect_bird_in_image(bird_path):
    object_detector_tool = Object_Detector_Tool()

    try:
        output = object_detector_tool.execute(image=bird_path)
        
        # Check if bird detected
        if "baseball" in output[0]['classification']:
            bird_label = "baseball"
        elif "basket" in output[0]['classification']:
            bird_label = "basket"
        else:
            bird_label = "unknown"

        # Count birds
        bird_count = output[1][bird_label]['total_count']

        print(f"Bird found: {bird_label}")
        print(f"Estimated bird count in the image: {bird_count}")
        
        return bird_count
    except Exception as e:
        print(f"Error detecting bird in image: {e}")
        return 0

# Function to calculate the remaining birds in the image
