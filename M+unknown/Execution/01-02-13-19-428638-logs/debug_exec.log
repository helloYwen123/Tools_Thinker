code:from object_detector import Object_Detector_Tool

def count_objects(image_path, labels, threshold=0.45, model_size="tiny", save_object=False, saved_image_path="detected_objects"):
    detector = Object_Detector_Tool(
        input_types={"image": image_path, "labels": labels, "model_size": model_size}, threshold=threshold, save_object=save_object
    )
    detections = detector.execute()
    label_counts = detections.pop(False)

    return detections, label_counts

