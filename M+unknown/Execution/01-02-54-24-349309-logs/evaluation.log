Code: from object_detector import Object_Detector_Tool

# Function to count toilets
def count_toilets(image_path):
    # Load the image
    tool = Object_Detector_Tool(image_path)
    
    # Process the labels based on their type
    labels = ['basin', 'toilet'] if 'basin' in tool.labels else []
    
    # Initialize the toilet count
    toilet_count = 0
    for label in labels:
        toilet_count += len(tool.objects[label])
    
    return toilet_count

# Example usage
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_20_image_1.jpg"  # Replace this path with your image
final_result = count_toilets(image_path)
print(final_result)

