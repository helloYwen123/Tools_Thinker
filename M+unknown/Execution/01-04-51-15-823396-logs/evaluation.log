Code: from object_detector import Object_Detector_Tool

final_result = {}
for i, item in enumerate(self.buns):
	# Detect the item using the tool
	detected_buns = (detected_buns,
		np.array(detected_buns["boxes"]),
		detected_buns["confidence_scores"],
		detected_buns["saved_image_paths"]
	)
	num_buns = detected_buns["count"]

	# Count the number of buns based on their bounding box coordinates
	num_bun = len(detected_buns["boxes"])
	if num_buns >= 2:
		tall = item.get("height", 0)
		if tall >= 40:
			final_result[num_bun] = "tall"
		else:
			final_result[num_bun] = "short"
	else:
		final_result[num_bun] = "one_bun"

# Count the total buns
total_buns = len(self.buns)
if total_buns == 2:
	final_result["total"] = "two_buns"
else:
	final_result["total"] = "over_2_buns"

