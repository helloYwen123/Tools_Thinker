Code: from object_detector import Object_Detector_Tool

final_result = 0

# Load object detector tool
detector_tool = Object_Detector_Tool()

# Specify image path and model size
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_51_image_1.jpg"
model_size = "tiny"

# Execute tool
bbox_results, object_number = detector_tool.execute(image_path, labels=["hot_dog"], save_object=True, saved_image_path="detected_objects")

if bbox_results:
    for label, bbox_results_list in bbox_results.items():
        for box_list in bbox_results_list:
            for box in box_list:
                if label == "hot_dog":
                    final_result = bbox_results_list.count(box)
                    break
else:
    print("Failed to detect objects")

print(f"Different kinds of sandwiches: {bbox_results}")
print(f"Final result: {final_result}")

