def count_almonds(image_path, labels=None, save_object=False, saved_image_path="detected_objects", **kwargs):
    tool = Object_Detector_Tool()
    tool.load_labels()

    boxes, scores, image_paths = tool.execute(image_path, labels=labels, **kwargs)

    label_counts = {}
    for label in tool.labels:
        label_counts[label] = len(boxes['baseball']['boxes'] + boxes['basket']['boxes'])
    
    if save_object:
        for label, box_list in box_counts.items():
            if box_list:
                with open(saved_image_path + f"/{label}_boxes_{image_path.split('/')[-1]}_{label}_boxes_{image_path.split('/')[-1]}.jpg", 'wb') as file:
                    pickle.dump([box_info for box_info in box_list], file)

    return label_counts

