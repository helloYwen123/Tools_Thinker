Code: from object_detector import Object_Detector_Tool

# image_path is the path to the file containing the image.
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_6_image_1.jpg"

# object_labels is a list of target object labels.
object_labels = ["almonds"]

# threshold is the object detection confidence threshold. 
threshold = 0.45

# model_size is the size of the model to use ('tiny' or 'base').
model_size = "tiny"

# If save_object is True, this will save the detected objects as images.
save_object = True

# If saved_image_path is not None, this path will be used to save detected object images.
saved_image_path = None

# An empty dictionary to store the grouped detection results.
detected_objects = {}

# An empty dictionary to store the total counts for each detected label.
label_counts = {}

# Use the Object_Detector_Tool class and the labels list to detect objects in the image.
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=object_labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Print the total counts for each detected label.
for detected_label, total in detected_objects.items():
    total_labels = detected_objects[detected_label]["boxes"]
    detected_label_counts = {label for boxes in total_labels for label in boxes["label"]}
    print(detected_label, ":\t", len(detected_label_counts))
    if saved_image_path is None:
        detected_objects[detected_label]["boxes"].extend(total_labels["boxes"])
        for box in total_labels["boxes"]:
            box["image_path"] = saved_image_path

# Print the final result.
final_result = detected_objects[object_labels[0]]
print("Number of {}s in the green bowl:".format(object_labels[0]))
print(" {} {}\t{}\n".format(object_labels[0], label_counts[object_labels[0]], object_number))

