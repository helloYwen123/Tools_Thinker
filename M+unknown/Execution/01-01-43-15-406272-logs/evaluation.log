        if label == 'baseball':
            total_bicycles += 1
        elif label == 'pavement':
            total_scooters += 1
        elif label == 'person':
            total_other += 1

final_result = {'total_scooters': total_scooters, 'total_bicycles': total_bicycles, 'total_other': total_other}

