Code: from object_detector import Object_Detector_Tool

# Given image path
image_path = "path/to/image.png"

# List of labels to detect
labels = ["baseball", "basket"]

# confidence threshold
threshold = 0.45

# size of the model
model_size = "tiny"

# save object detection results
save_object = True
saved_image_path = "detected_objects"

# execute object detection
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

# Get total count for each label
label_counts = {label: len(detected_objects) for label in detected_objects}

# Generate a list of possible labels
possible_labels = list(label_counts.keys())

# The number of banners in the awning
num_banners = len(possible_labels)

final_result = num_banners

