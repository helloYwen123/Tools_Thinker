Code: import image


def count_glasses():
    """
    This function counts the number of people wearing glasses in the image.
    
    Returns:
    int: The count of glasses-wearing people.
    """
    # Load image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_109_image_1.jpg"  # Example path

    # Detect people
    people_list = []
    for label in ["baseball", "basket", "person"]:
        people_result = image.object_detector.execute(image_path, labels=[[label]], save_object=True, saved_image_path="detected_{}".format(label))
        people_list.append(people_result['output_types'][1])

    return len(people_list) - 1  # Subtract one because we counted the person wearing glasses

final_result = count_glasses()
print(f"The number of people wearing glasses is: {final_result}")

