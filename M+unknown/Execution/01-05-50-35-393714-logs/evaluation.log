Code: #!/usr/bin/env python3

import os
from object_detector import Object_Detector_Tool

def count_bears(image_path: str) -> dict:
    global final_result

    # Load the detector object
    detector_tool = Object_Detector_Tool()
    
    # Execute the detector object
    detected_result = detector_tool.execute(image_path=image_path)

    # Initialize dictionary to count bears
    bear_count = {}

    # Loop through detected bear results
    for label in detected_result['object_number']:
        # Count each bear
        bear_count[label['label']] += 1

    # Save the detected bears in an image
    saved_bears_path = f"{image_path}_bears_detected.jpg"
    detected_result['detected_objects'].save(detected_result['detected_objects_path'], image_name=saved_bears_path)

    # Add the count of bears to the final result
    final_result = {'count': len(detector_tool.execute(image_path=image_path)['detected_object']) + saved_bears_path: bear_count}
    return final_result

# Test the function
final_result = count_bears(image_path="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_88_image_1.jpg")
print(final_result)

