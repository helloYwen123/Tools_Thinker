def count_people_with_hat(image_path):
    # Load the image
    image = object_detector.Tool.execute(image=image_path, save_object=False)

    # Initialize a dictionary to store the count of people with each hat
    person_count_with_hat = {}

    # Iterate through all detected object groups
    for label, detection_results in image['output_dict'].items():
        label_count = len(detection_results['labels'])
        hat_count = len([cap for cap in detection_results['caps'] if cap['category'] == 'hat'])

        # Check if the hat is being worn
        if hat_count > 0:
            # Check if the person has already encountered a match
            if label not in person_count_with_hat:
                person_count_with_hat[label] = {'boxes': [], 'confidence_scores': []}
            
            #Append the bounding box of the person to the matching list
            person_count_with_hat[label]['boxes'].append([*cap['box_list'][0]])

            # Compute the confidence score for the detected person
            if detection_results['boxes']:
                # Detect the person by finding objects within bounding boxes
                candidate_objects = [obj_dict['object_center'] for obj_dict in detection_results['boxes']]
                detection_scores = [obj_dict.get('confidence_score', obj_dict.get('category confidence', 1.0)) for obj_dict in candidate_objects]
                detection_scores = [score for score, _ in zip(detection_scores, candidate_objects)]
                person_count_with_hat[label]['confidence_scores'].append(min(detection_scores))
            
            # Check if the person has already encountered a match
            if hat_count > 2:
                for box, score in zip(person_count_with_hat[label]['boxes'], person_count_with_hat[label]['confidence_scores']):
                    # Check for the presence of the same object again
                    if box[1] == box[3] and score > 0.5:
                        person_count_with_hat[label]['confidence_scores'].pop(person_count_with_hat[label]['boxes'].index(box))
                        break

    return person_count_with_hat

