Code: from object_detector import Object_Detector_Tool

# Define the question
question = "How many people are washing hand?"

# Read the image paths
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_93_image_1.jpg'
labels = ['baseball']
threshold = 0.45
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Create the Object_Detector_Tool object
detect_tool = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Process the image
detections, _ = detect_tool.execute()
counter = {det["label"]: int(det["count"]) for det in detections if det["label"] in labels}

# Find the label with the counter of 1
count_one = max(counter, key=counter.get)
final_result = count_one if count_one in labels else (len(labels) - 1)

print(f"The person washing hand is identified by `{final_result}`.")

