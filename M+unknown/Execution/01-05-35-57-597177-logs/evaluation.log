class Image:
    def __init__(self, path):
        super().__init__()
        self.detected_objects = self.execute_image(path, labels=["hand"], save_object=True, saved_image_path="detected_objects", threshold=0.45)

    def execute_image(self, path, labels=[], save_object=False, threshold=0.45, model_size="tiny", saved_image_path="detected_objects"):

        detection_tool = Object_Detector_Tool()
        detections = detection_tool.execute(path, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)
        
        image = Image(path=path)
        image.total_object_count = len(detections)
        image.detection_count = sum([det["bbox"] for det in detections if "bbox" in det])
