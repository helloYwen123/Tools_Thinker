# Function to detect and count objects in an image
def detect_and_count_objects(image_path, labels, save_object=False, saved_image_path="detected_objects", threshold=0.45, model_size="tiny"):
    # Use the Object_Detector_Tool tool to detect objects in the image
    detected_objects = Object_Detector_Tool.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    
    # Initialize a dictionary to hold the object counts
    object_counts = {}
    
    # Loop through detected objects and count their number
    for label in detected_objects[1]:
        if label["boxes"]:
            count = len(label["boxes"]["total_scores"])
            object_counts[label["name"]] = count
        else:
            object_counts[label["name"]] = 0
    
    # Return the final result
    return object_counts

