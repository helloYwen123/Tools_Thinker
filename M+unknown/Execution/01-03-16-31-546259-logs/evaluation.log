detector_tool = Object_Detector_Tool(image_path=image_path, labels=labels, save_object=True, saved_image_path="detected_objects", model_size="tiny")
detected_objects, object_number = detector_tool.execute()

# Check if the detected objects are successful
if "success" in detected_objects:
    # For the first labeled object
    object_label = detected_objects["label1"].keys()
    object_count = detected_objects["count1"].keys()
    first_detected_object = detected_objects["detected_objects1"]

    for label in labels:
        if first_detected_object[label].keys():
            # Get the count for the current label
            current_count = detected_objects["count1"][label].keys()

            # Update the final result dictionary
            final_result[label] = {
                "count": current_count
            }
        else:
            # Label was not detected
            final_result[label] = {
                "count": current_count
            }

print("Detected baseballs and baskets in image:", [label for label, count in final_result.items()])

