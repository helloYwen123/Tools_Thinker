code:def count_buses(image_path):
    """This function counts buses in an image.

    Args:
        image_path: str - The file path to the image.

    Returns:
        bus_count: int - The count of buses.
    """
    from object_detector import Object_Detector_Tool

    # Load the image
    object_detector_tool = Object_Detector_Tool()

    # Define the image path and object labels
    image_path = image_path
    labels = ["bus"]  # Replace with other labels, if needed

    # Set the confidence threshold and model size
    thresholds = 0.45
    model_size = "tiny"

    # Execute the object detection tool
    detected_objects, bus_count = object_detector_tool.execute(image=image_path, labels=labels, threshold=thresholds, model_size=model_size, save_object=True, saved_image_path="detected_objects")

    # Return the bus count
    return bus_count

