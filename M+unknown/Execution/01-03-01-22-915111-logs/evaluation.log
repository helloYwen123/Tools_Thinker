Code: from object_detector import Object_Detector_Tool

class ImageDetector:
    def __init__(self, image_path):
        self.image_path = image_path

    def detect(self):
        with open(self.image_path, 'r') as image_file:
            image_data = image_file.read()
        
        tool = Object_Detector_Tool(image=image_data, labels=["soap", "shampoo", "washing-bat"], threshold=0.5, model_size="tiny")
        labels_count = tool.execute()
        
        final_result = {"count": labels_count}
        return final_result

image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_5_image_1.jpg"
