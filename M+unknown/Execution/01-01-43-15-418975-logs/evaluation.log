Code: from object_detector import Object_Detector_Tool

# Define the command as a function to execute the tool after providing all required inputs
def get_number_of_common_objects(image_path, labels, threshold=0.45, model_size='tiny', save_object=True, saved_image_path="detected_objects"): 

    # Load the model and get object bounding boxes and scores
    detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size, threshold=threshold)
    
    # Initialize an empty dictionary to hold the counts
    object_counts = {}
    
    # Loop through the detected objects and count the occurrences
    for label, bounding_box, confidence_score in detected_objects['detected_objects']:
        if label in object_counts:
            object_counts[label] += 1
        else:
            object_count = 1
            object_counts[label] = object_count
    
    # Ensure the object count is a float and appropriate for counting purposes
    object_counts = {k: float(v) for k, v in object_counts.items()}
    
    print("Detected common objects:")
    for label, count in object_counts.items():
        print(f"{label}: {count}")

