Code: from object_detector import Object_Detector_Tool

def count_toilets(image_path):
    # Load the image
    object_detector = Object_Detector_Tool(image=image_path)
    detected_objects, _ = object_detector.execute()
    
    # Count the number of toilets
    toilet_count = sum(1 for obj_details in detected_objects["objects"] if obj_details["label"] == "toilet")
    
    return toilet_count

