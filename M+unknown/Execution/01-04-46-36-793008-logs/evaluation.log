Code: from object_detector import Object_Detector_Tool

# Function to get the number of burners from the image
def get_burner_count_from_image(image_path):
    # Load the image
    object_detector_tool = Object_Detector_Tool(image_path, labels=["Burner"], threshold=0.45, model_size="tiny", save_object=True)
    final_result = object_detector_tool.execute()
    return final_result[1] - 1  # Subtract 1 because the top burner is not counted

