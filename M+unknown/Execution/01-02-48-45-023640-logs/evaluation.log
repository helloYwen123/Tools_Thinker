Code: from object_detector import Object_Detector_Tool

def count_sinking_boats():
    # Load the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_96_image_1.jpg"
    
    # Detect objects
    labels = ["sinking boat"]
    tool = Object_Detector_Tool(image_path, labels, threshold=0.45, model_size="base", save_object=True, saved_image_path="detected_objects")
    detected_objects = tool.execute()
    
    # Calculate counts
    object_count = {}
    for result in detected_objects["object_number"]:
        label = result["label"]
        count = result["count"]
        if label in object_count:
            object_count[label] += count
        else:
            object_count[label] = count
    
    # Find the most common label
    most_common_label = max(object_count, key=object_count.get)
    
    # Answer the question
    final_result = most_common_label if most_common_label not in ["base", "sinking boat"] else len(object_count)
    
    return final_result

# Call the function
result = count_sinking_boats()
print(result)

