from object_detector import Object_Detector_Tool

def count_skiers_with_color(ski_image_path):
    with open(ski_image_path, "rb") as image_file:
        image = image_file.read()

    tool_instance = Object_Detector_Tool(image=image, labels=["red"])
    tool_result = tool_instance.execute()

    return tool_result

def count_skiers_with_color(ski_image_path):
    import cv2

    image = cv2.imread(ski_image_path)

    tool_instance = Object_Detector_Tool(image=image, labels=["red"])
    tool_result = tool_instance.execute()

    count_dict = {}
    for label in tool_result['object_number']:
        if label in ["baseball", "basket", "skis"]:
            count = tool_result['object_number'][label]
        else:
            count = tool_result['object_number'][label]

        count_dict[label] = count

    ski_ski_count = count_dict["skis"]
    return ski_ski_count
