Code: from object_detector import Object_Detector_Tool

# Get label count for yellow stars
def get_label_count(label, image_path):
    detector_tool = Object_Detector_Tool()
    categories = ["yellow_star"]
    results = detector_tool.execute(labels=categories, labels_path=image_path, save_object=True, threshold=0.45, model_size="base")
    yellow_stars = [result for result in results if label in result["label"]]
    object_count = len(yellow_stars)
    return object_count - 1  # Subtract 1 because counting from 0

# Example usage
final_result = get_label_count("yellow_star", "/path/to/image.png")
print("Number of yellow stars:", final_result)

