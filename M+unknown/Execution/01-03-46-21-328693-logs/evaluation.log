def calculate_yellow_stars_count(image_path):
    # Read the image
    image = Object_Detector_Tool.image_reader(image_path)
    
    # Detect the objects in the image
    results = Object_Detector_Tool.detect_objects(image, labels=["yellow_star"])
    
    # Count the yellow stars in the image
    if results and "yellow_star" in results[0]:
        yellow_star_count = results[0]["yellow_star"]['boxes'][0][4]
    else:
        yellow_star_count = 0
    
    return yellow_star_count

