Code: from object_detector import Object_Detector_Tool

def count_yellow_stars(image_path):
    # Create an instance of the Object_Detector_Tool class
    object_detcator_tool = Object_Detector_Tool()

    # Execute the tool with the input parameters
    results = object_detcator_tool.execute(image_path=image_path, labels=["yellow-star"], threshold=0.45, model_size="tiny", save_object=True)

    # Extract the number of detected yellow stars
    num_yellow_stars = len(results[0]["boxes"])

    return num_yellow_stars

# Example usage
