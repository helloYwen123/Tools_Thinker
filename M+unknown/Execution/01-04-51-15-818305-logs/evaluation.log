def get_number_of_white Fridges(imagepath, detection_labels=["refrigerator"]):
    object_detector_tool = Object_Detector_Tool()
    total_objects = object_detector_tool.execute(imagepath=imagepath, labels=detection_labels, save_object=True)
    refrigerator_objects = total_objects.get("refrigerator")
    if refrigerator_objects is not None:
        total_objects.update(get_objects_objects_object(refrigerator_objects))
        refrigerator_objects = total_objects.get('refrigerator')
    return total_objects.get("count")

def get_objects_objects_object(objects_objects):
    total_objects = []
    for label, count_dict in objects_objects.items():
        label_objects = objects_objects[label]
        label_objects = {k: v for k, v in label_objects.items()}
        total_objects.extend(label_objects)
    return total_objects

final_result = get_number_of_white Fridges("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_100_image_1.jpg")
