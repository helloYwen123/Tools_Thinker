Code: from object_detector import Object_Detector_Tool


def count_people_without_hats():
    tool = Object_Detector_Tool()
    
    # Step 1: Load the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_95_image_1.jpg"
    if not object_detection(tool, image_path, 'baseball', threshold=0.6):
        print("Baseball could not be detected in the image.")
        return
    
    # Step 2: Detect people without hats
    people_without_hats_detected = None
    if not object_detection(tool, image_path, 'hat', threshold=0.6):
        print("People without hats could not be detected in the image.")
        people_without_hats_detected = 0
    else:
        print("People without hats were detected in the image.")
        people_without_hats_detected = len(tool.object_count_list['baseball']['boxes'])
        
    # Step 3: Count the people without hats
    if people_without_hats_detected > 0:
        print(f"Number of people without hats: {people_without_hats_detected}")
    else:
        print("No persons without hats were detected in the image.")
    
    # Step 4: Check if the number of people without hats is greater than 0
    if people_without_hats_detected > 0:
        return people_without_hats_detected
    else:
        return 0

