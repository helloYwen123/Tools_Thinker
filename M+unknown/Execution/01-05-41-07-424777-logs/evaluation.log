Code: from object_detector import Object_Detector_Tool

final_result = 0
labels = ["baseball", "basket"]

def count_empty_blue_seats(image_path):
    detector_tool = Object_Detector_Tool()
    detected_objects = detector_tool.execute(image=image_path, labels=labels, save_object=True, saved_image_path="detected_objects")
    empty_blue_seats = 0
    for label, detections in detected_objects.items():
        if label == "basket":
            empty_blue_seats += 1
    return empty_blue_seats

# Example usage
