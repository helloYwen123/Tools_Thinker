Code: from object_detector import Object_Detector_Tool
import os
import numpy as np

# Randomly generate a path to an image with multiple motorcycles
random_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_{}.jpg"

# Find all the filenames compatible with the object detector tool
file_paths = [f for f in os.listdir('.') if self.object_detector_tool.is_valid_file(f)]

# Extract the filenames with 'motorcycle_'
filenames = [f for f in file_paths if 'motorcycle_' in f]

# Find the indices of filenames that match the pattern
matching_indices = np.where(np.array(filenames) == "*.jpg *_motorcycle.*")

# Load the image file at each index
images = [self.object_detector_tool.get_image_or_file(index)[1] for index in matching_indices[0]]

# Detect all objects in the image
objects = self.object_detector_tool.detect_objects(image=images, labels=["motorcycle"])

# Calculate the total count of detected objects
total_objects_count = sum([count['total_labels'] for _, count in objects])
total_objects_count

