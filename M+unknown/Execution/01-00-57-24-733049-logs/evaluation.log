Code: from object_detector import Object_Detector_Tool

# Step 1: Define the image path and check whether the image is present
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_94_image_1.jpg"
if not Object_Detector_Tool.image_file_exists(image_path):
    print("Error: Image not found.")
    exit()

# Step 2: Set the options parameters for the tool
option_dict = {
    'label_keys': ['baseball'],  # Labels to detect
    'save_object': True,  # Save detected objects
    'saved_image_path': 'detected_objects',  # Saved image path
    'threshold': 0.45,  # Confidence threshold for detection
    'model_size': 'tiny',  # Model size
}

# Step 3: Execute the tool and get the results
result = Object_Detector_Tool.execute(image_path, labels=option_dict['label_keys'], threshold=option_dict['threshold'], model_size=option_dict['model_size'], save_object=option_dict['save_object'], saved_image_path=option_dict['saved_image_path'])

# Step 4: Analyze the results
if len(result) == 2:
    found_objects = result[0]
    print(f"Found {len(found_objects)} objects in the image.")
else:
    print("Error: Failed to find detected objects")
    exit()

