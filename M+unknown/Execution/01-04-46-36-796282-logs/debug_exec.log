from object_detector import Object_Detector_Tool

def answer_question(image_path):
    tool_params = {
        'image': image_path,
        'labels': ["counting_tile"],
        'threshold': 0.5,
        'model_size': 'tiny',
        'save_object': True,
        'saved_image_path': 'counting_tile_detected_objects',
    }
    
    detector_tool = Object_Detector_Tool(**tool_params)
    detected_objects, object_number = detector_tool.execute()
    
    final_result = {}
    for label in detected_objects:
        if label in ["counting_tile"]:
            final_result[label] = detected_objects[label]
    
    return final_result
