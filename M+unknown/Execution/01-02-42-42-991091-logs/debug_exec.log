def count_black_letters(image_path):
    tool_class_name = "Object_Detector_Tool"
    labels = ["black_letter"]

    # Load the image file
    object_detector_tool = Object_Detector_Tool(image_path)
    detections_image = object_detector_tool.load_image()

    # Detect black letters and count them in the image
    results = object_detector_tool.execute(labels=labels, detections_image=detections_image, threshold=0.45, model_size="tiny")
    count_result = {"black_letter": 0}
    for result in results:
        count_result["black_letter"] = count_result["black_letter"] + result["boxes"][0]["score"]
    final_result = count_result
    return final_result

