def calculate_letter_count(image_path):
    detector = Object_Detector_Tool()
    result = detector.execute(image_path, labels=["letters"], save_object=True)
    detector_name = "letters"
    image_count = result[0]
    if "boxes" in image_count:
        letters = image_count["boxes"]
        letter_count = {k: image_count["boxes"].count(v) for k, v in letters.items()}
        letter_count_str = ", ".join([f"{k}: {v}" for k, v in letter_count.items()])
        print(f"Letters detected: {letter_count_str}")
    else:
        print("No boxes detected!")
    return letter_count_str

