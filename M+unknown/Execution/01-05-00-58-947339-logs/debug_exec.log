from object_detector import Object_Detector_Tool

final_result = 1

def answer_to_quiz():
    """
    This function performs the following tasks:
    1. Loads the model from the "grounding_dino_model.pth" file
    2. Uses the model to detect objects in the image "path/to/image.png"
    3. Counts the number of detected objects on the image and prints them
    """
    global final_result

    # 1. Load the ground model
    detection_tool = Object_Detector_Tool()

    # 2. Detect objects in the image
    labels = ["baseball", "basket"]
    detection_tool.detect_images(image="path/to/image.png", labels=labels)

    # 3. Count the number of detected objects
    total_count = 0
    for label in labels:
        result = detection_tool.execute(image="path/to/image.png", labels=[label], save_object=True, saved_image_path="detected_objects")
        total_count += result['output_types'][0]

    final_result = total_count
    print(f"Number of objects detected in the image: {final_result}")
    return final_result
