from object_detector import Object_Detector_Tool

final_result = {}
labels = ['baseball', 'basket']
threshold = 0.45
model_size = 'base'

def detect_objects(image_path, labels, threshold, model_size=sf.tiny, save_object=True, saved_image_path="detected_objects"):
    detector = Object_Detector_Tool()
    results = detector.execute(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    detected_objects = results["output"][0]
    object_count = len(detected_objects.keys())
    detected_objects = [detected_objects for _ in range(object_count)]  # Make sure all labels are detected
   
    return object_count

# Usage
final_result = detect_objects("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_3_image_1.jpg", labels, threshold)
print(f"Number of detected objects: {final_result} objects detected. A total of {final_result} objects detected.")

