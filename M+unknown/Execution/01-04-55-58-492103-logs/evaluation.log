def count_tvs_in_wall():
    path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_3_image_1.jpg"
    labels = ["tv"]
    threshold = 0.45
    model_size = "tiny"
    save_object = True
    saved_image_path = "detected_objects"

    detected_results, object_number = object_detector_tool.execute(image=path_to_image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    total_tvs = sum(object_number[label][0] for label, objects in detected_results.items() for object_count in objects.values())

    final_result = ""
    if total_tvs > 0:
        final_result = f"{total_tvs} TV(s) are hung up on the wall."
    else:
        final_result = "There are no TVs hung up on the wall in this image."

    return final_result

final_result = count_tvs_in_wall()
print(final_result)

