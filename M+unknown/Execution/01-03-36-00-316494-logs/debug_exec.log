from object_detector import Object_Detector_Tool

# Function to calculate object counts
def count_objects(image_path: str, labels: list, save_object: bool = False, saved_image_path: str = None):
    image_path = image_path or "val_Counting_77_image_1.jpg"
    label_to_count = {x: 0 for x in labels}
    
    tool_instance = Object_Detector_Tool()
    tool_labels = [x for x in labels if x.lower() != 'none' and 's' not in x.lower()]
    tool_model_size = 'tiny' if tool_labels else 'base'
    
    if save_object:
        for label in tool_labels:
            tool_instance.execute(image_path = image_path, labels = label_to_count, save_object=True, saved_image_path = saved_image_path)
            label_to_count[label] += 1
    
    if not tool_labels:
        label_to_count['none'] = 1
    
    return label_to_count

final_result = count_objects(image_path="val.Counting_75.image_1.jpg", labels=['baseball', 'basket'],
                              save_object=True,
                              saved_image_path="detected_objects")

print(final_result)
