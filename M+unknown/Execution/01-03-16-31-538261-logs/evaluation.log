Code: from object_detector import Object_Detector_Tool

# Get a reference to the example image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_91_image_1.jpg"
detected_objects, object_count = Object_Detector_Tool.execute(image=image_path.replace(".jpg", "").replace(".png", ""), labels=["baseball"], save_object=True, saved_image_path="detected_objects")

# Check if any words containing the letter "i" were detected
final_result = []
for detected_object in detected_objects[0]:
    if "baseball" in detected_object["boxes"]:
        # Check if the detected object contains exactly one character containing the letter "i"
        if detected_object["boxes"].get("i") and detected_object["confidence_scores"][0] >= 0.45:
            final_result.append(object_count["number"][detected_object["classification"]])
        else:
            final_result.append(0)
    else:
        final_result.append(detected_object["number"])
# Print the final result
if final_result:
    print(f"The words containing the letter \"i\" in the image have {', '.join(str(x) for x in final_result)} in them.")
else:
    print("No words containing the letter \"i\" in the image.")

