Code: from object_detector import Object_Detector_Tool

def count_i_letters(image_path):
    detector = Object_Detector_Tool(image_path=image_path)
    _, label_results = detector.execute(labels=["i"])
    result_dict = label_results['count']
    count = sum(val['image'] == image_path for val in result_dict.values()) - sum(val['image'] != image_path for val in result_dict.values())
    return f"{count}"

final_result = count_i_letters("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_91_image_1.jpg")
print(final_result)

