Code: from object_detector import Object_Detector_Tool

def count_skiers(image_path):
    detector_tool = Object_Detector_Tool()
    labels = ['ski_dressed_in_red', 'other_ski_dressed_in_red']
    total_ski_counts = {}

    for label in labels:
        total, results = detector_tool.execute(image_path, labels=[label], confidence_threshold=0.5, model_size='base', save_object=False)
        total_ski_counts[label] = total

    if total_ski_counts:
        final_result = f"More than {len(total_ski_counts) - 1} people are wearing red skis, excluding the skis of the ski_dressed_in_red (assuming 'ski_dressed_in_red' is their type)."
    else:
        final_result = "No one in the image is wearing red skis."

    return final_result

# Sample image path
img_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_40_image_1.jpg"
count_skiers(img_path)

