code:from object_detector import Object_Detector_Tool

def calculate_object_count(image_path):
    """Detects objects in an image using the Grounding DINO model
    and returns a tuple containing the count for each detected object.
    """
    # Load the image file
    image = Image.open(image_path)
    
    # Detect objects using the Grounding DINO model
    tool = Object_Detector_Tool()
    labels = tool.object_detection(image)
    
    # Count the object detections
    count = len(labels['objects_by_label'])
    return count

