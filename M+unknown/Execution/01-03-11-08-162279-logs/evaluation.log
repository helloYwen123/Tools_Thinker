Code: from model_tool import object_detector

def count_signs(image_path):
    labels = ["stop"]  # Assuming only one label exists
    threshold = 0.45
    
    # Load the model
    model = object_detector.load_model('object_detector')
    
    # Run object detection
    outputs = model.run_on_image(image_path, labels=labels, threshold=threshold, model_size='tiny', save_object=False)
    
    # Count the number of signs
    sign_count = len([x for x in outputs['detected']['box'] if x['category'] == 'stop'])
    
    return {'sign_count': sign_count}

image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_104_image_1.jpg"  # Replace with the actual image path
final_result = count_signs(image_path)
print("Sign count:", final_result)
if final_result['sign_count'] > 0:
    print("There are", final_result['sign_count'], "signs on the image.")
else:
    print("No sign detected in the image.")

