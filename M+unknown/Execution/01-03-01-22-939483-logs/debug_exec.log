code:from object_detector import Object_Detector_Tool

def count_baseball_players(image_path):
    tool = Object_Detector_Tool()
    label_list = ["baseball", "basket"]
    # Save detected images with bounding boxes and confidence scores
    tool.execute(image_path, labels=label_list, save_object=True, saved_image_path="detected_objects")
    # Get a dictionary mapping detected labels and their counts and boxes
    result_dict = tool.output_types[0][0]
    # Count the number of baseball players
    baseball_count = {k: v["boxes"] for k, v in result_dict.items() if k == "baseball"}.get("boxes")
    # Filter the list of labels to only baseball players and count them
    baseball_labels = [l for l in label_list if l == "baseball"]
    baseball_count = len([bbox for bbox in baseball_labels[baseball_count] if bbox[0] > 0])
    return baseball_count

final_result = count_baseball_players("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_7_image_1.jpg")
print("Count of baseball players:", final_result)
