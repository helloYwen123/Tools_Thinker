code:from object_detector import Object_Detector_Tool

# Define the command: Detect objects in the image based on labels
def detect_objects(image_path, labels, save_object, saved_image_path):
    # Load the object detection model
    detector_og = Object_Detector_Tool()

    # Execute the command
    detected_objects, object_number = detector_og.execute(image_path, labels, threshold=0.45, model_size="tiny", save_object=save_object, saved_image_path=saved_image_path)

    return detected_objects, object_number

