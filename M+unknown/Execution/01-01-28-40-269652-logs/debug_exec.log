# Function to check the number of elephants with trunks in the water
def count_elephants_with_trunks(image_path, labels=["elephant"], threshold=0.45, model_size="base", save_object=False):
    detector_tool = Object_Detector_Tool(image_path=image_path, labels=labels, model_size=model_size)
    
    # Detect the elephants with trunks in the water
    for label in labels:
        object_detection_results = detector_tool.execute(threshold=threshold, labels=label, ignore_label_id=-1)
        
        if "boxes" in object_detection_results:
            if "total_count" in object_detection_results:
                total_count = object_detection_results["total_count"]
                
                for elephant in object_detection_results["boxes"]:
                    # Check if the elephants have their trunks in the water
                    if "trunk_length" in elephant and elephant["trunk_length"] > 0.5:
                        detected_image_path = f"{image_path.split('.')[0]}_with_trunk[length=0.5}.jpg"
                        object_number = total_count * 2
                        detector_tool.execute(save_object=save_object, labels=["elephant"], detected_image_path=detected_image_path, object_number=object_number, total_length=elephant["trunk_length"], name="elephant with trunk length=0.5")
                        return {"count": total_count, "label": label, "image_path": detected_image_path}
    return {"count": 0, "label": None, "image_path": None}

# Test the function with given image coordinates
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_43_image_1.jpg"
