# Import the Object_Detector_Tool class from the available tools
from object_detector import Object_Detector_Tool

def count_tennis_rackets(image_path):
    # Load the image from file
    image = object_detector.IO.ImgPyImage.open(image_path)

    # Detect tennis rackets using a predefined tool and return the count
    detected_objects = {}
    object_results = Object_Detector_Tool.execute(
        image=image,
        labels=["tennis racket"],
        save_object=False,
        saved_image_path=""
    )

    for label, box in object_results["detected_objects"].items():
        if "tennis racket" in label:
            box_count = box["boxes"].shape[0]
            # Count the number of tennis rackets detected
            tennis_racket_count = box_count

    return tennis_racket_count

