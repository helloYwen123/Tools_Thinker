def count_gloves(image_path):
    tool_tool_class_name = "Object_Detector_Tool"
    tool_input_types = { 'image': 'str - The path to the image file.', "labels": 'list - A list of object labels to detect.', "threshold": 'float - The confidence threshold for detection (default: 0.45).', "model_size": "str - The size of the model to use ('tiny' or 'base', default: 'tiny').", "save_object": 'bool - Whether to save the detected objects as images (default: False).', "saved_image_path": "str - The path to save the detected object images (default: 'detected_objects')'}
    tool_output_types = { "result": "tuple - A tuple containing two elements: (1) a dictionary mapping each detected label to its grouped detection results, where each value is a dictionary with keys 'boxes', 'confidence_scores', and 'saved_image_paths'; (2) a dictionary mapping each label to its total count in the image.", "labels_count": "dict - A dictionary with counts for each label."}
    tool_user_metadata = {'tool_class_name': tool_tool_class_name, 'tool_input_types': tool_input_types, 'tool_output_types': tool_output_types, 'tool_model_function': 'detect_objects'}
    
    detection_tool, labels, threshold, model_size, save_object, saved_image_folder = Object_Detector_Tool.execute(image_path, labels=["gloves'], save_object=True, saved_image_path="detected_objects", model_size=model_size)
    
    gloves_gloves_results = detection_tool["result"][-1]
    num_gloves = len(gloves_gloves_results["boxes"]["left"]) + len(gloves_gloves_results["boxes"]["right"])
    
    labels_count = {"gloves": num_gloves}
    return {"final_result": labels_count, "reason": "The number of gloves on the woman's hands is determined through the object detection results collected from the image file (image_path)."}

