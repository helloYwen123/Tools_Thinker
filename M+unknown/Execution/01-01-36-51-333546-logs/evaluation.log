Code: from object_detector import Object_Detector_Tool

person = input("请描述照片中的那个人：（输入'exit'退出）")
if person == 'exit':
    exit()

# 加载模型
detector_tool = Object_Detector_Tool()

# 读取图片
plt = detector_tool.execute(image="path/to/image.jpeg", labels=["baseball", "basket"])

# 计数每种物体
total = 0
box_count = {}

for box in plt:
    object_label = box['predicted_labels'][0][0][0]

    # 检查箱内的物体是否属于图片
    if object_label in ["baseball", "basket"]:
        print(f"在箱子内部发现了 {object_label}.")
        total += 1

    # 获取箱内的物体的标签
    label_box = box['result']['bbox'][0]  # 注意，bbox表示的是ymin, xmin,ymax, xmax，需要根据x+y和y的顺序进行处理
    while label_box in box_count:
        label_box = f'bbox.{label_box.split(".")[0]}'
    box_count[label_box] = box['result']['bbox'][0]

box_count = sorted(box_count.items(), key=lambda x: x[1], reverse=True)

# 打印箱子
print(f"共有 {total} 张票的照片。每张票大约有 {total} 个箱，箱内有:\n")
for box in box_count:
    x, y, w, h = box['bbox']
    if [box['result']['bbox'][0], box['result']['bbox'][1], int(x/w), int(y/w)] in plt:
        print(f"箱内有 {box['result']['bbox'][1]} x {box['result']['bbox'][0]} 的箱，坐标是 ({bbox['bbox'][0]}, {bbox['bbox'][1]}），大小为 {w}x{h}，内有 {total} 个箱")

final_result = (total, total)
print(f"最终结果是总共发现了 {total} 张票的照片。")

