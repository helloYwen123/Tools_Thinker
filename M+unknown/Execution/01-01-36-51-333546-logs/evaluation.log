Code: from object_detector import Object_Detector_Tool

# Define the labels to detect and the confidence threshold
labels = ['baseball', 'basket']
confidence_threshold = 0.45

# Initialize the object detector tool
object_detector_tool = Object_Detector_Tool()

# Call the tool to detect the labels in the image
detected_objects, object_number = object_detector_tool.execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_88_image_1.jpg", labels=labels, save_object=False, threshold=confidence_threshold)

# Define the results according to the label 'baseball'
baseball_results = detected_objects['baseball']['boxes'].flatten()
basket_results = detected_objects['basket']['boxes'].flatten()

# Print the counts of detected sports balls and baskets
print(f"Number of sports balls detected: {len(baseball_results)}")
print(f"Number of baskets detected: {len(basket_results)}")

# Initialize variables to store the counts of detected sports balls and baskets
sports_ball_counts = []
basket_counts = []

# Loop to update the counts for baskets and sports balls based on the detected objects
for num, (bbox, conf, id, _) in enumerate(detected_objects['basket']['boxes'].values()):
    number = object_number - num + 1
    basket_counts.append(number)
    sports_ball_counts.append(basket_counts[-1] + 1)

final_result = sports_ball_counts or basket_counts
final_result

