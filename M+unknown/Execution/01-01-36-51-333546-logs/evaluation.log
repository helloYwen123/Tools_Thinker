Code: from object_detector import Object_Detector_Tool

# Function to detect bears and count them
def detect_bears(image_path):
    # Initialize object detector tool
    detector = Object_Detector_Tool(image_path, labels=["bear"])
    # Execute object detection using the tool
    results = detector.execute()
    
    # Get bear count
    bear_counts = results.get('count', 0)
    
    return bear_counts

# Sample image path
sample_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_88_image_1.jpg"

# Call the function
bear_count = detect_bears(sample_image_path)

final_result = bear_count

