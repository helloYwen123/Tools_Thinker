import os
import cv2

def get_label_bbox(dataset, image_path):
    try:
        if not os.path.exists(image_path):
            raise ValueError(f"The image '{image_path}' is not found.")
        
        img = cv2.imread(image_path)
        
        # Detect the image using the Grounding DINO model
        label_list = detect_object(img, labels=['red', 'orange'], save_object=False)
        
        return label_list
    except Exception as e:
        return None

def label_count(dataset, label_list):
    label_count_dict = {}
    for label in label_list['labels']:
        if label in label_count_dict:
            current_count = label_count_dict[label]
            new_count = current_count + 1
            label_count_dict[label] = new_count
        else:
            label_count_dict[label] = 1
            
    return label_count_dict

def count_birds():
    # Load the val_image_115.txt file
    with open("val_image_115.txt", "r") as file:
        val_image_content = file.readlines()

    dataset_folder = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/"
    
    image_list = []
    for i in range(len(val_image_content)):
        val_label = val_image_content[i][11:13]
        image_list.append(os.path.join(dataset_folder, val_image_content[i].strip().replace('[', '').replace(']', '').replace('/Image', '')))
    
    label_list = get_label_bbox(dataset=dataset_folder, image_path=image_list[0])
    
    if label_list is None:
        return None
    
    label_count_dict = label_count(dataset=dataset_folder, label_list=label_list)
    
    bird_count = 0
    for label, count in label_count_dict.items():
        if label == 'wading-bird':
            bird_count += count

    return bird_count

