Code: from object_detector import Object_Detector_Tool

# Sample image for demonstration
# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_114_image_1.jpg"

# Initialize Object_Detector_Tool
detector_tool = Object_Detector_Tool()

# Detect objects
labels = ["baseball", "basket"]
detected_objects, object_count = detector_tool.execute(image_path=image_path, labels=labels, save_object=False)

# Get the counts for each detected object
class_count = object_count["baseball"]
print(f"There are {class_count} baseballs detected in the image.")

# Get the list of objects detected in the image
objects = detected_objects["baseball"]
print("The detected baseball objects in the image are:")
for obj in objects:
    print("Object label:", obj["label"], "Bounding box coordinates:", obj["box"], "Score:", obj["score"])

# Print all detected objects
for i, label in enumerate(labels):
    print(f"{label} detected with {object_count[label]} instances")

# Close the object Detection Tool
detector_tool.close()

