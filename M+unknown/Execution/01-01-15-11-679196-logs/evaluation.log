Code: from object_detector import Object_Detector_Tool

# path to the image
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_114_image_1.jpg"

# labels to detect
labels = ["baseball", "basket"]

# confidence threshold
threshold = 0.45

# size of the model to use ('tiny' or 'base', default: 'tiny')
model_size = "tiny"

# options for saving detected objects
save_object = True
saved_image_path = "detected_objects"

# execute the tool
detected_objects, objects_count = Object_Detector_Tool.execute(image=path_to_image, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size, threshold=threshold)

# get the total count of detected objects
total_count = len(detected_objects)

# extract the number of objects by label (excluding 'basket' to avoid counting it's reverse version)
objects_number = {
    'baseball': 0,
    'basket': 0
}

for object in detected_objects:
    label = object['label']
    
    # count the number of objects of the same label
    if label == 'baseball':
        objects_number['baseball'] += 1
    elif label == 'basket':
        objects_number['basket'] += 1
    
    # check if the object is detected in the 'basket' label
    if label == 'basket':
        if detected_objects['basket']['boxes'][0][1] == detected_objects['baseball']['boxes'][0][1] and detected_objects['basket']['boxes'][0][1] == detected_objects['basket']['boxes'][0][1] > threshold:
            if 'basket' in detected_objects['basket']['boxes'][1]:
                detected_objects['basket']['boxes'][1].remove('basket')
            else:
                detected_objects['basket']['boxes'][1].append('basket')
    
# check if the giraffe is in the list of detected objects
if 'baseball' in detected_objects:
    final_result = {
        'A': 0,
        'B': 0
    }
    for object in detected_objects['baseball']:
        if 'name' in object.keys() and detected_objects['baseball']['baseball']['name'] == 'Giraffe':
            final_result['A'] += 1
        elif 'name' in object.keys() and (
                'name' == 'Giraffe' or
                detected_objects['baseball']['name'] == 'Giraffe'
        ):
            final_result['B'] += 1
else:
    final_result = {
        'A': 0,
        'B': 0
    }  

# check if the giraffe is detected in the list of objects
if total_count > 0:
    if 'baseball' in detected_objects and detected_objects['baseball']['name'] == 'Giraffe':
        final_result['A'] += 1
    else:
        final_result['B'] += 1

