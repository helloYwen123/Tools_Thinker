def find_blue_towels(image_path):
    # Load the image file
    tools = Object_Detector_Tool(image_path)
    labels = tools.labels
    threshold = 0.45
    save_object = False
    saved_image_path = "detected_objects"
    
    # Filter objects by class and size
    filtered_objects = {l: [] for l in labels}
    for label, boxes in tools.items():
        if boxes[0].label == "base" and boxes[1].label == "blue":
            filtered_objects[label].append(boxes)
        else:
            filtered_objects[label].append(boxes[0])
    
    # Count the number of blue towels
    blue_towels_count = sum(1 for boxes in filtered_objects['blue'] if boxes[0].label == "towel")
    
