Code: class Object_Detector_Tool:
    def execute(self, image, labels, save_object=True, saved_image_path="detected_objects", threshold=0.45, model_size="tiny"):
        import numpy as np
        from object_detector_tool import detect_objects_with_model
        image = np.array(Image.open(image))
        result = detect_objects_with_model(image, labels, threshold, model_size)
        if save_object:
            for label in result['object_number']:
                with open(f'{saved_image_path}/{label}.jpg', 'wb') as f:
                    f.write(result['object_number'][label]['image_path'])
        return result

# Usage: run the command with appropriate input values
