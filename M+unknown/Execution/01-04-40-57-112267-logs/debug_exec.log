code:from object_detector import Object_Detector_Tool

# Function to calculate the number of people (purple) in the image
def calc_people_in_purple(image_path):
    # Load the image
    detector_tool = Object_Detector_Tool(image_path, labels=["human"], threshold=0.45, save_object=False)
    
    # Get the detected labels and return their numbers
    labels, counts = list(detector_tool.output)
    
    # Filter labels to extract purple objects
    purple_labels = [label for label, count in counts.items() if "human" in label]
    
    # Get the number of purple objects
    num_purple_objects = len(purple_labels)
    
    return num_purple_objects

