from object_detector import Object_Detector_Tool

# Function to count the number of red letters on the front of the train
def count_red_letters(train_image_path):
    # Load the image and detect red letters
    detected_objects = Object_Detector_Tool.execute(image=train_image_path, labels=["red"], save_object=True, saved_image_path="detected_objects")
    
    if "boxes" in detected_objects[0]:
        red_letters = detected_objects[0]["boxes"][0]  # Assuming the first detected object has a 'boxes' key
        num_red_letters = len(red_letters["x"]["y"])
        
    else:
        num_red_letters = 0  # If there are no letter boxes detected, return 0
    
    return num_red_letters
