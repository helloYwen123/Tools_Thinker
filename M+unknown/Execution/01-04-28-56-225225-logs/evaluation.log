def count_people_facing_train():
    # Load the image
    obj_detect_tool = Object_Detector_tool()
    
    # Load the image path
    img_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_99_image_1.jpg"
    
    # Detect people in the image
    objects, person_count = obj_detect_tool.execute(image=img_path, labels=['human'], save_object=True)
    
    # Get the object and count data for the given labels
    detections_by_labels = obj_detect_tool.get_obj_and_count_results(objects)
    
    # If the number is greater than zero, it indicates there are people
    if len(detections_by_labels) > 0:
        num_people = detections_by_labels[0]["total"][0]
        
        # If there is a person visible in front of the train
        if person_count[0] > 0:
            final_result = f"A total of {person_count[0]} person(s) are potentially facing the train."
        else:
            final_result = f"0 person(s) are potentially facing the train."
    else:
        # If there are no detections, it could mean the vehicle is very close to the camera
        final_result = "It is impossible to determine the number of people facing the train without additional information."
    
    return final_result

