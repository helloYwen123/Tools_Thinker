Code: def detect_objects(image_path, labels=["car", "bus"], confidence_threshold=0.45, model_size='tiny', save_object=False):
    detection_tool = Object_Detector_Tool()
    results = detection_tool.execute(image_path=image_path, labels=labels, save_object=save_object, threshold=confidence_threshold, model_size=model_size, labels_file='labels.json')
    object_count = {result['object_label']: len(results) for result in detection_tool.output_types[1]['grouped_results']}
    final_result = {
        "Detected Objects": object_count,
        "Total Objects Detected": len(detection_tool.output_types[0]['detected_results'])
    }
    return final_result

