def bbox_to_widht_height(bbox):
  return int(bbox[2] / (bbox[3] - bbox[1]), 32)

def get_bbox_area(bbox):
  return bbox[2] * bbox[3]

def object_counter(img):
  results, confidence_scores, saved_image_paths = img.detect_object_image()
  data = []
  for cls in results:
    bboxes = np.array([[bbox[0], bbox[1], bbox[2], bbox[3]] for bbox in results[cls]])
    width, height = bbox_to_widht_height(bboxes)
    x, y, w, h = bbox_to_widht_height(bboxes[0])
    label = results.keys()[0]
    conf = confidence_scores[label]

    if len(results) == 1:
      label = 'baseball'

    score = 1 / (1 + math.exp(conf * 900))
    area = get_bbox_area(bboxes) * conf * 0.01
    # score = 1 / (1 + math.exp(conf * 900000))
    data.append({'cls': label, 'bbox': bbox, 'area': area, 'score': score})

  # return ['baseball']
  return data

