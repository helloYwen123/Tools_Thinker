Code: from object_detector import Object_Detector_Tool

final_result = {}
labels = ["baseball", "basket"]

# Load model
detector_tool = Object_Detector_Tool()
detector_tool.load_model(model_size='tiny')

# Image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_81_image_1.jpg"

# Execute detection
boxes, scores, image_paths = detector_tool.execute(
    image=image_path,
    labels=labels,
    save_object=True,
    saved_image_path="detected_objects"
)

# Count detected objects
for detected_objects in boxes:
    results = {}
    for label in detected_objects:
        results[label] = dict(zip("boxes, confidence_scores, saved_image_paths", zip(
            tuple(detected_objects[label]), tuple(scores[label]), tuple(image_paths[label]))))

        if label in final_result:
            final_result[label].extend(results[label])
        else:
            final_result[label] = results[label]

print(final_result)

