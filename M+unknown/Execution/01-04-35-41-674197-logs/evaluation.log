Code: from object_detector import Object_Detector_Tool

def count_red_shirts(image_path):
    detector_tool = Object_Detector_Tool()

    labels = ["red_shirt"]
    save_object = True

    results = detector_tool.execute(image_path, labels=labels, save_object=save_object)

    num_red_shirt = results["object_number"]["red_shirt"][0]

    return num_red_shirt

final_result = count_red_shirts("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_81_image_1.jpg")
print("Number of players wearing red shirts:", final_result)

