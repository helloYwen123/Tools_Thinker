Code: from object_detector import Object_Detector_Tool

# Set the input image and label for detection
input_image = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_61_image_1.jpg'
labels = ["motorcycle"]
confidence_threshold = 0.7

# Create an Object_Detector_Tool instance
tool = Object_Detector_Tool()

# Execute the detection
detected_objects, object_number = tool.execute(input_image, labels=labels, confidence_threshold=confidence_threshold)

# Print the detected objects
for label, result in detected_objects.items():
    confidence = result.get("confidence_scores", 0)[0]
    boxes = result.get("boxes", [])
    if len(boxes) > 0:
        boxes = boxes[0][0]

        # Check if it's a motorcycle (ignoring all the other objects)
        if boxes[1] > 0.5 and boxes[3] > 0.5:
            final_result.append(label)
            print(f"Found {label} with Confidence {confidence}")

            # Save the detected motorcycle if "save_object" is True
            if save_object:
                motocycle_img_path = f'detected_objects/{label}'
                tool.save(detected_objects=motocycle_img_path, labels=tool.get_object_results())

# Print the final result
print("Detected motorcycles:", final_result)

