Code: from object_detector.object_detector import Object_Detector_Tool

final_result = 0

def detect_objects(input_path, labels, threshold=0.45, model_size='tiny', save_object=False):
    tool_instance = Object_Detector_Tool()
    result = tool_instance.execute(image=input_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)
    if result:
        detected_objects = result[0]
        object_count = detected_objects['count']
        return object_count
    else:
        return 0

result = detect_objects("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_32_image_1.jpg", ["frog", "green"])
final_result = result[0]
print("Number of green frogs under the table:", final_result)

