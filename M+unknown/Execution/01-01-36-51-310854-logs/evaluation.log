Code: def get_what_without_hats():
    # Load the image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_95_image_1.jpg"
    obj_detector = Object_Detector_Tool()
    detections = obj_detector.detect_image(image_path, labels=["hats"], threshold=0.45)

    # Count the number of objects without hats
    no_hats = 0
    all_labels = None
    for _, obj, _ in detections:
        if obj["label"] != "hats":
            no_hats += 1
            all_labels = obj 

    return no_hats, all_labels

