Code: from object_detector import Object_Detector_Tool

def count_people_without_hats(path_to_image):
    class_name = 'Person'
    count_without_hats = 0

    object_detector = Object_Detector_Tool(
        labels=[class_name],
        threshold=0.8,
        model_size='base',
        save_object=True,
        saved_image_path=None
    )

    with open(path_to_image, 'rb') as image_file:
        image = image_file.read()

    objects = object_detector.detect(image)

    for object_info in objects['output']:
        if 'boxes' in object_info.keys() and 'person' in object_info['boxes']:
            if 'hat' not in object_info['boxes'].keys():
                count_without_hats += 1

    return count_without_hats

final_result = count_people_without_hats('/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_95_image_1.jpg')
print(f"Number of people without hats: {final_result}")

