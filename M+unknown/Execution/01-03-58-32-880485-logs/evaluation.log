Code: from object_detector import Object_Detector_Tool

# The path to the image to be processed
im_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_55_image_1.jpg"

# Detect the objects in the image: baseball and basket
label_output = {"baseball": [], "basket": []}

# Calculate the number of baseball and basket
count = 0

# Load the model with the 'base' and 'basket' labels and save the objects
detector_tool = Object_Detector_Tool()
result = detector_tool.execute(image=im_path, labels=["baseball", "basket"], save_object=True)

# Check if there are baseball
if result["baseball"]:
    label_output["baseball"] = result["baseball"]
    count += 1

# Check if there are basket
if result["basket"]:
    label_output["basket"] = result["basket"]
    count += 1

# Calculate the total count
total_count = count
final_result = f"{total_count} {'baseball' if label_output['baseball'][0]['box'] > label_output['basket'][0]['box'] else 'basket'}"

print(final_result)

