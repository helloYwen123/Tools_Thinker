def main():
    from object_detector import Object_Detector_Tool  # 导入object_detector库

    # 解析图片
    def parse_image(image_path):
        label_dict = {}
        result_dict = {}
        model_size = "tiny"
        for _label in ["baseball", "basket"]:
            prediction = Object_Detector_Tool.execute(
                image_path,
                labels=[_label],
                save_object=True,
                saved_image_path=f"detected_objects/{_label}",
                model_size=model_size
            )
            label_dict[_label] = prediction["label_dict"]
        
        # 检查是否存在篮球队
        import os
        file_path = os.path.dirname(__file__)
        detected_folder = os.path.join(file_path, "detected_objects")
        
        # 删除预览图片
        if os.path.exists(f"{detected_folder}/baseball-detected.png"):
            os.remove(f"{detected_folder}/baseball-detected.png")
        
        return {"label_dict": label_dict, "detected_objects": {"baseball-detected.png": 1} if "baseball-detected.png" in os.listdir(detected_folder) else {}}

    # 解析图片
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_111_image_1.jpg"
    result = parse_image(image_path)

    # 计算篮球和棒球的总数
    total_balls = result["label_dict"]["baseball"]
    total_balls += result["label_dict"]["basket"]
    
    # 输出结果
    print(f"总数：{total_balls}")
    final_result = {"count": total_balls}
    print(final_result)

if __name__ == "__main__":
    main()
