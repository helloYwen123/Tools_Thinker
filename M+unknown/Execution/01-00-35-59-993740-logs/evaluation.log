from object_detector import Object_Detector_Tool

def count_white_umbrellas(image_path):
    detected_objects = Object_Detector_Tool.execute(image_path=image_path, labels=["white_umbrella"], save_object=False)
    total_white_umbrellas = 0
    for label_detected_objects in detected_objects:
        for detection_results in label_detected_objects["results"]:
            if detection_results["label"] == "white_umbrella":
                total_white_umbrellas += 1
                for box in detection_results["boxes"]:
                    white_umbrella_boxes.append([box["left"], box["top"], box["width"], box["height"]])

def count_total_umbrellas(image_path):
    detected_objects = Object_Detector_Tool.execute(image_path=image_path, labels=["umbrella"], save_object=False)
    total_umbrellas = 0
    for label_detected_objects in detected_objects:
        for detection_results in label_detected_objects["results"]:
            if detection_results["label"] == "umbrella":
                total_umbrellas += 1
                for box in detection_results["boxes"]:
                    total_umbrellas_boxes.append([box["left"], box["top"], box["width"], box["height"]])
    final_result = {"white_umbrellas": total_white_umbrellas, "total_umbrellas": total_umbrellas}

