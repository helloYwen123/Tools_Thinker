Code: from object_detector import Object_Detector_Tool

def detect_objects(image_path, labels, threshold, model_size, save_object, saved_image_path):
    obj_detector_tool = Object_Detector_Tool(image_path=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
    detected_objects, object_count = obj_detector_tool.execute()

    final_result = {'labels': obj_detector_tool.labels, 'counts': object_count}

    return final_result

