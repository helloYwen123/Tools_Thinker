        target_bboxes, target_scores, target_labels, target_conf_scores = bboxes, conf_scores, labels, target_boxes  # 2048, 2048, 4, 4

        return dict(target_bboxes=target_bboxes, target_labels=target_labels, target_scores=target_scores, target_conf_scores=target_conf_scores), bboxes, conf_scores, labels

    def threshold(self, boxes, scores, threshold):
        boxes = boxes.cpu().numpy()
        scores = scores.cpu().numpy()
        threshold = 90 # 90th percentile confidence threshold
        conf_scores = scores.cpu().numpy()

        for i, (det) in enumerate(boxes):
            if det[4] >= threshold:
                boxes[i, :] = det[:4]
                scores[i, :] = conf_scores[i, :]
        return boxes, scores

