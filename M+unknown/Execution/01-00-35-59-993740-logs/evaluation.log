class Object_Detector_Tool:
    def execute(self, image, labels, threshold=0.45, model_size='tiny', save_object=False, saved_image_path="detected_objects"):
        import torchvision.transforms as transforms
        import cv2
        from model import grounding_dino
        from torchvision.models.detection.r50_fpn_head import Head
        
        threshold, model, transform = self.threshold, self.model, self.transform
        detection_result = []
        
        input_transform = transform.Compose([
                           transforms.Resize((self.model.size.width, self.model.size.height)),
                           transforms.ToTensor(),
                           transform.SpatialNormalization(),
                            transform.Normalize(mean=[0.4, 0.4, 0.4], std=[0.2, 0.2, 0.2]),
                           ])
        
        image = cv2.cvtColor(cv2.imread(image), cv2.COLOR_BGR2RGB)
        input = input_transform(image=image, bboxes=None, mask=None, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path= saved_image_path)
        
        input = input.to(self.device)
        output_detections = grounding_dino(input)
        
        for _, detection in output_detections:
            boxes = detection['boxes']
            bboxes = boxes[labels]
            conf_score = detection['scores'][:, labels]
            detection_result.append({
                'boxes': bboxes,
                'confidence_score': conf_score,
                'label': labels
            })
        
        if save_object:
            for d in detection_result:
                if d['label'] in {'baseball', 'basket'}:
                    det_dir = f'detected_objects/{d["label"]}'
                    os.makedirs(det_dir, exist_ok=True)
                    det_img_path = path.join(det_dir, f'{d["label"]}.jpg')
                    import os
                    os.makedirs(det_img_path, exist_ok=True)                
                    cv2.imwrite(det_img_path, d['boxes'], d['scores'])
            
        return detection_result

