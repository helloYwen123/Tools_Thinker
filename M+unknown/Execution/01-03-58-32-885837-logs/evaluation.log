Code: import object_detector

def count_skiers():
    # Load the model and set the threshold
    mod = object_detector.Model("tiny")
    mod.threshold = 0.45
    
    # Define the image and labels
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_76_image_1.jpg"
    labels = ["ski", "snowboarder"]
    
    # Load model and check its ability to detect objects in the image
    det_results = mod._load_image(image_path)
    
    # Define the object detected
    object_name = "ski"
    
    # Detect the object in the image
    detected_object = det_results.get_labels(object_name)
    
    # Calculate the number of detected objects
    total_skiers = 0
    for obj in detected_object:
        if obj["label"] == object_name:
            total_skiers += 1
            
    # Print the information
    print("Total number of skiers detected:", total_skiers)

