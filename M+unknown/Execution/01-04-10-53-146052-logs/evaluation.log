Code: from object_detector import Object_Detector_Tool

detector = Object_Detector_Tool()

# Convert the image path to a PIL image
img = Image.open("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_60_image_1.jpg").convert('RGB')

# Detect objects using Object_Detector_Tool
detected_objects = {
    "egg": {
        "boxes": [],
        "confidence_scores": [],
        "saved_image_paths": []
    },
    "pepper": {
        "boxes": [],
        "confidence_scores": [],
        "saved_image_paths": []
    }
}

# Calculate the number of boxes with high confidence
num_boxes = len(detected_objects)

# Check if "egg" and "pepper" are detected
if "egg" in detected_objects and "pepper" in detected_objects:

    # Prepare the "boxes" list for both labels
    egg_boxes = []
    pepper_boxes = []

    # Convert each bounding box object results to individual bounding box.
    for obj in detected_objects["egg"].values():
        top, left, bottom, right = obj["bbox"]
        box = (top, left, bottom, right)
        egg_boxes.append(box)

    for obj in detected_objects["pepper"].values():
        top, left, bottom, right = obj["bbox"]
        box = (top, left, bottom, right)
        pepper_boxes.append(box)

    # Check if there were detected both "egg" and "pepper"
    num_egg_pepper = 0
    if len(egg_boxes) > 0 and len(pepper_boxes) > 0:
        num_egg_pepper = len(egg_boxes) + len(pepper_boxes)

        # Filter out any overlaps between egg and pepper boxes
        egg_pepper_overlaps = [[x1, y1, x2, y2] for x1, y1, x2, y2 in zip(*egg_boxes, *pepper_boxes)]
        egg_pepper_overlaps = [[xx for (yy, xx, xx, yy) in pairwise(box)] for box in egg_pepper_overlaps]
        egg_pepper_overlaps = [[box for box in group if len(group)>1] for group in groupby(egg_pepper_overlaps)]

        egg_counter = 0
        pepper_counter = 0
        for overlap in egg_pepper_overlaps:
            if overlap[0][1] < overlap[1][1]:
                pepper_counter += 1

            if overlap[0][0] < overlap[1][0]:
                egg_counter += 1

        num_egg_pepper += pepper_counter + egg_counter

    # Get the total count for each label
    results = detected_objects
    for label, objects in detected_objects.items():
        boxes = [tuple(box) for box in objects["boxes"]]
        scores = [box["confidence_score"] for box in objects["boxes"]]
        if len(scores) > 0:
            box_count = dict.from_dict({(key, val): 0 for key, val in enumerate(scores)})
            for box in boxes:
                top, left, bottom, right = box
                for score, box_loc in boxes_count.items():
                    if score == box["confidence_score"]:
                        box_count[score] += 1
                        break
            egg_boxes_count = results[label].get("box_count", 0)
            pepper_boxes_count = results[label].get("box_count", 0)
            total_box_count = egg_boxes_count + pepper_boxes_count
            results[label]["box_count"] = total_box_count

    num_boxes_str = str(num_boxes)
    final_result = {
        "a": detected_objects,
        "b": num_boxes_str,
        "c": num_boxes,
        "d": num_egg_pepper
    }

    print(f"Final result: {final_result}")
else:
    print("Detected objects are too limited. Please make sure the image contains both 'egg' and 'pepper'.")

