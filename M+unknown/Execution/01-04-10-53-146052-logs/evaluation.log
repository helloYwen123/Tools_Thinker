def count_sandwiches():
    # Replace 'path_to_image' with the actual file path to your image
    detected_objects, object_number = Object_Detector_Tool.execute(image='path_to_image', labels=["sandwich", "wrap"], save_object=True, saved_image_path="sandwiches")

    total_sandwiches = object_number["sandwich"]["boxes"] + object_number["wrap"]["boxes"]
    return total_sandwiches

