from object_detector import Object_Detector_Tool

def get_blue_buses(image, labels, threshold, model_size, save_object):
    object_detector_tool = Object_Detector_Tool()
    detections = object_detector_tool.execute(image=image, labels=labels, save_object=save_object)
    
    # Count blue buses
    blue_buses_count = len([bbox for label in detections["out"] for bbox in label if "blue" in label["name"]])
    
    return blue_buses_count
