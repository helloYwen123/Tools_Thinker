Code: from object_detector import Object_Detector_Tool

# Function to count the number of detected objects in a given image
def count_objects(image_path, labels=["bananas"], model_size="base", save_object=False, saved_image_path="detected_objects"):
    tool = Object_Detector_Tool()
    image = tool.load_image(image_path)
    
    # Detect objects in the image
    results = tool.detect_objects(image, labels, threshold=0.45, model_size=model_size)
    
    # Get labels count and grouped results
    labels_count = results.get("output", {}).get("grouped_results")
    total_objects = len(results.get("output", {}).get("results", []))
    
    # Return the number of detected bananas
    if save_object:
        return {'labels': labels, 'count': total_objects}
    else:
        return {'bananas': total_objects}

