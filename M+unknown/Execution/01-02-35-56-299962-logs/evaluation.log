Code: from object_detector import Object_Detector_Tool

# Load object detector
object_detector_tool = Object_Detector_Tool()

# Load image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_45_image_1.jpg"

# Detect objects
labels = ["baseball", "basket"]
confidence_threshold = 0.45
model_size = "tiny"

# Create a dictionary to store the results
result_dict = {}

# Detect baseball and basketball
for label in labels:
    result = object_detector_tool.detection(image_path, labels=label, confidence_threshold=confidence_threshold, model_size=model_size, save_object=True, saved_image_path="detected_objects")
    total_count = result["output_types"][0]["categories"]['baseball'].get('count', 0)
    result_dict[label] = {'boxes': result["output_types"][0]["boxes"], 'confidence_scores': result["output_types"][0]["confidences"], 'saved_image_paths': result["output_types"][0]["saved_image_paths"]}  
    result_dict[label]["count"] = total_count

# Extract the number of motor drives (boxes with 'MOTOR_DRIVE' in the saved image paths)
motors_drives = [item for label in result_dict for motor in result_dict[label]["boxes"] if "MOTOR_DRIVE" in motor["saved_image_paths"]]

final_result = {"motor drives": len(motors_drives)}
print(f"Number of motors driving near the bus: {final_result}")

