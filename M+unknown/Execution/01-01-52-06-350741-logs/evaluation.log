Code: from google.colab.object_detector_tool import Object_Detector_Tool

# Define variable to store the count of common vowels
common_vowels_count = 0

class Object_Detector_Tool:
    def __init__(self, image_path_path, labels, threshold = 0.45, model_size = "tiny", save_object = True, saved_image_path = ""):
        self.image_path_path = image_path_path
        self.labels = labels
        self.threshold = threshold
        self.model_size = model_size
        self.save_object = save_object
        self.saved_image_path = saved_image_path

    def detect_objects(self):
        # Load the image using Google object detection API
        detection_tool = Object_Detector_Tool(self.image_path_path, self.labels, self.threshold, self.model_size, self.save_object, self.saved_image_path)
        results = detection_tool.execute()

        # Analyze the results to count the common vowels
        for result in results:
            text = result['text'].lower()
            vowels = "aeiou"
            vowel_count = sum(1 for char in text if char in vowels)
            if vowel_count > 0: common_vowels_count += 1

    def get_labels_with_boxes(self, label_counts):
        return {
            label: {'boxes': boxes, 'confidence_scores': scores, 'image_paths': image_paths}
            for label, label_counts in label_counts.items()
        }

    def get_labels_with_counts(self, label_counts, sorted_labels):
        return {
            label: count
            for label, count in sorted(label_counts.items())
        }

    def has_objects(self):
        return self.labels not in ["all", "neither", "any", "count"]
    
    def has_correct_object(self, label_counts):
        return label_counts[self.labels] == 1
    
    def get_objects(self, label_counts, sorted_labels):
        return {
            label: label_counts.get(label, 0)
            for label in sorted_labels if label_counts[label] > 0
        }

    def get_unique_labels(self, results):
        return [label for label, result in results.items() if result['labels'] == self.labels]
    
    def has_correct_objects(self, results):
        for label in results:
            boxes = results[label].get('boxes', [])
            if not boxes: return False
            if len(set(boxes)) != len(boxes): return False
            if not results[label].get('confidence_scores'): return False
            if results[label].get('confidence_scores')[0] < self.threshold: return False
        return True

    def has_no_vowel_count(self, results):
        common_vowels_count = 0
        for result in results:
            text = result['text'].lower()
            vowels = "aeiou"
            if not all(char in vowels for char in text): common_vowels_count += 1

        return common_vowels_count == 0

