Code: from object_detector import *

def count_vowels(image_path):
    # Load the image and extract bounding boxes
    detections = object_detector.execute(image_path, ["Vowels"], save_object=True)

    # Extract the letters that appear in the image
    letter_labels = []
    for bounding_boxes in detections.values():
        for label in bounding_boxes[-2]:
            letter_labels.append(label)

    # Count the common vowels
    common_vowels = set()
    for letter in letter_labels:
        if letter.lower() in ['a', 'e', 'i', 'o', 'u']:
            common_vowels.add(letter.lower())

    return len(common_vowels)

image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_69_image_1.jpg"
final_result = count_vowels(image_path)
print("The number of common vowels in the image is:", final_result)

