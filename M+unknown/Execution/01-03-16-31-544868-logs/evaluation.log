Code: def find_motors(image_path):
    from object_detector import Object_Detector_Tool

    # Check if object_detection is installed and available
    if "object_detector" in __package__ and "Object_Detector_Tool" in __import_name__:
        tool = Object_Detector_Tool()
        detected_objects, object_number = tool.execute(image_path=image_path, labels="motors", save_object=True, saved_image_path="detected_objects")
        if detected_objects:
            motorcycles = detected_objects["detected_objects"]["motorcycles"]
            return motorcycles["boxes"], motorcycles["scores"], motorcycles["saved_image_paths"]
        else:
            return [], [], []
    else:
        return [], [], []

