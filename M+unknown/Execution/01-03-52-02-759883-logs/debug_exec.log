from object_detector import Object_Detector_Tool

final_result = []
labels = ['tall building', 'flat top building']
threshold = 0.3
model_size = 'tiny'
save_object = False

try:

    # Load image
    with open('/path/to/image.jpg', 'rb') as f:
        image = f.read()
        
    # Determine and count objects in image
    results = Object_Detector_Tool.execute(image=image, labels=labels, threshold=threshold, model_size=model_size)    
    
    detected_objects = results[0]
    num_count = {k: detected_objects[k][0][1].count('false') for k in labels}

    final_result.append({'Objects': 'tall buildings', 'Count': num_count['tall building'], 'Objects': 'flat top buildings', 'Count': num_count['flat top building']})
    
except Exception as e:
    print(f"An error occurred: {e}")
finally:
    print(final_result)
