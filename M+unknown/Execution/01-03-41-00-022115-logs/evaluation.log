Code: import object_detector

def calculate_elephants_in_water():
    # Detect objects in an image
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_73_image_1.jpg"
    labels_to Detect = ["elephants"]      # Need to specify labels here only
    save_object = True
    saved_image_path = "elephants_in_water"
    
    detected_objects, object_number = object_detector.execute(image_path, labels=labels_toDetect, save_object=bool(save_object), saved_image_path=saved_image_path)
    
    # Check and count the number of detected elephants
    elephants_in_water = sum(existing_object['num_objects'] for existing_object in detected_objects if existing_object['object_label'] == "elephants")
    
    return {"elephants_in_water": elephants_in_water}

