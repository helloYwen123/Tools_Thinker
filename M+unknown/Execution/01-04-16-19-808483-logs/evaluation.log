# Load the image from the file path
with Object_Detector_Tool().execute(image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_58_image_1.jpg") as output:

    # Create a dictionary to store the results
    result = {"labels": [], "boxes": [], "confidence_scores": [], "saved_image_paths": []}

    # Iterate through each detected object in the image
    for obj, boxes, confs, path in output['object_number']:

        # Check if the object is in the list of labels to detect
        if obj.label in label_list:
            result["labels"].append(obj.label)
            result["boxes"].append(boxes)
            result["confidence_scores"].append(confs)
            result["saved_image_paths"].append(path)

    # Append the total count for each label
    result["labels"].append("total")
    result["boxes"].append([x for _, _, _, _ in output["object_number"]])
    result["confidence_scores"].append(sum(output["confidence_scores"]))

    # Output the results as a tuple of two dictionaries
    final_result = (result, result["labels"])

