# Function to count drive wheels on the engine
def count_drive_wheels(label_list):
    # Initialize variable to count drive wheels
    drive_wheels_count = 0

    # Iterate through each detected object in 'object_list'
    for label, objects in label_list.items():
        # Iterate through each object in 'objects' and check which 'box' is 1 (indicating a drive wheel)
        for box in objects['boxes'][0]:
            if box == 1:
                drive_wheels_count += 1

    return drive_wheels_count

# Call the function and print the result
drive_wheels_count = count_drive_wheels({'baseball' : [{'boxes': [[1, 2, 0.6, 0.7]], 'confidence_scores': [0.7]}, {'boxes': [[0, 0, 1, 1]], 'confidence_scores': [0.7]}]})
print("The count of drive wheels is:", drive_wheels_count)

