Code: from object_detector import Object_Detector_Tool

final_result = 0

# Load the image and labels
label_1 = ['orange', 'green', 'red', 'yellow', 'blue', 'violet', 'pink', 'milk', 'tea', 'coffee', 'soda', 'hot_fudge']
label_2 = ['banana', 'water', 'ice', 'soda', 'milk', 'coffee', 'tea', 'fruit', 'meat', 'chocolate', 'cup', 'bowl']

# Path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_1_image_1.jpg"

# Convert the labels to a list
labels = label_1 + label_2

# Set the threshold
threshold = 0.45

# Set the model size
model_size = "tiny"

# Set the save object flag
save_object = True

# Execute the object detection tool
detected_objects, object_number = Object_Detector_Tool.execute(image_file=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object)

# Loop over the detected objects and count them
for label, detection_results in detected_objects["detected_objects"].items():
    if label in label_1:
        final_result += len(detection_results["boxes"])
    if label in label_2:
        final_result += label_2.count(label)

print(final_result)

