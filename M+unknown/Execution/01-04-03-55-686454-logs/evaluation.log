Code: from object_detector import Object_Detector_Tool

# Function to detect green tiles
def count_green_tiles(image_path):

    # Load the input image
    detector_tool = Object_Detector_Tool(image_path=image_path, labels=["green_tile"], threshold=0.3, save_object=False)
    detected_labels = detector_tool.run()
    
    # Get the number of green tiles
    green_tile_count = 0
    for detection in detected_labels:
        tiles = detection['boxes'][0]
        for tile in tiles:
            if tile in ["green_tile"]:
                green_tile_count += 1
    
    return green_tile_count

# Call the function to count green tiles
final_result = count_green_tiles("/Path_to_your_image_here")

print("The wall has", final_result, "green tiles.")

