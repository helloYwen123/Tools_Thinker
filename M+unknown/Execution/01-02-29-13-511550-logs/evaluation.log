Code: from object_detector import Object_Detector_Tool

# Image path
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_97_image_1.jpg'

# Object labels
labels = ['baseball', 'basket']

# Threshold for detection
threshold = 0.45

# Model size
model_size = 'tiny'

# Save object images
save_object = True

# Saved image path
saved_image_path = 'detected_objects'

try:
    # Create object detection tool instance
    detector = Object_Detector_Tool(image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

    # Display the result
    print("\nDetected objects:\n")
    for label, results in detector.objects.items():
        print(f"Label: {label}, Count: {results['count']}, Bounding box: {results['bbox']}")
except Exception as e:
    print(f"An error occurred during object detection: {e}")
finally:
    # Cleanup
    if detector:
        detector.close()
        
    if detector.objects:
        print("\nDetected objects were successfully closed.")
        
    print("\nObject detection done.")

# Analyze the data
final_result = {
    'count': len(detector.objects),
    'bbox': [results['bbox'] for results in detector.objects.values()]
}
print("\nFinal result:")
print(sorted(final_result.items(), key=lambda x: x[0], reverse=True))  # Output the final result as a sorted list

