from object_detector import Object_Detector_Tool

# Define the question
question = """
Question: How many words written in white chalk are on the chalkboard?

"""

# Call the tool to detect white words on the chalkboard
result = Object_Detector_Tool.execute(image="path_to_image.jpg", labels=["white chalk"], threshold=0.8, model_size="base")

# Extract the result
result_1 = result[1].get("result")

# The first element in the result is the word count dictionary
word_count = result_1[0]["result"]

# The second element is the number of detected white words
total_white_words = word_count["white chalk"]["words"]

# Assign the final answer
final_result = total_white_words
