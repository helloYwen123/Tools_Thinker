Code: from object_detector import Object_Detector_Tool

# Get the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_16_image_1.jpg"

# Create an object detector tool
detector_tool = Object_Detector_Tool()

# Use the tool to detect the image
detected_objects, object_number = detector_tool.execute(image=image_path, labels=["baseball"], save_object=True, saved_image_path="detected_objects")

# Sort the detected objects by number of images
sorted_objects = list(sorted(detected_objects.items(), key=lambda x: len(x[1]['saved_image_paths'])))

# Print the sorted objects dictionary
print(sorted_objects)

# Select the first item in the list (closest in terms of number of images)
first_sorted_object = sorted_objects[0]

# Print the number of kids in front of the school bus
kids_count = first_sorted_object.get("boxes") + [1]  # Adding 1 for the bus windows
final_result = sum(kids_count)  # Get the total number of kids in front of the bus
print(final_result)

