// Convert 'labels' to a list before sending to the tool
auto labels_list = std::vector<std::string>(labels);

void executed_command(const std::vector<std::string>& image_path, const std::vector<std::string>& labels, float threshold, std::string model_size, bool save_obj = nullptr, std::string dst_path = "detected_objects") {
        // Load the image
        cv::Mat img = cv::imread(image_path);

        // Apply the object detection and draw bounding boxes
        std::vector<int> boxes;
        std::vector<float> conf_scores;
        for (const auto& label : labels_list) {
            auto detected_objects = object_detector.execute(image_path, {label}, threshold, model_size, save_obj);
            for (const auto& obj : detected_objects) {
                boxes.push_back(obj[0]);
                conf_scores.push_back(obj[1]);
            }
        }

        // Draw the boxes on the image
        draw_object_in_image(img, boxes, conf_scores);

        // Convert the image to JPEG format for saving
        cv::imwrite(dst_path, img);

        // Clean up the object detection tool
        object_detector.tearDown();
}

void executed_command(const std::string& image_path) {
        // Load the image
        cv::Mat img = cv::imread(image_path);

        // Apply the object detection and draw bounding boxes
        std::vector<int> boxes;
        std::vector<float> conf_scores;
        for (const auto& label : labels_list) {
            auto detected_objects = object_detector.execute(image_path, {label}, 0.5, "base", true);
            for (const auto& obj : detected_objects) {
                boxes.push_back(obj[0]);
                conf_scores.push_back(obj[1]);
            }
        }

        // Draw the boxes on the image
        draw_object_in_image(img, boxes, conf_scores);

        // Convert the image to JPEG format for saving
        cv::imwrite("detected_objects.jpg", img);
}

void draw_object_in_image(cv::Mat img, const std::vector<int>& box_list, const std::vector<float>& score_list) {
        // Draw the objects on the image
        cv::drawRects(img, box_list, score_list, 255, 255, -0.02,
                       false); // No transparency to prevent it from being displayed
}

