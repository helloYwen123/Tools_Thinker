Code: from object_detector import Object_Detector_Tool

def count_people_in_water(image_path):
    detector = Object_Detector_Tool()  # instantiate the Object_Detector_TOOL
    labels = ["water"]  # specify which labels to detect
    
    # execute the tool on the image
    results = detector.execute(image_path, labels=labels, save_object=True)
    
    # extract the number of people in the water
    people_in_water = results[0]['boxes']
    total_people = sum([(1 for person in people_in_water if 'person' in person['category'])) 
    
    return total_people

