from object_detector import Object_Detector_Tool

def count_black_suitcases(image):
    tool = Object_Detector_Tool()
    tool.execute(image=image, labels=["baseball"], threshold=0.5, model_size="tiny")
    results = tool.output

    has_black_suitcases = {"baseball": {}, "basket": {}}
    for label, results_dict in results.items():
        # Get the number of objects for each label
        num_objects = results_dict["boxes"]
        has_black_suitcases[label]["black_suitcases"] = sum([int(box["label"]) == 1 for box in num_objects])

    return has_black_suitcases
