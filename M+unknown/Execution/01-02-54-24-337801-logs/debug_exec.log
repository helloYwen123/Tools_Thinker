from object_detector import Object_Detector_Tool

# Function to count yellow stars on a bridge
def count_yellow_stars(image_path):
    try:
        # Open the image
        image_data = Object_Detector_Tool._load_image(image_path)

        # Create a label (dictionary)
        labels = {"yellow_star": 0}

        # Run the object detection model
        results = Object_Detector_Tool.detect_objects(
            image_data,
            labels=labels,
            threshold=0.45,
            model_size="tiny",
            save_object=True,
            saved_image_path="yellow_stars_detected",
            limitations={"min_objects_detected": 1}
        )

        # Check the total count of the requested objects
        total_count = results['object_number']['yellow_star']

        return total_count
    except Exception as e:
        return "Error encountered while running the tool: {}".format(e)

