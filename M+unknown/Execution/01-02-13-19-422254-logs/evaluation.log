Code: from object_detector import Object_Detector_Tool, detected_objects, object_number

# Step 1: Initialize the Object_Detector_Tool from the available tools.
tool = Object_Detector_Tool()

# Step 2: Define the image path and label.
img_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_119_image_1.jpg"
label = "baseball"

# Step 3: Use the tool to execute image detection.
detected_objects, object_number = tool.execute(img_path=img_path, labels=[label], save_object=True, saved_image_path="detected_objects")

# Step 4: Extract information from the "detected_objects" dictionary using the returned data
# Initialize a dictionary to store detected object information
obj_info = {}

# Iterate through the detected objects
for label, group in detected_objects.items():
  # Grouping detections
  boxes, scores, image_path = group
  # Total count of the label
  label_count = object_number.copy()  # Create a copy of the object_number dictionary to avoid modifying it
  label_count[label] += 1

  # Construct the string '{}: ' followed by the count value
  label_count_string = "{}: {}".format(label, label_count)

  # Create a dictionary grouping total counts for a label with boxes, scores, and image paths
  label_group = {"boxes": boxes, "scores": scores, "image": image_path}
  
  # Add the group to the obj_info dictionary
  obj_info[label_count_string] = [label_group]

# Print the results
print("Detected objects:")
for label, objects in obj_info.items():
  print(f"Label: {label} - {len(objects)}")
for label, objects in obj_info.items():
  # Convert tuple to a string for print
  print("  - Group: {}".format(obj_info[label]))

# Step 5: Finally, assign the final answer to a variable (final_result) with the detected object data from the "obj_info" dictionary
final_result = obj_info

