from object_detector import Object_Detector_Tool

# path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_112_image_1.jpg"

# labels to detect
labels = ["baseball", "basket"]

# confidence threshold
confidence_threshold = 0.4

# size of the model to use ('tiny' or 'base', default: 'tiny')
object_detector_tool_tool_class_name = "Object_Detector_Tool"
object_detector_tool_size = "tiny"

# save detected objects as images if 'save_object' is True
save_object = True

# the path to save the detected object images
saved_image_path = "detected_objects"

try:
    # execute the object_detector_tool_tool_class_name method
    detected_objects, obj_number = getattr(Object_Detector_Tool, object_detector_tool_tool_class_name)(image_path, labels, confidence_threshold, object_detector_tool_size, save_object, saved_image_path)
    
    # count labels based on the detected_objects dictionary
    count_label = {label: detected_objects for label, detected_objects in detected_objects.items()}
    
    # final_result contains the number of detected bottles
    final_result = sum(count_label.values())
    
except Exception as e:
    print(f"An error occurred: {str(e)}")
