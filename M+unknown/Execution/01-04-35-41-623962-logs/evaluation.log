Code: from object_detector import Object_Detector_Tool

# Step 1: Define the labels to detect and set the confidence threshold
labels = ["elephant"]

# Set the threshold for confidence. You can use a higher threshold for a more accurate but less complete result
confidence_threshold = 0.5

# Step 2: Initialize the object detector
object_detector = Object_Detector_Tool()

# Step 3: Detect objects in the image
results = object_detector.execute(image="path/to/image.jpg", labels=labels, confidence_threshold=confidence_threshold)

# Step 4: Get the total count of each detected object
counts = dict()

for result in results['output']:
    if result['label'] in counts:
        counts[result['label']] += 1
    else:
        counts[result['label']] = 1

# Step 5: Calculate the final result
total_result = {}
total_result['count'] = 0
for label, count in counts.items():
    if label == None:
        label = 'elephant'
    total_result[label] = count

# Step 6: Display the final result
final_result = {'count': total_result['count'], 'labels': total_result}
