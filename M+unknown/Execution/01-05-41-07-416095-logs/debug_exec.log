from object_detector import Object_Detector_Tool

final_result = 2

def count_gloves():
    woman = Object_Detector_Tool.execute(image="path_to_image.jpg", labels=["gloves"])
    
    for label, result in woman.items():
        gloves = result["boxes"]
        
        if gloves is not None and len(gloves) > 1:
            count = len(gloves)
            final_result += count
            
    return final_result
