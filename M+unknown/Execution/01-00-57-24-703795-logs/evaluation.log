Code: from object_detector import Object_Detector_Tool

# Sample path to the image
image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_1_image_1.jpg'

# Sample labels to detect
labels = ["baseball", "basket"]

# Set the threshold and model size
threshold = 0.45
model_size = 'tiny'

# Set whether to save the detected objects as images
save_object = True

# Convert to string
img = open(image_path).read()

# Detect objects
detected_objects, object_number = Object_Detector_Tool.execute(image=img, labels=labels, save_object=save_object, threshold=threshold, model_size=model_size)

# Count detected objects for each label
for label, objs in detected_objects.items():
    if objs:
        final_result[label] = len(objs)

# Print the final result
print("There are", final_result, "blue floats.")

