# Convert image strings to actual image objects
image_paths = {"val_Counting_48_image_1.jpg": "Image File"}

# Prepare input parameters for detection tool
all_image_objects = []
for image_path, image_data in image_paths.items():
  labels = ['toilet', 'lid']
  threshold = 0.45
  model_size = "tiny"
  save_object = True
  saved_image_path = "detected_objects"

  # Detect objects in input image file
  object_detector = Object_Detector_Tool(image=image_data, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)
  result = object_detector.execute()

  # Extract counts of relevant 'toilet' objects
  toilet_list = []
  for label in result['object_number']:
    if label['id'] == 'toilet':
      toilet_list.append(label['count'])
      
  # Filter out toilet lids
  toilet_lids = []
  for lid in toilet_list:
    if lid[0] == lid[2]:
      toilet_lids.append(lid)

  # Exclude toilet lids with no corresponding toilet object
  if toilet_lids:
    toilet_lids = toilet_lids + toilet_list

  final_result = {
    'final_result': toilet_lids
  }

  all_image_objects.append(final_result)

final_result

