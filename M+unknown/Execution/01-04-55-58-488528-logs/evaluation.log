Code: from object_detector import Object_Detector_Tool

final_result = []

# Set object detection thresholds and model type
labels = ["baseball", "basket"]

# Set save object details
save_object = True
saved_image_path = "detected_objects"

# Detect the object in the image
object_number = Object_Detector_Tool.execute(image="image_with_counts_path", labels=labels, save_object=save_object, saved_image_path=saved_image_path)

# Determine if there's a count for each detected object
for label, grouped_results in object_number.items():
    detected_objects = grouped_results['object_results']
    for detected_object in detected_objects:
        if detected_object['label'] == "basket":
            final_result.append({"count_name": "basketball", "count_number": len(detected_objects) + 1})
        elif detected_object['label'] == "baseball":
            final_result.append({"count_name": "baseball", "count_number": len(detected_objects) + 1})
        else:
            final_result.append({"count_name": "unknown count", "count_number": len(detected_objects) + 1})

print(final_result)

