code:from object_detector import Object_Detector_Tool

def count_blue_shirted_players(image_path: str) -> int:
    """
    Counts the number of players wearing blue shirts in an image.
    
    Parameters:
    - image_path (str): The path to the image file.
    
    Returns:
    - int: The count of players wearing blue shirts in the image.
    """
    with Object_Detector_Tool(image_path, labels=["player"], threshold=0.45, model_size="tiny") as dettool:
        detections = dettool.detections
    
    player_count = len([det for det in detections if det["class_name"] == "player" and det["color"] == "blue"])
    return player_count

# Example usage
image_file = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_102_image_1.jpg"
count = count_blue_shirted_players(image_file)
print(f"Number of players wearing blue shirts: {count}")

