Code: from object_detector import Object_Detector_Tool

def count_frogs( Detective_Tool : Object_Detector_Tool)->(int):
    # Read the image
    image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_32_image_1.jpg'
    result = Detective_Tool.execute(image=image_path, labels=['frog', 'chameleon'], threshold=0.45, save_object=True, saved_image_path='detected_objects')
    detected_objects, obj_count = result
    
    # Identify and count the number of frogs under the table
    num_frogs_under_table = 0
    if 'frog' in detected_objects and 'table' in detected_objects:
        for obj in detected_objects['frog']:
            if obj['x'] < 785 and obj['y'] < 435:
                num_frogs_under_table += 1
    final_result = {'num_frogs': num_frogs_under_table}
    return final_result

