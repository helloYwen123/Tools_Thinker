def answer_question(question):
    # Get the image and labels
    image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_11_image_1.jpg"
    labels = ["baseball", "basket"]
    
    # Create the object detector tool
    ODT_Tool = Object_Detector_Tool(image_path=image_path, labels=labels, save_object=True)
    
    # Detect the objects
    detector_result = ODT_Tool.execute()
    
    # Count the basketball and baseball
    basketball_count = detector_result["object_number"]["basketball"]["boxes"].sum()
    baseball_count = detector_result["object_number"]["baseball"]["boxes"].sum()
    
    # Return the result
    if basketball_count > 0 and baseball_count > 0:
        return f"{basketball_count} basketballs and {baseball_count} baseballs. There are {basketball_count + baseball_count} objects in total."
    elif basketball_count < 0 and baseball_count < 0:
        return f"{basketball_count} basketballs and {baseball_count} baseballs. There are {basketball_count + baseball_count} objects in total."
    elif basketball_count < 0 and baseball_count < 0:
        return f"{basketball_count} basketballs and {baseball_count} baseballs. There are {basketball_count + baseball_count} objects in total."
    else:
        return f"{basketball_count} basketballs and {baseball_count} baseballs. There are {basketball_count + baseball_count} objects in total."
    
