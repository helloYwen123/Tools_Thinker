input_image = output_image_path
labels = ["baseball", "basket"]
threshold = 0.45
model_size = "tiny"
save_object = True
saved_image_path = "detected_objects"

# Step 3: Use the tool to detect 'baseball' and 'basket' in the image
detected_objects, object_number = Object_Detector_Tool.execute(image=input_image, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

final_result = {
    "count_0": sum([obj["number"] for obj in object_number]),
    "count_1": sum([obj["number"] for obj in detected_objects if obj["label"] == "baseball" & obj["confidence"] > threshold]),
    "count_2": sum([obj["number"] for obj in detected_objects if obj["label"] == "basket" & obj["confidence"] > threshold])
}

print(f"Count of 'baseball' and 'basket' detected: {final_result['count_0']} + {final_result['count_1']} = {final_result['count_0'] + final_result['count_1']}")

