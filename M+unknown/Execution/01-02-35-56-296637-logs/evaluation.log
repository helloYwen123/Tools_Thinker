    image="/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_118_image_1.jpg",
    save_object=True,
    labels=["cap"],
    threshold=0.45,
    model_size="tiny",
    saved_image_path="cap_detection"
)

# Detect the blue hats
cap_detections = tool.execute()

# Count the detections
num_hats = len(cap_detections)

# Calculate the proportion of people not wearing a blue hat
not_wearing_hats = 1 - (num_hats / len(cap_detections))

