code:from object_detector import Object_Detector_Tool
import os

def count_baseball_players(image_path):
    """Detects 'baseball' and returns a dictionary with the count of 'baseball' and its boxes."""
    tool = Object_Detector_Tool()
    result = tool.execute(image_path, labels=['baseball'], save_object=True)
    baseball_box_result = result["objects"][0]
    total_baseball_boxes = len(result["objects"])
    
    # Calculate the count of 'baseball'
    # We only need to check for 'baseball' as it's the only label detected so far
    total_count = len(result["objects"])
    if baseball_box_result["score"] == 0.4557 and int(total_baseball_boxes) > 0:
        final_result = {"baseball": total_count}
    
    return final_result

