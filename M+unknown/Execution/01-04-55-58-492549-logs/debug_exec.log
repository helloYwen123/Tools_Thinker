def count_baseball_and_basket(image_path):
    try:
        detector_tool = Object_Detector_Tool()
        image_data = detector_tool.execute(image_path, ["baseball", "basket"], save_object=False)
        
        baseball_count = 0
        basket_count = 0
        
        for label, results in image_data["results"].items():
            if label == "baseball":
                baseball_count += len(results["boxes"])
            elif label == "basket":
                basket_count += len(results["boxes"])
            
        return {
            "baseball_count": baseball_count,
            "basket_count": basket_count
        }
    except Exception as e:
        return {"error": str(e)}

