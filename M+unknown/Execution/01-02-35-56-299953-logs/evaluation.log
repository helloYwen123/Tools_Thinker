Code: from object_detector import Object_Detector_Tool

# Step 1: Initialize the object detector tool
tool = Object_Detector_Tool()

# Step 2: Set up the image and labels for detection
path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_93_image_1.jpg"
labels = ["baseball", "basket"]
threshold = 0.45
model_size = "tiny"

# Step 3: Execute the model with labels
result = tool.execute(image_path=path_to_image, labels=labels, save_object=True, threshold=threshold, model_size=model_size)

# Step 4: Load the detected objects into a dictionary
object_counts = tool.output_types['object_number']

# Step 5: Determine if only one object is present
if object_counts:
    if "baseball" in object_counts:
        final_result = f"Only one baseball was detected."
    else:
        for key in object_counts:
            if key not in ["baseball", "basket"]:
                break
        else:
            final_result = "No baseball was detected."
else:
    final_result = "No objects were detected."

# Step 6: Return the final result
final_result

