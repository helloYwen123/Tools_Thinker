Code: from object_detector import Object_Detector_Tool

def calculate_total_wash双手人数():
    # Load the image
    image_path = "/path/to/image.png"
    detector_tool = Object_Detector_Tool(image_path, labels=["hands"], threshold=0.5)
    detected_objects = detector_tool.execute()

    # Count the hands detected
    hand_counts = detected_objects.get('detected_objects', {}).get('label', []).count('hands')

    return int(hand_counts), 5

