from object_detector import Object_Detector_Tool

def count_drivers(image_path, num_labels, threshold, model_type='tiny', save_object=True, saved_image_path="detected_objects"):
    tool_config = {
        "image": image_path,
        "labels": [num_labels],
        "threshold": threshold,
        "model_size": model_type,
        "model_type": model_type,
        "save_object": save_object,
        "saved_image_path": saved_image_path
    }
    result = Object_Detector_Tool().execute(**tool_config)
    total_count = result[0]['object']['count']
    return total_count

def detect_and_count_drivers(image_path, num_labels, threshold, save_object=True):
    driver_count = count_drivers(image_path, num_labels, threshold, model_type="base", save_object=save_object)
    print(f"Total Drivers: {driver_count}")

if __name__ == "__main__":
    # Define number labels, threshold, and model size, which we know are valid values based on the tool.
    num_labels = 2
    threshold = 0.45
    model_type = "base"

