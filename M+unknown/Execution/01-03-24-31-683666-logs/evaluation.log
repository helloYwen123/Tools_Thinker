Code: from object_detector import Object_Detector_Tool

# Function to count blue circles in the image
def count_blue_circles(image_path):
    detector_tool = Object_Detector_Tool()
    label = "blue_circle"
    
    # Call the function with the provided image path and labels
    detected_objects, object_number = detector_tool.execute(image=image_path, labels=[label], save_object=True, threshold=0.45, model_size="tiny")
    
    # Count the number of detected objects
    blue_circle_count = len(detected_objects) if detected_objects else 0
    
    return blue_circle_count

