Code: from object_detector import Object_Detector_Tool

# Function to count the number of people in the water
def count_people_in_water(saved_image_path):
    with open(saved_image_path, 'r') as file:
        content = file.read()
        lines = content.split('\n')
        water_area = lines[1:18]

        # Find the water areas in the line
        for i in range(len(water_area)):
            if '$A$' in water_area[i] or '$B$' in water_area[i]:
                water_start_pos = i
                break

        # Count the number of water areas
        water_count = water_start_pos
        for i in range(1, len(water_area) - 1):
            if '$A$' in water_area[i] or '$B$' in water_area[i]:
                water_count += 1

        return water_count

# Get the number of people in the water
final_result = count_people_in_water("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_82_image_1.jpg")
print("Number of people in the water:", final_result)

