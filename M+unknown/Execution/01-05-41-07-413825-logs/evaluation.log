def count_purple_planes(input_image_path):
    # Define the labels to detect
    labels_to_check = ["purple"]
    
    # Ensure the image path ends with .jpg or .png
    input_image_path = input_image_path.split('/')[-1]
    if input_image_path.endswith('.png'):
        input_image_path = input_image_path[:-4] + '_jpg'
    
    # Create the object_detector_tool instance
    detector_tool = Object_Detector_Tool()

    # Execute the tool to detect purple planes
    detected_output = detector_tool.execute(image=input_image_path, labels=labels_to_check, save_object=True)

    # Count the purple planes
    total_purple_planes = 0
    for output in detected_output[1]:
        for plane in output['boxes']:
            if plane ['label'] == 'purple':
                total_purple_planes += plane['confidence'] # Assuming confidence is a measurement of how likely the plane is a purple plane

    return total_purple_planes

