Code: from object_detector import Object_Detector_Tool

def count_people(image):
    # Import object detector tool
    object_detector_tool = Object_Detector_Tool()
    
    # Execute the tool to detect people in the image
    detected_results = object_detector_tool.execute(image=image, labels=["person"], save_object=True, saved_image_path="detected_people")
    
    # Extract the number of people
    total_people = sum([result['boxes'] for result in detected_results.values()])
    
    return total_people

final_result = count_people("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_61_image_1.jpg")
print("Number of people: {}".format(final_result))

