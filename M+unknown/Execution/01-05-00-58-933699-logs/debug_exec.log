code:def get_glass_count(image, object_labels要知道):
    # Import tools
    import object_detector

    # Initialize object_detector tool
    tool = object_detector.Object_Detector_Tool()

    # Get detailed detections
    detailed_detection_results = tool.execute(image=image,
                                       labels=object_labels要知道,
                                       threshold=0.45,
                                       model_size="tiny",
                                       save_object=True)

    # Generate final result
    count_dict = {}
    glasses_count = 0
    for key, value in detailed_detection_results.items():
        if 'basket' in key:
            glasses_count += value[2][0]
        else:
            count_dict[key] = value[0] - glasses_count

    return count_dict

