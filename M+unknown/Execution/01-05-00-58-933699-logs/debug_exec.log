code:from object_detector import Object_Detector_Tool

def calculate_glasses_empty(image_path):
    # Load and detect objects using the Grounding DINO model
    detector_tool = Object_Detector_Tool()
    detected_objects_results = detector_tool.execute(image_path, labels=["glass"], save_object=True)

    # Count glasses in each group to determine how many are empty
    empty_glasses_count = 0
    for labels, detection_results in detected_objects_results.items():
        for group, boxes, scores, saved_image_paths in labels:
            if group == "glass":
                if len(saved_image_paths) > 0:
                    for saved_image_path in saved_image_paths:
                        if "empty" not in saved_image_path.split("-"):
                            empty_glasses_count += 1

    return empty_glasses_count

