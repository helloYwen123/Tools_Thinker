# Function to count the number of banners
def count_banners(path_to_image):
    # Open the image
    image_list = [] 
    object_detector_tool = Object_Detector_Tool()
    for label_list in object_detector_tool.execute(image_path=path_to_image, labels=["banners"], threshold=0.45):
        image_count = len(label_list["boxes"])        
        object_detector_tool.save_object(save_obj_path=f"detected_objects/{label_list['name']}.jpg", 
                                        boxes=label_list["boxes"], 
                                        confidence_scores=label_list["confidence_scores"])

    return {'count': image_count, 'labels': label_list}

# Call the function with the image path and pass the result to the final result variable
