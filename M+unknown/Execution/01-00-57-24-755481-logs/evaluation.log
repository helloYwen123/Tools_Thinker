Code: from object_detector import Object_Detector_Tool

# Function to count the number of people reflected in the mirror
def count_reflected_people(image_path):
    # Load the image
    detector_tool = Object_Detector_Tool()
    object_labels_to_count = ["Person"]
    saved_image_path = "detected_objects"
    
    # Execute the detection tool
    detected_objects, object_counts = detector_tool.execute(image=image_path, labels=object_labels_to_count, save_object=True, saved_image_path=saved_image_path)
    
    # Count the number of people by checking the 'count' values for each detected label
    reflected_people_count = sum(value["count"] for value in detected_objects.values() if "count" in value)
    
    return reflected_people_count

# Example usage
final_result = count_reflected_people("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_75_image_1.jpg")
print(f"The number of people reflected in the mirror is: {final_result}")

