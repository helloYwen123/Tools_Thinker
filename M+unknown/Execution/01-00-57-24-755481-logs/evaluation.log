Code: from object_detector import *

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_75_image_1.jpg"

# List of object labels to detect
labels = ["baseball", "basket"]

# Confidence threshold
confidence_threshold = 0.45

# Size of the model to use ('tiny' or 'base')
model_size = "tiny"

# Whether to save the detected objects as images (True)
save_object = True

# Path to save the detected object images
saved_image_path = "detected_objects"

# 1. Detect the objects
objects_results = Object_Detector_Tool.execute(image=image_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path, model_size=model_size)

# Check if the object detection was successful
if objects_results[0]:
    objects_detected = objects_results[1]

    # Count the detected objects
    num_objects = objects_results[2]

    # Determine the actual number of people reflected in the mirror
    num_people = 0

    # Assuming all objects detected are reflections of the same person
    for obj_number in objects_results[1]:
        # Convert object coordinate to relative size
        obj_coord = ((label_name_map[obj_number])['bbox']) if label_name_map[obj_number]['name'] == "baseball" else ((label_name_map[obj_number])['bbox'])
        
        # Convert object size to fraction of image width/height
        fraction_width = obj_coord[2][0] / float(obj_coord[2][2]) if obj_coord[2] else obj_coord[2][0]
        fraction_height = obj_coord[3][0] / float(obj_coord[3][2]) if obj_coord[3] else obj_coord[3][0]

        # Adjust fraction width and height if it is out of the image bounds
        if fraction_width > 1 or fraction_width < 0:
            fraction_width, fraction_height = 1, 1
        
        # Calculate the new relative width and height
        new_fraction_width = (obj_coord[2][0] + obj_coord[2][0]) / float(obj_coord[2][2]) if obj_coord[2] else obj_coord[2][0]
        new_fraction_height = (obj_coord[3][0] + obj_coord[3][0]) / float(obj_coord[3][2]) if obj_coord[3] else obj_coord[3][0]

        # Multiply the new coordinates to match the mirrored object coordinates
        new_obj_coords = ((fraction_width * obj_coord[0]),
                           (new_fraction_width * obj_coord[0]),
                           (new_fraction_height * obj_coord[1]),
                           (fraction_height * obj_coord[1]))

        # Calculate the normalized distance to the midline of the bounding box
        normalized_dist = (new_obj_coords[2][0] - new_obj_coords[0][0]) / float(new_obj_coords[2][2]) if new_obj_coords[0] else new_obj_coords[2][0]
        
        # Determine the direction in which the reflected object is moving
        if normalized_dist > 0:
            direction = "right"
        else:
            direction = "left"

        # Determine the distance to the right or left of the midline of the bounding box
        object_distance = normalize(new_obj_coords[0]) - normalize(new_obj_coords[2]) if obj_coord[2] else normalize(new_obj_coords[0])

        # Use the object's direction and coordinates to determine if it is a reflection of a person
        if direction == "right" and normalized_dist > 1.0 * conf_threshold and object_distance > 1.0 * conf_threshold:
            num_people += 1
            # Determine the reflection angle
            reflection_angle = normalize(new_obj_coords[2]) - normalize(new_obj_coords[-2])
            
            # Determine the object's orientation in the image coordinate system
            orientation_angle = 180 - reflection_angle
            # Determine the object's position within the image coordinate system
            obj_position = ((obj_coord[0] + obj_coord[2]) / 2) - ((fraction_width * obj_coord[0] + fraction_height * obj_coord[1]) / float(obj_coord[2]))
        
            # Determine the normalized distance from the midline of the bounding box (within the reflection angle)
            normalizedObjDistance = normalize(new_obj_coords[0]) - normalize(new_obj_coords[-2]) if obj_coord[0] else normalize(new_obj_coords[0])

            # Determine the reflection's direction (within the reflection angle)
            if normalizedObjDistance < 1.0 * conf_threshold and obj_position > 1.0 * conf_threshold:
                direction = "upright"
            elif normalizedObjDistance < -1.0 * conf_threshold and obj_position > 1.0 * conf_threshold:
                direction = "upright"
            elif normalizedObjDistance > 1.0 * conf_threshold and obj_position < -1.0 * conf_threshold:
                direction = "upright"
            elif normalizedObjDistance < -1.0 * conf_threshold and obj_position < -1.0 * conf_threshold:
                direction = "upright"
            else:
                direction = "upright"

            # Determine the reflection's image coordinates and position within the image
            new_obj_coords = ((new_obj_coords[2][0] - obj_position) if obj_position > 0 else new_obj_coords[2][0], normalise(new_obj_coords[2]) - normalize(new_obj_coords[0]))
            normalizedObjPosition = ((new_obj_coords[2] + obj_position) if obj_position > 0 else new_obj_coords[2], new_obj_coords[2])
            
            # Save the detected object
            Object_Detector_Tool.save_object(obj_number, obj_position, direction, normalizedObjPosition, new_obj_coords, conf_threshold, labels)
        else:
            # Assume all detected objects are reflections of the same person
            num_people += 1
                
    final_result = f"{num_people} people reflected in the mirror"
else:
    final_result = "No detection"

# Print the final result
print(final_result)

