def count_red_coats(): 
  # Load the model and set the threshold
    detector = Object_Detector_Tool()
    
    labels = ["red_coat"]
    
    # Initialize the results dictionary
    results_dict = {}
    
    # Get the results
    results = detector.execute(image="path/to/image.png", labels=labels, save_object=False)
    
    # Get the number of "red_coat" detections
    num_red_coats = sum([len(detected_objects['boxes']) for detected_objects in results['object_number']])
    
    # Print the number
    print(num_red_coats)
  
    return num_red_coats

if __name__ == "__main__":
