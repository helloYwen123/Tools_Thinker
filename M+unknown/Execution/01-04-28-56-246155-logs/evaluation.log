Code: from object_detector import Object_Detector_Tool

# Function to count the number of knobs on the stove
def count_knobs(image_path):
    # Initialize the Object_Detector_Tool object with the specified arguments
    obj = Object_Detector_Tool()

    # Set the image_path and labels, then execute the tool
    results = obj.execute(image_path, ['knobs'], save_object=False)

    # Check if the tool was successful
    if 'detected_objects' in obj.result:
        detected_objects = obj.result['detected_objects']

        # Get the labels in the results
        labels = detected_objects[0]['labels'].keys()

        # Count the labels
        count = len(labels)

        # Return the result
        final_result = {"Count": count}
        return final_result

    else:
        # Return the result of not successfully executing the tool
        return ""

