Code: import torchvision.transforms as T
import torch

def count_people_with_green_jackets(image_path):
    pipeline = T.Compose([T.LoadPILImage(image_path)])
    image = pipeline(image_path)
    object_detector = Object_Detector_Tool()
    detections = object_detector.run(image, labels=["shoes", "body", "backpack"], threshold=0.5, model_size="tiny", save_object=True, saved_image_path="detections")
    
    total_count = len(detections["boxes"])
    
    people_with_green_jackets = detections["boxes"][(detections["labels"] == "backpack") & (detections["boxes"]["green_jackets"])]
    final_result = {"count": int(total_count), "green_jackets": len(people_with_green_jackets)}
    
    return final_result

image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_30_image_1.jpg"
final_result = count_people_with_green_jackets(image_path)
print(f"Total number of people in the image: {final_result['count']}")
print(f"Number of people wearing green jackets: {final_result['green_jackets']}")

