Code: from object_detector import Object_Detector_Tool

final_result = 0

def detect_person(snow_skiers):
    labeled_snow_skiers = []
    for skiier in snow_skiers:
        label = "Person"
        detected_skiers = skiier.detect_labels(label=label)
        for detected_skier in detected_skiers:
            labeled_snow_skiers.append(detected_skier)

    return labeled_snow_skiers if labeled_snow_skiers else 0

# Example image
