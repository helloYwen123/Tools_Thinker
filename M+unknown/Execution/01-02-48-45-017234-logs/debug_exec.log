code:from object_detector import Object_Detector_Tool

# Function to check how many blue collars there are in the image
def count_blue_collar(image_path):
    tool = Object_Detector_Tool()
    results = tool.execute(image_path, ["blue", "collar"], saved_image_path="detected_objects")
    
    blue_collar_count = {}
    for obj in results["object_number"]:
        if obj["label"] == "blue collar":
            blue_collar_count_obj = blue_collar_count.get(obj["label"], {"count": 0})
            blue_collar_count[obj["label"]] = blue_collar_count_obj
            blue_collar_count[obj["label"]]["count"] += int(obj["box"][-1])

    return blue_collar_count

# Example usage
final_result = count_blue_collar("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_38_image_1.jpg")
print(final_result)
