Code: from object_detector import Object_Detector_Tool

final_result = 0
# Image Path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_96_image_1.jpg"
# Labels to detect
labels = ["baseball", "basket"]
# Save the detected objects as images if save_object True
save_object = True

# Create object detector tool
detector_tool = Object_Detector_Tool()
# Execute the object detection tool
detected_objects, object_number = detector_tool.execute(image=image_path, labels=labels, save_object=save_object, threshold=0.15, model_size="tiny")
# Get the label with the highest detection count
highest_detect = max(object_number, key=object_number.get)

if highest_detect == "baseball":
    final_result += 1
elif highest_detect == "basket":
    final_result -= 1
else:
    final_result = 0

final_result

