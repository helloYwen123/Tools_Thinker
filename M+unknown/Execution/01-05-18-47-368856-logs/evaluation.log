Code: from object_detector import Object_Detector_Tool

def detect_celebrity():
    path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_113_image_1.jpg"
    labels = ["baseball", "basket"]
    threshold = 0.45
    save_object = True
    saved_image_path = "detected_objects"
    object_number = 1  # Example: 1, 2, 3, etc...

    detector_tool = Object_Detector_Tool()
    if detector_tool:
        result = detector_tool.execute(image=path_to_image, labels=labels, save_object=save_object, threshold=threshold, model_size="tiny", saved_image_path=saved_image_path)
        print(result)
        final_result = result["output_types"][0][object_number]
        print(f"Count for {result['output_types'][1]['labels'][0]}: {final_result[0]['boxes'][0]}")
    else:
        print("Failed to execute object detection tool.")

