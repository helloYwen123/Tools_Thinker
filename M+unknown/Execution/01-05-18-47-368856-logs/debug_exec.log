from object_detector import Object_Detector_Tool

def detect_celebrity():
    path_to_image = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_113_image_1.jpg"
    labels = ["baseball", "basket"]
    threshold = 0.45
    save_object = True
    saved_image_path = "detected_objects"
    object_number = 1  # Example: 1, 2, 3, etc...

