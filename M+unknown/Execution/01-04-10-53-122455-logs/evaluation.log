Code: from object_detector import Object_Detector_Tool

# Set the required parameters
input_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_57_image_1.jpg'
labels = ['baseball', 'basket']
save_object = True
saved_image_path = 'detected_objects'

# Initialize the tool with the given parameters
tool = Object_Detector_Tool(input_path, labels=labels, save_object=save_object, saved_image_path=saved_image_path)

# Call the tool method
result = tool.execute()

# Get the detection results
labels_count = result['output_types'][0]
boxes_and_scores = result['output_types'][1]
image_paths = []

# Iterate through each detected label and check if it contains 'baseball' and 'basket' in its bounding box with confidence score > 0.45
for label, boxes in boxes_and_scores.items():
    if label == 'baseball' and 'basket' in boxes:
        box = box for box, score in boxes.items() if score > 0.45
        for box in box:
            if 'basket' in box['bbox'] and box['bbox'] not in image_paths:
                image_paths.append(box['bbox'])

# Count the number of detected 'baseball' and 'basket' objects
count_baseball = len([bbox for box in boxes_and_scores.values() for bbox in box if 'baseball' in bbox and 'basket' in bbox])
count_basket = len([bbox for box in boxes_and_scores.values() for bbox in box if 'basket' in bbox])
final_result = {'baseball_count': count_baseball, 'basket_count': count_basket}

