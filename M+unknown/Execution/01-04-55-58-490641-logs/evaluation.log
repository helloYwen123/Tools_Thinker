Code: from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_9_image_1.jpg"

# Object labels to detect
labels = ['Baseball', 'Basket']

# Confidence threshold
threshold = 0.45

# Size of the model
model_size = 'tiny'

# Whether to save detected objects as images
save_object = True

# Save path to save detected objects
saved_image_path = "detected_objects"

# Execute detection
detected_objects, object_number = Object_Detector_Tool.execute(image=image_path, labels=labels, threshold=threshold, model_size=model_size, save_object=save_object, saved_image_path=saved_image_path)

# Determine the number of detected objects as black
black_objects = ["Basketball", "Baseball"]

# Initialize a variable with the total number of black objects
total_black_objects = object_number

# Determine the number of black objects in the image based on the labels detected
if detected_objects == []:
    total_black_objects = 0

elif "Basketball" in detected_objects:
    total_black_objects += 1

elif "Baseball" in detected_objects:
    total_black_objects += 1

# Output the final result
final_result = ["Image:1", f"Total detected {total_black_objects} black objects.", ""] + detected_objects

