Code: from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_42_image_1.jpg"

# Object to detect
labels = ["baseball", "basket"]

# Confidence threshold
threshold = 0.45

detector = Object_Detector_Tool()

object_results, object_count = detector.execute(image_path, labels, threshold, 'tiny')

# Check if any labels were detected
if len(object_results) > 0:
    # Calculate total number of objects
    total_objects = sum(len(os_results) for labels, os_results in object_results.values())
    
    # Calculate proportion of detected objects
    proportion_detected = round((object_count / total_objects) * 100, 2)

    final_result = {"detected_objects": total_objects, 
                    "proportion_detected": proportion_detected}
else:
    final_result = {"detected_objects": 0, "proportion_detected": 0} 


# Check if final_result is valid (sums of keys should be 4)
for key, value in final_result.items():
    if key not in ["detected_objects", "proportion_detected"]:
        print("Invalid result for key:", key)
        final_result[key] = 0

print("Final result:", final_result)

