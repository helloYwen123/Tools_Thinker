class Image_Analysis_Tool:
    def __init__(self):
        self.image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_56_image_1.jpg"
        self.labels = ['baseball', 'basket']
        self.threshold = 0.45
        self.model_size = 'tiny'
        self.save_object = False

    def analyze_image_label(self):
        if self.model_size == 'tiny':
            tool = Object_Detector_Tool(image=self.image_path, labels=self.labels, save_object=self.save_object, threshold=self.threshold, model_size=self.model_size)
            return tool.execute()
        else:
            return False

    def analyze_label_count(self):
        tool = Object_Detector_Tool(image=self.image_path, labels=self.labels, save_object=self.save_object, threshold=self.threshold, model_size=self.model_size)
        return tool.execute()

    def get_label_box_scores(self, label):
        filtered_detections = self.analyze_image_label().get_label_counts()
        for detection in filtered_detections:
            if detection['label'] == label:
                return detection

    def get_total_counts(self):
        return self.analyze_label_count()

    def get_total_label_count(self):
        total_label_count = 0
        for label_count in self.analyze_image_label():
            total_label_count += label_count['count']
        return total_label_count

    def get_total_counts_din(self):
        with open('/home/stud/wxie/BLINK_Dataset/Counting/results.txt', 'r') as f:
            data = f.read()
        data_list = data.split('\n')
        for line in data_list:
            label, count = line.split(',')
            count = int(count)
            if label in self.labels:
                print(f"Found {label} : {count}")
                total_label_count += count
    final_result = 1

