Code: from object_detector import Object_Detector_Tool

final_result = {}
labels = ["baseball", "basket"]

# Assuming the image is 'val_Counting_103_image_1.jpg', no need to specify path
object_number = Object_Detector_Tool.execute(image="val_Counting_103_image_1.jpg", labels=labels)

for label in dict(list(enumerate(labels)) + sorted(object_number, key=lambda x: x[1])):
    for key, value in object_number.items():
        final_result[label] = value

