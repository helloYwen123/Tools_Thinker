from object_detector import Object_Detector_Tool
 
# Load the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_65_image_1.jpg"
object_detector_tool = Object_Detector_Tool()
detect_result = object_detector_tool.execute(image_path, labels=["chicken_nugget"], save_object=True, saved_image_path="detected_objects")

def count_chicken_nuggets(detect_result):
    # Detect the bounding boxes and confidence scores for chicken nuggets in the image
    chicken_nugget_boxes = [
        {
            "label": ["chicken_nugget"],
            "bbox": detect_result["boxes"]["chicken_nugget"],
            "confidence_score": [conf_score]
        }
        for conf_score in detect_result["confidence_scores"]
        if "chicken_nugget" in conf_score["labels"]
    ]
    
    # Filter out only the chicken nuggets
    chicken_nugget_bounding_boxes = [
        bbox
        for bbox in chicken_nugget_boxes
        if bbox["label"] == "chicken_nugget"
    ]
    
    # Count the chicken nuggets
    chicken_nugget_count = len(chicken_nugget_bounding_boxes)
    
    return chicken_nugget_count

final_result = count_chicken_nuggets(detect_result)
print("Number of chicken nuggets detected:", final_result)

