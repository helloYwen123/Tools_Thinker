Code: from object_detector import Object_Detector_Tool

def detect_chicken_nuggets(image_path):
    tool = Object_Detector_Tool(image_path)

    if tool.can_get_detection_results():
        if tool.need_to_generate_objects():
            objects = tool.generate_objects()

            if objects:
                for label, count in tool.label_count().items():
                    image = tool.load_result(label, True)
                    detected_objects = tool.detected_objects

                    if detected_objects:
                        for detected_objects in detected_objects:
                            for detected_object in detected_objects["boxes"]:
                                if detected_object["class"] == "ChickenNugget":
                                    final_result = detected_object["bbox"].copy()  # Save the bounding boxes

                print("Chicken Nuggets: ", count)  # Print the total count
    else:
        print("Error:", tool.errormsg)  # Print the error message

