class Image_Id:
    def __init__(self, image_path):
        self.image_path = image_path

    def execute(self, labels=None, save_object=False, saved_image_path="detected_objects"):
        # Load the image
        image = Image_Id(self.__class__.__dict__[image_path].__name__)
        labels_list = ['red_buses']

        # Analyze the image
        if labels:
            labels_to_detect = labels
        else:
            labels_to_detect = ['red_buses'] if image.path != "val_Counting_21_image_1.jpg" else ['baseball', 'basket', 'red_buses']

        tool = Object_Detector_Tool()
        labels_list = tool.execute(image.path, labels_to_detect, self, image, labels, '', labels_to_detect, save_object, saved_image_path)
        
        # Count the detections
        red_buses_boxes = labels_to_detect
        red_buses_count_list = [len(box) for box in label_to_boxes]
        
        # Calculate the total number of red buses
        final_result = sum(red_buses_count_list)
        
        return (labels_to_detect, red_buses_count_list, final_result)
