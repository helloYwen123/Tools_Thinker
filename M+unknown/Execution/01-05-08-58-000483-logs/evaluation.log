Code: from object_detector import Object_Detector_Tool

final_result = 3

def count_tomatoes(image_path):
    detector = Object_Detector_Tool(image_path=image_path, labels=["tomato"], save_object=True, saved_image_path="tomato_counts")
    tomato_counts = detector.execute()
    return tomato_counts[0]["boxes"]["tomato"]

image_path = '/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_25_image_1.jpg'
tomato_counts = count_tomatoes(image_path)

if tomato_counts:
    final_result = tomato_counts[0]["boxes"]["tomato"]
    print(f"There are {final_result} slices of tomatoes on the plate.")
else:
    print("Sorry, no tomatoes detected on the plate.")

