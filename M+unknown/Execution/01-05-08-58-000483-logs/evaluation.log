Code: from object_detector import Object_Detector_Tool

# Path to the image
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_25_image_1.jpg"

# Create the object detector tool
detector_tool = Object_Detector_Tool()

# Execute the tool with the image
detector_tool.execute(image_path=image_path, labels=["baseball", "basket"], save_object=True, saved_image_path="detected_objects")

# Create a dictionary to count the number of tomatoes
tomatoes_count_dict = {}
for detection_results in detector_tool.output_types[1]:
    labels = detection_results["label"]
    tomatoes_count_dict[labels] = detection_results.get("boxes", {}).get("tomato", [])
    for tomato in tomatoes_count_dict[labels]:
        tomato["count"] += 1

# Check for multiple tomatoes
if len(tomatoes_count_dict["baseball"]) == 3:
    final_result = len(tomatoes_count_dict["baseball"])  # 1 tomato
else:
    final_result = len(tomatoes_count_dict["baseball"])  # 0 tomatoes

print(f"Number of tomato slices: {final_result}")

