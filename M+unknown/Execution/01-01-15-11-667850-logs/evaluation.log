# Check if the detected objects are within the specified label
if object_detector_tool.output_types[1] is not None:
    detected_objects = object_detector_tool.output_types[1]["detected_objects"]["boxes"]
    object_count = [detected_objects["boxes"][i] for i in object_detector_tool.output_types[1]["count"]]

    # Determine the number of people wearing a green jacket
    green_jacket_count = [box["id"] for box in object_count if "baseball" in box["label"]]

    final_result = "How many people are wearing a green jacket? \n" + str(len(green_jacket_count))

else:
