Code: from object_detector.object_detector import Object_Detector_Tool

# Function to count the number of people wearing a green jacket
def count_green_jackets(image_path):
    # Create an object detector tool instance
    detect_tool = Object_Detector_Tool(image_path, labels=["green jacket"], threshold=0.45, save_object=True)
    
    # Execute the tool to detect green jackets
    detected_objects = detect_tool.execute()
    
    # Initialize variables to count detected jackets
    jacket_count = 0
    
    # Iterate through each detected jacket
    for label, detail in detected_objects[1].items():
        # Check if the jacket label matches the green jacket label
        if detail.get('label') == 'green jacket':
            jacket_count += 1
    
    # Return the count of green jackets
    return jacket_count

# Example usage
example_image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_30_image_1.jpg"
final_result = count_green_jackets(example_image_path)
print(final_result)

