# Function to count the number of knobs on the stove
def count_knobs(image_path):
    # Load the image and apply the detection tool
    tool = Object_Detector_Tool(image_path, labels=["stove"])
    tool.run()

    # Extract the number of knobs from the detection results
    detected_labels = tool.output['detected_labels']

    # Summarize the detection results
    total_labels = len(detected_labels)
    detected_objects = tool.output['progress_counts']
    for label, count in detected_objects.items():
        if label == "stove":
            final_result = (count)
            return final_result

    # Return the total count of detected labels if not found
    return total_labels

