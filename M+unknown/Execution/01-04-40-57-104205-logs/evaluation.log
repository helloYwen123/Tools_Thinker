# Define the image path
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_18_image_1.jpg"

# The label for the object we want to detect, in this case, 'bathroom' for the bathtub
label = 'bathroom'

# Initial confidence threshold
threshold = 0.4

# Load the detector model
detector_tool = Object_Detector_Tool(image_path=image_path, labels=[label], threshold=threshold)

# Save the detected objects as images
detector_tool.save_object() 

# Check how many fingers are in front of the bathtub
fingers = 0
for boxes in detector_tool["object_number"].values():
    if "fingers" in boxes:
        fingers += boxes.get("fingers")

# Final result
final_result = "There are " + str(fingers) + " fingers in front of the bathtub."

