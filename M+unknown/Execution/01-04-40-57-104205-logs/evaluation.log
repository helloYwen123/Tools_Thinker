Code: from object_detector import Object_Detector_Tool

def count_fingers(image_path):
    result_tool = Object_Detector_Tool()
    result_tool.object_labels = ["fingers"]
    result_tool.threshold = 0.45
    result_tool.save_object = True
    result_tool.save_image_path = "fingers_results"

    # Execute the tool
    detected_objects, total_count = result_tool.execute(image_path)

    # Initialize counter
    finger_count = total_count["fingers"]

    return finger_count

# Example usage
fingers_count = count_fingers("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_18_image_1.jpg")
final_result = fingers_count

