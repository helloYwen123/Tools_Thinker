    if label['label'] in labels:
        label_count[label['label']] += 1

# print the number of detected black cars
all_detected_objects = detected_objects
black_detected_objects = [obj for obj in all_detected_objects if obj['label'] == 'black']
final_result = 1 if black_detected_objects else 0

print(f"The number of black cars detected is {final_result}")

