label_count = {'baseball': 0, 'basket': 0}

# set the confidence threshold
confidence_threshold = 0.45

# set the model size
model_size = "tiny"

# save the detection results
save_object = False

# execute object detection
detected_objects, object_number = Object_Detector_Tool.execute(image_path, labels, confidence_threshold, model_size, save_object, "detected_objects")

