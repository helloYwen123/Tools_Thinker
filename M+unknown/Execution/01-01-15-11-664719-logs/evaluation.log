Code: from object_detector import Object_Detector_Tool

# Define the path to the image file
image_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_36_image_1.jpg"

# Initialize the Object_Detector_Tool
tool = Object_Detector_Tool()

# Execute the tool to detect objects in the image
detected_objects, object_number = tool.execute(image=image_path, labels=["baseball", "basket"], save_object=True)

# Print the information about the detected objects
print(f"The detected baseball has the box ({detected_objects['baseball']['boxes'][0]['x1']}:{detected_objects['baseball']['boxes'][0]['x2']}), score of {detected_objects['baseball']['scores'][0]:.2f}.")
print(f"The detected basket has the box ({detected_objects['basket']['boxes'][0]['x1']}:{detected_objects['basket']['boxes'][0]['x2']}), score of {detected_objects['basket']['scores'][0]:.2f}.")

# Calculate the total number of wooden beams on top of the person
total_beams = 6

# Determine the number of wooden beams on top of the person
num_beams = int(detected_objects['baseball']['scores'][0] > 0.45) + int(object_number)

# Calculate the number of wooden beams on top of the person
beams_str = f"{num_beams} wooden beams are on top of the person."

# Check if the count is greater than zero
if num_beams > 0:
    final_result = f"Number of wooden beams on top of the person: {beams_str}"
else:
    final_result = "No wooden beams detected."

final_result

