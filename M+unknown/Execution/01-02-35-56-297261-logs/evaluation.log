labels = ["baseball", "basket"]
threshold = 0.45
save_object = True
saved_image_path = "detected_objects"

model_size = "tiny"
label_count = {}

# Detect objects in the image using the Grounding DINO model
obj_detector = Object_Detector_Tool(image_path, labels, threshold, model_size, save_object)
obj_results = obj_detector.execute()

if obj_results[0]['boxes'][0]:
    # Determine the number of fingers in front of the bathtub
    finger_count = len(obj_results[0]['boxes'][0][0])

    # Increment the count for the most common label found in the image
    if label_count.get(finger_count, 0) != 0:
        label_count[finger_count] += 1
    else:
        label_count[finger_count] = 1

    # Print final result
    print(f"Number of fingers in front of the bathtub is: {finger_count}")
    print("Label count:", label_count)
else:
    print("Failed to detect objects in the image.")

