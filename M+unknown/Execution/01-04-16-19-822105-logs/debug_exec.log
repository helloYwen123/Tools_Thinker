def count_yellow_buses(buses, yellow_buses):
    count = 0
    for bus in buses:
        if bus['name'].get('color') == 'yellow':
            count += 1
    return count

# Example usage
buses = [
    {'name': {'color': 'blue', 'brand': 'Moby'}, 'number': 7, 'address': '4762484'}, 
    {'name': {'color': 'yellow', 'brand': 'Caterham', 'number': 5346796}, 'address': '4831133'}]
output = count_yellow_buses(buses, yellow_buses={'color': 'yellow'})
