Code: def count_people_in_image(image_path):
    """
    This function Counts the number of people in an image.

    Parameters:
    image_path (str): The path to the image file.

    Returns:
    int: The count of people detected in the image.
    """
    from object_detector import Object_Detector_Tool

    object_detector_tool = Object_Detector_Tool()
    labels_list = ["person"]  # Add more labels if needed
    
    count = object_detector_tool.execute(image=image_path, labels=labels_list, save_object=False)
    
    return count

