Code: from object_detector import Object_Detector_Tool

# Specify the image path where the green bowl is located
green_bowl_image_path = "/path/to/your/image.jpg"

# Initialize the object detection tool
obj_detector_tool = Object_Detector_Tool()

# Execute the detection
detected_objects, object_number = obj_detector_tool.execute(image=green_bowl_image_path, labels=["almond"], save_object=True, saved_image_path="detected_objects")

# Process the detection results
for label, detection_results in detected_objects['labelwise']:
    box = detection_results['boxes'][0]
    confidence_score = detection_results['confidence_scores'][0]
    
    # Check if the almond is larger than 0.5 times the box's width
    if confidence_score > 0.5 and box['height'] / box['width'] >= 2:
        largest_almond_count = object_number[label] + 1
        final_result = largest_almond_count
        break

