def count_tall_buidlings(image_path, labels=['Lackawanna']):
    model_name = 'tiny'

    def add_label_to_result(labels, boxes, scores):
        for label in labels:
            if label == 'Lackawanna':
                for box, score in boxes:
                    yield (box, score, labels), (box, score)

    tool = Object_Detector_Tool(image_path, labels=labels, save_object=True, saved_image_path="Lackawanna detected")

    detections = tool.execute()
    labels_count = {}
    for box, score, results in detections:
        for result in add_label_to_result(labels, results):
            labels_count[result[0].split(' ')[0]] = result[1]
    
    return labels_count

