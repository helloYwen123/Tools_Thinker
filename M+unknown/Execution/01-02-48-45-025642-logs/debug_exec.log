class Image_Analysis_Tool:
    def __init__(self, image_path, labels, save_object=False, saved_image_path=None):
        self.image_path = image_path
        self.labels = labels
        self.save_object = save_object
        self.saved_image_path = saved_image_path

    def analyze_image(self):
        results = Object_Detector_Tool.execute(image=self.image_path, labels=self.labels, save_object=self.save_object, saved_image_path=self.saved_image_path)
        detections = results[0]

        final_result = {}

        for label in self.labels:
            if label in detections:
                detected_objects = detections[label]
                for object_data in detected_objects:
                    if object_data["boxes"] is not None and object_data["boxes"][0] is not None and len(object_data["boxes"]) > 0:
                        x1, y1, x2, y2 = object_data["boxes"][0]
                        if x1 > x2:
                            x1, x2 = x2, x1
                            y1, y2 = y2, y1
                        # Calculate the total number of detected objects in this image
                        for detected_object in detected_objects:
                            if y1 < y2:
                                y1 = y2
                                x1 = x2
                                y2 = y1
                                # Calculate the total number of detected objects in this image
                                total_count = len(detected_objects)
                            else:
                                # Calculate the total number of detected objects in this image
                                total_count = len(detected_objects) - 1 if y1 < y2 else len(detected_objects)

                        # Add the total number of detected objects in this image to the final result
                        final_result[label] = total_count

        return final_result

