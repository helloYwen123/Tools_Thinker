# Function to count the number of red buildings
def count_red_buildings(image_path):
    object_detector_tool = Object_Detector_Tool()
    labels_to_count = ["red_building"]
    saved_image_path = str(image_path) + "_detected_buildings"
    
    if "Baseball" in labels_to_count:
        print("Finding Baseball")
        # Add your code to find 'Baseball' in the image here.
        # For example:
        detected_objects = object_detector_tool.execute(image_path, labels={'Baseball': [True]})
        object_detector_tool.save_object(detected_objects, labels={'Baseball': [True]}, saved_image_path=saved_image_path)
        
        building_id, building_name = find_building(saved_image_path)
        
    saved_image_path = str(image_path) + "_detected_wings"
    
    if "Basket" in labels_to_count:
        print("Finding Basket")
        # Add your code to find 'Basket' in the image here.
        # For example:
        detected_objects = object_detector_tool.execute(image_path, labels={'Basket': [True]})
        object_detector_tool.save_object(detected_objects, labels={'Basket': [True]}, saved_image_path=saved_image_path)
        building_id, building_name = find_building(saved_image_path)
        
    return building_id, building_name

# Example usage
final_result = count_red_buildings("/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_101_image_1.jpg")
print(final_result)

