Code: from object_detector import Object_Detector_Tool

# Define the labels to detect (in this case, 'bananas')
labels=['butter', 'egg', 'sausage', 'lettuce']

# Confidence threshold
threshold = 0.45

# Size of the model (to choose between 'tiny' or 'base')
model_size = 'base'

# Save object detections as images
save_object = True

# Set the path of the image file
image_path = 'path/to/image.jpg'

# Execute the tool to detect the 'bananas' in the image
tool_result = Object_Detector_Tool.execute(image_path, labels=labels, save_object=save_object, model_size=model_size, threshold=threshold)

# Print the result
print(f"Number of bananas detected: {tool_result[0]['object_number']}")

# Store the number of detections in the final result
