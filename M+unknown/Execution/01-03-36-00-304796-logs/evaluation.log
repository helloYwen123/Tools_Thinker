Code: from object_detector import Object_Detector_Tool

def count_words_on_chalkboard(image_path):
    """
    Counts the number of words written in white chalk on a chalkboard.

    Args:
        image_path (str): The path to the image file.

    Returns:
        int: The number of words on the chalkboard.
    """
    import os
    from matplotlib.patches import Rectangle
    # Load image and convert to grayscale
    image = Image.open(image_path).convert('L')
    image_array = numpy.array(image)

    # Apply DINO model for object detection
    label_results = Object_Detector_Tool.image(image_path, labels=("brick-oven-pizza", "as-4-aggi"), threshold=0.45,
                                                model_size="tiny", save_object=True)

    # Total detected words
    total_words = 0
    detected_labels = []
    for label_dict in label_results["detected_objects"]:
        total_words += label_dict["count"]
        detected_labels.append(label_dict["label"])

    return total_words

# Get and count detected words on chalkboard
chalkboard = '<path_to_filename>'
