Code: from object_detector import Object_Detector_Tool

model_size = "tiny"
threshold = 0.45
save_object = True
saved_image_path = "detected_objects"

def calculate_train_stations():
    """ Calculates the number of trains stopped at a station.
    
    Returns:
        int: The number of trains stopped at the station.
    """
    # Load the trained model
    detector = Object_Detector_Tool()
    
    # Load the image
    im_path = "/home/stud/wxie/BLINK_Dataset/Counting/val/images/val_Counting_98_image_1.jpg"  # Replace with the actual image file path
    
    # Detect the objects in the image
    result = detector.execute(image=im_path, labels=["train"], threshold=threshold, save_object=save_object, saved_image_path=saved_image_path)
    object_number = {label: count for i, label in enumerate(result['object_number'])) if 'object_number' and 'count' in result[0] else {'train': 0}

    # Calculate the number of trains stopped at the station
    total_count = len(result['object_number']['train'])
    if total_count == 0:
        return 0
    return total_count - object_number['train'][0] - object_number['train'][1] - object_number['train'][2]

final_result = calculate_train_stations()
print(f"The station has {final_result} trains stopped.")

