Code: from Object_Detector_Tool import Object_Detector_Tool

# Code to analyze the image and check for the existence of people climbing on the wall
def analyze_image(image_path, label='wall', save_object=False, saved_image_path=None):
    # Load the prediction result from the image_path
    detector_tool = Object_Detector_Tool(image_path)
    results = detector_tool.execute(image_path, labels=[label], threshold=0.65, model_size='tiny', save_object=save_object, saved_image_path=saved_image_path)
    object_number = results[0][label]["total_count"]
    print(f"Number of detected people climbing on the wall: {object_number}")
    return object_number

# Use the analyzer function with the appropriate parameters
final_result = analyze_image("/path/to/image.png")
print(f"The number of people climbing on the wall in the image is: {final_result}")

